/*
 * specC.goh -- Port32: the messages between the generic and the
 * specific UI whose C prototypes (visC.goh, genC.goh) lack what the asm
 * passes, as goc aliases with the parameters the C UI sends
 * (Port32/ABI.md section 13x).  The generic UI and the specific UIs
 * handle and send these forms.
 */
#ifndef __SPECC_GOH
#define __SPECC_GOH

@include <ui.goh>
@include <Objects/gItemGC.goh>
@include <Objects/gBoolGC.goh>

@deflib ui

/* the parents MSG_SPEC_GUP_QUERY_VIS_PARENT asks for (visC.def) */
typedef word SpecQueryVisParentType;
#define SQT_VIS_PARENT_FOR_FIELD	0
#define SQT_VIS_PARENT_FOR_APPLICATION	1
#define SQT_VIS_PARENT_FOR_PRIMARY	2
#define SQT_VIS_PARENT_FOR_DISPLAY	3
#define SQT_VIS_PARENT_FOR_POPUP	4
#define SQT_VIS_PARENT_FOR_URGENT	5
#define SQT_VIS_PARENT_FOR_SYS_MODAL	6

/* the generic upward query, passed on as it came (MSG_GEN_GUP_QUERY's
 * parameters); TRUE if answered */
@alias (MSG_SPEC_GUP_QUERY) Boolean MSG_SPEC_P32_GUP_QUERY(
				GenReturnParams *retValue = axbpcxdx,
				GenUpwardQueryType queryType = cx) = carry;

/* the asm passed the VisOptFlags to mark invalid in cl */
@alias (MSG_SPEC_RESCAN_GEO_AND_UPDATE) void
	MSG_SPEC_P32_RESCAN_GEO_AND_UPDATE(VisOptFlags flags,
					   VisUpdateMode updateMode);

/* TRUE (the asm's carry) if answered: the branch from here up is built */
@alias (MSG_GEN_GUP_ENSURE_UPDATE_WINDOW) Boolean
	MSG_GEN_P32_GUP_ENSURE_UPDATE_WINDOW(UpdateWindowFlags updateFlags,
					     VisUpdateMode updateMode);

/* the visual upward query (visC.def: VisUpwardQueryType); the
 * specific UI's queries start at SPEC_VIS_QUERY_START */
typedef word VisUpwardQueryType;
#define VUQ_DISPLAY_SCHEME	0
#define VUQ_VIDEO_DRIVER	1
#define SPEC_VIS_QUERY_START	2000
#define APP_VIS_QUERY_START	4000

/*
 * MSG_VIS_VUP_QUERY with its registers (Port32): the query type, the
 * asm's dx and bp passed on, the answer in retValue; TRUE (the asm's
 * carry) if answered.  VUQ_DISPLAY_SCHEME answers GRP_ax = the
 * DisplayScheme's colorScheme | displayType << 8 | lightColor << 16 |
 * darkColor << 24, GRP_cx = the font ID, GRP_dx = the point size;
 * VUQ_VIDEO_DRIVER answers the driver in GRP_ax.
 */
@alias (MSG_VIS_VUP_QUERY) Boolean MSG_VIS_P32_VUP_QUERY(
				GenReturnParams *retValue = axbpcxdx,
				VisUpwardQueryType queryType = cx,
				dword data1 = dx, dword data2 = bp) = carry;

/*
 * The update of an item group's look (Port32): the asm passed a
 * GenItemGroup's changed items as a block of identifiers (bp, its size
 * in bytes in dx), a GenBooleanGroup's changed booleans in cx.  Here:
 * the changed booleans, or the number of identifiers and the identifiers
 * (good for the call only).
 */
@alias (MSG_SPEC_UPDATE_SPECIFIC_OBJECT) void
	MSG_SPEC_P32_UPDATE_SPECIFIC_OBJECT(word changedBooleans,
					    word numItems,
					    const word *items);

/*
 * MSG_GEN_ITEM_GROUP_SCAN_ITEMS and MSG_GEN_BOOLEAN_GROUP_SCAN_BOOLEANS
 * with what the asm returned: TRUE (the asm's carry) if a usable and
 * enabled item was found; the item in retValue.  For GSIF_DYNAMIC_LIST
 * the position instead, with the first and last usable and enabled
 * items.
 */
typedef struct _GenScanItemsReturn {
    word	GSIR_item;
    word	GSIR_first;
    word	GSIR_last;
} GenScanItemsReturn;

@alias (MSG_GEN_ITEM_GROUP_SCAN_ITEMS) Boolean
	MSG_GEN_ITEM_GROUP_P32_SCAN_ITEMS(GenScanItemsReturn *retValue,
					  GenScanItemsFlags flags,
					  word initialItem,
					  sword scanAmount) = carry;
@alias (MSG_GEN_BOOLEAN_GROUP_SCAN_BOOLEANS) Boolean
	MSG_GEN_BOOLEAN_GROUP_P32_SCAN_BOOLEANS(GenScanItemsReturn *retValue,
						GenScanItemsFlags flags,
						word initialItem,
						sword scanAmount) = carry;

/*
 * MSG_GEN_ITEM_GROUP_UPDATE_EXTENDED_SELECTION's flags: ExtSelFlags in
 * the low byte, the flags passed on to the set message in the high
 * byte.  The set message (setSelMsg) takes the identifier and a word:
 * the passed flags in the low byte, the high byte non-zero to select.
 */
#define ESF_INITIAL_SELECTION		0x80
#define ESF_XOR_INDIVIDUAL_ITEMS	0x40
#define ESF_CLEAR_UNSELECTED_ITEMS	0x20
#define ESF_SELECT			0x10

@prototype void GEN_ITEM_GROUP_SET_EXT_SEL_MSG(word identifier,
					       word flags);

@endlib

#endif
