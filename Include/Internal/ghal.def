COMMENT @----------------------------------------------------------------------

PROJECT:	PC GEOS
FILE:		ghal.def

DESCRIPTION:
	GEOS Hardware Abstraction Layer (GHAL), asm side.

	Every direct contact of the kernel with PC hardware (interrupt
	flag, 8259 PIC, 8253 PIT) goes through the macros below, so that
	the C port has one defined contract per contact (see
	Port32/GHAL-Concept.md).

	This is the dos backend (real16 and pm16).  Each macro expands to
	exactly the instructions it replaces, so the build output stays
	byte-identical (checked with Port32/tools/geocmp.py against
	Port32/reference/pm-baseline.json).

	The PIT macros use constants from Library/Kernel/Timer/
	timerConstant.def, which must be visible where they are expanded.

------------------------------------------------------------------------------@

SetDef	__GHAL

;------------------------------------------------------------------------------
;	CPU interrupt flag
;------------------------------------------------------------------------------

GHAL_IntOff	macro
	cli
endm

GHAL_IntOn	macro
	sti
endm

;------------------------------------------------------------------------------
;	Interrupt controller (8259)
;
;	GHAL_PicEoi	cmd
;		Send end-of-interrupt command byte cmd to the master PIC.
;		Destroys: al
;------------------------------------------------------------------------------

GHAL_PicEoi	macro	cmd
	mov	al, cmd
	out	IC1_CMDPORT, al
endm

;------------------------------------------------------------------------------
;	Programmable interval timer (8253), counter 0
;
;	GHAL_TimerRead
;		Return:	ax = current count of counter 0
;
;	GHAL_TimerWrite
;		Pass:	cx = new count for counter 0
;		Destroys: al
;
;	GHAL_TimerReset	value
;		Put counter 0 into square wave mode with the given count.
;		Destroys: ax
;------------------------------------------------------------------------------

GHAL_TimerRead	macro
	mov	al, TIMER_COMMAND_0_READ_COUNTER
	out	TIMER_IO_COMMAND, al
	jmp	$+2			; I/O delay
	in	al, TIMER_IO_0_LATCH	; al = low byte
	jmp	$+2			; I/O delay
	mov	ah, al
	in	al, TIMER_IO_0_LATCH	; al = high byte
	xchg	al, ah
endm

GHAL_TimerWrite	macro
	mov	al, TIMER_COMMAND_0_WRITE
	out	TIMER_IO_COMMAND, al
	jmp	$+2			; give 8253 time to react
	mov	al, cl
	out	TIMER_IO_0_LATCH, al
	jmp	$+2			; give 8253 time to react
	mov	al, ch
	out	TIMER_IO_0_LATCH, al
endm

GHAL_TimerReset	macro	value
	mov	al, TimerControlWord <0,TRLC_WORD,TM_SQUARE_WAVE,0>
	out	TIMER_IO_COMMAND, al
	mov	ax, value
	out	TIMER_IO_0_LATCH, al
	mov	al, ah
	out	TIMER_IO_0_LATCH, al
endm

;------------------------------------------------------------------------------
;	DOS services
;
;	GHAL_DosCall
;		Issue a DOS function call (int 21h).  Registers in and out as
;		documented for the DOS function in ah.  Other hosts map the
;		functions the kernel uses to ghal_fs / ghal_boot / ghal_time
;		(Port32/GHAL-Concept.md).
;------------------------------------------------------------------------------

GHAL_DosCall	macro
	int	21h
endm

;------------------------------------------------------------------------------
;	BIOS and other host services
;
;	Each macro issues the software interrupt of one host service.
;	Registers in and out as documented for that service.
;
;	Macro			int	Service -> GHAL module on other hosts
;	GHAL_VideoBios      	10h	video BIOS -> ghal_video / video driver
;	GHAL_DiskBios       	13h	disk BIOS -> ghal_fs (raw disk, format)
;	GHAL_SysBios        	15h	system BIOS (APM, A20, memory size) -> ghal_power / ghal_boot
;	GHAL_KbdBios        	16h	keyboard BIOS -> ghal_input
;	GHAL_BootstrapBios  	19h	bootstrap loader (reboot) -> ghal_exit
;	GHAL_ClockBios      	1ah	clock BIOS / RTC -> ghal_time
;	GHAL_DosAbsRead     	25h	DOS absolute disk read (leaves flags on stack) -> ghal_fs
;	GHAL_DosAbsWrite    	26h	DOS absolute disk write (leaves flags on stack) -> ghal_fs
;	GHAL_MultiplexCall  	2fh	DOS multiplex (XMS, task switchers, ...) -> ghal_mem / ghal_boot
;	GHAL_EmsCall        	67h	EMS driver -> ghal_mem
;------------------------------------------------------------------------------

GHAL_VideoBios	macro
	int	10h
endm

GHAL_DiskBios	macro
	int	13h
endm

GHAL_SysBios	macro
	int	15h
endm

GHAL_KbdBios	macro
	int	16h
endm

GHAL_BootstrapBios	macro
	int	19h
endm

GHAL_ClockBios	macro
	int	1ah
endm

GHAL_DosAbsRead	macro
	int	25h
endm

GHAL_DosAbsWrite	macro
	int	26h
endm

GHAL_MultiplexCall	macro
	int	2fh
endm

GHAL_EmsCall	macro
	int	67h
endm
