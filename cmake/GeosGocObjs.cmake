# GeosGocObjs.cmake -- collect the chunk constants of the files of a geode.
#
#   cmake -D OUT=<geode>_objs.h -D INPUTS=<a.goc.x.h;b.goc.x.h...> -P GeosGocObjs.cmake
#
# goc -cg -x writes, for each .goc file, macros with the chunk handle and
# resource number of every chunk the file defines (__goc_xch_<chunk>,
# __goc_xrs_<chunk>).  The other files of the geode use them for objects
# they declare with @extern, in resource data and static data in code
# (GOCR_XSOPTR, Port32/ABI.md).  OUT is only rewritten when it changes, so
# editing code does not recompile every file of the geode.
set(text "/* generated by cmake/GeosGocObjs.cmake */\n")
foreach(in IN LISTS INPUTS)
  file(READ ${in} part)
  string(APPEND text "${part}")
endforeach()
set(old "")
if(EXISTS ${OUT})
  file(READ ${OUT} old)
endif()
if(NOT old STREQUAL text)
  file(WRITE ${OUT} "${text}")
endif()
