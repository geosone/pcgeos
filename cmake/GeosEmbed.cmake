# GeosEmbed.cmake -- write a file as a C array (see geos_embed in
# GeosGeode.cmake).
#
#   cmake -D IN=<file> -D OUT=<file.c> -D SYMBOL=<name> -P GeosEmbed.cmake
file(READ ${IN} hex HEX)
string(LENGTH "${hex}" len)
math(EXPR size "${len} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
string(REGEX REPLACE "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)" "\\1\n" bytes "${bytes}")
file(WRITE ${OUT} "/* generated by cmake/GeosEmbed.cmake from ${IN} */\n"
     "const unsigned char ${SYMBOL}[] = {\n${bytes}0};\n"
     "const unsigned long ${SYMBOL}_size = ${size};\n")
