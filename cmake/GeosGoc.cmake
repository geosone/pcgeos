# GeosGoc.cmake -- run goc -cg (the Port32 backend of goc) in CMake builds.
#
#   geos_goc(<out-var> <geode.gp> <file.goc>... [INCLUDES dir...])
#
# Translates the .goc files of one geode with goc -cg and numbers its
# resources from <geode.gp> and the files (Port32/tools/gpres.py).
# <out-var> receives one C file per .goc file to add to a target: each
# includes the resource numbers and then the goc output, so no compiler-
# specific "force include" option is needed.  goc is the one built by the
# pmake tools build (bin/goc); it runs on the build host, also when cross
# compiling.
find_program(GEOS_GOC goc PATHS ${PROJECT_SOURCE_DIR}/bin NO_DEFAULT_PATH)
find_package(Python3 COMPONENTS Interpreter)

function(geos_goc out_var gp_file)
  cmake_parse_arguments(PARSE_ARGV 2 ARG "" "" "INCLUDES")
  get_filename_component(gp_file ${gp_file} ABSOLUTE)
  get_filename_component(geode ${gp_file} NAME_WE)
  set(dir ${CMAKE_CURRENT_BINARY_DIR}/goc/${geode})
  set(res_h ${dir}/${geode}_res.h)

  set(gocs)
  foreach(goc_file IN LISTS ARG_UNPARSED_ARGUMENTS)
    get_filename_component(goc_file ${goc_file} ABSOLUTE)
    list(APPEND gocs ${goc_file})
  endforeach()

  add_custom_command(OUTPUT ${res_h}
    COMMAND ${CMAKE_COMMAND} -E make_directory ${dir}
    COMMAND ${Python3_EXECUTABLE} ${PROJECT_SOURCE_DIR}/Port32/tools/gpres.py
            -o ${res_h} ${gp_file} ${gocs}
    DEPENDS ${gp_file} ${gocs} ${PROJECT_SOURCE_DIR}/Port32/tools/gpres.py
    COMMENT "gpres ${geode}"
    VERBATIM)

  set(wrappers)
  foreach(goc_file IN LISTS gocs)
    get_filename_component(goc_dir ${goc_file} DIRECTORY)
    get_filename_component(base ${goc_file} NAME_WE)
    set(out_c ${dir}/${base}.goc.c)
    set(includes -I${goc_dir})
    foreach(inc IN LISTS ARG_INCLUDES)
      list(APPEND includes -I${inc})
    endforeach()
    list(APPEND includes -I${PROJECT_SOURCE_DIR}/CInclude)
    add_custom_command(OUTPUT ${out_c}
      COMMAND ${CMAKE_COMMAND} -E make_directory ${dir}
      COMMAND ${GEOS_GOC} -cg -D__GEOS__ ${includes} -o ${out_c} ${goc_file}
      WORKING_DIRECTORY ${goc_dir}
      DEPENDS ${goc_file} ${GEOS_GOC}
      COMMENT "goc -cg ${base}.goc"
      VERBATIM)
    set(wrapper ${dir}/${base}.c)
    file(CONFIGURE OUTPUT ${wrapper} CONTENT
         "/* generated by cmake/GeosGoc.cmake */\n#include \"${geode}_res.h\"\n#include \"${base}.goc.c\"\n"
         @ONLY)
    set_source_files_properties(${wrapper} PROPERTIES
      OBJECT_DEPENDS "${out_c};${res_h}")
    list(APPEND wrappers ${wrapper})
  endforeach()
  set(${out_var} ${wrappers} PARENT_SCOPE)
endfunction()
