/*
 * viewScrollbarDraw.goc -- Motif's scrollbar drawing (after
 * Motif/View/viewScrollbarDraw.asm): the bar is drawn from tables of
 * lines, rectangles and arrow bitmaps (vertScrollbar, horizScrollbar,
 * the sliders' and gauges'), one part after the other: the up arrow,
 * the thumb, the page up area, the page down area, the down arrow.  A
 * coordinate in a table is a number or a parameter (P_*) plus a small
 * offset: the arrow width, its height, the beginning and end of the
 * region drawn (the thumb's, a page area's), the arrow's middle, the end
 * less an arrow.  A pressed arrow is drawn in its selected colors; the
 * page areas are 50% patterns of the dark and light colors; the arrows
 * are bitmaps of 8, 10, 12 or 14 pixels (olArrowSize).
 *
 * Port32 (Port32/ABI.md section 13y): a part is a routine number and its
 * table (the asm's nptr and the words after it); the bitmaps are C data.
 */
@include "CView/cviewInt.goh"

/* the parameters of the tables */
#define P_ARROW_WIDTH		0x5000
#define P_ARROW_HEIGHT		0x6000
#define P_BEGIN_REGION		0x7000
#define P_END_REGION		0x8000
#define P_ARROW_MID		0x9000
#define P_END_MINUS_ARROW	0xa000

/* ArrowBitmaps (the asm's word offsets halved) */
#define AB_INSIDE_UP_ARROW	0
#define AB_OUTSIDE_UP_ARROW	1
#define AB_INSIDE_DOWN_ARROW	2
#define AB_OUTSIDE_DOWN_ARROW	3
#define AB_INSIDE_LEFT_ARROW	4
#define AB_OUTSIDE_LEFT_ARROW	5
#define AB_INSIDE_RIGHT_ARROW	6
#define AB_OUTSIDE_RIGHT_ARROW	7

/* the routines of the parts */
typedef enum {
    SBR_UP_ARROW, SBR_THUMB, SBR_PAGE, SBR_PAGE_AVOID_SHADOW,
    SBR_PAGE_LIGHT, SBR_TEXT_PAGE_UP, SBR_TEXT_PAGE_DN, SBR_DN_ARROW
} SBRoutine;

typedef struct {
    SBRoutine	SBP_routine;
    const word	*SBP_data;
} SBPart;

/* the tables (vertScrollbar ... horizTextGauge of the asm) */
static const word vertScrollbar_0[] = {
    1, P_ARROW_WIDTH+1, P_ARROW_MID, 2,
    P_ARROW_MID+1, 2, P_ARROW_WIDTH, P_ARROW_HEIGHT,
    P_ARROW_MID+2, 2, P_ARROW_WIDTH+1, P_ARROW_HEIGHT,
    2, P_ARROW_HEIGHT, P_ARROW_WIDTH, P_ARROW_HEIGHT,
    2, P_ARROW_HEIGHT+1, P_ARROW_WIDTH+1, P_ARROW_HEIGHT+1,
    1, 1, AB_INSIDE_UP_ARROW,
    1, 1, AB_OUTSIDE_UP_ARROW
};
