static const struct { Bitmap h; byte d[28]; } RightOutside14 = {
    { 16, 14, BMC_UNCOMPACTED, BMF_MONO },
    { 0x9f, 0xff, 0x87, 0xff, 0x81, 0xff, 0x80, 0x7f, 0x80, 0x1f, 0x80, 0x07, 0x80, 0x01, 0x80, 0x01, 0x80, 0x07, 0x80, 0x1f, 0x80, 0x7f, 0x81, 0xff, 0x87, 0xff, 0x9f, 0xff }
};

static const Bitmap *const sbBitmaps14[] = {
    &UpInside14.h,
    &UpOutside14.h,
    &DownInside14.h,
    &DownOutside14.h,
    &LeftInside14.h,
    &LeftOutside14.h,
    &RightInside14.h,
    &RightOutside14.h
};

/* ---------------------------------------------------------------------
 * The interpreter (DrawSBPart and the routines of the parts)
 * ------------------------------------------------------------------- */

/* the frame of DrawScrollbar */
typedef struct {
    Color		SBD_ltColor, SBD_rbColor, SBD_fillColor,
			SBD_fillSelColor, SBD_darkColor;
    GStateHandle	SBD_gstate;
    word		SBD_scrLen;
    Boolean		SBD_notSelected;	/* the asm's selected? */
    OLScrollbarAttrs	SBD_attrs;
    Boolean		SBD_updating, SBD_readOnly, SBD_bw;
    word		SBD_arrowSize;
    sword		SBD_posX, SBD_posY;
    word		SBD_param[6];
    char		SBD_valueText[GEN_VALUE_MAX_TEXT_LEN + 1];
    sword		SBD_valueTextPos;
    const word		*SBD_si;		/* the table being drawn */
} SBDraw;

/* ApplySBParam: a coordinate of the table: a number or a parameter
 * plus an offset of less than 100 either way */
static word ApplySBParam(const SBDraw *d, word v)
{
    static const word p[] = {
	P_ARROW_WIDTH, P_ARROW_HEIGHT, P_BEGIN_REGION, P_END_REGION,
	P_ARROW_MID, P_END_MINUS_ARROW
    };
    word i;

    if (v < P_ARROW_WIDTH - 100 || v >= P_END_MINUS_ARROW + 100)
	return v;
    for (i = 0; i < 5 && v >= p[i] + 100; i++)
	;
    return (word) (v - p[i] + d->SBD_param[i]);
}

/* GetSBRect: the next four words, the parameters applied, at the
 * draw position */
static void GetSBRect(SBDraw *d, sword *l, sword *t, sword *r, sword *b)
{
    const word *s = d->SBD_si;

    *l = (sword) (ApplySBParam(d, s[0]) + d->SBD_posX);
    *t = (sword) (ApplySBParam(d, s[1]) + d->SBD_posY);
    *r = (sword) (ApplySBParam(d, s[2]) + d->SBD_posX);
    *b = (sword) (ApplySBParam(d, s[3]) + d->SBD_posY);
    d->SBD_si += 4;
}

static void DrawSBLine(SBDraw *d)
{
    sword l, t, r, b;

    GetSBRect(d, &l, &t, &r, &b);
    GrDrawLine(d->SBD_gstate, l, t, r, b);
}

/* only in black and white (color has no shadow) */
static void DrawSBLineShadow(SBDraw *d)
{
    if (d->SBD_bw)
	DrawSBLine(d);
    else
	d->SBD_si += 4;
}

static void DrawSBLineIfNotTwisted(SBDraw *d)
{
    if (d->SBD_attrs & OLSA_TWISTED)
	d->SBD_si += 4;
    else
	DrawSBLineShadow(d);
}

static void FillSBRect(SBDraw *d)
{
    sword l, t, r, b;

    GetSBRect(d, &l, &t, &r, &b);
    GrFillRect(d->SBD_gstate, l, t, r, b);
}

/* the first rectangle in color, the second in black and white */
static void FillSBRectCustomBW(SBDraw *d)
{
    if (d->SBD_bw)
	d->SBD_si += 4;
    FillSBRect(d);
    if (!d->SBD_bw)
	d->SBD_si += 4;
}

/* FillSBBitmap: the arrow bitmap of the arrow size at the next two
 * words */
static void FillSBBitmap(SBDraw *d)
{
    const word *s = d->SBD_si;
    const Bitmap *const *tab;
    sword x, y;

    x = (sword) (ApplySBParam(d, s[0]) + d->SBD_posX);
    y = (sword) (ApplySBParam(d, s[1]) + d->SBD_posY);
    switch (d->SBD_arrowSize) {
    case 14:	tab = sbBitmaps14; break;
    case 12:	tab = sbBitmaps12; break;
    case 10:	tab = sbBitmaps10; break;
    default:	tab = sbBitmaps8; break;
    }
    GrFillBitmap(d->SBD_gstate, x, y, tab[s[2]], NULL);
    d->SBD_si += 3;
}

/* SetLTColor ... SetRevDarkColor: the colors of a part, selected or
 * not, enabled or not (50%) */
static void SetLTColor(SBDraw *d)
{
    GrSetLineColor(d->SBD_gstate, CF_INDEX,
		   d->SBD_notSelected ? d->SBD_ltColor : C_BLACK, 0, 0);
    if (!(d->SBD_attrs & OLSA_ENABLED))
	GrSetLineMaskSys(d->SBD_gstate, SDM_50);
}

static void SetRBColor(SBDraw *d)
{
    GrSetLineColor(d->SBD_gstate, CF_INDEX,
		   d->SBD_notSelected ? d->SBD_rbColor : d->SBD_ltColor, 0, 0);
    if (!(d->SBD_attrs & OLSA_ENABLED))
	GrSetLineMaskSys(d->SBD_gstate, SDM_50);
}

static void SetFillColor(SBDraw *d)
{
    GrSetAreaColor(d->SBD_gstate, CF_INDEX,
		   d->SBD_notSelected ? d->SBD_fillColor
				      : d->SBD_fillSelColor, 0, 0);
    GrSetAreaMaskSys(d->SBD_gstate,
		     (d->SBD_attrs & OLSA_ENABLED) ? SDM_100 : SDM_50);
}

/* 50% dark (inverse, so the light dots are the reverse's); text too:
 * solid; disabled: none */
static void SetDarkColor(SBDraw *d)
{
    word m = SDM_0;

    GrSetAreaColor(d->SBD_gstate, CF_INDEX, d->SBD_darkColor, 0, 0);
    if (d->SBD_attrs & OLSA_ENABLED)
	m = (d->SBD_attrs & OLSA_TEXT_TOO) ? SDM_100 : (SDM_50 | SDM_INVERSE);
    GrSetAreaMaskSys(d->SBD_gstate, m);
}

static void SetRevDarkColor(SBDraw *d)
{
    GrSetAreaColor(d->SBD_gstate, CF_INDEX, d->SBD_fillColor, 0, 0);
    GrSetAreaMaskSys(d->SBD_gstate,
		     (d->SBD_attrs & OLSA_ENABLED) ? SDM_50 : SDM_0);
}

/* HVUpArrow, HVDnArrow: the bevel, the inside of the arrow in the fill
 * color, the outside 50% dark (in color first the light dots) */
static void ArrowBitmaps(SBDraw *d)
{
    const word *s;

    SetFillColor(d);
    FillSBBitmap(d);
    if (!d->SBD_bw) {
	s = d->SBD_si;
	SetRevDarkColor(d);
	FillSBBitmap(d);
	d->SBD_si = s;
    }
    SetDarkColor(d);
    FillSBBitmap(d);
}

static void HVUpArrow(SBDraw *d)
{
    SetLTColor(d);
    DrawSBLine(d);
    SetRBColor(d);
    DrawSBLine(d);
    DrawSBLineShadow(d);
    DrawSBLine(d);
    DrawSBLineIfNotTwisted(d);
    ArrowBitmaps(d);
}

static void HVDnArrow(SBDraw *d)
{
    SetRBColor(d);
    DrawSBLine(d);
    DrawSBLineShadow(d);
    SetLTColor(d);
    DrawSBLine(d);
    DrawSBLine(d);
    ArrowBitmaps(d);
}

/* HVPageUpDn: 50% dark and light dots */
static void HVPageUpDn(SBDraw *d)
{
    const word *s = d->SBD_si;

    SetDarkColor(d);
    FillSBRect(d);
    d->SBD_si = s;
    SetRevDarkColor(d);
    FillSBRect(d);
}

static void HVPageUpDnAvoidShadow(SBDraw *d)
{
    const word *s = d->SBD_si;

    SetDarkColor(d);
    FillSBRectCustomBW(d);
    d->SBD_si = s;
    SetRevDarkColor(d);
    FillSBRectCustomBW(d);
}

/* HVThumb: the bevel and the fill (black and white: the extra pixel) */
static void HVThumb(SBDraw *d)
{
    SetLTColor(d);
    DrawSBLine(d);
    DrawSBLine(d);
    SetRBColor(d);
    DrawSBLine(d);
    DrawSBLine(d);
    DrawSBLineShadow(d);
    SetFillColor(d);
    FillSBRect(d);
    if (d->SBD_bw) {
	SetFillColor(d);
	HVPageUpDn(d);
    } else
	d->SBD_si += 4;
}

/* HVPageUpDnLight: a gauge's empty part in the light color */
static void HVPageUpDnLight(SBDraw *d)
{
    d->SBD_notSelected = TRUE;
    SetFillColor(d);
    FillSBRect(d);
}

/* HTextPageUp, HTextPageDn: a text gauge's parts with the value in
 * them (white on dark, dark on light) */
static void HTextPage(SBDraw *d, Boolean up)
{
    GStateHandle gs = d->SBD_gstate;
    sword l, t, r, b;

    if (up)
	SetDarkColor(d);
    else
	SetFillColor(d);
    GetSBRect(d, &l, &t, &r, &b);
    GrSetClipRect(gs, PCT_REPLACE, l, t, r, b);
    GrFillRect(gs, l, t, r, b);
    GrSetTextColor(gs, CF_INDEX, up ? C_WHITE : d->SBD_darkColor, 0, 0);
    GrDrawText(gs, (sword) (d->SBD_valueTextPos + d->SBD_posX), t,
	       d->SBD_valueText, 0);
    if (!up)
	GrSetClipRect(gs, PCT_NULL, 0, 0, 0, 0);
}

/* DrawSBPart: the part drawn at x, y for the region from begin to end */
static void DrawSBPart(SBDraw *d, const SBPart *p, sword x, sword y,
		       word begin, word end)
{
    word a = d->SBD_arrowSize;

    d->SBD_posX = x;
    d->SBD_posY = y;
    d->SBD_param[0] = a;
    d->SBD_param[1] = (word) (a + 1);
    d->SBD_param[2] = begin;
    d->SBD_param[3] = end;
    d->SBD_param[4] = (word) (a >> 1);
    d->SBD_param[5] = (word) (end - (a + 1));
    d->SBD_si = p->SBP_data;
    switch (p->SBP_routine) {
    case SBR_UP_ARROW:		HVUpArrow(d); break;
    case SBR_THUMB:		HVThumb(d); break;
    case SBR_PAGE:		HVPageUpDn(d); break;
    case SBR_PAGE_AVOID_SHADOW:	HVPageUpDnAvoidShadow(d); break;
    case SBR_PAGE_LIGHT:	HVPageUpDnLight(d); break;
    case SBR_TEXT_PAGE_UP:	HTextPage(d, TRUE); break;
    case SBR_TEXT_PAGE_DN:	HTextPage(d, FALSE); break;
    case SBR_DN_ARROW:		HVDnArrow(d); break;
    }
}

/* ---------------------------------------------------------------------
 * DrawScrollbar
 * ------------------------------------------------------------------- */

/* SetupDrawColors: black and white, or white and the dark color around
 * the light one */
static void SetupDrawColors(SBDraw *d)
{
    d->SBD_rbColor = d->SBD_ltColor = C_BLACK;
    d->SBD_fillColor = C_WHITE;
    d->SBD_fillSelColor = C_BLACK;
    d->SBD_darkColor = C_BLACK;
    if (!(moCS_flags & CSF_BW)) {
	d->SBD_fillColor = moCS_dsLightColor;
	d->SBD_fillSelColor = d->SBD_rbColor = d->SBD_darkColor =
	    moCS_dsDarkColor;
	d->SBD_ltColor = C_WHITE;
    }
}

/* DrawOutline: the inset frame around the bar (across it only as wide
 * as an arrow and its frame) */
static void DrawOutline(optr oself, GStateHandle gs)
{
    OLScrollbarInstance *sb;
    Rectangle r;
    word colors = C_BLACK | (C_BLACK << 8);
    Color fill = C_WHITE;

    if (!(moCS_flags & CSF_BW)) {
	colors = (word) (moCS_dsDarkColor | (C_WHITE << 8));
	fill = moCS_dsLightColor;
    }
    GrSetAreaColor(gs, CF_INDEX, fill, 0, 0);
    VisGetBounds(oself, &r);
    sb = SBVis(oself);
    if (!(sb->OLSBI_attrs & OLSA_TWISTED)) {
	if (sb->OLSBI_attrs & OLSA_VERTICAL)
	    r.R_right = (sword) (r.R_left + sb->OLSBI_arrowSize + 2);
	else
	    r.R_bottom = (sword) (r.R_top + sb->OLSBI_arrowSize + 2);
    }
    OpenDrawRect(oself, gs, r.R_left, r.R_top, r.R_right, r.R_bottom, colors);
}

/*
 * DrawScrollbar: the outline (unless updating), then the parts: the up
 * arrow (not when updating), the thumb (none read only, twisted or
 * without room), the page up area (none with the thumb at the top), the
 * page down area (none at the bottom or twisted), the down arrow (beside
 * the up arrow when twisted)
 */
void DrawScrollbar(optr oself, GStateHandle gs, Boolean updating)
{
    OLScrollbarInstance *sb;
    const SBPart *p;
    SBDraw d;
    sword x, y, beg, end, lim, top;
    Boolean slider;
    word c;

    memset(&d, 0, sizeof(d));
    d.SBD_gstate = gs;
    d.SBD_updating = updating;
    d.SBD_bw = OpenCheckIfBW();
    if (!updating)
	DrawOutline(oself, gs);
    sb = SBVis(oself);
    d.SBD_attrs = sb->OLSBI_attrs;
    d.SBD_arrowSize = sb->OLSBI_arrowSize;
    d.SBD_readOnly = (SBGen(oself)->GI_attrs & GA_READ_ONLY) != 0;
    SetupDrawColors(&d);

    /* SetupDrawParams: the thumb's beginning and end, the tables */
    sb = SBVis(oself);
    slider = (sb->OLSBI_attrs & OLSA_SLIDER) != 0;
    beg = sb->OLSBI_elevOffset;
    lim = 0;
    if (!slider) {
	beg = (sword) (beg + sb->OLSBI_arrowSize + 3);
	lim = (sword) (sb->OLSBI_arrowSize + 3);
    } else
	beg++;
    end = (sword) (beg + sb->OLSBI_elevLen);
    lim = (sword) (lim + sb->OLSBI_scrArea);
    if (slider)
	lim++;
    if ((word) end > (word) lim)
	end = lim;
    end--;
    sb->OLSBI_attrs |= OLSA_DRAWN_ENABLED;
    if (!(sb->OLSBI_attrs & OLSA_ENABLED))
	sb->OLSBI_attrs &= ~OLSA_DRAWN_ENABLED;
    x = sb->VI_bounds.R_left;
    y = sb->VI_bounds.R_top;
    if (sb->OLSBI_attrs & (OLSA_VERTICAL | OLSA_TWISTED)) {
	p = vertScrollbar;
	d.SBD_scrLen = (word) (sb->VI_bounds.R_bottom - 1 - y);
	if (slider)
	    p = d.SBD_readOnly ? vertGauge : vertSlider;
    } else {
	p = horizScrollbar;
	d.SBD_scrLen = (word) (sb->VI_bounds.R_right - 1 - x);
	if (slider) {
	    p = horizSlider;
	    if (d.SBD_readOnly) {
		p = (sb->OLSBI_attrs & OLSA_TEXT_TOO) ? horizTextGauge
						     : horizGauge;
		if (sb->OLSBI_attrs & OLSA_TEXT_TOO) {
		    @call oself::MSG_GEN_VALUE_GET_VALUE_TEXT(d.SBD_valueText,
							      GVT_VALUE);
		    d.SBD_valueTextPos = (sword) ((sword) (d.SBD_scrLen -
			GrTextWidth(gs, d.SBD_valueText,
				    0)) >> 1);
		}
	    }
	}
    }

    /* DrawUpArrow */
    sb = SBVis(oself);
    if (!slider) {
	if (!updating) {
	    d.SBD_notSelected = (sb->OLSBI_state & OLSS_DOWN_FLAGS) !=
				OLSS_INC_UP;
	    DrawSBPart(&d, p, x, y, (word) beg, (word) end);
	}
	p++;
    }
    if (sb->OLSBI_attrs & OLSA_TWISTED)
	x = (sword) (x + sb->OLSBI_arrowSize);

    /* DrawThumb */
    if (!d.SBD_readOnly) {
	sb = SBVis(oself);
	if ((sb->OLSBI_attrs & OLSA_TWISTED) || sb->OLSBI_elevOffset < 0)
	    p++;
	else {
	    sword b2 = beg;

	    d.SBD_notSelected = TRUE;
	    if (slider) {
		sword mid = (sword) ((word) (end - beg) >> 1) + beg;

		DrawSBPart(&d, p, x, y, (word) beg, (word) mid);
		b2 = (sword) (mid + 1);
	    }
	    DrawSBPart(&d, p, x, y, (word) b2, (word) end);
	    p++;
	}
    }

    /* the page up area */
    sb = SBVis(oself);
    c = (d.SBD_bw && !slider) ? 1 : 0;
    if (sb->OLSBI_elevOffset > (sword) c)
	DrawSBPart(&d, p, x, y, (word) beg, (word) end);
    p++;

    /* the page down area: from the thumb's end to the bar's */
    sb = SBVis(oself);
    beg = end;
    end = (sword) d.SBD_scrLen;
    if (!(sb->OLSBI_attrs & OLSA_TWISTED)) {
	top = 1;
	if (sb->OLSBI_elevOffset >= 0) {
	    top = (sword) (sb->OLSBI_scrArea - sb->OLSBI_elevLen -
			   sb->OLSBI_elevOffset);
	    if (d.SBD_bw && !slider)
		top--;
	}
	if (top > 0) {
	    sword b2 = beg, e2 = end;

	    if (d.SBD_bw) {
		e2++;
		if (sb->OLSBI_elevOffset >= 0)
		    b2++;
	    }
	    DrawSBPart(&d, p, x, y, (word) b2, (word) e2);
	}
    }
    p++;

    /* DrawDownArrow */
    sb = SBVis(oself);
    if (!slider && !updating) {
	d.SBD_notSelected = (sb->OLSBI_state & OLSS_DOWN_FLAGS) !=
			    OLSS_INC_DOWN;
	DrawSBPart(&d, p, x, y, (word) beg, (word) end);
    }
    GrSetLineMaskSys(gs, SDM_100);
    GrSetAreaMaskSys(gs, SDM_100);
}
