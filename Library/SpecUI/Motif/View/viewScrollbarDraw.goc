    1, P_BEGIN_REGION, (P_ARROW_WIDTH+2)-3, P_BEGIN_REGION,
    1, P_BEGIN_REGION, 1, P_END_REGION-1,
    (P_ARROW_WIDTH+2)-2, P_BEGIN_REGION, (P_ARROW_WIDTH+2)-2, P_END_REGION,
    1, P_END_REGION, (P_ARROW_WIDTH+2)-2, P_END_REGION,
    2, P_END_REGION+1, (P_ARROW_WIDTH+2)-2, P_END_REGION+1,
    2, P_BEGIN_REGION+1, (P_ARROW_WIDTH+2)-2, P_END_REGION,
    1, P_END_REGION+1, 1, P_END_REGION+1
};
