    P_ARROW_WIDTH, P_END_MINUS_ARROW, P_ARROW_MID+1, P_END_REGION-2,
    P_ARROW_WIDTH+1, P_END_MINUS_ARROW, P_ARROW_MID+2, P_END_REGION-2,
    1, P_END_MINUS_ARROW, P_ARROW_WIDTH-1, P_END_MINUS_ARROW,
    1, P_END_MINUS_ARROW, P_ARROW_MID, P_END_REGION-2,
