/*
 * cspecItem.goc -- the build routines of the item groups and their
 * items (after cspecItem.asm): a GenItemGroup, GenBooleanGroup or
 * GenDynamicList is an OLItemGroup, with HINT_ITEM_GROUP_SCROLLABLE
 * (HINT_BOOLEAN_GROUP_SCROLLABLE) an OLScrollList; an item of a
 * scrolling list is an OLScrollableItem, of a non exclusive group (a
 * boolean) an OLCheckedItem, else an OLItem.
 */
@include "CItem/citemInt.goh"

ClassStruct *OLBuildItemGroup(optr oself, word masterOffset)
{
    (void) masterOffset;
    if (ObjVarFindData(oself, HINT_ITEM_GROUP_SCROLLABLE))
	return (ClassStruct *) &OLScrollListClass;
    return (ClassStruct *) &OLItemGroupClass;
}

ClassStruct *OLBuildBooleanGroup(optr oself, word masterOffset)
{
    (void) masterOffset;
    if (ObjVarFindData(oself, HINT_BOOLEAN_GROUP_SCROLLABLE))
	return (ClassStruct *) &OLScrollListClass;
    return (ClassStruct *) &OLItemGroupClass;
}

ClassStruct *OLBuildDynamicList(optr oself, word masterOffset)
{
    return OLBuildItemGroup(oself, masterOffset);
}

ClassStruct *OLBuildItem(optr oself, word masterOffset)
{
    OLItemParentState ps;

    (void) masterOffset;
    (void) OLItemGetParentState(oself, &ps);
    if (ps.PS_state & OLIGS_SCROLLABLE)
	return (ClassStruct *) &OLScrollableItemClass;
    if (ps.PS_behavior == GIGBT_NON_EXCLUSIVE)
	return (ClassStruct *) &OLCheckedItemClass;
    return (ClassStruct *) &OLItemClass;
}

ClassStruct *OLBuildBoolean(optr oself, word masterOffset)
{
    return OLBuildItem(oself, masterOffset);
}
