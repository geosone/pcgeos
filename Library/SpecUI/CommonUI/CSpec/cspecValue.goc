/*
 * cspecValue.goc -- the build routine of the value (after
 * cspecValue.asm): a GenValue with HINT_VALUE_X_SCROLLER or
 * HINT_VALUE_Y_SCROLLER is an OLScrollbar, with HINT_SPEC_SLIDER (the
 * scrollbar of a slider) too; any other is an OLValue, the spin gadget.
 *
 * Port32 (Port32/ABI.md section 13y), not yet: OLSliderClass
 * (HINT_SPEC_SLIDER is built as a scrollbar).
 */
@include "CView/cviewInt.goh"
@include <Internal/SpecUI/olValueClass.goh>

ClassStruct *OLBuildValue(optr oself, word masterOffset)
{
    (void) masterOffset;
    if (ObjVarFindData(oself, HINT_VALUE_X_SCROLLER) ||
	ObjVarFindData(oself, HINT_VALUE_Y_SCROLLER) ||
	ObjVarFindData(oself, HINT_SPEC_SLIDER))
	return (ClassStruct *) &OLScrollbarClass;
    return (ClassStruct *) &OLValueClass;
}
