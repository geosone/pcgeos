/*
 * cviewPane.goc -- OLPaneClass (after cviewPane.asm): the specific part
 * of a GenView.  An OLCtrl with a window of its own (a portal, opened in
 * cviewPaneWindow.goc) that shows the content; the view's scrollbars
 * (GenValues it creates unless the application gave them) and the other
 * generic children sit in four areas left, above, right of and below
 * the window (an OLCtrl made for an area with more than one object).
 * Building, the areas, the focus and target (passed on to the content),
 * the keys that scroll, a new content, the scrollbars told of the
 * document.  The size is cviewPaneGeometry.goc's, scrolling
 * cviewPaneScroll.goc's.
 *
 * Port32 (Port32/ABI.md section 13y), not yet: linked views
 * (MSG_GEN_VIEW_SEND_TO_LINKS for scrolling), scaling
 * (cviewPaneScale.asm: MSG_GEN_VIEW_SET_SCALE_FACTOR, scale to fit),
 * ink, drag scrolling and the quick transfer's wandering grab.
 */
@include "CView/cviewInt.goh"
@include <Internal/flowC.goh>

@classdecl OLPaneClass, neverSaved;

/* (in cviewPaneGeometry.goc, cviewPaneScroll.goc, cviewPaneWindow.goc) */
@extern method OLPaneClass, MSG_VIS_RECALC_SIZE;
@extern method OLPaneClass, MSG_VIS_POSITION_BRANCH;
@extern method OLPaneClass, MSG_VIS_INVALIDATE;
@extern method OLPaneClass, MSG_VIS_NOTIFY_GEOMETRY_VALID;
@extern method OLPaneClass, MSG_GEN_VIEW_REDRAW_CONTENT;
