@extern method OLPaneClass, MSG_GEN_VIEW_SET_ORIGIN_LOW;
@extern method OLPaneClass, MSG_SPEC_VIEW_INIT_ORIGIN;
@extern method OLPaneClass, MSG_GEN_VIEW_MAKE_RECT_VISIBLE;
@extern method OLPaneClass, MSG_META_CONTENT_TRACK_SCROLLING;
