@extern method OLPaneClass, MSG_GEN_VIEW_SCROLL_LEFT_EDGE;
@extern method OLPaneClass, MSG_GEN_VIEW_SCROLL_RIGHT_EDGE;
@extern method OLPaneClass, MSG_GEN_VIEW_SCROLL_SET_X_ORIGIN;
@extern method OLPaneClass, MSG_GEN_VIEW_SCROLL_SET_Y_ORIGIN;
@extern method OLPaneClass, MSG_GEN_VIEW_SET_ORIGIN;
