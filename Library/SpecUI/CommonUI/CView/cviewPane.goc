@extern method OLPaneClass, MSG_VIS_CLOSE_WIN;
@extern method OLPaneClass, MSG_VIS_MOVE_RESIZE_WIN;
@extern method OLPaneClass, MSG_VIS_DRAW;
@extern method OLPaneClass, MSG_META_END_SELECT, MSG_META_DRAG_SELECT,
	MSG_META_START_MOVE_COPY, MSG_META_DRAG_MOVE_COPY, MSG_META_DRAG_FEATURES,
