/*
 * cviewVariable.goc -- after cviewVariable.def: the keys of the text
 * object (textKbdBindings, CUA style) and what each does, in the order
 * of the table (the handler list after it in the .def file).
 * SpecGetTextKbdBindings (copenTextCommon.goc) hands them out.
 */
@include "cGeode.goh"

#define UKEY(k)		((KS_CHAR_SET_CONTROL << 8) | (k))

/* the text object's keys (cviewVariable.def, CUA style): not special */
const KeyboardShortcut textKbdBindings[TEXT_KBD_BINDING_COUNT] = {
    KS_PHYSICAL | KS_CTRL | KS_SHIFT | UKEY(VC_LEFT),
    KS_PHYSICAL | KS_CTRL | KS_SHIFT | UKEY(VC_RIGHT),
    KS_PHYSICAL | KS_CTRL | KS_SHIFT | UKEY(VC_UP),
    KS_PHYSICAL | KS_CTRL | KS_SHIFT | UKEY(VC_DOWN),
    KS_PHYSICAL | KS_CTRL | KS_SHIFT | UKEY(VC_HOME),
    KS_PHYSICAL | KS_CTRL | KS_SHIFT | UKEY(VC_END),
    KS_PHYSICAL | KS_CTRL | UKEY(VC_LEFT),
    KS_PHYSICAL | KS_CTRL | UKEY(VC_RIGHT),
    KS_PHYSICAL | KS_CTRL | UKEY(VC_UP),
    KS_PHYSICAL | KS_CTRL | UKEY(VC_DOWN),
    KS_PHYSICAL | KS_CTRL | UKEY(VC_HOME),
    KS_PHYSICAL | KS_CTRL | UKEY(VC_END),
    KS_PHYSICAL | KS_SHIFT | UKEY(VC_LEFT),
    KS_PHYSICAL | KS_SHIFT | UKEY(VC_RIGHT),
    KS_PHYSICAL | KS_SHIFT | UKEY(VC_UP),
    KS_PHYSICAL | KS_SHIFT | UKEY(VC_DOWN),
    KS_PHYSICAL | KS_SHIFT | UKEY(VC_HOME),
    KS_PHYSICAL | KS_SHIFT | UKEY(VC_END),
    UKEY(VC_UP), UKEY(VC_DOWN), UKEY(VC_LEFT), UKEY(VC_RIGHT),
    UKEY(VC_HOME), UKEY(VC_END), UKEY(VC_BACKSPACE), UKEY(VC_DEL),
    KS_SHIFT | UKEY(VC_BACKSPACE), KS_SHIFT | UKEY(VC_DEL),
    KS_CTRL | UKEY(VC_BACKSPACE), KS_CTRL | UKEY(VC_DEL),
    KS_CTRL | KS_SHIFT | UKEY(VC_BACKSPACE),
    KS_PHYSICAL | KS_CTRL | KS_SHIFT | UKEY(VC_DEL),
    KS_PHYSICAL | KS_CTRL | (KS_CHAR_SET_PRINTABLE << 8) | ' ',
    KS_PHYSICAL | KS_ALT | UKEY(VC_INS),
    KS_PHYSICAL | UKEY(VC_INS),
    KS_CTRL | KS_SHIFT | (KS_CHAR_SET_PRINTABLE << 8) | '"',
    KS_CTRL | KS_SHIFT | (KS_CHAR_SET_PRINTABLE << 8) | '\'',
    KS_CTRL | (KS_CHAR_SET_PRINTABLE << 8) | '"',
    KS_CTRL | (KS_CHAR_SET_PRINTABLE << 8) | '\'',
    KS_PHYSICAL | UKEY(VC_JOYSTICK_180),
    KS_PHYSICAL | UKEY(VC_JOYSTICK_0)
};

/* what the keys do, in the order of the table (VisTextKeyFunction) */
const word textKbdFunctions[TEXT_KBD_BINDING_COUNT] = {
    VTKF_SELECT_ADJUST_BACKWARD_WORD, VTKF_SELECT_ADJUST_FORWARD_WORD,
    VTKF_SELECT_ADJUST_BACKWARD_PARAGRAPH,
    VTKF_SELECT_ADJUST_FORWARD_PARAGRAPH,
    VTKF_SELECT_ADJUST_TO_START, VTKF_SELECT_ADJUST_TO_END,
    VTKF_BACKWARD_WORD, VTKF_FORWARD_WORD,
    VTKF_BACKWARD_PARAGRAPH, VTKF_FORWARD_PARAGRAPH,
    VTKF_START_OF_TEXT, VTKF_END_OF_TEXT,
    VTKF_SELECT_ADJUST_BACKWARD_CHAR, VTKF_SELECT_ADJUST_FORWARD_CHAR,
    VTKF_SELECT_ADJUST_BACKWARD_LINE, VTKF_SELECT_ADJUST_FORWARD_LINE,
    VTKF_SELECT_ADJUST_START_OF_LINE, VTKF_SELECT_ADJUST_END_OF_LINE,
    VTKF_BACKWARD_LINE, VTKF_FORWARD_LINE,
    VTKF_BACKWARD_CHAR, VTKF_FORWARD_CHAR,
    VTKF_START_OF_LINE, VTKF_END_OF_LINE,
    VTKF_DELETE_BACKWARD_CHAR, VTKF_DELETE_CHAR,
    VTKF_DELETE_BACKWARD_CHAR, VTKF_DELETE_CHAR,
    VTKF_DELETE_BACKWARD_WORD, VTKF_DELETE_WORD,
    VTKF_DELETE_BACKWARD_LINE, VTKF_DELETE_LINE,
    VTKF_SELECT_WORD, VTKF_DESELECT, VTKF_TOGGLE_OVERSTRIKE_MODE,
    VTKF_TOGGLE_SMART_QUOTES, VTKF_TOGGLE_SMART_QUOTES,
    VTKF_TOGGLE_SMART_QUOTES, VTKF_TOGGLE_SMART_QUOTES,
    VTKF_BACKWARD_CHAR, VTKF_FORWARD_CHAR
};
