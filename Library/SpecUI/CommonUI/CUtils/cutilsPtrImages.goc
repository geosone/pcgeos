/* OpenGetPtrImage: the PointerDef of an OLPtrImage (OLPI_NONE and
 * unknown ones: none) */
optr OpenGetPtrImage(OLPtrImage image)
{
    switch (image) {
    case 1:
	return @pBasic;
    case 2:
	return @pX;
    case 3:
	return @pCrosshairs;
    case 4:
	return @pBusy;
    case 5:
	return @pModal;
    case 6:
	return @pMove;
    case 7:
	return @pResizeLeft;
    case 8:
	return @pResizeRight;
    case 9:
	return @pResizeUp;
    case 10:
	return @pResizeDown;
    case 11:
	return @pResizeUpLeftDiag;
    case 12:
	return @pResizeUpRightDiag;
    case 13:
	return @pResizeDownLeftDiag;
    case 14:
	return @pResizeDownRightDiag;
    }
    return NullOptr;
}
