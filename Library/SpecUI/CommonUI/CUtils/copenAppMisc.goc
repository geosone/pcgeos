/*
 * copenAppMisc.goc -- OLApplicationClass (after copenAppMisc.asm): the
 * application's units, its exclusives asked for, the keyboard (the
 * application's shortcuts, accelerators, input ignored), the navigation
 * between windows and applications, the gadget timer, the host's
 * display size.
 *
 * Port32 (Port32/ABI.md section 13y), not yet: the task bar's
 * windows (the task bar is not ported), the windows told of a new
 * field size.
 *
 * The standard dialogs: the template every standard dialog is a copy of
 * (StandardDialogUI, a block that holds nothing but the standard dialog,
 * duplicated for each one put up) is uic -g's of cspecFile.ui, by way of
 * cspecCUAS.ui (cspecCUAS.goh); its pictures are the monikers uic -g
 * writes of cspecCUAS.ui's picture resources.  The application builds
 * one (MSG_GEN_APPLICATION_BUILD_STANDARD_DIALOG, for
 * UserStandardDialog) and runs one without a thread waiting
 * (MSG_GEN_APPLICATION_DO_STANDARD_DIALOG, ..._TIMED_DIALOG: the response
 * is sent to an object).  Port32: the strings are put together before
 * they go into the text's chunk (the asm substitutes in the chunk, and
 * again in what it substituted); MSG_GEN_APPLICATION_BUILD_STANDARD_DIALOG
 * has no help context in C: who builds adds it (CreateHelpHintIfNeeded
 * here, UserStandardDialog in the UI).
 */
@include "cGeode.goh"
@include "cutilsMacro.goh"
@include <Internal/flowC.goh>
@include <Internal/specC.goh>
#include <input.h>
@include "cspecCUAS.goh"
@include <Objects/gTextC.goh>
@include <Objects/gGlyphC.goh>
#include <uDialog.h>
#include <timer.h>
#include <Objects/helpCC.h>

static word OLStdDialogStrLen(const char *s);
static void CreateHelpHintIfNeeded(optr dlg, const char *helpContext,
				   CustomDialogBoxFlags flags);

static OLApplicationInstance *App(optr oself)
{
    return (OLApplicationInstance *) ObjDerefVis(oself);
}

static GenApplicationInstance *GenApp(optr oself)
{
    return (GenApplicationInstance *) ObjDerefGen(oself);
}

@extern method OLApplicationClass, MSG_GEN_APPLICATION_SET_MEASUREMENT_TYPE
{
    pself->OLAI_units = measurementType;
}

/* OLApplicationQueryIfPressIsInk: only the focus application's windows
 * take ink */
@extern method OLApplicationClass, MSG_META_QUERY_IF_PRESS_IS_INK
{
    /* no ink while menus are in stay up mode (the press dismisses them) */
    if (!OLCountStayUpModeMenus(oself) &&
	(App(oself)->OLAI_flowFlags & AFF_FOCUS_APP)) {
	@callsuper();
	return;
    }
    memset(retVal, 0, sizeof(*retVal));
    retVal->inkType = IRV_NO_INK;
    @call oself::MSG_GEN_APPLICATION_INK_QUERY_REPLY(IRV_NO_INK, 0);
}

/* ---------------------------------------------------------------------
 * The exclusives asked for
 * ------------------------------------------------------------------- */

@extern method OLApplicationClass, MSG_META_GET_FOCUS_EXCL
{
    *focusObject = pself->VCNI_focusExcl.FTVMC_OD;
    return TRUE;
}

@extern method OLApplicationClass, MSG_META_GET_MODEL_EXCL
{
    *modelObject = pself->OLAI_modelExcl.FTVMC_OD;
    return TRUE;
}

@extern method OLApplicationClass, MSG_META_GET_TARGET_EXCL
{
    *targetObject = pself->VCNI_targetExcl.FTVMC_OD;
    return TRUE;
}

@extern method OLApplicationClass, MSG_META_GET_TARGET_AT_TARGET_LEVEL
{
    FlowGetTargetAtTargetLevel(oself, VIS_MASTER,
			       APP_OFFSET(VCNI_targetExcl), TL_GEN_APPLICATION,
			       level, retValue);
}

/* OLApplicationSpecResolveMonikerList: the application keeps its list
 * (for the icons of its primaries) */
@extern method OLApplicationClass, MSG_SPEC_RESOLVE_MONIKER_LIST
{
    (void) monikerList;
}

/* OLApplicationSpecUpdateVisMoniker: the primaries update their icons
 * (they may show the application's moniker) */
@extern method OLApplicationClass, MSG_SPEC_UPDATE_VIS_MONIKER
{
    EventHandle ev;

    @callsuper();
    ev = @record GenPrimaryClass::MSG_OL_MENUED_WIN_UPDATE_ICON_MONIKER();
    @call oself::MSG_GEN_SEND_TO_CHILDREN(ev);
}

/* OLApplicationUnwantedKbdEvent: no one takes the key: a beep on the
 * first press */
@extern method OLApplicationClass, MSG_VIS_CONTENT_UNWANTED_KBD_EVENT
{
    (void) character;
    (void) state;
    if (flags & CF_FIRST_PRESS)
	UserStandardSound(SST_NO_INPUT);
}

/* ---------------------------------------------------------------------
 * The keyboard
 * ------------------------------------------------------------------- */

/* the application's shortcuts (Motif, not ISUI) and their messages */
static const KeyboardShortcut appShortcuts[4] = {
    KS_ALT | (KS_CHAR_SET_CONTROL << 8) | VC_ESCAPE,	/* next application */
    KS_ALT | (KS_CHAR_SET_CONTROL << 8) | VC_F6,	/* next window */
    (KS_CHAR_SET_CONTROL << 8) | VC_F3,			/* quit */
    (KS_CHAR_SET_CONTROL << 8) | VC_F1			/* help */
};

/* HardIconBarFunction (Internal/im.def) */
#define HIBF_TOGGLE_EXPRESS_MENU	0

/* LOW_ON_FREE_HANDLES_THRESHOLD (heapInt.def) */
#define LOW_ON_FREE_HANDLES_THRESHOLD	400

/*
 * OLApplicationKbdChar: with input ignored (and no modal window
 * overriding it) the key goes to the field; low on handles, input is
 * ignored until the process caught up
 */
@extern method OLApplicationClass, MSG_META_KBD_CHAR
{
    struct { word c, f, s; } p;

    if (!(pself->OLAI_flowFlags & AFF_OVERRIDE_INPUT_RESTRICTIONS) &&
	pself->OLAI_ignoreInputCount) {
	Boolean done = FALSE;

	p.c = character;
	p.f = flags;
	p.s = state;
	GenCallParent(oself, MSG_META_FUP_KBD_CHAR, &p, sizeof(p), &done,
		      sizeof(done));
	return;
    }
    if (SysGetInfo(SGIT_NUMBER_OF_FREE_HANDLES) <=
	LOW_ON_FREE_HANDLES_THRESHOLD && !pself->OLAI_ignoreInputCount) {
	@call oself::MSG_GEN_APPLICATION_IGNORE_INPUT();
	UserSendToApplicationViaProcess(MSG_GEN_APPLICATION_ACCEPT_INPUT,
					NULL, 0);
    }
    @callsuper();
}

/*
 * OLApplicationFupKbdChar: a key no one in the application took: the
 * accelerators of the modal window, else of the application (the menus
 * in stay-up mode let go then); the application's shortcuts; else the
 * field's
 */
@extern method OLApplicationClass, MSG_META_FUP_KBD_CHAR
{
    static const Message appShortcutMsgs[4] = {
	MSG_OL_APP_NAVIGATE_TO_NEXT_APP,
	MSG_OL_APP_NAVIGATE_TO_NEXT_WINDOW,
	MSG_OL_APPLICATION_QUIT,
	MSG_GEN_APPLICATION_BRING_UP_HELP
    };
    struct { word c, f, s; } p;
    Boolean done = FALSE;
    word off;

    if ((character >> 8) == CS_UI_FUNCS)
	goto callField;
    if (!(pself->OLAI_flowFlags & AFF_OVERRIDE_INPUT_RESTRICTIONS) &&
	pself->OLAI_ignoreInputCount)
	goto callField;
    if (!(flags & (CF_RELEASE | CF_STATE_KEY | CF_TEMP_ACCENT))) {
	if (!UserGetKbdAcceleratorMode())
	    goto afterLocalShortcuts;
	if (character != (word) ((CS_CONTROL << 8) | VC_F1)) {
	    optr m = pself->OLAI_modalWin;

	    /* an accelerator (of the modal window, if one is up) done: the
	     * menus in stay up mode released */
	    if (m) {
		(void) @call m::MSG_GEN_FIND_KBD_ACCELERATOR(character, flags,
							      state);
		OLReleaseAllStayUpModeMenus(oself);
		return TRUE;
	    }
	    if (@call oself::MSG_GEN_FIND_KBD_ACCELERATOR(character, flags,
							  state)) {
		OLReleaseAllStayUpModeMenus(oself);
		return TRUE;
	    }
	}
    }
    if (flags & (CF_STATE_KEY | CF_TEMP_ACCENT) ||
	!(flags & (CF_FIRST_PRESS | CF_REPEAT_PRESS)))
	goto afterLocalShortcuts;
    off = FlowCheckKbdShortcut((KeyboardShortcut *) appShortcuts, 4,
			       character, flags, state);
    if (off != (word) -1 && off / sizeof(KeyboardShortcut) < 4) {
	Message msg = appShortcutMsgs[off / sizeof(KeyboardShortcut)];

	if (msg == MSG_OL_APP_NAVIGATE_TO_NEXT_APP)
	    @call oself::MSG_OL_APP_NAVIGATE_TO_NEXT_APP(0);
	else
	    CObjMessageP(MF_CALL, oself, msg, NULL, 0, NULL, 0);
	return TRUE;
    }
afterLocalShortcuts:
callField:
    p.c = character;
    p.f = flags;
    p.s = state;
    GenCallParent(oself, MSG_META_FUP_KBD_CHAR, &p, sizeof(p), &done,
		  sizeof(done));
    return done;
}

/* OLApplicationTestForCancelMnemonic: Escape, without shift, control or
 * alt */
@extern method OLApplicationClass, MSG_GEN_APPLICATION_TEST_FOR_CANCEL_MNEMONIC
{
    (void) state;
    if (flags.CFASS_shiftState & (SS_LSHIFT | SS_RSHIFT | SS_LCTRL |
				  SS_RCTRL | SS_LALT | SS_RALT))
	return FALSE;
    return (character & 0xff) == VC_ESCAPE;
}

/* ---------------------------------------------------------------------
 * Navigation
 * ------------------------------------------------------------------- */

/* a window the application may go on to: a dialog, an icon or a base
 * window that says it may be (OLANTNW_Callback) */
static Boolean IsPotentialNextWindow(optr w)
{
    if (!@call w::MSG_META_IS_OBJECT_IN_CLASS(&OLDialogWinClass) &&
	!@call w::MSG_META_IS_OBJECT_IN_CLASS(&OLWinIconClass) &&
	!@call w::MSG_META_IS_OBJECT_IN_CLASS(&OLBaseWinClass))
	return FALSE;
    return @call w::MSG_OL_WIN_CHECK_IF_POTENTIAL_NEXT_WINDOW();
}

/*
 * OLApplicationNavigateToNextWindow: unless a modal window is up, the
 * window after the focus window on the application's GAGCNLT_WINDOWS
 * list (raised last first), else the eligible one before it, comes to
 * the top; the old focus window goes behind and to the end of the list
 */
@extern method OLApplicationClass, MSG_OL_APP_NAVIGATE_TO_NEXT_WINDOW
{
    OLApplicationInstance *a = App(oself);
    optr focus = a->VCNI_focusExcl.FTVMC_OD, cur = 0, next = 0, other = 0;
    TempMetaGCNData *g;
    MemHandle mh = OptrToHandle(oself);
    ChunkHandle list;
    word i, n;
    Boolean seen;
    WindowHandle win;

    if (a->OLAI_modalWin)
	return;
    if (focus) {
	cur = @call focus::MSG_VIS_VUP_FIND_OBJECT_OF_CLASS(&OLDialogWinClass);
	if (!cur)
	    cur = @call focus::MSG_VIS_VUP_FIND_OBJECT_OF_CLASS(
							&OLWinIconClass);
	if (!cur)
	    cur = @call focus::MSG_VIS_VUP_FIND_OBJECT_OF_CLASS(
							&OLBaseWinClass);
    }
    g = ObjVarFindData(oself, TEMP_META_GCN);
    if (!g)
	return;
    list = GCNListFindListInBlock(MANUFACTURER_ID_GEOWORKS, GAGCNLT_WINDOWS,
				  mh, g->TMGCND_listOfLists, FALSE);
    if (!list)
	return;
    /* the first eligible one after the focus window; until the focus
     * window is seen, the last eligible one before it (wrapped to) */
    seen = (cur == 0);
    n = ChunkArrayGetCount(ConstructOptr(mh, list));
    for (i = 0; i < n && !next; i++) {
	optr item;
	Boolean ok;

	memcpy(&item, &((GCNListElement *) ChunkArrayElementToPtr(
			    ConstructOptr(mh, list), i, NULL))->GCNLE_item,
	       sizeof(item));
	ok = IsPotentialNextWindow(item);
	if (seen) {
	    if (ok)
		next = item;
	} else if (item == cur)
	    seen = TRUE;
	else if (ok)
	    other = item;
    }
    if (!next)
	next = other;
    if (!next)
	return;
    @call next::MSG_GEN_BRING_TO_TOP();
    if (!cur)
	return;
    win = @call cur::MSG_VIS_QUERY_WINDOW();
    if (!win)
	return;
    WinChangePriority(win, WPF_PLACE_BEHIND, 0);
    @call oself::MSG_GEN_APPLICATION_LOWER_WINDOW_TO_BOTTOM(cur);
}

/*
 * OLApplicationNavigateToNextApp: the field finds the next application
 * (this one lowered then, unless an event is passed)
 */
@extern method OLApplicationClass, MSG_OL_APP_NAVIGATE_TO_NEXT_APP
{
    EventHandle ev;

    if (!event)
	event = @record oself::MSG_GEN_LOWER_TO_BOTTOM();
    ev = @record OLFieldClass::MSG_OL_FIELD_NAVIGATE_TO_NEXT_APP(oself,
								    event);
    @call oself::MSG_GEN_GUP_SEND_TO_OBJECT_OF_CLASS(ev);
}

/*
 * OLApplicationTryNavigateToApp: to this application if it can take
 * the focus (then the event: the previous one lowered, unless it is
 * this one), else on to the next
 */
@extern method OLApplicationClass, MSG_OL_APP_TRY_NAVIGATE_TO_APP
{
    optr dest = 0;

    if (!(GenApp(oself)->GAI_states & AS_FOCUSABLE) ||
	(GenApp(oself)->GAI_states & AS_NOT_USER_INTERACTABLE)) {
	@call oself::MSG_OL_APP_NAVIGATE_TO_NEXT_APP(event);
	return;
    }
    @call oself::MSG_GEN_BRING_TO_TOP();
    if (!event)
	return;
    (void) ObjGetMessageInfo(event, &dest);
    if (dest == oself)
	ObjFreeMessage(event);
    else
	CMessageDispatchP(event, 0, NULL, 0);
}

/* ---------------------------------------------------------------------
 * The gadget timer
 * ------------------------------------------------------------------- */

/* OLApplicationStartTimer: a one-shot timer for the object (with the
 * gadget exclusive); MSG_TIMER_EXPIRED goes to it */
@extern method OLApplicationClass, MSG_OL_APP_START_TIMER
{
    word id = 0;
    TimerHandle t;

    if (!ticks)
	ticks = olGadgetRepeatDelay;
    pself->OLAI_timerOD = od;
    t = TimerStart(TIMER_EVENT_ONE_SHOT, oself, ticks, MSG_TIMER_EXPIRED, 0,
		   &id);
    pself = App(oself);
    pself->OLAI_timerID = id;
    pself->OLAI_timerHandle = t;
}

@extern method OLApplicationClass, MSG_OL_APP_STOP_TIMER
{
    TimerHandle t;
    word id;

    if (od != pself->OLAI_timerOD)
	return;
    t = pself->OLAI_timerHandle;
    id = pself->OLAI_timerID;
    pself->OLAI_timerID = 0;
    pself->OLAI_timerHandle = 0;
    pself->OLAI_timerOD = 0;
    if (t)
	TimerStop(t, id);
}

/* OLApplicationTimerExpired: on to the object, unless the timer is an
 * old one or was stopped */
@extern method OLApplicationClass, MSG_TIMER_EXPIRED
{
    optr od;

    if (pself->OLAI_timerID != timerID)
	return;
    od = pself->OLAI_timerOD;
    pself->OLAI_timerOD = 0;
    if (!od || !pself->OLAI_timerHandle)
	return;
    pself->OLAI_timerHandle = 0;
    pself->OLAI_timerID = 0;
    @send od::MSG_TIMER_EXPIRED(tick, timerID);
}

/* ---------------------------------------------------------------------
 * Notifications
 * ------------------------------------------------------------------- */

/* NukeExpressMenu: the field's express menu down */
static void NukeExpressMenu(optr oself)
{
    EventHandle ev = @record OLFieldClass::
			MSG_OL_FIELD_RELEASE_EXPRESS_MENU();

    @call oself::MSG_VIS_VUP_CALL_OBJECT_OF_CLASS(ev);
}

/* OLApplicationStartSelect: a press in the application takes the
 * express menu down */
@extern method OLApplicationClass, MSG_META_START_SELECT, MSG_META_START_MOVE_COPY
{
    NukeExpressMenu(oself);
    @callsuper();
}

/*
 * OLApplicationNotify: the host's display (the field) changed size: the
 * application's size follows (the windows told: not yet); an indexed
 * application starting or a hard icon bar function takes the express
 * menu down
 */
@extern method OLApplicationClass, MSG_META_NOTIFY
{
    if (manufID == MANUFACTURER_ID_GEOWORKS) {
	if (notificationType == GWNT_HOST_SCREEN_FIELD_SIZE_CHANGE) {
	    SizeAsDWord ps = 0, s;

	    VisCallParent(oself, MSG_VIS_GET_SIZE, NULL, 0, &ps, sizeof(ps));
	    s = @call oself::MSG_VIS_GET_SIZE();
	    if (s != ps)
		@call oself::MSG_VIS_SET_SIZE(DWORD_WIDTH(ps),
					      DWORD_HEIGHT(ps));
	} else if (notificationType == GWNT_STARTUP_INDEXED_APP ||
		   (notificationType == GWNT_HARD_ICON_BAR_FUNCTION &&
		    data != HIBF_TOGGLE_EXPRESS_MENU))
	    NukeExpressMenu(oself);
    }
    @callsuper();
}

@extern method OLApplicationClass, MSG_META_NOTIFY_WITH_DATA_BLOCK
{
    if (manufID == MANUFACTURER_ID_GEOWORKS &&
	(notificationType == GWNT_STARTUP_INDEXED_APP ||
	 (notificationType == GWNT_HARD_ICON_BAR_FUNCTION &&
	  (word) data != HIBF_TOGGLE_EXPRESS_MENU)))
	NukeExpressMenu(oself);
    @callsuper();
}

/* OLApplicationToggleCurrentMenuBar: the target's, if it is a base
 * window (a GenPrimary) */
@extern method OLApplicationClass, MSG_GEN_APPLICATION_TOGGLE_CURRENT_MENU_BAR
{
    optr t = App(oself)->VCNI_targetExcl.FTVMC_OD;

    if (t && @call t::MSG_META_IS_OBJECT_IN_CLASS(&OLBaseWinClass))
	@call t::MSG_OL_BASE_WIN_TOGGLE_MENU_BAR();
}

/* OLApplicationToggleExpressMenu: the field's (else the default
 * field's) express menu */
@extern method OLApplicationClass, MSG_GEN_APPLICATION_TOGGLE_EXPRESS_MENU
{
    Boolean isField = FALSE;
    ClassStruct *c = (ClassStruct *) &OLFieldClass;
    optr field = 0;

    if (GenCallParent(oself, MSG_META_IS_OBJECT_IN_CLASS, &c, sizeof(c),
		      &isField, sizeof(isField)) && isField) {
	GenCallParent(oself, MSG_OL_FIELD_TOGGLE_EXPRESS_MENU, NULL, 0, NULL,
		      0);
	return;
    }
    UserCallSystem(MSG_GEN_SYSTEM_GET_DEFAULT_FIELD, NULL, 0, &field,
		   sizeof(field));
    if (field)
	@send field::MSG_OL_FIELD_TOGGLE_EXPRESS_MENU();
}

/* the windows' positions for the task bar: not yet (OLWinClass) */
@extern method OLApplicationClass, MSG_OL_APP_UPDATE_WINDOWS_FOR_TASK_BAR
{
}

/* the table of response triggers a GIT_MULTIPLE_RESPONSE dialog is
 * passed (StandardDialogResponseTriggerTable) */
typedef struct {
    word				SDRTT_numTriggers;
    StandardDialogResponseTriggerEntry	SDRTT_triggers[1];
} StdDialogTriggers;

/* SubstituteStringArg, for both: the string with arg1 for each
 * C_CTRL_A and arg2 for each C_CTRL_B, written to dest if there is
 * one; its size with the null */
static word Substitute(char *dest, const char *s, const char *arg1,
		       const char *arg2)
{
    word n = 0;

    for (; *s; s++) {
	const char *a = (*s == C_CTRL_A) ? arg1 :
			(*s == C_CTRL_B) ? arg2 : NULL;

	if (!a) {
	    if (dest)
		dest[n] = *s;
	    n++;
	    continue;
	}
	if (dest)
	    memcpy(dest + n, a, OLStdDialogStrLen(a));
	n += OLStdDialogStrLen(a);
    }
    if (dest)
	dest[n] = 0;
    return n + 1;
}

/*
 * CreateMultipleResponseTriggers: a trigger in the reply bar per entry,
 * with its moniker and command, completing the interaction.  A
 * destructive action whose first trigger is "Yes" has its default focus
 * on the second one.
 */
static void CreateResponseTriggers(optr dlg, const StdDialogTriggers *t,
				   CustomDialogBoxFlags flags)
{
    word i;

    if (!t)
	return;
    for (i = 0; i < t->SDRTT_numTriggers; i++) {
	const StandardDialogResponseTriggerEntry *e = &t->SDRTT_triggers[i];
	optr trig = OpenCreateChildObject(OptrToHandle(dlg), dlg,
					  &GenTriggerClass,
					  HINT_SEEK_REPLY_BAR, TRUE, FALSE,
					  CCO_LAST);
	word *cmd;

	if (e->SDRTE_moniker)
	    (void) @call trig::MSG_GEN_REPLACE_VIS_MONIKER_OPTR(
					e->SDRTE_moniker, VUM_MANUAL);
	cmd = ObjVarAddData(trig, ATTR_GEN_TRIGGER_INTERACTION_COMMAND,
			    sizeof(word));
	*cmd = e->SDRTE_responseValue;
	if ((flags & CDBF_DESTRUCTIVE_ACTION) && i == 1 &&
	    t->SDRTT_triggers[0].SDRTE_responseValue == IC_YES)
	    (void) ObjVarAddData(trig, HINT_DEFAULT_FOCUS, 0);
	((GenInstance *) ObjDerefGen(trig))->GI_attrs |=
					GA_SIGNAL_INTERACTION_COMPLETE;
    }
}

/*
 * OLApplicationBuildStandardDialog: a copy of the standard dialog
 * (owned by the caller's geode, run by its thread) with the picture of
 * its type, its interaction type, the response triggers and the text;
 * the application's last child, usable.  0 if the application is
 * detaching.
 */
@extern method OLApplicationClass, MSG_GEN_APPLICATION_BUILD_STANDARD_DIALOG
{
    MemHandle bh;
    optr dlg, glyph, text;
    ChunkHandle mkr;
    GenInteractionInstance *gi;
    GenInteractionType type;

    (void) pself;
    if (((GenApplicationInstance *) ObjDerefGen(oself))->GAI_states &
	AS_DETACHING)
	return 0;
    bh = ObjDuplicateResource(OptrToHandle(@StandardDialogSummons), 0, 0);
    dlg = ConstructOptr(bh, OptrToChunk(@StandardDialogSummons));
    glyph = ConstructOptr(bh, OptrToChunk(@StdDialogCuteGlyph));
    text = ConstructOptr(bh, OptrToChunk(@StdDialogText));
    switch ((dialogFlags & CDBF_DIALOG_TYPE) >> CDBF_DIALOG_TYPE_OFFSET) {
    case CDT_QUESTION:
	mkr = OptrToChunk(@StdDialogQuestionMoniker);
	break;
    case CDT_WARNING:
	mkr = OptrToChunk(@StdDialogWarningMoniker);
	break;
    case CDT_NOTIFICATION:
	mkr = OptrToChunk(@StdDialogNotificationMoniker);
	break;
    default:
	mkr = OptrToChunk(@StdDialogErrorMoniker);
	break;
    }
    ((GenInstance *) ObjDerefGen(glyph))->GI_visMoniker = mkr;
    gi = (GenInteractionInstance *) ObjDerefGen(dlg);
    if (dialogFlags & CDBF_SYSTEM_MODAL) {
	gi->GII_attrs |= GIA_SYS_MODAL;
	gi->GII_attrs &= ~GIA_MODAL;
    }
    type = (GenInteractionType) ((dialogFlags & CDBF_INTERACTION_TYPE) >>
				 CDBF_INTERACTION_TYPE_OFFSET);
    gi->GII_type = type;
    if (type == GIT_MULTIPLE_RESPONSE)
	CreateResponseTriggers(dlg, (const StdDialogTriggers *) customTriggers,
			       dialogFlags);
    if (string) {
	(void) LMemReAlloc(text, Substitute(NULL, string, arg1, arg2));
	(void) Substitute(LMemDeref(text), string, arg1, arg2);
    }
    @call oself::MSG_GEN_ADD_CHILD(dlg, CCO_LAST);
    @call dlg::MSG_GEN_SET_USABLE(VUM_MANUAL);
    return dlg;
}

static OLAStdDialog *StdDialog(optr app, ChunkHandle d)
{
    return (OLAStdDialog *) LMemDerefHandles(OptrToHandle(app), d);
}

/*
 * OLApplicationDoStandardDialog: a standard dialog whose response goes
 * to an object: the dialog is described by a chunk in the application's
 * chain, its interaction command comes back here
 * (TEMP_GEN_INTERACTION_WITH_ACTION_RESPONSE) with that chunk.  Not
 * built (detaching): IC_NULL is the response, through the queue.
 */
static void DoStandardDialog(optr oself, word timeout, Boolean timed,
			     Message dialogMethod, optr dialogOD,
			     const char *helpContext,
			     const char *customTriggers, const char *arg2,
			     const char *arg1, const char *string,
			     CustomDialogBoxFlags dialogFlags)
{
    ChunkHandle d = LMemAlloc(OptrToHandle(oself), sizeof(OLAStdDialog));
    optr dlg = @call oself::MSG_GEN_APPLICATION_BUILD_STANDARD_DIALOG(
				(char *) customTriggers, (char *) arg2,
				(char *) arg1, (char *) string, dialogFlags);
    OLAStdDialog *s;
    OLApplicationInstance *a;
    ActionDescriptor *ad;
    word id = 0;
    TimerHandle timer = 0;

    if (!dlg) {
	LMemFreeHandles(OptrToHandle(oself), d);
	@send, forceQueue dialogOD::{GEN_APP_DO_STANDARD_DIALOG_MSG}
						(dialogMethod)(IC_NULL);
	return;
    }
    CreateHelpHintIfNeeded(dlg, helpContext, dialogFlags);
    if (timed)
	timer = TimerStart(TIMER_EVENT_ONE_SHOT, oself, timeout,
			   MSG_OL_APP_TIMED_DIALOG_TIMER_EXPIRED, 0, &id);
    a = (OLApplicationInstance *) ObjDerefVis(oself);
    s = StdDialog(oself, d);
    s->OLASD_responseOD = dialogOD;
    s->OLASD_responseMsg = dialogMethod;
    s->OLASD_summons = dlg;
    s->OLASD_timerHandle = timer;
    s->OLASD_timerId = id;
    s->OLASD_next = a->OLAI_stdDialogs;
    a->OLAI_stdDialogs = d;
    ad = ObjVarAddData(dlg, TEMP_GEN_INTERACTION_WITH_ACTION_RESPONSE,
		       sizeof(ActionDescriptor) + sizeof(word));
    ad->AD_OD = oself;
    ad->AD_message = MSG_OL_APP_DO_DIALOG_RESPONSE;
    *(word *) (ad + 1) = d;
    @call dlg::MSG_GEN_INTERACTION_INITIATE();
    /* the sound of an error or a warning */
    switch ((dialogFlags & CDBF_DIALOG_TYPE) >> CDBF_DIALOG_TYPE_OFFSET) {
    case CDT_ERROR:
	UserStandardSound(SST_ERROR);
	break;
    case CDT_WARNING:
	UserStandardSound(SST_WARNING);
	break;
    }
}

@extern method OLApplicationClass, MSG_GEN_APPLICATION_DO_STANDARD_DIALOG
{
    (void) pself;
    DoStandardDialog(oself, 0, FALSE, dialogMethod, dialogOD, helpContext,
		     customTriggers, arg2, arg1, string, dialogFlags);
}

@extern method OLApplicationClass,
	MSG_GEN_APPLICATION_DO_STANDARD_TIMED_DIALOG
{
    (void) pself;
    DoStandardDialog(oself, timeout, TRUE, dialogMethod, dialogOD,
		     helpContext, customTriggers, arg2, arg1, string,
		     dialogFlags);
}

/*
 * OLApplicationDoDialogResponse: a standard dialog is answered: off the
 * chain (its timer stopped), the dialog off the window list, taken out
 * and its block freed; the response goes to who asked (sent: that may
 * be another thread)
 */
@extern method OLApplicationClass, MSG_OL_APP_DO_DIALOG_RESPONSE
{
    ChunkHandle *link = &pself->OLAI_stdDialogs;
    OLAStdDialog s;

    while (*link && *link != stdDialog)
	link = &StdDialog(oself, *link)->OLASD_next;
    if (!*link)
	return;
    s = *StdDialog(oself, stdDialog);
    *link = s.OLASD_next;
    LMemFreeHandles(OptrToHandle(oself), stdDialog);
    if (s.OLASD_timerId)
	(void) TimerStop(s.OLASD_timerHandle, s.OLASD_timerId);
    (void) @call oself::MSG_META_GCN_LIST_REMOVE(s.OLASD_summons,
						 GAGCNLT_WINDOWS,
						 MANUFACTURER_ID_GEOWORKS);
    @call s.OLASD_summons::MSG_GEN_SET_NOT_USABLE(VUM_NOW);
    @call oself::MSG_GEN_REMOVE_CHILD(s.OLASD_summons, 0);
    @send s.OLASD_summons::MSG_META_BLOCK_FREE();
    @send s.OLASD_responseOD::{GEN_APP_DO_STANDARD_DIALOG_MSG}
				(s.OLASD_responseMsg)(response);
}

/* OLApplicationTimedDialogTimerExpired: a timed dialog not answered
 * yet is answered with IC_NULL */
@extern method OLApplicationClass, MSG_OL_APP_TIMED_DIALOG_TIMER_EXPIRED
{
    ChunkHandle d;

    (void) tick;
    for (d = pself->OLAI_stdDialogs; d; d = StdDialog(oself, d)->OLASD_next)
	if (StdDialog(oself, d)->OLASD_timerId == timerID) {
	    @call oself::MSG_OL_APP_DO_DIALOG_RESPONSE(IC_NULL, d);
	    return;
	}
}

static word OLStdDialogStrLen(const char *s)
{
    word n = 0;

    while (s[n])
	n++;
    return n;
}

/* CreateHelpHintIfNeeded: the help context of a standard dialog (a
 * system modal one has help of its own type) */
static void CreateHelpHintIfNeeded(optr dlg, const char *helpContext,
		     CustomDialogBoxFlags flags)
{
    word n;

    if (!helpContext || !dlg)
	return;
    n = OLStdDialogStrLen(helpContext) + 1;
    memcpy(ObjVarAddData(dlg, ATTR_GEN_HELP_CONTEXT, n), helpContext, n);
    if (flags & CDBF_SYSTEM_MODAL)
	*(byte *) ObjVarAddData(dlg, ATTR_GEN_HELP_TYPE, 1) =
						HT_SYSTEM_MODAL_HELP;
}
