@extern method OLApplicationClass, MSG_GEN_APPLICATION_SET_TASK_ENTRY_MONIKER
{
    (void) entryMoniker;
}

@extern method OLApplicationClass, MSG_OL_APP_UPDATE_TASK_ENTRY
{
    (void) hasFocus;
}

/* OLAppSendToFlow: the mouse's state is the flow object's */
@extern method OLApplicationClass, MSG_VIS_VUP_TERMINATE_ACTIVE_MOUSE_FUNCTION
{
    optr flow = UserGetFlowObject();

    if (flow)
	@call flow::MSG_VIS_VUP_TERMINATE_ACTIVE_MOUSE_FUNCTION();
}

@extern method OLApplicationClass, MSG_VIS_VUP_GET_MOUSE_STATUS
{
    optr flow = UserGetFlowObject();

    return flow ? @call flow::MSG_VIS_VUP_GET_MOUSE_STATUS() : 0;
}

@extern method OLApplicationClass, MSG_VIS_VUP_BUMP_MOUSE
{
    optr flow = UserGetFlowObject();

    if (flow)
	@call flow::MSG_VIS_VUP_BUMP_MOUSE(xBump, yBump);
}

/* OLApplicationGetMeasurementType: the application's units, the
 * system's for AMT_DEFAULT; the application's in the high byte */
@extern method OLApplicationClass, MSG_GEN_APPLICATION_GET_MEASUREMENT_TYPE
{
    WholeMeasurementType w;

    w.WMT_appMeasurementType = pself->OLAI_units;
    w.WMT_measurementType = pself->OLAI_units == AMT_DEFAULT
			    ? (MeasurementType) LocalGetMeasurementType()
			    : (MeasurementType) pself->OLAI_units;
    return w;
}
