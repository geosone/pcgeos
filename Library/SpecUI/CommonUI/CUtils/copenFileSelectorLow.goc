/*
 * copenFileSelectorLow.goc -- after copenFileSelectorLow.asm:
 * MSG_OL_FILE_SELECTOR_LIST_MESSAGE, MSG_OL_FILE_SELECTOR_DOUBLE_PRESS,
 * MSG_GEN_FILE_SELECTOR_UP_DIRECTORY,
 * MSG_OL_FILE_SELECTOR_CLOSE_DIR_BUTTON,
 * MSG_OL_FILE_SELECTOR_DOCUMENT_BUTTON, MSG_GEN_FILE_SELECTOR_RESCAN,
 * MSG_GEN_FILE_SELECTOR_OPEN_ENTRY, MSG_GEN_FILE_SELECTOR_SUSPEND,
 * MSG_GEN_FILE_SELECTOR_END_SUSPEND,
 * MSG_SPEC_ACTIVATE_OBJECT_WITH_MNEMONIC,
 * MSG_META_CHECK_IF_INTERACTABLE_OBJECT, MSG_META_KBD_CHAR,
 * MSG_META_FUP_KBD_CHAR, OLFSFindTempData, OLFSStuffDriveAndVolumeName,
 * OLFSResolveSelection, OLFSCopySelection, OLFSBuildEntryFlagsAndSendAD,
 * OLFSUpdateChangeDrivePopupMoniker,
 * OLFSSelectCurrentDriveInChangeDrivePopup, OLFSNotifyUserOfDiskError.
 */
@include "cGeode.goh"
@include "cutilsMacro.goh"
@include "cspecCUAS.goh"
@include <Internal/specC.goh>
@include <Internal/SpecUI/olFileSelectorClass.goh>
@include <Internal/SpecUI/olApplicationClass.goh>
@include <Objects/gInterC.goh>
@include <Objects/gItemC.goh>
#include <fileEnum.h>
#include <disk.h>
#include <drive.h>
@include <gcnlist.goh>
#include <sysstats.h>
#include <chunkarr.h>
#include <localize.h>
#include <gstring.h>
#include <uDialog.h>
@include "cutilsConstant.goh"
/*
 * OLFSRescanLow: the current directory is shown first when directories
 * are; the directory is read; the list gets its number of items and
 * the selection (the entry named by GFSI_selection); the popups follow
 * and the destination is told.  If the focus is among the selector's
 * gadgets the list takes it.
 */
static void RescanLow(optr o)
{
    optr list;
    word entry, n;
    ObjectAndGrabParams q;

    if (GFS(o)->GFSI_fileCriteria & FSFC_DIRS)
	FS(o)->OLFSI_state |= OLFSS_SHOW_PARENT_DIR;
    else
	FS(o)->OLFSI_state &= ~OLFSS_SHOW_PARENT_DIR;
    OLFSFreeBuffers(o);
    OLFSReadList(o);
    (void) OLFSResolveSelection(o, &entry);
    n = FS(o)->OLFSI_numFiles;
    if (FS(o)->OLFSI_state & OLFSS_SHOW_PARENT_DIR)
	n++;
    list = OLFSUIObj(o, @OLFileSelectorFileList);
    if (list) {
	@call list::MSG_GEN_DYNAMIC_LIST_INITIALIZE(n);
	OLFSSetItemSelection(list, entry);
    }
    OLFSShowCurrentDir(o);
    OLFSSelectCurrentDriveInChangeDrivePopup(o);
    OLFSBuildEntryFlagsAndSendAD(o, entry);

    memset(&q, 0, sizeof(q));
    @call o::MSG_VIS_VUP_QUERY_FOCUS_EXCL(&q);
    if (list && OptrToHandle(q.OAGP_object) == OptrToHandle(list))
	@send, forceQueue list::MSG_META_GRAB_FOCUS_EXCL();
}

/* OLFileSelectorListMethod: the list's selection.  With [motif
 * options] fsSingleClickToOpen a single action selector (HINT_FILE_
 * SELECTOR_SINGLE_ACTION) also gets a double press. */
static void ListAction(optr o, word entry)
{
    if (olFileSelectorSingleClickToOpen &&
	(FS(o)->OLFSI_state & OLFSS_SINGLE_ACTION)) {
	struct { word sel; word num; GenItemGroupStateFlags flags; } a;

	a.sel = entry;
	a.num = 1;
	a.flags = 0;
	CObjMessageP(MF_FORCE_QUEUE, o, MSG_OL_FILE_SELECTOR_DOUBLE_PRESS,
		     &a, sizeof(a), NULL, 0);
    }
    HandleFileSelectorUserAction(o, entry, FALSE);
}

@extern method OLFileSelectorClass, MSG_OL_FILE_SELECTOR_LIST_MESSAGE
{
    (void) pself;
    (void) numSelections;
    (void) stateFlags;
    ListAction(oself, selection);
}

@extern method OLFileSelectorClass, MSG_OL_FILE_SELECTOR_DOUBLE_PRESS
{
    (void) pself;
    (void) numSelections;
    (void) stateFlags;
    HandleFileSelectorUserAction(oself, selection, TRUE);
}

/* OLFileSelectorUpDirectory: with the current directory in the list
 * and another entry selected, the selection moves to it; else up */
static void GoUp(optr o)
{
    if ((FS(o)->OLFSI_state & OLFSS_SHOW_PARENT_DIR) && OLFSListSelection(o)) {
	OLFSSetItemSelection(OLFSUIObj(o, @OLFileSelectorFileList), 0);
	OLFSBuildEntryFlagsAndSendAD(o, 0);
	OLFSShowCurrentDir(o);
	return;
    }
    ListAction(o, OLFS_UP_DIRECTORY_ENTRY_NUM);
}

@extern method OLFileSelectorClass, MSG_GEN_FILE_SELECTOR_UP_DIRECTORY
{
    (void) pself;
    GoUp(oself);
}

@extern method OLFileSelectorClass, MSG_OL_FILE_SELECTOR_CLOSE_DIR_BUTTON
{
    (void) pself;
    (void) trigger;
    GoUp(oself);
}

@extern method OLFileSelectorClass, MSG_OL_FILE_SELECTOR_DOCUMENT_BUTTON
{
    (void) pself;
    (void) trigger;
    if (!@call oself::MSG_OL_FILE_SELECTOR_PATH_SET("", SP_DOCUMENT))
	OLFSUpdateChangeDrivePopupMoniker(oself, FALSE);
    else
	OLFSNotifyUserOfDiskError();
    OLFSSelectCurrentDriveInChangeDrivePopup(oself);
}

@extern method OLFileSelectorClass, MSG_GEN_FILE_SELECTOR_RESCAN
{
    (void) pself;
    OLFSCallApp(MSG_GEN_APPLICATION_MARK_APP_COMPLETELY_BUSY);
    RescanLow(oself);
    OLFSCallApp(MSG_GEN_APPLICATION_MARK_APP_NOT_COMPLETELY_BUSY);
}

/* OLFileSelectorOpenEntry: as a double press, the error returned */
@extern method OLFileSelectorClass, MSG_GEN_FILE_SELECTOR_OPEN_ENTRY
{
    Boolean parent = (pself->OLFSI_state & OLFSS_SHOW_PARENT_DIR) != 0;
    word n = pself->OLFSI_numFiles;

    if (parent && !entryNumber)
	return FALSE;
    if (!n || entryNumber > n || (!parent && entryNumber == n))
	return TRUE;
    pself->OLFSI_state |= OLFSS_FORCE_OPEN;
    HandleFileSelectorUserAction(oself, entryNumber, TRUE);
    pself = FS(oself);
    pself->OLFSI_state &= ~OLFSS_FORCE_OPEN;
    if (!(pself->OLFSI_state & OLFSS_RESCAN_ERROR))
	return FALSE;
    pself->OLFSI_state &= ~OLFSS_RESCAN_ERROR;
    return TRUE;
}

/* TRUE: was suspended already */
@extern method OLFileSelectorClass, MSG_GEN_FILE_SELECTOR_SUSPEND
{
    if (pself->OLFSI_state & OLFSS_SUSPENDED)
	return TRUE;
    pself->OLFSI_state |= OLFSS_SUSPENDED;
    return FALSE;
}

/* TRUE: was not suspended */
@extern method OLFileSelectorClass, MSG_GEN_FILE_SELECTOR_END_SUSPEND
{
    OLFileSelectorState s = pself->OLFSI_state;

    if (!(s & OLFSS_SUSPENDED))
	return TRUE;
    pself->OLFSI_state &= ~(OLFSS_SUSPENDED | OLFSS_RESCAN_NEEDED);
    if (s & OLFSS_RESCAN_NEEDED)
	@call oself::MSG_GEN_FILE_SELECTOR_RESCAN();
    return FALSE;
}
/*
 * OLFileSelectorActivateObjectWithMnemonic: the selector's own
 * mnemonic gives the list the focus; 'v' opens the drive popup (whose
 * moniker, the drive's name, has lost its mnemonic)
 */
@extern method OLFileSelectorClass, MSG_SPEC_ACTIVATE_OBJECT_WITH_MNEMONIC
{
    optr obj;

    if (pself->VI_attrs & VA_FULLY_ENABLED) {
	if (VisCheckMnemonic(oself, character, flags, state)) {
	    obj = OLFSUIObj(oself, @OLFileSelectorFileList);
	    if (obj)
		@call obj::MSG_META_GRAB_FOCUS_EXCL();
	    return TRUE;
	}
	if ((GFS(oself)->GFSI_attrs & FSA_HAS_CHANGE_DRIVE_LIST) &&
	    ((character & 0xff) == 'v' || (character & 0xff) == 'V') &&
	    (character >> 8) == CS_BSW) {
	    obj = OLFSUIObj(oself, @OLFileSelectorChangeDrivePopup);
	    if (obj)
		@call obj::MSG_GEN_ACTIVATE();
	    return TRUE;
	}
    }
    return @callsuper();
}

/* OLFSCheckIfInteractableObject: the gadgets are the selector's */
@extern method OLFileSelectorClass, MSG_META_CHECK_IF_INTERACTABLE_OBJECT
{
    if (OptrToHandle(obj) == pself->OLFSI_uiBlock)
	return TRUE;
    return @callsuper();
}

/* OLFSDynamicListKbdChar: the space bar is a double press on the
 * selected entry */
static Boolean ListSpace(optr o, word character, word flags)
{
    word sel;
    optr fs;

    if ((flags & (CF_RELEASE | CF_STATE_KEY | CF_TEMP_ACCENT)) ||
	character != ((CS_BSW << 8) | VC_BLANK))
	return FALSE;
    sel = @call o::MSG_GEN_ITEM_GROUP_GET_SELECTION();
    fs = ObjBlockGetOutput(OptrToHandle(o));
    if (sel == GIGS_NONE || !fs)
	return FALSE;
    @call fs::MSG_OL_FILE_SELECTOR_DOUBLE_PRESS(sel, 1, 0);
    return TRUE;
}

@extern method OLFSDynamicListClass, MSG_META_KBD_CHAR
{
    (void) pself;
    if (!ListSpace(oself, character, flags))
	@callsuper();
}

@extern method OLFSDynamicListClass, MSG_META_FUP_KBD_CHAR
{
    (void) pself;
    if (ListSpace(oself, character, flags))
	return TRUE;
    return @callsuper();
}

static word StrLen(const char *s)
{
    word n = 0;

    while (s[n])
	n++;
    return n;
}

static Boolean StrEq(const char *a, const char *b)
{
    while (*a && *a == *b)
	a++, b++;
    return *a == *b;
}

void *OLFSFindTempData(optr o)
{
    return ObjVarDerefData(o, TEMP_GEN_FILE_SELECTOR_DATA);
}

/* OLFSStuffDriveAndVolumeName: "name:[volume]\", as much as fits */
void OLFSStuffDriveAndVolumeName(char *buf, word size, word drive,
				    word flags, word status, DiskHandle disk)
{
    char *p;

    buf[0] = 0;
    p = DriveGetName(drive, buf, size);
    if (!p)
	return;
    size = (word) (size - (p - buf));
    if (size < 2)
	return;
    *p++ = ':';
    *p = 0;
    size -= 2;
    if (flags & SDAVNF_VOLUME_ONLY_FOR_FIXED) {
	/* only where the medium stays and is known to */
	if ((status & DS_MEDIA_REMOVABLE) ||
	    (status & DS_TYPE) != DRIVE_FIXED)
	    goto slash;
    }
    if (!(flags & SDAVNF_PASS_DISK_HANDLE)) {
	disk = DiskRegisterDiskSilently(drive);
	if (!disk)
	    goto slash;
    }
    if (size < VOLUME_NAME_LENGTH + 3)
	return;
    *p++ = '[';
    DiskGetVolumeName(disk, p);
    p += StrLen(p);
    *p++ = ']';
    *p = 0;
    size -= 3;
slash:
    if (!(flags & SDAVNF_TRAILING_SLASH) || size < 2)
	return;
    *p++ = '\\';
    *p = 0;
}
/*
 * OLFSResolveSelection: the entry of the list with the name in
 * GFSI_selection (*entry).  With no name, no files or no such file:
 * the first entry (no entry if there are no files and the current
 * directory is not shown).  TRUE if there was a name and it is not
 * there.
 */
Boolean OLFSResolveSelection(optr o, word *entry)
{
    OLFileSelectorInstance *f = FS(o);
    word n = f->OLFSI_numFiles, i, first;
    char sel[sizeof(GenFileSelectorSelection)];
    Boolean parent = (f->OLFSI_state & OLFSS_SHOW_PARENT_DIR) != 0;

    first = parent ? 0 : GIGS_NONE;
    if (!n) {
	*entry = first;
	return TRUE;
    }
    *entry = 0;
    OLFSStrCopy(sel, GFS(o)->GFSI_selection, sizeof(sel));
    if (!sel[0] || !f->OLFSI_indexBuffer)
	return FALSE;
    for (i = 0; i < n; i++) {
	OLFileSelectorEntry *e = OLFSLockEntry(o, i);
	Boolean same = StrEq(e->OLFSE_name, sel);

	MemUnlock(FS(o)->OLFSI_fileBuffer);
	if (same) {
	    *entry = parent ? i + 1 : i;
	    return FALSE;
	}
    }
    return TRUE;
}

/*
 * OLFSCopySelection: the entry and its flags (not the error) to the
 * temporary data, its name to GFSI_selection: "." for the current
 * directory, nothing if there are no files
 */
void OLFSCopySelection(optr o, word entry, GenFileSelectorEntryFlags flags)
{
    GFSTempDataEntry *t = OLFSFindTempData(o);
    char name[FILE_LONGNAME_BUFFER_SIZE];

    t->GFSTDE_selectionFlags = flags & ~GFSEF_ERROR;
    t->GFSTDE_selectionNumber = entry;
    name[0] = 0;
    if (FS(o)->OLFSI_state & OLFSS_SHOW_PARENT_DIR) {
	if (!entry) {
	    name[0] = '.';
	    name[1] = 0;
	    goto store;
	}
	entry--;
    }
    if (FS(o)->OLFSI_numFiles && entry < FS(o)->OLFSI_numFiles) {
	OLFileSelectorEntry *e = OLFSLockEntry(o, entry);

	OLFSStrCopy(name, e->OLFSE_name, sizeof(name));
	MemUnlock(FS(o)->OLFSI_fileBuffer);
    }
store:
    OLFSStrCopy(GFS(o)->GFSI_selection, name, sizeof(GenFileSelectorSelection));
}

void OLFSBuildEntryFlagsAndSendAD(optr o, word entry)
{
    OLFSBuildEntryFlagsAndSendADLow(o, entry, 0, NULL, NULL);
}

/*
 * OLFSUpdateChangeDrivePopupMoniker: the drive popup's moniker is the
 * current drive and its volume (useCurrent), or "Drives" again.  With
 * [motif options] fsStaticDrivePopupMoniker it stays "Drives".
 */
void OLFSUpdateChangeDrivePopupMoniker(optr o, Boolean useCurrent)
{
    optr popup = OLFSUIObj(o, @OLFileSelectorChangeDrivePopup);
    char name[FILE_LONGNAME_BUFFER_SIZE];

    if (!(GFS(o)->GFSI_attrs & FSA_HAS_CHANGE_DRIVE_LIST))
	return;
    if (useCurrent && !olFileSelectorStaticDrivePopupMoniker) {
	DiskHandle disk;
	word drive = OLFSGetCurrentDrive(o, &disk);
	Boolean same = FALSE;

	OLFSStuffDriveAndVolumeName(name, sizeof(name), drive,
				SDAVNF_PASS_DISK_HANDLE, 0, disk);
	if (popup) {
	    /* (not set again if that is the moniker already) */
	    ChunkHandle m = @call popup::MSG_GEN_GET_VIS_MONIKER();

	    if (m) {
		VisMoniker *vm = LMemDerefHandles(OptrToHandle(popup), m);

		same = !(vm->VM_type & VMT_GSTRING) &&
		       StrEq((const char *) vm + VMWT_text, name);
	    }
	    if (!same)
		OLFSReplaceMonikerText(popup, name);
	}
	FS(o)->OLFSI_state |= OLFSS_SHOWING_DRIVE_LETTER;
	return;
    }
    if (!(FS(o)->OLFSI_state & OLFSS_SHOWING_DRIVE_LETTER))
	return;
    if (popup)
	(void) @call popup::MSG_GEN_REPLACE_VIS_MONIKER_OPTR(
			@ChangeDriveMoniker, VUM_DELAYED_VIA_UI_QUEUE);
    FS(o)->OLFSI_state &= ~OLFSS_SHOWING_DRIVE_LETTER;
}

/* OLFSSelectCurrentDriveInChangeDrivePopup: the current drive's item
 * selected (a drive that has gone: left as it is) */
void OLFSSelectCurrentDriveInChangeDrivePopup(optr o)
{
    optr popup = OLFSUIObj(o, @OLFileSelectorChangeDrivePopup);
    word drive, status, id;

    if (!(GFS(o)->GFSI_attrs & FSA_HAS_CHANGE_DRIVE_LIST) || !popup)
	return;
    drive = OLFSGetCurrentDrive(o, NULL);
    status = DriveGetStatus(drive);
    if (!status)
	return;
    id = (word) ((drive & 0xff) | (status << 8));
    OLFSSetItemSelection(popup, id);
    if (!@call popup::MSG_GEN_ITEM_GROUP_GET_ITEM_OPTR(id))
	return;
    OLFSUpdateChangeDrivePopupMoniker(o,
	(FS(o)->OLFSI_state & OLFSS_SHOWING_DRIVE_LETTER) != 0);
}
/* OLFSNotifyUserOfDiskError */
void OLFSNotifyUserOfDiskError(void)
{
    optr app = GeodeGetAppObject(0);
    char *s;

    if (!app)
	return;
    s = LMemDeref(@DiskNotFoundString);
    @call app::MSG_GEN_APPLICATION_DO_STANDARD_DIALOG(0, 0, NULL, NULL,
		NULL, NULL, s,
		(CDT_ERROR << CDBF_DIALOG_TYPE_OFFSET) |
		(GIT_NOTIFICATION << CDBF_INTERACTION_TYPE_OFFSET));
}

/* OLFSSendAD: the selection noted, then told to the destination when
 * the queue has been emptied (the selector may not be done yet) */
static void SendAD(optr o, word entry, GenFileSelectorEntryFlags flags)
{
    struct { word entryNum; GenFileSelectorEntryFlags entryFlags; } a;
    GenFileSelectorInstance *g;
    optr dest;
    Message msg;
    EventHandle ev;

    OLFSCopySelection(o, entry, flags);
    g = GFS(o);
    dest = g->GFSI_destination;
    msg = g->GFSI_notificationMsg;
    if (!msg || !dest)
	return;
    a.entryNum = entry;
    a.entryFlags = flags;
    if (OptrToHandle(dest)) {
	CObjMessageP(MF_FORCE_QUEUE, dest, msg, &a, sizeof(a), NULL, 0);
	return;
    }
    CObjMessageP(MF_RECORD, 0, msg, &a, sizeof(a), &ev, sizeof(ev));
    @send, forceQueue o::MSG_GEN_OUTPUT_ACTION(ev, dest);
}

/*
 * OLFSBuildEntryFlagsAndSendADLow: the GenFileSelectorEntryFlags of
 * the entry (on top of those passed) and the notification.  The entry
 * of the file buffer is copied to *out if there is one (*has).
 */
void OLFSBuildEntryFlagsAndSendADLow(optr o, word entry,
					GenFileSelectorEntryFlags flags,
					OLFileSelectorEntry *out, Boolean *has)
{
    OLFileSelectorInstance *f = FS(o);
    Boolean parent = (f->OLFSI_state & OLFSS_SHOW_PARENT_DIR) != 0;
    word n = entry;

    if (has)
	*has = FALSE;
    if (parent && !entry) {
	flags |= GFSET_SUBDIR << GFSEF_TYPE_OFFSET;
    } else {
	if (parent)
	    n--;
	if (f->OLFSI_numFiles && n < f->OLFSI_numFiles) {
	    OLFileSelectorEntry *e = OLFSLockEntry(o, n);

	    if (e->OLFSE_fileAttrs & FA_VOLUME) {
		flags |= GFSET_VOLUME << GFSEF_TYPE_OFFSET;
	    } else {
		if (e->OLFSE_fileAttrs & FA_SUBDIR)
		    flags |= GFSET_SUBDIR << GFSEF_TYPE_OFFSET;
		else {
		    /* a file: the document flags of its header */
		    if (e->OLFSE_fileFlags & GFHF_TEMPLATE)
			flags |= GFSEF_TEMPLATE;
		    if (e->OLFSE_fileFlags & GFHF_SHARED_MULTIPLE)
			flags |= GFSEF_SHARED_MULTIPLE;
		    if (e->OLFSE_fileFlags & GFHF_SHARED_SINGLE)
			flags |= GFSEF_SHARED_SINGLE;
		}
		if (e->OLFSE_fileAttrs & FA_RDONLY)
		    flags |= GFSEF_READ_ONLY;
	    }
	    if (out)
		*out = *e;
	    if (has)
		*has = TRUE;
	    MemUnlock(FS(o)->OLFSI_fileBuffer);
	    f = FS(o);
	}
    }
    if (!f->OLFSI_numFiles)
	flags |= GFSEF_NO_ENTRIES;
    if (parent && !entry)
	flags |= GFSEF_PARENT_DIR;
    /* an error of the last scan is told once (..._OPEN_ENTRY returns
     * it instead) */
    if (!(f->OLFSI_state & OLFSS_FORCE_OPEN) &&
	(f->OLFSI_state & OLFSS_RESCAN_ERROR)) {
	flags |= GFSEF_ERROR;
	f->OLFSI_state &= ~OLFSS_RESCAN_ERROR;
    }
    SendAD(o, entry, flags);
}

/* OLFSGetCurrentDrive */
word OLFSGetCurrentDrive(optr o, DiskHandle *disk)
{
    GenFilePath *p;
    DiskHandle d = OLFSCurPath(o, &p);

    if (disk)
	*disk = d;
    return DiskGetDrive(d);
}

/* OLFSHaveVirtualRoot */
GenFilePath *OLFSHaveVirtualRoot(optr o)
{
    if (!(GFS(o)->GFSI_attrs & FSA_USE_VIRTUAL_ROOT))
	return NULL;
    return ObjVarFindData(o, ATTR_GEN_FILE_SELECTOR_VIRTUAL_ROOT);
}

/* OLFSIsCurDirVirtualRootOrUnderVirtualRoot: PCT_EQUAL or PCT_SUBDIR
 * in *how */
Boolean OLFSIsCurDirVirtualRootOrUnderVirtualRoot(optr o, PathCompareType *how)
{
    GenFilePath *p, *vr;
    DiskHandle d;
    char cur[PATH_BUFFER_SIZE], root[PATH_BUFFER_SIZE];
    DiskHandle vd;
    PathCompareType t;

    if (!OLFSHaveVirtualRoot(o))
	return FALSE;
    d = OLFSCurPath(o, &p);		/* (the block may move) */
    OLFSStrCopy(cur, p->GFP_path, sizeof(cur));
    vr = OLFSHaveVirtualRoot(o);
    vd = vr->GFP_disk;
    OLFSStrCopy(root, vr->GFP_path, sizeof(root));
    t = FileComparePaths(root, vd, cur, d);
    if (how)
	*how = t;
    return t == PCT_EQUAL || t == PCT_SUBDIR;
}

/* up a directory (not above a virtual root): the directory left is the
 * suggested selection of its parent's list */
static void UpDirectory(optr o)
{
    char path[PATH_BUFFER_SIZE];

    if (OLFSIsVirtualRoot(o))
	return;
    (void) OLFSFullPath(o, path, sizeof(path));
    if (!(path[0] == '\\' && !path[1]))
	OLFSStrCopy(GFS(o)->GFSI_selection, OLFSLastElement(path),
		sizeof(GenFileSelectorSelection));
    (void) @call o::MSG_GEN_PATH_SET("..", 0);
}

/*
 * HandleFileSelectorUserAction: a press on an entry tells the
 * destination; a double press (GFSEF_OPEN) also opens a directory, on
 * the first entry (the current directory) it goes up
 */
void HandleFileSelectorUserAction(optr o, word entry, Boolean doublePress)
{
    FileSelectorAttrs attrs = GFS(o)->GFSI_attrs;
    OLFileSelectorEntry e;
    Boolean has;

    if ((FS(o)->OLFSI_state & OLFSS_SHOW_PARENT_DIR) && !entry) {
	if (!doublePress) {
	    OLFSBuildEntryFlagsAndSendAD(o, 0);
	    OLFSShowCurrentDir(o);
	} else if (attrs & FSA_ALLOW_CHANGE_DIRS)
	    UpDirectory(o);
	return;
    }
    if (entry == OLFS_UP_DIRECTORY_ENTRY_NUM) {
	UpDirectory(o);
	return;
    }
    OLFSBuildEntryFlagsAndSendADLow(o, entry, doublePress ? GFSEF_OPEN : 0,
				&e, &has);
    if (!has)
	return;
    if (!doublePress) {
	OLFSShowCurrentDir(o);
	return;
    }
    if (!(attrs & FSA_ALLOW_CHANGE_DIRS) || !(e.OLFSE_fileAttrs & FA_SUBDIR))
	return;
    if (@call o::MSG_OL_FILE_SELECTOR_PATH_SET(e.OLFSE_name, 0))
	OLFSNotifyUserOfDiskError();
}

/* OLFSSetUsableOnFlags */
void OLFSSetUsableOnFlags(optr obj, Boolean usable)
{
    if (!obj)
	return;
    if (usable)
	@call obj::MSG_GEN_SET_USABLE(VUM_DELAYED_VIA_UI_QUEUE);
    else
	@call obj::MSG_GEN_SET_NOT_USABLE(VUM_DELAYED_VIA_UI_QUEUE);
}

/* OLFSTurnOffGadgetry: the gadgets the attributes ask for */
void OLFSTurnOffGadgetry(optr o)
{
    FileSelectorAttrs a = GFS(o)->GFSI_attrs;

    OLFSSetUsableOnFlags(OLFSUIObj(o, @OLFileSelectorDocumentButton),
	      (a & FSA_HAS_DOCUMENT_BUTTON) != 0);
    OLFSSetUsableOnFlags(OLFSUIObj(o, @OLFileSelectorChangeDirectoryPopup),
	      (a & FSA_HAS_CHANGE_DIRECTORY_LIST) != 0);
    OLFSSetUsableOnFlags(OLFSUIObj(o, @OLFileSelectorChangeDrivePopup),
	      (a & FSA_HAS_CHANGE_DRIVE_LIST) != 0);
    OLFSSetUsableOnFlags(OLFSUIObj(o, @OLFileSelectorFileList),
	      (a & FSA_HAS_FILE_LIST) != 0);
}

/* OLFSDisableDocButtonIfDocDir */
void OLFSDisableDocButtonIfDocDir(optr o, const char *path, DiskHandle disk)
{
    optr b = OLFSUIObj(o, @OLFileSelectorDocumentButton);

    if (!b)
	return;
    if (FileComparePaths("", SP_DOCUMENT, path, disk) == PCT_EQUAL)
	@call b::MSG_GEN_SET_NOT_ENABLED(VUM_DELAYED_VIA_UI_QUEUE);
    else
	@call b::MSG_GEN_SET_ENABLED(VUM_DELAYED_VIA_UI_QUEUE);
}

/* OLFSDisableCloseAndChangeDirectoryButtonsIfFirstEntryAndIsRoot: no
 * path popup with the first entry selected at the (virtual) root */
void OLFSDisableCloseAndChangeDirectoryButtonsIfFirstEntryAndIsRoot(optr o, Boolean atRoot)
{
    optr popup = OLFSUIObj(o, @OLFileSelectorChangeDirectoryPopup);
    Boolean enable = TRUE;

    if (!(FS(o)->OLFSI_state & OLFSS_SHOW_PARENT_DIR) || !OLFSListSelection(o))
	enable = !OLFSIsVirtualRoot(o) && !atRoot;
    if (!popup)
	return;
    if (enable)
	@call popup::MSG_GEN_SET_ENABLED(VUM_DELAYED_VIA_UI_QUEUE);
    else
	@call popup::MSG_GEN_SET_NOT_ENABLED(VUM_DELAYED_VIA_UI_QUEUE);
}
