/*
 * copenUtils.goc -- utilities of the specific UI (after copenUtils.asm):
 * so far the line bounds of an object, the display checks (CGA, black
 * and white, TV, the screen's dimensions), GStates for the UI, the
 * conditional hints, the flags of a parent OLCtrl, the visibility
 * notification and the size of a generic moniker.  The pointer images of
 * OpenGetPtrImage are in cutilsPtrImages.goc.
 */
@include "cGeode.goh"
@include <Internal/SpecUI/olValueClass.goh>
@include <Objects/vTextC.goh>
@include <Internal/SpecUI/olScrollbarClass.goh>
@include <Objects/gViewC.goh>
@include <Objects/gContC.goh>

/* OpenGetLineBounds: the bounds of the object for drawing lines: the
 * right and bottom one pixel in */
void OpenGetLineBounds(optr obj, Rectangle *r)
{
    VisGetBounds(obj, r);
    r->R_right--;
    r->R_bottom--;
}

/* OpenCheckIfCGA: a very squished or tiny display */
Boolean OpenCheckIfCGA(void)
{
    return (moCS_flags & (CSF_VERY_SQUISHED | CSF_TINY)) != 0;
}

/* OpenCheckMenusInHeaderOnMax: the menu bar goes in the header of a
 * maximized window (the .ini's window options) */
Boolean OpenCheckMenusInHeaderOnMax(void)
{
    return (olWindowOptions &
	    UIWO_COMBINE_HEADER_AND_MENU_IN_MAXIMIZED_WINDOWS) != 0;
}

/* OpenMinimizeIfCGA: 0 on a CGA, else the value */
word OpenMinimizeIfCGA(word value)
{
    return OpenCheckIfCGA() ? 0 : value;
}

/* OpenCheckIfBW: a black and white display */
Boolean OpenCheckIfBW(void)
{
    return (moCS_flags & CSF_BW) != 0;
}

/* OpenGetScreenDimensions: the default screen's size (cached once
 * known) */
void OpenGetScreenDimensions(word *width, word *height)
{
    if (!screenHeight) {
	optr screen = 0;
	Rectangle b;

	UserCallSystem(MSG_GEN_SYSTEM_GET_DEFAULT_SCREEN, NULL, 0, &screen,
		       sizeof(screen));
	if (screen) {
	    @call screen::MSG_VIS_GET_BOUNDS(&b);
	    screenWidth = b.R_right;
	    screenHeight = b.R_bottom;
	}
    }
    *width = screenWidth;
    *height = screenHeight;
}

/* OpenCheckIfNarrow: a very narrow application */
Boolean OpenCheckIfNarrow(void)
{
    return (moCS_flags & CSF_VERY_NARROW) != 0;
}

/* OpenCheckIfTV: a TV display */
Boolean OpenCheckIfTV(void)
{
    return (moCS_flags & CSF_TV) != 0;
}

/* OpenCheckDefaultRings: if default rings are drawn */
Boolean OpenCheckDefaultRings(void)
{
    return !olNoDefaultRing;
}

/* OpenCheckIfVerticalScreen: a screen higher than wide */
Boolean OpenCheckIfVerticalScreen(void)
{
    word w, h;

    OpenGetScreenDimensions(&w, &h);
    return w < h;
}

/* OpenCheckIfLimitedLength: no room in the direction the composite
 * orients its children (vertically: a CGA, else a very narrow
 * application) */
Boolean OpenCheckIfLimitedLength(optr obj)
{
    byte geo = ((VisCompInstance *) ObjDerefVis(obj))->VCI_geoAttrs;

    if (geo & VCGA_ORIENT_CHILDREN_VERTICALLY)
	return (moCS_flags & (CSF_VERY_SQUISHED | CSF_TINY)) != 0;
    return (moCS_flags & CSF_VERY_NARROW) != 0;
}

/* ---------------------------------------------------------------------
 * GStates
 * ------------------------------------------------------------------- */

/* ViewCreateGState: a GState on the window (or none) with the display
 * scheme in its private data, the UI's font and square line ends */
GStateHandle ViewCreateGState(WindowHandle win)
{
    GStateHandle gs = GrCreateState(win);
    DisplayScheme d;

    SpecGetDisplayScheme(&d);
    GrSetPrivateData(gs, (word) (d.DS_colorScheme | (d.DS_displayType << 8)),
		     (word) (d.DS_lightColor | (d.DS_darkColor << 8)),
		     d.DS_fontID, (word) d.DS_pointSize);
    GrSetFont(gs, d.DS_fontID, MakeWWFixed(d.DS_pointSize));
    GrSetLineEnd(gs, LE_SQUARECAP);
    return gs;
}

/* ViewCreateCalcGState: one without a window, for calculations */
GStateHandle ViewCreateCalcGState(void)
{
    return ViewCreateGState(0);
}

/* VupCreateGState: one on the object's window */
GStateHandle VupCreateGState(optr obj)
{
    return ViewCreateGState(VisQueryWindow(obj));
}

/* ---------------------------------------------------------------------
 * Conditional hints
 * ------------------------------------------------------------------- */

/* the next entry of the variable data (offsets in the chunk) */
static word NextVarEntry(const byte *p, word e, word end)
{
    word size = ((const VarDataEntry *) (p + e))->VDE_entrySize;

    if (size < sizeof(VarDataEntry))
	return end;
    e = (word) ((e + size + 7u) & ~7u);
    return e > end ? end : e;
}

static word VarEntryType(const byte *p, word e, word end)
{
    return e < end ?
	(word) (((const VarDataEntry *) (p + e))->VDE_dataType & VDF_TYPE) : 0;
}

/*
 * RemoveConditionalHintsIfNeeded: for each HINT_IF_SYSTEM_ATTRS, the
 * hints up to its HINT_ELSE or HINT_ENDIF (just the next one without)
 * are kept if the system has one of the attributes (none of them with
 * SA_NOT), else those after HINT_ELSE up to HINT_ENDIF; the others and
 * the conditional hints themselves are deleted (FindConditionalHints)
 */
void RemoveConditionalHintsIfNeeded(optr obj)
{
    SystemAttrs *sa;

    while ((sa = ObjVarFindData(obj, HINT_IF_SYSTEM_ATTRS)) != NULL) {
	byte *p = LMemDeref(obj);
	word end = LMemGetChunkSize(obj);
	word e = (word) ((byte *) sa - sizeof(VarDataEntry) - p);
	word ifStart, ifEnd, elseStart = 0, elseEnd = 0, t;
	Boolean met, endif = FALSE;

	met = (*sa & SA_NOT) ? !(*sa & olSystemAttrs & ~SA_NOT)
			     : (*sa & olSystemAttrs) != 0;
	e = NextVarEntry(p, e, end);
	ifStart = e;
	t = VarEntryType(p, e, end);
	if (t != HINT_ELSE && t != HINT_ENDIF)
	    e = NextVarEntry(p, e, end);
	ifEnd = e;
	while ((t = VarEntryType(p, e, end)) != 0) {
	    if (t == HINT_ELSE) {
		elseStart = e;
		e = NextVarEntry(p, e, end);
		ifEnd = e;		/* HINT_ELSE goes with the "if" */
		continue;
	    }
	    if (t == HINT_ENDIF) {
		if (elseStart)
		    elseEnd = e;
		else
		    ifEnd = e;
		endif = TRUE;
		break;
	    }
	    e = NextVarEntry(p, e, end);
	}
	if (met) {
	    ifStart = elseStart;
	    ifEnd = elseEnd;
	}
	if (ifStart && ifEnd > ifStart)
	    LMemDeleteAt(obj, ifStart, (word) (ifEnd - ifStart));
	if (endif)
	    (void) ObjVarDeleteData(obj, HINT_ENDIF);
	(void) ObjVarDeleteData(obj, HINT_IF_SYSTEM_ATTRS);
    }
}

/* OpenScanVarData: ObjVarScanData after the conditional hints are
 * resolved */
void OpenScanVarData(optr obj, word numHandlers, VarDataCHandler *table,
		     void *data)
{
    RemoveConditionalHintsIfNeeded(obj);
    ObjVarScanData(obj, numHandlers, table, data);
}

/* ---------------------------------------------------------------------
 * The flags of a parent OLCtrl
 * ------------------------------------------------------------------- */

/* OpenGetFlagsIfCtrl: the flags of the vis parent if it is an OLCtrl,
 * else its answer to the message (0 if none); a window has none */
static word GetFlagsIfCtrl(optr obj, Boolean more)
{
    optr parent;
    word f = 0;

    if (((VisInstance *) ObjDerefVis(obj))->VI_typeFlags & VTF_IS_WIN_GROUP)
	return 0;
    parent = VisFindParent(obj);
    if (!parent)
	return 0;
    ObjLockObjBlock(OptrToHandle(parent));
    if (ObjIsObjectInClass(parent, &OLCtrlClass)) {
	OLCtrlInstance *c = (OLCtrlInstance *) ObjDerefVis(parent);

	f = more ? c->OLCI_moreFlags : c->OLCI_buildFlags;
	MemUnlock(OptrToHandle(parent));
	return f;
    }
    MemUnlock(OptrToHandle(parent));
    if (more) {
	OLCtrlMoreFlags m = 0;

	if (@call parent::MSG_VUP_GET_MORE_FLAGS(&m))
	    f = m;
    } else {
	OLBuildFlags b = 0;

	if (@call parent::MSG_VUP_GET_BUILD_FLAGS(&b))
	    f = b;
    }
    return f;
}

OLBuildFlags OpenGetParentBuildFlagsIfCtrl(optr obj)
{
    return (OLBuildFlags) GetFlagsIfCtrl(obj, FALSE);
}

OLCtrlMoreFlags OpenGetParentMoreFlagsIfCtrl(optr obj)
{
    return (OLCtrlMoreFlags) GetFlagsIfCtrl(obj, TRUE);
}

/* ---------------------------------------------------------------------
 * Visibility notification (copenButtonClass.asm)
 * ------------------------------------------------------------------- */

/* VisOpenCloseNotifyCommon: ATTR_GEN_VISIBILITY_MESSAGE (else
 * MSG_GEN_APPLICATION_VISIBILITY_NOTIFICATION) with the object (or
 * ATTR_GEN_VISIBILITY_DATA) to ATTR_GEN_VISIBILITY_DESTINATION (else
 * the application) */
static void VisOpenCloseNotifyCommon(optr obj, Boolean opening)
{
    optr data = obj, dest;
    Message msg = MSG_GEN_APPLICATION_VISIBILITY_NOTIFICATION;
    void *p;

    if ((p = ObjVarFindData(obj, ATTR_GEN_VISIBILITY_DATA)) != NULL)
	data = *(optr *) p;
    if ((p = ObjVarFindData(obj, ATTR_GEN_VISIBILITY_MESSAGE)) != NULL)
	msg = *(Message *) p;
    if ((p = ObjVarFindData(obj, ATTR_GEN_VISIBILITY_DESTINATION)) != NULL)
	dest = *(optr *) p;
    else
	dest = GeodeGetAppObject(0);
    if (dest)
	@send dest::{GEN_VISIBILITY_OUTPUT}(msg)(data, opening);
}

void VisOpenNotifyCommon(optr obj)
{
    VisOpenCloseNotifyCommon(obj, TRUE);
}

void VisCloseNotifyCommon(optr obj)
{
    VisOpenCloseNotifyCommon(obj, FALSE);
}

/* ---------------------------------------------------------------------
 * Moniker sizes (copenMoniker.asm)
 * ------------------------------------------------------------------- */

static word systemFontHeight;
static word addOnMnemonicWidth;

/* GetSystemFontHeight: the height of the UI's font (cached;
 * CalcAndCacheSystemFontHeight) */
word GetSystemFontHeight(void)
{
    if (!systemFontHeight) {
	GStateHandle gs = ViewCreateCalcGState();

	systemFontHeight = (word) GrFontMetrics(gs, GFMI_HEIGHT_ROUNDED);
	GrDestroyState(gs);
    }
    return systemFontHeight;
}

/* SpecGetGenMonikerSize: the generic moniker's size; a mnemonic not in
 * the text is shown after it (as " (w)") */
SizeAsDWord SpecGetGenMonikerSize(optr obj, GStateHandle gs)
{
    ChunkHandle m = ((GenInstance *) ObjDerefGen(obj))->GI_visMoniker;
    SizeAsDWord s;
    VisMonikerWithText *t;

    s = VisGetMonikerSize(obj, m, GetSystemFontHeight(), gs);
    if (!m)
	return s;
    t = LMemDeref(ConstructOptr(OptrToHandle(obj), m));
    if ((t->VMWT_common.VM_type & VMT_GSTRING) ||
	(byte) t->VMWT_mnemonicOffset != 0xfe)	/* VMO_MNEMONIC_NOT_IN_MKR_TEXT */
	return s;
    if (!addOnMnemonicWidth) {
	GStateHandle cg = ViewCreateCalcGState();

	addOnMnemonicWidth = GrTextWidth(cg, " (w)", 4);
	GrDestroyState(cg);
    }
    return MAKE_SIZE_DWORD(DWORD_WIDTH(s) + addOnMnemonicWidth,
			   DWORD_HEIGHT(s));
}

/* ---------------------------------------------------------------------
 * The keyboard
 * ------------------------------------------------------------------- */

/* CheckIfKeyboardRequired (cmainUtils.asm): no keyboard, or the
 * floating keyboard wanted ([input] floatingKbd) */
Boolean CheckIfKeyboardRequired(void)
{
    return (FlowGetUIButtonFlags() & UIBF_NO_KEYBOARD) || kbdRequired;
}

/* OpenCheckIfKeyboardOnly: no mouse */
Boolean OpenCheckIfKeyboardOnly(void)
{
    return (FlowGetUIButtonFlags() & UIBF_KEYBOARD_ONLY) != 0;
}

/* OpenCheckIfKeyboard: the user may navigate with the keyboard (no
 * mouse, or a keyboard) */
Boolean OpenCheckIfKeyboard(void)
{
    UIButtonFlags f = FlowGetUIButtonFlags();

    return (f & UIBF_KEYBOARD_ONLY) || !(f & UIBF_NO_KEYBOARD);
}

/* OpenCheckIfMenusTakeFocus: menus take the focus but on a pen system
 * with no keyboard (PRESERVE_FOCUS_IF_PEN_ONLY) */
Boolean OpenCheckIfMenusTakeFocus(void)
{
    UIButtonFlags f;

    if (!SysGetPenMode())
	return TRUE;
    f = FlowGetUIButtonFlags();
    return (f & UIBF_KEYBOARD_ONLY) || !(f & UIBF_NO_KEYBOARD);
}

/* OpenCheckIfKeyboardNavigation: [motif options] kbdNavigation */
Boolean OpenCheckIfKeyboardNavigation(void)
{
    return (olWindowOptions & UIWO_KBD_NAVIGATION) != 0;
}

/* OpenDoClickSound: the key click, if wanted */
void OpenDoClickSound(void)
{
    if (specDoClickSound)
	UserStandardSound(SST_KEY_CLICK);
}

/* ---------------------------------------------------------------------
 * The window of an object, gadget colors
 * ------------------------------------------------------------------- */

/* OpenFindOLWin (FindOLWin): the OLWin the object is in (itself if it
 * is one), up the vis tree as far as this thread runs it; 0 if none */
/*
 * OLProcessAppStayUpModeMenus: MSG_META_ENSURE_NO_MENUS_IN_STAY_UP_MODE
 * to the windows of the application of this thread (GAGCNLT_WINDOWS):
 * their menus in stay up mode dismissed, or with params counted
 */
void OLProcessAppStayUpModeMenus(EnsureNoMenusInStayUpModeParams *p)
{
    optr app = GeodeGetAppObject(0);
    struct {
	GCNListSendFlags f; EventHandle e; MemHandle b; word t;
	ManufacturerID m;
    } s;
    EventHandle ev;

    if (!app)
	return;
    ev = @record null::MSG_META_ENSURE_NO_MENUS_IN_STAY_UP_MODE(p);
    s.f = 0;
    s.e = ev;
    s.b = 0;
    s.t = GAGCNLT_WINDOWS;
    s.m = MANUFACTURER_ID_GEOWORKS;
    CObjMessageP(MF_CALL, app, MSG_META_GCN_LIST_SEND, &s, sizeof(s), NULL,
		 0);
}

/* ReleaseExpressMenu: the field's express menu (on the UI's thread) */
static void ReleaseExpressMenu(optr o)
{
    EventHandle ev = @record OLFieldClass::MSG_OL_FIELD_RELEASE_EXPRESS_MENU();

    @call o::MSG_VIS_VUP_CALL_OBJECT_OF_CLASS(ev);
}

/* OLReleaseAllStayUpModeMenus: all of them dismissed */
void OLReleaseAllStayUpModeMenus(optr o)
{
    OLProcessAppStayUpModeMenus(NULL);
    ReleaseExpressMenu(o);
}

/* OLCountStayUpModeMenus: counted (not dismissed: the menus count
 * then), the express menus released; the count */
word OLCountStayUpModeMenus(optr o)
{
    EnsureNoMenusInStayUpModeParams p;

    p.ENMISUMP_menuCount = 0;
    OLProcessAppStayUpModeMenus(&p);
    ReleaseExpressMenu(o);
    return p.ENMISUMP_menuCount;
}

optr OpenFindOLWin(optr o)
{
    while (o) {
	VisInstance *v;
	Boolean win;

	if (!ObjTestIfObjBlockRunByCurThread(OptrToHandle(o)))
	    return 0;
	ObjLockObjBlock(OptrToHandle(o));
	v = (VisInstance *) ObjDerefVis(o);
	win = (v->VI_typeFlags & VTF_IS_WIN_GROUP) &&
	      ObjIsObjectInClass(o, &OLWinClass);
	MemUnlock(OptrToHandle(o));
	if (win)
	    return o;
	o = VisFindParent(o);
    }
    return 0;
}

/* GetCtrlColors: an OLCtrl's HINT_GADGET_BACKGROUND_COLORS, or (in a
 * toolbox) its parent's: the first and second color, unselected and
 * selected */
static Boolean GetCtrlColors(optr o, word *unsel, word *sel)
{
    while (o) {
	BackgroundColors *bc;
	Boolean toolbox;

	ObjLockObjBlock(OptrToHandle(o));
	if (!ObjIsObjectInClass(o, &OLCtrlClass)) {
	    MemUnlock(OptrToHandle(o));
	    return FALSE;
	}
	bc = ObjVarFindData(o, HINT_GADGET_BACKGROUND_COLORS);
	if (bc) {
	    *unsel = bc->BC_unselectedColor1 | (bc->BC_unselectedColor2 << 8);
	    *sel = bc->BC_selectedColor1 | (bc->BC_selectedColor2 << 8);
	    MemUnlock(OptrToHandle(o));
	    return TRUE;
	}
	toolbox = (((OLCtrlInstance *) ObjDerefVis(o))->OLCI_buildFlags &
		   OLBF_TOOLBOX) != 0;
	MemUnlock(OptrToHandle(o));
	if (!toolbox)
	    return FALSE;
	o = VisFindParent(o);
    }
    return FALSE;
}

/*
 * OpenGetBackgroundColor: the object's HINT_GADGET_BACKGROUND_COLORS, a
 * parent OLCtrl's, or the light color (selected: the selection's); the
 * selected ones if asked for: the first color in the low byte, the
 * second (drawn over it at 50%) in the high one
 */
word OpenGetBackgroundColor(optr o, Boolean selected)
{
    BackgroundColors *bc = ObjVarFindData(o, HINT_GADGET_BACKGROUND_COLORS);
    word unsel, sel;

    if (bc) {
	unsel = bc->BC_unselectedColor1 | (bc->BC_unselectedColor2 << 8);
	sel = bc->BC_selectedColor1 | (bc->BC_selectedColor2 << 8);
    } else if (!GetCtrlColors(VisFindParent(o), &unsel, &sel)) {
	unsel = moCS_dsLightColor | (moCS_dsLightColor << 8);
	sel = moCS.CSV_selBkgdColor | (moCS.CSV_selBkgdColor << 8);
    }
    return selected ? sel : unsel;
}

/* OpenGetTextColor: the object's or its vis parent's
 * HINT_GADGET_TEXT_COLOR (FALSE: none) */
Boolean OpenGetTextColor(optr o, Color *c)
{
    TextColors *tc = ObjVarFindData(o, HINT_GADGET_TEXT_COLOR);
    optr p;

    if (tc) {
	*c = tc->TC_unselectedColor;
	return TRUE;
    }
    p = VisFindParent(o);
    if (!p)
	return FALSE;
    ObjLockObjBlock(OptrToHandle(p));
    tc = ObjVarFindData(p, HINT_GADGET_TEXT_COLOR);
    if (tc)
	*c = tc->TC_unselectedColor;
    MemUnlock(OptrToHandle(p));
    return tc != NULL;
}

/* ---------------------------------------------------------------------
 * The default focus and target
 * ------------------------------------------------------------------- */

typedef struct {
    Boolean	focus;
    Boolean	target;
} FocusTargetHints;

static void FocusTargetHint(MemHandle mh, ChunkHandle chnk,
			    VarDataEntry *extra, word dataType,
			    void *handlerData)
{
    FocusTargetHints *h = handlerData;

    (void) mh; (void) chnk; (void) extra;
    if (dataType == HINT_DEFAULT_FOCUS)
	h->focus = TRUE;
    else
	h->target = TRUE;
}

static VarDataCHandler focusTargetHints[] = {
    { HINT_DEFAULT_FOCUS, FocusTargetHint },
    { HINT_DEFAULT_TARGET, FocusTargetHint },
};

static Boolean FullyEnabled(optr obj)
{
    return (((VisInstance *) ObjDerefVis(obj))->VI_attrs &
	    VA_FULLY_ENABLED) != 0;
}

/*
 * ScanFocusTargetHintHandlers: HINT_DEFAULT_TARGET and then
 * HINT_DEFAULT_FOCUS grab the target and focus if the object is fully
 * enabled; TRUE if it has the focus hint (ScanTargetHintHandler: only
 * the target grabbed)
 */
static Boolean ScanFocusTargetHints(optr obj, FocusTargetHints *h)
{
    h->focus = h->target = FALSE;
    ObjVarScanData(obj, sizeof(focusTargetHints) / sizeof(focusTargetHints[0]),
		   focusTargetHints, h);
    if (h->target && FullyEnabled(obj))
	@call obj::MSG_META_GRAB_TARGET_EXCL();
    return h->focus;
}

Boolean ScanTargetHintHandler(optr obj)
{
    FocusTargetHints h;

    return ScanFocusTargetHints(obj, &h);
}

Boolean ScanFocusTargetHintHandlers(optr obj)
{
    FocusTargetHints h;

    if (ScanFocusTargetHints(obj, &h) && FullyEnabled(obj))
	@call obj::MSG_META_GRAB_FOCUS_EXCL();
    return h.focus;
}

/* ---------------------------------------------------------------------
 * The parent window
 * ------------------------------------------------------------------- */

/* OpenGetParentWinSize: the size of the parent window (its info, with
 * the margins for windows extended near its corner); FALSE if it has
 * none */
Boolean OpenGetParentWinSize(optr obj, WinSizeInfoParams *p)
{
    optr parent = VisFindParent(obj);

    memset(p, 0, sizeof(*p));
    if (parent)
	@call parent::MSG_SPEC_VUP_GET_WIN_SIZE_INFO(p);
    return p->WSIP_windowWidth && p->WSIP_windowHeight;
}

/* ---------------------------------------------------------------------
 * Drawing
 * ------------------------------------------------------------------- */

/*
 * OpenDrawRect (SetupDraw, DrawFrame): a frame in the rectangle (the
 * bounds of a fill), the top left in the low color, the bottom right
 * in the high one (the white one leaves the corners); a disabled object
 * clears it first and draws it 50%
 */
void OpenDrawRect(optr obj, GStateHandle gs, sword left, sword top,
		  sword right, sword bottom, word colors)
{
    Color br = (Color) (colors >> 8);

    if (!FullyEnabled(obj)) {
	GrSetLineColor(gs, CF_INDEX, moCS_dsLightColor, 0, 0);
	GrSetLineMaskSys(gs, SDM_50 | SDM_INVERSE);
	GrDrawRect(gs, left, top, (sword) (right - 1), (sword) (bottom - 1));
	GrSetLineMaskSys(gs, SDM_50);
    }
    GrSetLineColor(gs, CF_INDEX, (byte) colors, 0, 0);
    right--;
    bottom--;
    GrDrawVLine(gs, left, top, bottom);
    GrDrawHLine(gs, left, top, right);
    GrSetLineColor(gs, CF_INDEX, br, 0, 0);
    if (br == C_WHITE) {
	top++;
	left++;
    }
    GrDrawVLine(gs, right, top, bottom);
    GrDrawHLine(gs, left, bottom, right);
    GrSetLineMaskSys(gs, SDM_100);
}

#define GRADIENT_STEP_SIZE	4

/* CalcStep: a color component from start to end over the width, per
 * step (8.8 fixed, as the asm rounds it) */
static sdword CalcStep(byte start, byte end, sword width)
{
    sdword diff = (sdword) end - start;
    WWFixedAsDWord q;

    if (!diff || !width)
	return 0;
    q = GrSDivWWFixed((WWFixedAsDWord) (diff << 16),
		      (WWFixedAsDWord) ((sdword) width << 16));
    q = (WWFixedAsDWord) ((sdword) q * GRADIENT_STEP_SIZE);
    return ((sdword) q + 0x80) >> 8;
}

/*
 * DrawGradient: the rectangle filled from the start color (left) to
 * the end color (right), in steps of GRADIENT_STEP_SIZE
 */
void DrawGradient(GStateHandle gs, const Rectangle *r, Color start,
		  Color end)
{
    RGBColorAsDWord s = GrMapColorIndex(gs, start);
    RGBColorAsDWord e = GrMapColorIndex(gs, end);
    sword w = (sword) (r->R_right - r->R_left);
    sdword cur[3], step[3];
    sword x;
    int i;

    for (i = 0; i < 3; i++) {
	byte sc = (byte) (s >> (8 * i)), ec = (byte) (e >> (8 * i));

	cur[i] = (sdword) sc << 8;
	step[i] = CalcStep(sc, ec, w);
    }
    /* the last piece in the color before it, as the asm */
    for (x = r->R_left; ; ) {
	GrSetAreaColor(gs, CF_RGB, (word) ((cur[0] >> 8) & 0xff),
		       (word) ((cur[1] >> 8) & 0xff),
		       (word) ((cur[2] >> 8) & 0xff));
	GrFillRect(gs, x, r->R_top, (sword) (x + GRADIENT_STEP_SIZE + 1),
		   r->R_bottom);
	x += GRADIENT_STEP_SIZE;
	for (i = 0; i < 3; i++)
	    cur[i] += step[i];
	if (x + GRADIENT_STEP_SIZE >= r->R_right)
	    break;
    }
    GrFillRect(gs, x, r->R_top, r->R_right, r->R_bottom);
}

/*
 * OpenCreateChildObject: an object of the class in the block, not
 * dirtied (unless CCF_MARK_DIRTY), its generic part initialized, the
 * hint added (if any); added to the parent (if any) as a child or only
 * linked up to it; usable if asked for.
 */
optr OpenCreateChildObject(MemHandle block, optr parent, ClassStruct *class,
			   word hint, Boolean usable, Boolean oneWay,
			   CompChildFlags flags)
{
    optr o = ObjInstantiate(block, class);

    ObjSetFlags(o, (flags & CCF_MARK_DIRTY) ? OCF_DIRTY : OCF_IGNORE_DIRTY,
		0);
    ObjInitializePart(o, word_offsetof(GenBase, Gen_offset));
    if (hint)
	(void) ObjVarAddData(o, hint, 0);
    if (parent) {
	if (oneWay)
	    @call parent::MSG_GEN_ADD_CHILD_UPWARD_LINK_ONLY(o);
	else
	    @call parent::MSG_GEN_ADD_CHILD(o, flags);
    }
    if (usable)
	((GenInstance *) ObjDerefGen(o))->GI_states |= GS_USABLE;
    return o;
}

/*
 * OpenCreateNewParentObject: a new generic object of the class in the
 * object's block (not dirtied), to become its parent: the object's
 * generic hints (HINT_TOOLBOX dropped) and a copy of its moniker
 */
optr OpenCreateNewParentObject(optr o, ClassStruct *class)
{
    optr parent = ObjInstantiate(OptrToHandle(o), class);
    ChunkHandle mkr;

    ObjSetFlags(parent, OCF_IGNORE_DIRTY, 0);
    ObjInitializePart(parent, word_offsetof(GenBase, Gen_offset));
    ObjVarCopyDataRange(o, parent, HINT_DUMMY, ATTR_GEN_TEXT_STATUS_MSG - 1);
    (void) ObjVarDeleteData(parent, HINT_TOOLBOX);
    mkr = ((GenInstance *) ObjDerefGen(o))->GI_visMoniker;
    if (mkr)
	(void) @call parent::MSG_GEN_REPLACE_VIS_MONIKER_OPTR(
			ConstructOptr(OptrToHandle(o), mkr), VUM_MANUAL);
    return parent;
}

/*
 * OpenBuildNewParentObject: the new parent (OpenCreateNewParentObject)
 * enabled and targetable as the object; for a view a new GenContent
 * (as wide as the view, usable) is its content, the object at its
 * origin and as wide as the document.  Unless the object is built the
 * parent is added to the object's generic parent after it, usable, the
 * object visually under it (or the content), the parent built; then
 * the parent keeps only its upward link.
 */
void OpenBuildNewParentObject(optr o, optr parent, SpecBuildFlags flags,
			      Boolean view)
{
    GenInstance *g, *pg;
    optr content = 0, gp;
    Rectangle b;
    word pos;

    g = (GenInstance *) ObjDerefGen(o);
    pg = (GenInstance *) ObjDerefGen(parent);
    if (!(g->GI_states & GS_ENABLED))
	pg->GI_states &= ~GS_ENABLED;
    pg->GI_attrs &= ~GA_TARGETABLE;
    pg->GI_attrs |= g->GI_attrs & GA_TARGETABLE;
    if (view) {
	GenViewInstance *v;

	content = ObjInstantiate(OptrToHandle(o),
				 (ClassStruct *) &GenContentClass);
	ObjSetFlags(content, OCF_IGNORE_DIRTY, 0);
	ObjInitializePart(content, word_offsetof(GenBase, Gen_offset));
	ObjInitializePart(content, word_offsetof(VisBase, Vis_offset));
	ObjInitializePart(parent, word_offsetof(VisBase, Vis_offset));
	VisSetPosition(o, 0, 0);
	v = (GenViewInstance *) ObjDerefGen(parent);
	v->GVI_content = content;
	VisMarkFullyInvalid(o);
	VisGetBounds(o, &b);
	v = (GenViewInstance *) ObjDerefGen(parent);
	v->GVI_docBounds.RD_right = (word) (b.R_right - b.R_left) > SSS_DATA
				    ? SSS_DATA : (word) (b.R_right - b.R_left);
	((GenInstance *) ObjDerefGen(content))->GI_states |= GS_USABLE;
	((VisContentInstance *) ObjDerefVis(content))->VCNI_attrs |=
	    VCNA_SAME_WIDTH_AS_VIEW;
    }
    if (VisCheckIfSpecBuilt(o))
	return;
    gp = GenFindParent(o);
    if (!gp)
	return;
    pos = @call gp::MSG_GEN_FIND_CHILD(o);
    @call gp::MSG_GEN_ADD_CHILD(parent, (CompChildFlags) (pos + 1));
    ((GenInstance *) ObjDerefGen(parent))->GI_states |= GS_USABLE;
    if (VisCheckIfSpecBuilt(view ? content : parent))
	return;
    if (view)
	@call content::MSG_VIS_ADD_CHILD(o, CCO_LAST);
    else
	@call parent::MSG_VIS_ADD_CHILD(o, CCO_LAST);
    @call parent::MSG_SPEC_BUILD_BRANCH(flags);
    GenRemoveDownwardLink(OptrToHandle(parent), OptrToChunk(parent), 0);
}

/*
 * OpenDestroyGenericBranch: brought down without updating the parent,
 * the moniker kept out of it unless keepMoniker, destroyed
 */
void OpenDestroyGenericBranch(optr o, Boolean keepMoniker)
{
    if (!o || !OptrToChunk(o))
	return;
    ((GenInstance *) ObjDerefGen(o))->GI_states &= ~GS_USABLE;
    @call o::MSG_SPEC_SET_NOT_USABLE(VUM_MANUAL);
    if (!keepMoniker)
	((GenInstance *) ObjDerefGen(o))->GI_visMoniker = 0;
    @call o::MSG_GEN_DESTROY(VUM_NOW, 0);
}

/*
 * OpenUnbuildCreatedParent: the object out of its created parent (a
 * view: with its content), which is destroyed (not when only the
 * visual parent unbuilds); visually under its generic parent again,
 * without a size, and removed with the update mode of flags
 */
void OpenUnbuildCreatedParent(optr o, optr parent, SpecBuildFlags flags,
			      Boolean view, Boolean keepMoniker)
{
    optr gp;

    VisRemove(o, VUM_MANUAL);
    if (!(flags & SBF_VIS_PARENT_UNBUILDING) && parent) {
	if (view) {
	    optr content = @call parent::MSG_GEN_VIEW_GET_CONTENT();

	    OpenDestroyGenericBranch(parent, keepMoniker);
	    parent = content;
	}
	OpenDestroyGenericBranch(parent, keepMoniker);
    }
    gp = GenFindParent(o);
    if (gp)
	@call gp::MSG_VIS_ADD_CHILD(o, CCO_LAST);
    VisSetSize(o, 0, 0);
    VisRemove(o, (VisUpdateMode) (flags & SBF_UPDATE_MODE));
}

/*
 * ForwardMenuSepQueryToNextSiblingOrParent: the menu separator query
 * on to the next visible sibling, else to the parent as from its last
 * child
 */
MenuSepFlags OpenForwardMenuSepQuery(optr obj, MenuSepFlags f)
{
    optr next = ((VisInstance *) ObjDerefVis(obj))->VI_link.LP_next;

    if (!next)
	return f;
    if (next & LP_IS_PARENT) {
	next &= ~(optr) LP_IS_PARENT;
	f |= MSF_FROM_CHILD;
    }
    return @call next::MSG_SPEC_MENU_SEP_QUERY(f);
}

/* ---------------------------------------------------------------------
 * Scrollbars of views and lists (copenUtils.asm)
 * ------------------------------------------------------------------- */

/*
 * OpenSetScrollbarAttrs: the scrollbar's output (to parent), its message,
 * orientation and range; values of zero not set when creating (the
 * defaults); drawable, detectable and managed
 */
void OpenSetScrollbarAttrs(optr sb, optr parent, Boolean creating,
			   const OpenScrollbarArgs *a)
{
    VisInstance *v;

    @call sb::MSG_GEN_VALUE_SET_DESTINATION(parent);
    @call sb::MSG_GEN_VALUE_SET_APPLY_MSG(a->OSA_actionMsg);
    @call sb::MSG_SET_ORIENTATION(a->OSA_vertical);
    if (!creating || a->OSA_maximum)
	@call sb::MSG_GEN_VALUE_SET_MAXIMUM(a->OSA_maximum);
    if (!creating || a->OSA_minimum)
	@call sb::MSG_GEN_VALUE_SET_MINIMUM(a->OSA_minimum);
    if (!creating || a->OSA_value)
	@call sb::MSG_GEN_VALUE_SET_VALUE(a->OSA_value, FALSE);
    if (!creating || a->OSA_increment)
	@call sb::MSG_GEN_VALUE_SET_INCREMENT(a->OSA_increment);
    v = (VisInstance *) ObjDerefVis(sb);
    if ((v->VI_attrs & (VA_DRAWABLE | VA_DETECTABLE | VA_MANAGED)) !=
	(VA_DRAWABLE | VA_DETECTABLE | VA_MANAGED))
	@call sb::MSG_VIS_SET_ATTRS(VA_DRAWABLE | VA_DETECTABLE | VA_MANAGED,
				    0, VUM_MANUAL);
}

/*
 * OpenAddScrollbar: a GenValue with the hint made the last generic child
 * of the parent (a one-way upward link only unless saved with it: dirty),
 * built and set up as a scrollbar
 */
optr OpenAddScrollbar(optr parent, word hint, Boolean dirty,
		      Boolean immediateDrag, const OpenScrollbarArgs *a)
{
    optr sb = OpenCreateChildObject(OptrToHandle(parent), parent,
				    (ClassStruct *) &GenValueClass,
				    hint | VDF_SAVE_TO_STATE, TRUE, FALSE,
				    CCO_LAST | (dirty ? CCF_MARK_DIRTY : 0));
    SpecBuildFlags f = 0;

    if (immediateDrag)
	(void) ObjVarAddData(sb, HINT_VALUE_IMMEDIATE_DRAG_NOTIFICATION, 0);
    /* a slider takes the parent's HINT_VALUE_DELAYED_DRAG_NOTIFICATION */
    if (hint == HINT_SPEC_SLIDER &&
	ObjVarFindData(parent, HINT_VALUE_DELAYED_DRAG_NOTIFICATION))
	(void) ObjVarAddData(sb, HINT_VALUE_DELAYED_DRAG_NOTIFICATION, 0);
    if (!dirty) {
	ObjSetFlags(sb, OCF_IGNORE_DIRTY, OCF_DIRTY);
	GenRemoveDownwardLink(OptrToHandle(sb), OptrToChunk(sb), 0);
    }
    if (((VisInstance *) ObjDerefVis(parent))->VI_attrs & VA_FULLY_ENABLED)
	f = SBF_VIS_PARENT_FULLY_ENABLED;
    @call sb::MSG_SPEC_BUILD(f);
    OpenSetScrollbarAttrs(sb, parent, TRUE, a);
    return sb;
}

/*
 * SpecSetFlagsOnAllCtrlParents: OLCOF_CANT_OVERLAP_KIDS on the OLCtrls
 * above, up to the window group (or one that has it already)
 */
void SpecSetFlagsOnAllCtrlParents(optr obj)
{
    optr p = VisFindParent(obj);
    OLCtrlInstance *c;

    while (p && ObjIsObjectInClass(p, &OLCtrlClass)) {
	c = (OLCtrlInstance *) ObjDerefVis(p);
	if ((c->OLCI_moreFlags & OLCOF_CANT_OVERLAP_KIDS) ||
	    (c->VI_typeFlags & VTF_IS_WIN_GROUP))
	    break;
	c->OLCI_moreFlags |= OLCOF_CANT_OVERLAP_KIDS;
	p = VisFindParent(p);
    }
}

/*
 * OpenSetInsetRectColors: the colors of OpenDrawRect for an inset frame
 * (dark top left, white bottom right; black in black and white) and the
 * area color of its inside (white, the light color in color)
 */
word OpenSetInsetRectColors(GStateHandle gs)
{
    if (moCS_flags & CSF_BW) {
	GrSetAreaColor(gs, CF_INDEX, C_WHITE, 0, 0);
	return (C_BLACK << 8) | C_BLACK;
    }
    GrSetAreaColor(gs, CF_INDEX, moCS_dsLightColor, 0, 0);
    return (C_WHITE << 8) | moCS_dsDarkColor;
}

#define UKEY(k)		((KS_CHAR_SET_CONTROL << 8) | (k))

/* the text object's keys (cviewVariable.def, CUA style): not special */
static const KeyboardShortcut textKbdBindings[] = {
    KS_PHYSICAL | KS_CTRL | KS_SHIFT | UKEY(VC_LEFT),
    KS_PHYSICAL | KS_CTRL | KS_SHIFT | UKEY(VC_RIGHT),
    KS_PHYSICAL | KS_CTRL | KS_SHIFT | UKEY(VC_UP),
    KS_PHYSICAL | KS_CTRL | KS_SHIFT | UKEY(VC_DOWN),
    KS_PHYSICAL | KS_CTRL | KS_SHIFT | UKEY(VC_HOME),
    KS_PHYSICAL | KS_CTRL | KS_SHIFT | UKEY(VC_END),
    KS_PHYSICAL | KS_CTRL | UKEY(VC_LEFT),
    KS_PHYSICAL | KS_CTRL | UKEY(VC_RIGHT),
    KS_PHYSICAL | KS_CTRL | UKEY(VC_UP),
    KS_PHYSICAL | KS_CTRL | UKEY(VC_DOWN),
    KS_PHYSICAL | KS_CTRL | UKEY(VC_HOME),
    KS_PHYSICAL | KS_CTRL | UKEY(VC_END),
    KS_PHYSICAL | KS_SHIFT | UKEY(VC_LEFT),
    KS_PHYSICAL | KS_SHIFT | UKEY(VC_RIGHT),
    KS_PHYSICAL | KS_SHIFT | UKEY(VC_UP),
    KS_PHYSICAL | KS_SHIFT | UKEY(VC_DOWN),
    KS_PHYSICAL | KS_SHIFT | UKEY(VC_HOME),
    KS_PHYSICAL | KS_SHIFT | UKEY(VC_END),
    UKEY(VC_UP), UKEY(VC_DOWN), UKEY(VC_LEFT), UKEY(VC_RIGHT),
    UKEY(VC_HOME), UKEY(VC_END), UKEY(VC_BACKSPACE), UKEY(VC_DEL),
    KS_SHIFT | UKEY(VC_BACKSPACE), KS_SHIFT | UKEY(VC_DEL),
    KS_CTRL | UKEY(VC_BACKSPACE), KS_CTRL | UKEY(VC_DEL),
    KS_CTRL | KS_SHIFT | UKEY(VC_BACKSPACE),
    KS_PHYSICAL | KS_CTRL | KS_SHIFT | UKEY(VC_DEL),
    KS_PHYSICAL | KS_CTRL | (KS_CHAR_SET_PRINTABLE << 8) | ' ',
    KS_PHYSICAL | KS_ALT | UKEY(VC_INS),
    KS_PHYSICAL | UKEY(VC_INS),
    KS_CTRL | KS_SHIFT | (KS_CHAR_SET_PRINTABLE << 8) | '"',
    KS_CTRL | KS_SHIFT | (KS_CHAR_SET_PRINTABLE << 8) | '\'',
    KS_CTRL | (KS_CHAR_SET_PRINTABLE << 8) | '"',
    KS_CTRL | (KS_CHAR_SET_PRINTABLE << 8) | '\'',
    KS_PHYSICAL | UKEY(VC_JOYSTICK_180),
    KS_PHYSICAL | UKEY(VC_JOYSTICK_0)
};

/* what the keys do, in the order of the table (VisTextKeyFunction) */
static const word textKbdFunctions[] = {
    VTKF_SELECT_ADJUST_BACKWARD_WORD, VTKF_SELECT_ADJUST_FORWARD_WORD,
    VTKF_SELECT_ADJUST_BACKWARD_PARAGRAPH,
    VTKF_SELECT_ADJUST_FORWARD_PARAGRAPH,
    VTKF_SELECT_ADJUST_TO_START, VTKF_SELECT_ADJUST_TO_END,
    VTKF_BACKWARD_WORD, VTKF_FORWARD_WORD,
    VTKF_BACKWARD_PARAGRAPH, VTKF_FORWARD_PARAGRAPH,
    VTKF_START_OF_TEXT, VTKF_END_OF_TEXT,
    VTKF_SELECT_ADJUST_BACKWARD_CHAR, VTKF_SELECT_ADJUST_FORWARD_CHAR,
    VTKF_SELECT_ADJUST_BACKWARD_LINE, VTKF_SELECT_ADJUST_FORWARD_LINE,
    VTKF_SELECT_ADJUST_START_OF_LINE, VTKF_SELECT_ADJUST_END_OF_LINE,
    VTKF_BACKWARD_LINE, VTKF_FORWARD_LINE,
    VTKF_BACKWARD_CHAR, VTKF_FORWARD_CHAR,
    VTKF_START_OF_LINE, VTKF_END_OF_LINE,
    VTKF_DELETE_BACKWARD_CHAR, VTKF_DELETE_CHAR,
    VTKF_DELETE_BACKWARD_CHAR, VTKF_DELETE_CHAR,
    VTKF_DELETE_BACKWARD_WORD, VTKF_DELETE_WORD,
    VTKF_DELETE_BACKWARD_LINE, VTKF_DELETE_LINE,
    VTKF_SELECT_WORD, VTKF_DESELECT, VTKF_TOGGLE_OVERSTRIKE_MODE,
    VTKF_TOGGLE_SMART_QUOTES, VTKF_TOGGLE_SMART_QUOTES,
    VTKF_TOGGLE_SMART_QUOTES, VTKF_TOGGLE_SMART_QUOTES,
    VTKF_BACKWARD_CHAR, VTKF_FORWARD_CHAR
};

/*
 * SpecGetTextKbdBindings (SPIR_GET_TEXT_KBD_BINDINGS): the text
 * object's keys: the shortcuts, their count and the function of each
 */
const KeyboardShortcut *SpecGetTextKbdBindings(word *count,
					       const word **functions)
{
    *count = sizeof(textKbdBindings) / sizeof(textKbdBindings[0]);
    *functions = textKbdFunctions;
    return textKbdBindings;
}

/*
 * SpecCheckIfSpecialUIChar: a key for the UI rather than the object with
 * the focus: Alt, F10, releases of control keys, shortcuts that are not
 * the text object's keys (the keypad's joystick keys are not)
 */
Boolean SpecCheckIfSpecialUIChar(word c, word flags, word state)
{
    byte cs = c >> 8, ch = c & 0xff;

    if (c == ((CS_CONTROL << 8) | VC_LALT) ||
	c == ((CS_CONTROL << 8) | VC_RALT) ||
	c == ((CS_CONTROL << 8) | VC_F10))
	return TRUE;
    if (cs == CS_CONTROL && ch >= VC_JOYSTICK_0 && ch <= VC_FIRE_BUTTON_2)
	return FALSE;
    if (flags & CF_RELEASE)
	return ch >= 0x80;
    if (!UserCheckAcceleratorChar(c, flags, state) ||
	UserCheckInsertableCtrlChar(c, flags, state))
	return FALSE;
    return FlowCheckKbdShortcut((KeyboardShortcut *) textKbdBindings,
				sizeof(textKbdBindings) /
				sizeof(textKbdBindings[0]), c, flags,
				state) == (word) -1;
}

/*
 * ConvertKeyToMethod: the message for the key in a table of shortcuts
 * and the messages beside it; 0 if not there
 */
Message ConvertKeyToMethod(const KeyboardShortcut *keys, const Message *msgs,
			   word count, word c, word flags, word state)
{
    word off = FlowCheckKbdShortcut((KeyboardShortcut *) keys, count, c,
				    flags, state);

    return off == (word) -1 ? 0 : msgs[off / sizeof(KeyboardShortcut)];
}

/*
 * OLBroadcastForDefaultFocus (OLBroadcastForDefaultFocus_callBack over
 * the visible children): the object with HINT_DEFAULT_FOCUS below o;
 * every fully enabled child is asked, the last to answer stays
 */
void OLBroadcastForDefaultFocus(optr o, ObjectAndGrabParams *q)
{
    optr c;
    word i;

    for (i = 0; (c = @call o::MSG_VIS_FIND_CHILD_AT_POSITION(i)) != 0; i++)
	if (((VisInstance *) ObjDerefVis(c))->VI_attrs & VA_FULLY_ENABLED)
	    @call c::MSG_SPEC_BROADCAST_FOR_DEFAULT_FOCUS(q);
}
