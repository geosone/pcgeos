/*
 * copenUtils.goc -- utilities of the specific UI (after copenUtils.asm):
 * so far the line bounds of an object, the display checks (CGA, black
 * and white, TV, the screen's dimensions), GStates for the UI, the
 * conditional hints, the flags of a parent OLCtrl, the visibility
 * notification and the size of a generic moniker.  The pointer images of
 * OpenGetPtrImage are in cutilsPtrImages.goc.
 */
@include "cGeode.goh"

/* OpenGetLineBounds: the bounds of the object for drawing lines: the
 * right and bottom one pixel in */
void OpenGetLineBounds(optr obj, Rectangle *r)
{
    VisGetBounds(obj, r);
    r->R_right--;
    r->R_bottom--;
}

/* OpenCheckIfCGA: a very squished or tiny display */
Boolean OpenCheckIfCGA(void)
{
    return (moCS_flags & (CSF_VERY_SQUISHED | CSF_TINY)) != 0;
}

/* OpenMinimizeIfCGA: 0 on a CGA, else the value */
word OpenMinimizeIfCGA(word value)
{
    return OpenCheckIfCGA() ? 0 : value;
}

/* OpenCheckIfBW: a black and white display */
Boolean OpenCheckIfBW(void)
{
    return (moCS_flags & CSF_BW) != 0;
}

/* OpenGetScreenDimensions: the default screen's size (cached once
 * known) */
void OpenGetScreenDimensions(word *width, word *height)
{
    if (!screenHeight) {
	optr screen = 0;
	Rectangle b;

	UserCallSystem(MSG_GEN_SYSTEM_GET_DEFAULT_SCREEN, NULL, 0, &screen,
		       sizeof(screen));
	if (screen) {
	    @call screen::MSG_VIS_GET_BOUNDS(&b);
	    screenWidth = b.R_right;
	    screenHeight = b.R_bottom;
	}
    }
    *width = screenWidth;
    *height = screenHeight;
}

/* OpenCheckIfNarrow: a very narrow application */
Boolean OpenCheckIfNarrow(void)
{
    return (moCS_flags & CSF_VERY_NARROW) != 0;
}

/* OpenCheckIfTV: a TV display */
Boolean OpenCheckIfTV(void)
{
    return (moCS_flags & CSF_TV) != 0;
}

/* OpenCheckDefaultRings: if default rings are drawn */
Boolean OpenCheckDefaultRings(void)
{
    return !olNoDefaultRing;
}

/* OpenCheckIfVerticalScreen: a screen higher than wide */
Boolean OpenCheckIfVerticalScreen(void)
{
    word w, h;

    OpenGetScreenDimensions(&w, &h);
    return w < h;
}

/* OpenCheckIfLimitedLength: no room in the direction the composite
 * orients its children (vertically: a CGA, else a very narrow
 * application) */
Boolean OpenCheckIfLimitedLength(optr obj)
{
    byte geo = ((VisCompInstance *) ObjDerefVis(obj))->VCI_geoAttrs;

    if (geo & VCGA_ORIENT_CHILDREN_VERTICALLY)
	return (moCS_flags & (CSF_VERY_SQUISHED | CSF_TINY)) != 0;
    return (moCS_flags & CSF_VERY_NARROW) != 0;
}

/* ---------------------------------------------------------------------
 * GStates
 * ------------------------------------------------------------------- */

/* ViewCreateGState: a GState on the window (or none) with the display
 * scheme in its private data, the UI's font and square line ends */
GStateHandle ViewCreateGState(WindowHandle win)
{
    GStateHandle gs = GrCreateState(win);
    DisplayScheme d;

    SpecGetDisplayScheme(&d);
    GrSetPrivateData(gs, (word) (d.DS_colorScheme | (d.DS_displayType << 8)),
		     (word) (d.DS_lightColor | (d.DS_darkColor << 8)),
		     d.DS_fontID, (word) d.DS_pointSize);
    GrSetFont(gs, d.DS_fontID, MakeWWFixed(d.DS_pointSize));
    GrSetLineEnd(gs, LE_SQUARECAP);
    return gs;
}

/* ViewCreateCalcGState: one without a window, for calculations */
GStateHandle ViewCreateCalcGState(void)
{
    return ViewCreateGState(0);
}

/* VupCreateGState: one on the object's window */
GStateHandle VupCreateGState(optr obj)
{
    return ViewCreateGState(VisQueryWindow(obj));
}

/* ---------------------------------------------------------------------
 * Conditional hints
 * ------------------------------------------------------------------- */

/* the next entry of the variable data (offsets in the chunk) */
static word NextVarEntry(const byte *p, word e, word end)
{
    word size = ((const VarDataEntry *) (p + e))->VDE_entrySize;

    if (size < sizeof(VarDataEntry))
	return end;
    e = (word) ((e + size + 7u) & ~7u);
    return e > end ? end : e;
}

static word VarEntryType(const byte *p, word e, word end)
{
    return e < end ?
	(word) (((const VarDataEntry *) (p + e))->VDE_dataType & VDF_TYPE) : 0;
}

/*
 * RemoveConditionalHintsIfNeeded: for each HINT_IF_SYSTEM_ATTRS, the
 * hints up to its HINT_ELSE or HINT_ENDIF (just the next one without)
 * are kept if the system has one of the attributes (none of them with
 * SA_NOT), else those after HINT_ELSE up to HINT_ENDIF; the others and
 * the conditional hints themselves are deleted (FindConditionalHints)
 */
void RemoveConditionalHintsIfNeeded(optr obj)
{
    SystemAttrs *sa;

    while ((sa = ObjVarFindData(obj, HINT_IF_SYSTEM_ATTRS)) != NULL) {
	byte *p = LMemDeref(obj);
	word end = LMemGetChunkSize(obj);
	word e = (word) ((byte *) sa - sizeof(VarDataEntry) - p);
	word ifStart, ifEnd, elseStart = 0, elseEnd = 0, t;
	Boolean met, endif = FALSE;

	met = (*sa & SA_NOT) ? !(*sa & olSystemAttrs & ~SA_NOT)
			     : (*sa & olSystemAttrs) != 0;
	e = NextVarEntry(p, e, end);
	ifStart = e;
	t = VarEntryType(p, e, end);
	if (t != HINT_ELSE && t != HINT_ENDIF)
	    e = NextVarEntry(p, e, end);
	ifEnd = e;
	while ((t = VarEntryType(p, e, end)) != 0) {
	    if (t == HINT_ELSE) {
		elseStart = e;
		e = NextVarEntry(p, e, end);
		ifEnd = e;		/* HINT_ELSE goes with the "if" */
		continue;
	    }
	    if (t == HINT_ENDIF) {
		if (elseStart)
		    elseEnd = e;
		else
		    ifEnd = e;
		endif = TRUE;
		break;
	    }
	    e = NextVarEntry(p, e, end);
	}
	if (met) {
	    ifStart = elseStart;
	    ifEnd = elseEnd;
	}
	if (ifStart && ifEnd > ifStart)
	    LMemDeleteAt(obj, ifStart, (word) (ifEnd - ifStart));
	if (endif)
	    (void) ObjVarDeleteData(obj, HINT_ENDIF);
	(void) ObjVarDeleteData(obj, HINT_IF_SYSTEM_ATTRS);
    }
}

/* OpenScanVarData: ObjVarScanData after the conditional hints are
 * resolved */
void OpenScanVarData(optr obj, word numHandlers, VarDataCHandler *table,
		     void *data)
{
    RemoveConditionalHintsIfNeeded(obj);
    ObjVarScanData(obj, numHandlers, table, data);
}

/* ---------------------------------------------------------------------
 * The flags of a parent OLCtrl
 * ------------------------------------------------------------------- */

/* OpenGetFlagsIfCtrl: the flags of the vis parent if it is an OLCtrl,
 * else its answer to the message (0 if none); a window has none */
static word GetFlagsIfCtrl(optr obj, Boolean more)
{
    optr parent;
    word f = 0;

    if (((VisInstance *) ObjDerefVis(obj))->VI_typeFlags & VTF_IS_WIN_GROUP)
	return 0;
    parent = VisFindParent(obj);
    if (!parent)
	return 0;
    ObjLockObjBlock(OptrToHandle(parent));
    if (ObjIsObjectInClass(parent, &OLCtrlClass)) {
	OLCtrlInstance *c = (OLCtrlInstance *) ObjDerefVis(parent);

	f = more ? c->OLCI_moreFlags : c->OLCI_buildFlags;
	MemUnlock(OptrToHandle(parent));
	return f;
    }
    MemUnlock(OptrToHandle(parent));
    if (more) {
	OLCtrlMoreFlags m = 0;

	if (@call parent::MSG_VUP_GET_MORE_FLAGS(&m))
	    f = m;
    } else {
	OLBuildFlags b = 0;

	if (@call parent::MSG_VUP_GET_BUILD_FLAGS(&b))
	    f = b;
    }
    return f;
}

OLBuildFlags OpenGetParentBuildFlagsIfCtrl(optr obj)
{
    return (OLBuildFlags) GetFlagsIfCtrl(obj, FALSE);
}

OLCtrlMoreFlags OpenGetParentMoreFlagsIfCtrl(optr obj)
{
    return (OLCtrlMoreFlags) GetFlagsIfCtrl(obj, TRUE);
}

/* ---------------------------------------------------------------------
 * Visibility notification (copenButtonClass.asm)
 * ------------------------------------------------------------------- */

/* VisOpenCloseNotifyCommon: ATTR_GEN_VISIBILITY_MESSAGE (else
 * MSG_GEN_APPLICATION_VISIBILITY_NOTIFICATION) with the object (or
 * ATTR_GEN_VISIBILITY_DATA) to ATTR_GEN_VISIBILITY_DESTINATION (else
 * the application) */
static void VisOpenCloseNotifyCommon(optr obj, Boolean opening)
{
    optr data = obj, dest;
    Message msg = MSG_GEN_APPLICATION_VISIBILITY_NOTIFICATION;
    void *p;

    if ((p = ObjVarFindData(obj, ATTR_GEN_VISIBILITY_DATA)) != NULL)
	data = *(optr *) p;
    if ((p = ObjVarFindData(obj, ATTR_GEN_VISIBILITY_MESSAGE)) != NULL)
	msg = *(Message *) p;
    if ((p = ObjVarFindData(obj, ATTR_GEN_VISIBILITY_DESTINATION)) != NULL)
	dest = *(optr *) p;
    else
	dest = GeodeGetAppObject(0);
    if (dest)
	@send dest::{GEN_VISIBILITY_OUTPUT}(msg)(data, opening);
}

void VisOpenNotifyCommon(optr obj)
{
    VisOpenCloseNotifyCommon(obj, TRUE);
}

void VisCloseNotifyCommon(optr obj)
{
    VisOpenCloseNotifyCommon(obj, FALSE);
}

/* ---------------------------------------------------------------------
 * Moniker sizes (copenMoniker.asm)
 * ------------------------------------------------------------------- */

static word systemFontHeight;
static word addOnMnemonicWidth;

/* GetSystemFontHeight: the height of the UI's font (cached;
 * CalcAndCacheSystemFontHeight) */
word GetSystemFontHeight(void)
{
    if (!systemFontHeight) {
	GStateHandle gs = ViewCreateCalcGState();

	systemFontHeight = (word) GrFontMetrics(gs, GFMI_HEIGHT_ROUNDED);
	GrDestroyState(gs);
    }
    return systemFontHeight;
}

/* SpecGetGenMonikerSize: the generic moniker's size; a mnemonic not in
 * the text is shown after it (as " (w)") */
SizeAsDWord SpecGetGenMonikerSize(optr obj, GStateHandle gs)
{
    ChunkHandle m = ((GenInstance *) ObjDerefGen(obj))->GI_visMoniker;
    SizeAsDWord s;
    VisMonikerWithText *t;

    s = VisGetMonikerSize(obj, m, GetSystemFontHeight(), gs);
    if (!m)
	return s;
    t = LMemDeref(ConstructOptr(OptrToHandle(obj), m));
    if ((t->VMWT_common.VM_type & VMT_GSTRING) ||
	(byte) t->VMWT_mnemonicOffset != 0xfe)	/* VMO_MNEMONIC_NOT_IN_MKR_TEXT */
	return s;
    if (!addOnMnemonicWidth) {
	GStateHandle cg = ViewCreateCalcGState();

	addOnMnemonicWidth = GrTextWidth(cg, " (w)", 4);
	GrDestroyState(cg);
    }
    return MAKE_SIZE_DWORD(DWORD_WIDTH(s) + addOnMnemonicWidth,
			   DWORD_HEIGHT(s));
}

/* ---------------------------------------------------------------------
 * The keyboard
 * ------------------------------------------------------------------- */

/* CheckIfKeyboardRequired (cmainUtils.asm): no keyboard, or the
 * floating keyboard wanted ([input] floatingKbd) */
Boolean CheckIfKeyboardRequired(void)
{
    return (FlowGetUIButtonFlags() & UIBF_NO_KEYBOARD) || kbdRequired;
}

/* OpenCheckIfKeyboardOnly: no mouse */
Boolean OpenCheckIfKeyboardOnly(void)
{
    return (FlowGetUIButtonFlags() & UIBF_KEYBOARD_ONLY) != 0;
}

/* OpenCheckIfKeyboard: the user may navigate with the keyboard (no
 * mouse, or a keyboard) */
Boolean OpenCheckIfKeyboard(void)
{
    UIButtonFlags f = FlowGetUIButtonFlags();

    return (f & UIBF_KEYBOARD_ONLY) || !(f & UIBF_NO_KEYBOARD);
}

/* OpenCheckIfKeyboardNavigation: [motif options] kbdNavigation */
Boolean OpenCheckIfKeyboardNavigation(void)
{
    return (olWindowOptions & UIWO_KBD_NAVIGATION) != 0;
}

/* OpenDoClickSound: the key click, if wanted (Port32: no
 * UserStandardSound yet, the sound library is not ported) */
void OpenDoClickSound(void)
{
    if (specDoClickSound)
	return;		/* UserStandardSound(SST_KEY_CLICK) */
}

/* ---------------------------------------------------------------------
 * The window of an object, gadget colors
 * ------------------------------------------------------------------- */

/* OpenFindOLWin (FindOLWin): the OLWin the object is in (itself if it
 * is one), up the vis tree as far as this thread runs it; 0 if none */
optr OpenFindOLWin(optr o)
{
    while (o) {
	VisInstance *v;
	Boolean win;

	if (!ObjTestIfObjBlockRunByCurThread(OptrToHandle(o)))
	    return 0;
	ObjLockObjBlock(OptrToHandle(o));
	v = (VisInstance *) ObjDerefVis(o);
	win = (v->VI_typeFlags & VTF_IS_WIN_GROUP) &&
	      ObjIsObjectInClass(o, &OLWinClass);
	MemUnlock(OptrToHandle(o));
	if (win)
	    return o;
	o = VisFindParent(o);
    }
    return 0;
}

/* GetCtrlColors: an OLCtrl's HINT_GADGET_BACKGROUND_COLORS, or (in a
 * toolbox) its parent's: the first and second color, unselected and
 * selected */
static Boolean GetCtrlColors(optr o, word *unsel, word *sel)
{
    while (o) {
	BackgroundColors *bc;
	Boolean toolbox;

	ObjLockObjBlock(OptrToHandle(o));
	if (!ObjIsObjectInClass(o, &OLCtrlClass)) {
	    MemUnlock(OptrToHandle(o));
	    return FALSE;
	}
	bc = ObjVarFindData(o, HINT_GADGET_BACKGROUND_COLORS);
	if (bc) {
	    *unsel = bc->BC_unselectedColor1 | (bc->BC_unselectedColor2 << 8);
	    *sel = bc->BC_selectedColor1 | (bc->BC_selectedColor2 << 8);
	    MemUnlock(OptrToHandle(o));
	    return TRUE;
	}
	toolbox = (((OLCtrlInstance *) ObjDerefVis(o))->OLCI_buildFlags &
		   OLBF_TOOLBOX) != 0;
	MemUnlock(OptrToHandle(o));
	if (!toolbox)
	    return FALSE;
	o = VisFindParent(o);
    }
    return FALSE;
}

/*
 * OpenGetBackgroundColor: the object's HINT_GADGET_BACKGROUND_COLORS, a
 * parent OLCtrl's, or the light color (selected: the selection's); the
 * selected ones if asked for: the first color in the low byte, the
 * second (drawn over it at 50%) in the high one
 */
word OpenGetBackgroundColor(optr o, Boolean selected)
{
    BackgroundColors *bc = ObjVarFindData(o, HINT_GADGET_BACKGROUND_COLORS);
    word unsel, sel;

    if (bc) {
	unsel = bc->BC_unselectedColor1 | (bc->BC_unselectedColor2 << 8);
	sel = bc->BC_selectedColor1 | (bc->BC_selectedColor2 << 8);
    } else if (!GetCtrlColors(VisFindParent(o), &unsel, &sel)) {
	unsel = moCS_dsLightColor | (moCS_dsLightColor << 8);
	sel = moCS.CSV_selBkgdColor | (moCS.CSV_selBkgdColor << 8);
    }
    return selected ? sel : unsel;
}

/* OpenGetTextColor: the object's or its vis parent's
 * HINT_GADGET_TEXT_COLOR (FALSE: none) */
Boolean OpenGetTextColor(optr o, Color *c)
{
    TextColors *tc = ObjVarFindData(o, HINT_GADGET_TEXT_COLOR);
    optr p;

    if (tc) {
	*c = tc->TC_unselectedColor;
	return TRUE;
    }
    p = VisFindParent(o);
    if (!p)
	return FALSE;
    ObjLockObjBlock(OptrToHandle(p));
    tc = ObjVarFindData(p, HINT_GADGET_TEXT_COLOR);
    if (tc)
	*c = tc->TC_unselectedColor;
    MemUnlock(OptrToHandle(p));
    return tc != NULL;
}

/* ---------------------------------------------------------------------
 * The default focus and target
 * ------------------------------------------------------------------- */

typedef struct {
    Boolean	focus;
    Boolean	target;
} FocusTargetHints;

static void FocusTargetHint(MemHandle mh, ChunkHandle chnk,
			    VarDataEntry *extra, word dataType,
			    void *handlerData)
{
    FocusTargetHints *h = handlerData;

    (void) mh; (void) chnk; (void) extra;
    if (dataType == HINT_DEFAULT_FOCUS)
	h->focus = TRUE;
    else
	h->target = TRUE;
}

static VarDataCHandler focusTargetHints[] = {
    { HINT_DEFAULT_FOCUS, FocusTargetHint },
    { HINT_DEFAULT_TARGET, FocusTargetHint },
};

static Boolean FullyEnabled(optr obj)
{
    return (((VisInstance *) ObjDerefVis(obj))->VI_attrs &
	    VA_FULLY_ENABLED) != 0;
}

/*
 * ScanFocusTargetHintHandlers: HINT_DEFAULT_TARGET and then
 * HINT_DEFAULT_FOCUS grab the target and focus if the object is fully
 * enabled; TRUE if it has the focus hint (ScanTargetHintHandler: only
 * the target grabbed)
 */
static Boolean ScanFocusTargetHints(optr obj, FocusTargetHints *h)
{
    h->focus = h->target = FALSE;
    ObjVarScanData(obj, sizeof(focusTargetHints) / sizeof(focusTargetHints[0]),
		   focusTargetHints, h);
    if (h->target && FullyEnabled(obj))
	@call obj::MSG_META_GRAB_TARGET_EXCL();
    return h->focus;
}

Boolean ScanTargetHintHandler(optr obj)
{
    FocusTargetHints h;

    return ScanFocusTargetHints(obj, &h);
}

Boolean ScanFocusTargetHintHandlers(optr obj)
{
    FocusTargetHints h;

    if (ScanFocusTargetHints(obj, &h) && FullyEnabled(obj))
	@call obj::MSG_META_GRAB_FOCUS_EXCL();
    return h.focus;
}

/* ---------------------------------------------------------------------
 * The parent window
 * ------------------------------------------------------------------- */

/* OpenGetParentWinSize: the size of the parent window (its info, with
 * the margins for windows extended near its corner); FALSE if it has
 * none */
Boolean OpenGetParentWinSize(optr obj, WinSizeInfoParams *p)
{
    optr parent = VisFindParent(obj);

    memset(p, 0, sizeof(*p));
    if (parent)
	@call parent::MSG_SPEC_VUP_GET_WIN_SIZE_INFO(p);
    return p->WSIP_windowWidth && p->WSIP_windowHeight;
}

/* ---------------------------------------------------------------------
 * Drawing
 * ------------------------------------------------------------------- */

/*
 * OpenDrawRect (SetupDraw, DrawFrame): a frame in the rectangle (the
 * bounds of a fill), the top left in the low color, the bottom right
 * in the high one (the white one leaves the corners); a disabled object
 * clears it first and draws it 50%
 */
void OpenDrawRect(optr obj, GStateHandle gs, sword left, sword top,
		  sword right, sword bottom, word colors)
{
    Color br = (Color) (colors >> 8);

    if (!FullyEnabled(obj)) {
	GrSetLineColor(gs, CF_INDEX, moCS_dsLightColor, 0, 0);
	GrSetLineMaskSys(gs, SDM_50 | SDM_INVERSE);
	GrDrawRect(gs, left, top, (sword) (right - 1), (sword) (bottom - 1));
	GrSetLineMaskSys(gs, SDM_50);
    }
    GrSetLineColor(gs, CF_INDEX, (byte) colors, 0, 0);
    right--;
    bottom--;
    GrDrawVLine(gs, left, top, bottom);
    GrDrawHLine(gs, left, top, right);
    GrSetLineColor(gs, CF_INDEX, br, 0, 0);
    if (br == C_WHITE) {
	top++;
	left++;
    }
    GrDrawVLine(gs, right, top, bottom);
    GrDrawHLine(gs, left, bottom, right);
    GrSetLineMaskSys(gs, SDM_100);
}

#define GRADIENT_STEP_SIZE	4

/* CalcStep: a color component from start to end over the width, per
 * step (8.8 fixed, as the asm rounds it) */
static sdword CalcStep(byte start, byte end, sword width)
{
    sdword diff = (sdword) end - start;
    WWFixedAsDWord q;

    if (!diff || !width)
	return 0;
    q = GrSDivWWFixed((WWFixedAsDWord) (diff << 16),
		      (WWFixedAsDWord) ((sdword) width << 16));
    q = (WWFixedAsDWord) ((sdword) q * GRADIENT_STEP_SIZE);
    return ((sdword) q + 0x80) >> 8;
}

/*
 * DrawGradient: the rectangle filled from the start color (left) to
 * the end color (right), in steps of GRADIENT_STEP_SIZE
 */
void DrawGradient(GStateHandle gs, const Rectangle *r, Color start,
		  Color end)
{
    RGBColorAsDWord s = GrMapColorIndex(gs, start);
    RGBColorAsDWord e = GrMapColorIndex(gs, end);
    sword w = (sword) (r->R_right - r->R_left);
    sdword cur[3], step[3];
    sword x;
    int i;

    for (i = 0; i < 3; i++) {
	byte sc = (byte) (s >> (8 * i)), ec = (byte) (e >> (8 * i));

	cur[i] = (sdword) sc << 8;
	step[i] = CalcStep(sc, ec, w);
    }
    /* the last piece in the color before it, as the asm */
    for (x = r->R_left; ; ) {
	GrSetAreaColor(gs, CF_RGB, (word) ((cur[0] >> 8) & 0xff),
		       (word) ((cur[1] >> 8) & 0xff),
		       (word) ((cur[2] >> 8) & 0xff));
	GrFillRect(gs, x, r->R_top, (sword) (x + GRADIENT_STEP_SIZE + 1),
		   r->R_bottom);
	x += GRADIENT_STEP_SIZE;
	for (i = 0; i < 3; i++)
	    cur[i] += step[i];
	if (x + GRADIENT_STEP_SIZE >= r->R_right)
	    break;
    }
    GrFillRect(gs, x, r->R_top, r->R_right, r->R_bottom);
}

/*
 * OpenCreateChildObject: an object of the class in the block, not
 * dirtied (unless CCF_MARK_DIRTY), its generic part initialized, the
 * hint added (if any); added to the parent (if any) as a child or only
 * linked up to it; usable if asked for.
 */
optr OpenCreateChildObject(MemHandle block, optr parent, ClassStruct *class,
			   word hint, Boolean usable, Boolean oneWay,
			   CompChildFlags flags)
{
    optr o = ObjInstantiate(block, class);

    ObjSetFlags(o, (flags & CCF_MARK_DIRTY) ? OCF_DIRTY : OCF_IGNORE_DIRTY,
		0);
    ObjInitializePart(o, word_offsetof(GenBase, Gen_offset));
    if (hint)
	(void) ObjVarAddData(o, hint, 0);
    if (parent) {
	if (oneWay)
	    @call parent::MSG_GEN_ADD_CHILD_UPWARD_LINK_ONLY(o);
	else
	    @call parent::MSG_GEN_ADD_CHILD(o, flags);
    }
    if (usable)
	((GenInstance *) ObjDerefGen(o))->GI_states |= GS_USABLE;
    return o;
}
