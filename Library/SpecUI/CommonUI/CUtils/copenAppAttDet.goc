/*
 * copenAppAttDet.goc -- OLApplicationClass (after copenAppAttDet.asm):
 * the application object's start and end.  The application is the
 * geode's input object and the node of its focus, target and model
 * hierarchies; it lives on its field (a visual upward link only, no
 * visual child of it), opens no window of its own (it takes its
 * field's) and comes up when attached.
 *
 * Port32 (Port32/ABI.md section 13y):
 *   - the vis parent's window is asked of the vis parent
 *     (MSG_VIS_QUERY_WINDOW; MSG_SPEC_GUP_QUERY_VIS_PARENT returns the
 *     optr only);
 *   - GeodeSetUIData is not set (a word; nothing reads it);
 *   - not yet: the application's entries in the express menus
 *     (OLAppTaskItemClass, MSG_OL_APPLICATION_ADD_TO_FIELD_TASK_LIST),
 *     the standard dialogs (MSG_GEN_APPLICATION_DO_STANDARD_DIALOG).
 */
@include "cGeode.goh"
@include <Internal/flowC.goh>
@include <Internal/specC.goh>
@include <Objects/gInterC.goh>

@classdecl OLApplicationClass, neverSaved;

/* the methods in copenAppCommon.goc and copenAppMisc.goc */
