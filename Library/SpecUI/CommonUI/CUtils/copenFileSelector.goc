/* OLFSSetUsableOnFlags */
static void SetUsable(optr obj, Boolean usable)
{
    if (!obj)
	return;
    if (usable)
	@call obj::MSG_GEN_SET_USABLE(VUM_DELAYED_VIA_UI_QUEUE);
    else
	@call obj::MSG_GEN_SET_NOT_USABLE(VUM_DELAYED_VIA_UI_QUEUE);
}

/* OLFSTurnOffGadgetry: the gadgets the attributes ask for */
static void TurnOffGadgetry(optr o)
{
    FileSelectorAttrs a = GFS(o)->GFSI_attrs;

    SetUsable(UIObj(o, @OLFileSelectorDocumentButton),
	      (a & FSA_HAS_DOCUMENT_BUTTON) != 0);
    SetUsable(UIObj(o, @OLFileSelectorChangeDirectoryPopup),
	      (a & FSA_HAS_CHANGE_DIRECTORY_LIST) != 0);
    SetUsable(UIObj(o, @OLFileSelectorChangeDrivePopup),
	      (a & FSA_HAS_CHANGE_DRIVE_LIST) != 0);
    SetUsable(UIObj(o, @OLFileSelectorFileList),
	      (a & FSA_HAS_FILE_LIST) != 0);
}

@method OLFileSelectorClass, MSG_GEN_FILE_SELECTOR_SET_ATTRS
{
    (void) attributes;
    if (!pself->OLFSI_uiBlock)
	return;
    TurnOffGadgetry(oself);
    BuildChangeDrivePopup(oself);
    (void) MarkDirtyAndRescanIfRealized(oself);
}

/* OLFileSelectorAddVarData, ...DeleteVarData: the match attributes are
 * vardata */
static void VarDataChanged(optr o, word type)
{
    if (type >= ATTR_GEN_FILE_SELECTOR_TOKEN_MATCH &&
	type <= ATTR_GEN_FILE_SELECTOR_NAME_MASK)
	(void) MarkDirtyAndRescanIfRealized(o);
}

@method OLFileSelectorClass, MSG_META_ADD_VAR_DATA
{
    word type = dataType & ~(VDF_SAVE_TO_STATE | VDF_EXTRA_DATA);

    (void) pself;
    @callsuper();
    VarDataChanged(oself, type);
}

@method OLFileSelectorClass, MSG_META_DELETE_VAR_DATA
{
    Boolean r = @callsuper();

    (void) pself;
    VarDataChanged(oself, dataType & ~(VDF_SAVE_TO_STATE | VDF_EXTRA_DATA));
    return r;
}

/* OLFileSelectorGetFilterRoutine: the routine of the vardata, if any
 * (an application's subclass returns its own) */
@method OLFileSelectorClass, MSG_GEN_FILE_SELECTOR_GET_FILTER_ROUTINE
{
    void *d = ObjVarFindData(oself, ATTR_GEN_FILE_SELECTOR_FILE_ENUM_FILTER);

    (void) pself;
    filter->filterRoutine = NULL;
    filter->filterAttrs = NULL;
    /* (Port32: the vardata holds a pointer, so it has its size) */
    if (d && ((VarDataEntry *) d - 1)->VDE_entrySize - sizeof(VarDataEntry) >=
	     sizeof(filter->filterRoutine))
	memcpy(&filter->filterRoutine, d, sizeof(filter->filterRoutine));
}

/* ---------------------------------------------------------------------
 * The monikers of the list
 * ------------------------------------------------------------------- */

/* the icon of an entry: a volume's by the kind of its drive (the
 * DriveStatus in the high byte of the file flags) */
static const Bitmap *EntryIcon(const OLFileSelectorEntry *e, Boolean parent,
			       Boolean first)
{
    if (e->OLFSE_fileAttrs & FA_SUBDIR) {
	if (!parent)
	    return &narrowFolderIconBitmap.b;
	return first ? &openFolderIconBitmap.b : &folderIconBitmap.b;
    }
    if (!(e->OLFSE_fileAttrs & FA_VOLUME))
	return parent ? &fileIconBitmap.b : &narrowFileIconBitmap.b;
    switch ((e->OLFSE_fileFlags >> 8) & DS_TYPE) {
    case DRIVE_5_25:
	return &disk525IconBitmap.b;
    case DRIVE_3_5:
	return &disk35IconBitmap.b;
    case DRIVE_PCMCIA:
	return &diskPCMCIAIconBitmap.b;
    case DRIVE_FIXED:
    case DRIVE_CD_ROM:
	return &diskHDIconBitmap.b;
    default:
	return &diskRamIconBitmap.b;
    }
}

/*
 * OLFileSelectorRequestMoniker: the list asks for an item's moniker: a
 * graphics string of the entry's icon and name.  With the current
 * directory shown the first item is its name (the drive and volume at
 * the root) with an open folder (the drive's icon), the others are
 * indented.  Files shown disabled (FSA_SHOW_FILES_DISABLED) are.
 */
@method OLFileSelectorClass, MSG_OL_FILE_SELECTOR_ITEM_QUERY
{
    optr dl = UIObj(oself, @OLFileSelectorFileList);
    Boolean parent = (pself->OLFSI_state & OLFSS_SHOW_PARENT_DIR) != 0;
    OLFileSelectorEntry e;
    const Bitmap *bm;
    MemHandle bh;
    GStateHandle gs;
    word chunk = 0, n = item;
    ReplaceItemMonikerFlags flags = 0;

    (void) list;
    if (!dl)
	return;
    memset(&e, 0, sizeof(e));
    if (parent && !item) {
	char path[PATH_BUFFER_SIZE];
	DiskHandle disk = FullPath(oself, path, sizeof(path));
	const char *last = LastElement(path);

	if (*last) {
	    StrCopy(e.OLFSE_name, last, sizeof(e.OLFSE_name));
	    e.OLFSE_fileAttrs = FA_SUBDIR;
	} else {
	    word drive = DiskGetDrive(disk);
	    word status = DriveGetStatus(drive);

	    if (!status)
		return;
	    e.OLFSE_fileAttrs = FA_VOLUME;
	    e.OLFSE_fileFlags = (GeosFileHeaderFlags) (status << 8);
	    StuffDriveAndVolumeName(e.OLFSE_name, sizeof(e.OLFSE_name),
		drive, SDAVNF_PASS_DISK_HANDLE | SDAVNF_TRAILING_SLASH, 0,
		disk);
	}
    } else {
	OLFileSelectorEntry *p;

	if (parent)
	    n--;
	pself = FS(oself);
	if (n >= pself->OLFSI_numFiles || !pself->OLFSI_fileBuffer)
	    return;
	p = LockEntry(oself, n);
	e = *p;
	MemUnlock(FS(oself)->OLFSI_fileBuffer);
    }

    bh = MemAllocLMem(LMEM_TYPE_GENERAL, 0);
    gs = GrCreateGString(bh, GST_CHUNK, &chunk);
    bm = EntryIcon(&e, parent, !item);
    GrFillBitmapAtCP(gs, bm, NULL);
    GrRelMoveTo(gs, MakeWWFixed(bm->B_width + GFS_ICON_SPACING), 0);
    GrDrawTextAtCP(gs, e.OLFSE_name, 0);
    (void) GrEndGString(gs);
    GrDestroyGString(gs, 0, GSKT_LEAVE_DATA);

    if ((GFS(oself)->GFSI_attrs & FSA_SHOW_FILES_DISABLED) &&
	!(e.OLFSE_fileAttrs & (FA_SUBDIR | FA_VOLUME)))
	flags = RIMF_NOT_ENABLED;
    @call dl::MSG_GEN_DYNAMIC_LIST_REPLACE_ITEM_MONIKER(item, flags, 0, 0, 0,
		VMDT_GSTRING, VMST_OPTR, ConstructOptr(bh, chunk));
    MemFree(bh);
}

/* ---------------------------------------------------------------------
 * Building
 * ------------------------------------------------------------------- */

@method OLFileSelectorClass, MSG_META_INITIALIZE
{
    ObjMarkDirty(oself);
    @callsuper();
    pself = FS(oself);
    pself->OLFSI_fileBuffer = 0;
    pself->OLFSI_indexBuffer = 0;
    pself->OLFSI_numFiles = 0;
    pself->OLFSI_state = 0;
}

/*
 * HandleScalableUIData: HINT_FILE_SELECTOR_SCALABLE_UI_DATA sets or
 * adds attributes by the application's features and level
 */
static void HandleScalableUIData(optr o)
{
    GenFileSelectorScalableUIEntry *e =
	ObjVarFindData(o, HINT_FILE_SELECTOR_SCALABLE_UI_DATA);
    optr app = GeodeGetAppObject(0);
    AppFeaturesInfo info = 0;
    word n, i, features, level;

    if (!e || !app)
	return;
    n = (word) ((((VarDataEntry *) e - 1)->VDE_entrySize -
		 sizeof(VarDataEntry)) / sizeof(*e));
    info = @call app::MSG_GEN_APPLICATION_GET_APP_FEATURES();
    features = GET_APP_FEATURES(info);
    level = (word) GET_UI_INTERFACE_LEVEL(info);
    e = ObjVarFindData(o, HINT_FILE_SELECTOR_SCALABLE_UI_DATA);
    for (i = 0; i < n; i++, e++) {
	Boolean on = (features & e->GFSSUIE_appFeature) != 0;
	Boolean set;

	switch (e->GFSSUIE_command) {
	case GFSSUIC_SET_FEATURES_IF_APP_FEATURE_ON:
	    set = TRUE;
	    break;
	case GFSSUIC_SET_FEATURES_IF_APP_FEATURE_OFF:
	    set = TRUE;
	    on = !on;
	    break;
	case GFSSUIC_ADD_FEATURES_IF_APP_FEATURE_ON:
	    set = FALSE;
	    break;
	case GFSSUIC_SET_FEATURES_IF_APP_LEVEL:
	    set = TRUE;
	    on = level >= e->GFSSUIE_appFeature;
	    break;
	case GFSSUIC_ADD_FEATURES_IF_APP_LEVEL:
	    set = FALSE;
	    on = level >= e->GFSSUIE_appFeature;
	    break;
	default:
	    continue;
	}
	if (!on)
	    continue;
	if (set)
	    GFS(o)->GFSI_attrs = e->GFSSUIE_fsFeatures;
	else
	    GFS(o)->GFSI_attrs |= e->GFSSUIE_fsFeatures;
    }
}

/* OLFSProcessHints: the size of the list and the hints that go to it */
typedef struct {
    optr	o;
    optr	list;
    byte	count;		/* files shown (0: the height not fixed) */
    byte	width;		/* in average characters (0: not fixed) */
} HintScan;

static void FSHint(MemHandle mh, ChunkHandle chnk, VarDataEntry *extra,
		   word dataType, void *data)
{
    HintScan *h = data;

    (void) mh;
    (void) chnk;
    switch (dataType) {
    case HINT_FILE_SELECTOR_NUMBER_OF_FILES_TO_SHOW:
	h->count = *(byte *) extra;
	return;
    case HINT_FILE_SELECTOR_FILE_LIST_WIDTH:
	h->width = *(byte *) extra;
	return;
    case HINT_FILE_SELECTOR_SINGLE_ACTION:
	FS(h->o)->OLFSI_state |= OLFSS_SINGLE_ACTION;
	return;
    case HINT_EXPAND_WIDTH_TO_FIT_PARENT:
	h->width = 0;
	break;
    case HINT_EXPAND_HEIGHT_TO_FIT_PARENT:
	h->count = 0;
	break;
    }
    /* (the default focus, the feature hints, the expand hints) */
    ObjVarCopyDataRange(h->o, h->list, dataType, dataType);
}

static VarDataCHandler fsHints[] = {
    { HINT_FILE_SELECTOR_NUMBER_OF_FILES_TO_SHOW, FSHint },
    { HINT_FILE_SELECTOR_FILE_LIST_WIDTH, FSHint },
    { HINT_DEFAULT_FOCUS, FSHint },
    { HINT_AN_ADVANCED_FEATURE, FSHint },
    { HINT_GENERAL_CONSUMER_MODE, FSHint },
    { HINT_EXPAND_WIDTH_TO_FIT_PARENT, FSHint },
    { HINT_EXPAND_HEIGHT_TO_FIT_PARENT, FSHint },
    { HINT_FILE_SELECTOR_SINGLE_ACTION, FSHint }
};

static void ProcessHints(optr o)
{
    HintScan h;
    CompSizeHintArgs *a;
    word w, ht;

    h.o = o;
    h.list = UIObj(o, @OLFileSelectorFileList);
    h.count = OLFS_DEFAULT_FILES_SHOWN;
    h.width = FILE_LONGNAME_LENGTH + 7;
    if (OpenCheckIfCGA())
	h.count = OLFS_CGA_DEFAULT_FILES_SHOWN;
    /* OpenCheckIfDisplayLarge */
    switch (moCS_displayType & DT_DISP_SIZE) {
    case DS_LARGE << DT_DISP_SIZE_OFFSET:
    case DS_HUGE << DT_DISP_SIZE_OFFSET:
	h.count = OLFS_LARGE_DISPLAY_DEFAULT_FILES_SHOWN;
	break;
    }
    OpenGetScreenDimensions(&w, &ht);
    if (w <= TINY_SCREEN_WIDTH_THRESHOLD)
	h.width = FILE_LONGNAME_LENGTH + 2;
    ObjVarScanData(o, sizeof(fsHints) / sizeof(fsHints[0]), fsHints, &h);
    /* the list: wide enough for a name, so many lines high */
    a = ObjVarAddData(h.list, HINT_FIXED_SIZE, sizeof(CompSizeHintArgs));
    a->CSHA_width = SST_AVG_CHAR_WIDTHS | h.width;
    a->CSHA_height = SST_LINES_OF_TEXT | h.count;
    a->CSHA_count = h.count;
}

/*
 * OLFileSelectorSpecBuild: the gadgets are a copy of FileSelectorUI,
 * owned by the selector's owner, their output the selector.  The copy
 * goes when the selector is unbuilt or detached: for the detach it is
 * on the application's active list.  The group is built below the
 * selector (an upward link only).
 */
@method OLFileSelectorClass, MSG_SPEC_BUILD
{
    optr app = GeodeGetAppObject(0), group;
    MemHandle bh;
    SpecBuildFlags f = flags;

    @callsuper();
    bh = ObjDuplicateResource(OptrToHandle(@OLFileSelectorGroup),
			      MemOwner(OptrToHandle(oself)), 0);
    FS(oself)->OLFSI_uiBlock = bh;
    if (app)
	(void) @call app::MSG_META_GCN_LIST_ADD(oself,
			MGCNLT_ACTIVE_LIST | GCNLTF_SAVE_TO_STATE,
			MANUFACTURER_ID_GEOWORKS);
    GetIDs(oself);
    (void) GCNListAdd(oself, MANUFACTURER_ID_GEOWORKS, GCNSLT_FILE_SYSTEM);
    ObjBlockSetOutput(bh, oself);
    HandleScalableUIData(oself);
    TurnOffGadgetry(oself);
    group = ConstructOptr(bh, OptrToChunk(@OLFileSelectorGroup));
    GenSetUpwardLink(OptrToHandle(group), OptrToChunk(group), oself);
    ProcessHints(oself);

    f &= ~SBF_UPDATE_MODE;
    if (!(GFS(oself)->GI_states & GS_ENABLED))
	f &= ~SBF_VIS_PARENT_FULLY_ENABLED;
    @call group::MSG_SPEC_BUILD_BRANCH(f);
}

/* DestroyBlockAndRemoveFromActiveList */
static void DestroyBlock(optr o)
{
    MemHandle bh = FS(o)->OLFSI_uiBlock;
    optr app = GeodeGetAppObject(0);

    FS(o)->OLFSI_uiBlock = 0;
    if (bh) {
	optr group = ConstructOptr(bh, OptrToChunk(@OLFileSelectorGroup));

	/* (only an upward link: nothing to mark dirty) */
	@call group::MSG_GEN_DESTROY(VUM_DELAYED_VIA_UI_QUEUE, 0);
	@call group::MSG_META_BLOCK_FREE();
    }
    (void) GCNListRemove(o, MANUFACTURER_ID_GEOWORKS, GCNSLT_FILE_SYSTEM);
    if (app)
	(void) @call app::MSG_META_GCN_LIST_REMOVE(o, MGCNLT_ACTIVE_LIST,
						   MANUFACTURER_ID_GEOWORKS);
}

@method OLFileSelectorClass, MSG_SPEC_UNBUILD
{
    (void) pself;
    @callsuper();
    DestroyBlock(oself);
}

@method OLFileSelectorClass, MSG_SPEC_UNBUILD_BRANCH
{
    optr group = UIObj(oself, @OLFileSelectorGroup);

    (void) pself;
    if (group)
	@call group::MSG_SPEC_UNBUILD_BRANCH(flags);
    @callsuper();
}

@method OLFileSelectorClass, MSG_META_DETACH
{
    (void) pself;
    DestroyBlock(oself);
    @callsuper();
}

/* OLFSNotifyCommon: the gadgets are visual children, but generic ones
 * by an upward link only: they are told here */
@method OLFileSelectorClass, MSG_SPEC_NOTIFY_ENABLED,
			     MSG_SPEC_NOTIFY_NOT_ENABLED
{
    struct { byte updateMode, flags; } a;

    (void) pself;
    if (!@callsuper())
	return FALSE;
    a.updateMode = updateMode;
    a.flags = flags & ~NEF_STATE_CHANGING;
    VisSendToChildren(oself, message == MSG_SPEC_NOTIFY_ENABLED ?
			     MSG_GEN_NOTIFY_ENABLED :
			     MSG_GEN_NOTIFY_NOT_ENABLED, &a, sizeof(a));
    return TRUE;
}

/*
 * OLFileSelectorVisOpen: on screen: a path that cannot be used is
 * dropped (the default takes its place), a directory not under the
 * virtual root becomes the root, the drives are listed and the
 * directory is read; if that fails, the top directory is.
 */
@method OLFileSelectorClass, MSG_VIS_OPEN
{
    GenFilePath *p;

    (void) pself;
    @callsuper();
    if (!CurPath(oself, &p)) {
	ObjVarDeleteData(oself, ATTR_GEN_PATH_DATA);
	ObjVarDeleteData(oself, TEMP_GEN_PATH_SAVED_DISK_HANDLE);
    }
    if (VirtualRoot(oself) && !UnderVirtualRoot(oself, NULL))
	CloseForNotify(oself);
    BuildChangeDrivePopup(oself);
    FS(oself)->OLFSI_state &= ~OLFSS_VIS_OPEN_ERROR;
    @call oself::MSG_GEN_FILE_SELECTOR_RESCAN();
    if (FS(oself)->OLFSI_state & OLFSS_VIS_OPEN_ERROR)
	(void) @call oself::MSG_OL_FILE_SELECTOR_PATH_SET("", SP_TOP);
}

@method OLFileSelectorClass, MSG_VIS_CLOSE
{
    (void) pself;
    ObjMarkDirty(oself);
    @callsuper();
    FreeBuffers(oself);
}

/* ---------------------------------------------------------------------
 * Notifications
 * ------------------------------------------------------------------- */

@method OLFileSelectorClass, MSG_NOTIFY_DRIVE_CHANGE
{
    (void) pself;
    @callsuper();
    BuildChangeDrivePopup(oself);
}

static Boolean DiskIsOurs(optr o, DiskHandle disk)
{
    word n, i;
    FilePathID *ids = DirIDs(o, &n);

    for (i = 0; i < n; i++)
	if (ids[i].FPID_disk == disk)
	    return TRUE;
    return FALSE;
}

/* OLFileSelectorRemovingDisk: the disk of the directory goes: to the
 * document directory */
@method OLFileSelectorClass, MSG_META_REMOVING_DISK
{
    (void) pself;
    if (DiskIsOurs(oself, disk))
	@call oself::MSG_OL_FILE_SELECTOR_DOCUMENT_BUTTON(0);
}

/* OLFileSelectorCheckIDIsOurs: the file is the current directory */
static Boolean IDIsOurs(optr o, const FileChangeNotificationData *d)
{
    word n, i;
    FilePathID *ids = DirIDs(o, &n);

    for (i = 0; i < n; i++)
	if (ids[i].FPID_disk == d->FCND_disk && ids[i].FPID_id == d->FCND_id)
	    return TRUE;
    return FALSE;
}

/* OLFileSelectorCheckIDIsKids: the file is in the list */
static Boolean IDIsKids(optr o, const FileChangeNotificationData *d)
{
    OLFileSelectorInstance *f = FS(o);
    MemHandle fb = f->OLFSI_fileBuffer;
    word n = f->OLFSI_numFiles, i;
    OLFileSelectorEntry *e;
    Boolean found = FALSE;

    if (!fb)
	return FALSE;
    e = MemLock(fb);
    for (i = 0; i < n && !found; i++)
	found = e[i].OLFSE_disk == d->FCND_disk &&
		e[i].OLFSE_id == d->FCND_id;
    MemUnlock(fb);
    return found;
}

/* (gcnlist.goh stops at FCNT_BATCH) */
#define FCNT_ADD_SP_DIRECTORY		9
#define FCNT_DELETE_SP_DIRECTORY	10

/*
 * OLFileSelectorNotifyFileChangeLow: a file created in the directory,
 * one of the list renamed, deleted or with new attributes: scanned
 * again; the directory itself renamed or deleted, its disk formatted:
 * left (CloseForNotify); a directory added to or taken from a standard
 * path the directory is in: scanned again
 */
static void NotifyFileChange(optr o, word type,
			     const FileChangeNotificationData *d)
{
    switch (type) {
    case FCNT_CREATE:
	if (IDIsOurs(o, d))
	    (void) MarkDirtyAndRescanIfRealized(o);
	break;
    case FCNT_RENAME:
    case FCNT_DELETE:
	if (IDIsOurs(o, d))
	    CloseForNotify(o);
	else if (IDIsKids(o, d))
	    (void) MarkDirtyAndRescanIfRealized(o);
	break;
    case FCNT_ATTRIBUTES:
	if (IDIsKids(o, d))
	    (void) MarkDirtyAndRescanIfRealized(o);
	break;
    case FCNT_DISK_FORMAT:
	if (DiskIsOurs(o, d->FCND_disk))
	    CloseForNotify(o);
	break;
    case FCNT_ADD_SP_DIRECTORY:
    case FCNT_DELETE_SP_DIRECTORY: {
	/* (the standard path is the notification's disk) */
	GenFilePath *p;
	DiskHandle ours = CurPath(o, &p);

	if ((ours & DISK_IS_STD_PATH_MASK) &&
	    FileComparePaths("", d->FCND_disk, "", ours) <= PCT_SUBDIR)
	    (void) MarkDirtyAndRescanIfRealized(o);
	break;
    }
    default:
	break;
    }
}

@method OLFileSelectorClass, MSG_NOTIFY_FILE_CHANGE
{
    (void) pself;
    if (data) {
	byte *base = MemLock(data);

	if (notifyType == FCNT_BATCH) {
	    /* the items one by one, the selector suspended; an item
	     * has a name only if its type has (create, rename) */
	    FileChangeBatchNotificationData *b = (void *) base;
	    Boolean was = @call oself::MSG_GEN_FILE_SELECTOR_SUSPEND();
	    word at = word_offsetof(FileChangeBatchNotificationData,
				    FCBND_notifications);

	    while (at < b->FCBND_end) {
		FileChangeBatchNotificationItem *it = (void *) (base + at);
		word type = (word) it->FCBNI_type;

		NotifyFileChange(oself, type,
		    (const FileChangeNotificationData *) &it->FCBNI_disk);
		at += word_offsetof(FileChangeBatchNotificationItem,
				    FCBNI_name);
		if (type <= FCNT_RENAME)
		    at += sizeof(FileLongName);
	    }
	    if (!was)
		(void) @call oself::MSG_GEN_FILE_SELECTOR_END_SUSPEND();
	} else
	    NotifyFileChange(oself, (word) notifyType, (void *) base);
	MemUnlock(data);
    }
    @callsuper();
}

/* ---------------------------------------------------------------------
 * The keyboard
 * ------------------------------------------------------------------- */

/*
 * OLFileSelectorActivateObjectWithMnemonic: the selector's own
 * mnemonic gives the list the focus; 'v' opens the drive popup (whose
 * moniker, the drive's name, has lost its mnemonic)
 */
@method OLFileSelectorClass, MSG_SPEC_ACTIVATE_OBJECT_WITH_MNEMONIC
{
    optr obj;

    if (pself->VI_attrs & VA_FULLY_ENABLED) {
	if (VisCheckMnemonic(oself, character, flags, state)) {
	    obj = UIObj(oself, @OLFileSelectorFileList);
	    if (obj)
		@call obj::MSG_META_GRAB_FOCUS_EXCL();
	    return TRUE;
	}
	if ((GFS(oself)->GFSI_attrs & FSA_HAS_CHANGE_DRIVE_LIST) &&
	    ((character & 0xff) == 'v' || (character & 0xff) == 'V') &&
	    (character >> 8) == CS_BSW) {
	    obj = UIObj(oself, @OLFileSelectorChangeDrivePopup);
	    if (obj)
		@call obj::MSG_GEN_ACTIVATE();
	    return TRUE;
	}
    }
    return @callsuper();
}

/* OLFSCheckIfInteractableObject: the gadgets are the selector's */
@method OLFileSelectorClass, MSG_META_CHECK_IF_INTERACTABLE_OBJECT
{
    if (OptrToHandle(obj) == pself->OLFSI_uiBlock)
	return TRUE;
    return @callsuper();
}

/* OLFSDynamicListKbdChar: the space bar is a double press on the
 * selected entry */
static Boolean ListSpace(optr o, word character, word flags)
{
    word sel;
    optr fs;

    if ((flags & (CF_RELEASE | CF_STATE_KEY | CF_TEMP_ACCENT)) ||
	character != ((CS_BSW << 8) | VC_BLANK))
	return FALSE;
    sel = @call o::MSG_GEN_ITEM_GROUP_GET_SELECTION();
    fs = ObjBlockGetOutput(OptrToHandle(o));
    if (sel == GIGS_NONE || !fs)
	return FALSE;
    @call fs::MSG_OL_FILE_SELECTOR_DOUBLE_PRESS(sel, 1, 0);
    return TRUE;
}

@method OLFSDynamicListClass, MSG_META_KBD_CHAR
{
    (void) pself;
    if (!ListSpace(oself, character, flags))
	@callsuper();
}

@method OLFSDynamicListClass, MSG_META_FUP_KBD_CHAR
{
    (void) pself;
    if (ListSpace(oself, character, flags))
	return TRUE;
    return @callsuper();
}

/* ---------------------------------------------------------------------
 * OLBuildFileSelector (cspecFileSelector.asm): always this class
 * ------------------------------------------------------------------- */

ClassStruct *OLBuildFileSelector(optr oself, word masterOffset)
{
    (void) oself;
    (void) masterOffset;
    return (ClassStruct *) &OLFileSelectorClass;
}
