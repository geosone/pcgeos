/*
 * cwinPopup.goc -- OLPopupWinClass (after cwinPopup.asm): the window of
 * a GenInteraction that pops up (a dialog, a menu).  It is built twice
 * (SA_USES_DUAL_BUILD): as a window (its vis parent the one for popups
 * or system modal windows) and as the button that brings it up; app or
 * system modal by its hints and attributes; brought up by
 * MSG_GEN_INTERACTION_INITIATE, taken down by IC_DISMISS (and the
 * application's focus found again).
 *
 * As the modal window it lets the mouse into its own windows and into
 * menus not pinned (which come from it).
 *
 * Port32 (Port32/ABI.md section 13y), not yet:
 *   - the application cache (a UserDoDialog of an application on the
 *     transparent detach list ends at once in the asm);
 *   - discarding the block of HINT_INTERACTION_DISCARD_WHEN_CLOSED (the
 *     kernel does not load a discarded resource again yet).
 */
@include "cGeode.goh"
#include <sem.h>

@classdecl OLPopupWinClass, neverSaved;

#define PWin(o)		((OLPopupWinInstance *) ObjDerefVis(o))
#define Inter(o)	((GenInteractionInstance *) ObjDerefGen(o))
#define T(t)		((t) << OLBF_TARGET_OFFSET)

/* the button's optr (0 if none) */
static optr PopupButton(optr o)
{
    ChunkHandle b = PWin(o)->OLPWI_button;

    return b ? ConstructOptr(OptrToHandle(o), b) : 0;
}

/*
 * PopupBuildButton: the button that brings the popup up: made the
 * first time (an OLButton; a default one with HINT_DEFAULT_DEFAULT_
 * ACTION is the window's master default), enabled as the popup is,
 * added to its vis parent beside the generic siblings (a system icon
 * or the express menu's to the generic parent, first); a menu's is an
 * OLMenuButton.  The button uses the popup's moniker: a moniker list
 * is reduced to the moniker fitting the display first (an icon if
 * there is one).  Port32: the file menu's place not yet.
 */
static void PopupBuildButton(optr oself, SpecBuildFlags flags)
{
    OLPopupWinInstance *p = PWin(oself);
    OLBuildFlags bf = p->OLCI_buildFlags;
    Boolean isDefault;
    optr b, vp;
    VisInstance *v;
    OLButtonInstance *bi;
    SpecBuildFlags vf = flags;
    GenReturnParams r;

    (void) @call oself::MSG_GEN_FIND_MONIKER(FALSE, VMSF_REPLACE_LIST |
				VMSF_GSTRING | (VMS_ICON << VMSF_STYLE_OFFSET),
				0);
    p = PWin(oself);
    if (!p->OLPWI_button) {
	word ta = p->OLWI_type | ((word) p->OLWI_fixedAttr << 8);
	Boolean menu = (p->OLWI_fixedAttr & OWFA_IS_MENU) != 0;

	isDefault = !menu &&
		    ObjVarFindData(oself, HINT_DEFAULT_DEFAULT_ACTION) != NULL;
	b = ObjInstantiate(OptrToHandle(oself), menu ?
			   (ClassStruct *) &OLMenuButtonClass :
			   (ClassStruct *) &OLButtonClass);
	ObjSetFlags(b, OCF_IGNORE_DIRTY, 0);
	@call b::MSG_OL_BUTTON_SETUP(OptrToChunk(oself), ta, bf);
	if (isDefault)
	    ((OLButtonInstance *) ObjDerefVis(b))->OLBI_fixedAttrs |=
					OLBFA_MASTER_DEFAULT_TRIGGER;
	PWin(oself)->OLPWI_button = OptrToChunk(b);
    }
    b = PopupButton(oself);
    if (VisCheckIfSpecBuilt(b))
	return;
    v = (VisInstance *) ObjDerefVis(b);
    v->VI_attrs &= ~VA_FULLY_ENABLED;
    if (OLQueryIsMenu(oself) ||
	((flags & SBF_VIS_PARENT_FULLY_ENABLED) &&
	 (((GenInstance *) ObjDerefGen(oself))->GI_states & GS_ENABLED)))
	((VisInstance *) ObjDerefVis(b))->VI_attrs |= VA_FULLY_ENABLED;
    /* the popup's vis parent for its button part (as the asm: the
     * popup asked, not the button) */
    vp = VisGetVisParent(oself, &vf);
    if (!vp)
	return;
    bi = (OLButtonInstance *) ObjDerefVis(b);
    if ((bf & OLBF_TARGET) == T(OLBT_IS_EXPRESS_MENU) ||
	(bi->OLBI_specState & OLBSS_SYS_ICON)) {
	/* a system icon is a child of the window itself (the generic
	 * parent), not of its gadget area */
	optr gp = GenFindParent(oself);

	if (gp)
	    vp = gp;
	@call vp::MSG_VIS_ADD_CHILD(b, CCO_FIRST);
	return;
    }
    /* the "File" menu comes first, wherever it is among the generic
     * children */
    if (PWin(oself)->OLPWI_flags & OLPWF_FILE_MENU) {
	@call vp::MSG_VIS_ADD_CHILD(b, CCO_FIRST);
	VisMarkFullyInvalid(b);
	return;
    }
    VisAddChildRelativeToGen(oself, b, vp, flags);
    VisMarkFullyInvalid(b);
    if (((OLButtonInstance *) ObjDerefVis(b))->OLBI_fixedAttrs &
	OLBFA_MASTER_DEFAULT_TRIGGER)
	(void) @call b::MSG_VIS_P32_VUP_QUERY(&r, SVQT_SET_MASTER_DEFAULT,
					      OptrToChunk(b),
					      OptrToHandle(b));
    if (PWin(oself)->OLCI_buildFlags & OLBF_ABOVE_DISP_CTRL)
	(void) @call oself::MSG_VIS_VUP_UPDATE_WIN_GROUP(VUM_DELAYED_VIA_UI_QUEUE);
}

/* the application, called */
static void EnsureAppActiveFT(void)
{
    optr app = GeodeGetAppObject(0);

    if (app)
	@call app::MSG_META_ENSURE_ACTIVE_FT();
}

/*
 * OLQueryIsMenu: an OLWin that is a menu (not one that avoids the menu
 * bar, not a popup list)
 */
Boolean OLQueryIsMenu(optr o)
{
    OLWinInstance *w;

    if (!ObjIsObjectInClass(o, (ClassStruct *) &OLWinClass))
	return FALSE;
    w = (OLWinInstance *) ObjDerefVis(o);
    if (!(w->OLWI_fixedAttr & OWFA_IS_MENU) ||
	(w->OLCI_buildFlags & OLBF_AVOID_MENU_BAR))
	return FALSE;
    return (w->OLCI_buildFlags & OLBF_TARGET) != T(OLBT_IS_POPUP_LIST);
}

/*
 * OpenSendSpecBuildBranch (VisSendSpecBuildBranch): the branch built,
 * fully enabled if the object is
 */
void OpenSendSpecBuildBranch(optr o, SpecBuildFlags flags)
{
    flags &= ~SBF_VIS_PARENT_FULLY_ENABLED;
    if (GenCheckIfFullyEnabled(o, TRUE))
	flags |= SBF_VIS_PARENT_FULLY_ENABLED;
    @call o::MSG_SPEC_BUILD_BRANCH(flags);
}

/* ---------------------------------------------------------------------
 * Initialization and build
 * ------------------------------------------------------------------- */

/*
 * OLPopupWinInitialize: app modal (HINT_INTERACTION_MODAL, GIA_MODAL)
 * or system modal (GIA_SYS_MODAL); a popup, built twice
 */
@method OLPopupWinClass, MSG_META_INITIALIZE
{
    OLPopupWinFlags f = 0;
    GenInteractionAttrs a;
    OLPopupWinInstance *w;

    @callsuper();
    a = Inter(oself)->GII_attrs;
    if (ObjVarFindData(oself, HINT_INTERACTION_MODAL) || (a & GIA_MODAL))
	f |= OLPWF_APP_MODAL;
    if (a & GIA_SYS_MODAL)
	f |= OLPWF_SYS_MODAL;
    w = PWin(oself);
    w->OLPWI_flags = f;
    w->OLWI_moreFixedAttr |= OWMFA_IS_POPUP;
    w->VI_specAttrs |= SA_USES_DUAL_BUILD;
}

/* OLPopupWinUpdateSpecBuild: the window's children built within the
 * tree */
@method OLPopupWinClass, MSG_SPEC_BUILD_BRANCH
{
    if (flags & SBF_WIN_GROUP)
	flags |= SBF_VIS_PARENT_WITHIN_SCOPE_OF_TREE_BUILD;
    @callsuper oself::OLPopupWinClass::MSG_SPEC_BUILD_BRANCH(flags);
}

/*
 * OLPopupWinSpecBuild: the window as OLWin builds it; the other part is
 * the button, unless the popup is not user initiatable
 */
@method OLPopupWinClass, MSG_SPEC_BUILD
{
    if (flags & SBF_WIN_GROUP) {
	@callsuper();
	return;
    }
    if (Inter(oself)->GII_attrs & (GIA_NOT_USER_INITIATABLE |
				   GIA_INITIATED_VIA_USER_DO_DIALOG))
	return;
    PopupBuildButton(oself, flags);
}

/* OLPopupWinVisUnBuild: the button unbuilt; the window's pin trigger
 * destroyed, then the window unbuilt */
@method OLPopupWinClass, MSG_SPEC_UNBUILD
{
    optr b;
    ChunkHandle pin;

    if (!(flags & SBF_WIN_GROUP)) {
	b = PopupButton(oself);
	if (b) {
	    @call b::MSG_SPEC_UNBUILD_BRANCH(flags);
	    PWin(oself)->OLPWI_button = 0;
	}
	return;
    }
    pin = pself->OLPWI_pinTrigger;
    pself->OLPWI_pinTrigger = 0;
    if (pin) {
	optr p = ConstructOptr(OptrToHandle(oself), pin);

	@call p::MSG_GEN_DESTROY(VUM_NOW, 0);
    }
    @callsuper();
}

/*
 * OLPopupGetVisParent: the window's as OLWin finds it; the button's is
 * the generic parent's choice (SA_CUSTOM_VIS_PARENT_FOR_CHILD) or the
 * generic parent
 */
@method OLPopupWinClass, MSG_SPEC_GET_VIS_PARENT
{
    optr vp, gp, r = 0;
    SpecAttrs sa;

    if (flags & SBF_WIN_GROUP)
	return @callsuper();
    vp = pself->OLCI_visParent;
    gp = GenFindParent(oself);
    if (vp != gp)
	return vp;
    if (gp) {
	sa = ((VisInstance *) ObjDerefVis(gp))->VI_specAttrs;
	if (sa & SA_CUSTOM_VIS_PARENT_FOR_CHILD)
	    r = @call gp::MSG_SPEC_DETERMINE_VIS_PARENT_FOR_CHILD(oself);
    }
    if (!r)
	r = gp;
    PWin(oself)->OLCI_visParent = r;
    return r;
}

/* OLPopupGetSpecificVisObj: the window, or the button */
@method OLPopupWinClass, MSG_SPEC_GET_SPECIFIC_VIS_OBJECT
{
    if (flags & SBF_WIN_GROUP)
	return oself;
    return PopupButton(oself);
}

/* OLPWMetaCheckIfInteractableObject: everything below a system modal
 * popup is */
@method OLPopupWinClass, MSG_META_CHECK_IF_INTERACTABLE_OBJECT
{
    if (pself->OLPWI_flags & OLPWF_SYS_MODAL)
	return TRUE;
    return @callsuper();
}

@method OLPopupWinClass, MSG_OL_POPUP_FIND_BUTTON
{
    return PopupButton(oself);
}

/* OLPopupWinGenActivate: the button activated, or the popup initiated */
@method OLPopupWinClass, MSG_GEN_ACTIVATE
{
    optr b = PopupButton(oself);

    if (b)
	@call b::MSG_GEN_ACTIVATE();
    else
	@call oself::MSG_GEN_INTERACTION_INITIATE();
}

@method OLPopupWinClass, MSG_OL_POPUP_ACTIVATE
{
    (void) x;
    (void) y;
    @call oself::MSG_GEN_INTERACTION_INITIATE();
}

/*
 * OLPopupGenInitiate: usable (and enabled, if it goes when disabled):
 * realizable and on top; a discardable popup is in use
 */
@method OLPopupWinClass, MSG_GEN_INTERACTION_INITIATE
{
    if (!GenCheckIfFullyUsable(oself, FALSE))
	return;
    if ((pself->OLWI_attrs & OWA_DISMISS_WHEN_DISABLED) &&
	!GenCheckIfFullyEnabled(oself, FALSE))
	return;
    if (!OpenWinEnsureRealizableOnTop(oself))
	return;
    if (ObjVarFindData(oself, HINT_INTERACTION_DISCARD_WHEN_CLOSED))
	@call oself::MSG_GEN_INTERACTION_DISABLE_DISCARDING();
}

/*
 * OLPopupTestWinInteractibility: as the modal window, may the mouse go
 * into the window of the input object?  Into this one and its child
 * windows; into a menu (or popup list) not pinned, which can only have
 * come from here (the menus are dismissed when a modal window comes up,
 * and none from it can be pinned).
 */
@method OLPopupWinClass, MSG_META_TEST_WIN_INTERACTIBILITY
{
    Boolean r = FALSE;
    WindowHandle parent = 0;

    if (!inputOD)
	return FALSE;
    if (inputOD == oself)
	return TRUE;
    if (window)
	WinGetInfo(window, WIT_PARENT_WIN, &parent);
    if (parent && parent == pself->VCI_window)
	return TRUE;
    if (!ObjTestIfObjBlockRunByCurThread(OptrToHandle(inputOD)))
	return FALSE;
    ObjLockObjBlock(OptrToHandle(inputOD));
    if (ObjIsObjectInClass(inputOD, (ClassStruct *) &OLMenuWinClass) &&
	!(((OLWinInstance *) ObjDerefVis(inputOD))->OLWI_specState &
	  OLWSS_PINNED))
	r = TRUE;
    MemUnlock(OptrToHandle(inputOD));
    return r;
}

/* FindButtonMenu: the menu (window) the popup's button is in, if it is
 * in one */
static optr FindButtonMenu(optr o)
{
    optr b = PopupButton(o);

    if (!b || !(((OLButtonInstance *) ObjDerefVis(b))->OLBI_specState &
		OLBSS_IN_MENU))
	return 0;
    return OpenFindOLWin(b);
}

/* OLPopupWinSpecChangeUsable: a popup whose button is in a menu (a sub
 * menu) has the menu's separators updated */
@method OLPopupWinClass, MSG_SPEC_SET_USABLE, MSG_SPEC_SET_NOT_USABLE
{
    optr menu = 0;

    (void) pself;
    if (message == MSG_SPEC_SET_NOT_USABLE)
	menu = FindButtonMenu(oself);
    @callsuper();
    if (message == MSG_SPEC_SET_USABLE)
	menu = FindButtonMenu(oself);
    if (menu)
	@call menu::MSG_SPEC_UPDATE_MENU_SEPARATORS();
}

/* OLPopupClose: closable: dismissed */
@method OLPopupWinClass, MSG_OL_WIN_CLOSE
{
    if (pself->OLWI_attrs & OWA_CLOSABLE)
	(void) @call oself::MSG_GEN_GUP_INTERACTION_COMMAND(IC_DISMISS);
}

/*
 * OLPopupDismiss: not realizable any more (Port32: a discardable popup
 * is not discarded yet, only out of use)
 */
void OLPopupDismiss(optr o)
{
    GenInteractionDiscardInfo *d;

    @call o::MSG_SPEC_SET_ATTRS(0, SA_REALIZABLE, VUM_NOW);
    if (ObjVarFindData(o, HINT_INTERACTION_DISCARD_WHEN_CLOSED) &&
	(d = ObjVarFindData(o, TEMP_INTERACTION_DISCARD_INFO)) != NULL)
	d->GIDI_inUse = 0;
}

/*
 * OLPopupDestroyAndFreeBlock: a popup without a button goes the quick
 * way: off the screen (OLWin), off the window list; one with a button
 * is unbuilt the slow way (FALSE).  Port32: the popup itself is taken
 * off the list (the asm every object of its block).
 */
@method OLPopupWinClass, MSG_GEN_DESTROY_AND_FREE_BLOCK
{
    if (pself->OLPWI_button)
	return FALSE;
    (void) @callsuper();
    OLWinTakeOffWindowList(oself);
    return TRUE;
}

/* AddRemoveGCNListCommon: on or off the application's list of dialogs
 * a thread waits for */
static void UserDoDialogsList(optr o, Boolean add)
{
    optr app = GeodeGetAppObject(0);

    if (!app)
	return;
    if (add)
	(void) @call app::MSG_META_GCN_LIST_ADD(o, GAGCNLT_USER_DO_DIALOGS,
					 MANUFACTURER_ID_GEOWORKS);
    else
	(void) @call app::MSG_META_GCN_LIST_REMOVE(o, GAGCNLT_USER_DO_DIALOGS,
					    MANUFACTURER_ID_GEOWORKS);
}

/*
 * OLPopupInitiateBlockingThreadOnResponse (UserDoDialog): the dialog
 * comes up and keeps the caller's structure for its response.  A
 * dialog run by the UI thread is system modal, as is one of an
 * application that is still attaching and runs it itself (nothing of
 * it could be used meanwhile).  Not enabled, or the application
 * detaching: answered at once with IC_NULL.
 */
@method OLPopupWinClass,
	MSG_GEN_INTERACTION_INITIATE_BLOCKING_THREAD_ON_RESPONSE
{
    GeodeHandle ui = GeodeFind("ui      ", GEODE_NAME_SIZE, 0, 0);
    optr app = GeodeGetAppObject(0), field;
    ApplicationStates st = 0;
    word none = IC_NULL;

    if (ui && (ThreadHandle) MemGetInfo(OptrToHandle(oself),
					MGIT_EXEC_THREAD) == ProcInfo(ui)) {
	pself->OLPWI_flags &= ~OLPWF_APP_MODAL;
	pself->OLPWI_flags |= OLPWF_SYS_MODAL;
    }
    pself->OLPWI_udds = dialogInfo;
    if (app)
	st = @call app::MSG_GEN_APPLICATION_GET_STATE();
    if (!(pself->VI_attrs & VA_FULLY_ENABLED) || (st & AS_DETACHING)) {
	@call oself::MSG_GEN_INTERACTION_RELEASE_BLOCKED_THREAD_WITH_RESPONSE(
								    &none);
	return;
    }
    if ((st & AS_ATTACHING) && dialogInfo->UDDS_boxRunByCurrentThread) {
	pself = PWin(oself);
	pself->OLPWI_flags &= ~OLPWF_APP_MODAL;
	pself->OLPWI_flags |= OLPWF_SYS_MODAL;
    }
    UserDoDialogsList(oself, TRUE);
    @call oself::MSG_GEN_INTERACTION_INITIATE();
    field = @call oself::MSG_VIS_VUP_FIND_OBJECT_OF_CLASS(
					(ClassStruct *) &OLFieldClass);
    if (field)
	@send field::MSG_META_ENSURE_ACTIVE_FT();
}

/*
 * OLPopupReleaseBlockedThreadWithResponse: the UserDoDialog of this
 * window ends with a response (the window stays): the caller's
 * structure is complete; a caller that dispatches its queue gets a
 * message to wake up for, one that blocks its semaphore
 */
@method OLPopupWinClass,
	MSG_GEN_INTERACTION_RELEASE_BLOCKED_THREAD_WITH_RESPONSE
{
    UserDoDialogStruct *u;

    UserDoDialogsList(oself, FALSE);
    pself = PWin(oself);
    u = pself->OLPWI_udds;
    if (!u)
	return;
    pself->OLPWI_udds = NULL;
    /* (the response before the dialog is complete) */
    u->UDDS_response = *command;
    u->UDDS_complete = (Boolean) -1;
    if (u->UDDS_callingThread)
	@send ConstructOptr(u->UDDS_callingThread, 0)::MSG_META_DUMMY();
    else
	ThreadVSem(u->UDDS_semaphore);
}

/*
 * OLPopupInteractionCommand: IC_INTERACTION_COMPLETE dismisses a popup
 * that is not pinned; IC_DISMISS takes it down (not a pinned menu).
 * The command stops here.
 */
@method OLPopupWinClass, MSG_GEN_GUP_INTERACTION_COMMAND
{
    OLPopupWinInstance *w;

    if (command == IC_INTERACTION_COMPLETE) {
	if (pself->OLWI_specState & OLWSS_PINNED)
	    return TRUE;
	command = IC_DISMISS;
    }
    if (command != IC_DISMISS)
	return TRUE;
    w = PWin(oself);
    if ((w->OLWI_fixedAttr & OWFA_IS_MENU) &&
	(w->OLWI_specState & OLWSS_PINNED))
	return TRUE;
    OLPopupDismiss(oself);
    if (PWin(oself)->OLPWI_udds) {
	word dismiss = IC_DISMISS;

	@call oself::MSG_GEN_INTERACTION_RELEASE_BLOCKED_THREAD_WITH_RESPONSE(
								&dismiss);
    }
    return TRUE;
}

/* OLPopupWinVisClose: the modal state of the application updated, its
 * focus and target found again */
@method OLPopupWinClass, MSG_VIS_CLOSE
{
    @callsuper();
    OpenWinUpdateModalStatus(oself);
    EnsureAppActiveFT();
}

/* OLPopupUpdateVisual: the button's win group and ours */
@method OLPopupWinClass, MSG_SPEC_UPDATE_VISUAL
{
    optr b = PopupButton(oself);

    if (b)
	(void) @call b::MSG_VIS_VUP_UPDATE_WIN_GROUP(updateMode);
    (void) @call oself::MSG_VIS_VUP_UPDATE_WIN_GROUP(updateMode);
}

/* OLPopupWinNotifyEnabled: the button too (if we are fully enabled) */
@method OLPopupWinClass, MSG_SPEC_NOTIFY_ENABLED
{
    optr b;

    if (!(pself->VI_typeFlags & VTF_IS_GEN) ||
	GenCheckIfFullyEnabled(oself, TRUE)) {
	b = PopupButton(oself);
	if (b)
	    (void) @call b::MSG_SPEC_NOTIFY_ENABLED(updateMode, flags);
    }
    return @callsuper();
}

/*
 * OLPopupWinNotifyNotEnabled: not for a menu: the button too, and the
 * popup dismissed (without a system menu, or if it goes when disabled)
 */
@method OLPopupWinClass, MSG_SPEC_NOTIFY_NOT_ENABLED
{
    optr b;
    OLPopupWinInstance *w;

    if (!OLQueryIsMenu(oself)) {
	b = PopupButton(oself);
	if (b)
	    (void) @call b::MSG_SPEC_NOTIFY_NOT_ENABLED(updateMode, flags);
	w = PWin(oself);
	if (!w->OLWI_sysMenu || (w->OLWI_attrs & OWA_DISMISS_WHEN_DISABLED))
	    (void) @call oself::MSG_GEN_GUP_INTERACTION_COMMAND(IC_DISMISS);
    }
    return @callsuper();
}

/* OLPopupWinUpdateVisMoniker: the button's moniker too (later if it is
 * not realized) */
@method OLPopupWinClass, MSG_SPEC_UPDATE_VIS_MONIKER
{
    optr b;

    @callsuper();
    b = PopupButton(oself);
    if (!b)
	return;
    if (!(((VisInstance *) ObjDerefVis(b))->VI_attrs & VA_REALIZED))
	updateMode = VUM_DELAYED_VIA_UI_QUEUE;
    @call b::MSG_SPEC_UPDATE_VIS_MONIKER(updateMode, oldMonikerWidth,
					 oldMonikerHeight);
}

/* OLPopupWinSendToButton: a GenDisplay's word to the popup's button */
@method OLPopupWinClass, MSG_SHOW_MENU_BUTTON, MSG_HIDE_MENU_BUTTON
{
    optr b = PopupButton(oself);

    if (b)
	CObjMessageP(MF_CALL, b, message, NULL, 0, NULL, 0);
}
