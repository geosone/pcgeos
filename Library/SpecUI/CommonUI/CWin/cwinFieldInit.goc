/*
 * cwinFieldInit.goc -- after cwinFieldInit.asm: MSG_META_INITIALIZE,
 * MSG_GEN_LOAD_OPTIONS, MSG_SPEC_BUILD, MSG_VIS_OPEN_WIN.
 */
@include "cGeode.goh"
@include <Internal/flowC.goh>
@include <Internal/specC.goh>

/* ---------------------------------------------------------------------
 * Initialization (cwinFieldInit.asm)
 * ------------------------------------------------------------------- */

/* OLFieldInitialize: a window, win group and input node; not managed,
 * its children placed by themselves */
@extern method OLFieldClass, MSG_META_INITIALIZE
{
    @callsuper();
    pself = ObjDerefVis(oself);
    pself->VI_typeFlags |= VTF_IS_WINDOW | VTF_IS_WIN_GROUP |
			   VTF_IS_INPUT_NODE;
    pself->VI_specAttrs |= SA_REALIZABLE;
    pself->VI_attrs &= ~VA_MANAGED;
    pself->VCI_geoAttrs |= VCGA_CUSTOM_MANAGE_CHILDREN;
}

/* OLFieldLoadOptions: the specific UI's options, read as the field
 * loads its own (those of a field from its category) */
@extern method OLFieldClass, MSG_GEN_LOAD_OPTIONS
{
    char cat[INI_CATEGORY_BUFFER_SIZE];

    /* a copy: the object block may move */
    memcpy(cat, params->GOP_category, sizeof(cat));
    cat[sizeof(cat) - 1] = 0;
    SpecInitDefaultDisplayScheme();
    SpecInitGadgetPreferences();
    SpecInitWindowPreferences(cat);
    SpecInitExpressPreferences(cat);
    SpecInitHelpPreferences(cat);
    SpecInitDocumentControl(cat);
}

/*
 * OLFieldSpecBuild: a visual child of its vis parent (the screen, asked
 * of the generic parent unless set), its size; the resize borders for
 * the display
 */
@extern method OLFieldClass, MSG_SPEC_BUILD
{
    optr visParent;
    SizeAsDWord size;

    (void) flags;
    if (VisCheckIfSpecBuilt(oself))
	return;
    visParent = GenFieldInstanceOf(oself)->GFI_visParent;
    if (!visParent) {
	GenCallParent(oself, MSG_SPEC_GUP_QUERY_VIS_PARENT,
		      &(word){ SQT_VIS_PARENT_FOR_FIELD }, sizeof(word),
		      &visParent, sizeof(visParent));
	GenFieldInstanceOf(oself)->GFI_visParent = visParent;
    }
    if (!visParent)
	return;
    @call visParent::MSG_VIS_ADD_CHILD(oself, CCO_LAST);
    size = @call visParent::MSG_VIS_GET_SIZE();
    pself = ObjDerefVis(oself);
    pself->VI_bounds.R_right = pself->VI_bounds.R_left + DWORD_WIDTH(size);
    pself->VI_bounds.R_bottom = pself->VI_bounds.R_top + DWORD_HEIGHT(size);
    pself->VI_optFlags |= VOF_WINDOW_INVALID;

    resizeBarHeight = resizeBarWidth = CUAS_WIN_RESIZE_BORDER_SIZE;
    if (OpenCheckIfCGA())
	resizeBarHeight = CUAS_WIN_RESIZE_BORDER_TINY_SIZE;
    if (OpenCheckIfNarrow())
	resizeBarWidth = CUAS_WIN_RESIZE_BORDER_TINY_SIZE;
}

/*
 * OLFieldOpenWin: the field's window on the screen's, behind its other
 * children, in the background color, owned by the field's process
 */
@extern method OLFieldClass, MSG_VIS_OPEN_WIN
{
    Rectangle b;
    word color;
    WindowHandle win;

    if (pself->VCI_window)
	return;
    OpenGetLineBounds(oself, &b);
    color = FieldWindowColor(oself);
    win = WinOpen(parentWindow, oself, oself, color >> 8, color & 0xff, 0,
		  0, WPF_PLACE_BEHIND, 0, GeodeGetProcessHandle(), NULL,
		  b.R_left, b.R_top, b.R_right, b.R_bottom);
    OLFieldInstanceOf(oself)->VCI_window = win;
}
