/*
 * cwinClassCommonHigh.goc -- OLWinClass (after cwinClassCommonHigh.asm):
 * the window of the specific UI.  Its initialization, the window hints,
 * the specific build of the win group, the position and size of the
 * window (WinPosSizeFlags), the vis parent.  The rest of the class is in
 * cwinClassCommonMiddle.goc, cwinClassCommonLow.goc,
 * cwinClassOther.goc, cwinGeometry.goc, cwinExcl.goc, cwinPtr.goc (the
 * mouse), cwinClassMisc.goc (the keyboard) and (the drawing)
 * Motif/Win/winDraw.goc.
 *
 * The system menu and its icons: cwinClassCUAS.goc.
 *
 * Port32 (Port32/ABI.md section 13y), not yet: pinned menus, moniker lists
 * (GenFindMoniker), the
 * task bar (taskBarPrefs: the adjustments are 0, as with no task bar).
 */
@include "cGeode.goh"
@include "cwinConstant.goh"
@include <Internal/specC.goh>
@include <Objects/gPrimC.goh>
@include <Objects/gPenICC.goh>

@classdecl OLWinClass, neverSaved;
