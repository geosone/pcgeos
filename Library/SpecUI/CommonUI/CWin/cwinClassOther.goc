/*
 * cwinClassOther.goc -- OLWinClass (after cwinClassOther.asm): the
 * window closed (its grabs given up, its stagger slot freed, ready to
 * open again), lowered to the bottom, a menu's focus released.
 *
 * A menu kept off its button (AvoidMenuOverlap).
 *
 * Port32: the system menu's window list entry and the state saved on
 * detach (OpenWinSaveState) are not ported yet.
 */
@include "cGeode.goh"
@include <Objects/gPrimC.goh>
@include <Objects/gDispC.goh>
@include <Objects/gInterC.goh>

#define Win(o)		((OLWinInstance *) ObjDerefVis(o))

/* OpenWinCheckMenuState: a menu is not saved unless it is pinned and
 * from a resource */
static void CheckMenuState(optr o)
{
    OLWinInstance *w = Win(o);

    if (!(w->OLWI_fixedAttr & OWFA_IS_MENU))
	return;
    w->OLWI_winPosSizeFlags |= WPSF_NEVER_SAVE_STATE;
    if ((w->OLWI_specState & OLWSS_PINNED) &&
	(ObjGetFlags(o) & OCF_IN_RESOURCE))
	w->OLWI_winPosSizeFlags &= ~WPSF_NEVER_SAVE_STATE;
}

/* OpenWinFreeStaggeredSlot: the stagger slot back to the field */
void OpenWinFreeStaggeredSlot(optr o)
{
    OLWinInstance *w = Win(o);
    byte slot = (byte) ((w->OLWI_winPosSizeState & WPSS_STAGGERED_SLOT) >>
			WPSS_STAGGERED_SLOT_OFFSET);
    optr p;

    if (!(slot & SSPR_SLOT))
	return;
    w->OLWI_winPosSizeState &= ~((word) SSPR_SLOT << WPSS_STAGGERED_SLOT_OFFSET);
    p = VisFindParent(o);
    if (p) {
	GenReturnParams r;

	(void) @call p::MSG_VIS_P32_VUP_QUERY(&r, SVQT_FREE_STAGGER_SLOT,
					      slot, 0);
    }
}

/* OpenWinPrepForReOpen: a window that does not persist and was moved
 * or resized gets its position and size worked out again */
static void PrepForReOpen(optr o)
{
    OLWinInstance *w = Win(o);

    if (!(w->OLWI_winPosSizeFlags & WPSF_PERSIST) &&
	(w->OLWI_winPosSizeState & WPSS_HAS_MOVED_OR_RESIZED)) {
	w->OLWI_winPosSizeState |= WPSS_POSITION_INVALID | WPSS_SIZE_INVALID;
	UpdateWinPosSize(o);
    }
    @call o::MSG_OL_WIN_PREPARE_FIELD_SIZE_CHANGE();
}

/*
 * OpenWinVisClose: no focus or target, no move or resize, no gadget
 * exclusive, no pre-passive grab; closed; the stagger slot freed (not a
 * primary's or an icon's)
 */
@extern method OLWinClass, MSG_VIS_CLOSE
{
    OLWinType t;

    @call oself::MSG_META_RELEASE_FT_EXCL();
    @call oself::MSG_OL_WIN_END_GRAB(TRUE);
    @call oself::MSG_VIS_TAKE_GADGET_EXCL(0);
    @call oself::MSG_VIS_REMOVE_BUTTON_PRE_PASSIVE();
    @callsuper();
    CheckMenuState(oself);
    t = Win(oself)->OLWI_type;
    if (t != MOWT_PRIMARY_WINDOW && t != MOWT_WINDOW_ICON)
	OpenWinFreeStaggeredSlot(oself);
    PrepForReOpen(oself);
}

/*
 * OpenWinLowerToBottom: the focus and target given up, the window
 * behind the others, the application finds a new focus and target; the
 * application told
 */
@extern method OLWinClass, MSG_GEN_LOWER_TO_BOTTOM
{
    WindowHandle win = VisQueryWindow(oself);
    optr app = GeodeGetAppObject(0);

    if (win) {
	@call oself::MSG_META_RELEASE_FOCUS_EXCL();
	@call oself::MSG_META_RELEASE_TARGET_EXCL();
	WinChangePriority(win, WPF_PLACE_BEHIND, 0);
	OpenWinUpdateModalStatus(oself);
	if (app)
	    @call app::MSG_META_ENSURE_ACTIVE_FT();
    }
    if (app)
	@call app::MSG_GEN_APPLICATION_LOWER_WINDOW_TO_BOTTOM(oself);
}

/* OLWinReleaseMenuFocus: a menu with the focus gives it up */
@extern method OLWinClass, MSG_VIS_VUP_RELEASE_MENU_FOCUS
{
    optr f = pself->OLWI_focusExcl.FTVMC_OD;

    if (!(pself->OLWI_focusExcl.FTVMC_flags & MAEF_OD_IS_MENU_RELATED))
	return;
    if (f)
	@call f::MSG_META_RELEASE_FOCUS_EXCL();
    @call oself::MSG_VIS_REMOVE_BUTTON_PRE_PASSIVE();
}

/* ---------------------------------------------------------------------
 * A menu and its button
 * ------------------------------------------------------------------- */

/*
 * AvoidMenuOverlap: in one direction (across, or down if vertical): a
 * menu that begins before its button's end moves to the other side of
 * the button if it fits there, else (and a menu opening to the right,
 * checked across, if it overlaps by more than a little) below the
 * button (checked down: to its right).  TRUE if moved that way: it has
 * to be brought on screen and checked again.
 */
Boolean AvoidMenuOverlap(optr button, optr menu, Boolean vertical,
			 Boolean toRight)
{
    VisInstance *b = (VisInstance *) ObjDerefVis(button);
    VisInstance *m;
    WindowHandle win;
    sword bx = b->VI_bounds.R_left, by = b->VI_bounds.R_top;
    sword bw, bh, mx, my, mw, mh;
    sword start, other, bLen, bOther, mStart, mLen, overlap;

    win = VisQueryWindow(button);
    if (!win)
	return FALSE;
    {
	XYValueAsDWord s = WinTransform(win, bx, by);

	bx = (sword) DWORD_X(s);
	by = (sword) DWORD_Y(s);
    }
    b = (VisInstance *) ObjDerefVis(button);
    m = (VisInstance *) ObjDerefVis(menu);
    bw = (sword) (b->VI_bounds.R_right - b->VI_bounds.R_left);
    bh = (sword) (b->VI_bounds.R_bottom - b->VI_bounds.R_top);
    mx = m->VI_bounds.R_left;
    my = m->VI_bounds.R_top;
    mw = (sword) (m->VI_bounds.R_right - mx);
    mh = (sword) (m->VI_bounds.R_bottom - my);
    if (vertical) {
	start = by; other = bx; bLen = bh; bOther = bw;
	mStart = my; mLen = mh;
    } else {
	start = bx; other = by; bLen = bw; bOther = bh;
	mStart = mx; mLen = mw;
    }
    /* one pixel of overlap is allowed (Motif) */
    overlap = (sword) (mStart - start + 1 - bLen);
    if (overlap >= 0)
	return FALSE;
    overlap--;
    if (toRight && !vertical) {
	/* Motif sub menus get some latitude */
	if (overlap + 6 >= 0)
	    return FALSE;
    } else if (mLen <= start) {
	/* fits before the button */
	sword d = (sword) -(overlap + mLen + bLen);

	if (vertical)
	    VisSetPosition(menu, mx, (sword) (my + d));
	else
	    VisSetPosition(menu, (sword) (mx + d), my);
	return FALSE;
    }
    other = (sword) (other + bOther);
    if (vertical)
	VisSetPosition(menu, other, mStart);
    else
	VisSetPosition(menu, mStart, other);
    return TRUE;
}

/* OpenWinUpdateModalStatus: a modal popup tells the application, a
 * system modal one the system first (cwinClassOther.asm) */
void OpenWinUpdateModalStatus(optr o)
{
    OLPopupWinInstance *p = (OLPopupWinInstance *) ObjDerefVis(o);
    word flags;
    optr app;

    if (!(p->OLWI_moreFixedAttr & OWMFA_IS_POPUP))
	return;
    flags = p->OLPWI_flags;
    if (!(flags & (OLPWF_SYS_MODAL | OLPWF_APP_MODAL)))
	return;
    if (flags & OLPWF_SYS_MODAL)
	(void) UserCallSystem(MSG_GEN_SYSTEM_NOTIFY_SYS_MODAL_WIN_CHANGE,
			      NULL, 0, NULL, 0);
    app = GeodeGetAppObject(0);
    if (app)
	@call app::MSG_GEN_APPLICATION_NOTIFY_MODAL_WIN_CHANGE();
}
