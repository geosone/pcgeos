/*
 * cwinMenu.goc -- OLMenuWinClass (after cwinMenu.asm): the window of a
 * menu.  Brought up by its button (MSG_OL_POPUP_ACTIVATE at the
 * button's corner) or initiated; its items vertical, no spacing; the
 * build info of its children (they are in a sub menu); stay up mode
 * (after a click on its button the menu stays up until a press, its
 * pre-passive grab watching for it); a release with no stay up mode
 * completes it (the menu goes down, its button is told); a menu of a
 * group type gets the standard moniker (File, Edit, ...).
 *
 * Port32 (Port32/ABI.md section 13y), not yet: the pushpin (pinnable
 * menus: the PinMoniker picture), the Exit trigger of the file menu,
 * cascading sub menus (Motif has none: _CASCADING_MENUS), the scrollers
 * of a menu taller than the screen (MenuWinScrollerClass), menu
 * separators, the system and express menus, the menu centers
 * (OLMenuCalcCenters), the navigation character kept for item groups
 * (lastKbdCharCX).
 *
 * The keyboard: up and down move through the items (the first gets the
 * focus when the menu stays up), left and right to the neighbouring
 * menu of the bar (a sub menu: left back to its menu, right on), Escape
 * goes up to the button; a menu in the primary has the focus window
 * exclusive of the primary while up (with the remote gadget exclusive:
 * another gadget taking it completes the menu).
 */
@include "cGeode.goh"

@classdecl OLMenuWinClass, neverSaved;

#define MWin(o)		((OLMenuWinInstance *) ObjDerefVis(o))
#define R(r)		((r) << OLBF_REPLY_OFFSET)

/* the menu's position and size: kept visible, placed as required,
 * sized as desired */
#define MENU_POS_SIZE_FLAGS	(WPSF_PERSIST | (WCT_KEEP_VISIBLE << 6) | \
				 (WPT_AS_REQUIRED << 3) | WST_AS_DESIRED)

/* the button's optr (0 if none) */
static optr MenuButton(optr o)
{
    ChunkHandle b = MWin(o)->OLPWI_button;

    return b ? ConstructOptr(OptrToHandle(o), b) : 0;
}

/* OLMenuWinCallButtonOrGenParent: a visual query with this menu as the
 * data, to the button (none: the generic parent) */
static void QueryButtonOrGenParent(optr o, word q)
{
    optr b = MenuButton(o);
    GenReturnParams r;

    if (!b)
	b = GenFindParent(o);
    if (b)
	(void) @call b::MSG_VIS_P32_VUP_QUERY(&r, q, OptrToChunk(o),
					      OptrToHandle(o));
}

static Boolean IsPinnedOrWas(optr o)
{
    return (MWin(o)->OLWI_specState & OLWSS_PINNED) ||
	   (MWin(o)->OLMWI_specState & OMWSS_WAS_PINNED);
}

static void HintNotPinnable(optr o)
{
    MWin(o)->OLWI_attrs &= ~OWA_PINNABLE;
}

static void MenuHint(MemHandle mh, ChunkHandle ch, VarDataEntry *extra,
		     word dataType, void *handlerData)
{
    optr o = ConstructOptr(mh, ch);
    OLMenuWinInstance *m = MWin(o);

    (void) extra;
    (void) handlerData;
    switch (dataType) {
    case HINT_INFREQUENTLY_USED:
	HintNotPinnable(o);
	break;
    case HINT_INTERACTION_INFREQUENT_USAGE:
	m->OLMWI_specState |= OMWSS_INFREQUENT_USAGE;
	break;
    case HINT_CUSTOM_SYS_MENU:
	m->OLMWI_specState |= OMWSS_CUSTOM_SYS_MENU;
	break;
    case HINT_SYS_MENU:
    case HINT_IS_EXPRESS_MENU:
	m->OLWI_fixedAttr |= OWFA_IS_MENU;
	m->OLWI_type = MOWT_SYSTEM_MENU;
	break;
    }
}

static VarDataCHandler menuHints[] = {
    { HINT_INFREQUENTLY_USED, MenuHint },
    { HINT_SYS_MENU, MenuHint },
    { HINT_IS_EXPRESS_MENU, MenuHint },
    { HINT_CUSTOM_SYS_MENU, MenuHint },
    { HINT_INTERACTION_INFREQUENT_USAGE, MenuHint },
};

/*
 * OLMenuWinInitialize: a menu (a sub menu below a menu), with a thick
 * border, the items inside it, focusable, closable; its position and
 * size hints, its hints.  Port32: not pinnable (no pushpin yet).
 */
@method OLMenuWinClass, MSG_META_INITIALIZE
{
    OLMenuWinInstance *m;

    @callsuper();
    m = MWin(oself);
    m->OLWI_fixedAttr |= OWFA_IS_MENU;
    m->OLWI_attrs |= OWA_THICK_LINE_BORDER | OWA_KIDS_INSIDE_BORDER |
		     OWA_FOCUSABLE | OWA_CLOSABLE;
    m->OLWI_attrs &= ~OWA_PINNABLE;
    m->OLWI_type = ((m->OLCI_buildFlags & OLBF_REPLY) == R(OLBR_SUB_MENU)) ?
		   MOWT_SUBMENU : MOWT_MENU;
    @call oself::MSG_SPEC_SCAN_GEOMETRY_HINTS();
    ObjVarScanData(oself, sizeof(menuHints) / sizeof(menuHints[0]),
		   menuHints, NULL);
}

@method OLMenuWinClass, MSG_SPEC_SCAN_GEOMETRY_HINTS
{
    @callsuper();
    MWin(oself)->OLWI_winPosSizeFlags = MENU_POS_SIZE_FLAGS;
    OpenWinProcessHints(oself);
}

/*
 * OLMenuWinUpdateSpecBuild: built with its vis parent fully enabled
 * (the menu is enabled as its button), the items vertical
 */
@method OLMenuWinClass, MSG_SPEC_BUILD_BRANCH
{
    flags |= SBF_VIS_PARENT_FULLY_ENABLED;
    @callsuper();
    MWin(oself)->VCI_geoAttrs |= VCGA_ORIENT_CHILDREN_VERTICALLY;
}

@extern visMoniker GroupTypeFileMoniker;
@extern visMoniker GroupTypeEditMoniker;
@extern visMoniker GroupTypeViewMoniker;
@extern visMoniker GroupTypeOptionsMoniker;
@extern visMoniker GroupTypeWindowMoniker;
@extern visMoniker GroupTypeHelpMoniker;
@extern visMoniker GroupTypePrintMoniker;

/*
 * OLMenuWinSpecBuild: a menu of a group type: the file menu noted (the
 * primary told), the type's standard moniker if it has none
 */
@method OLMenuWinClass, MSG_SPEC_BUILD
{
    GenInteractionGroupType *gt =
	ObjVarFindData(oself, ATTR_GEN_INTERACTION_GROUP_TYPE);
    optr m = 0, gp;

    if (gt) {
	byte t = *gt;

	if (t == GIGT_FILE_MENU) {
	    MWin(oself)->OLMWI_specState |= OMWSS_FILE_MENU;
	    MWin(oself)->OLPWI_flags |= OLPWF_FILE_MENU;
	    gp = GenFindParent(oself);
	    if (gp && ObjIsObjectInClass(gp, &GenPrimaryClass))
		@call gp::MSG_OL_BASE_WIN_NOTIFY_OF_FILE_MENU(oself);
	}
	if (!((GenInstance *) ObjDerefGen(oself))->GI_visMoniker) {
	    switch (t) {
	    case GIGT_FILE_MENU:	m = @GroupTypeFileMoniker; break;
	    case GIGT_EDIT_MENU:	m = @GroupTypeEditMoniker; break;
	    case GIGT_VIEW_MENU:	m = @GroupTypeViewMoniker; break;
	    case GIGT_OPTIONS_MENU:	m = @GroupTypeOptionsMoniker; break;
	    case GIGT_WINDOW_MENU:	m = @GroupTypeWindowMoniker; break;
	    case GIGT_HELP_MENU:	m = @GroupTypeHelpMoniker; break;
	    case GIGT_PRINT_GROUP:	m = @GroupTypePrintMoniker; break;
	    }
	    if (m)
		(void) @call oself::MSG_GEN_REPLACE_VIS_MONIKER_OPTR(m,
								 VUM_MANUAL);
	}
    }
    @callsuper();
}

/* OLMenuWinGupQuery: the children of a menu are in a sub menu here */
@method OLMenuWinClass, MSG_SPEC_P32_GUP_QUERY
{
    if ((word) queryType != SGQT_BUILD_INFO)
	return @callsuper();
    retValue->GRP_bp |= R(OLBR_SUB_MENU);
    retValue->GRP_cx = OptrToHandle(oself);
    retValue->GRP_dx = OptrToChunk(oself);
    return TRUE;
}

/*
 * OLMenuWinActivate: brought up by its button at x, y (screen): placed
 * there as required and kept visible, not in stay up mode, initiated
 */
@method OLMenuWinClass, MSG_OL_POPUP_ACTIVATE
{
    OLMenuWinInstance *m = MWin(oself);

    m->OLWI_winPosSizeFlags &= WPSF_SHRINK_DESIRED_SIZE_TO_FIT_IN_PARENT;
    m->OLWI_winPosSizeFlags |= MENU_POS_SIZE_FLAGS;
    m->OLMWI_specState &= ~OMWSS_IN_STAY_UP_MODE;
    VisSetPosition(oself, x, y);
    VisMarkInvalid(oself, VOF_WINDOW_INVALID, VUM_MANUAL);
    @callsuper oself::OLMenuWinClass::MSG_GEN_INTERACTION_INITIATE();
    @call oself::MSG_OL_WIN_STARTUP_GRAB();
}

/* OLMenuWinInitiate: initiated (not by its button): up in stay up mode */
@method OLMenuWinClass, MSG_GEN_INTERACTION_INITIATE
{
    pself->OLMWI_specState &= ~OMWSS_IN_STAY_UP_MODE;
    @callsuper();
    @call oself::MSG_OL_WIN_STARTUP_GRAB();
    @call oself::MSG_MO_MW_ENTER_STAY_UP_MODE(TRUE);
}

/*
 * OLMenuWinInteractionCommand: dismissed (or complete, not pinned): down,
 * the button told; IC_EXIT quits the application
 */
@method OLMenuWinClass, MSG_GEN_GUP_INTERACTION_COMMAND
{
    optr b;

    if (command == IC_INTERACTION_COMPLETE &&
	!(pself->OLWI_specState & OLWSS_PINNED))
	command = IC_DISMISS;
    switch (command) {
    case IC_DISMISS:
	if (pself->OLWI_specState & OLWSS_PINNED)
	    return TRUE;
	/* Port32: a menu closed in stay up mode (by the keyboard) leaves
	 * it, so its window no longer thinks a menu is up (the asm left
	 * OLWMS_HAS_MENU_IN_STAY_UP_MODE set until the next press: no
	 * mnemonics there meanwhile) */
	if (pself->OLMWI_specState & OMWSS_IN_STAY_UP_MODE) {
	    pself->OLMWI_specState &= ~OMWSS_IN_STAY_UP_MODE;
	    @call oself::MSG_VIS_REMOVE_BUTTON_PRE_PASSIVE();
	    QueryButtonOrGenParent(oself, SVQT_NO_MENU_IN_STAY_UP_MODE);
	}
	(void) @callsuper oself::OLMenuWinClass::
		MSG_GEN_GUP_INTERACTION_COMMAND(IC_DISMISS);
	b = MenuButton(oself);
	if (b)
	    @call b::MSG_OL_MENU_BUTTON_NOTIFY_MENU_DISMISSED();
	return TRUE;
    case IC_EXIT:
	{
	    optr app = GeodeGetAppObject(0);

	    if (app)
		@call app::MSG_META_QUIT();
	}
	return TRUE;
    default:
	return @callsuper();
    }
}

/*
 * OLMenuWinEnterStayUpMode: up until a press: its button (or generic
 * parent) told, the pre-passive grab watching for the press
 */
@method OLMenuWinClass, MSG_MO_MW_ENTER_STAY_UP_MODE
{
    pself->OLMWI_specState |= OMWSS_IN_STAY_UP_MODE;
    QueryButtonOrGenParent(oself, SVQT_HAS_MENU_IN_STAY_UP_MODE);
    if (grab)
	QueryButtonOrGenParent(oself,
			SVQT_NOTIFY_MENU_BUTTON_AND_REMOTE_GRAB_GADGET_EXCL);
    @call oself::MSG_VIS_ADD_BUTTON_PRE_PASSIVE();
    @call oself::MSG_GEN_NAVIGATE_TO_NEXT_FIELD();
}

/*
 * OLMenuWinLeaveStayUpMode: the pre-passive grab gone; the button told
 * of the press (TRUE if it is on the button)
 */
@method OLMenuWinClass, MSG_MO_MW_LEAVE_STAY_UP_MODE
{
    optr b;

    if (!(pself->OLMWI_specState & OMWSS_IN_STAY_UP_MODE))
	return FALSE;
    pself->OLMWI_specState &= ~OMWSS_IN_STAY_UP_MODE;
    @call oself::MSG_VIS_REMOVE_BUTTON_PRE_PASSIVE();
    QueryButtonOrGenParent(oself, SVQT_NO_MENU_IN_STAY_UP_MODE);
    b = MenuButton(oself);
    if (!b)
	return FALSE;
    return @call b::MSG_MO_MB_LEAVE_STAY_UP_MODE(x, y, inputState);
}

/*
 * OLMenuWinPrePassiveButton: in stay up mode a press leaves it: in the
 * menu (or on its button) it is processed there, elsewhere the menu
 * goes and the press is replayed; outside the menu without a press,
 * processed
 */
@method OLMenuWinClass, MSG_META_PRE_PASSIVE_BUTTON
{
    WindowHandle w;
    XYValueAsDWord p;
    Boolean onButton;

    if (!(pself->OLMWI_specState & OMWSS_IN_STAY_UP_MODE)) {
	@callsuper();
	return;
    }
    if (!((inputState >> 8) & UIFA_IN) &&
	VisTestPointInBounds(oself, xPosition, yPosition)) {
	retVal->flags = MRF_PROCESSED;
	return;
    }
    if (!(inputState & BI_PRESS)) {
	@callsuper();
	return;
    }
    w = VisQueryWindow(oself);
    p = w ? WinTransform(w, xPosition, yPosition) :
	    MAKE_XY_DWORD(xPosition, yPosition);
    onButton = @call oself::MSG_MO_MW_LEAVE_STAY_UP_MODE(
			(sword) DWORD_X(p), (sword) DWORD_Y(p), inputState);
    if (((inputState >> 8) & UIFA_IN) || onButton) {
	retVal->flags = MRF_PROCESSED;
	return;
    }
    (void) @call oself::MSG_GEN_GUP_INTERACTION_COMMAND(
						IC_INTERACTION_COMPLETE);
    retVal->flags = MRF_REPLAY;
}

/*
 * OLMenuWinPostPassiveButton: all buttons up, not in stay up mode: the
 * menu is complete (a release on an item has activated it)
 */
@method OLMenuWinClass, MSG_META_POST_PASSIVE_BUTTON
{
    if (!(inputState & BI_PRESS) &&
	!(inputState & (BI_B3_DOWN | BI_B2_DOWN | BI_B1_DOWN | BI_B0_DOWN)) &&
	!(pself->OLMWI_specState & OMWSS_IN_STAY_UP_MODE))
	(void) @call oself::MSG_GEN_GUP_INTERACTION_COMMAND(
						IC_INTERACTION_COMPLETE);
    @callsuper();
}

/*
 * OLMenuWinEnsureNoMenusInStayUpMode: a menu in stay up mode (not
 * pinned) is dismissed (or counted); its children too
 */
@method OLMenuWinClass, MSG_META_ENSURE_NO_MENUS_IN_STAY_UP_MODE
{
    if ((pself->OLWI_specState & OLWSS_PINNED) ||
	!(pself->OLMWI_specState & OMWSS_IN_STAY_UP_MODE))
	return 0;
    if (params)
	params->ENMISUMP_menuCount++;
    else
	(void) @call oself::MSG_GEN_GUP_INTERACTION_COMMAND(IC_DISMISS);
    return 0;
}

/*
 * OLMenuWinLostGadgetExcl: complete, unless its button has the mouse
 * (the press on the button)
 */
@method OLMenuWinClass, MSG_VIS_LOST_GADGET_EXCL
{
    optr b = MenuButton(oself);

    if (b && (((OLButtonInstance *) ObjDerefVis(b))->OLBI_specState &
	      OLBSS_HAS_MOUSE_GRAB))
	return;
    (void) @call oself::MSG_GEN_GUP_INTERACTION_COMMAND(
						IC_INTERACTION_COMPLETE);
}

/* the window's margins, no spacing between the items */
static VisCompSpacingMarginsInfo MenuWinPassMarginInfo(optr o)
{
    Rectangle m;

    @call o::MSG_VIS_COMP_GET_MARGINS(&m);
    return OpenPassMarginInfo(o, &m, MENU_SPACING, MENU_SPACING);
}

@method OLMenuWinClass, MSG_VIS_COMP_GET_CHILD_SPACING
{
    return MAKE_SPACING_DWORD(MENU_SPACING, MENU_SPACING);
}

@method OLMenuWinClass, MSG_VIS_RECALC_SIZE
{
    return OpenRecalcCtrlSize(oself, width, height,
			      MenuWinPassMarginInfo(oself));
}

@method OLMenuWinClass, MSG_VIS_POSITION_BRANCH
{
    VisCompPosition(oself, (sword) xOrigin, (sword) yOrigin,
		    MenuWinPassMarginInfo(oself));
}

/*
 * OLMenuWinFindKbdAccelerator: the menu's accelerator activates its
 * button (through the queue)
 */
@method OLMenuWinClass, MSG_GEN_FIND_KBD_ACCELERATOR
{
    optr b;

    if (!GenCheckKbdAccelerator(oself, charValue, charFlagsAndShiftState,
				toggleStateAndScanCode))
	return FALSE;
    b = MenuButton(oself);
    if (b)
	@send, forceQueue b::MSG_OL_BUTTON_KBD_ACTIVATE();
    return TRUE;
}

/* OLMenuWinVisClose: the remote gadget exclusive given back */
@method OLMenuWinClass, MSG_VIS_CLOSE
{
    QueryButtonOrGenParent(oself, SVQT_REMOTE_RELEASE_GADGET_EXCL);
    @callsuper();
}

/*
 * OLMenuWinVupQuery: the stay up mode and the remote gadget exclusive
 * of a menu not pinned go to its button (or generic parent)
 */
@method OLMenuWinClass, MSG_VIS_P32_VUP_QUERY
{
    optr b;

    switch (queryType) {
    case SVQT_HAS_MENU_IN_STAY_UP_MODE:
    case SVQT_NO_MENU_IN_STAY_UP_MODE:
    case SVQT_REMOTE_GRAB_GADGET_EXCL:
    case SVQT_REMOTE_RELEASE_GADGET_EXCL:
	if (IsPinnedOrWas(oself))
	    break;
	b = MenuButton(oself);
	if (!b)
	    b = GenFindParent(oself);
	return b ? @call b::MSG_VIS_P32_VUP_QUERY(retValue, queryType, data1,
						  data2) : FALSE;
    }
    return @callsuper();
}

/*
 * OLMenuWinBringToTop: on top, the focus (not the target) of the
 * window it is in; the application told
 */
@method OLMenuWinClass, MSG_GEN_BRING_TO_TOP
{
    WindowHandle w = VisQueryWindow(oself);
    optr app;

    if (w) {
	WinChangePriority(w, 0, 0);
	if (!(MWin(oself)->OLWI_specState & OLWSS_PINNED) &&
	    OpenCheckIfMenusTakeFocus())
	    @call oself::MSG_META_GRAB_FOCUS_EXCL();
    }
    app = GeodeGetAppObject(0);
    if (app)
	@call app::MSG_GEN_APPLICATION_BRING_WINDOW_TO_TOP(oself);
}

/*
 * OLMenuWinAlterFTVMCExcl: a menu not pinned asks for (and gives up) the
 * focus of its window through its button (or generic parent): the
 * focus goes from the menu to the window and back
 */
@method OLMenuWinClass, MSG_META_MUP_ALTER_FTVMC_EXCL
{
    struct { optr o; MetaAlterFTVMCExclFlags f; } p;
    optr b;

    if (!(flags & MAEF_NOT_HERE) && (flags & MAEF_FOCUS)) {
	Boolean up;

	if (flags & MAEF_GRAB)
	    up = (flags & MAEF_OD_IS_WINDOW) &&
		 (flags & MAEF_OD_IS_MENU_RELATED) && !IsPinnedOrWas(oself);
	else
	    up = !IsPinnedOrWas(oself) &&
		 objectWantingControl != pself->OLWI_focusExcl.FTVMC_OD;
	if (up) {
	    b = MenuButton(oself);
	    if (!b)
		b = GenFindParent(oself);
	    if (b) {
		p.o = objectWantingControl;
		p.f = flags;
		CObjMessageP(MF_CALL, b, MSG_META_MUP_ALTER_FTVMC_EXCL, &p,
			     sizeof(p), NULL, 0);
	    }
	    return;
	}
    }
    @callsuper();
}

/*
 * OLMenuWinFupKbdChar: a menu with a button: left and right to the
 * neighbouring menu (its button gets the focus, the menu with the
 * focus then is activated), a sub menu's left back to its menu, right
 * on to the next of the bar, Escape to the button; up and down through
 * the items; a menu without a button completes on Escape
 */
static const KeyboardShortcut menuKeys[3] = {
    (KS_CHAR_SET_CONTROL << 8) | VC_LEFT,
    (KS_CHAR_SET_CONTROL << 8) | VC_RIGHT,
    (KS_CHAR_SET_CONTROL << 8) | VC_ESCAPE
};
static const KeyboardShortcut internalKeys[3] = {
    (KS_CHAR_SET_CONTROL << 8) | VC_UP,
    (KS_CHAR_SET_CONTROL << 8) | VC_DOWN,
    (KS_CHAR_SET_CONTROL << 8) | VC_ESCAPE
};

/* OLMenuWinKbdCloseSubMenuToParentMenu: the button the focus of the
 * parent menu, the sub menu dismissed */
static void CloseSubMenuToParentMenu(optr o)
{
    optr b = MenuButton(o);
    optr pm;

    if (!b || (MWin(o)->OLWI_specState & OLWSS_PINNED))
	return;
    ((OLMenuButtonInstance *) ObjDerefVis(b))->OLMBI_specState &=
	~OLMBSS_POPUP_OPEN;
    OLButtonRestoreBorderedAndDepressedAndDrawNow(b);
    pm = VisFindParentOfVisType(b, VTF_IS_WIN_GROUP);
    if (pm)
	@call pm::MSG_META_GRAB_FOCUS_EXCL();
    (void) @call o::MSG_GEN_GUP_INTERACTION_COMMAND(IC_DISMISS);
    @call b::MSG_META_GRAB_FOCUS_EXCL();
}

@method OLMenuWinClass, MSG_META_FUP_KBD_CHAR
{
    OLMenuWinInstance *m = pself;
    word off, i;
    optr b, f;

    if (!(flags & (CF_FIRST_PRESS | CF_REPEAT_PRESS)) ||
	(flags & (CF_STATE_KEY | CF_TEMP_ACCENT)))
	return @callsuper();
    if (!(m->OLWI_specState & OLWSS_PINNED) && m->OLPWI_button) {
	Boolean sub = (m->OLCI_buildFlags & OLBF_REPLY) ==
		      (OLBR_SUB_MENU << OLBF_REPLY_OFFSET);

	off = FlowCheckKbdShortcut((KeyboardShortcut *) menuKeys, 3,
				   character, flags, state);
	if (off != (word) -1) {
	    i = off / sizeof(KeyboardShortcut);
	    b = MenuButton(oself);
	    if (i == 2 || ObjVarFindData(oself, HINT_IS_EXPRESS_MENU)) {
		(void) @call b::MSG_META_FUP_KBD_CHAR(
				i == 2 ? character
				       : ((CS_CONTROL << 8) | VC_ESCAPE),
				flags, state);
		return TRUE;
	    }
	    if (sub && i == 0) {
		CloseSubMenuToParentMenu(oself);
		return TRUE;
	    }
	    if (sub) {
		@call b::MSG_OL_MENU_BUTTON_SEND_RIGHT_ARROW_TO_PARENT_MENU();
		return TRUE;
	    }
	    /* OLMenuWinFocusAndCallButton */
	    @call oself::MSG_META_MUP_ALTER_FTVMC_EXCL(b,
			MAEF_OD_IS_MENU_RELATED | MAEF_GRAB | MAEF_FOCUS |
			MAEF_NOT_HERE);
	    if (i == 0)
		@call b::MSG_SPEC_NAVIGATE_TO_PREVIOUS_FIELD();
	    else
		@call b::MSG_SPEC_NAVIGATE_TO_NEXT_FIELD();
	    f = VisFindParentOfVisType(b, VTF_IS_WIN_GROUP);
	    f = f ? ((OLWinInstance *) ObjDerefVis(f))->OLWI_focusExcl.FTVMC_OD
		  : 0;
	    if (f && ObjIsObjectInClass(f, &OLMenuButtonClass))
		@call f::MSG_OL_MENU_BUTTON_KBD_ACTIVATE();
	    return TRUE;
	}
    }
    off = FlowCheckKbdShortcut((KeyboardShortcut *) internalKeys, 3,
			       character, flags, state);
    if (off == (word) -1)
	return @callsuper();
    i = off / sizeof(KeyboardShortcut);
    if (i == 0)
	@call oself::MSG_GEN_NAVIGATE_TO_PREVIOUS_FIELD();
    else if (i == 1)
	@call oself::MSG_GEN_NAVIGATE_TO_NEXT_FIELD();
    else
	(void) @call oself::MSG_GEN_GUP_INTERACTION_COMMAND(
						IC_INTERACTION_COMPLETE);
    return TRUE;
}
