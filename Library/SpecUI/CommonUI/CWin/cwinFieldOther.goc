@extern method OLFieldClass, MSG_META_GAINED_FULL_SCREEN_EXCL, MSG_META_LOST_FULL_SCREEN_EXCL;
@extern method OLFieldClass, MSG_META_FORCE_GRAB_KBD, MSG_META_GRAB_KBD, MSG_META_RELEASE_KBD;
@extern method OLFieldClass, MSG_VIS_FORCE_GRAB_LARGE_MOUSE, MSG_VIS_FORCE_GRAB_MOUSE, MSG_VIS_GRAB_LARGE_MOUSE, MSG_VIS_GRAB_MOUSE, MSG_VIS_RELEASE_MOUSE;
@extern method OLFieldClass, MSG_GEN_BRING_TO_TOP;
@extern method OLFieldClass, MSG_GEN_LOWER_TO_BOTTOM;
