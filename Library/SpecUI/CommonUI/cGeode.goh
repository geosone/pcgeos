			 word bxParam, word cxParam, word dxParam);

/* ---------------------------------------------------------------------
 * The build (cGeode.def): Motif
 * ------------------------------------------------------------------- */

#define _MOTIF			1
#define _CUA_STYLE		1
#define _OL_STYLE		0
#define _ISUI			0
#define ANIMATED_BUSY_CURSOR	0
#define FIND_HIGHER_LAYER_PRIORITY 0

/* WinPriorityData (window.def) */
#define WPD_LAYER		0xf0
#define WPD_WIN			0x0f

