/* the specific UI's generic upward queries (cConstant.def
 * SpecGenQueryTypes; MSG_SPEC_P32_GUP_QUERY) */
#define SPEC_GEN_QUERY_START		2000
#define SGQT_BUILD_INFO			(SPEC_GEN_QUERY_START + 0)
	/* GRP_bp: the OLBuildFlags passed and answered; GRP_cx, GRP_dx:
	 * the vis parent */
#define SGQT_FIND_MENU_BAR		(SPEC_GEN_QUERY_START + 1)
#define SGQT_IS_CHILD_OF_PRIMARY	(SPEC_GEN_QUERY_START + 2)
#define SGQT_BRING_UP_KEYBOARD		(SPEC_GEN_QUERY_START + 3)
#define SGQT_WIN_GROUP			(SPEC_GEN_QUERY_START + 4)

/* the specific UI's visual upward queries (cConstant.def
 * SpecVisQueryTypes; MSG_VIS_P32_VUP_QUERY): the optr passed in data1
 * (the window's default queries) */
#define SVQT_REQUEST_STAGGER_SLOT		(SPEC_VIS_QUERY_START + 0)
#define SVQT_REQUEST_NEAREST_ICON_SLOT		(SPEC_VIS_QUERY_START + 1)
#define SVQT_FREE_STAGGER_SLOT			(SPEC_VIS_QUERY_START + 2)
#define SVQT_SET_MASTER_DEFAULT			(SPEC_VIS_QUERY_START + 3)
#define SVQT_RESET_MASTER_DEFAULT		(SPEC_VIS_QUERY_START + 4)
#define SVQT_TAKE_DEFAULT_EXCLUSIVE		(SPEC_VIS_QUERY_START + 5)
#define SVQT_REQUEST_DEFAULT_EXCLUSIVE		(SPEC_VIS_QUERY_START + 6)
#define SVQT_RELEASE_DEFAULT_EXCLUSIVE		(SPEC_VIS_QUERY_START + 7)
#define SVQT_FORCE_RELEASE_DEFAULT_EXCLUSIVE	(SPEC_VIS_QUERY_START + 8)
#define SVQT_ACTIVATE_DEFAULT			(SPEC_VIS_QUERY_START + 9)
#define SVQT_HAS_MENU_IN_STAY_UP_MODE		(SPEC_VIS_QUERY_START + 10)
#define SVQT_NO_MENU_IN_STAY_UP_MODE		(SPEC_VIS_QUERY_START + 11)
#define SVQT_REMOTE_GRAB_GADGET_EXCL		(SPEC_VIS_QUERY_START + 12)
#define SVQT_NOTIFY_MENU_BUTTON_AND_REMOTE_GRAB_GADGET_EXCL \
						(SPEC_VIS_QUERY_START + 13)
#define SVQT_REMOTE_RELEASE_GADGET_EXCL		(SPEC_VIS_QUERY_START + 14)
#define SVQT_QUERY_WIN_GROUP_FOR_FOCUS_EXCL	(SPEC_VIS_QUERY_START + 15)
#define SVQT_QUERY_FOR_REPLY_BAR		(SPEC_VIS_QUERY_START + 16)
#define SVQT_GRAB_FOCUS_EXCL_FOR_MENU		(SPEC_VIS_QUERY_START + 17)
#define SVQT_DELAYED_MODE			(SPEC_VIS_QUERY_START + 18)
#define SVQT_BACKGROUND_COLORS			(SPEC_VIS_QUERY_START + 19)

/* the stagger slot of a window (StaggerSlotPositionRequest): the slot
