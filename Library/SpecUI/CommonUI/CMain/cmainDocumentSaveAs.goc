/*
 * cmainDocumentSaveAs.goc -- OLDocumentClass: the document goes to
 * another file, back to what was saved, and to and from the formats of
 * other programs (after cmainDocumentMisc.asm: OLDocumentSaveAs,
 * OLDocumentRevert, OLDocumentImport and their like).
 */
@include "cmainDocument.goh"
@include <Objects/gProcC.goh>
@include <system.h>

/*
 * CheckIfDestinationIsCurrentFile: is the file of the parameters the
 * one the document has open?
 */
static Boolean DestinationIsCurrentFile(optr o,
					const DocumentCommonParams *params)
{
    FileHandle file = GD(o)->GDI_fileHandle;
    DiskHandle disk = params->DCP_diskHandle, curDisk = 0;
    FileID id, curID = 0;

    id = IACPGetDocumentID(params->DCP_path, params->DCP_name, &disk);
    if (id == FILE_NO_ID)
	return FALSE;
    if (FileGetHandleExtAttributes(file, FEA_FILE_ID, &curID,
				   sizeof(curID)) || curID != id)
	return FALSE;
    if (FileGetHandleExtAttributes(file, FEA_DISK, &curDisk,
				   sizeof(curDisk)) || curDisk != disk)
	return FALSE;
    return TRUE;
}

/*
 * OLDocumentSaveAs: the document is saved under the name of the
 * parameters and is that file from now on (an untitled document's own
 * file goes).  A document that was being closed (the Save As dialog
 * came up for an untitled one) is closed then.  The group hears how it
 * went (MSG_OLDG_USER_CLOSE_OK, ..._CANCELLED).  As a template the new
 * file is marked as one.
 */
@extern method OLDocumentClass, MSG_GEN_DOCUMENT_SAVE_AS,
				MSG_GEN_DOCUMENT_SAVE_AS_TEMPLATE
{
    optr parent = GenFindParent(oself);
    Boolean failed = TRUE, ok = FALSE;
    DocFileOrError file = 0;
    word e, r;

    (void) pself;
    OLDocSetOperation(oself, GDO_SAVE_AS);
    ObjVarDeleteData(oself, TEMP_OL_DOCUMENT_USER_RETRY_SAVE_AS);
    (void) OLDocWriteCachedData(oself, TRUE);
    e = OLDocPushAndSetPath(oself, params);
    if (!e && DestinationIsCurrentFile(oself, params)) {
	/* onto itself: another name, then */
	(void) OLDocStandardDialogParams(oself,
					 SDBT_FILE_OVERWRITING_ITSELF,
					 params);
	OLDocSendToDocumentControl(oself,
			MSG_GEN_DOCUMENT_CONTROL_INITIATE_SAVE_AS_DOC);
	ObjVarAddData(oself, TEMP_OL_DOCUMENT_USER_RETRY_SAVE_AS, 0);
    } else {
	for (;;) {
	    if (!e) {
		file = 0;
		if (!@call oself::MSG_GEN_DOCUMENT_PHYSICAL_SAVE_AS(&file,
								   params)) {
		    ok = TRUE;
		    break;
		}
		e = (word) file;
	    }
	    /* (cmainDocLowDisk: a full disk while closing has a dialog
	     * of its own) */
	    if (e == ERROR_DISK_UNAVAILABLE)
		break;
	    e = OLDocConvertErrorCode(e);
	    r = OLDocHandleSaveError(oself, e, params);
	    if (r == OLDSE_GIVE_UP)
		break;
	    if (r == OLDSE_OVERWRITE)
		params->DCP_flags |= DOF_SAVE_AS_OVERWRITE_EXISTING_FILE;
	    e = 0;
	}
	if (!ok)
	    OLDocSendCompleteUpdateToDC(oself, TRUE);
    }
    if (ok) {
	/* the file it had as an untitled document */
	if (GD(oself)->GDI_attrs & (GDA_UNTITLED | GDA_SAVE_FAILED))
	    @call oself::MSG_GEN_DOCUMENT_PHYSICAL_DELETE();
	OLDocStoreNewDocumentName(oself, (FileHandle) file, params);
	UserStoreDocFileName(params);
	@call oself::MSG_GEN_DOCUMENT_SAVE_AS_COMPLETED();
	OLDocSetAttrs(oself, 0, GDA_DIRTY | GDA_UNTITLED | GDA_READ_ONLY |
		      GDA_ATTACH_TO_DIRTY_FILE | GDA_SAVE_FAILED |
		      GDA_SHARED_SINGLE | GDA_SHARED_MULTIPLE);
	OLDocSendCompleteUpdateToDC(oself, TRUE);
	if (GD(oself)->GDI_attrs & GDA_CLOSING) {
	    OLDocSetAttrs(oself, 0, GDA_CLOSING);
	    (void) @call oself::MSG_GEN_DOCUMENT_CLOSE(0);
	}
	*fileOrError = GD(oself)->GDI_fileHandle;
	failed = FALSE;
    } else {
	*fileOrError = e;
    }
    OLDocClearOperation(oself);

    /* in the CUI an application that quits has no use for the answer */
    if (failed && UserGetDefaultUILevel() <= UIIL_INTRODUCTORY &&
	(@call GeodeGetAppObject(0)::MSG_GEN_APPLICATION_GET_STATE() &
	 AS_QUITTING)) {
	/* nothing */
    } else if (message != MSG_GEN_DOCUMENT_SAVE_AS_TEMPLATE) {
	if (failed)
	    @call parent::MSG_OLDG_USER_CLOSE_CANCELLED();
	else
	    @call parent::MSG_OLDG_USER_CLOSE_OK();
    } else if (!failed) {
	GeosFileHeaderFlags flags = GFHF_TEMPLATE;

	FileSetHandleExtAttributes(GD(oself)->GDI_fileHandle, FEA_FLAGS,
				   &flags, sizeof(flags));
	(void) OLDocStandardDialog(oself, SDBT_NOTIFY_SAVE_AS_TEMPLATE);
    }
    if (failed) {
	/* unless the user is asked for another name the close that led
	 * here is off */
	if (ObjVarFindData(oself, TEMP_OL_DOCUMENT_USER_RETRY_SAVE_AS))
	    ObjVarDeleteData(oself, TEMP_OL_DOCUMENT_USER_RETRY_SAVE_AS);
	else
	    OLDocSetAttrs(oself, 0, GDA_CLOSING);
	OLDocSetOperation(oself, GDO_NORMAL);
    }
    FilePopDir();
    return failed;
}

@extern method OLDocumentClass, MSG_GEN_DOCUMENT_SAVE_AS_CANCELLED
{
    (void) pself;
    GD(oself)->GDI_attrs &= ~GDA_CLOSING;
}

/* ---------------------------------------------------------------------
 * Back to what was saved
 * ------------------------------------------------------------------- */

/* OLDocumentRevert: after asking.  TRUE if it is not done */
@extern method OLDocumentClass, MSG_GEN_DOCUMENT_REVERT
{
    (void) pself;
    OLDocSetOperation(oself, GDO_REVERT);
    if ((GD(oself)->GDI_attrs & GDA_CLOSING) ||
	OLDocStandardDialog(oself, SDBT_FILE_REVERT_CONFIRM) != IC_YES) {
	OLDocClearOperation(oself);
	return TRUE;
    }
    @call oself::MSG_GEN_DOCUMENT_REVERT_NO_PROMPT();
    return FALSE;
}

/* the UI lets go of the document first; the rest once that is through */
@extern method OLDocumentClass, MSG_GEN_DOCUMENT_REVERT_NO_PROMPT
{
    (void) pself;
    @call oself::MSG_GEN_DOCUMENT_DETACH_UI_FROM_DOCUMENT();
    OLDocSendToSelfOnQueue(oself, MSG_OL_DOCUMENT_CONTINUE_REVERT);
}

static void Reattach(optr o)
{
    @call o::MSG_GEN_DOCUMENT_READ_CACHED_DATA_FROM_FILE();
    @call o::MSG_GEN_DOCUMENT_ATTACH_UI_TO_DOCUMENT();
    @call o::MSG_GEN_DOCUMENT_FILE_CHANGED_REINITIALIZE_CREATED_UI();
}

@extern method OLDocumentClass, MSG_OL_DOCUMENT_CONTINUE_REVERT
{
    Boolean failed;
    word e;

    (void) pself;
    OLDocMarkBusy(oself);
    failed = @call oself::MSG_GEN_DOCUMENT_PHYSICAL_REVERT(&e);
    if (failed)
	(void) OLDocStandardDialog(oself, SDBT_FILE_REVERT_ERROR);
    Reattach(oself);
    if (!failed)
	OLDocSetCleanAndUpdate(oself);
    OLDocClearOperation(oself);
    OLDocMarkNotBusy(oself);
}

/* OLDocumentRevertToAutoSave: back to what auto save last wrote */
@extern method OLDocumentClass, MSG_GEN_DOCUMENT_REVERT_TO_AUTO_SAVE
{
    (void) pself;
    OLDocSetOperation(oself, GDO_REVERT_TO_AUTO_SAVE);
    @call oself::MSG_GEN_DOCUMENT_DETACH_UI_FROM_DOCUMENT();
    OLDocSendToSelfOnQueue(oself,
			   MSG_OL_DOCUMENT_CONTINUE_REVERT_TO_AUTO_SAVE);
    return FALSE;
}

@extern method OLDocumentClass, MSG_OL_DOCUMENT_CONTINUE_REVERT_TO_AUTO_SAVE
{
    (void) pself;
    OLDocMarkBusy(oself);
    if (@call oself::MSG_GEN_DOCUMENT_PHYSICAL_REVERT_TO_AUTO_SAVE())
	(void) OLDocStandardDialog(oself, SDBT_FILE_REVERT_ERROR);
    Reattach(oself);
    OLDocClearOperation(oself);
    OLDocMarkNotBusy(oself);
}

/* ---------------------------------------------------------------------
 * Import and export: the output of the group does the work
 * ------------------------------------------------------------------- */

static void SendImpexToOutput(optr o, Message msg,
			      ImpexTranslationParams *params)
{
    optr output = @call GenFindParent(o)::MSG_GEN_DOCUMENT_GROUP_GET_OUTPUT();

    if (output)
	CObjMessageP(0, output, msg, params, sizeof(*params), NULL, 0);
}

/* what came in is a document that wants saving */
@extern method OLDocumentClass, MSG_GEN_DOCUMENT_IMPORT
{
    (void) pself;
    SendImpexToOutput(oself, MSG_META_DOC_OUTPUT_IMPORT_FILE, params);
    OLDocSendToSelfOnQueue(oself, MSG_GEN_DOCUMENT_SAVE);
    OLDocSendToSelfOnQueue(oself, MSG_GEN_DOCUMENT_MARK_DIRTY);
    return FALSE;
}

@extern method OLDocumentClass, MSG_GEN_DOCUMENT_EXPORT
{
    EventHandle ev;

    (void) pself;
    SendImpexToOutput(oself, MSG_META_DOC_OUTPUT_EXPORT_FILE, params);
    CObjMessageP(MF_RECORD, (optr) (uintptr_t) &GenDocumentControlClass,
		 MSG_GEN_DOCUMENT_CONTROL_FILE_EXPORTED, NULL, 0, &ev,
		 sizeof(ev));
    @call GenFindParent(oself)::MSG_GEN_GUP_CALL_OBJECT_OF_CLASS(ev);
}
