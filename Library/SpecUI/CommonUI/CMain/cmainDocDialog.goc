/*
 * cmainDocDialog.goc -- the standard dialogs of a document (after
 * cmainDocDialog.asm): each StandardDialogBoxType has its kind of
 * dialog, its text (a chunk of DocumentStringsUI, in which \1 stands
 * for the name of the file and \2 for what was being done) and its
 * response triggers.
 *
 * Port32: the asm's table (StdDialogTable, with the trigger tables)
 * is the switch of GetEntry, made from it by a script once: an optr
 * is no constant here.
 */
@include "cmainDocument.goh"

typedef struct {
    word				n;
    StandardDialogResponseTriggerEntry	e[3];
} StdDialogTriggers;

typedef struct {
    CustomDialogBoxFlags	flags;
    optr			arg2;	/* SDA_*: what was being done */
    optr			string;
    StdDialogTriggers		t;
} StdDialogEntry;

#define TRIGGER(i, moniker, response) \
    (d->t.e[i].SDRTE_moniker = (moniker), \
     d->t.e[i].SDRTE_responseValue = (response), d->t.n = (i) + 1)

static void GetEntry(StandardDialogBoxType type, StdDialogEntry *d)
{
    memset(d, 0, sizeof(*d));
    switch (type) {
    case SDBT_FILE_NEW_CANNOT_CREATE_TEMP_NAME:
	d->flags = (CDT_ERROR << CDBF_DIALOG_TYPE_OFFSET) |
		   (GIT_NOTIFICATION << CDBF_INTERACTION_TYPE_OFFSET);
	d->arg2 = @SDA_createNew;
	d->string = @SDS_fileCannotCreateTemp;
	break;
    case SDBT_FILE_NEW_INSUFFICIENT_DISK_SPACE:
	d->flags = (CDT_ERROR << CDBF_DIALOG_TYPE_OFFSET) |
		   (GIT_NOTIFICATION << CDBF_INTERACTION_TYPE_OFFSET);
	d->arg2 = @SDA_createNew;
	d->string = @SDS_fileInsufficientDiskSpace;
	break;
    case SDBT_FILE_NEW_TOO_MANY_OPEN_FILES:
	d->flags = (CDT_ERROR << CDBF_DIALOG_TYPE_OFFSET) |
		   (GIT_NOTIFICATION << CDBF_INTERACTION_TYPE_OFFSET);
	d->arg2 = @SDA_createNew;
	d->string = @SDS_fileTooManyOpenFiles;
	break;
    case SDBT_FILE_NEW_ERROR:
	d->flags = (CDT_ERROR << CDBF_DIALOG_TYPE_OFFSET) |
		   (GIT_NOTIFICATION << CDBF_INTERACTION_TYPE_OFFSET);
	d->arg2 = @SDA_createNew;
	d->string = @SDS_fileError;
	break;
    case SDBT_FILE_NEW_WRITE_PROTECTED:
	d->flags = (CDT_QUESTION << CDBF_DIALOG_TYPE_OFFSET) |
		   (GIT_MULTIPLE_RESPONSE << CDBF_INTERACTION_TYPE_OFFSET);
	d->arg2 = @SDA_createNew;
	d->string = @SDS_fileWriteProtected;
	TRIGGER(0, @SDRT_ok, IC_YES);
	TRIGGER(1, @SDRT_cancel, IC_NO);
	break;
    case SDBT_FILE_OPEN_SHARING_DENIED:
	d->flags = (CDT_ERROR << CDBF_DIALOG_TYPE_OFFSET) |
		   (GIT_NOTIFICATION << CDBF_INTERACTION_TYPE_OFFSET);
	d->arg2 = @SDA_opening;
	d->string = @SDS_fileSharingDenied;
	break;
    case SDBT_FILE_OPEN_FILE_NOT_FOUND:
	d->flags = (CDT_ERROR << CDBF_DIALOG_TYPE_OFFSET) |
		   (GIT_NOTIFICATION << CDBF_INTERACTION_TYPE_OFFSET);
	d->arg2 = @SDA_opening;
	d->string = @SDS_fileFileNotFound;
	break;
    case SDBT_FILE_OPEN_INVALID_VM_FILE:
	d->flags = (CDT_ERROR << CDBF_DIALOG_TYPE_OFFSET) |
		   (GIT_NOTIFICATION << CDBF_INTERACTION_TYPE_OFFSET);
	d->arg2 = @SDA_opening;
	d->string = @SDS_fileInvalidVMFile;
	break;
    case SDBT_FILE_OPEN_INSUFFICIENT_DISK_SPACE:
	d->flags = (CDT_ERROR << CDBF_DIALOG_TYPE_OFFSET) |
		   (GIT_NOTIFICATION << CDBF_INTERACTION_TYPE_OFFSET);
	d->arg2 = @SDA_opening;
	d->string = @SDS_fileInsufficientDiskSpace;
	break;
    case SDBT_FILE_OPEN_ERROR:
	d->flags = (CDT_ERROR << CDBF_DIALOG_TYPE_OFFSET) |
		   (GIT_NOTIFICATION << CDBF_INTERACTION_TYPE_OFFSET);
	d->arg2 = @SDA_opening;
	d->string = @SDS_fileError;
	break;
    case SDBT_FILE_OPEN_READ_ONLY_PUBLIC_IN_TRANSPARENT_MODE:
	d->flags = (CDT_QUESTION << CDBF_DIALOG_TYPE_OFFSET) |
		   (GIT_MULTIPLE_RESPONSE << CDBF_INTERACTION_TYPE_OFFSET);
	d->string = @SDS_fileOpenReadOnlyPublicInTransparentMode;
	TRIGGER(0, @SDRT_ok, IC_YES);
	TRIGGER(1, @SDRT_cancel, IC_NO);
	break;
    case SDBT_FILE_OPEN_VM_DIRTY:
	d->flags = (CDT_NOTIFICATION << CDBF_DIALOG_TYPE_OFFSET) |
		   (GIT_NOTIFICATION << CDBF_INTERACTION_TYPE_OFFSET);
	d->string = @SDS_fileOpenVMDirty;
	break;
    case SDBT_FILE_OPEN_APP_MORE_RECENT_THAN_DOC:
	d->flags = (CDT_ERROR << CDBF_DIALOG_TYPE_OFFSET) |
		   (GIT_NOTIFICATION << CDBF_INTERACTION_TYPE_OFFSET);
	d->string = @SDS_fileOpenAppMoreRecent;
	break;
    case SDBT_FILE_OPEN_DOC_MORE_RECENT_THAN_APP:
	d->flags = (CDT_ERROR << CDBF_DIALOG_TYPE_OFFSET) |
		   (GIT_NOTIFICATION << CDBF_INTERACTION_TYPE_OFFSET);
	d->string = @SDS_fileOpenDocMoreRecent;
	break;
    case SDBT_FILE_OPEN_FILE_TYPE_MISMATCH:
	d->flags = (CDT_ERROR << CDBF_DIALOG_TYPE_OFFSET) |
		   (GIT_NOTIFICATION << CDBF_INTERACTION_TYPE_OFFSET);
	d->string = @SDS_fileOpenFileTypeMismatch;
	break;
    case SDBT_FILE_SAVE_INSUFFICIENT_DISK_SPACE:
	d->flags = (CDT_ERROR << CDBF_DIALOG_TYPE_OFFSET) |
		   (GIT_NOTIFICATION << CDBF_INTERACTION_TYPE_OFFSET);
	d->arg2 = @SDA_saving;
	d->string = @SDS_fileInsufficientDiskSpace;
	break;
    case SDBT_FILE_SAVE_ERROR:
	d->flags = (CDT_ERROR << CDBF_DIALOG_TYPE_OFFSET) |
		   (GIT_NOTIFICATION << CDBF_INTERACTION_TYPE_OFFSET);
	d->string = @SDS_fileSaveError;
	break;
    case SDBT_FILE_SAVE_WRITE_PROTECTED:
	d->flags = (CDT_QUESTION << CDBF_DIALOG_TYPE_OFFSET) |
		   (GIT_MULTIPLE_RESPONSE << CDBF_INTERACTION_TYPE_OFFSET);
	d->arg2 = @SDA_saving;
	d->string = @SDS_fileWriteProtected;
	TRIGGER(0, @SDRT_ok, IC_YES);
	TRIGGER(1, @SDRT_cancel, IC_NO);
	break;
    case SDBT_FILE_SAVE_AS_FILE_EXISTS:
	d->flags = (CDT_QUESTION << CDBF_DIALOG_TYPE_OFFSET) |
		   (GIT_AFFIRMATION << CDBF_INTERACTION_TYPE_OFFSET);
	d->arg2 = @SDA_saving;
	d->string = @SDS_fileSaveFileExists;
	break;
    case SDBT_FILE_SAVE_AS_SHARING_DENIED:
	d->flags = (CDT_ERROR << CDBF_DIALOG_TYPE_OFFSET) |
		   (GIT_NOTIFICATION << CDBF_INTERACTION_TYPE_OFFSET);
	d->arg2 = @SDA_saving;
	d->string = @SDS_fileSharingDenied;
	break;
    case SDBT_FILE_SAVE_AS_FILE_FORMAT_MISMATCH:
	d->flags = (CDT_ERROR << CDBF_DIALOG_TYPE_OFFSET) |
		   (GIT_NOTIFICATION << CDBF_INTERACTION_TYPE_OFFSET);
