	break;
    case SDBT_FILE_REVERT_ERROR:
	d->flags = (CDT_ERROR << CDBF_DIALOG_TYPE_OFFSET) |
		   (GIT_NOTIFICATION << CDBF_INTERACTION_TYPE_OFFSET);
	d->arg2 = @SDA_reverting;
	d->string = @SDS_fileError;
	break;
    case SDBT_FILE_ATTACH_DISK_NOT_FOUND:
	d->flags = (CDT_QUESTION << CDBF_DIALOG_TYPE_OFFSET) |
		   (GIT_MULTIPLE_RESPONSE << CDBF_INTERACTION_TYPE_OFFSET);
	d->string = @SDS_attachDiskNotFound;
	TRIGGER(0, @SDRT_ok, IC_OK);
	TRIGGER(1, @SDRT_cancel, IC_DISMISS);
	break;
    case SDBT_CANNOT_CHANGE_TYPE:
	d->flags = (CDT_ERROR << CDBF_DIALOG_TYPE_OFFSET) |
		   (GIT_NOTIFICATION << CDBF_INTERACTION_TYPE_OFFSET);
	d->string = @SDS_cannotChangeType;
	break;
    case SDBT_CANNOT_CHANGE_PASSWORD:
	d->flags = (CDT_ERROR << CDBF_DIALOG_TYPE_OFFSET) |
		   (GIT_NOTIFICATION << CDBF_INTERACTION_TYPE_OFFSET);
	d->string = @SDS_cannotChangePassword;
	break;
    case SDBT_PROMPT_MOVE_TEMPLATE:
	d->flags = (CDT_QUESTION << CDBF_DIALOG_TYPE_OFFSET) |
		   (GIT_MULTIPLE_RESPONSE << CDBF_INTERACTION_TYPE_OFFSET);
	d->string = @SDS_promptMoveTempalte;
	TRIGGER(0, @SDRT_promptMoveTemplate_Yes, IC_OK);
	TRIGGER(1, @SDRT_promptMoveTemplate_No, IC_DISMISS);
	break;
    case SDBT_BAD_PASSWORD:
	d->flags = (CDT_ERROR << CDBF_DIALOG_TYPE_OFFSET) |
		   (GIT_NOTIFICATION << CDBF_INTERACTION_TYPE_OFFSET);
