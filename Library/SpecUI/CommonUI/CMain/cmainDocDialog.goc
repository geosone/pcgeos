    case SDBT_RENAME_FILE_EXISTS:
	d->flags = (CDT_ERROR << CDBF_DIALOG_TYPE_OFFSET) |
		   (GIT_NOTIFICATION << CDBF_INTERACTION_TYPE_OFFSET);
	d->string = @SDS_renameFileExists;
	break;
    case SDBT_RENAME_ERROR:
	d->flags = (CDT_ERROR << CDBF_DIALOG_TYPE_OFFSET) |
		   (GIT_NOTIFICATION << CDBF_INTERACTION_TYPE_OFFSET);
	d->string = @SDS_renameError;
	break;
    case SDBT_BACKUP_ERROR:
	d->flags = (CDT_ERROR << CDBF_DIALOG_TYPE_OFFSET) |
		   (GIT_NOTIFICATION << CDBF_INTERACTION_TYPE_OFFSET);
	d->string = @SDS_backupError;
	break;
    case SDBT_REVERT_QUICK_CONFIRM:
	d->flags = (CDT_WARNING << CDBF_DIALOG_TYPE_OFFSET) |
		   (GIT_AFFIRMATION << CDBF_INTERACTION_TYPE_OFFSET);
	d->string = @SDS_revertQuickConfirm;
	break;
    case SDBT_REVERT_QUICK_ERROR:
	d->flags = (CDT_ERROR << CDBF_DIALOG_TYPE_OFFSET) |
		   (GIT_NOTIFICATION << CDBF_INTERACTION_TYPE_OFFSET);
	d->string = @SDS_revertQuickError;
	break;
    case SDBT_QUERY_SET_EMPTY_NONE_EXISTS:
	d->flags = (CDT_QUESTION << CDBF_DIALOG_TYPE_OFFSET) |
		   (GIT_MULTIPLE_RESPONSE << CDBF_INTERACTION_TYPE_OFFSET);
	d->string = @SDS_querySetEmptyNoneExists;
	TRIGGER(0, @SDRT_querySetEmpty_Yes, IC_YES);
	TRIGGER(1, @SDRT_cancel, IC_DISMISS);
	break;
    case SDBT_QUERY_SET_EMPTY_ONE_EXISTS:
	d->flags = (CDT_QUESTION << CDBF_DIALOG_TYPE_OFFSET) |
		   (GIT_MULTIPLE_RESPONSE << CDBF_INTERACTION_TYPE_OFFSET);
	d->string = @SDS_querySetEmptyOneExists;
	TRIGGER(0, @SDRT_querySetEmpty_Yes, IC_YES);
	TRIGGER(1, @SDRT_querySetEmptyOneExists_No, IC_NO);
	TRIGGER(2, @SDRT_cancel, IC_DISMISS);
	break;
    case SDBT_QUERY_CLEAR_EMPTY:
	d->flags = (CDT_QUESTION << CDBF_DIALOG_TYPE_OFFSET) |
		   (GIT_MULTIPLE_RESPONSE << CDBF_INTERACTION_TYPE_OFFSET);
	d->string = @SDS_queryClearEmpty;
	TRIGGER(0, @SDRT_querySetEmptyOneExists_No, IC_NO);
	TRIGGER(1, @SDRT_cancel, IC_DISMISS);
	break;
    case SDBT_QUERY_SET_DEFAULT_NONE_EXISTS:
	d->flags = (CDT_QUESTION << CDBF_DIALOG_TYPE_OFFSET) |
		   (GIT_MULTIPLE_RESPONSE << CDBF_INTERACTION_TYPE_OFFSET);
	d->string = @SDS_querySetDefaultNoneExists;
	TRIGGER(0, @SDRT_querySetDefault_Yes, IC_YES);
	TRIGGER(1, @SDRT_cancel, IC_DISMISS);
	break;
    case SDBT_QUERY_SET_DEFAULT_ONE_EXISTS:
	d->flags = (CDT_QUESTION << CDBF_DIALOG_TYPE_OFFSET) |
		   (GIT_MULTIPLE_RESPONSE << CDBF_INTERACTION_TYPE_OFFSET);
	d->string = @SDS_querySetDefaultOneExists;
	TRIGGER(0, @SDRT_querySetDefault_Yes, IC_YES);
	TRIGGER(1, @SDRT_querySetDefaultOneExists_No, IC_NO);
	TRIGGER(2, @SDRT_cancel, IC_DISMISS);
	break;
    case SDBT_QUERY_CLEAR_DEFAULT:
	d->flags = (CDT_QUESTION << CDBF_DIALOG_TYPE_OFFSET) |
		   (GIT_MULTIPLE_RESPONSE << CDBF_INTERACTION_TYPE_OFFSET);
	d->string = @SDS_queryClearDefault;
	TRIGGER(0, @SDRT_querySetDefaultOneExists_No, IC_NO);
	TRIGGER(1, @SDRT_cancel, IC_DISMISS);
	break;
    case SDBT_SET_EMPTY_ERROR:
	d->flags = (CDT_ERROR << CDBF_DIALOG_TYPE_OFFSET) |
		   (GIT_NOTIFICATION << CDBF_INTERACTION_TYPE_OFFSET);
	d->string = @SDS_setEmptyError;
	break;
    case SDBT_TRANSPARENT_NEW_FILE_EXISTS:
	d->flags = (CDT_ERROR << CDBF_DIALOG_TYPE_OFFSET) |
		   (GIT_NOTIFICATION << CDBF_INTERACTION_TYPE_OFFSET);
	d->string = @SDS_transparentNewFileExists;
	break;
    case SDBT_CONFIRM_PASSWORD_CHANGE:
	d->flags = (CDT_WARNING << CDBF_DIALOG_TYPE_OFFSET) |
		   (GIT_AFFIRMATION << CDBF_INTERACTION_TYPE_OFFSET);
	d->string = @SDS_confirmPasswordChange;
	break;
    case SDBT_NOTIFY_SAVE_AS_TEMPLATE:
	d->flags = (CDT_NOTIFICATION << CDBF_DIALOG_TYPE_OFFSET) |
		   (GIT_NOTIFICATION << CDBF_INTERACTION_TYPE_OFFSET);
	d->string = @SDS_notifySaveAsTemplate;
	break;
    case SDBT_NOTIFY_SAVING_READ_ONLY:
	d->flags = (CDT_NOTIFICATION << CDBF_DIALOG_TYPE_OFFSET) |
		   (GIT_NOTIFICATION << CDBF_INTERACTION_TYPE_OFFSET);
	d->string = @SDS_notifySavingReadOnly;
	break;
    case SDBT_NOTIFY_SAVING_PUBLIC:
	d->flags = (CDT_NOTIFICATION << CDBF_DIALOG_TYPE_OFFSET) |
		   (GIT_NOTIFICATION << CDBF_INTERACTION_TYPE_OFFSET);
	d->string = @SDS_notifySavingPublic;
	break;
    case SDBT_DISK_RESTORE:
	d->flags = (CDT_ERROR << CDBF_DIALOG_TYPE_OFFSET) |
		   (GIT_MULTIPLE_RESPONSE << CDBF_INTERACTION_TYPE_OFFSET);
	d->string = @SDS_diskRestore;
	TRIGGER(0, @SDRT_diskRestore_Yes, IC_YES);
	TRIGGER(1, @SDRT_diskRestore_No, IC_NO);
	break;
    case SDBT_FILE_ILLEGAL_NAME:
	d->flags = (CDT_ERROR << CDBF_DIALOG_TYPE_OFFSET) |
		   (GIT_NOTIFICATION << CDBF_INTERACTION_TYPE_OFFSET);
	d->string = @SDS_fileSaveIllegalName;
	break;
    case SDBT_FILE_OVERWRITING_ITSELF:
	d->flags = (CDT_ERROR << CDBF_DIALOG_TYPE_OFFSET) |
		   (GIT_NOTIFICATION << CDBF_INTERACTION_TYPE_OFFSET);
	d->string = @SDS_fileOverwritingItself;
	break;
    case SDBT_CANT_MOVE_READ_ONLY_DOCUMENT:
	d->flags = (CDT_ERROR << CDBF_DIALOG_TYPE_OFFSET) |
		   (GIT_NOTIFICATION << CDBF_INTERACTION_TYPE_OFFSET);
	d->string = @SDS_cantMoveReadOnlyDocument;
	break;
    case SDBT_FILE_MOVE_WRITE_PROTECTED:
	d->flags = (CDT_QUESTION << CDBF_DIALOG_TYPE_OFFSET) |
		   (GIT_MULTIPLE_RESPONSE << CDBF_INTERACTION_TYPE_OFFSET);
	d->arg2 = @SDA_moving;
	d->string = @SDS_fileWriteProtected;
	TRIGGER(0, @SDRT_ok, IC_YES);
	TRIGGER(1, @SDRT_cancel, IC_NO);
	break;
    case SDBT_UNABLE_TO_OVERWRITE_EXISTING_FILE:
	d->flags = (CDT_ERROR << CDBF_DIALOG_TYPE_OFFSET) |
		   (GIT_NOTIFICATION << CDBF_INTERACTION_TYPE_OFFSET);
	d->string = @SDS_unableToOverwriteExistingFile;
	break;
    case SDBT_FILE_MOVE_INSUFFICIENT_DISK_SPACE:
	d->flags = (CDT_ERROR << CDBF_DIALOG_TYPE_OFFSET) |
		   (GIT_NOTIFICATION << CDBF_INTERACTION_TYPE_OFFSET);
	d->arg2 = @SDA_moving;
	d->string = @SDS_fileInsufficientDiskSpace;
	break;
    case SDBT_FILE_MOVE_ERROR:
	d->flags = (CDT_ERROR << CDBF_DIALOG_TYPE_OFFSET) |
		   (GIT_NOTIFICATION << CDBF_INTERACTION_TYPE_OFFSET);
	d->string = @SDS_fileMoveError;
	break;
    case SDBT_FILE_COPY_FILE_IS_PUBLIC_OR_READ_ONLY:
	d->flags = (CDT_NOTIFICATION << CDBF_DIALOG_TYPE_OFFSET) |
		   (GIT_NOTIFICATION << CDBF_INTERACTION_TYPE_OFFSET);
	d->string = @SDS_fileCopyPublicOrReadOnly;
	break;
    }
}

/*
 * CallUserStandardDialog: the dialog of a type, with the first string
 * argument (the name of the file, usually) and a second one for the
 * dialogs that have no standing one.  The InteractionCommand.
 */
word OLDocUserStandardDialog(StandardDialogBoxType type, Boolean sysModal,
			     const char *arg1, const char *arg2)
{
    StdDialogEntry d;
    MemHandle strings;
    word response;

    GetEntry(type, &d);
    if (sysModal)
	d.flags |= CDBF_SYSTEM_MODAL;
    /* a PDA has no disks to speak of */
    if (olPDA) {
	if (d.string == @SDS_fileFileNotFound)
	    d.string = @SDS_fileFileNotFoundPDA;
	else if (d.string == @SDS_fileSaveError)
	    d.string = @SDS_fileSaveErrorPDA;
    }
    strings = OptrToHandle(d.string);
    MemLock(strings);
    if (d.arg2)
	arg2 = LMemDeref(d.arg2);
    response = UserStandardDialog(NULL, d.t.n ? (char *) &d.t : NULL,
				  (char *) arg2, (char *) arg1,
				  LMemDeref(d.string), d.flags);
    MemUnlock(strings);
    return response;
}

/* SetSysModalIfDiskFullError: over everything while the disk is full */
static Boolean SysModal(optr o)
{
    return ObjVarFindData(o, TEMP_OL_DOCUMENT_NO_DISK_SPACE_MESSAGE) != 0;
}

word OLDocStandardDialogArg(optr o, StandardDialogBoxType type,
			    const DocumentCommonParams *params,
			    const char *arg2)
{
    FileLongName name;

    if (params)
	memcpy(name, params->DCP_name, sizeof(name));
    else
	memcpy(name, GD(o)->GDI_fileName, sizeof(name));
    return OLDocUserStandardDialog(type, SysModal(o), name, arg2);
}

/* CallStandardDialogDS_SI: about the document's file */
word OLDocStandardDialog(optr o, StandardDialogBoxType type)
{
    return OLDocStandardDialogArg(o, type, NULL, NULL);
}

/* CallStandardDialogSS_BP: about the file of the parameters */
word OLDocStandardDialogParams(optr o, StandardDialogBoxType type,
			       const DocumentCommonParams *params)
{
    return OLDocStandardDialogArg(o, type, params, NULL);
}
