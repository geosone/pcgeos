/*
 * cmainDocumentCommon.goc -- OLDocumentClass, the specific UI's part of
 * a GenDocument (after cmainDocumentCommon.asm): what all its
 * operations share (the operation in progress, busy, attributes, the
 * notification of the document control), saving, updating, auto save
 * and the check for changes by others, on their timers.
 *
 * Port32 (Port32/ABI.md section 13y): as the asm's Motif build (none
 * of FLOPPY_BASED_DOCUMENTS, LIMITED_UNTITLED_DOC_DISK_SPACE,
 * VOLATILE_SYSTEM_STATE, UNTITLED_DOCS_ON_SP_TOP).  The methods of the
 * class are in cmainDocumentNew.goc (new, open, connections),
 * cmainDocPhysical.goc (the file itself, the document's UI),
 * cmainDocumentMisc.goc (attach, detach, close, save as, revert) and
 * cmainDocObscure.goc (the rarer ones).
 */
@include "cmainDocument.goh"
@include <Objects/gProcC.goh>

@classdecl OLDocumentClass;

/* cmainDocPhysical.goc */
@extern method OLDocumentClass, MSG_GEN_DOCUMENT_INITIALIZE_DOCUMENT_FILE;
