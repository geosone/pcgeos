@method OLDocumentGroupClass, MSG_GEN_DOCUMENT_GROUP_GET_PROTOCOL
{
    GenDocumentGroupInstance *g = GDG(oself);

    (void) pself;
    return ((dword) g->GDGI_protocolMinor << 16) | g->GDGI_protocolMajor;
}

@method OLDocumentGroupClass, MSG_GEN_DOCUMENT_GROUP_GET_VIEW
