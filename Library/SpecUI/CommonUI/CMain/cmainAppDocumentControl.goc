@method OLDocumentGroupClass, MSG_META_GET_MODEL_EXCL
{
    *modelObject = pself->OLDGI_modelExcl.HG_OD;
    return TRUE;
}

/* OLDocumentGroupAlterFTVMCExcl: the model exclusive of a document is
 * the group's to give; the rest goes on up */
@method OLDocumentGroupClass, MSG_META_MUP_ALTER_FTVMC_EXCL
{
    (void) pself;
    if (flags & MAEF_MODEL) {
	FlowAlterHierarchicalGrab(oself, MSG_META_GAINED_MODEL_EXCL,
				  VIS_MASTER, OLDG_OFFSET(OLDGI_modelExcl),
				  objectWantingControl,
				  flags & (MAEF_GRAB | MAEF_MODEL));
	flags &= ~MAEF_MODEL;
	if (!(flags & MAEF_MASK_OF_ALL_HIERARCHIES))
	    return;
    }
    @callsuper oself::OLDocumentGroupClass::MSG_META_MUP_ALTER_FTVMC_EXCL(
	objectWantingControl, flags);
}

/* ---------------------------------------------------------------------
 * New and open
 * ------------------------------------------------------------------- */

/*
 * CreateDocObject: a new document object, a child of the group, usable,
 * which then makes or opens its file (msg: MSG_GEN_DOCUMENT_NEW or
 * ..._OPEN).  If that fails the object goes again, and the control
 * sees whether its main dialog is to come up.  The document, 0 if
 * there is none.
 */
static optr CreateDocObject(optr o, Message msg, DocumentCommonParams *params)
{
    optr proto = GDG(o)->GDGI_genDocument, doc;
    word fileOrError = 0;
    Boolean err;

    if (OptrToHandle(proto))
	doc = ConstructOptr(ObjDuplicateResource(OptrToHandle(proto), 0, 0),
			    OptrToChunk(proto));
    else
	doc = ObjInstantiate(OptrToHandle(o), GDG(o)->GDGI_documentClass);
    /* opened for an IACP connection alone */
    if (params->DCP_flags & DOF_OPEN_FOR_IACP_ONLY)
	@call doc::MSG_META_ADD_VAR_DATA(ATTR_GEN_DOCUMENT_OPEN_FOR_IACP_ONLY,
					 0, NULL);
    @call o::MSG_GEN_ADD_CHILD(doc, CCO_FIRST | CCF_MARK_DIRTY);
    @call doc::MSG_GEN_SET_USABLE(VUM_MANUAL);
    if (msg == MSG_GEN_DOCUMENT_NEW)
	err = @call doc::MSG_GEN_DOCUMENT_NEW(&fileOrError, params);
    else
	err = @call doc::MSG_GEN_DOCUMENT_OPEN(&fileOrError, params);
    if (!err)
	return doc;
    @call o::MSG_OLDG_REMOVE_DOC(doc);
    SendToUIDocControl(o, MSG_OLDC_TEST_FOR_DISPLAY_MAIN_DIALOG, NULL, 0);
    return 0;
}

/* OLDocumentGroupNewDoc (cmainDocPhysical.asm) */
@method OLDocumentGroupClass, MSG_GEN_DOCUMENT_GROUP_NEW_DOC
{
    (void) pself;
    return CreateDocObject(oself, MSG_GEN_DOCUMENT_NEW, params);
}

/*
 * OLDocumentGroupOpenDoc: a document that is open already comes to the
 * front instead (MSG_GEN_DOCUMENT_GROUP_SEARCH_FOR_DOC); not for a
 * template, which is always copied into a new document.
 */
@method OLDocumentGroupClass, MSG_GEN_DOCUMENT_GROUP_OPEN_DOC
{
    (void) pself;
    params->DCP_flags |= DOF_RAISE_APP_AND_DOC;
    if (!(params->DCP_flags & DOF_FORCE_TEMPLATE_BEHAVIOR)) {
	Boolean open = @call oself::MSG_GEN_DOCUMENT_GROUP_SEARCH_FOR_DOC(
			params);

	if (open)
	    return 0;
    }
    return CreateDocObject(oself, MSG_GEN_DOCUMENT_OPEN, params);
}

/*
 * OLDocumentGroupSearchForDoc: TRUE if a document has the file open
 * (it then does what the flags ask: comes to the front, takes the
 * connection).  The documents compare the id of the file, which is
 * put into the first four bytes of the name, with its disk, while they
 * are asked (DOF_NAME_HOLDS_FILE_ID).
 */
@method OLDocumentGroupClass, MSG_GEN_DOCUMENT_GROUP_SEARCH_FOR_DOC
{
    DocumentOpenFlags flags = params->DCP_flags;
    DiskHandle disk = params->DCP_diskHandle;
    Boolean found = FALSE;
    byte name[sizeof(FileID)];
    FileID id;
    optr doc;
    word i;

    (void) pself;
    if (!(flags & DOF_NAME_HOLDS_FILE_ID)) {
	DiskHandle d = disk;

	id = IACPGetDocumentID(params->DCP_path, params->DCP_name, &d);
	memcpy(name, params->DCP_name, sizeof(name));
	memcpy(params->DCP_name, &id, sizeof(id));
	params->DCP_diskHandle = d;
    }
    params->DCP_flags |= DOF_NAME_HOLDS_FILE_ID;
    for (i = 0; (doc = @call oself::MSG_GEN_FIND_CHILD_AT_POSITION(i)) != 0;
	 i++) {
	if (@call doc::MSG_GEN_DOCUMENT_SEARCH_FOR_DOC(params)) {
	    found = TRUE;
	    break;
	}
    }
    if (!(flags & DOF_NAME_HOLDS_FILE_ID)) {
	params->DCP_diskHandle = disk;
	memcpy(params->DCP_name, name, sizeof(name));
    }
    params->DCP_flags = flags | (params->DCP_flags & ~DOF_NAME_HOLDS_FILE_ID);
    return found;
}

/* OLDocumentGroupGetDefaultName: the name of an untitled document, in
 * SP_DOCUMENT; the group's attributes */
@method OLDocumentGroupClass, MSG_GEN_DOCUMENT_GROUP_GET_DEFAULT_NAME
{
    DocumentCommonParams *p = (DocumentCommonParams *) buffer;
    GenDocumentGroupInstance *g = GDG(oself);
    ChunkHandle name = g->GDGI_untitledName;
    word size;

    (void) pself;
    p->DCP_diskHandle = SP_DOCUMENT;
    p->DCP_path[0] = 0;
    p->DCP_name[0] = 0;
    if (name) {
	size = LMemGetChunkSizeHandles(OptrToHandle(oself), name);
	EC_ERROR_IF(size > FILE_LONGNAME_LENGTH - 3 + 1, -1);
	if (size > sizeof(p->DCP_name))
	    size = sizeof(p->DCP_name);
	memcpy(p->DCP_name, LMemDerefHandles(OptrToHandle(oself), name),
	       size);
    }
    return g->GDGI_attrs;
}

/* ---------------------------------------------------------------------
 * Import, printing
 * ------------------------------------------------------------------- */

/* OLDocumentGroupImportNewDoc: a new, really empty document, which
 * imports the file; the import control is told how it went */
@method OLDocumentGroupClass, MSG_GEN_DOCUMENT_GROUP_IMPORT_NEW_DOC
{
    DocumentCommonParams p;
    optr doc;

    (void) pself;
    memset(&p, 0, sizeof(p));
    p.DCP_flags = DOF_FORCE_REAL_EMPTY_DOCUMENT;
    p.DCP_docAttrs = GDA_UNTITLED;
    doc = CreateDocObject(oself, MSG_GEN_DOCUMENT_NEW, &p);
    if (doc)
	(void) @call doc::MSG_GEN_DOCUMENT_IMPORT(params);
    if (params->ITP_impexOD)
	CObjMessageP(0, params->ITP_impexOD, params->ITP_returnMsg, params,
		     sizeof(*params), NULL, 0);
    return doc;
}

/* OLDocumentGroupGetDocName: the print control gets the name of the
 * target document ("" if there is none) */
@method OLDocumentGroupClass, MSG_PRINT_GET_DOC_NAME
{
    FileLongName name;
    optr doc = pself->OLDGI_modelExcl.HG_OD;

    name[0] = 0;
    if (doc)
	@call doc::MSG_GEN_DOCUMENT_GET_FILE_NAME(name);
    @call printCtrlOD::MSG_PRINT_CONTROL_SET_DOC_NAME(name);
}

/* ---------------------------------------------------------------------
 * A document goes; closing while quitting
 * ------------------------------------------------------------------- */

/*
 * OLDocumentGroupRemoveDoc: the document gives up the model exclusive,
 * leaves the tree and is freed: its block if it is a copy of the
 * resource of GDGI_genDocument, else the object.
 */
@method OLDocumentGroupClass, MSG_OLDG_REMOVE_DOC
{
    (void) pself;
    @call document::MSG_META_RELEASE_MODEL_EXCL();
    @call document::MSG_GEN_SET_NOT_USABLE(VUM_NOW);
    @call oself::MSG_GEN_REMOVE_CHILD(document, 0);
    if (OptrToHandle(GDG(oself)->GDGI_genDocument))
	@send document::MSG_META_BLOCK_FREE();
    else
	@send document::MSG_META_OBJ_FREE();
}

/* OLDocumentGroupSaveAsCancelled: a quit is off; the target document
 * is told */
@method OLDocumentGroupClass, MSG_GEN_DOCUMENT_GROUP_SAVE_AS_CANCELLED
{
    (void) pself;
    @call oself::MSG_OLDG_USER_CLOSE_CANCELLED();
    SendToDocOrTarget(oself, 0, MSG_GEN_DOCUMENT_SAVE_AS_CANCELLED);
}

@method OLDocumentGroupClass, MSG_OLDG_USER_CLOSE_CANCELLED
{
    optr quit = pself->OLDGI_quitObj, ctrl;

    pself->OLDGI_quitObj = 0;
    if (!quit)
	return;
    ctrl = GDG(oself)->GDGI_documentControl;
    if (ctrl)
	@send ctrl::MSG_META_QUIT_ACK(0, (word) -1);
}

@method OLDocumentGroupClass, MSG_OLDG_USER_CLOSE_OK
{
    if (pself->OLDGI_quitObj)
	@call oself::MSG_META_QUIT();
}
