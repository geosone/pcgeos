/*
 * cmainUIDocumentControl.goc -- OLDocumentControlClass (after
 * cmainUIDocumentControl.asm and the OLDocumentControlUI, ...ToolboxUI
 * and ControlStrings resources of cmainUIDocumentControl.ui): the
 * specific part of a GenDocumentControl, the part of the document
 * control that runs in the UI thread.  It is a controller: its normal
 * UI is the File menu's entries for documents (New/Open, Close, Save,
 * Save As, Backup, Other), its tools the buttons for them.  The state
 * of the target document comes with GWNT_DOCUMENT_CHANGE
 * (NotifyDocumentChange), by which the entries are enabled.  What the
 * entries do is the GenDocumentGroup's (GDCI_documentGroup, in the
 * application thread) and the target GenDocument's; the control itself
 * has the model exclusive and passes what comes for the model on to
 * the group.  The dialogs are in cmainUIDocOperations.goc.
 *
 * Port32 (Port32/ABI.md section 13y): the messages that take a
 * structure of the stack (DocumentCommonParams,
 * DocumentFileChangedParams) carry a copy when queued (section 5).
 * The parameter of the Close entry is the connection alone
 * (MSG_GEN_DOCUMENT_CLOSE's parameter structure).  The dialogs
 * are in cmainUIDocOperations.goc.
 */
@include "cGeode.goh"
@include <Internal/specC.goh>
@include <Internal/SpecUI/olDocumentControlClass.goh>
@include <Internal/SpecUI/olDocumentClass.goh>
@include <Objects/gDocGrpC.goh>
@include <Objects/gPrimC.goh>
@include <Objects/gDispC.goh>
@include <Objects/gTrigC.goh>
@include <Objects/gInterC.goh>
@include <alb.goh>
@include <gcnlist.goh>
#include <initfile.h>
#include <disk.h>
#include <file.h>
#include <string.h>

@classdecl OLDocumentControlClass, neverSaved;

#define OLDC_DEFAULT_FEATURES		GDC_SUGGESTED_ADVANCED_FEATURES
#define OLDC_DEFAULT_TOOLBOX_FEATURES	0x003f	/* all of GDCToolboxFeatures */

/* (ALF_OPEN_FOR_IACP_ONLY of alb.def; ui.goh has its old name) */
#define ALF_OPEN_FOR_IACP_ONLY		ALF_LAUNCHED_FOR_PRINTING_ONLY

/* the features of the Other sub menu */
#define OTHER_FEATURES \
    (GDCF_COPY | GDCF_EXPORT | GDCF_REVERT | GDCF_RENAME | \
     GDCF_EDIT_USER_NOTES | GDCF_SET_TYPE | GDCF_SET_PASSWORD | \
     GDCF_SAVE_AS_TEMPLATE | GDCF_SET_EMPTY_DOCUMENT | \
     GDCF_SET_DEFAULT_DOCUMENT)

/* ---------------------------------------------------------------------
 * The options of the specific UI ([ui] docControlOptions,
 * docControlFSLevel, backupDir of the field's category; the variables
 * are in cmainVariable.goc)
 * ------------------------------------------------------------------- */

/* SpecInitDocumentControl: backupDir is a path followed by the data of
 * a saved disk */
void SpecInitDocumentControl(const char *category)
{
    word v, size = 0;
    MemHandle bh = 0;

    if (!InitFileReadInteger(category, "docControlOptions", &v))
	docControlOptions = v;
    if (!InitFileReadInteger(category, "docControlFSLevel", &v))
	docControlFSLevel = v;
    if (InitFileReadDataBlock(category, "backupDir", &bh, &size) || !bh)
	return;
    if (size) {
	char *p = MemLock(bh);
	word n = 0;
	DiskHandle disk = 0;

	while (n < size && p[n])
	    n++;
	if (n < size && n < PATH_BUFFER_SIZE &&
	    (disk = DiskRestore(p + n + 1, NULL)) != 0) {
	    backupDirDisk = disk;
	    memcpy(backupDirPath, p, n + 1);
	}
	MemUnlock(bh);
    }
    MemFree(bh);
}

word SpecGetDocControlOptions(void)
{
    return docControlOptions;
}

