/*
 * cmainDocumentMisc.goc -- OLDocumentClass: a document comes back from
 * state, goes to state, and is closed (after cmainDocumentMisc.asm).
 * Closing asks about unsaved changes and saves, reverts or leaves the
 * document open; when the last one who had it open (the user, IACP
 * clients) lets go the document object goes.
 *
 * The class record of OLDocumentClass is here, as in the asm.
 */
@include "cmainDocument.goh"
@include <Objects/gProcC.goh>
@include <Objects/gInterC.goh>
@include <disk.h>
@include <system.h>
@include <Objects/vTextC.goh>

@classdecl OLDocumentClass;
/* cmainDocLowDisk.goc */
