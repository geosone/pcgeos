/*
 * copenButtonBuild.goc -- OLButtonClass (after copenButtonBuild.asm):
 * building a button.  A GenTrigger is its own button (OLBI_genChunk is
 * itself); a popup window's button is set up by the popup
 * (MSG_OL_BUTTON_SETUP) with the popup as its generic part.  The hints
 * make it a default, immediate, system icon or toolbox button; the
 * generic parents say where it goes (SGQT_BUILD_INFO: the menu bar, a
 * menu, the reply bar); in a reply bar it can take the default ring.
 *
 * Port32 (Port32/ABI.md section 13y), not yet: popup lists
 * (OLMenuButtonClass's OLMBSS_OPENS_POPUP_LIST), the pushpin trigger
 * (always enabled), scrollable items in a popup list
 * (OLScrollableItemClass), the task bar (HINT_EXPRESS_MENU always makes
 * a system icon), ATTR_GEN_DEFAULT_MONIKER (the StandardMonikers
 * resource).
 */
@include "cGeode.goh"

@classdecl OLButtonClass;

@extern method OLButtonClass, MSG_VIS_RECALC_SIZE;
@extern method OLButtonClass, MSG_SPEC_GET_EXTRA_SIZE;
@extern method OLButtonClass, MSG_GET_FIRST_MKR_POS;
@extern method OLButtonClass, MSG_VIS_VUP_CREATE_GSTATE;
@extern method OLButtonClass, MSG_SPEC_SET_USABLE;
@extern method OLButtonClass, MSG_SPEC_SET_NOT_USABLE;
@extern method OLButtonClass, MSG_SPEC_UPDATE_VIS_MONIKER;
@extern method OLButtonClass, MSG_SPEC_UPDATE_KBD_ACCELERATOR;
@extern method OLButtonClass, MSG_SPEC_VIS_OPEN_NOTIFY;
@extern method OLButtonClass, MSG_SPEC_VIS_CLOSE_NOTIFY;
@extern method OLButtonClass, MSG_GEN_ACTIVATE;
@extern method OLButtonClass, MSG_OL_BUTTON_KBD_ACTIVATE;
@extern method OLButtonClass, MSG_META_KBD_CHAR;
@extern method OLButtonClass, MSG_META_FUP_KBD_CHAR;
@extern method OLButtonClass, MSG_SPEC_ACTIVATE_OBJECT_WITH_MNEMONIC;
@extern method OLButtonClass, MSG_GEN_FIND_KBD_ACCELERATOR;
@extern method OLButtonClass, MSG_GEN_TRIGGER_MAKE_DEFAULT_ACTION;
@extern method OLButtonClass, MSG_OL_BUTTON_REDRAW;
@extern method OLButtonClass, MSG_META_START_SELECT;
@extern method OLButtonClass, MSG_META_PTR;
@extern method OLButtonClass, MSG_META_END_SELECT;
@extern method OLButtonClass, MSG_META_GAINED_SYS_FOCUS_EXCL;
@extern method OLButtonClass, MSG_META_LOST_SYS_FOCUS_EXCL;
@extern method OLButtonClass, MSG_VIS_LOST_GADGET_EXCL;
@extern method OLButtonClass, MSG_META_GAINED_DEFAULT_EXCL;
@extern method OLButtonClass, MSG_META_LOST_DEFAULT_EXCL;
@extern method OLButtonClass, MSG_SPEC_BROADCAST_FOR_DEFAULT_FOCUS;
@extern method OLButtonClass, MSG_OL_MAKE_APPLYABLE;
@extern method OLButtonClass, MSG_OL_MAKE_NOT_APPLYABLE;
@extern method OLButtonClass, MSG_SPEC_NOTIFY_ENABLED;
@extern method OLButtonClass, MSG_SPEC_NOTIFY_NOT_ENABLED;
@extern method OLButtonClass, MSG_OL_BUTTON_QUERY_IS_TRIGGER;
@extern method OLButtonClass, MSG_VIS_DRAW;
@extern method OLButtonClass, MSG_OL_BUTTON_SET_DRAW_STATE_UNKNOWN;
@extern method OLButtonClass, MSG_OL_BUTTON_GET_GEN_PART;

#define Btn(o)		((OLButtonInstance *) ObjDerefVis(o))
#define T(t)		((t) << OLBF_TARGET_OFFSET)
#define R(r)		((r) << OLBF_REPLY_OFFSET)

/* ---------------------------------------------------------------------
 * Initializing
 * ------------------------------------------------------------------- */

static void ButtonHint(MemHandle mh, ChunkHandle chnk, VarDataEntry *extra,
		       word dataType, void *handlerData)
{
    optr b = ConstructOptr(mh, (ChunkHandle) (uintptr_t) handlerData);
    OLButtonInstance *bi = Btn(b);

    (void) chnk;
    switch (dataType) {
    case HINT_TRIGGER_BRINGS_UP_WINDOW:
	bi->OLBI_specState |= OLBSS_WINDOW_MARK;
	break;
    case ATTR_GEN_TRIGGER_IMMEDIATE_ACTION:
	bi->OLBI_fixedAttrs |= OLBFA_IMMEDIATE_ACTION;
	break;
    case HINT_DEFAULT_DEFAULT_ACTION:
	bi->OLBI_fixedAttrs |= OLBFA_MASTER_DEFAULT_TRIGGER;
	break;
    case HINT_MDI_LIST_ENTRY: {
	/* a menu item, unbordered; the generic part another chunk */
	ChunkHandle *c = (ChunkHandle *) (extra + 1);

	bi->OLBI_specState |= OLBSS_IN_MENU;
	bi->OLBI_specState &= ~OLBSS_BORDERED;
	if ((extra->VDE_dataType & VDF_EXTRA_DATA) && *c)
	    bi->OLBI_genChunk = *c;
	OLButtonUpdateState(b);
	break;
    }
    case HINT_SYS_ICON:
	bi->OLBI_specState |= OLBSS_SYS_ICON;
	bi->VI_attrs &= ~VA_MANAGED;
	break;
    case HINT_EXPRESS_MENU:
	/* (no task bar in Port32) */
	bi->OLBI_specState |= OLBSS_SYS_ICON;
	break;
    case HINT_DEFAULT_FOCUS:
	bi->OLBI_fixedAttrs |= OLBFA_DEFAULT_FOCUS;
	break;
    case HINT_SHOW_SHORTCUT:
	bi->OLBI_fixedAttrs |= OLBFA_FORCE_SHORTCUT;
	break;
    case HINT_DRAW_SHORTCUT_BELOW:
	bi->OLBI_moreAttrs |= OLBMA_DRAW_SHORTCUT_BELOW;
	break;
    case HINT_DONT_SHOW_SHORTCUT:
	bi->OLBI_fixedAttrs |= OLBFA_FORCE_NO_SHORTCUT;
	break;
    }
}

static VarDataCHandler buttonHints[] = {
    { HINT_TRIGGER_BRINGS_UP_WINDOW, ButtonHint },
    { ATTR_GEN_TRIGGER_IMMEDIATE_ACTION, ButtonHint },
    { HINT_DEFAULT_DEFAULT_ACTION, ButtonHint },
    { HINT_MDI_LIST_ENTRY, ButtonHint },
    { HINT_SYS_ICON, ButtonHint },
    { HINT_EXPRESS_MENU, ButtonHint },
    { HINT_DEFAULT_FOCUS, ButtonHint },
    { HINT_SHOW_SHORTCUT, ButtonHint },
    { HINT_DRAW_SHORTCUT_BELOW, ButtonHint },
    { HINT_DONT_SHOW_SHORTCUT, ButtonHint },
};

/* the generic part, if it is generic */
static optr GenPart(optr oself)
{
    ChunkHandle g = Btn(oself)->OLBI_genChunk;

    if (!g)
	return 0;
    if (!(((VisInstance *) ObjDerefVis(ConstructOptr(OptrToHandle(oself),
					g)))->VI_typeFlags & VTF_IS_GEN))
	return 0;
    return ConstructOptr(OptrToHandle(oself), g);
}

static void GadgetHint(MemHandle mh, ChunkHandle chnk, VarDataEntry *extra,
		       word dataType, void *handlerData)
{
    OLButtonMoreAttrs *f = handlerData;

    (void) mh; (void) chnk; (void) extra;
    switch (dataType) {
    case HINT_EXPAND_WIDTH_TO_FIT_PARENT:
	*f |= OLBMA_EXPAND_WIDTH_TO_FIT_PARENT;
	break;
    case HINT_EXPAND_HEIGHT_TO_FIT_PARENT:
	*f |= OLBMA_EXPAND_HEIGHT_TO_FIT_PARENT;
	break;
    case HINT_CAN_CLIP_MONIKER_WIDTH:
	*f |= OLBMA_CAN_CLIP_MONIKER_WIDTH;
	break;
    case HINT_CAN_CLIP_MONIKER_HEIGHT:
	*f |= OLBMA_CAN_CLIP_MONIKER_HEIGHT;
	break;
    case HINT_CENTER_MONIKER:
	*f |= OLBMA_CENTER_MONIKER;
	break;
    }
}

/* OLGlyphHints (copenGlyphDisplay.asm), but HINT_GLYPH_SEPARATOR */
static VarDataCHandler gadgetHints[] = {
    { HINT_EXPAND_WIDTH_TO_FIT_PARENT, GadgetHint },
    { HINT_EXPAND_HEIGHT_TO_FIT_PARENT, GadgetHint },
    { HINT_CAN_CLIP_MONIKER_WIDTH, GadgetHint },
    { HINT_CAN_CLIP_MONIKER_HEIGHT, GadgetHint },
    { HINT_CENTER_MONIKER, GadgetHint },
};

/*
 * OLButtonScanGeometryHints: the button hints of the generic part; the
 * geometry flags; the gadget hints (any: the size recalculated even
 * when valid)
 */
@method OLButtonClass, MSG_SPEC_SCAN_GEOMETRY_HINTS
{
    optr g = GenPart(oself);
    OLButtonMoreAttrs f = 0;

    if (g)
	ObjVarScanData(g, sizeof(buttonHints) / sizeof(buttonHints[0]),
		       buttonHints,
		       (void *) (uintptr_t) OptrToChunk(oself));
    pself = Btn(oself);
    pself->VI_geoAttrs |= VGA_ONLY_RECALC_SIZE_WHEN_INVALID |
			  VGA_USE_VIS_CENTER | VGA_USE_VIS_SET_POSITION;
    pself->OLBI_moreAttrs &= ~(OLBMA_EXPAND_WIDTH_TO_FIT_PARENT |
			       OLBMA_EXPAND_HEIGHT_TO_FIT_PARENT |
			       OLBMA_CAN_CLIP_MONIKER_WIDTH |
			       OLBMA_CAN_CLIP_MONIKER_HEIGHT |
			       OLBMA_CENTER_MONIKER);
    g = GenPart(oself);
    if (g) {
	OpenScanVarData(g, sizeof(gadgetHints) / sizeof(gadgetHints[0]),
			gadgetHints, &f);
	if (f)
	    Btn(oself)->VI_geoAttrs &= ~VGA_ONLY_RECALC_SIZE_WHEN_INVALID;
    }
    Btn(oself)->OLBI_moreAttrs |= f;
}

/*
 * OLButtonInitialize: its own generic part, a simple generic object
 * with a vis parent of its own, bordered; the hints; seeking the title
 * bar makes it a system icon there
 */
@method OLButtonClass, MSG_META_INITIALIZE
{
    @callsuper();
    pself = Btn(oself);
    pself->OLBI_genChunk = OptrToChunk(oself);
    pself->VI_specAttrs |= SA_SIMPLE_GEN_OBJ | SA_CUSTOM_VIS_PARENT;
    pself->VI_geoAttrs |= VGA_ONLY_RECALC_SIZE_WHEN_INVALID |
			  VGA_USE_VIS_CENTER | VGA_USE_VIS_SET_POSITION;
    pself->OLBI_specState |= OLBSS_BORDERED;
    @call oself::MSG_SPEC_SCAN_GEOMETRY_HINTS();
    if (ObjVarFindData(oself, HINT_SEEK_TITLE_BAR_LEFT) ||
	ObjVarFindData(oself, HINT_SEEK_TITLE_BAR_RIGHT)) {
	Btn(oself)->OLBI_specState |= OLBSS_SYS_ICON;
	(void) ObjVarAddData(oself, ATTR_OL_BUTTON_IN_TITLE_BAR, 0);
    }
}

@method OLButtonClass, MSG_OL_BUTTON_SET_WIN_FLAG
{
    pself->OLBI_specState |= OLBSS_WINDOW_MARK;
}

@method OLButtonClass, MSG_OL_BUTTON_CLEAR_WIN_FLAG
{
    pself->OLBI_specState &= ~OLBSS_WINDOW_MARK;
}

/* ---------------------------------------------------------------------
 * The vis parent
 * ------------------------------------------------------------------- */

/*
 * UseQueryResultsToSetButtonAttributes: from the build flags: a popup
 * list's button is centered and bordered; avoiding the menu bar makes
 * a bordered button with a down mark (not for the express menu); in the
 * menu bar or a menu, no border
 */
static void UseQueryResults(optr oself, OLBuildFlags f)
{
    OLButtonInstance *b = Btn(oself);
    word reply = f & OLBF_REPLY;
    optr g;

    if ((f & OLBF_TARGET) == T(OLBT_IS_POPUP_LIST)) {
	/* (OLMBSS_OPENS_POPUP_LIST: with OLMenuButtonClass) */
	b->OLBI_moreAttrs |= OLBMA_CENTER_MONIKER;
	b->OLBI_specState |= OLBSS_BORDERED | OLBSS_WAS_BORDERED;
	b->OLBI_specState &= ~OLBSS_IN_MENU_BAR;
	return;
    }
    if (f & OLBF_AVOID_MENU_BAR) {
	b->OLBI_specState |= OLBSS_BORDERED | OLBSS_MENU_DOWN_MARK;
	g = GenPart(oself);
	if (g && ObjVarFindData(g, HINT_EXPRESS_MENU))
	    Btn(oself)->OLBI_specState &= ~OLBSS_MENU_DOWN_MARK;
	return;
    }
    if (reply == R(OLBR_TOP_MENU)) {
	b->OLBI_specState |= OLBSS_IN_MENU_BAR;
	b->OLBI_specState &= ~OLBSS_BORDERED;
    } else if (reply == R(OLBR_SUB_MENU)) {
	b->OLBI_specState |= OLBSS_IN_MENU;
	b->OLBI_specState &= ~OLBSS_BORDERED;
    }
}

/*
 * OLButtonGetVisParent: in the title bar: the generic parent; a system
 * icon: its generic parent; a popup's button: the popup's vis parent;
 * else the generic parents are asked (SGQT_BUILD_INFO with the
 * trigger's hints) and the answer sets the button's look.  0 for the
 * generic parent.
 */
@method OLButtonClass, MSG_SPEC_GET_VIS_PARENT
{
    OLBuildFlags f = OLBF_TRIGGER;
    GenReturnParams r;
    optr gp = GenFindParent(oself), vp = 0;
    ChunkHandle g;

    OLButtonUpdateState(oself);
    if (OpenCheckIfBW())
	Btn(oself)->OLBI_optFlags &= ~OLBOF_DRAW_STATE_KNOWN;
    if (!ObjVarFindData(oself, HINT_SEEK_TITLE_BAR_RIGHT) &&
	!ObjVarFindData(oself, HINT_SEEK_TITLE_BAR_LEFT)) {
	pself = Btn(oself);
	if (pself->OLBI_specState & OLBSS_SYS_ICON)
	    return gp;
	g = pself->OLBI_genChunk;
	if ((pself->OLBI_specState & OLBSS_OPENS_POPUP_WINDOW_MASK) &&
	    g != OptrToChunk(oself)) {
	    /* the popup's button: where the popup puts its button part
	     * (its OLCI_visParent, else what its generic parent
	     * determines; the button itself has no generic parent) */
	    optr popup = ConstructOptr(OptrToHandle(oself), g);

	    return @call popup::MSG_SPEC_GET_VIS_PARENT(
					flags & ~SBF_WIN_GROUP);
	}
    }
    OLScanMapGroupHints(oself, &f);
    memset(&r, 0, sizeof(r));
    r.GRP_bp = f;
    if (gp && @call gp::MSG_GEN_GUP_QUERY(&r, SGQT_BUILD_INFO)) {
	UseQueryResults(oself, (OLBuildFlags) r.GRP_bp);
	if (r.GRP_cx)
	    vp = ConstructOptr(r.GRP_cx, r.GRP_dx);
    } else
	UseQueryResults(oself, f);
    return vp == gp ? 0 : vp;
}

/* ---------------------------------------------------------------------
 * Building
 * ------------------------------------------------------------------- */

/*
 * SetToolboxBasedOnParent: not for an MDI list entry: a parent OLCtrl
 * for the title bar makes a system icon there; in a toolbox the button
 * is a toolbox button, the height of a horizontal parent (not in a
 * menu; a narrow vertical one loses its down mark), its size
 * recalculated even when valid
 */
static void SetToolboxBasedOnParent(optr oself)
{
    optr g, p;
    OLBuildFlags bf = 0;
    VisCompGeoAttrs ga = 0;
    word target;
    OLButtonInstance *b;

    if (ObjVarFindData(oself, HINT_MDI_LIST_ENTRY))
	return;
    g = ConstructOptr(OptrToHandle(oself), Btn(oself)->OLBI_genChunk);
    p = GenFindParent(g);
    if (!p)
	return;
    ObjLockObjBlock(OptrToHandle(p));
    if (ObjIsObjectInClass(p, &OLCtrlClass)) {
	OLCtrlInstance *c = (OLCtrlInstance *) ObjDerefVis(p);

	bf = c->OLCI_buildFlags;
	ga = c->VCI_geoAttrs;
    }
    MemUnlock(OptrToHandle(p));
    target = bf & OLBF_TARGET;
    if (target == T(OLBT_FOR_TITLE_BAR_LEFT) ||
	target == T(OLBT_FOR_TITLE_BAR_RIGHT)) {
	Btn(oself)->OLBI_specState |= OLBSS_SYS_ICON;
	(void) ObjVarAddData(oself, ATTR_OL_BUTTON_IN_TITLE_BAR, 0);
    }
    if (!(bf & OLBF_TOOLBOX))
	return;
    b = Btn(oself);
    b->OLBI_moreAttrs |= OLBMA_IN_TOOLBOX;
    if (b->OLBI_specState & OLBSS_IN_MENU)
	;
    else if (!(ga & VCGA_ORIENT_CHILDREN_VERTICALLY))
	b->OLBI_moreAttrs |= OLBMA_EXPAND_HEIGHT_TO_FIT_PARENT;
    else if (OpenCheckIfNarrow())
	b->OLBI_specState &= ~OLBSS_MENU_DOWN_MARK;
    b->VI_geoAttrs &= ~VGA_ONLY_RECALC_SIZE_WHEN_INVALID;
}

/* OLButtonInitFixedAttrs: the toolbox; a master default (not in a
 * menu) or a reply bar button can be the temporary default (with
 * default rings) */
static void InitFixedAttrs(optr oself)
{
    OLButtonInstance *b;
    Boolean can = FALSE;

    SetToolboxBasedOnParent(oself);
    b = Btn(oself);
    if (b->OLBI_fixedAttrs & OLBFA_MASTER_DEFAULT_TRIGGER)
	can = !(b->OLBI_specState & (OLBSS_IN_MENU | OLBSS_IN_MENU_BAR));
    else
	can = (b->OLBI_fixedAttrs & OLBFA_IN_REPLY_BAR) != 0;
    if (can && OpenCheckDefaultRings())
	Btn(oself)->OLBI_fixedAttrs |= OLBFA_CAN_BE_TEMP_DEFAULT_TRIGGER;
}

static void ButtonHint2(MemHandle mh, ChunkHandle chnk, VarDataEntry *extra,
			word dataType, void *handlerData)
{
    optr b = ConstructOptr(mh, (ChunkHandle) (uintptr_t) handlerData);

    (void) chnk; (void) extra;
    switch (dataType) {
    case HINT_TRIGGER_DESTRUCTIVE_ACTION:
	Btn(b)->OLBI_fixedAttrs &= ~OLBFA_CAN_BE_TEMP_DEFAULT_TRIGGER;
	break;
    case HINT_NO_BORDERS_ON_MONIKERS:
	Btn(b)->OLBI_specState &= ~OLBSS_BORDERED;
	break;
    case HINT_ENSURE_TEMPORARY_DEFAULT:
	if (OpenCheckDefaultRings()) {
	    Btn(b)->OLBI_fixedAttrs |= OLBFA_CAN_BE_TEMP_DEFAULT_TRIGGER;
	    VisCallParent(b, MSG_SPEC_CTRL_SET_MORE_FLAGS,
			  &(struct { OLCtrlMoreFlags s, c; })
			  { OLCOF_OVERSIZED_CHILDREN, 0 },
			  sizeof(struct { OLCtrlMoreFlags s, c; }),
			  NULL, 0);
	}
	break;
    case ATTR_GEN_DEFAULT_MONIKER:
	/* (the StandardMonikers resource: not yet) */
	break;
    }
}

static VarDataCHandler buttonHints2[] = {
    { HINT_TRIGGER_DESTRUCTIVE_ACTION, ButtonHint2 },
    { HINT_ENSURE_TEMPORARY_DEFAULT, ButtonHint2 },
    { ATTR_GEN_DEFAULT_MONIKER, ButtonHint2 },
    { HINT_NO_BORDERS_ON_MONIKERS, ButtonHint2 },
};

/* HandleGenericButtonHints: the generic part's hints that need the
 * button built */
static void HandleGenericButtonHints(optr oself)
{
    optr g = ConstructOptr(OptrToHandle(oself), Btn(oself)->OLBI_genChunk);

    ObjVarScanData(g, sizeof(buttonHints2) / sizeof(buttonHints2[0]),
		   buttonHints2, (void *) (uintptr_t) OptrToChunk(oself));
}

/* the interaction command of the trigger told to its window (as made
 * or as going) */
static void NotifyInteractionCommand(optr oself, word flags)
{
    InteractionCommand *ic = ObjVarFindData(oself,
					ATTR_GEN_TRIGGER_INTERACTION_COMMAND);
    NotifyOfInteractionCommandStruct n;
    optr win;

    if (!ic || !(VarDataFlagsPtr(ic) & VDF_EXTRA_DATA))
	return;
    n.NOICS_optr = oself;
    n.NOICS_ic = *ic;
    n.NOICS_flags = flags;
    win = OpenFindOLWin(oself);
    if (win)
	@call win::MSG_OL_WIN_NOTIFY_OF_INTERACTION_COMMAND(&n);
}

/* a query to the window of the button about it */
void OLButtonCallWin(optr oself, VisUpwardQueryType q)
{
    optr win = OpenFindOLWin(oself);
    GenReturnParams r;

    if (!win)
	return;
    memset(&r, 0, sizeof(r));
    (void) @call win::MSG_VIS_P32_VUP_QUERY(&r, q, OptrToChunk(oself),
					    OptrToHandle(oself));
}

/*
 * OLButtonSpecBuild: system icons and the system menu's close are
 * built enabled; in a menu window the button is a menu item (no
 * border); a gadget in a reply bar with default rings is one there;
 * the fixed attributes, its interaction command told to the window, the
 * hints, a master default made the window's
 */
@method OLButtonClass, MSG_SPEC_BUILD
{
    optr win;

    if (ObjVarFindData(oself, ATTR_SYSTEM_MENU_CLOSE) ||
	(Btn(oself)->OLBI_specState & OLBSS_SYS_ICON))
	flags |= SBF_VIS_PARENT_FULLY_ENABLED;
    @callsuper oself::OLButtonClass::MSG_SPEC_BUILD(flags);
    if (!(Btn(oself)->OLBI_specState & OLBSS_SYS_ICON)) {
	win = OpenFindOLWin(oself);
	if (win) {
	    Boolean menu;

	    ObjLockObjBlock(OptrToHandle(win));
	    menu = (((OLWinInstance *) ObjDerefVis(win))->OLWI_fixedAttr &
		    OWFA_IS_MENU) != 0;
	    MemUnlock(OptrToHandle(win));
	    if (menu) {
		Btn(oself)->OLBI_specState |= OLBSS_IN_MENU;
		Btn(oself)->OLBI_specState &= ~OLBSS_BORDERED;
	    }
	}
    }
    if (!(Btn(oself)->OLBI_specState & (OLBSS_SETTING | OLBSS_IN_MENU)) &&
	OpenCheckDefaultRings()) {
	GenReturnParams r;
	optr p = VisFindParent(oself);

	memset(&r, 0, sizeof(r));
	if (p && @call p::MSG_VIS_P32_VUP_QUERY(&r, SVQT_QUERY_FOR_REPLY_BAR,
						0, 0))
	    Btn(oself)->OLBI_fixedAttrs |= OLBFA_IN_REPLY_BAR;
    }
    InitFixedAttrs(oself);
    NotifyInteractionCommand(oself, 0);
    HandleGenericButtonHints(oself);
    if (OpenButtonCheckIfFullyEnabled(oself) &&
	(Btn(oself)->OLBI_fixedAttrs & OLBFA_MASTER_DEFAULT_TRIGGER))
	OLButtonCallWin(oself, SVQT_SET_MASTER_DEFAULT);
}

/*
 * OLButtonVisUnbuildBranch: the interaction command's trigger gone; a
 * popup's button unbuilt with its vis parent is forgotten by the popup;
 * no longer the master default or default
 */
@method OLButtonClass, MSG_SPEC_UNBUILD_BRANCH
{
    ChunkHandle g;

    NotifyInteractionCommand(oself, NOICF_TRIGGER_DEMISE);
    g = Btn(oself)->OLBI_genChunk;
    if ((flags & SBF_VIS_PARENT_UNBUILDING) && g && g != OptrToChunk(oself)) {
	optr p = ConstructOptr(OptrToHandle(oself), g);

	if (ObjIsObjectInClass(p, &OLPopupWinClass))
	    ((OLPopupWinInstance *) ObjDerefVis(p))->OLPWI_button = 0;
    }
    OLButtonResetMasterDefault(oself);
    OLButtonReleaseDefaultExclusive(oself);
    @callsuper();
}

/*
 * OLButtonSetup: a popup's button: the popup is its generic part; a
 * text moniker gets the window mark; the popup's build flags set its
 * look; in a reply bar with default rings it is one there
 */
@method OLButtonClass, MSG_OL_BUTTON_SETUP
{
    optr g = ConstructOptr(OptrToHandle(oself), genChunk);
    ChunkHandle m;
    optr vp;

    pself->OLBI_genChunk = genChunk;
    m = ((GenInstance *) ObjDerefGen(g))->GI_visMoniker;
    if (m && !(((VisMoniker *) LMemDeref(ConstructOptr(OptrToHandle(g), m)))
		   ->VM_type & VMT_GSTRING))
	Btn(oself)->OLBI_specState |= OLBSS_WINDOW_MARK;
    UseQueryResults(oself, buildFlags);
    vp = ((OLCtrlInstance *) ObjDerefVis(g))->OLCI_visParent;
    if (OpenCheckDefaultRings() && vp) {
	GenReturnParams r;

	memset(&r, 0, sizeof(r));
	if (@call vp::MSG_VIS_P32_VUP_QUERY(&r, SVQT_QUERY_FOR_REPLY_BAR,
					    0, 0))
	    Btn(oself)->OLBI_fixedAttrs |= OLBFA_IN_REPLY_BAR;
    }
    InitFixedAttrs(oself);
    OLButtonUpdateState(oself);
    HandleGenericButtonHints(oself);
}
