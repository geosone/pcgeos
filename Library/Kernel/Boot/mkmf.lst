# mkmf.lst -- the files of this directory that the DOS16 build takes
# (Tools/nmkmf reads only these).  The C ports of the 32-bit build
# (CMake, Port32) beside them are left out.
bootBoot.asm
bootConstant.def
bootInit.asm
bootInitfile.asm
bootInitfileVariable.def
bootLog.asm
bootMacro.def
bootManager.asm
bootStrings.asm
bootVariable.def
