/*
 * taRunLow.goc -- the attribute runs of a small text object (after
 * taRunLow.asm; changing runs is in taRunManip.goc, their elements in
 * taElement.goc, creating them in taStorage.goc, looking up attributes
 * in taRunQuery.goc).
 *
 * A run array is a chunk array of TextRunArrayElement in the object's
 * block (VTI_charAttrRuns, VTI_paraAttrRuns with VTSF_MULTIPLE_...):
 * a run starts at TRAE_position and has the attribute TRAE_token, an
 * element of the element array the run array's header names
 * (TRAH_elementArray, a chunk of the same block); the last run is at
 * TEXT_ADDRESS_PAST_END with CA_NULL_ELEMENT.  The text at a position
 * has the attribute of the last run that starts at or before it (the
 * run "to the right"; to the left: at a run's start, the run before).
 * Elements are counted: one reference per run that uses them (and per
 * insertion token, ATTR_VIS_TEXT_CHAR_ATTR_INSERTION_TOKEN: the
 * attribute for text typed at a cursor).
 *
 * Port32 (Port32/ABI.md section 13z): runs are positions and tokens,
 * looked up by index (no pointers kept across a change of the block).
 * Not yet: graphics and type runs, undo, the cached last run position
 * (TEMP_VIS_TEXT_CACHED_RUN_INFO: only an optimization).
 */
@include "textInt.goh"
#include <chunkarr.h>
#include <hugearr.h>
#include <char.h>

/* ---------------------------------------------------------------------
 * The run array (taRunLow.asm: RunArrayLock, RunArrayInsert, ...)
 *
 * The runs of a small object are a chunk array in its block, those of a
 * large object (and of a transfer format) a huge array in its VM file
 * (TextLargeRunArrayHeader); TextRuns names either.
 * ------------------------------------------------------------------- */

/* RunArrayLock: the runs of a kind of the object */
void TA_RunsOf(optr o, TextRunKind kind, TextRuns *r)
{
    VisTextInstance *t = VT(o);
    word h = kind == TRK_CHAR_ATTR ? t->VTI_charAttrRuns
				   : t->VTI_paraAttrRuns;

    r->TR_file = T_GetVMFile(o);
    if (t->VTI_storageFlags & VTSF_LARGE) {
	r->TR_chunk = NullOptr;
	r->TR_block = h;
    } else {
	r->TR_chunk = ConstructOptr(OptrToHandle(o), h);
	r->TR_block = 0;
    }
}

/* the runs of a transfer format (or any huge array of runs) */
void TA_RunsInFile(VMFileHandle f, VMBlockHandle b, TextRuns *r)
{
    r->TR_chunk = NullOptr;
    r->TR_file = f;
    r->TR_block = b;
}

/* a run locked: of a huge array until RunsUnlock */
static TextRunArrayElement *RunsLock(const TextRuns *r, word i)
{
    void *p;
    word size;

    if (r->TR_block) {
	(void) HugeArrayLock(r->TR_file, r->TR_block, i, &p, &size);
	return p;
    }
    return ChunkArrayElementToPtr(r->TR_chunk, i, NULL);
}

static void RunsUnlock(const TextRuns *r, TextRunArrayElement *e,
		       Boolean dirty)
{
    if (r->TR_block) {
	if (dirty)
	    HugeArrayDirty(e);
	HugeArrayUnlock(e);
    } else if (dirty)
	ObjMarkDirty(r->TR_chunk);
}

word TA_RunsCount(const TextRuns *r)
{
    if (r->TR_block)
	return (word) HugeArrayGetCount(r->TR_file, r->TR_block);
    return (word) ChunkArrayGetCount(r->TR_chunk);
}

static dword PosOf(const TextRunArrayElement *e)
{
    return (word) e->TRAE_position.WAAH_low |
	   ((dword) (byte) e->TRAE_position.WAAH_high << 16);
}

dword TA_RunsPosition(const TextRuns *r, word i)
{
    TextRunArrayElement *e = RunsLock(r, i);
    dword pos = PosOf(e);

    RunsUnlock(r, e, FALSE);
    return pos;
}

word TA_RunsToken(const TextRuns *r, word i)
{
    TextRunArrayElement *e = RunsLock(r, i);
    word token = e->TRAE_token;

    RunsUnlock(r, e, FALSE);
    return token;
}

static void SetPos(TextRunArrayElement *e, dword pos)
{
    e->TRAE_position.WAAH_low = (sword) (word) pos;
    e->TRAE_position.WAAH_high = (sbyte) (byte) (pos >> 16);
}

void TA_RunsSetPosition(const TextRuns *r, word i, dword pos)
{
    TextRunArrayElement *e = RunsLock(r, i);

    SetPos(e, pos);
    RunsUnlock(r, e, TRUE);
}

void TA_RunsSetToken(const TextRuns *r, word i, word token)
{
    TextRunArrayElement *e = RunsLock(r, i);

    e->TRAE_token = token;
    RunsUnlock(r, e, TRUE);
}

/* RunArrayInsert: a run before run i */
void TA_RunsInsert(const TextRuns *r, word i, dword pos, word token)
{
    TextRunArrayElement n;

    SetPos(&n, pos);
    n.TRAE_token = token;
    if (r->TR_block) {
	HugeArrayInsert(r->TR_file, r->TR_block, 1, i, &n);
	return;
    }
    *(TextRunArrayElement *) ChunkArrayInsertAt(r->TR_chunk,
		ChunkArrayElementToPtr(r->TR_chunk, i, NULL), 0) = n;
    ObjMarkDirty(r->TR_chunk);
}

/* RunArrayDelete */
void TA_RunsDelete(const TextRuns *r, word i)
{
    if (r->TR_block) {
	HugeArrayDelete(r->TR_file, r->TR_block, 1, i);
	return;
    }
    ChunkArrayDelete(r->TR_chunk, ChunkArrayElementToPtr(r->TR_chunk, i,
							 NULL));
    ObjMarkDirty(r->TR_chunk);
}

/* GetRunForPosition (right: a run starting at pos is the one) and
 * GetRunForPositionLeft (the run before it); TEXT_ADDRESS_PAST_END is
 * in the middle of the last real run */
word TA_RunsForPosition(const TextRuns *r, dword pos, Boolean left)
{
    word n = TA_RunsCount(r), i;

    for (i = 0; i < n; i++) {
	dword p = TA_RunsPosition(r, i);
	if (pos < p || (pos == p && TA_RunAtEnd(pos)))
	    break;		/* in the middle of the run before */
	if (pos == p)
	    return left && i ? i - 1 : i;
    }
    return i ? i - 1 : 0;
}

/* (the object's runs of a kind) */
dword TA_RunPosition(optr o, TextRunKind kind, word i)
{
    TextRuns r;

    TA_RunsOf(o, kind, &r);
    return TA_RunsPosition(&r, i);
}

word TA_RunToken(optr o, TextRunKind kind, word i)
{
    TextRuns r;

    TA_RunsOf(o, kind, &r);
    return TA_RunsToken(&r, i);
}

void TA_SetRunPos(optr o, TextRunKind kind, word i, dword pos)
{
    TextRuns r;

    TA_RunsOf(o, kind, &r);
    TA_RunsSetPosition(&r, i, pos);
}

void TA_SetRunToken(optr o, TextRunKind kind, word i, word token)
{
    TextRuns r;

    TA_RunsOf(o, kind, &r);
    TA_RunsSetToken(&r, i, token);
}

Boolean TA_RunAtEnd(dword pos)
{
    return (pos >> 16) == TEXT_ADDRESS_PAST_END_HIGH;
}

void TA_RunInsert(optr o, TextRunKind kind, word i, dword pos, word token)
{
    TextRuns r;

    TA_RunsOf(o, kind, &r);
    TA_RunsInsert(&r, i, pos, token);
}

word TA_RunForPosition(optr o, TextRunKind kind, dword pos, Boolean left)
{
    TextRuns r;

    TA_RunsOf(o, kind, &r);
    return TA_RunsForPosition(&r, pos, left);
}

void RunArrayDelete(optr o, TextRunKind kind, word i)
{
    TextRuns r;

    TA_RunsOf(o, kind, &r);
    TA_RunsDelete(&r, i);
}

