/*
 * taCharAttr.goc -- the character attributes of a text object (after
 * taCharAttr.asm; the messages that change one field are in taAttr.goc).
 *
 * Port32 (Port32/ABI.md section 13z): an object with a single
 * character attribute has a VisTextDefaultCharAttr in VTI_charAttrRuns
 * (VTSF_DEFAULT_CHAR_ATTR) or the chunk of a VisTextCharAttr; an
 * attribute that a default record can say is kept as one
 * (SetSingleCharAttr), the range of a change is the whole object.  With
 * VTSF_MULTIPLE_CHAR_ATTRS the range is changed in the runs
 * (taRunManip.goc), one undo chain ("Font/Style Change").
 */
@include "textInt.goh"

@extern chunk StyleString;
#include <font.h>
#include <fontID.h>
#include <chunkarr.h>

static const FontID defaultFonts[] = {
    FID_BERKELEY, FID_CHICAGO, FID_BISON, FID_WINDOWS, FID_LED,
    FID_ROMA, FID_UNIVERSITY,
    FID_DTC_URW_ROMAN, FID_DTC_URW_SANS, FID_DTC_URW_MONO,
    FID_DTC_URW_SYMBOLPS, FID_DTC_CENTURY_SCHOOLBOOK,
    FID_PIZZA_KANJI, FID_BITSTREAM_KANJI_HON_MINCHO,
    FID_BITSTREAM_KANJI_SQUARE_GOTHIC, FID_JSYS, FID_ESQUIRE
};
#define N_DEFAULT_FONTS	(sizeof(defaultFonts) / sizeof(defaultFonts[0]))

static const byte defaultPointSizes[8] = { 8, 9, 10, 12, 14, 18, 24, 36 };

/* TextMapDefaultCharAttr */
void TA_MapDefaultCharAttr(VisTextDefaultCharAttr def, VisTextCharAttr *a)
{
    word font = def & VTDCA_FONT;

    memset(a, 0, sizeof(*a));
    a->VTCA_meta.SSEH_style = CA_NULL_ELEMENT;
    /* (the asm reads past its table for a font it does not have) */
    a->VTCA_fontID = font < N_DEFAULT_FONTS ? defaultFonts[font]
					    : FID_BERKELEY;
    a->VTCA_pointSize.WBF_int =
	defaultPointSizes[(def & VTDCA_SIZE) >> VTDCA_SIZE_OFFSET];
    if (def & VTDCA_UNDERLINE)
	a->VTCA_textStyles |= TS_UNDERLINE;
    if (def & VTDCA_BOLD)
	a->VTCA_textStyles |= TS_BOLD;
    if (def & VTDCA_ITALIC)
	a->VTCA_textStyles |= TS_ITALIC;
    a->VTCA_color.CQ_redOrIndex = (def & VTDCA_COLOR) >> VTDCA_COLOR_OFFSET;
    a->VTCA_color.CQ_info = CF_INDEX;
    a->VTCA_bgColor.CQ_redOrIndex = C_WHITE;
    a->VTCA_bgColor.CQ_info = CF_INDEX;
    a->VTCA_grayScreen = SDM_100;
    a->VTCA_bgGrayScreen = SDM_0;
    a->VTCA_fontWeight = FW_NORMAL;
    a->VTCA_fontWidth = FWI_MEDIUM;
}

/* TextFindDefaultCharAttr: TRUE and the record if a default record says
 * the attribute */
Boolean TA_FindDefaultCharAttr(const VisTextCharAttr *a,
			       VisTextDefaultCharAttr *def)
{
    word font, size, d;

    if (a->VTCA_trackKerning || a->VTCA_extendedStyles ||
	a->VTCA_fontWeight != FW_NORMAL || a->VTCA_fontWidth != FWI_MEDIUM ||
	a->VTCA_grayScreen != SDM_100 || a->VTCA_bgGrayScreen != SDM_0 ||
	a->VTCA_bgColor.CQ_redOrIndex != C_WHITE ||
	a->VTCA_bgColor.CQ_info != CF_INDEX ||
	a->VTCA_pattern.HP_type != PT_SOLID ||
	a->VTCA_pattern.HP_data != 0 ||
	a->VTCA_bgPattern.HP_type != PT_SOLID ||
	a->VTCA_bgPattern.HP_data != 0)
	return FALSE;
    for (font = 0; font < N_DEFAULT_FONTS; font++)
	if (defaultFonts[font] == a->VTCA_fontID)
	    break;
    if (font == N_DEFAULT_FONTS || a->VTCA_pointSize.WBF_frac)
	return FALSE;
    for (size = 0; size < 8; size++)
	if (defaultPointSizes[size] == a->VTCA_pointSize.WBF_int)
	    break;
    if (size == 8)
	return FALSE;
    if (a->VTCA_textStyles & ~(TS_UNDERLINE | TS_BOLD | TS_ITALIC))
	return FALSE;
    /* (the color has four bits in the record) */
    if (a->VTCA_color.CQ_info != CF_INDEX || a->VTCA_color.CQ_redOrIndex > 15)
	return FALSE;
    d = size << VTDCA_SIZE_OFFSET | font |
	(word) a->VTCA_color.CQ_redOrIndex << VTDCA_COLOR_OFFSET;
    if (a->VTCA_textStyles & TS_UNDERLINE)
	d |= VTDCA_UNDERLINE;
    if (a->VTCA_textStyles & TS_BOLD)
	d |= VTDCA_BOLD;
    if (a->VTCA_textStyles & TS_ITALIC)
	d |= VTDCA_ITALIC;
    *def = d;
    return TRUE;
}

/* GetSingleCharAttr */
void TA_GetSingleCharAttr(optr o, VisTextCharAttr *a)
{
    VisTextInstance *t = VT(o);

    if (t->VTI_storageFlags & VTSF_DEFAULT_CHAR_ATTR)
	TA_MapDefaultCharAttr(t->VTI_charAttrRuns, a);
    else
	memcpy(a, LMemDerefHandles(OptrToHandle(o), t->VTI_charAttrRuns),
	       sizeof(*a));
}

/* SetSingleCharAttr */
void TA_SetSingleCharAttr(optr o, const VisTextCharAttr *a)
{
    MemHandle mh = OptrToHandle(o);
    VisTextInstance *t = VT(o);
    VisTextDefaultCharAttr def;
    ChunkHandle c;

    ObjMarkDirty(o);
    if (TA_FindDefaultCharAttr(a, &def)) {
	c = t->VTI_charAttrRuns;
	t->VTI_charAttrRuns = def;
	if (!(t->VTI_storageFlags & VTSF_DEFAULT_CHAR_ATTR)) {
	    t->VTI_storageFlags |= VTSF_DEFAULT_CHAR_ATTR;
	    LMemFreeHandles(mh, c);
	}
	return;
    }
    if (t->VTI_storageFlags & VTSF_DEFAULT_CHAR_ATTR) {
	c = LMemAlloc(mh, sizeof(VisTextCharAttr));
	t = VT(o);
	t->VTI_storageFlags &= ~VTSF_DEFAULT_CHAR_ATTR;
	t->VTI_charAttrRuns = c;
    }
    memcpy(LMemDerefHandles(mh, t->VTI_charAttrRuns), a, sizeof(*a));
}

/*
 * UnHiliteAndFixupCharAttrRange: the range of a change made real (the
 * whole object with a single attribute: VIS_TEXT_RANGE_SELECTION, as
 * FixupCharAttrRange makes it); the selection off the screen while the
 * attribute changes.  FALSE if the object has a single attribute.
 */
Boolean FixupRange(optr o, VisTextRange *r, dword start, dword end)
{
    Boolean multiple =
	(VT(o)->VTI_storageFlags & VTSF_MULTIPLE_CHAR_ATTRS) != 0;

    r->VTR_start = start;
    r->VTR_end = end;
    if (multiple)
	TA_GetTextRange(o, r, VTRC_CHAR_ATTR_CHANGE);
    TextGStateCreate(o);
    EditUnHilite(o);
    return multiple;
}

/* SetCharAttrCommon, SetCharAttrOrParaAttrMultiple: the whole attribute
 * (the element added, the range set to it, the extra reference given
 * up) */
static void SetCharAttr(optr o, dword start, dword end,
			const VisTextCharAttr *a)
{
    VisTextCharAttr c = *a;
    VisTextRange r;
    word token;

    if (FixupRange(o, &r, start, end)) {
	token = TA_AddElement(o, TRK_CHAR_ATTR, &c);
	TU_StartChainIfUndoable(o, @StyleString);
	(void) TA_ModifyRun(o, TRK_CHAR_ATTR, r.VTR_start, r.VTR_end, NULL,
			    NULL, token);
	TU_EndChainIfUndoable(o);
	TA_RemoveElement(o, TRK_CHAR_ATTR, token);
    } else
	TA_SetSingleCharAttr(o, &c);
    ReflectChangeUpdateGeneric(o);
}

@extern method VisTextClass, MSG_VIS_TEXT_SET_CHAR_ATTR_BY_DEFAULT
{
    VisTextCharAttr a;

    TA_MapDefaultCharAttr(defCharAttrs, &a);
    SetCharAttr(oself, rangeStart, rangeEnd, &a);
}

@extern method VisTextClass, MSG_VIS_TEXT_SET_CHAR_ATTR
{
    SetCharAttr(oself, rangeStart, rangeEnd, attrs);
}

/* VisTextSetCharAttrByToken: an element of the array (CA_NULL_ELEMENT,
 * the base style: no style sheets yet) */
@extern method VisTextClass, MSG_VIS_TEXT_SET_CHAR_ATTR_BY_TOKEN
{
    VisTextRange r;

    if (!FixupRange(oself, &r, rangeStart, rangeEnd) ||
	token == CA_NULL_ELEMENT) {
	ReflectChangeUpdateGeneric(oself);
	return;
    }
    TU_StartChainIfUndoable(oself, @StyleString);
    (void) TA_ModifyRun(oself, TRK_CHAR_ATTR, r.VTR_start, r.VTR_end, NULL,
			NULL, token);
    TU_EndChainIfUndoable(oself);
    ReflectChangeUpdateGeneric(oself);
}

/* VisTextAddCharAttr: the element with a reference */
@extern method VisTextClass, MSG_VIS_TEXT_ADD_CHAR_ATTR
{
    VisTextCharAttr a = *attrs;

    return TA_AddElement(oself, TRK_CHAR_ATTR, &a);
}

@extern method VisTextClass, MSG_VIS_TEXT_REMOVE_CHAR_ATTR
{
    TA_RemoveElement(oself, TRK_CHAR_ATTR, attrToken);
}

/* DiffCharAttr: the fields in which two attributes differ marked */
void DiffCharAttr(const VisTextCharAttr *a, const VisTextCharAttr *b,
			 VisTextCharAttrDiffs *diffs)
{
    word d = diffs->VTCAD_diffs;

    if (a->VTCA_fontID != b->VTCA_fontID)
	d |= VTCAF_MULTIPLE_FONT_IDS;
    if (a->VTCA_pointSize.WBF_int != b->VTCA_pointSize.WBF_int ||
	a->VTCA_pointSize.WBF_frac != b->VTCA_pointSize.WBF_frac)
	d |= VTCAF_MULTIPLE_POINT_SIZES;
    if (memcmp(&a->VTCA_color, &b->VTCA_color, sizeof(ColorQuad)))
	d |= VTCAF_MULTIPLE_COLORS;
    if (a->VTCA_grayScreen != b->VTCA_grayScreen)
	d |= VTCAF_MULTIPLE_GRAY_SCREENS;
    if (memcmp(&a->VTCA_pattern, &b->VTCA_pattern, sizeof(GraphicPattern)))
	d |= VTCAF_MULTIPLE_PATTERNS;
    if (a->VTCA_trackKerning != b->VTCA_trackKerning)
	d |= VTCAF_MULTIPLE_TRACK_KERNINGS;
    if (a->VTCA_fontWeight != b->VTCA_fontWeight)
	d |= VTCAF_MULTIPLE_FONT_WEIGHTS;
    if (a->VTCA_fontWidth != b->VTCA_fontWidth)
	d |= VTCAF_MULTIPLE_FONT_WIDTHS;
    if (memcmp(&a->VTCA_bgColor, &b->VTCA_bgColor, sizeof(ColorQuad)))
	d |= VTCAF_MULTIPLE_BG_COLORS;
    if (a->VTCA_bgGrayScreen != b->VTCA_bgGrayScreen)
	d |= VTCAF_MULTIPLE_BG_GRAY_SCREENS;
    if (memcmp(&a->VTCA_bgPattern, &b->VTCA_bgPattern,
	       sizeof(GraphicPattern)))
	d |= VTCAF_MULTIPLE_BG_PATTERNS;
    if (a->VTCA_meta.SSEH_style != b->VTCA_meta.SSEH_style)
	d |= VTCAF_MULTIPLE_STYLES;
    diffs->VTCAD_diffs = d;
    diffs->VTCAD_textStyles |= a->VTCA_textStyles ^ b->VTCA_textStyles;
    diffs->VTCAD_extendedStyles |=
	a->VTCA_extendedStyles ^ b->VTCA_extendedStyles;
}

/*
 * VisTextGetCharAttr: the attribute of the range (of its start; at a
 * cursor the one typing would get); with several runs in the range the
 * differences of theirs marked and CA_NULL_ELEMENT returned, else the
 * run's token.  With VTGAF_MERGE_WITH_PASSED the passed attribute is
 * compared too.
 */
@extern method VisTextClass, MSG_VIS_TEXT_GET_CHAR_ATTR
{
    VisTextCharAttr a, e;
    VisTextRange r;
    word i, token;
    dword next;

    if (diffs && !(flags & VTGAF_MERGE_WITH_PASSED))
	memset(diffs, 0, sizeof(*diffs));
    if (!(pself->VTI_storageFlags & VTSF_MULTIPLE_CHAR_ATTRS)) {
	TA_GetSingleCharAttr(oself, &a);
	if ((flags & VTGAF_MERGE_WITH_PASSED) && diffs)
	    DiffCharAttr(&a, attrs, diffs);
	*attrs = a;
	return CA_NULL_ELEMENT;
    }
    r.VTR_start = rangeStart;
    r.VTR_end = rangeEnd;
    TA_GetTextRange(oself, &r, 0);
    if (r.VTR_start == r.VTR_end) {
	/* a cursor: the insertion element, else the attribute typing
	 * would get */
	token = (word) -1;
	{
	    word *w = ObjVarFindData(oself,
				     ATTR_VIS_TEXT_CHAR_ATTR_INSERTION_TOKEN);
	    if (w)
		token = *w;
	}
	if (token == (word) -1)
	    i = TA_RunForPosition(oself, TRK_CHAR_ATTR, r.VTR_start,
				  !TSL_IsParagraphStart(oself, r.VTR_start) &&
				  TS_GetTextSize(oself) != r.VTR_start);
    } else {
	/* a range: the run to the right of its start */
	token = (word) -1;
	i = TA_RunForPosition(oself, TRK_CHAR_ATTR, r.VTR_start, FALSE);
    }
    if (token != (word) -1)
	next = TEXT_ADDRESS_PAST_END;
    else {
	token = TA_RunToken(oself, TRK_CHAR_ATTR, i);
	next = TA_RunPosition(oself, TRK_CHAR_ATTR, i + 1);
    }
    TA_GetElement(oself, TRK_CHAR_ATTR, token, &a);
    if (r.VTR_start == r.VTR_end || next >= r.VTR_end) {
	if ((flags & VTGAF_MERGE_WITH_PASSED) && diffs)
	    DiffCharAttr(&a, attrs, diffs);
	*attrs = a;
	return token;
    }
    /* EnumRunsInRange with GetCharAttrCallback */
    i = TA_RunForPosition(oself, TRK_CHAR_ATTR, r.VTR_start, FALSE);
    while (TA_RunPosition(oself, TRK_CHAR_ATTR, i) < r.VTR_end &&
	   TA_RunToken(oself, TRK_CHAR_ATTR, i) != CA_NULL_ELEMENT) {
	TA_GetElement(oself, TRK_CHAR_ATTR,
		      TA_RunToken(oself, TRK_CHAR_ATTR, i), &e);
	if (diffs)
	    DiffCharAttr(&e, &a, diffs);
	i++;
    }
    *attrs = a;
    return CA_NULL_ELEMENT;
}

/*
 * CharAttrChangeCommon: one field of the attribute changed by the
 * callback, in the range (with runs) or the object's single attribute
 */
void CharAttrChangeCommon(optr o, dword start, dword end,
			   TA_ModifyCallback *cb, void *data)
{
    VisTextCharAttr a;
    VisTextRange r;

    if (FixupRange(o, &r, start, end)) {
	TU_StartChainIfUndoable(o, @StyleString);
	(void) TA_ModifyRun(o, TRK_CHAR_ATTR, r.VTR_start, r.VTR_end, cb,
			    data, CA_NULL_ELEMENT);
	TU_EndChainIfUndoable(o);
    } else {
	TA_GetSingleCharAttr(o, &a);
	cb(o, &a, data);
	TA_SetSingleCharAttr(o, &a);
    }
    ReflectChangeUpdateGeneric(o);
}

/* UnHiliteAndFixupParaAttrRange: the range of a change, whole
 * paragraphs; FALSE if the object has a single attribute */
Boolean UnHiliteAndFixupParaAttrRange(optr o, VisTextRange *r, dword start,
			      dword end)
{
    Boolean multiple =
	(VT(o)->VTI_storageFlags & VTSF_MULTIPLE_PARA_ATTRS) != 0;

    r->VTR_start = start;
    r->VTR_end = end;
    if (multiple)
	TA_GetTextRange(o, r, VTRC_PARAGRAPH_CHANGE);
    TextGStateCreate(o);
    EditUnHilite(o);
    return multiple;
}
