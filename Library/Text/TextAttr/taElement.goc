/*
 * taElement.goc -- after taElement.asm: GetInsertionElement,
 * ClearInsertionElement, SetInsertionElement, TA_GetElement,
 * TA_AddElement, TA_ElementAddRef, TA_RemoveElement.
 */
@include "textInt.goh"
#include <chunkarr.h>
#include <hugearr.h>
#include <char.h>

/* GetInsertionElement */
word GetInsertionElement(optr o)
{
    word *w = ObjVarFindData(o, ATTR_VIS_TEXT_CHAR_ATTR_INSERTION_TOKEN);

    return w ? *w : CA_NULL_ELEMENT;
}

/* ClearInsertionElement: the token (CA_NULL_ELEMENT if none), its
 * reference removed if `unref' */
word ClearInsertionElement(optr o, Boolean unref)
{
    word token = GetInsertionElement(o);

    if (token == CA_NULL_ELEMENT)
	return token;
    (void) ObjVarDeleteData(o, ATTR_VIS_TEXT_CHAR_ATTR_INSERTION_TOKEN);
    if (unref)
	TA_RemoveElement(o, TRK_CHAR_ATTR, token);
    return token;
}

/* SetInsertionElement: with a reference */
void SetInsertionElement(optr o, word token)
{
    word *w;

    (void) ClearInsertionElement(o, TRUE);
    w = ObjVarAddData(o, ATTR_VIS_TEXT_CHAR_ATTR_INSERTION_TOKEN,
		      sizeof(word));
    *w = token;
    TA_ElementAddRef(o, TRK_CHAR_ATTR, token);
}

/*
 * ElementArrayLock: the element array of runs: a chunk of the object's
 * block, or VM_ELEMENT_ARRAY_CHUNK of an LMem VM block of the runs'
 * file (TRAH_elementVMBlock of small runs, TLRAH_elementVMBlock of a
 * huge array); *vm the block to give back (ElementArrayUnlock)
 */
static optr ElementArrayLock(const TextRuns *r, MemHandle *vm)
{
    VMBlockHandle b;

    *vm = 0;
    if (r->TR_block) {
	TextLargeRunArrayHeader *h;

	HugeArrayLockDir(r->TR_file, r->TR_block, (void **) &h);
	b = h->TLRAH_elementVMBlock;
	HugeArrayUnlockDir(h);
    } else {
	TextRunArrayHeader *h = LMemDeref(r->TR_chunk);

	b = h->TRAH_elementVMBlock;
	if (!b)
	    return ConstructOptr(OptrToHandle(r->TR_chunk),
				 h->TRAH_elementArray);
    }
    (void) VMLock(r->TR_file, b, vm);
    return ConstructOptr(*vm, VM_ELEMENT_ARRAY_CHUNK);
}

static void ElementArrayUnlock(MemHandle vm, Boolean dirty)
{
    if (!vm)
	return;
    if (dirty)
	VMDirty(vm);
    VMUnlock(vm);
}

/* ---------------------------------------------------------------------
 * Elements (taElement.asm)
 * ------------------------------------------------------------------- */

static word ElementSize(TextRunKind kind)
{
    return kind == TRK_CHAR_ATTR ? sizeof(VisTextCharAttr)
				 : sizeof(VisTextMaxParaAttr);
}

/* GetElement */
void TA_RunsGetElement(const TextRuns *r, TextRunKind kind, word token,
		       void *buf)
{
    MemHandle vm;
    word size;
    void *e = ChunkArrayElementToPtr(ElementArrayLock(r, &vm), token, &size);

    memset(buf, 0, ElementSize(kind));
    memcpy(buf, e, size);
    ElementArrayUnlock(vm, FALSE);
}

/* AddElement: the element's token, with a reference more */
word TA_RunsAddElement(const TextRuns *r, TextRunKind kind, void *element)
{
    MemHandle vm;
    optr a = ElementArrayLock(r, &vm);
    word t;

    if (kind == TRK_PARA_ATTR)
	t = ElementArrayAddElementSized(a, element, TA_ParaAttrSize(element),
					0, NULL);
    else
	t = ElementArrayAddElement(a, element, 0, NULL);
    ElementArrayUnlock(vm, TRUE);
    return t;
}

/* ElementAddRef */
void TA_RunsElementAddRef(const TextRuns *r, word token)
{
    MemHandle vm;

    ElementArrayAddReference(ElementArrayLock(r, &vm), token);
    ElementArrayUnlock(vm, TRUE);
}

/* RemoveElement */
void TA_RunsRemoveElement(const TextRuns *r, word token)
{
    MemHandle vm;

    ElementArrayRemoveReference(ElementArrayLock(r, &vm), token, 0, NULL);
    ElementArrayUnlock(vm, TRUE);
}

/* (the object's elements of a kind) */
void TA_GetElement(optr o, TextRunKind kind, word token, void *buf)
{
    TextRuns r;

    TA_RunsOf(o, kind, &r);
    TA_RunsGetElement(&r, kind, token, buf);
}

word TA_AddElement(optr o, TextRunKind kind, void *element)
{
    TextRuns r;

    TA_RunsOf(o, kind, &r);
    return TA_RunsAddElement(&r, kind, element);
}

void TA_ElementAddRef(optr o, TextRunKind kind, word token)
{
    TextRuns r;

    TA_RunsOf(o, kind, &r);
    TA_RunsElementAddRef(&r, token);
}

void TA_RemoveElement(optr o, TextRunKind kind, word token)
{
    TextRuns r;

    TA_RunsOf(o, kind, &r);
    TA_RunsRemoveElement(&r, token);
}
