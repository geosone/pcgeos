/*
 * taRunManip.goc -- after taRunManip.asm:
 * TA_UpdateRunsForSelectionChange, CoalesceRun,
 * TA_UpdateRunsForReplacement, TA_ModifyRun (ModifyRun, with its undo
 * actions), the runs of undo actions (TA_AppendRunsInRangeToHugeArray,
 * TA_RestoreRunsFromHugeArray, TA_DeleteRunsInRange,
 * TA_DecrementRefCountsFromHugeArray).
 */
@include "textInt.goh"
@include <Objects/styles.goh>
#include <chunkarr.h>
#include <char.h>
#include <hugearr.h>

static dword ModifyRunWithoutUndo(optr o, TextRunKind kind, dword start,
				  dword end, TA_ModifyCallback *cb,
				  void *data, word token);

/* TA_UpdateRunsForSelectionChange: a new selection drops the insertion
 * token */
void TA_UpdateRunsForSelectionChange(optr o)
{
    if (VT(o)->VTI_storageFlags & VTSF_MULTIPLE_CHAR_ATTRS)
	(void) ClearInsertionElement(o, TRUE);
}

/* ---------------------------------------------------------------------
 * Coalescing and changing (taRunManip.asm)
 * ------------------------------------------------------------------- */

/* CoalesceRun: runs with the token of the one before, and the first of
 * two at the same position, removed; the position of the last real run */
dword CoalesceRun(optr o, TextRunKind kind)
{
    word i = 0, lastToken;
    dword lastPos, pos;

    lastToken = TA_RunToken(o, kind, 0);
    lastPos = TA_RunPosition(o, kind, 0);
    for (i = 1; ; ) {
	pos = TA_RunPosition(o, kind, i);
	if (TA_RunAtEnd(pos))
	    break;
	if (TA_RunToken(o, kind, i) == lastToken) {
	    TA_RemoveElement(o, kind, lastToken);
	    RunArrayDelete(o, kind, i);
	    continue;
	}
	if (pos == lastPos) {
	    TA_RemoveElement(o, kind, TA_RunToken(o, kind, i - 1));
	    RunArrayDelete(o, kind, i - 1);
	    if (i > 1) {
		i--;
		lastToken = TA_RunToken(o, kind, i - 1);
		lastPos = TA_RunPosition(o, kind, i - 1);
	    } else {
		lastToken = TA_RunToken(o, kind, 0);
		lastPos = TA_RunPosition(o, kind, 0);
		i = 1;
	    }
	    continue;
	}
	lastToken = TA_RunToken(o, kind, i);
	lastPos = pos;
	i++;
    }
    return lastPos;
}
/*
 * DoUpdateRunUndo: the undo actions for the runs a replacement changes.
 * A replacement that undoes one adds none unless it deletes (the runs
 * of the deleted text would be lost).  Other runs than paragraph ones
 * are kept only if one starts in the range before its end (then up to
 * its end); paragraph runs up to the next paragraph's start (a run at
 * the end may go with the carriage return).  An insertion keeps none,
 * but for an insertion token.
 */
static void DoUpdateRunUndo(optr o, TextRunKind kind,
			    const VisTextReplaceParameters *rp)
{
    VisTextRange r = rp->VTRP_range;
    Boolean any;

    if (!(VT(o)->VTI_features & VTF_ALLOW_UNDO))
	return;
    if (r.VTR_end == r.VTR_start) {
	/* inserting */
	if (GenProcessUndoCheckIfIgnoring() || kind == TRK_PARA_ATTR ||
	    GetInsertionElement(o) == CA_NULL_ELEMENT)
	    return;
	TU_CreateUndoForRunModification(o, kind, &r);
	return;
    }
    if (rp->VTRP_insCount && (rp->VTRP_flags & VTRF_UNDO))
	return;
    if (kind == TRK_PARA_ATTR) {
	dword end, size;

	if (!CheckIfRunsInRangeForUndo(o, kind, &r))
	    return;
	end = r.VTR_end;
	(void) TSL_FindParagraphEnd(o, &end);
	end++;
	size = TS_GetTextSize(o);
	r.VTR_end = end > size ? size : end;
    } else {
	r.VTR_end--;
	any = CheckIfRunsInRangeForUndo(o, kind, &r);
	r.VTR_end++;
	if (!any)
	    return;
    }
    TU_CreateUndoForRunsInRange(o, kind, &r);
    TU_CreateUndoForRunModification(o, kind, &r);
}

/*
 * UpdateRun: the runs of a kind moved for the replacement of the range
 * by insCount characters (the text not yet replaced).  TRUE if the
 * attributes the UI shows may have changed.
 */
static Boolean UpdateRun(optr o, TextRunKind kind,
			 const VisTextReplaceParameters *rp, Boolean middle)
{
    Boolean para = kind == TRK_PARA_ATTR, updateUI = FALSE,
	    coalesce = FALSE, atEnd;
    dword rStart = rp->VTRP_range.VTR_start, rEnd = rp->VTRP_range.VTR_end;
    dword ins = rp->VTRP_insCount, del = rEnd - rStart;
    dword runPos, nextPos, p;
    word i, insToken = CA_NULL_ELEMENT;

    DoUpdateRunUndo(o, kind, rp);
    /* a replacement takes the attribute of the replaced text */
    if (ins && del && !para) {
	updateUI = TRUE;
	insToken = TA_RunToken(o, kind,
			       TA_RunForPosition(o, kind, rStart, FALSE));
	SetInsertionElement(o, insToken);
    }
    i = TA_RunForPosition(o, kind, rStart, TRUE);
    if (rStart && i)
	i--;
    for (;;) {
	runPos = TA_RunPosition(o, kind, i);
	/* case 0: the last run */
	if (TA_RunAtEnd(runPos))
	    break;
	nextPos = TA_RunPosition(o, kind, i + 1);
	/* case -1: the only run stays */
	if (runPos == 0 && TA_RunAtEnd(nextPos))
	    break;
	/* case 1: the run ends before the range */
	if (nextPos <= rStart) {
	    i++;
	    continue;
	}
	/* case 2: the run is after the range */
	if (runPos >= rEnd) {
	    if (runPos == rEnd) {
		/* the run starts where the range ends */
		if (para) {
		    if (!del) {
			i++;
			continue;
		    }
		    goto extendToNextParagraph;
		}
		if (del) {
		    /* the carriage return after a deletion joins the
		     * run before */
		    if (TSL_IsParagraphEnd(o, runPos, &atEnd)) {
			if (atEnd)
			    goto doDelete;
			TA_SetRunPos(o, kind, i, runPos + 1);
			runPos++;
			nextPos = TA_RunPosition(o, kind, i + 1);
		    }
		}
		if (TSL_IsParagraphStart(o, rEnd))
		    updateUI = TRUE;
		if (TSL_IsParagraphStart(o, rStart)) {
		    /* at a paragraph's start the insertion does not move
		     * the run, the deletion does */
		    if (del) {
			coalesce = TRUE;
			TA_SetRunPos(o, kind, i, runPos - del);
		    }
		    i++;
		    continue;
		}
	    }
	    if (runPos == 0) {
		i++;
		continue;
	    }
	    if (del)
		coalesce = TRUE;
	    TA_SetRunPos(o, kind, i, runPos - del + ins);
	    i++;
	    continue;
	}
	/* the run starts before the range: not ours */
	if (runPos < rStart) {
	    i++;
	    continue;
	}
	/* the run starts at the range and goes on past it: kept (unless
	 * only its carriage return is left after it) */
	if (runPos == rStart && middle && nextPos > rEnd) {
	    if (nextPos - 1 != rEnd)
		goto case4;
	    if (para) {
		i++;
		continue;
	    }
	    if (!TSL_IsParagraphEnd(o, rEnd, &atEnd) ||
		TSL_IsParagraphStart(o, rStart)) {
		i++;
		continue;
	    }
	    goto doDelete;
	}
	/* case 3: the run is in the range */
	updateUI = TRUE;
	if (!middle) {
	    /* deleting at the end: the last paragraph attribute, and a
	     * character attribute at a paragraph's start, stay if they
	     * are not all deleted */
	    if (para || TSL_IsParagraphStart(o, rStart)) {
		if (TA_RunAtEnd(nextPos) && runPos <= rStart) {
		    i++;
		    continue;
		}
	    }
	    goto doDelete;
	}
	if (nextPos <= rEnd)
	    goto doDelete;
case4:
	/* case 4: the run goes on past the range's end */
	if (rStart == 0) {
	    i++;
	    continue;
	}
	if (para)
	    goto extendToNextParagraph;
	TA_SetRunPos(o, kind, i, rStart + ins);
	i++;
	continue;

extendToNextParagraph:
	/* the paragraph run starts with the next paragraph after the
	 * range */
	updateUI = TRUE;
	if (TSL_IsParagraphStart(o, rStart))
	    p = rEnd;
	else {
	    p = rEnd;
	    if (TSL_FindParagraphEnd(o, &p))
		p++;
	    else
		p = TEXT_ADDRESS_PAST_END;
	}
	if (TA_RunAtEnd(p))
	    goto doDelete;
	TA_SetRunPos(o, kind, i, p);
	if (p == nextPos)
	    goto doDelete;
	p -= del;
	if (p != rStart)
	    p += ins;
	TA_SetRunPos(o, kind, i, p);
	i++;
	continue;

doDelete:
	TA_RemoveElement(o, kind, TA_RunToken(o, kind, i));
	RunArrayDelete(o, kind, i);
	if (runPos == 0)
	    TA_SetRunPos(o, kind, i, 0);
	coalesce = updateUI = TRUE;
    }
    if (coalesce)
	(void) CoalesceRun(o, kind);
    if (para)
	return updateUI && del;
    /* the insertion token for the inserted text */
    insToken = ClearInsertionElement(o, FALSE);
    if (insToken != CA_NULL_ELEMENT) {
	if (ins) {
	    dword s = rStart, e;
	    Boolean eot;

	    /* (a change at a paragraph's end takes its CR too) */
	    if (TSL_IsParagraphEnd(o, s, &eot) && !eot)
		s++;
	    e = middle ? s + ins : TEXT_ADDRESS_PAST_END;
	    (void) ModifyRunWithoutUndo(o, kind, rStart, e, NULL, NULL,
					insToken);
	} else
	    updateUI = TRUE;
	TA_RemoveElement(o, kind, insToken);
    }
    return updateUI && del;
}

/* TA_UpdateRunsForReplacement: TRUE if the attributes shown may have
 * changed */
Boolean TA_UpdateRunsForReplacement(optr o,
				    const VisTextReplaceParameters *p)
{
    VisTextStorageFlags f = VT(o)->VTI_storageFlags;
    Boolean middle = TS_GetTextSize(o) != p->VTRP_range.VTR_end,
	    changed = FALSE;

    if (f & VTSF_MULTIPLE_CHAR_ATTRS)
	changed |= UpdateRun(o, TRK_CHAR_ATTR, p, middle);
    if (f & VTSF_MULTIPLE_PARA_ATTRS)
	changed |= UpdateRun(o, TRK_PARA_ATTR, p, middle);
    return changed;
}

static void SetToken(optr o, TextRunKind kind, word i, word token)
{
    TA_SetRunToken(o, kind, i, token);
}
/* MR_ModifyElementLow: the element changed by the callback (or
 * replaced by `token'), the old reference given up; the new token */
static word ModifyElement(optr o, TextRunKind kind, word old,
			  TA_ModifyCallback *cb, void *data, word token)
{
    VisTextMaxParaAttr buf;
    word t;

    TA_GetElement(o, kind, old, &buf);
    TA_RemoveElement(o, kind, old);
    if (cb) {
	cb(o, &buf, data);
	return TA_AddElement(o, kind, &buf);
    }
    /* CA_NULL_ELEMENT: back to the element of the style (if any) */
    if (token == CA_NULL_ELEMENT) {
	word style = ((StyleSheetElementHeader *) &buf)->SSEH_style;
	StyleChunkDesc d;

	if (style != CA_NULL_ELEMENT && GetStyleArray(o, &d)) {
	    Boolean flag;
	    optr a = StyleSheetLockStyleChunk(&d, &flag);
	    const TextStyleElementHeader *e =
		ChunkArrayElementToPtr(a, style, NULL);
	    word base = kind == TRK_CHAR_ATTR ? e->TSEH_charAttrToken :
			e->TSEH_paraAttrToken;

	    StyleSheetUnlockStyleChunk(a, flag);
	    TA_GetElement(o, kind, base, &buf);
	}
	return TA_AddElement(o, kind, &buf);
    }
    t = token;
    TA_ElementAddRef(o, kind, t);
    return t;
}

/*
 * ModifyRunWithoutUndo: the attribute of a range changed by the
 * callback (or set to the element `token'); at a cursor (an empty range
 * inside the text) the character attribute becomes the insertion token
 * instead.  The position of the last real run, or 0xffffffff for an
 * insertion token.
 */
static dword ModifyRunWithoutUndo(optr o, TextRunKind kind, dword start,
				  dword end, TA_ModifyCallback *cb,
				  void *data, word token)
{
    dword size = TS_GetTextSize(o), p;
    word i, endToken, ins;

    if (start == end && kind == TRK_CHAR_ATTR && size != start) {
	if (!cb && token != CA_NULL_ELEMENT) {
	    SetInsertionElement(o, token);
	    return 0xffffffff;
	}
	ins = GetInsertionElement(o);
	if (ins == CA_NULL_ELEMENT) {
	    /* at a paragraph's start the attribute to the right, else the
	     * one to the left */
	    i = TA_RunForPosition(o, kind, start,
				  !TSL_IsParagraphStart(o, start));
	    ins = TA_RunToken(o, kind, i);
	}
	TA_ElementAddRef(o, kind, ins);
	ins = ModifyElement(o, kind, ins, cb, data, token);
	SetInsertionElement(o, ins);
	TA_RemoveElement(o, kind, ins);
	return 0xffffffff;
    }
    /* the attribute at the end, kept for the text after the range */
    endToken = TA_RunToken(o, kind, TA_RunForPosition(o, kind, end, FALSE));
    TA_ElementAddRef(o, kind, endToken);
    i = TA_RunForPosition(o, kind, start, FALSE);
    if (TA_RunPosition(o, kind, i) != start) {
	/* a run where the change starts */
	TA_RunInsert(o, kind, i, TA_RunPosition(o, kind, i),
		  TA_RunToken(o, kind, i));
	i++;
	TA_SetRunPos(o, kind, i, start);
	/* (the inserted run holds a reference too) */
	TA_ElementAddRef(o, kind, TA_RunToken(o, kind, i));
    }
    for (;;) {
	SetToken(o, kind, i,
		 ModifyElement(o, kind, TA_RunToken(o, kind, i), cb, data,
			       token));
	i++;
	p = TA_RunPosition(o, kind, i);
	if (p >= end)
	    break;
    }
    if (p != end && !(TA_RunAtEnd(p) && end == size)) {
	/* a run where it ends, so that the text after keeps its
	 * attribute */
	TA_RunInsert(o, kind, i, end, endToken);
	TA_ElementAddRef(o, kind, endToken);
    }
    TA_RemoveElement(o, kind, endToken);
    return CoalesceRun(o, kind);
}

/*
 * ModifyRun: ModifyRunWithoutUndo with the undo actions: the runs of the
 * range kept, and the range to clear of runs when undone.  Setting the
 * insertion token can't be undone (the chain aborted).
 */
dword TA_ModifyRun(optr o, TextRunKind kind, dword start, dword end,
		   TA_ModifyCallback *cb, void *data, word token)
{
    VisTextRange r;
    dword last;

    if (start == end && kind != TRK_PARA_ATTR) {
	TU_AbortChainIfUndoable(o);
	return ModifyRunWithoutUndo(o, kind, start, end, cb, data, token);
    }
    r.VTR_start = start;
    r.VTR_end = end;
    if (CheckIfRunsInRangeForUndo(o, kind, &r))
	TU_CreateUndoForRunsInRange(o, kind, &r);
    last = ModifyRunWithoutUndo(o, kind, start, end, cb, data, token);
    if (CheckIfRunsInRangeForUndo(o, kind, &r))
	TU_CreateUndoForRunModification(o, kind, &r);
    return last;
}

/* ---------------------------------------------------------------------
 * The runs of undo actions
 * ------------------------------------------------------------------- */

static dword ElPos(const TextRunArrayElement *e)
{
    return (word) e->TRAE_position.WAAH_low |
	   ((dword) (byte) e->TRAE_position.WAAH_high << 16);
}

/*
 * CheckIfRunsInRangeForUndo: TRUE if the object makes undo actions and a
 * run starts in the range (its end included)
 */
Boolean CheckIfRunsInRangeForUndo(optr o, TextRunKind kind,
				  const VisTextRange *r)
{
    word i;
    dword p;

    if (!TU_CheckForUndo(o))
	return FALSE;
    for (i = TA_RunForPosition(o, kind, r->VTR_start, FALSE); ; i++) {
	p = TA_RunPosition(o, kind, i);
	if (TA_RunAtEnd(p))
	    return FALSE;
	if (p >= r->VTR_start)
	    return p <= r->VTR_end;
    }
}

/*
 * TA_AppendRunsInRangeToHugeArray: the runs starting in the range (its
 * end included) appended to the huge array, their elements referenced
 */
void TA_AppendRunsInRangeToHugeArray(optr o, TextRunKind kind,
				     const VisTextRange *r, VMFileHandle f,
				     VMBlockHandle ha)
{
    word i;
    dword p;
    TextRunArrayElement e;

    i = TA_RunForPosition(o, kind, r->VTR_start, FALSE);
    for (p = TA_RunPosition(o, kind, i); p <= r->VTR_end;
	 p = TA_RunPosition(o, kind, ++i)) {
	if (TA_RunAtEnd(p))
	    break;
	if (p < r->VTR_start)
	    continue;
	memset(&e, 0, sizeof(e));
	e.TRAE_position.WAAH_low = (sword) (word) p;
	e.TRAE_position.WAAH_high = (sbyte) (byte) (p >> 16);
	e.TRAE_token = TA_RunToken(o, kind, i);
	TA_ElementAddRef(o, kind, e.TRAE_token);
	(void) HugeArrayAppend(f, ha, 1, &e);
    }
}

/* TA_DecrementRefCountsFromHugeArray: the references of the saved runs
 * given up */
void TA_DecrementRefCountsFromHugeArray(optr o, TextRunKind kind,
					VMFileHandle f, VMBlockHandle ha)
{
    dword n = HugeArrayGetCount(f, ha), i;
    TextRunArrayElement *e;
    word size;

    for (i = 0; i < n; i++) {
	word token;

	(void) HugeArrayLock(f, ha, i, (void **) &e, &size);
	token = e->TRAE_token;
	HugeArrayUnlock(e);
	TA_RemoveElement(o, kind, token);
    }
}

/*
 * TA_DeleteRunsInRange: the runs starting in the range (its end
 * included) deleted (kept for the redo first)
 */
void TA_DeleteRunsInRange(optr o, TextRunKind kind, const VisTextRange *r)
{
    word i;
    dword p;

    if (!CheckIfRunsInRangeForUndo(o, kind, r))
	return;
    TU_CreateUndoForRunsInRange(o, kind, r);
    (void) ObjVarDeleteData(o, TEMP_VIS_TEXT_CACHED_RUN_INFO);
    i = TA_RunForPosition(o, kind, r->VTR_start, FALSE);
    for (;;) {
	p = TA_RunPosition(o, kind, i);
	if (p < r->VTR_start) {
	    i++;
	    continue;
	}
	if (p > r->VTR_end || TA_RunAtEnd(p))
	    break;
	TA_RemoveElement(o, kind, TA_RunToken(o, kind, i));
	RunArrayDelete(o, kind, i);
    }
    TextGStateCreate(o);
    ReflectChange(o);
}

/*
 * TA_RestoreRunsFromHugeArray: the saved runs put back (the redo action
 * clears their range again)
 */
void TA_RestoreRunsFromHugeArray(optr o, TextRunKind kind, VMFileHandle f,
				 VMBlockHandle ha)
{
    dword n = HugeArrayGetCount(f, ha), k;
    TextRunArrayElement *e;
    VisTextRange r;
    word i, size;

    EC_ERROR_IF(!n, -1);
    if (!n)
	return;
    (void) HugeArrayLock(f, ha, 0, (void **) &e, &size);
    r.VTR_start = ElPos(e);
    HugeArrayUnlock(e);
    /* before the run after the first one restored (the run there may
     * be gone) */
    i = TA_RunForPosition(o, kind, r.VTR_start, FALSE);
    if (TA_RunPosition(o, kind, i) <= r.VTR_start)
	i++;
    for (k = 0; k < n; k++, i++) {
	dword pos;
	word token;

	(void) HugeArrayLock(f, ha, k, (void **) &e, &size);
	pos = ElPos(e);
	token = e->TRAE_token;
	HugeArrayUnlock(e);
	TA_RunInsert(o, kind, i, pos, token);
	TA_ElementAddRef(o, kind, token);
	r.VTR_end = pos;
    }
    (void) CoalesceRun(o, kind);
    TU_CreateUndoForRunModification(o, kind, &r);
    TextGStateCreate(o);
    ReflectChange(o);
}
