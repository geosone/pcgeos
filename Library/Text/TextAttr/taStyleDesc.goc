static const SSDiffEntry PADiffTable[] = {
    { PAD_OFF(VTPAD_attributes), VTPAA_JUSTIFICATION, DescJustification, 0 },
    { PAD_OFF(VTPAD_diffs), VTPAF_MULTIPLE_LEFT_MARGINS, DescLeftMargin,
      NEW_CAT },
    { PAD_OFF(VTPAD_diffs), VTPAF_MULTIPLE_PARA_MARGINS, DescParaMargin,
      NEW_CAT },
    { PAD_OFF(VTPAD_diffs), VTPAF_MULTIPLE_RIGHT_MARGINS, DescRightMargin,
      NEW_CAT },
    { PAD_OFF(VTPAD_diffs),
      VTPAF_MULTIPLE_LINE_SPACINGS | VTPAF_MULTIPLE_LEADINGS,
      DescLineSpacingAndLeading, NEW_CAT },
    { PAD_OFF(VTPAD_diffs), VTPAF_MULTIPLE_TOP_SPACING, DescTopSpacing,
      NEW_CAT },
    { PAD_OFF(VTPAD_diffs), VTPAF_MULTIPLE_BOTTOM_SPACING, DescBottomSpacing,
      NEW_CAT },
    { PAD_OFF(VTPAD_diffs), VTPAF_MULTIPLE_DEFAULT_TABS, DescDefaultTabs,
      NEW_CAT },
    { PAD_OFF(VTPAD_diffs), VTPAF_MULTIPLE_BG_COLORS, DescParaBGColor,
      NEW_CAT },
    { PAD_OFF(VTPAD_diffs), VTPAF_MULTIPLE_BG_GRAY_SCREENS,
      DescParaBGGrayScreen, 0 },
    { PAD_OFF(VTPAD_diffs), VTPAF_MULTIPLE_BG_PATTERNS, DescParaBGPattern,
      0 },
    { PAD_OFF(VTPAD_diffs), VTPAF_MULTIPLE_TAB_LISTS, DescTabList, NEW_CAT },
    { PAD_OFF(VTPAD_borderDiffs),
      VTPABF_MULTIPLE_BORDER_LEFT | VTPABF_MULTIPLE_BORDER_TOP |
      VTPABF_MULTIPLE_BORDER_RIGHT | VTPABF_MULTIPLE_BORDER_BOTTOM |
      VTPABF_MULTIPLE_BORDER_DOUBLES | VTPABF_MULTIPLE_BORDER_DRAW_INNERS |
      VTPABF_MULTIPLE_BORDER_ANCHORS | VTPABF_MULTIPLE_BORDER_SHADOWS,
      DescBorder, NEW_CAT },
    { PAD_OFF(VTPAD_borderDiffs), VTPABF_MULTIPLE_BORDER_WIDTHS,
      DescBorderWidth, NEW_CAT },
    { PAD_OFF(VTPAD_borderDiffs), VTPABF_MULTIPLE_BORDER_SPACINGS,
      DescBorderSpacing, NEW_CAT },
    { PAD_OFF(VTPAD_borderDiffs), VTPABF_MULTIPLE_BORDER_COLORS,
      DescBorderColor, NEW_CAT },
    { PAD_OFF(VTPAD_borderDiffs), VTPABF_MULTIPLE_BORDER_GRAY_SCREENS,
      DescBorderGrayScreen, 0 },
    { PAD_OFF(VTPAD_borderDiffs), VTPABF_MULTIPLE_BORDER_PATTERNS,
      DescBorderPattern, 0 },
    { PAD_OFF(VTPAD_attributes), VTPAA_DISABLE_WORD_WRAP,
      DescDisableWordWrap, NEW_CAT },
    { PAD_OFF(VTPAD_attributes), VTPAA_COLUMN_BREAK_BEFORE,
      DescColumnBreakBefore, NEW_CAT },
    { PAD_OFF(VTPAD_attributes), VTPAA_KEEP_PARA_WITH_NEXT,
      DescKeepParaWithNext, NEW_CAT },
    { PAD_OFF(VTPAD_attributes), VTPAA_KEEP_PARA_TOGETHER,
      DescKeepParaTogether, NEW_CAT },
    { PAD_OFF(VTPAD_attributes), VTPAA_ALLOW_AUTO_HYPHENATION,
      DescAutoHyphenation, NEW_CAT },
    { PAD_OFF(VTPAD_hyphenationInfo), VTHI_HYPHEN_MAX_LINES,
      DescHyphenationMaxLines, NEW_CAT },
    { PAD_OFF(VTPAD_hyphenationInfo), VTHI_HYPHEN_SHORTEST_WORD,
      DescHyphenationShortestWord, NEW_CAT },
    { PAD_OFF(VTPAD_hyphenationInfo), VTHI_HYPHEN_SHORTEST_PREFIX,
      DescHyphenationShortestPrefix, NEW_CAT },
    { PAD_OFF(VTPAD_hyphenationInfo), VTHI_HYPHEN_SHORTEST_SUFFIX,
      DescHyphenationShortestSuffix, NEW_CAT },
    { PAD_OFF(VTPAD_attributes), VTPAA_KEEP_LINES, DescKeepLines, NEW_CAT },
    { PAD_OFF(VTPAD_keepInfo), VTKI_TOP_LINES, DescKeepTop, NEW_CAT },
    { PAD_OFF(VTPAD_keepInfo), VTKI_BOTTOM_LINES, DescKeepBottom, NEW_CAT },
};

/*
 * DescribeParaAttr: the description callback of paragraph attributes:
 * "Paragraph:" and what differs from the base (no base: from the
 * default attribute, the justification always)
 */
void DescribeParaAttr(TCHAR **ptr, word *left, word used,
		      const void *derived, const void *base, optr extraUI,
		      dword privateData, word attrsFlag)
{
    VisTextParaAttrDiffs diffs;

    (void) extraUI; (void) attrsFlag;
    memset(&diffs, 0, sizeof(diffs));
    if (!base)
	diffs.VTPAD_attributes = VTPAA_JUSTIFICATION;
    DiffParaAttr(derived, base ? base : &TS_defaultParaAttr, &diffs);
    diffs.VTPAD_diffs &= ~VTPAF_MULTIPLE_STYLES;
    if (AllZero(&diffs, sizeof(diffs)))
	return;
    StyleSheetAddAttributeHeader(used != 0, @ParagraphString, ptr, left);
    StyleSheetCallDescribeRoutines(PADiffTable, COUNT(PADiffTable), ptr, left,
				   derived, base, &diffs,
				   (word) privateData);
}
