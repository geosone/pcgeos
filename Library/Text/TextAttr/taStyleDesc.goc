/* the block of the strings (TextStyleStrings) */
#define STRINGS		OptrToHandle(@CharacterString)
#define COUNT(t)	((word) (sizeof(t) / sizeof((t)[0])))

/* (the asm's OurAddName and AddSpace) */
static void AddName(optr name, TCHAR **ptr, word *left)
{
    StyleSheetAddNameFromChunk(name, ptr, left);
}

static void AddSpace(TCHAR **ptr, word *left)
{
    StyleSheetAddCharToDescription(' ', ptr, left);
}

/* the default attributes: what a style without a base style is
 * described (and merged) against */
const VisTextCharAttr TS_defaultCharAttr = {
    .VTCA_meta = { .SSEH_style = 0 },
    .VTCA_fontID = FID_DTC_URW_ROMAN,
    .VTCA_pointSize = { 0, 12 },
    .VTCA_color = { C_BLACK, CF_INDEX, 0, 0 },
    .VTCA_fontWeight = FW_NORMAL,
    .VTCA_fontWidth = FWI_MEDIUM,
    .VTCA_grayScreen = SDM_100,
    .VTCA_bgColor = { C_WHITE, CF_INDEX, 0, 0 },
    .VTCA_bgGrayScreen = SDM_0,
};

const VisTextMaxParaAttr TS_defaultParaAttr = {
    .VTMPA_paraAttr = {
	.VTPA_meta = { .SSEH_style = CA_NULL_ELEMENT },
	.VTPA_borderColor = { C_BLACK, CF_INDEX, 0, 0 },
	.VTPA_lineSpacing = 1 << 8,		/* 1.0 */
	.VTPA_bgColor = { C_WHITE, CF_INDEX, 0, 0 },
	.VTPA_borderWidth = 1 * 8,
	.VTPA_borderSpacing = 2 * 8,
	.VTPA_borderShadow = 1 * 8,
	.VTPA_borderGrayScreen = SDM_100,
	.VTPA_bgGrayScreen = SDM_0,
	.VTPA_defaultTabs = (PIXELS_PER_INCH * 8) / 2,
	.VTPA_startingParaNumber = VIS_TEXT_DEFAULT_STARTING_NUMBER,
    },
};

/*
 * DescribeTextStyle: the special description callback: the attribute
 * list of the box shows the style's flags; the flags in words but for
 * the attributes of the selection (the "Define New Style" box)
 */
void DescribeTextStyle(TCHAR **ptr, word *left, word used,
		       const void *derived, const void *base, optr extraUI,
		       dword privateData, word attrsFlag)
{
    static const struct { word flag; int which; } names[] = {
	{ TSF_APPLY_TO_SELECTION_ONLY, 0 }, { TSF_POINT_SIZE_RELATIVE, 1 },
	{ TSF_MARGINS_RELATIVE, 2 }, { TSF_SPACING_RELATIVE, 3 }
    };
    optr strings[4];
    word flags, i;
    Boolean sep = used != 0;

    (void) privateData;
    UpdateDescTextStyleAttributeList(extraUI, (void *) derived, base);
    if (attrsFlag)
	return;
    strings[0] = @CharacterOnlyString;
    strings[1] = @PointSizeRelativeString;
    strings[2] = @MarginsRelativeString;
    strings[3] = @LeadingRelativeString;
    flags = ((const TextStyleElementHeader *) derived)->
	TSEH_privateData.TSPD_flags;
    for (i = 0; i < COUNT(names); i++)
	if (flags & names[i].flag) {
	    StyleSheetAddAttributeHeader(sep, strings[names[i].which], ptr,
					 left);
	    sep = TRUE;
	}
}

/* ---- character attributes --------------------------------------- */

/* the font's name, or "Font=" and its number */
static void DescFont(TCHAR **ptr, word *left, const void *newAttrs,
		     const void *oldAttrs, const void *diffs, word data)
{
    char name[20 + 1];			/* FONT_NAME_LEN */
    FontID id = ((const VisTextCharAttr *) newAttrs)->VTCA_fontID;

    (void) oldAttrs; (void) diffs; (void) data;
    if (GrGetFontName(id, name))
	StyleSheetAddNameFromPtr(name, ptr, left);
    else {
	AddName(@UnknownFontString, ptr, left);
	StyleSheetAddWord(id, ptr, left);
    }
}

/* the point size; relative to the base style's if the style says so */
static void DescPointSize(TCHAR **ptr, word *left, const void *newAttrs,
			  const void *oldAttrs, const void *diffs, word data)
{
    const VisTextCharAttr *n = newAttrs, *o = oldAttrs;
    sdword v = ((sdword) n->VTCA_pointSize.WBF_int << 8) |
	       n->VTCA_pointSize.WBF_frac;
    SSDescribeDistanceFlags f = 0;

    (void) diffs;
    if ((data & TSF_POINT_SIZE_RELATIVE) && o) {
	v -= ((sdword) o->VTCA_pointSize.WBF_int << 8) |
	     o->VTCA_pointSize.WBF_frac;
	f = SSDDF_RELATIVE;
    }
    /* (8.8 to 13.3) */
    StyleSheetDescribeDistance(DU_POINTS, (sword) (v >> 5), f, 0, ptr, left);
}

/* the styles that differ (the bits of the diffs, as the asm) */
static void DescTextStyle(TCHAR **ptr, word *left, const void *newAttrs,
			  const void *oldAttrs, const void *diffs, word data)
{
    SSDescribeWordEntry t[] = {
	{ (word) (TS_UNDERLINE), OptrToChunk(@UnderlineString) },
	{ (word) (TS_OUTLINE), OptrToChunk(@OutlineString) },
	{ (word) (TS_BOLD), OptrToChunk(@BoldString) },
	{ (word) (TS_ITALIC), OptrToChunk(@ItalicString) },
	{ (word) (TS_STRIKE_THRU), OptrToChunk(@StrikeThruString) },
	{ (word) (TS_SUPERSCRIPT), OptrToChunk(@SuperscriptString) },
	{ (word) (TS_SUBSCRIPT), OptrToChunk(@SubscriptString) },
    };

    (void) newAttrs; (void) oldAttrs; (void) data;
    (void) StyleSheetDescribeNonExclusiveWord(
	((const VisTextCharAttrDiffs *) diffs)->VTCAD_textStyles, t,
	COUNT(t), STRINGS, ptr, left);
}

static void DescExtendedStyle(TCHAR **ptr, word *left, const void *newAttrs,
			      const void *oldAttrs, const void *diffs,
			      word data)
{
    SSDescribeWordEntry t[] = {
	{ (word) (VTES_BOXED), OptrToChunk(@BoxedString) },
	{ (word) (VTES_BUTTON), OptrToChunk(@ButtonString) },
	{ (word) (VTES_INDEX), OptrToChunk(@IndexString) },
	{ (word) (VTES_ALL_CAP), OptrToChunk(@AllCapString) },
	{ (word) (VTES_SMALL_CAP), OptrToChunk(@SmallCapString) },
	{ (word) (VTES_HIDDEN), OptrToChunk(@HiddenString) },
	{ (word) (VTES_CHANGE_BAR), OptrToChunk(@ChangeBarString) },
    };

    (void) newAttrs; (void) oldAttrs; (void) data;
    (void) StyleSheetDescribeNonExclusiveWord(
	((const VisTextCharAttrDiffs *) diffs)->VTCAD_extendedStyles, t,
	COUNT(t), STRINGS, ptr, left);
}

static void DescFontWeight(TCHAR **ptr, word *left, const void *newAttrs,
			   const void *oldAttrs, const void *diffs, word data)
{
    (void) oldAttrs; (void) diffs; (void) data;
    StyleSheetDescribeWWFixed(
	(WWFixedAsDWord) ((const VisTextCharAttr *) newAttrs)->VTCA_fontWeight
	<< 16, DESC_ALL_DIGITS, @FontWeightString, ptr, left);
}

static void DescFontWidth(TCHAR **ptr, word *left, const void *newAttrs,
			  const void *oldAttrs, const void *diffs, word data)
{
    (void) oldAttrs; (void) diffs; (void) data;
    StyleSheetDescribeWWFixed(
	(WWFixedAsDWord) ((const VisTextCharAttr *) newAttrs)->VTCA_fontWidth
	<< 16, DESC_ALL_DIGITS, @FontWidthString, ptr, left);
}

static void DescTrackKerning(TCHAR **ptr, word *left, const void *newAttrs,
			     const void *oldAttrs, const void *diffs,
			     word data)
{
    (void) oldAttrs; (void) diffs; (void) data;
    StyleSheetDescribeWWFixed(
	(WWFixedAsDWord) (word) ((const VisTextCharAttr *) newAttrs)->
	VTCA_trackKerning << 16, DESC_ALL_DIGITS, @TrackKerningString, ptr,
	left);
}

/* a color: the name (if any), the standard color's name */
static void DescColorCommon(optr name, const ColorQuad *c, TCHAR **ptr,
			    word *left)
{
    SSDescribeWordEntry t[] = {
	{ (word) (C_BLACK), OptrToChunk(@BlackString) },
	{ (word) (C_BLUE), OptrToChunk(@DarkBlueString) },
	{ (word) (C_GREEN), OptrToChunk(@DarkGreenString) },
	{ (word) (C_CYAN), OptrToChunk(@CyanString) },
	{ (word) (C_RED), OptrToChunk(@DarkRedString) },
	{ (word) (C_VIOLET), OptrToChunk(@DarkVioletString) },
	{ (word) (C_BROWN), OptrToChunk(@BrownString) },
	{ (word) (C_LIGHT_GRAY), OptrToChunk(@LightGrayString) },
	{ (word) (C_DARK_GRAY), OptrToChunk(@DarkGrayString) },
	{ (word) (C_LIGHT_BLUE), OptrToChunk(@LightBlueString) },
	{ (word) (C_LIGHT_GREEN), OptrToChunk(@LightGreenString) },
	{ (word) (C_LIGHT_CYAN), OptrToChunk(@LightCyanString) },
	{ (word) (C_LIGHT_RED), OptrToChunk(@LightRedString) },
	{ (word) (C_LIGHT_VIOLET), OptrToChunk(@LightVioletString) },
	{ (word) (C_YELLOW), OptrToChunk(@YellowString) },
	{ (word) (C_WHITE), OptrToChunk(@WhiteString) },
    };

    if (name) {
	AddName(name, ptr, left);
	AddSpace(ptr, left);
    }
    StyleSheetDescribeExclusiveWord(c->CQ_redOrIndex, t, COUNT(t), STRINGS,
				    0, ptr, left);
}

static void DescTextColor(TCHAR **ptr, word *left, const void *newAttrs,
			  const void *oldAttrs, const void *diffs, word data)
{
    (void) oldAttrs; (void) diffs; (void) data;
    DescColorCommon(0, &((const VisTextCharAttr *) newAttrs)->VTCA_color,
		    ptr, left);
}

/* a draw mask: filled, unfilled, or the percentage of halftone */
static void DescGrayCommon(SystemDrawMask mask, TCHAR **ptr, word *left)
{
    dword r;

    if (mask == SDM_100) {
	AddName(@FilledString, ptr, left);
	return;
    }
    if (mask == SDM_0) {
	AddName(@UnfilledString, ptr, left);
	return;
    }
    /* 64 - (mask - SDM_100) in 64ths, as a percentage, rounded */
    r = (dword) ((100 * 256) / 64) * (word) (SDM_100 + 64 - mask) + 0x80;
    StyleSheetDescribeWWFixed((WWFixedAsDWord) ((r >> 8) & 0xffff) << 16,
			      DESC_ALL_DIGITS, 0, ptr, left);
    StyleSheetAddCharToDescription('%', ptr, left);
    AddSpace(ptr, left);
    AddName(@HalftoneString, ptr, left);
}

static void DescGrayScreen(TCHAR **ptr, word *left, const void *newAttrs,
			   const void *oldAttrs, const void *diffs, word data)
{
    (void) oldAttrs; (void) diffs; (void) data;
    DescGrayCommon(((const VisTextCharAttr *) newAttrs)->VTCA_grayScreen, ptr,
		   left);
}

/* a pattern (type in the low byte, data in the high one) */
static void DescPatternCommon(const GraphicPattern *p, TCHAR **ptr,
			      word *left)
{
    const byte *b = (const byte *) p;
    SSDescribeWordEntry t[] = {
	{ (word) (0), OptrToChunk(@SolidPatternString) },
	{ (word) (PT_SYSTEM_HATCH | (SH_VERTICAL << 8)), OptrToChunk(@VerticalPatternString) },
	{ (word) (PT_SYSTEM_HATCH | (SH_HORIZONTAL << 8)), OptrToChunk(@HorizontalPatternString) },
	{ (word) (PT_SYSTEM_HATCH | (SH_45_DEGREE << 8)), OptrToChunk(@Degree45PatternString) },
	{ (word) (PT_SYSTEM_HATCH | (SH_135_DEGREE << 8)), OptrToChunk(@Degree135PatternString) },
	{ (word) (PT_SYSTEM_HATCH | (SH_BRICK << 8)), OptrToChunk(@BrickPatternString) },
	{ (word) (PT_SYSTEM_HATCH | (SH_SLANTED_BRICK << 8)), OptrToChunk(@SlantedBrickPatternString) },
    };

    StyleSheetDescribeExclusiveWord((word) (b[0] | (b[1] << 8)), t, COUNT(t),
				    STRINGS, OptrToChunk(@UnknownPatternString),
				    ptr, left);
    AddSpace(ptr, left);
    AddName(@PatternString, ptr, left);
}

static void DescPattern(TCHAR **ptr, word *left, const void *newAttrs,
			const void *oldAttrs, const void *diffs, word data)
{
    (void) oldAttrs; (void) diffs; (void) data;
    DescPatternCommon(&((const VisTextCharAttr *) newAttrs)->VTCA_pattern,
		      ptr, left);
}

static void DescBGColor(TCHAR **ptr, word *left, const void *newAttrs,
			const void *oldAttrs, const void *diffs, word data)
{
    (void) oldAttrs; (void) diffs; (void) data;
    DescColorCommon(@BGColorString,
		    &((const VisTextCharAttr *) newAttrs)->VTCA_bgColor, ptr,
		    left);
}

static void DescBGGrayScreen(TCHAR **ptr, word *left, const void *newAttrs,
			     const void *oldAttrs, const void *diffs,
			     word data)
{
    (void) oldAttrs; (void) diffs; (void) data;
    DescGrayCommon(((const VisTextCharAttr *) newAttrs)->VTCA_bgGrayScreen,
		   ptr, left);
}

static void DescBGPattern(TCHAR **ptr, word *left, const void *newAttrs,
			  const void *oldAttrs, const void *diffs, word data)
{
    (void) oldAttrs; (void) diffs; (void) data;
    DescPatternCommon(&((const VisTextCharAttr *) newAttrs)->VTCA_bgPattern,
		      ptr, left);
}

#define NEW_CAT		SSDF_NEW_CATEGORY
#define CAD_OFF(f)	((word) offsetof(VisTextCharAttrDiffs, f))

static const SSDiffEntry CADiffTable[] = {
    { CAD_OFF(VTCAD_diffs), VTCAF_MULTIPLE_FONT_IDS, DescFont, 0 },
    { CAD_OFF(VTCAD_diffs), VTCAF_MULTIPLE_POINT_SIZES, DescPointSize, 0 },
    { CAD_OFF(VTCAD_textStyles), 0xff, DescTextStyle, 0 },
    { CAD_OFF(VTCAD_extendedStyles), 0xffff, DescExtendedStyle, 0 },
    { CAD_OFF(VTCAD_diffs), VTCAF_MULTIPLE_COLORS, DescTextColor, NEW_CAT },
    { CAD_OFF(VTCAD_diffs), VTCAF_MULTIPLE_GRAY_SCREENS, DescGrayScreen, 0 },
    { CAD_OFF(VTCAD_diffs), VTCAF_MULTIPLE_PATTERNS, DescPattern, 0 },
    { CAD_OFF(VTCAD_diffs), VTCAF_MULTIPLE_FONT_WEIGHTS, DescFontWeight,
      NEW_CAT },
    { CAD_OFF(VTCAD_diffs), VTCAF_MULTIPLE_FONT_WIDTHS, DescFontWidth,
      NEW_CAT },
    { CAD_OFF(VTCAD_diffs), VTCAF_MULTIPLE_TRACK_KERNINGS, DescTrackKerning,
      NEW_CAT },
    { CAD_OFF(VTCAD_diffs), VTCAF_MULTIPLE_BG_COLORS, DescBGColor, NEW_CAT },
    { CAD_OFF(VTCAD_diffs), VTCAF_MULTIPLE_BG_GRAY_SCREENS, DescBGGrayScreen,
      0 },
    { CAD_OFF(VTCAD_diffs), VTCAF_MULTIPLE_BG_PATTERNS, DescBGPattern, 0 },
};

/* whether a structure is all zero */
static Boolean AllZero(const void *p, word size)
{
    const byte *b = p;

    for (; size; size--)
	if (*b++)
	    return FALSE;
    return TRUE;
}

/*
 * DescribeCharAttr: the description callback of character attributes:
 * "Character:" and what differs from the base (no base: from the
 * default attribute, the font and size always)
 */
void DescribeCharAttr(TCHAR **ptr, word *left, word used,
		      const void *derived, const void *base, optr extraUI,
		      dword privateData, word attrsFlag)
{
    VisTextCharAttrDiffs diffs;

    (void) extraUI; (void) attrsFlag;
    memset(&diffs, 0, sizeof(diffs));
    if (!base)
	diffs.VTCAD_diffs = VTCAF_MULTIPLE_FONT_IDS |
			    VTCAF_MULTIPLE_POINT_SIZES;
    DiffCharAttr(derived, base ? base : &TS_defaultCharAttr, &diffs);
    diffs.VTCAD_diffs &= ~VTCAF_MULTIPLE_STYLES;
    diffs.VTCAD_extendedStyles &= ~VTES_BACKGROUND_COLOR;
    if (AllZero(&diffs, sizeof(diffs)))
	return;
    StyleSheetAddAttributeHeader(used != 0, @CharacterString, ptr, left);
    StyleSheetCallDescribeRoutines(CADiffTable, COUNT(CADiffTable), ptr, left,
				   derived, base, &diffs,
				   (word) privateData);
}

/* ---- paragraph attributes --------------------------------------- */

#define PA(p)	(&((const VisTextMaxParaAttr *) (p))->VTMPA_paraAttr)

static void DescJustification(TCHAR **ptr, word *left, const void *newAttrs,
			      const void *oldAttrs, const void *diffs,
			      word data)
{
    SSDescribeWordEntry t[] = {
	{ (word) (J_LEFT << VTPAA_JUSTIFICATION_OFFSET), OptrToChunk(@LeftJustString) },
	{ (word) (J_CENTER << VTPAA_JUSTIFICATION_OFFSET), OptrToChunk(@CenterJustString) },
	{ (word) (J_RIGHT << VTPAA_JUSTIFICATION_OFFSET), OptrToChunk(@RightJustString) },
	{ (word) (J_FULL << VTPAA_JUSTIFICATION_OFFSET), OptrToChunk(@FullJustString) },
    };

    (void) oldAttrs; (void) diffs; (void) data;
    StyleSheetDescribeExclusiveWord(
	PA(newAttrs)->VTPA_attributes & VTPAA_JUSTIFICATION, t, COUNT(t),
	STRINGS, 0, ptr, left);
}

/* a margin; relative to the base style's if the style says so */
static void DescMargin(word v, const word *old, word flags, optr name,
		       TCHAR **ptr, word *left)
{
    SSDescribeDistanceFlags f = SSDDF_PLURAL_FOR_NON_RELATIVE_IF_NEEDED;

    if ((flags & TSF_MARGINS_RELATIVE) && old) {
	v = (word) (v - *old);
	f = SSDDF_RELATIVE;
    }
    StyleSheetDescribeDistance(DU_INCHES_OR_CENTIMETERS, (sword) v, f, name,
			       ptr, left);
}

static void DescLeftMargin(TCHAR **ptr, word *left, const void *newAttrs,
			   const void *oldAttrs, const void *diffs, word data)
{
    (void) diffs;
    DescMargin(PA(newAttrs)->VTPA_leftMargin,
	       oldAttrs ? &PA(oldAttrs)->VTPA_leftMargin : NULL, data,
	       @LeftMarginString, ptr, left);
}

static void DescParaMargin(TCHAR **ptr, word *left, const void *newAttrs,
			   const void *oldAttrs, const void *diffs, word data)
{
    (void) diffs;
    DescMargin(PA(newAttrs)->VTPA_paraMargin,
	       oldAttrs ? &PA(oldAttrs)->VTPA_paraMargin : NULL, data,
	       @ParaMarginString, ptr, left);
}

static void DescRightMargin(TCHAR **ptr, word *left, const void *newAttrs,
			    const void *oldAttrs, const void *diffs, word data)
{
    (void) diffs;
    DescMargin(PA(newAttrs)->VTPA_rightMargin,
	       oldAttrs ? &PA(oldAttrs)->VTPA_rightMargin : NULL, data,
	       @RightMarginString, ptr, left);
}

/*
 * The line spacing, or the leading if there is one.  A relative leading
 * is described as relative, but not made relative: the asm subtracted
 * the base's leading from another register (ax, not dx), and so does
 * not the port.
 */
static void DescLineSpacingAndLeading(TCHAR **ptr, word *left,
				      const void *newAttrs,
				      const void *oldAttrs,
				      const void *diffs, word data)
{
    const VisTextParaAttr *n = PA(newAttrs);
    SSDescribeDistanceFlags f = SSDDF_PLURAL_FOR_NON_RELATIVE_IF_NEEDED;

    (void) diffs;
    if (!n->VTPA_leading) {
	/* (BBFixed to WWFixed) */
	StyleSheetDescribeWWFixed((WWFixedAsDWord) n->VTPA_lineSpacing << 8,
				  DESC_ALL_DIGITS, @LineSpacingString, ptr,
				  left);
	return;
    }
    if ((data & TSF_SPACING_RELATIVE) && oldAttrs)
	f = SSDDF_RELATIVE;
    StyleSheetDescribeDistance(DU_POINTS_OR_MILLIMETERS,
			       (sword) n->VTPA_leading, f, @LeadingString,
			       ptr, left);
}

static void DescTopSpacing(TCHAR **ptr, word *left, const void *newAttrs,
			   const void *oldAttrs, const void *diffs, word data)
{
    (void) oldAttrs; (void) diffs; (void) data;
    StyleSheetDescribeDistance(DU_POINTS_OR_MILLIMETERS,
			       (sword) PA(newAttrs)->VTPA_spaceOnTop,
			       SSDDF_PLURAL_FOR_NON_RELATIVE_IF_NEEDED,
			       @TopSpacingString, ptr, left);
}

static void DescBottomSpacing(TCHAR **ptr, word *left, const void *newAttrs,
			      const void *oldAttrs, const void *diffs,
			      word data)
{
    (void) oldAttrs; (void) diffs; (void) data;
    StyleSheetDescribeDistance(DU_POINTS_OR_MILLIMETERS,
			       (sword) PA(newAttrs)->VTPA_spaceOnBottom,
			       SSDDF_PLURAL_FOR_NON_RELATIVE_IF_NEEDED,
			       @BottomSpacingString, ptr, left);
}

