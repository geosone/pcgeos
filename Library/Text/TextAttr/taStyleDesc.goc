/*
 * The tabs: "Tabs: 1 inch, 2 inches centered, 3 inches anchored with
 * '.' with bullet leader 50% halftone 3 point wide lines 4 point
 * spacing, ..."
 */
static void DescTabList(TCHAR **ptr, word *left, const void *newAttrs,
			const void *oldAttrs, const void *diffs, word data)
{
    const VisTextMaxParaAttr *m = newAttrs;
    word n = m->VTMPA_paraAttr.VTPA_numberOfTabs, type, leader;
    const Tab *t = m->VTMPA_tabs;
    SSDescribeWordEntry types[] = {
	{ (word) (TT_CENTER), OptrToChunk(@CenterJustString) },
	{ (word) (TT_RIGHT), OptrToChunk(@RightJustString) },
	{ (word) (TT_ANCHORED), OptrToChunk(@AnchoredString) },
    };
    SSDescribeWordEntry leaders[] = {
	{ (word) (TL_DOT << TabLeader_OFFSET), OptrToChunk(@DotLeaderString) },
	{ (word) (TL_LINE << TabLeader_OFFSET), OptrToChunk(@LineLeaderString) },
	{ (word) (TL_BULLET << TabLeader_OFFSET), OptrToChunk(@BulletLeaderString) },
    };

    (void) oldAttrs; (void) diffs; (void) data;
    if (!n) {
	AddName(@NoTabsString, ptr, left);
	return;
    }
    AddName(@TabsString, ptr, left);
    AddSpace(ptr, left);
    for (;; t++) {
	StyleSheetDescribeDistance(DU_INCHES_OR_CENTIMETERS,
				   (sword) t->T_position,
				   SSDDF_PLURAL_FOR_NON_RELATIVE_IF_NEEDED, 0,
				   ptr, left);
	type = t->T_attr & TabType;
	if (type != TT_LEFT) {
	    AddSpace(ptr, left);
	    StyleSheetDescribeExclusiveWord(type, types, COUNT(types),
					    STRINGS, 0, ptr, left);
	    if (type == TT_ANCHORED) {
		AddSpace(ptr, left);
		AddName(@AnchoredWithString, ptr, left);
		StyleSheetAddCharToDescription((TCHAR) (byte) t->T_anchor,
					       ptr, left);
		AddName(@AnchoredEndString, ptr, left);
	    }
	}
	leader = t->T_attr & TabLeader;
	if (leader) {
	    AddSpace(ptr, left);
	    AddName(@WithString, ptr, left);
	    AddSpace(ptr, left);
	    StyleSheetDescribeExclusiveWord(leader, leaders, COUNT(leaders),
					    STRINGS, 0, ptr, left);
	    AddSpace(ptr, left);
	    AddName(@LeaderString, ptr, left);
	}
	if (t->T_grayScreen != SDM_100) {
	    AddSpace(ptr, left);
	    DescGrayCommon(t->T_grayScreen, ptr, left);
	}
	if (t->T_lineWidth) {
	    AddSpace(ptr, left);
	    StyleSheetDescribeDistance(DU_POINTS_OR_MILLIMETERS,
				       t->T_lineWidth, 0, 0, ptr, left);
	    AddSpace(ptr, left);
	    AddName(@TabLineWidthString, ptr, left);
	}
	if (t->T_lineSpacing != 1 * 8) {
	    AddSpace(ptr, left);
	    StyleSheetDescribeDistance(DU_POINTS_OR_MILLIMETERS,
				       t->T_lineSpacing, 0, 0, ptr, left);
	    AddSpace(ptr, left);
	    AddName(@TabLineSpacingString, ptr, left);
	}
	if (!--n)
	    break;
	StyleSheetAddCharToDescription(',', ptr, left);
	AddSpace(ptr, left);
    }
}

#define BORDER_SIDES	(VTPBF_LEFT | VTPBF_TOP | VTPBF_RIGHT | VTPBF_BOTTOM)

/* the border: "Double Line Border with 2 points between lines",
 * "Shadowed Border from bottom-right with 2 point shadow", "Normal
 * Border top, left sides", ", draw inner lines" */
static void DescBorder(TCHAR **ptr, word *left, const void *newAttrs,
		       const void *oldAttrs, const void *diffs, word data)
{
    const VisTextParaAttr *a = PA(newAttrs);
    word f = a->VTPA_borderFlags, shadow = a->VTPA_borderShadow, n;
    SSDescribeWordEntry sides[] = {
	{ (word) (VTPBF_LEFT), OptrToChunk(@LeftString) },
	{ (word) (VTPBF_TOP), OptrToChunk(@TopString) },
	{ (word) (VTPBF_RIGHT), OptrToChunk(@RightString) },
	{ (word) (VTPBF_BOTTOM), OptrToChunk(@BottomString) },
    };

    (void) oldAttrs; (void) diffs; (void) data;
    if (!(f & BORDER_SIDES)) {
	AddName(@NoBorderString, ptr, left);
	return;
    }
    AddName((f & VTPBF_DOUBLE) ? @DoubleBorderString :
	    (f & VTPBF_SHADOW) ? @ShadowBorderString : @NormalBorderString,
	    ptr, left);
    if (f & VTPBF_DOUBLE) {
	if (shadow != 1 * 8) {
	    AddSpace(ptr, left);
	    StyleSheetDescribeDistance(DU_POINTS_OR_MILLIMETERS, (sword) shadow,
				SSDDF_PLURAL_FOR_NON_RELATIVE_IF_NEEDED,
				@WithString, ptr, left);
	    AddSpace(ptr, left);
	    AddName(@SpaceBetweenString, ptr, left);
	}
    } else if (f & VTPBF_SHADOW) {
	switch (f & VTPBF_ANCHOR) {
	case SA_TOP_RIGHT:
	    AddSpace(ptr, left);
	    AddName(@ShadowTopRightString, ptr, left);
	    break;
	case SA_BOTTOM_LEFT:
	    AddSpace(ptr, left);
	    AddName(@ShadowBottomLeftString, ptr, left);
	    break;
	case SA_BOTTOM_RIGHT:
	    AddSpace(ptr, left);
	    AddName(@ShadowBottomRightString, ptr, left);
	    break;
	}
	if (shadow != 1 * 8) {
	    AddSpace(ptr, left);
	    StyleSheetDescribeDistance(DU_POINTS_OR_MILLIMETERS, (sword) shadow,
				       0, @WithString, ptr, left);
	    AddSpace(ptr, left);
	    AddName(@ShadowWidthString, ptr, left);
	}
    }
    if ((f & BORDER_SIDES) != BORDER_SIDES) {
	AddSpace(ptr, left);
	n = StyleSheetDescribeNonExclusiveWord(f & BORDER_SIDES, sides,
					       COUNT(sides), STRINGS, ptr,
					       left);
	AddSpace(ptr, left);
	AddName(n == 1 ? @SideString : @SidesString, ptr, left);
    }
    if (f & VTPBF_DRAW_INNER_LINES) {
	StyleSheetAddCharToDescription(',', ptr, left);
	AddSpace(ptr, left);
	AddName(@DrawInnerString, ptr, left);
    }
}

