/* a field of the hyphenation or keep info: its value plus add */
static void DescFieldCommon(word v, word shift, word add, optr name,
			    TCHAR **ptr, word *left)
{
    StyleSheetDescribeWWFixed((WWFixedAsDWord) (word) ((v >> shift) + add)
			      << 16, 0, name, ptr, left);
}

