/*
 * taStyleDesc.goc -- after taStyleDesc.asm: the description callbacks
 * of the style sheet code (StyleSheetParams): a style's flags, and how
 * its character and paragraph attributes differ from its base style's
 * (or from the default attributes) in words.
 *
 * Port32: the tables of names are made on the stack, the chunk handles
 * of the strings being known when the code runs.  Where the asm left a
 * register to the routine it called (the fraction digits of
 * StyleSheetDescribeWWFixed, the default name of
 * StyleSheetDescribeExclusiveWord), DESC_ALL_DIGITS and 0 are passed:
 * what the register held was a stack address.
 */
@include "textInt.goh"
@include <Objects/styles.goh>

/* (the fraction digits of a value: all there are) */
#define DESC_ALL_DIGITS	0xffff

@extern chunk CharacterOnlyString;
@extern chunk PointSizeRelativeString;
@extern chunk MarginsRelativeString;
@extern chunk LeadingRelativeString;
@extern chunk CharacterString;
@extern chunk UnknownFontString;
