/*
 * taAttr.goc -- after taAttr.asm: SelectTab, MSG_VIS_TEXT_SET_FONT_ID,
 * MSG_VIS_TEXT_SET_FONT_WEIGHT, MSG_VIS_TEXT_SET_FONT_WIDTH,
 * MSG_VIS_TEXT_SET_POINT_SIZE, MSG_VIS_TEXT_SET_TEXT_STYLE,
 * MSG_VIS_TEXT_SET_COLOR, MSG_VIS_TEXT_SET_GRAY_SCREEN,
 * MSG_VIS_TEXT_SET_BORDER_BITS, MSG_VIS_TEXT_SET_BORDER_WIDTH,
 * MSG_VIS_TEXT_SET_BORDER_SPACING, MSG_VIS_TEXT_SET_BORDER_SHADOW,
 * MSG_VIS_TEXT_SET_BORDER_COLOR, MSG_VIS_TEXT_SET_BORDER_PATTERN,
 * MSG_VIS_TEXT_SET_LINE_SPACING, MSG_VIS_TEXT_SET_DEFAULT_TABS,
 * MSG_VIS_TEXT_SET_LEFT_MARGIN, MSG_VIS_TEXT_SET_RIGHT_MARGIN,
 * MSG_VIS_TEXT_SET_PARA_MARGIN, MSG_VIS_TEXT_SET_SPACE_ON_TOP,
 * MSG_VIS_TEXT_SET_SPACE_ON_BOTTOM, MSG_VIS_TEXT_SET_LEADING,
 * MSG_VIS_TEXT_SET_PARA_BG_COLOR, MSG_VIS_TEXT_SET_PARA_BG_PATTERN,
 * MSG_VIS_TEXT_SET_TAB, MSG_VIS_TEXT_CLEAR_TAB, MSG_VIS_TEXT_MOVE_TAB,
 * MSG_VIS_TEXT_CLEAR_ALL_TABS, MSG_VIS_TEXT_SET_PREPEND_CHARS,
 * MSG_VIS_TEXT_SET_BORDER_GRAY_SCREEN, MSG_VIS_TEXT_SET_PARA_ATTRIBUTES,
 * MSG_VIS_TEXT_SET_LEFT_AND_PARA_MARGIN,
 * MSG_VIS_TEXT_SET_PARA_BG_GRAY_SCREEN,
 * MSG_VIS_TEXT_SET_HYPHENATION_PARAMS, MSG_VIS_TEXT_SET_DROP_CAP_PARAMS,
 * MSG_VIS_TEXT_SET_KEEP_PARAMS, MSG_VIS_TEXT_SET_PARAGRAPH_NUMBER.
 */
@include "textInt.goh"
#include <font.h>
#include <fontID.h>
#include <chunkarr.h>

/* SelectTab: the tab the ruler shows selected */
void SelectTab(optr o, word pos)
{
    word *w = ObjVarAddData(o, ATTR_VIS_TEXT_SELECTED_TAB, sizeof(word));

    *w = pos;
}

/*
 * The handlers of taAttr.asm that change one field, with their
 * callbacks
 */
static void SetFontIDCB(optr o, void *e, void *data)
{
    (void) o;
    ((VisTextCharAttr *) e)->VTCA_fontID = *(FontID *) data;
}

@extern method VisTextClass, MSG_VIS_TEXT_SET_FONT_ID
{
    CharAttrChangeCommon(oself, rangeStart, rangeEnd, SetFontIDCB, &fid);
}

static void SetFontWeightCB(optr o, void *e, void *data)
{
    (void) o;
    ((VisTextCharAttr *) e)->VTCA_fontWeight = *(byte *) data;
}

@extern method VisTextClass, MSG_VIS_TEXT_SET_FONT_WEIGHT
{
    CharAttrChangeCommon(oself, rangeStart, rangeEnd, SetFontWeightCB,
		   &fontWeight);
}

static void SetFontWidthCB(optr o, void *e, void *data)
{
    (void) o;
    ((VisTextCharAttr *) e)->VTCA_fontWidth = *(byte *) data;
}

@extern method VisTextClass, MSG_VIS_TEXT_SET_FONT_WIDTH
{
    CharAttrChangeCommon(oself, rangeStart, rangeEnd, SetFontWidthCB,
		   &fontWidth);
}

/* SetWBFixedCallback: the WWFixed rounded to a WBFixed */
static void SetPointSizeCB(optr o, void *e, void *data)
{
    VisTextCharAttr *a = e;
    WWFixed *s = data;

    (void) o;
    a->VTCA_pointSize.WBF_int = s->WWF_int;
    a->VTCA_pointSize.WBF_frac = s->WWF_frac >> 8;
}

@extern method VisTextClass, MSG_VIS_TEXT_SET_POINT_SIZE
{
    CharAttrChangeCommon(oself, rangeStart, rangeEnd, SetPointSizeCB,
		   &pointSize);
}

/* SetTextStyleCallback: the same bits to set and to clear toggle them;
 * superscript and subscript exclude each other, the new one wins */
typedef struct {
    word set, clear, extSet, extClear;
} StyleChange;

static void SetTextStyleCB(optr o, void *e, void *data)
{
    VisTextCharAttr *a = e;
    StyleChange *c = data;
    byte s = a->VTCA_textStyles;

    (void) o;
    if ((byte) c->clear == (byte) c->set)
	s ^= (byte) c->clear;
    else
	s = (s & ~(byte) c->clear) | (byte) c->set;
    if ((s & (TS_SUPERSCRIPT | TS_SUBSCRIPT)) ==
	(TS_SUPERSCRIPT | TS_SUBSCRIPT)) {
	if (a->VTCA_textStyles & TS_SUPERSCRIPT)
	    s &= ~TS_SUPERSCRIPT;
	else
	    s &= ~TS_SUBSCRIPT;
    }
    a->VTCA_textStyles = s;
    a->VTCA_extendedStyles =
	(a->VTCA_extendedStyles & ~c->extClear) | c->extSet;
}

@extern method VisTextClass, MSG_VIS_TEXT_SET_TEXT_STYLE
{
    StyleChange c;

    c.set = styleBitsToSet;
    c.clear = styleBitsToClear;
    c.extSet = extBitsToSet;
    c.extClear = extBitsToClear;
    CharAttrChangeCommon(oself, rangeStart, rangeEnd, SetTextStyleCB, &c);
}

/* SetColorCallback: an index has no green and blue */
static void SetColorCB(optr o, void *e, void *data)
{
    VisTextCharAttr *a = e;

    (void) o;
    a->VTCA_color = *(ColorQuad *) data;
    if (a->VTCA_color.CQ_info == CF_INDEX)
	a->VTCA_color.CQ_green = a->VTCA_color.CQ_blue = 0;
}

@extern method VisTextClass, MSG_VIS_TEXT_SET_COLOR
{
    CharAttrChangeCommon(oself, rangeStart, rangeEnd, SetColorCB, &color);
}

static void SetGrayScreenCB(optr o, void *e, void *data)
{
    (void) o;
    ((VisTextCharAttr *) e)->VTCA_grayScreen = *(SystemDrawMask *) data;
}

@extern method VisTextClass, MSG_VIS_TEXT_SET_GRAY_SCREEN
{
    CharAttrChangeCommon(oself, rangeStart, rangeEnd, SetGrayScreenCB,
		   &grayScreen);
}

/*
 * The handlers of taAttr.asm that change one field of the paragraph
 * attribute, with their callbacks (SetWordCallback, SetByteCallback,
 * SetWordBitsCallback, SetColorCallback and their own)
 */
typedef struct {
    word set, clear;
} BitsChange;

#define PA(e)	(((VisTextMaxParaAttr *) (e))->VTMPA_paraAttr)

/* a callback that sets one field from the word data points to */
#define WORD_FIELD_CB(name, field) \
    static void name(optr o, void *e, void *data) \
    { (void) o; PA(e).field = *(word *) data; }
#define BYTE_FIELD_CB(name, field) \
    static void name(optr o, void *e, void *data) \
    { (void) o; PA(e).field = *(byte *) data; }
#define BITS_FIELD_CB(name, field) \
    static void name(optr o, void *e, void *data) \
    { BitsChange *c = data; (void) o; \
      PA(e).field = (PA(e).field & ~c->clear) | c->set; }
#define COLOR_FIELD_CB(name, field) \
    static void name(optr o, void *e, void *data) \
    { (void) o; PA(e).field = *(ColorQuad *) data; \
      if (PA(e).field.CQ_info == CF_INDEX) \
	  PA(e).field.CQ_green = PA(e).field.CQ_blue = 0; }
#define PATTERN_FIELD_CB(name, field) \
    static void name(optr o, void *e, void *data) \
    { (void) o; PA(e).field = *(GraphicPattern *) data; }

WORD_FIELD_CB(SetLineSpacingCB, VTPA_lineSpacing)
WORD_FIELD_CB(SetDefaultTabsCB, VTPA_defaultTabs)
WORD_FIELD_CB(SetLeftMarginCB, VTPA_leftMargin)
WORD_FIELD_CB(SetRightMarginCB, VTPA_rightMargin)
WORD_FIELD_CB(SetParaMarginCB, VTPA_paraMargin)
WORD_FIELD_CB(SetSpaceOnTopCB, VTPA_spaceOnTop)
WORD_FIELD_CB(SetSpaceOnBottomCB, VTPA_spaceOnBottom)
WORD_FIELD_CB(SetLeadingCB, VTPA_leading)
WORD_FIELD_CB(SetParagraphNumberCB, VTPA_startingParaNumber)
BYTE_FIELD_CB(SetBorderWidthCB, VTPA_borderWidth)
BYTE_FIELD_CB(SetBorderSpacingCB, VTPA_borderSpacing)
BYTE_FIELD_CB(SetBorderShadowCB, VTPA_borderShadow)
BYTE_FIELD_CB(SetBorderGrayScreenCB, VTPA_borderGrayScreen)
BYTE_FIELD_CB(SetParaBGGrayScreenCB, VTPA_bgGrayScreen)
BITS_FIELD_CB(SetBorderBitsCB, VTPA_borderFlags)
BITS_FIELD_CB(SetParaAttributesCB, VTPA_attributes)
BITS_FIELD_CB(SetHyphenationCB, VTPA_hyphenationInfo)
BITS_FIELD_CB(SetDropCapCB, VTPA_dropCapInfo)
BITS_FIELD_CB(SetKeepCB, VTPA_keepInfo)
COLOR_FIELD_CB(SetBorderColorCB, VTPA_borderColor)
COLOR_FIELD_CB(SetParaBGColorCB, VTPA_bgColor)
PATTERN_FIELD_CB(SetBorderPatternCB, VTPA_borderPattern)
PATTERN_FIELD_CB(SetParaBGPatternCB, VTPA_bgPattern)

static void ChangeByte(optr o, dword start, dword end,
		       TA_ModifyCallback *cb, byte v)
{
    ChangeParaAttr(o, start, end, cb, &v);
}

static void ChangeBits(optr o, dword start, dword end,
		       TA_ModifyCallback *cb, word set, word clear)
{
    BitsChange c;

    c.set = set;
    c.clear = clear;
    ChangeParaAttr(o, start, end, cb, &c);
}

@extern method VisTextClass, MSG_VIS_TEXT_SET_BORDER_BITS
{
    ChangeBits(oself, rangeStart, rangeEnd, SetBorderBitsCB, bitsToSet,
	       bitsToClear);
}

@extern method VisTextClass, MSG_VIS_TEXT_SET_BORDER_WIDTH
{
    ChangeByte(oself, rangeStart, rangeEnd, SetBorderWidthCB, width);
}

