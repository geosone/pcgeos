/* FindTabAtPosition: the index of the tab at a position, or -1 */
static int FindTab(const VisTextMaxParaAttr *a, word pos)
{
    int i;

    for (i = 0; i < a->VTMPA_paraAttr.VTPA_numberOfTabs; i++)
	if (a->VTMPA_tabs[i].T_position == pos)
	    return i;
    return -1;
}

/* InsertTabAtPosition: room for a tab at a position (in order); its
 * index.  A tab already there is the one. */
static int InsertTab(VisTextMaxParaAttr *a, word pos)
{
    int n = a->VTMPA_paraAttr.VTPA_numberOfTabs, i;

    for (i = 0; i < n; i++) {
	if (a->VTMPA_tabs[i].T_position == pos)
	    return i;
	if (a->VTMPA_tabs[i].T_position > pos)
	    break;
    }
    memmove(&a->VTMPA_tabs[i + 1], &a->VTMPA_tabs[i],
	    (n - i) * sizeof(Tab));
    a->VTMPA_paraAttr.VTPA_numberOfTabs++;
    return i;
}

/* ClearTabAtPosition: TRUE and the tab if there was one */
static Boolean ClearTab(VisTextMaxParaAttr *a, word pos, Tab *was)
{
    int i = FindTab(a, pos), n = a->VTMPA_paraAttr.VTPA_numberOfTabs;

    if (i < 0)
	return FALSE;
    *was = a->VTMPA_tabs[i];
    memmove(&a->VTMPA_tabs[i], &a->VTMPA_tabs[i + 1],
	    (n - i - 1) * sizeof(Tab));
    a->VTMPA_paraAttr.VTPA_numberOfTabs--;
    return TRUE;
}

/* SelectTab: the tab the ruler shows selected */
static void SelectTab(optr o, word pos)
{
    word *w = ObjVarAddData(o, ATTR_VIS_TEXT_SELECTED_TAB, sizeof(word));

    *w = pos;
}

/* SetTabCallback: replaced, or added if there is room */
static void SetTabCB(optr o, void *e, void *data)
{
    VisTextMaxParaAttr *a = e;
    Tab *t = data;
    int i = FindTab(a, t->T_position);

    (void) o;
    if (i < 0) {
	if (a->VTMPA_paraAttr.VTPA_numberOfTabs == VIS_TEXT_MAX_TABS)
	    return;
	i = InsertTab(a, t->T_position);
    }
    a->VTMPA_tabs[i] = *t;
}

@extern method VisTextClass, MSG_VIS_TEXT_SET_TAB
{
    SelectTab(oself, tab.T_position);
    ChangeParaAttr(oself, rangeStart, rangeEnd, SetTabCB, &tab);
}

static void ClearTabCB(optr o, void *e, void *data)
{
    Tab was;

    (void) o;
    (void) ClearTab(e, *(word *) data, &was);
}

@extern method VisTextClass, MSG_VIS_TEXT_CLEAR_TAB
{
    ChangeWord(oself, rangeStart, rangeEnd, ClearTabCB, position);
}

/* MoveTabCallback: the tab at the source (if any) to the destination */
typedef struct {
    word from, to;
} TabMove;

static void MoveTabCB(optr o, void *e, void *data)
{
    VisTextMaxParaAttr *a = e;
    TabMove *m = data;
    Tab t;
    int i;

    (void) o;
    if (!ClearTab(a, m->from, &t) ||
	a->VTMPA_paraAttr.VTPA_numberOfTabs == VIS_TEXT_MAX_TABS)
	return;
    i = InsertTab(a, m->to);
    a->VTMPA_tabs[i] = t;
    a->VTMPA_tabs[i].T_position = m->to;
}

@extern method VisTextClass, MSG_VIS_TEXT_MOVE_TAB
{
    TabMove m;

    m.from = sourcePosition;
    m.to = destPosition;
    SelectTab(oself, destPosition);
    ChangeParaAttr(oself, rangeStart, rangeEnd, MoveTabCB, &m);
}

static void ClearAllTabsCB(optr o, void *e, void *data)
{
    (void) o;
    (void) data;
    PA(e).VTPA_numberOfTabs = 0;
}

@extern method VisTextClass, MSG_VIS_TEXT_CLEAR_ALL_TABS
{
    ChangeParaAttr(oself, rangeStart, rangeEnd, ClearAllTabsCB, NULL);
}

static void SetPrependCharsCB(optr o, void *e, void *data)
{
    (void) o;
    memcpy(PA(e).VTPA_prependChars, data, 4);
}

@extern method VisTextClass, MSG_VIS_TEXT_SET_PREPEND_CHARS
{
    ChangeParaAttr(oself, rangeStart, rangeEnd, SetPrependCharsCB,
		   prependChars);
}

/* (the bits by their names: the asm's frame has them the other way
 * round from the C prototype of these three) */
@extern method VisTextClass, MSG_VIS_TEXT_SET_HYPHENATION_PARAMS
