/*
 * tsExternal.goc -- the text storage (after tsExternal.asm and the
 * small object's tsSmallAccess.asm,
 * tsSmallModify.asm, tsSmallGetText.asm): the text of a small object is
 * a chunk of its block, null terminated (VTI_text).
 *
 * A large object's (VTSF_LARGE) is a huge array (tsLarge*.goc): each
 * routine goes to the one of its kind (CallStorageHandler).  A pointer
 * from TS_LockTextPtr is given back with TS_UnlockTextPtr.
 *
 * Port32, not yet: the character classes, finding strings.
 */
@include "textInt.goh"

/* the text chunk; an object of a resource that names no text gets its
 * empty one on first use */
static optr TextOptr(optr o)
{
    if (!VT(o)->VTI_text)
	TS_SmallCreateTextStorage(o);
    return ConstructOptr(OptrToHandle(o), VT(o)->VTI_text);
}

#define LARGE(o)	(VT(o)->VTI_storageFlags & VTSF_LARGE)

dword TS_GetTextSize(optr o)
{
    if (LARGE(o))
	return LargeGetTextSize(o);
    return (dword) LMemGetChunkSize(TextOptr(o)) - 1;
}

const char *TS_LockTextPtr(optr o, dword offset, word *after)
{
    optr t;
    word size;

    if (LARGE(o))
	return LargeLockTextPtr(o, offset, after);
    t = TextOptr(o);
    size = LMemGetChunkSize(t) - 1;

    if (after)
	*after = (word) (size - offset);
    return (const char *) LMemDeref(t) + offset;
}

/* TS_UnlockTextPtr: nothing to do for a small object */
void TS_UnlockTextPtr(optr o, const char *p)
{
    if (LARGE(o))
	LargeUnlockTextPtr(p);
}

/* TS_RelockTextPtr: the text a callback locked before released, the
 * text at offset locked (the style callbacks: tlCommonCalc.asm,
 * tlCommonPosition.asm, tlCommonDraw.asm) */
const char *TS_RelockTextPtr(TextLockState *s, dword offset, word *after)
{
    TS_ReleaseTextPtr(s);
    s->TLK_locked = TS_LockTextPtr(s->TLK_object, offset, after);
    return s->TLK_locked;
}

void TS_ReleaseTextPtr(TextLockState *s)
{
    if (s->TLK_locked)
	TS_UnlockTextPtr(s->TLK_object, s->TLK_locked);
    s->TLK_locked = NULL;
}

word TS_GetCharAtOffset(optr o, dword offset)
{
    if (LARGE(o))
	return LargeGetCharAtOffset(o, offset);
    return (byte) *TS_LockTextPtr(o, offset, NULL);
}

/* SmallCheckLegalChange */
Boolean TS_CheckLegalChange(optr o, VisTextReplaceParameters *p)
{
    dword size;
    word max;

    if (LARGE(o))
	return LargeCheckLegalChange(o, p);
    size = TS_GetTextSize(o) + p->VTRP_insCount -
		 (p->VTRP_range.VTR_end - p->VTRP_range.VTR_start);
    max = VT(o)->VTI_maxLength;

    if (size <= max)
	return TRUE;
    if (!(p->VTRP_flags & VTRF_TRUNCATE) ||
	size - max > p->VTRP_insCount)
	return FALSE;
    p->VTRP_insCount -= size - max;
    return TRUE;
}

/* SmallReplaceRange: room made or taken at the range's start, the new
 * text copied in */
void TS_ReplaceRange(optr o, VisTextReplaceParameters *p)
{
    optr t;
    word start, del, ins;

    if (LARGE(o)) {
	LargeReplaceRange(o, p);
	return;
    }
    t = TextOptr(o);
    start = (word) p->VTRP_range.VTR_start;
    del = (word) (p->VTRP_range.VTR_end - p->VTRP_range.VTR_start);
    ins = (word) p->VTRP_insCount;

    if (ins > del)
	LMemInsertAt(t, start, ins - del);
    else if (del > ins)
	LMemDeleteAt(t, start, del - ins);
    ObjMarkDirty(t);
    if (ins)
	TS_CopyTextReference((char *) LMemDeref(t) + start,
			     &p->VTRP_textReference, ins);
}

/* SmallGetTextRange (the reference may be a chunk of the object's
 * block: the text is found after that chunk has its size) */
dword TS_GetTextRange(optr o, const VisTextRange *range, TextReference *ref)
{
    dword n = range->VTR_end - range->VTR_start;

    if (LARGE(o))
	return LargeGetTextRange(o, range, ref);
    TS_ResizeReference(ref, n + 1);
    TS_AppendToReference(ref, 0, (const char *) LMemDeref(TextOptr(o)) +
			 range->VTR_start, (word) n);
    return n;
}

/* TS_GetWordCount: the words (runs of word part characters,
 * CC_WORD_PART: TSL_IsWordPart) */
dword TS_GetWordCount(optr o)
{
    dword size = TS_GetTextSize(o), off, count = 0;
    Boolean in = FALSE;

    for (off = 0; off < size; off++) {
	Boolean w = TSL_IsWordPart(o, off);

	if (w && !in)
	    count++;
	in = w;
    }
    return count;
}
