/*
 * tsParams.goc -- the size of the text a reference names (after
 * tsParams.asm): up to its null.
 *
 * Port32: there are no segments, so no TRT_SEGMENT_CHUNK.
 */
@include "textInt.goh"
#include <localize.h>
#include <hugearr.h>
#include <dbase.h>

/* GetSizeHugeArray: its elements, without the last if that is a null
 * (Port32: an empty array has none) */
static dword GetSizeHugeArray(VMFileHandle f, VMBlockHandle a)
{
    dword n = HugeArrayGetCount(f, a);
    void *p;
    word size;

    if (!n)
	return 0;
    (void) HugeArrayLock(f, a, n - 1, &p, &size);
    if (!*(const char *) p)
	n--;
    HugeArrayUnlock(p);
    return n;
}

dword TS_ComputeReferenceSize(const TextReference *ref)
{
    dword n = 0;
    MemHandle mh;
    const char *p;

    switch (ref->TR_type) {
    case TRT_POINTER:
	n = LocalStringSize(ref->TR_ref.TRU_pointer.TRP_pointer);
	break;
    case TRT_OPTR:
	mh = OptrToHandle(ref->TR_ref.TRU_blockChunk.TRBC_ref);
	ObjLockObjBlock(mh);
	n = LocalStringSize(LMemDeref(ref->TR_ref.TRU_blockChunk.TRBC_ref));
	MemUnlock(mh);
	break;
    case TRT_BLOCK:
	mh = ref->TR_ref.TRU_block.TRB_handle;
	n = LocalStringSize(MemLock(mh));
	MemUnlock(mh);
	break;
    case TRT_VM_BLOCK:
	p = VMLock(ref->TR_ref.TRU_vmBlock.TRVMB_file,
		   ref->TR_ref.TRU_vmBlock.TRVMB_block, &mh);
	n = LocalStringSize(p);
	VMUnlock(mh);
	break;
    case TRT_DB_ITEM:
	p = DBLock(ref->TR_ref.TRU_dbItem.TRDBI_file,
		   ref->TR_ref.TRU_dbItem.TRDBI_group,
		   ref->TR_ref.TRU_dbItem.TRDBI_item);
	n = LocalStringSize(p);
	DBUnlock((void *) p);
	break;
    case TRT_HUGE_ARRAY:
	n = GetSizeHugeArray(ref->TR_ref.TRU_hugeArray.TRHA_file,
			     ref->TR_ref.TRU_hugeArray.TRHA_array);
	break;
    default:
	EC_ERROR(-1);
    }
    return n;
}

/* TS_GetReplaceSize: INSERT_COMPUTE_TEXT_LENGTH in the high word of the
 * count: the reference's size */
void TS_GetReplaceSize(optr o, VisTextReplaceParameters *p)
{
    (void) o;
    if ((p->VTRP_insCount >> 16) == INSERT_COMPUTE_TEXT_LENGTH)
	p->VTRP_insCount = TS_ComputeReferenceSize(&p->VTRP_textReference);
}
