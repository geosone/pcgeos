/*
 * tlTabUtils.goc -- after tlTabUtils.asm: Utility routines for accessing
 * tabs.
 */
@include "textInt.goh"

#define PA(l)	((l)->LICL_theParaAttr.VTMPA_paraAttr)

/* TabGetPositionAndAttributes: the position and the attributes of the
 * tab a reference names; spacing (if wanted): the room its line takes,
 * after a right tab, before the others (negative) */
word TabGetPositionAndAttributes(LICL_vars *l, Boolean paraStart,
				    word endPrevField, TabReference ref,
				    byte *attr, sword *spacing)
{
    byte num = ref & TR_REF_NUMBER;

    *attr = TT_LEFT;
    if (spacing)
	*spacing = 0;
    if (!(ref & 0x80)) {
	const Tab *tab;

	if (num == RULER_TAB_TO_LEFT_MARGIN)
	    return PA(l).VTPA_leftMargin;
	if (num == RULER_TAB_TO_PARA_MARGIN)
	    return PA(l).VTPA_paraMargin;
	if (num == RULER_TAB_TO_LINE_LEFT)
	    return paraStart ? PA(l).VTPA_paraMargin : PA(l).VTPA_leftMargin;
	tab = &l->LICL_theParaAttr.VTMPA_tabs[PA(l).VTPA_numberOfTabs - num];
	*attr = tab->T_attr;
	if (spacing) {
	    *spacing = (sword) (((word) (byte) (tab->T_lineWidth +
						tab->T_lineSpacing)) >> 3);
	    if ((tab->T_attr & TA_TYPE) != TT_RIGHT)
		*spacing = (sword) -*spacing;
	}
	return tab->T_position;
    }
    if (num == OTHER_INTRINSIC_TAB)
	return (word) (endPrevField + TAB_INTRINSIC_WIDTH);
    if (num == OTHER_ZERO_WIDTH_TAB)
	return endPrevField;
    return (word) (((dword) num * ((dword) PA(l).VTPA_defaultTabs << 2) +
		    16) >> 5);
}
