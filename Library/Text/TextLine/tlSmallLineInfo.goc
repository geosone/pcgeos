/*
 * tlSmallLineInfo.goc -- after tlSmallLineInfo.asm: SmallLineGetCount.
 * (The tops, heights and positions of lines are common to small and
 * large objects: tlExternal.goc.)
 */
@include "textInt.goh"
#include <chunkarr.h>

dword SmallLineGetCount(optr o)
{
    return VT(o)->VTI_lines ? ChunkArrayGetCount(Lines(o)) : 0;
}
