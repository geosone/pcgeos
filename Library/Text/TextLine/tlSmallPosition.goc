/*
 * tlSmallPosition.goc -- after tlSmallPosition.asm: SmallLineToPosition.
 */
@include "textInt.goh"

/* SmallLineToPosition: a line's left edge and top, in its region */
void SmallLineToPosition(optr o, dword line, sword *x, sword *y)
{
    *x = SmallLineGetLeftEdge(o, line);
    *y = SmallLineGetTop(o, line).WBF_int;
}
