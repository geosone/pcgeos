/*
 * tlSmallOffset.goc -- after tlSmallOffset.asm: SmallLineToOffsetStart,
 * SmallLineFromOffsetGetStart.
 */
@include "textInt.goh"
#include <chunkarr.h>

/* SmallLineToOffsetStart: where a line's text starts */
dword SmallLineToOffsetStart(optr o, dword line)
{
    dword off = 0, i;

    for (i = 0; i < line; i++)
	off += TL_LineGetCharCount(SmallGetLinePointer(o, i, NULL));
    return off;
}

/*
 * SmallLineFromOffsetGetStart: the line an offset is on; *start where that
 * line starts.  An offset where one line ends and the next starts is
 * on the first of them if first is set, else on the second.
 */
dword SmallLineFromOffsetGetStart(optr o, dword offset, Boolean first, dword *start)
{
    dword n = TL_LineGetCount(o), i, off = 0, count;

    for (i = 0; i < n; i++) {
	count = TL_LineGetCharCount(SmallGetLinePointer(o, i, NULL));
	if (offset < off + count || i == n - 1 ||
	    (offset == off + count && first))
	    break;
	off += count;
    }
    if (start)
	*start = off;
    return i;
}
