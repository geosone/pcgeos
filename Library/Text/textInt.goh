			       TextReference *ref);
extern void LargeReplaceRange(optr o, VisTextReplaceParameters *p);
extern void TS_UnlockTextPtr(optr o, const char *p);
/* the text a style callback of the kernel has locked: the object
 * first (the callbacks find it through a pointer to an optr), the text
 * last locked (released at the next callback and when done) */
typedef struct {
    optr		TLK_object;
    const char		*TLK_locked;
} TextLockState;
extern const char *TS_RelockTextPtr(TextLockState *s, dword offset,
				    word *after);
extern void TS_ReleaseTextPtr(TextLockState *s);
/* TextTrans/: the transfer format's header, a transfer item made of
 * a format (0: of the selection), a paste from the clipboard, a
 * warning */
extern VMBlockHandle TT_CreateTransferFormatHeader(VMFileHandle f);
extern VMBlockHandle TT_GenerateTransferItem(optr o, VMFileHandle f,
					     VMBlockHandle format, optr owner,
					     const char *name);
extern Boolean TT_PasteCommon(optr o, dword start, dword end, word flags);
extern void TT_DoWarningDialog(optr string);
/* Text/textUtils.goc: the VM file of the object's huge arrays */
extern VMFileHandle T_GetVMFile(optr o);
extern dword TS_GetTextSize(optr o);
extern dword TS_GetWordCount(optr o);
/* the text from an offset on (till the next change of the object's
 * block), *after the characters from there */
extern const char *TS_LockTextPtr(optr o, dword offset, word *after);
extern word TS_GetCharAtOffset(optr o, dword offset);
/* FALSE: the object would hold more than VTI_maxLength (VTRF_TRUNCATE
 * cuts the insertion instead) */
extern Boolean TS_CheckLegalChange(optr o, VisTextReplaceParameters *p);
extern void TS_ReplaceRange(optr o, VisTextReplaceParameters *p);
/* the range (real, within the text) into the reference, with a null;
 * the characters copied */
extern dword TS_GetTextRange(optr o, const VisTextRange *range,
			     TextReference *ref);

/* TextStorage/tsParams.goc: INSERT_COMPUTE_TEXT_LENGTH resolved; the
 * size of the text of a reference, without its null */
extern void TS_GetReplaceSize(optr o, VisTextReplaceParameters *p);
extern dword TS_ComputeReferenceSize(const TextReference *ref);

/* TextStorage/tsReference.goc: count characters of the reference to
 * dest; a reference made size bytes; count characters and a null
 * written to a reference at off */
extern void TS_CopyTextReference(char *dest, const TextReference *ref,
				 dword count);
extern void TS_ResizeReference(TextReference *ref, dword size);
extern void TS_AppendToReference(TextReference *ref, dword off,
