dword CommonLineTextPosition(optr o, dword line, sword pixel, dword stop, sword *x, Boolean *over);
void SmallStorageCreate(optr o);
void SmallStorageDestroy(optr o);
dword SmallLineGetCount(optr o);
void SmallLineInsert(optr o, dword line, word count);
void SmallLineDelete(optr o, dword line, word count);

/* taAttr.goc (for taParaAttr.goc) */
void SelectTab(optr o, word pos);

/* taElement.goc (for taRunLow.goc) */
word GetInsertionElement(optr o);
word ClearInsertionElement(optr o, Boolean unref);
void SetInsertionElement(optr o, word token);

/* taRunManip.goc (for taRunLow.goc) */
