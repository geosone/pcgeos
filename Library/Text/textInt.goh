/* taCharAttr.goc (for taParaAttr.goc) */
Boolean UnHiliteAndFixupParaAttrRange(optr o, VisTextRange *r, dword start,
	dword end);

/* taRunLow.goc (for taRunManip.goc) */
void RunArrayDelete(optr o, TextRunKind kind, word i);

/* tslMethodMouse.goc (for tslKbdShortcuts.goc) */
