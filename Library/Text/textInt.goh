/* the state of a calculation (texttext.def) */
typedef ByteFlags CalcFlags;
#define CF_SAVE_RESULTS		0x80
#define CF_LINE_CHANGED		0x40	/* the line calculated changed */
#define CF_LINE_SHORTER		0x20
#define CF_TEXT_LOCKED		0x10
#define CF_FORCE_CHANGED	0x08

typedef struct {
    optr		LICL_object;
    TextLockState	LICL_textLock;	/* Port32: the text the calc's
					 * callback has locked
					 * (CF_TEXT_LOCKED) */
    VisTextRange	LICL_range;	/* start: the line to calculate
					 * (then the next); end: of the
					 * change */
    dword		LICL_startPos;	/* the start of the change */
    CalcFlags		LICL_calcFlags;
    dword		LICL_line;
    dword		LICL_regionTopLine;
    WBFixed		LICL_lineBottom; /* the top of the line */
    WBFixed		LICL_lineHeight;
    WBFixed		LICL_oldLineHeight;
    dword		LICL_lineStart;
    sdword		LICL_lineStartChange;
    sdword		LICL_insertedSpace;	/* 1/256 */
    LineFlags		LICL_lineFlags;
    LineFlags		LICL_oldLineFlags;
    word		LICL_lineEnd;
    word		LICL_lineJustEnd;
    word		LICL_lastFieldJustWidth;
    byte		LICL_lastFieldTabType;
    TabReference	LICL_tabReference;
    word		LICL_extStylePos;
    word		LICL_field;	/* the field being measured */
    word		LICL_realRightMargin;
    dword		LICL_paraAttrStart;
    dword		LICL_paraAttrEnd;
    VisTextMaxParaAttr	LICL_theParaAttr;
    Rectangle		LICL_theRect;	/* the line's bounds, drawing */
    sword		*LICL_borderStart;	/* LICL_mapRect: the edges */
    sword		*LICL_borderSide;	/* of LICL_theRect a side */
    sword		*LICL_borderEnd;	/* of the border is drawn */
    sword		*LICL_borderOpposite;	/* by (TextDrawBorder) */
    VisTextParaBorderFlags LICL_prevLineBF;	/* the border before */
    VisTextParaBorderFlags LICL_nextLineBF;	/* and after the line */
    LineInfo		*LICL_linePtr;	/* Port32: a large object's line
					 * locked by its calc */
} LICL_vars;

/* Text/textBGBorder.goc: a paragraph's border (textline.def) */
typedef ByteFlags DrawBorderFlags;
#define DBF_NEGATIVE		0x40	/* the side grows inward */
#define DBF_SHADOW_FLAG		0x20	/* the start moved, else the end */
#define DBF_NO_SHADOW		0x10
#define DBF_SIDE_SHADOWED	0x08	/* this side has the shadow */
#define DBF_DOUBLE		0x04
#define DBF_DONT_ADJUST_START	0x02
#define DBF_DONT_ADJUST_END	0x01
typedef struct {
    sword		BI_space;	/* the room it takes */
    sword		BI_width;	/* the line's width */
    sword		BI_shadow;	/* the shadow (double: the inset) */
    sword		BI_bg;		/* the room the background leaves */
    DrawBorderFlags	BI_flags;
} BorderInfo;
extern void GetBorderInfo(LICL_vars *l, VisTextParaBorderFlags side,
			  VisTextParaBorderFlags flags, BorderInfo *b);
extern VisTextParaBorderFlags T_GetBorderInfo(LICL_vars *l, dword pos);
extern VisTextParaBorderFlags CalcRealBorder(LICL_vars *l);
extern sword CalcBorderSpacing(LICL_vars *l, VisTextParaBorderFlags side);
/* TextLine/tlBorder.goc */
extern void TextClearBehindLine(LICL_vars *l, sdword top, byte flags,
