extern Boolean TextCheckCanDrawEditable(optr o);
extern void TSL_ConvertOffsetToCoordinate(optr o, dword offset, sword *x,
					  sword *y);
extern dword TSL_GetCursorLine(optr o);
extern void CursorEnable(optr o);
extern void CursorDisable(optr o);
extern void CursorForceOn(optr o);
extern void TSL_CursorDrawIfOn(optr o);
extern void TSL_CursorPosition(optr o, sword x, sword y);
extern void TSL_StartCursorCommon(optr o);
extern void TSL_StopCursorTimer(optr o);

/* TextSelect/tslInvert.goc: the selection on the screen, shown and
 * taken away (with the object's gstate) */
extern void TSL_DrawHilite(optr o, dword start, dword end);
extern void EditHilite(optr o);
extern void EditUnHilite(optr o);

/* the small and common line routines behind tlExternal.goc */
