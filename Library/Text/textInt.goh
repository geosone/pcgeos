Boolean TA_RunAtEnd(dword pos);
dword CoalesceRun(optr o, TextRunKind kind);

/* tslMethodCursor.goc (for tslCursor.goc) */
void TextTimerStart(optr o, Message msg);

/* tslMisc.goc (for tslInvert.goc) */
