/* tlSmallStorage.goc (for tlSmallLineInfo.goc) */
optr Lines(optr o);

/* tslCursor.goc (for tslMethodCursor.goc) */
Boolean CursorNoFocus(optr o);
void CursorToggle(optr o);

/* tslMain.goc (for textCompatibility.goc) */
void SelectRange(optr o, dword start, dword end);

/* a WBFixed as a 24.8 number */
#define TEXT_WBF(w)	(((sdword) (w)->WBF_int << 8) + (w)->WBF_frac)

/* textUtils.goc (for textInstance.goc) */
void SendToTextOutputLowIfNotSelf(optr o, Message msg, const void *args,
	word size);

