/*
 * textInt.goh -- the text library in C (Port32), internal: the routines
 * the modules call in each other (after textstorage.def, texttext.def,
 * textselect.def, textattr.def).
 *
 * Port32 (Port32/ABI.md section 13z): small text objects only so far
 * (the text in a chunk of the object's block); the text is in bytes
 * (no DBCS).
 */
#ifndef __TEXTINT_GOH
#define __TEXTINT_GOH

@include <stdapp.goh>
@include <Objects/vTextC.goh>
#include <string.h>

#define VT(o)	((VisTextInstance *) ObjDerefVis(o))

/* the first size of a text chunk: the null (TEXT_INIT_STREAM) */
#define TEXT_INIT_STREAM	1
#define INITIAL_LEFT_OFFSET	0

/* TextStorage/tsExternal.goc: the text of an object */
extern void TS_SmallCreateTextStorage(optr o);
extern dword TS_GetTextSize(optr o);
/* the text from an offset on (till the next change of the object's
 * block), *after the characters from there */
extern const char *TS_LockTextPtr(optr o, dword offset, word *after);
extern word TS_GetCharAtOffset(optr o, dword offset);
/* FALSE: the object would hold more than VTI_maxLength (VTRF_TRUNCATE
 * cuts the insertion instead) */
extern Boolean TS_CheckLegalChange(optr o, VisTextReplaceParameters *p);
extern void TS_ReplaceRange(optr o, VisTextReplaceParameters *p);
/* the range (real, within the text) into the reference, with a null;
 * the characters copied */
extern dword TS_GetTextRange(optr o, const VisTextRange *range,
			     TextReference *ref);

/* TextStorage/tsParams.goc: INSERT_COMPUTE_TEXT_LENGTH resolved; the
 * size of the text of a reference, without its null */
extern void TS_GetReplaceSize(optr o, VisTextReplaceParameters *p);
extern dword TS_ComputeReferenceSize(const TextReference *ref);

/* TextStorage/tsReference.goc: count characters of the reference to
 * dest; the buffer of a reference to write size bytes to (a chunk or a
 * block is made that large), and the block to unlock afterwards */
extern void TS_CopyTextReference(char *dest, const TextReference *ref,
				 dword count);
extern char *TS_LockReferenceForWrite(TextReference *ref, dword size,
				      MemHandle *unlock);
extern void TS_UnlockReference(MemHandle unlock);

/* TextAttr/taRange.goc: a virtual range (the selection, the end of the
 * text) made real */
extern void TA_GetTextRange(optr o, VisTextRange *range,
			    VisTextRangeContext context);

/* TextAttr/taCharAttr.goc: the single character attribute of an
 * object, and the default records (VisTextDefaultCharAttr) */
extern void TA_MapDefaultCharAttr(VisTextDefaultCharAttr def,
				  VisTextCharAttr *a);
extern Boolean TA_FindDefaultCharAttr(const VisTextCharAttr *a,
				      VisTextDefaultCharAttr *def);
extern void TA_GetSingleCharAttr(optr o, VisTextCharAttr *a);
extern void TA_SetSingleCharAttr(optr o, const VisTextCharAttr *a);

/* TextSelect/tslMain.goc: the selection */
extern void TSL_SelectGetSelection(optr o, dword *start, dword *end);
extern Boolean TSL_SelectIsCursor(optr o);
extern void TSL_SelectSetSelection(optr o, dword start, dword end);
extern void TSL_SelectSetSelectionWithoutNukingUndo(optr o, dword start,
						    dword end);

/* Text/textMethodSet.goc: the replacement all changes of the text go
 * through (VisTextReplaceNew); TRUE if it was not made */
extern Boolean VisTextReplace(optr o, VisTextReplaceParameters *p);
extern void TextMarkUserModified(optr o);
extern void TextMarkNotUserModified(optr o);

/* Text/textUtils.goc: a message to VTI_output with the object */
extern void SendToTextOutput(optr o, Message msg);

/* TextAttr/taParaAttr.goc: the paragraph attribute; the attributes to
 * draw with */
extern void TA_MapDefaultParaAttr(VisTextDefaultParaAttr def,
				  VisTextParaAttr *a);
extern void TA_GetSingleParaAttr(optr o, VisTextMaxParaAttr *a);
extern void TA_GetParaAttrForPosition(optr o, dword pos,
				      VisTextMaxParaAttr *a, dword *start,
				      dword *end);
extern VisTextExtendedStyles TA_FillTextAttrForDraw(optr o, dword pos,
						    TextAttr *ta,
						    dword *count);

/* a one line object is as wide as a paragraph may be */
#define VIS_TEXT_ONE_LINE_RIGHT_MARGIN	4000
#define TA_TYPE				0x03	/* TabAttributes: TabType */

/* Text/textGState.goc: the gstate the object calculates and draws
 * with (VTI_gstate), counted */
extern void TextGStateCreate(optr o);
extern void TextGStateDestroy(optr o);

/* TextLine/tlSmallStorage.goc: the lines */
#define TL_LINE_SIZE(fields) \
	(offsetof(LineInfo, LI_firstField) + (fields) * sizeof(FieldInfo))
extern void TL_LineStorageCreate(optr o);
extern void TL_LineStorageDestroy(optr o);
extern dword TL_LineGetCount(optr o);
extern LineInfo *TL_LinePtr(optr o, dword line, word *size);
extern void TL_LineInsert(optr o, dword line, word count);
extern void TL_LineDelete(optr o, dword line, word count);
extern void TL_LineSetFieldCount(optr o, dword line, word fields);
extern word TL_LineGetFieldCount(optr o, dword line);
extern dword TL_LineGetCharCount(const LineInfo *li);
extern void TL_LineSetCharCount(LineInfo *li, dword count);
extern dword TL_LineToOffsetStart(optr o, dword line);
extern dword TL_LineFromOffset(optr o, dword offset, Boolean first,
			       dword *start);
extern WBFixed TL_LineGetTop(optr o, dword line);

/* the state of a calculation (texttext.def) */
typedef ByteFlags CalcFlags;
#define CF_SAVE_RESULTS		0x80
#define CF_LINE_CHANGED		0x40	/* the line calculated changed */
#define CF_LINE_SHORTER		0x20
#define CF_TEXT_LOCKED		0x10
#define CF_FORCE_CHANGED	0x08

typedef struct {
    optr		LICL_object;
    VisTextRange	LICL_range;	/* start: the line to calculate
					 * (then the next); end: of the
					 * change */
    dword		LICL_startPos;	/* the start of the change */
    CalcFlags		LICL_calcFlags;
    dword		LICL_line;
    dword		LICL_regionTopLine;
    WBFixed		LICL_lineBottom; /* the top of the line */
    WBFixed		LICL_lineHeight;
    WBFixed		LICL_oldLineHeight;
    dword		LICL_lineStart;
    sdword		LICL_lineStartChange;
    sdword		LICL_insertedSpace;	/* 1/256 */
    LineFlags		LICL_lineFlags;
    LineFlags		LICL_oldLineFlags;
    word		LICL_lineEnd;
    word		LICL_lineJustEnd;
    word		LICL_lastFieldJustWidth;
    byte		LICL_lastFieldTabType;
    TabReference	LICL_tabReference;
    word		LICL_extStylePos;
    word		LICL_field;	/* the field being measured */
    word		LICL_realRightMargin;
    dword		LICL_paraAttrStart;
    dword		LICL_paraAttrEnd;
    VisTextMaxParaAttr	LICL_theParaAttr;
} LICL_vars;

/* TextLine/tlCommonCalc.goc */
extern void TL_LineCalculate(LICL_vars *l, LineFlags flags);
extern word TL_TabGetPositionAndAttributes(LICL_vars *l, Boolean paraStart,
					   word endPrevField,
					   TabReference ref, byte *attr);

/* Text/textCalc.goc: the lines calculated again */
extern void T_GetNewParaAttr(LICL_vars *l, dword pos);
extern void TextCompleteRecalc(optr o);
extern void TextRecalc(optr o, dword start, dword inserted, dword deleted);

/* Text/textMethodDraw.goc */
#define TCBF_MSG_DRAW		0x80	/* answering MSG_VIS_DRAW */
#define TCBF_DRAW_ALL_LINES	0x40
#define TCBF_PRINT		0x20
extern void TextDraw(optr o, byte flags, Boolean onlyMarked);
extern void TextScreenUpdate(optr o);

#endif
