extern void DrawBorderIfAny(LICL_vars *l, VisTextParaBorderFlags ignore);
extern void TextDrawBorder(LICL_vars *l, VisTextParaBorderFlags ignore);
extern void GetPrevNextBorder(LICL_vars *l);
