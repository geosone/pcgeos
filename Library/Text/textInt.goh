/*
 * textInt.goh -- the text library in C (Port32), internal: the routines
 * the modules call in each other (after textstorage.def, texttext.def,
 * textselect.def, textattr.def).
 *
 * Port32 (Port32/ABI.md section 13z): small text objects only so far
 * (the text in a chunk of the object's block); the text is in bytes
 * (no DBCS).
 */
#ifndef __TEXTINT_GOH
#define __TEXTINT_GOH

@include <stdapp.goh>
@include <Objects/vTextC.goh>
#include <string.h>

#define VT(o)	((VisTextInstance *) ObjDerefVis(o))

/* the first size of a text chunk: the null (TEXT_INIT_STREAM) */
#define TEXT_INIT_STREAM	1
#define INITIAL_LEFT_OFFSET	0

/* TextStorage/tsExternal.goc: the text of an object */
extern void TS_SmallCreateTextStorage(optr o);
extern dword TS_GetTextSize(optr o);
/* the text from an offset on (till the next change of the object's
 * block), *after the characters from there */
extern const char *TS_LockTextPtr(optr o, dword offset, word *after);
extern word TS_GetCharAtOffset(optr o, dword offset);
/* FALSE: the object would hold more than VTI_maxLength (VTRF_TRUNCATE
 * cuts the insertion instead) */
extern Boolean TS_CheckLegalChange(optr o, VisTextReplaceParameters *p);
extern void TS_ReplaceRange(optr o, VisTextReplaceParameters *p);
/* the range (real, within the text) into the reference, with a null;
 * the characters copied */
extern dword TS_GetTextRange(optr o, const VisTextRange *range,
			     TextReference *ref);

/* TextStorage/tsParams.goc: INSERT_COMPUTE_TEXT_LENGTH resolved; the
 * size of the text of a reference, without its null */
extern void TS_GetReplaceSize(optr o, VisTextReplaceParameters *p);
extern dword TS_ComputeReferenceSize(const TextReference *ref);

/* TextStorage/tsReference.goc: count characters of the reference to
 * dest; the buffer of a reference to write size bytes to (a chunk or a
 * block is made that large), and the block to unlock afterwards */
extern void TS_CopyTextReference(char *dest, const TextReference *ref,
				 dword count);
extern char *TS_LockReferenceForWrite(TextReference *ref, dword size,
				      MemHandle *unlock);
extern void TS_UnlockReference(MemHandle unlock);

/* TextAttr/taRange.goc: a virtual range (the selection, the end of the
 * text) made real */
extern void TA_GetTextRange(optr o, VisTextRange *range,
			    VisTextRangeContext context);

/* TextAttr/taCharAttr.goc: the single character attribute of an
 * object, and the default records (VisTextDefaultCharAttr) */
extern void TA_MapDefaultCharAttr(VisTextDefaultCharAttr def,
				  VisTextCharAttr *a);
extern Boolean TA_FindDefaultCharAttr(const VisTextCharAttr *a,
				      VisTextDefaultCharAttr *def);
extern void TA_GetSingleCharAttr(optr o, VisTextCharAttr *a);
extern void TA_SetSingleCharAttr(optr o, const VisTextCharAttr *a);
/* ReflectChangeUpdateGeneric: after an attribute changed, the lines
 * made again and drawn (with the object's gstate), the selection
 * shown, the object told */
extern void ReflectChangeUpdateGeneric(optr o);

/* TextAttr/taRunLow.goc and beside: the attribute runs (VTSF_MULTIPLE_CHAR_ATTRS,
 * VTSF_MULTIPLE_PARA_ATTRS) */
typedef enum { TRK_CHAR_ATTR, TRK_PARA_ATTR } TextRunKind;
/* the element (a VisTextCharAttr or VisTextMaxParaAttr) changed */
typedef void TA_ModifyCallback(optr o, void *element, void *data);
extern word TA_RunForPosition(optr o, TextRunKind kind, dword pos,
			      Boolean left);
extern dword TA_RunPosition(optr o, TextRunKind kind, word run);
extern word TA_RunToken(optr o, TextRunKind kind, word run);
extern void TA_GetElement(optr o, TextRunKind kind, word token, void *buf);
extern word TA_AddElement(optr o, TextRunKind kind, void *element);
extern void TA_ElementAddRef(optr o, TextRunKind kind, word token);
extern void TA_RemoveElement(optr o, TextRunKind kind, word token);
extern Boolean TSL_IsParagraphStart(optr o, dword pos);
/* TRUE at a carriage return or the end of the text (*atEnd then) */
extern Boolean TSL_IsParagraphEnd(optr o, dword pos, Boolean *atEnd);
/* *pos to the carriage return at or after it; FALSE (at the end of the
 * text) if there is none */
extern Boolean TSL_FindParagraphEnd(optr o, dword *pos);
extern dword TSL_FindParagraphStart(optr o, dword pos);
/* the attribute of the range changed by cb (or, with none, set to the
 * element token) */
extern dword TA_ModifyRun(optr o, TextRunKind kind, dword start,
			  dword end, TA_ModifyCallback *cb, void *data,
			  word token);
/* before the text is replaced: the runs moved; TRUE if the attributes
 * shown may have changed */
extern Boolean TA_UpdateRunsForReplacement(optr o,
					   const VisTextReplaceParameters *p);
extern void TA_UpdateRunsForSelectionChange(optr o);
/* the character attribute at a position (insertion: for the cursor),
 * *count the characters from there that have it */
extern void TA_GetCharAttrForPosition(optr o, dword pos, Boolean insertion,
				      VisTextCharAttr *a, dword *count);

/* TextSelect/tslMain.goc: the selection */
extern void TSL_SelectGetSelection(optr o, dword *start, dword *end);
extern Boolean TSL_SelectIsCursor(optr o);
extern void TSL_SelectSetSelection(optr o, dword start, dword end);
extern void TSL_SelectSetSelectionWithoutNukingUndo(optr o, dword start,
						    dword end);
/* on the screen too (with the object's gstate): a cursor, the
 * selection grown from where it started */
extern void SelectCursor(optr o, dword offset, Boolean setGoal);
extern dword TSL_SelectGetAdjustPosition(optr o, Boolean forward);
extern void StartSelectAdjust(optr o, dword offset);

/* TextSelect/tslKbdShortcuts.goc: a key function (VisTextKeyFunction);
 * FALSE if not done */
extern Boolean TSL_HandleKbdShortcut(optr o, VisTextKeyFunction f);
/* where a line ends for the cursor */
extern dword TSL_LineCursorEnd(optr o, dword line);

/* Text/textMethodSet.goc: the replacement all changes of the text go
 * through (VisTextReplaceNew); TRUE if it was not made */
extern Boolean VisTextReplace(optr o, VisTextReplaceParameters *p);
/* Text/textFilter.goc: TRUE to refuse */
extern Boolean FilterReplacement(optr o, VisTextReplaceParameters *p);
extern Boolean TF_CheckIfCharFiltered(optr o, word c);
/* Text/textScrollOneLine.goc */
extern void TextScrollOneLine(optr o, dword offset);
extern void TextMarkUserModified(optr o);
extern void TextMarkNotUserModified(optr o);

/* Text/textUtils.goc: a message to VTI_output with the object */
extern void SendToTextOutput(optr o, Message msg);

/* TextAttr/taParaAttr.goc: the paragraph attribute; the attributes to
 * draw with */
extern void TA_MapDefaultParaAttr(VisTextDefaultParaAttr def,
				  VisTextParaAttr *a);
extern void TA_GetSingleParaAttr(optr o, VisTextMaxParaAttr *a);
extern void TA_SetSingleParaAttr(optr o, const VisTextMaxParaAttr *a);
/* CalcParaAttrSize: the attribute with its tabs */
#define TA_ParaAttrSize(a) \
    ((word) (offsetof(VisTextMaxParaAttr, VTMPA_tabs) + \
	     ((const VisTextParaAttr *) (a))->VTPA_numberOfTabs * sizeof(Tab)))
extern void TA_GetParaAttrForPosition(optr o, dword pos,
				      VisTextMaxParaAttr *a, dword *start,
				      dword *end);
extern VisTextExtendedStyles TA_FillTextAttrForDraw(optr o, dword pos,
						    TextAttr *ta,
						    dword *count);

/* a one line object is as wide as a paragraph may be */
#define VIS_TEXT_ONE_LINE_RIGHT_MARGIN	4000
#define TA_TYPE				0x03	/* TabAttributes: TabType */

/* Text/textGState.goc: the gstate the object calculates and draws
 * with (VTI_gstate), counted */
extern void TextGStateCreate(optr o);
extern void TextGStateDestroy(optr o);

/* TextLine/tlSmallStorage.goc: the lines */
#define TL_LINE_SIZE(fields) \
	(offsetof(LineInfo, LI_firstField) + (fields) * sizeof(FieldInfo))
extern void TL_LineStorageCreate(optr o);
extern void TL_LineStorageDestroy(optr o);
extern dword TL_LineGetCount(optr o);
extern LineInfo *SmallGetLinePointer(optr o, dword line, word *size);
extern void TL_LineInsert(optr o, dword line, word count);
extern void TL_LineDelete(optr o, dword line, word count);
extern void SmallLineAddField(optr o, dword line, word fields);
extern word TL_LineGetFieldCount(optr o, dword line);
extern dword TL_LineGetCharCount(const LineInfo *li);
extern void TL_LineSetCharCount(LineInfo *li, dword count);
extern dword TL_LineToOffsetStart(optr o, dword line);
extern dword TL_LineFromOffset(optr o, dword offset, Boolean first,
			       dword *start);
extern WBFixed TL_LineGetTop(optr o, dword line);

/* the state of a calculation (texttext.def) */
typedef ByteFlags CalcFlags;
#define CF_SAVE_RESULTS		0x80
#define CF_LINE_CHANGED		0x40	/* the line calculated changed */
#define CF_LINE_SHORTER		0x20
#define CF_TEXT_LOCKED		0x10
#define CF_FORCE_CHANGED	0x08

typedef struct {
    optr		LICL_object;
    VisTextRange	LICL_range;	/* start: the line to calculate
					 * (then the next); end: of the
					 * change */
    dword		LICL_startPos;	/* the start of the change */
    CalcFlags		LICL_calcFlags;
    dword		LICL_line;
    dword		LICL_regionTopLine;
    WBFixed		LICL_lineBottom; /* the top of the line */
    WBFixed		LICL_lineHeight;
    WBFixed		LICL_oldLineHeight;
    dword		LICL_lineStart;
    sdword		LICL_lineStartChange;
    sdword		LICL_insertedSpace;	/* 1/256 */
    LineFlags		LICL_lineFlags;
    LineFlags		LICL_oldLineFlags;
    word		LICL_lineEnd;
    word		LICL_lineJustEnd;
    word		LICL_lastFieldJustWidth;
    byte		LICL_lastFieldTabType;
    TabReference	LICL_tabReference;
    word		LICL_extStylePos;
    word		LICL_field;	/* the field being measured */
    word		LICL_realRightMargin;
    dword		LICL_paraAttrStart;
    dword		LICL_paraAttrEnd;
    VisTextMaxParaAttr	LICL_theParaAttr;
} LICL_vars;

/* TextLine/tlCommonCalc.goc */
extern void TL_LineCalculate(LICL_vars *l, LineFlags flags);
extern word TabGetPositionAndAttributes(LICL_vars *l, Boolean paraStart,
					   word endPrevField,
					   TabReference ref, byte *attr);

/* Text/textCalc.goc: the lines calculated again */
extern void T_GetNewParaAttr(LICL_vars *l, dword pos);
extern void T_EnsureCorrectParaAttr(LICL_vars *l, dword pos);
extern void TextCompleteRecalc(optr o);
void SmallRegionAdjustHeight(optr o, WBFixed before);
extern void TextRecalc(optr o, dword start, dword inserted, dword deleted);

/* Text/textMethodDraw.goc */
#define TCBF_MSG_DRAW		0x80	/* answering MSG_VIS_DRAW */
#define TCBF_DRAW_ALL_LINES	0x40
#define TCBF_PRINT		0x20
extern void TextDraw(optr o, byte flags, Boolean onlyMarked);
extern void TextScreenUpdate(optr o);
/* the object's gstate moved to the text (inside the margins) and
 * clipped to it; between GrSaveState and GrRestoreState */
extern void SmallRegionTransformGState(optr o, Boolean print);

/* TextLine/tlCommonPosition.goc: positions on a line (from its left
 * edge, LI_adjustment), the line at a height */
extern dword TL_LineTextPosition(optr o, dword line, sword pixel,
				 dword stop, sword *x, Boolean *over);
extern dword TL_LineFromPosition(optr o, sword y, Boolean *below);

/* TextSelect/tslCursor.goc: the cursor */
extern Boolean TextCheckCanDraw(optr o);
extern Boolean TextCheckCanDrawEditable(optr o);
extern void TSL_ConvertOffsetToCoordinate(optr o, dword offset, sword *x,
					  sword *y);
extern dword TSL_GetCursorLine(optr o);
extern void CursorEnable(optr o);
extern void CursorDisable(optr o);
extern void CursorForceOn(optr o);
extern void TSL_CursorDrawIfOn(optr o);
extern void TSL_CursorPosition(optr o, sword x, sword y);
extern void TSL_StartCursorCommon(optr o);
extern void TSL_StopCursorTimer(optr o);

/* TextSelect/tslInvert.goc: the selection on the screen, shown and
 * taken away (with the object's gstate) */
extern void TSL_DrawHilite(optr o, dword start, dword end);
extern void EditHilite(optr o);
extern void EditUnHilite(optr o);

/* the small and common line routines behind tlExternal.goc */
void CommonLineCalculate(LICL_vars *l, LineFlags flags);
dword CommonLineTextPosition(optr o, dword line, sword pixel, dword stop, sword *x, Boolean *over);
void SmallStorageCreate(optr o);
void SmallStorageDestroy(optr o);
dword SmallLineGetCount(optr o);
void SmallLineInsert(optr o, dword line, word count);
void SmallLineDelete(optr o, dword line, word count);
dword SmallLineToOffsetStart(optr o, dword line);
dword SmallLineFromOffsetGetStart(optr o, dword offset, Boolean first, dword *start);
WBFixed SmallLineGetTop(optr o, dword line);

/* taAttr.goc (for taParaAttr.goc) */
void SelectTab(optr o, word pos);

/* taElement.goc (for taRunLow.goc) */
word GetInsertionElement(optr o);
word ClearInsertionElement(optr o, Boolean unref);
void SetInsertionElement(optr o, word token);

/* taRunManip.goc (for taRunLow.goc) */
optr TA_RunArray(optr o, TextRunKind kind);
void TA_SetRunPos(optr o, TextRunKind kind, word i, dword pos);
Boolean TA_RunAtEnd(dword pos);
dword CoalesceRun(optr o, TextRunKind kind);

/* tslMethodCursor.goc (for tslCursor.goc) */
void TextTimerStart(optr o, Message msg);

/* tslMisc.goc (for tslInvert.goc) */
void InvertRange(optr o, dword start, dword end);

/* tslUtils.goc (for tslKbdShortcuts.goc) */
Boolean TSL_IsWordPart(optr o, dword offset);
dword FindNextWordEdge(optr o, dword off);
dword FindPreviousWordEdge(optr o, dword off);
dword FindPreviousParagraphEdge(optr o, dword off);
dword FindNextParagraphEdge(optr o, dword off);

/* taRunLow.goc (for taRunManip.goc) */
TextRunArrayElement *TA_Run(optr o, TextRunKind kind, word i);
void TA_RunInsert(optr o, TextRunKind kind, word i, dword pos,
	word token);

/* taCharAttr.goc (for taAttr.goc) */
Boolean FixupRange(optr o, VisTextRange *r, dword start, dword end);

/* taParaAttr.goc (for taAttr.goc) */
void ChangeParaAttr(optr o, dword start, dword end,
	TA_ModifyCallback *cb, void *data);

/* tlSmallStorage.goc (for tlSmallLineInfo.goc) */
optr Lines(optr o);

/* tslCursor.goc (for tslMethodCursor.goc) */
Boolean CursorNoFocus(optr o);
void CursorToggle(optr o);

/* tslMain.goc (for textCompatibility.goc) */
void SelectRange(optr o, dword start, dword end);

/* a WBFixed as a 24.8 number */
#define TEXT_WBF(w)	(((sdword) (w)->WBF_int << 8) + (w)->WBF_frac)

/* textUtils.goc (for textInstance.goc) */
void SendToTextOutputLowIfNotSelf(optr o, Message msg, const void *args,
	word size);

/* taRunQuery.goc (for textMethodGeometry.goc) */
word TA_CharAttrRunSetupGStateForCalc(optr o, GFM_info info);

/* taCharAttr.goc (for taAttr.goc) */
void CharAttrChangeCommon(optr o, dword start, dword end,
	TA_ModifyCallback *cb, void *data);

/* taParaAttr.goc (for taAttr.goc) */
void ParaAttrChangeCommon(optr o, dword start, dword end,
	TA_ModifyCallback *cb, word v);

/* taCharAttr.goc (for taParaAttr.goc) */
Boolean UnHiliteAndFixupParaAttrRange(optr o, VisTextRange *r, dword start,
	dword end);

/* taRunLow.goc (for taRunManip.goc) */
void RunArrayDelete(optr o, TextRunKind kind, word i);

/* tslMethodMouse.goc (for tslKbdShortcuts.goc) */
dword ComputeEventPositionAndOffset(optr o, dword line);

/* textMethodDraw.goc (for trSmallGState.goc) */
void TextSize(optr o, sword *width, sword *height);

/* trSmallClear.goc (for textMethodDraw.goc) */
void ClearRectCommon(optr o, sword left, sword top, sword right,
	sword bottom);

/* trSmallClear.goc */
void SmallRegionClearToBottom(optr o);

/* tlCommonDraw.goc (for textMethodDraw.goc) */
word FieldDrawStyleCallback(GDF_vars *v, TextAttr *attr, word offset,
	Boolean first, const char **text);

/* tlCommonInit.goc (for tlSmallStorage.goc) */
void CommonInitLineAndField(LineInfo *li);

/* tslMain.goc (for tslMethodMouse.goc) */
void SetShown(optr o, dword start, dword end, dword show);

#endif
