/*
 * tslMethodFocus.goc -- the focus and the target (after
 * tslMethodFocus.asm).
 *
 * The object with the system's focus shows its cursor (flashing) and
 * gets the keyboard; it keeps its gstate as long.  The target shows
 * its selection: the system's target (TEMP_VIS_TEXT_SYS_TARGET) also
 * without the focus.
 *
 * Port32 (Port32/ABI.md section 13z), not yet: the notifications of the
 * focus text object for the application's GCN list and of the
 * selection's context, undo, the FEP.
 */
@include "textInt.goh"
#include <Internal/specUI.h>
#include <timer.h>


/* the focus flag changed: a range of the system's target looks the
 * same with and without the focus */
static void SetFocus(optr o, Boolean focus)
{
    Boolean same = ObjVarFindData(o, TEMP_VIS_TEXT_SYS_TARGET) &&
		   !TSL_SelectIsCursor(o);

    if (!same)
	EditUnHilite(o);
    if (focus)
	VT(o)->VTI_intSelFlags |= VTISF_IS_FOCUS;
    else
	VT(o)->VTI_intSelFlags &= ~VTISF_IS_FOCUS;
    if (!same)
	EditHilite(o);
}

/* VisTextGainedFocusExcl */
@extern method VisTextClass, MSG_META_GAINED_SYS_FOCUS_EXCL
{
    if (pself->VTI_intSelFlags & VTISF_IS_FOCUS)
	return;
    TextGStateCreate(oself);
    SetFocus(oself, TRUE);
    TSL_StartCursorCommon(oself);
    SendToTextOutput(oself, MSG_META_TEXT_GAINED_FOCUS);
    VisForceGrabKbd(oself);
}

/* VisTextLostFocusExcl */
@extern method VisTextClass, MSG_META_LOST_SYS_FOCUS_EXCL
{
    if (!(pself->VTI_intSelFlags & VTISF_IS_FOCUS))
	return;
    TSL_StopCursorTimer(oself);
    /* (the cursor as it stands when not flashing, then taken away) */
    CursorForceOn(oself);
    SetFocus(oself, FALSE);
    TextGStateDestroy(oself);
    SendToTextOutput(oself, MSG_META_TEXT_LOST_FOCUS);
    VisReleaseKbd(oself);
}

/* ChangeSelectionFlags */
static void SetTarget(optr o, Boolean target, Message msg)
{
    TextGStateCreate(o);
    EditUnHilite(o);
    if (target)
	VT(o)->VTI_intSelFlags |= VTISF_IS_TARGET;
    else
	VT(o)->VTI_intSelFlags &= ~VTISF_IS_TARGET;
    EditHilite(o);
    TextGStateDestroy(o);
    SendToTextOutput(o, msg);
}

/* VisTextGainedTargetExcl: the controllers told (when on the screen),
 * the selection shown (a small object unless
 * ATTR_VIS_TEXT_DONT_SHOW_POSITION_ON_GAINED_TARGET_EXCL) */
@extern method VisTextClass, MSG_META_GAINED_TARGET_EXCL
{
    SetTarget(oself, TRUE, MSG_META_TEXT_GAINED_TARGET);
    if (VT(oself)->VI_attrs & VA_REALIZED)
	TA_SendNotification(oself, VIS_TEXT_GAINED_TARGET_NOTIFICATION_FLAGS);
    if (ObjVarFindData(oself,
		       ATTR_VIS_TEXT_DONT_SHOW_POSITION_ON_GAINED_TARGET_EXCL))
	return;
    if (!ObjVarFindData(oself,
			ATTR_VIS_TEXT_SHOW_POSITION_ON_GAINED_TARGET_EXCL) &&
	(VT(oself)->VTI_storageFlags & VTSF_LARGE))
	return;
    @call oself::MSG_VIS_TEXT_SHOW_POSITION(VIS_TEXT_RANGE_SELECTION);
}

/* VisTextLostTargetExcl: the application's lists without a target */
@extern method VisTextClass, MSG_META_LOST_TARGET_EXCL
{
    SetTarget(oself, FALSE, MSG_META_TEXT_LOST_TARGET);
    TA_SendNotification(oself, 0);
}

static void SetSysTarget(optr o, Boolean target)
{
    Boolean focus = (VT(o)->VTI_intSelFlags & VTISF_IS_FOCUS) != 0;

    if (!focus) {
	TextGStateCreate(o);
	EditUnHilite(o);
    }
    if (target)
	(void) ObjVarAddData(o, TEMP_VIS_TEXT_SYS_TARGET, 0);
    else
	(void) ObjVarDeleteData(o, TEMP_VIS_TEXT_SYS_TARGET);
    if (!focus) {
	EditHilite(o);
	TextGStateDestroy(o);
    }
}

@extern method VisTextClass, MSG_META_GAINED_SYS_TARGET_EXCL
{
    SetSysTarget(oself, TRUE);
}

@extern method VisTextClass, MSG_META_LOST_SYS_TARGET_EXCL
{
    SetSysTarget(oself, FALSE);
}

/* TSL_StartCursorCommon: the cursor starts flashing */
void TSL_StartCursorCommon(optr o)
{
    VisTextInstance *t = VT(o);

    if (!(((VisInstance *) t)->VI_attrs & VA_REALIZED) ||
	t->VTI_timerHandle || !(t->VTI_state & VTS_EDITABLE) ||
	!(FlowGetUIButtonFlags() & UIBF_BLINKING_CURSOR))
	return;
    @call o::MSG_VIS_TEXT_FLASH_CURSOR_ON();
}
