/*
 * tslMisc.goc -- after tslMisc.asm: InvertRange.
 */
@include "textInt.goh"

/*
 * InvertRange (CommonLineInvertRange, LineInvertArea): the characters
 * from start to end inverted, line by line: from the line's left edge
 * or the start to the end of its last field or the end
 */
void InvertRange(optr o, dword start, dword end)
{
    VisTextInstance *t = VT(o);
    VisInstance *v = (VisInstance *) t;
    GStateHandle g = t->VTI_gstate;
    dword first, last, line, ls, s;
    word region;
    sdword top;
    WBFixed wtop;
    sword width = (sword) (v->VI_bounds.R_right - v->VI_bounds.R_left -
			   2 * t->VTI_lrMargin);

    if (start > end) {
	s = start;
	start = end;
	end = s;
    }
    last = TL_LineFromOffset(o, end, TRUE, NULL);
    first = TL_LineFromOffset(o, start, FALSE, &ls);
    if (first > last)
	return;
    wtop = TL_LineGetTop(o, first);
    top = TEXT_WBF(&wtop);
    region = TR_RegionFromLine(o, first);
    GrSaveState(g);
    for (line = first; line <= last; line++) {
	LineInfo *li;
	sdword hgt;
	dword count;
	word fields;
	sword adj, left, right, x;

	if (line == first || TR_RegionFromLine(o, line) != region) {
	    /* (each region's lines in it) */
	    if (line != first) {
		region = TR_RegionFromLine(o, line);
		top = 0;
		GrRestoreState(g);
		GrSaveState(g);
	    }
	    TR_RegionMoveGState(o, region, FALSE);
	    GrSetAreaMaskSys(g, SDM_100);
	    GrSetMixMode(g, MM_INVERT);
	    if (t->VTI_storageFlags & VTSF_LARGE)
		width = TR_RegionWidth(o, region, 0, 0);
	}
	li = TL_LineLock(o, line, NULL);
	hgt = TEXT_WBF(&li->LI_hgt);
	count = TL_LineGetCharCount(li);
	fields = TL_LineGetFieldCount(o, line);
	adj = li->LI_adjustment;

	if (hgt) {
	    if (ls >= start)
		left = adj;
	    else {
		(void) TL_LineTextPosition(o, line, 0x7fff, start, &x, NULL);
		left = (sword) (x + adj);
	    }
	    li = TL_LineRelock(o, line, li);
	    if (ls + count <= end) {
		const FieldInfo *fi = &li->LI_firstField + (fields - 1);

		right = (sword) (fi->FI_position + fi->FI_width + adj);
	    } else {
		(void) TL_LineTextPosition(o, line, 0x7fff, end, &x, NULL);
		right = (sword) (x + adj);
	    }
	    left = (sword) (left + VT(o)->VTI_leftOffset);
	    right = (sword) (right + VT(o)->VTI_leftOffset);
	    if (right > width)
		right = width;
	    if (left < right)
		GrFillRect(g, left, (sword) ((top + 0xff) >> 8), right,
			   (sword) ((top + hgt + 0xff) >> 8));
	}
	TL_LineUnlock(o, li);
	top += hgt;
	ls += count;
    }
    GrSetMixMode(g, MM_COPY);
    GrRestoreState(g);
}
