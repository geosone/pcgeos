/*
 * tslCursor.goc -- the text cursor (after tslCursor.asm,
 * tslMethodCursor.asm, of tslMisc.asm the position of an offset).
 *
 * The cursor stands at VTI_cursorPos (in the text's coordinates plus
 * VTI_leftOffset; P_y one below the top of its line) while the
 * selection is no range.  It is drawn by the specific UI
 * (SPIR_DRAW_TEXT_CURSOR), inverting, so drawing it again takes it
 * away: VTISF_CURSOR_ON says it is to be seen (the flashing turns that
 * on and off), VTISF_CURSOR_ENABLED that it is not taken away for a
 * change of the text or the selection; it is on the screen while both
 * are set and the object has the focus.
 *
 * Port32 (Port32/ABI.md section 13z): small objects.  Not yet: the
 * overstrike mode's highlight, right to left.
 */
@include "textInt.goh"
#include <Internal/specUI.h>
#include <timer.h>

@extern method VisTextClass, MSG_VIS_TEXT_FLASH_CURSOR_ON;
@extern method VisTextClass, MSG_VIS_TEXT_FLASH_CURSOR_OFF;

#define VIS_TEXT_CURSOR_FLASH	40	/* ticks on, and off */

typedef void SpecDrawTextCursorRoutine(optr o, GStateHandle gstate);

/* TextCheckCanDraw: on the screen, with lines and a gstate there */
Boolean TextCheckCanDraw(optr o)
{
    VisTextInstance *t = VT(o);
    VisInstance *v = (VisInstance *) t;

    if ((v->VI_optFlags & VOF_GEOMETRY_INVALID) ||
	(t->VTI_intFlags & VTIF_SUSPENDED) || !t->VTI_lines ||
	!(v->VI_attrs & VA_DRAWABLE) || !(v->VI_attrs & VA_REALIZED) ||
	!t->VTI_gstate)
	return FALSE;
    return GrGetWinHandle(t->VTI_gstate) != NullHandle;
}

Boolean TextCheckCanDrawEditable(optr o)
{
    return TextCheckCanDraw(o) && (VT(o)->VTI_state & VTS_EDITABLE);
}

static Boolean CursorNoFocus(optr o)
{
    return ObjVarFindData(o, ATTR_VIS_TEXT_CURSOR_NO_FOCUS) != NULL;
}

/*
 * TSL_ConvertOffsetToCoordinate: where an offset is, in the text's
 * coordinates: its left edge and the top of its line.  An offset
 * between two lines is at the start of the second.
 */
void TSL_ConvertOffsetToCoordinate(optr o, dword offset, sword *x, sword *y)
{
    dword line = TL_LineFromOffset(o, offset, FALSE, NULL);
    WBFixed top = TL_LineGetTop(o, line);
    sword pos;

    (void) TL_LineTextPosition(o, line, 0x7fff, offset, &pos, NULL);
    *x = (sword) (pos + TL_LinePtr(o, line, NULL)->LI_adjustment);
    *y = (sword) top.WBF_int;
}

/* TSL_GetCursorLine: the line the cursor is on */
dword TSL_GetCursorLine(optr o)
{
    return TL_LineFromPosition(o, VT(o)->VTI_cursorPos.P_y, NULL);
}

/*
 * CursorToggle: the cursor drawn (on, or away again): the gstate at
 * the baseline of the cursor's line, with the font and style of the
 * text there, for the specific UI
 */
static void CursorToggle(optr o)
{
    VisTextInstance *t;
    VisInstance *v;
    GStateHandle g;
    VisTextCharAttr ca;
    SpecDrawTextCursorRoutine *r;
    sword x, y, right;
    word blo;

    if (ObjVarFindData(o, ATTR_VIS_TEXT_NO_CURSOR))
	return;
    r = (SpecDrawTextCursorRoutine *)
	ProcGetLibraryEntry(UserGetSpecificUI(), SPIR_DRAW_TEXT_CURSOR);
    if (!r)
	return;
    blo = TL_LinePtr(o, TSL_GetCursorLine(o), NULL)->LI_blo.WBF_int;
    t = VT(o);
    v = (VisInstance *) t;
    g = t->VTI_gstate;
    x = t->VTI_cursorPos.P_x;
    y = (sword) (t->VTI_cursorPos.P_y - 1 + blo);
    /* never right of the text */
    right = (sword) (v->VI_bounds.R_right - v->VI_bounds.R_left -
		     2 * t->VTI_lrMargin - 1);
    if ((word) x > (word) right)
	x = right;
    GrSaveState(g);
    TextGStateToText(o, FALSE);
    GrMoveTo(g, x, y);
    TA_GetCharAttrForPosition(o, VT(o)->VTI_selectStart, TRUE, &ca, NULL);
    GrSetFont(g, ca.VTCA_fontID,
	      ((dword) ca.VTCA_pointSize.WBF_int << 16) |
	      ((dword) ca.VTCA_pointSize.WBF_frac << 8));
    GrSetTextStyle(g, ca.VTCA_textStyles, (TextStyle) ~ca.VTCA_textStyles);
    r(o, g);
    GrRestoreState(g);
}

/* EnableDisableCommon: the cursor may be on the screen, or not */
static void EnableDisable(optr o, byte want)
{
    VisTextInstance *t = VT(o);

    if ((t->VTI_intSelFlags & VTISF_CURSOR_ENABLED) == want)
	return;
    t->VTI_intSelFlags ^= VTISF_CURSOR_ENABLED;
    if (!(t->VTI_intSelFlags & VTISF_CURSOR_ON))
	return;
    if (!CursorNoFocus(o) && !(VT(o)->VTI_intSelFlags & VTISF_IS_FOCUS))
	return;
    if (TextCheckCanDrawEditable(o))
	CursorToggle(o);
}

void CursorEnable(optr o)
{
    EnableDisable(o, VTISF_CURSOR_ENABLED);
}

void CursorDisable(optr o)
{
    EnableDisable(o, 0);
}

/* CursorForceOn: the flashing cursor to be seen */
void CursorForceOn(optr o)
{
    VisTextInstance *t;

    if (!TextCheckCanDrawEditable(o))
	return;
    t = VT(o);
    t->VTI_intFlags |= VTIF_HILITED;
    if (t->VTI_intSelFlags & VTISF_CURSOR_ON)
	return;
    t->VTI_intSelFlags |= VTISF_CURSOR_ON;
    if (!(t->VTI_intSelFlags & VTISF_CURSOR_ENABLED))
	return;
    if (!CursorNoFocus(o) && !(VT(o)->VTI_intSelFlags & VTISF_IS_FOCUS))
	return;
    CursorToggle(o);
}

/* TSL_CursorDrawIfOn: after the text was drawn over it */
void TSL_CursorDrawIfOn(optr o)
{
    VisTextInstance *t;

    if (!TextCheckCanDrawEditable(o))
	return;
    t = VT(o);
    if (!(t->VTI_intSelFlags & VTISF_CURSOR_ON) ||
	!(t->VTI_intSelFlags & VTISF_CURSOR_ENABLED))
	return;
    if (!CursorNoFocus(o) && !(VT(o)->VTI_intSelFlags & VTISF_IS_FOCUS))
	return;
    CursorToggle(o);
}

/* EnsureCursorXPositionInRegion: not right of the text (a one line
 * object scrolls instead) */
static void EnsureCursorXPosition(optr o)
{
    VisTextInstance *t = VT(o);
    VisInstance *v = (VisInstance *) t;
    sword right;

    if (t->VTI_state & VTS_ONE_LINE)
	return;
    right = (sword) (v->VI_bounds.R_right - v->VI_bounds.R_left -
		     2 * t->VTI_lrMargin - 1);
    if ((word) t->VTI_cursorPos.P_x > (word) right)
	t->VTI_cursorPos.P_x = right;
}

/* TSL_CursorPosition: the cursor to a position (x with VTI_leftOffset,
 * y the top of its line) */
void TSL_CursorPosition(optr o, sword x, sword y)
{
    VisTextInstance *t;

    CursorDisable(o);
    t = VT(o);
    t->VTI_intFlags |= VTIF_HILITED;
    t->VTI_cursorPos.P_x = x;
    t->VTI_cursorPos.P_y = (sword) (y + 1);
    t->VTI_cursorRegion = 0;
    EnsureCursorXPosition(o);
    CursorEnable(o);
}

/* TSL_StartCursorCommon: the cursor starts flashing */
void TSL_StartCursorCommon(optr o)
{
    VisTextInstance *t = VT(o);

    if (!(((VisInstance *) t)->VI_attrs & VA_REALIZED) ||
	t->VTI_timerHandle || !(t->VTI_state & VTS_EDITABLE) ||
	!(FlowGetUIButtonFlags() & UIBF_BLINKING_CURSOR))
	return;
    @call o::MSG_VIS_TEXT_FLASH_CURSOR_ON();
}

/* TSL_StopCursorTimer: no more flashing */
void TSL_StopCursorTimer(optr o)
{
    VisTextInstance *t = VT(o);
    TimerHandle th = t->VTI_timerHandle;

    if (!th)
	return;
    t->VTI_timerHandle = NullHandle;
    (void) TimerStop(th, t->VTI_timerID);
}

/* TextTimerStart: the next half of a flash */
static void TextTimerStart(optr o, Message msg)
{
    word id = 0;
    TimerHandle th = TimerStart(TIMER_EVENT_ONE_SHOT, o,
				VIS_TEXT_CURSOR_FLASH, msg, 0, &id);
    VisTextInstance *t = VT(o);

    t->VTI_timerHandle = th;
    t->VTI_timerID = id;
}

/* VisTextFlashCursorOn */
@extern method VisTextClass, MSG_VIS_TEXT_FLASH_CURSOR_ON
{
    Boolean noFocus = CursorNoFocus(oself);

    pself = VT(oself);
    pself->VTI_timerHandle = NullHandle;
    if (!noFocus && !(pself->VTI_intSelFlags & VTISF_IS_FOCUS))
	return;
    if (!(pself->VTI_state & VTS_EDITABLE))
	return;
    /* (not while someone has the screen to himself) */
    if (!GrGetExclusive(NullHandle))
	CursorForceOn(oself);
    if (noFocus)
	return;
    TextTimerStart(oself, MSG_VIS_TEXT_FLASH_CURSOR_OFF);
}

/* VisTextFlashCursorOff */
@extern method VisTextClass, MSG_VIS_TEXT_FLASH_CURSOR_OFF
{
    Boolean noFocus = CursorNoFocus(oself);
    byte f;

    pself = VT(oself);
    f = pself->VTI_intSelFlags;
    pself->VTI_timerHandle = NullHandle;
    if (!noFocus && !(f & VTISF_IS_FOCUS))
	return;
    if (!(pself->VTI_state & VTS_EDITABLE))
	return;
    if (TextCheckCanDraw(oself)) {
	Boolean off = TRUE;

	if (f & VTISF_CURSOR_ENABLED) {
	    if (!(f & VTISF_CURSOR_ON) || GrGetExclusive(NullHandle))
		off = FALSE;
	    else
		CursorToggle(oself);
	}
	if (off)
	    VT(oself)->VTI_intSelFlags &= ~VTISF_CURSOR_ON;
    }
    if (noFocus)
	return;
    TextTimerStart(oself, MSG_VIS_TEXT_FLASH_CURSOR_ON);
}
