/*
 * tslCursor.goc -- the text cursor (after tslCursor.asm;
 * the cursor messages are in tslMethodCursor.goc).
 *
 * The cursor stands at VTI_cursorPos (in the text's coordinates plus
 * VTI_leftOffset; P_y one below the top of its line) while the
 * selection is no range.  It is drawn by the specific UI
 * (SPIR_DRAW_TEXT_CURSOR), inverting, so drawing it again takes it
 * away: VTISF_CURSOR_ON says it is to be seen (the flashing turns that
 * on and off), VTISF_CURSOR_ENABLED that it is not taken away for a
 * change of the text or the selection; it is on the screen while both
 * are set and the object has the focus.
 *
 * Port32 (Port32/ABI.md section 13z): small objects.  Not yet: the
 * overstrike mode's highlight, right to left.
 */
@include "textInt.goh"
#include <Internal/specUI.h>
#include <timer.h>


typedef void SpecDrawTextCursorRoutine(optr o, GStateHandle gstate);

Boolean CursorNoFocus(optr o)
{
    return ObjVarFindData(o, ATTR_VIS_TEXT_CURSOR_NO_FOCUS) != NULL;
}

/*
 * CursorToggle: the cursor drawn (on, or away again): the gstate at
 * the baseline of the cursor's line, with the font and style of the
 * text there, for the specific UI
 */
void CursorToggle(optr o)
{
    VisTextInstance *t;
    VisInstance *v;
    GStateHandle g;
    VisTextCharAttr ca;
    SpecDrawTextCursorRoutine *r;
    sword x, y, right;
    word blo;

    if (ObjVarFindData(o, ATTR_VIS_TEXT_NO_CURSOR))
	return;
    r = (SpecDrawTextCursorRoutine *)
	ProcGetLibraryEntry(UserGetSpecificUI(), SPIR_DRAW_TEXT_CURSOR);
    if (!r)
	return;
    blo = TL_LineGetBLO(o, TSL_GetCursorLine(o)).WBF_int;
    t = VT(o);
    v = (VisInstance *) t;
    g = t->VTI_gstate;
    x = t->VTI_cursorPos.P_x;
    y = (sword) (t->VTI_cursorPos.P_y - 1 + blo);
    /* never right of the text */
    right = (sword) (v->VI_bounds.R_right - v->VI_bounds.R_left -
		     2 * t->VTI_lrMargin - 1);
    if ((word) x > (word) right)
	x = right;
    GrSaveState(g);
    SmallRegionTransformGState(o, FALSE);
    GrMoveTo(g, x, y);
    TA_GetCharAttrForPosition(o, VT(o)->VTI_selectStart, TRUE, &ca, NULL);
    GrSetFont(g, ca.VTCA_fontID,
	      ((dword) ca.VTCA_pointSize.WBF_int << 16) |
	      ((dword) ca.VTCA_pointSize.WBF_frac << 8));
    GrSetTextStyle(g, ca.VTCA_textStyles, (TextStyle) ~ca.VTCA_textStyles);
    r(o, g);
    GrRestoreState(g);
}

/* EnableDisableCommon: the cursor may be on the screen, or not */
static void EnableDisable(optr o, byte want)
{
    VisTextInstance *t = VT(o);

    if ((t->VTI_intSelFlags & VTISF_CURSOR_ENABLED) == want)
	return;
    t->VTI_intSelFlags ^= VTISF_CURSOR_ENABLED;
    if (!(t->VTI_intSelFlags & VTISF_CURSOR_ON))
	return;
    if (!CursorNoFocus(o) && !(VT(o)->VTI_intSelFlags & VTISF_IS_FOCUS))
	return;
    if (TextCheckCanDrawEditable(o))
	CursorToggle(o);
}

void CursorEnable(optr o)
{
    EnableDisable(o, VTISF_CURSOR_ENABLED);
}

void CursorDisable(optr o)
{
    EnableDisable(o, 0);
}

/* CursorForceOn: the flashing cursor to be seen */
void CursorForceOn(optr o)
{
    VisTextInstance *t;

    if (!TextCheckCanDrawEditable(o))
	return;
    t = VT(o);
    t->VTI_intFlags |= VTIF_HILITED;
    if (t->VTI_intSelFlags & VTISF_CURSOR_ON)
	return;
    t->VTI_intSelFlags |= VTISF_CURSOR_ON;
    if (!(t->VTI_intSelFlags & VTISF_CURSOR_ENABLED))
	return;
    if (!CursorNoFocus(o) && !(VT(o)->VTI_intSelFlags & VTISF_IS_FOCUS))
	return;
    CursorToggle(o);
}

/* TSL_CursorDrawIfOn: after the text was drawn over it */
void TSL_CursorDrawIfOn(optr o)
{
    VisTextInstance *t;

    if (!TextCheckCanDrawEditable(o))
	return;
    t = VT(o);
    if (!(t->VTI_intSelFlags & VTISF_CURSOR_ON) ||
	!(t->VTI_intSelFlags & VTISF_CURSOR_ENABLED))
	return;
    if (!CursorNoFocus(o) && !(VT(o)->VTI_intSelFlags & VTISF_IS_FOCUS))
	return;
    CursorToggle(o);
}

/* EnsureCursorXPositionInRegion: not right of the text (a one line
 * object scrolls instead) */
static void EnsureCursorXPosition(optr o)
{
    VisTextInstance *t = VT(o);
    VisInstance *v = (VisInstance *) t;
    sword right;

    if (t->VTI_state & VTS_ONE_LINE)
	return;
    right = (sword) (v->VI_bounds.R_right - v->VI_bounds.R_left -
		     2 * t->VTI_lrMargin - 1);
    if ((word) t->VTI_cursorPos.P_x > (word) right)
	t->VTI_cursorPos.P_x = right;
}

/* TSL_CursorPosition: the cursor to a position (x with VTI_leftOffset,
 * y the top of its line) */
void TSL_CursorPosition(optr o, sword x, sword y)
{
    VisTextInstance *t;

    CursorDisable(o);
    t = VT(o);
    t->VTI_intFlags |= VTIF_HILITED;
    t->VTI_cursorPos.P_x = x;
    t->VTI_cursorPos.P_y = (sword) (y + 1);
    t->VTI_cursorRegion = 0;
    EnsureCursorXPosition(o);
    CursorEnable(o);
}

/* TSL_StopCursorTimer: no more flashing */
void TSL_StopCursorTimer(optr o)
{
    VisTextInstance *t = VT(o);
    TimerHandle th = t->VTI_timerHandle;

    if (!th)
	return;
    t->VTI_timerHandle = NullHandle;
    (void) TimerStop(th, t->VTI_timerID);
}
