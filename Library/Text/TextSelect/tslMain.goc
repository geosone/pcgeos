/*
 * tslMain.goc -- the selection (after tslMain.asm; the messages are in tslMethodSelect.goc):
 * VTI_selectStart to VTI_selectEnd, a cursor where they are the same.
 *
 * On the screen it is shown by tslInvert.goc and tslCursor.goc.
 *
 * Port32, not yet: the selection by mouse and keyboard, the context
 * notifications.
 */
@include "textInt.goh"

void TSL_SelectGetSelection(optr o, dword *start, dword *end)
{
    VisTextInstance *t = VT(o);

    *start = t->VTI_selectStart;
    *end = t->VTI_selectEnd;
}

Boolean TSL_SelectIsCursor(optr o)
{
    VisTextInstance *t = VT(o);

    return t->VTI_selectStart == t->VTI_selectEnd;
}

void TSL_SelectSetSelectionWithoutNukingUndo(optr o, dword start, dword end)
{
    VisTextInstance *t = VT(o);

    t->VTI_selectStart = start;
    t->VTI_selectEnd = end;
}

void TSL_SelectSetSelection(optr o, dword start, dword end)
{
    TSL_SelectSetSelectionWithoutNukingUndo(o, start, end);
}

/* the selection changed on the screen: the old one off, the new on
 * (the object has its gstate); a one line object scrolls to show */
void SetShown(optr o, dword start, dword end, dword show)
{
    EditUnHilite(o);
    TSL_SelectSetSelection(o, start, end);
    TextScrollOneLine(o, show);
    EditHilite(o);
    TA_UpdateRunsForSelectionChange(o);
}

/*
 * SelectGetAdjustPosition: the end of the selection that moves when
 * it is adjusted: the one away from where it started
 * (VTI_selectMinStart to VTI_selectMinEnd); of a selection that is
 * only that the end to adjust forward, the start to adjust backward
 */
dword TSL_SelectGetAdjustPosition(optr o, Boolean forward)
{
    VisTextInstance *t = VT(o);

    if (t->VTI_selectStart != t->VTI_selectMinStart)
	return t->VTI_selectStart;
    if (t->VTI_selectEnd != t->VTI_selectMinEnd)
	return t->VTI_selectEnd;
    return forward ? t->VTI_selectEnd : t->VTI_selectStart;
}

/* the range made real, kept within the text and in order */
void SelectRange(optr o, dword start, dword end)
{
    VisTextRange r;
    dword size = TS_GetTextSize(o);

    r.VTR_start = start;
    r.VTR_end = end;
    TA_GetTextRange(o, &r, 0);
    if (r.VTR_start > size)
	r.VTR_start = size;
    if (r.VTR_end > size)
	r.VTR_end = size;
    if (r.VTR_end < r.VTR_start) {
	dword s = r.VTR_start;

	r.VTR_start = r.VTR_end;
	r.VTR_end = s;
    }
    /* UpdateSelectedArea: the old one off the screen, the new one on */
    TextGStateCreate(o);
    EditUnHilite(o);
    if (VT(o)->VTI_selectStart != r.VTR_start ||
	VT(o)->VTI_selectEnd != r.VTR_end)
	TA_UpdateRunsForSelectionChange(o);
    TSL_SelectSetSelection(o, r.VTR_start, r.VTR_end);
    TextScrollOneLine(o, r.VTR_end);
    EditHilite(o);
    VT(o)->VTI_selectMinStart = r.VTR_start;
    VT(o)->VTI_selectMinEnd = r.VTR_start;
    /* (VisTextSelectRangeNew, on the screen) the goal where the cursor
     * is, the start shown, the controllers told */
    if (TextCheckCanDraw(o)) {
	VT(o)->VTI_goalPosition = VT(o)->VTI_cursorPos.P_x;
	TextCallShowSelection(o, r.VTR_start, 0);
	TA_SendNotification(o, VIS_TEXT_STANDARD_NOTIFICATION_FLAGS);
    }
    TextGStateDestroy(o);
}
