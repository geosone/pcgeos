/* VisTextInitialize */
@method VisTextClass, MSG_META_INITIALIZE
{
    @callsuper();
    pself = VT(oself);
    pself->VI_attrs |= VA_FULLY_ENABLED;
    pself->VI_geoAttrs |= VGA_NOTIFY_GEOMETRY_VALID;
    pself->VTI_state = VTS_EDITABLE | VTS_SELECTABLE;
    pself->VTI_intFlags = 0;
    pself->VTI_storageFlags = VTSF_DEFAULT_CHAR_ATTR | VTSF_DEFAULT_PARA_ATTR;
    pself->VTI_paraAttrRuns = VIS_TEXT_INITIAL_PARA_ATTR;
    TS_SmallCreateTextStorage(oself);
    pself = VT(oself);
    pself->VTI_maxLength = 0xffff;
    pself->VTI_leftOffset = INITIAL_LEFT_OFFSET;
    memset(&pself->VTI_washColor, 0, sizeof(pself->VTI_washColor));
    pself->VTI_washColor.CQ_redOrIndex = C_WHITE;
    pself->VTI_washColor.CQ_info = CF_INDEX;
    pself->VTI_charAttrRuns = VIS_TEXT_INITIAL_CHAR_ATTR;
}

@method VisTextClass, MSG_VIS_TEXT_SET_FILTER
{
    pself->VTI_filters = filter;
}

@method VisTextClass, MSG_VIS_TEXT_GET_FILTER
{
    return pself->VTI_filters;
}

@method VisTextClass, MSG_VIS_TEXT_SET_OUTPUT
{
    pself->VTI_output = newOutput;
}

@method VisTextClass, MSG_VIS_TEXT_GET_OUTPUT
{
    return pself->VTI_output;
}

@method VisTextClass, MSG_VIS_TEXT_SET_LR_MARGIN
{
    pself->VTI_lrMargin = lrMargin;
}

@method VisTextClass, MSG_VIS_TEXT_GET_LR_MARGIN
{
    return pself->VTI_lrMargin;
}

@method VisTextClass, MSG_VIS_TEXT_SET_TB_MARGIN
{
    pself->VTI_tbMargin = tbMargin;
}

@method VisTextClass, MSG_VIS_TEXT_GET_TB_MARGIN
{
    return pself->VTI_tbMargin;
}

/* SendToTextOutput (textUtils.asm): the message with the object to
 * VTI_output; a generic text object's goes as its action */
void SendToTextOutput(optr o, Message msg)
{
    optr out = VT(o)->VTI_output;
    EventHandle ev;

    if (!out)
	return;
    if (VT(o)->VI_typeFlags & VTF_IS_GEN) {
	CObjMessageP(MF_RECORD, 0, msg, &o, sizeof(o), &ev, sizeof(ev));
	@call o::MSG_GEN_OUTPUT_ACTION(ev, out);
    } else
	CObjMessageP(0, out, msg, &o, sizeof(o), NULL, 0);
}
