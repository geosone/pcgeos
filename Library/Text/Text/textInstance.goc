/*
 * textInstance.goc -- VisTextClass (after textInstance.asm): the class,
 * a new object, the plain instance data.
 *
 * A new text object is editable and selectable, empty, with the default
 * character and paragraph attributes, as long as it likes
 * (VTI_maxLength), on white.
 *
 * Port32 (Port32/ABI.md section 13z), not yet: the system's character
 * attributes (TextGetSystemCharAttrRun: the default attributes are
 * used), relocation, freeing the storage, the navigation query.
 */
@include "textInt.goh"

@classdecl VisTextClass;

