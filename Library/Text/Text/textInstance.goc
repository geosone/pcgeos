/*
 * textInstance.goc -- VisTextClass (after textInstance.asm; its class
 * record is in tVariable.goc, after tVariable.def):
 * a new object, the plain instance data.
 *
 * A new text object is editable and selectable, empty, with the default
 * character and paragraph attributes, as long as it likes
 * (VTI_maxLength), on white.
 *
 * Port32 (Port32/ABI.md section 13z), not yet: relocation, freeing the
 * storage, the navigation query.
 */
@include "textInt.goh"
#include <Internal/specUI.h>


/* VisTextInitialize */
/*
 * T_GetSystemCharAttr: the default attributes with the specific UI's
 * font and point size (SPIR_GET_DISPLAY_SCHEME), in black; without a
 * specific UI the defaults
 */
static void GetSystemCharAttr(VisTextCharAttr *a)
{
    GeodeHandle ui = UserGetLoadedSpecificUI();
    void (*get)(DisplayScheme *) = ui ? (void (*)(DisplayScheme *))
		ProcGetLibraryEntry(ui, SPIR_GET_DISPLAY_SCHEME) : NULL;
    DisplayScheme ds;

    TA_MapDefaultCharAttr(VIS_TEXT_INITIAL_CHAR_ATTR, a);
    if (!get)
	return;
    memset(&ds, 0, sizeof(ds));
    get(&ds);
    if (!ds.DS_fontID || ds.DS_pointSize <= 0)
	return;
    a->VTCA_pointSize.WBF_int = (word) ds.DS_pointSize;
    a->VTCA_pointSize.WBF_frac = 0;
    a->VTCA_fontID = ds.DS_fontID;
    a->VTCA_color.CQ_redOrIndex = C_BLACK;
}

/*
 * TextGetSystemCharAttrRun: the character attributes of a new text
 * object: the system's, as a default record if one says them (the
 * object keeps VTSF_DEFAULT_CHAR_ATTR), else in a chunk of the
 * object's block
 */
static word SystemCharAttrRun(optr o)
{
    VisTextCharAttr a;
    VisTextDefaultCharAttr def;
    ChunkHandle c;

    GetSystemCharAttr(&a);
    if (TA_FindDefaultCharAttr(&a, &def))
	return def;
    c = LMemAlloc(OptrToHandle(o), sizeof(a));
    ObjSetFlags(ConstructOptr(OptrToHandle(o), c), OCF_IGNORE_DIRTY, 0);
    memcpy(LMemDeref(ConstructOptr(OptrToHandle(o), c)), &a, sizeof(a));
    VT(o)->VTI_storageFlags &= ~VTSF_DEFAULT_CHAR_ATTR;
    return c;
}

@extern method VisTextClass, MSG_META_INITIALIZE
{
    @callsuper();
    pself = VT(oself);
    pself->VI_attrs |= VA_FULLY_ENABLED;
    pself->VI_geoAttrs |= VGA_NOTIFY_GEOMETRY_VALID;
    pself->VTI_state = VTS_EDITABLE | VTS_SELECTABLE;
    pself->VTI_intFlags = 0;
    pself->VTI_storageFlags = VTSF_DEFAULT_CHAR_ATTR | VTSF_DEFAULT_PARA_ATTR;
    pself->VTI_paraAttrRuns = VIS_TEXT_INITIAL_PARA_ATTR;
    TS_SmallCreateTextStorage(oself);
    pself = VT(oself);
    pself->VTI_maxLength = 0xffff;
    pself->VTI_leftOffset = INITIAL_LEFT_OFFSET;
    memset(&pself->VTI_washColor, 0, sizeof(pself->VTI_washColor));
    pself->VTI_washColor.CQ_redOrIndex = C_WHITE;
    pself->VTI_washColor.CQ_info = CF_INDEX;
    pself->VTI_charAttrRuns = SystemCharAttrRun(oself);
}

@extern method VisTextClass, MSG_VIS_TEXT_SET_FILTER
{
    pself->VTI_filters = filter;
}

@extern method VisTextClass, MSG_VIS_TEXT_GET_FILTER
{
    return pself->VTI_filters;
}

@extern method VisTextClass, MSG_VIS_TEXT_SET_OUTPUT
{
    pself->VTI_output = newOutput;
}

@extern method VisTextClass, MSG_VIS_TEXT_GET_OUTPUT
{
    return pself->VTI_output;
}

@extern method VisTextClass, MSG_VIS_TEXT_SET_LR_MARGIN
{
    pself->VTI_lrMargin = lrMargin;
}

@extern method VisTextClass, MSG_VIS_TEXT_GET_LR_MARGIN
{
    return pself->VTI_lrMargin;
}

@extern method VisTextClass, MSG_VIS_TEXT_SET_TB_MARGIN
{
    pself->VTI_tbMargin = tbMargin;
}

@extern method VisTextClass, MSG_VIS_TEXT_GET_TB_MARGIN
{
    return pself->VTI_tbMargin;
}

/*
 * SendToTextOutputLowIfNotSelf: what the object tells itself goes on
 * to its output unless that is the object (a subclass that took the
 * message is the output then); a generic text object's as its action
 */
static void ToOutputIfNotSelf(optr o, Message msg, const void *args,
			      word size)
{
    optr out = VT(o)->VTI_output;
    EventHandle ev;

    if (!out || out == o)
	return;
    if (VT(o)->VI_typeFlags & VTF_IS_GEN) {
	CObjMessageP(MF_RECORD, 0, msg, args, size, &ev, sizeof(ev));
	@call o::MSG_GEN_OUTPUT_ACTION(ev, out);
    } else
	CObjMessageP(0, out, msg, args, size, NULL, 0);
}

@extern method VisTextClass, MSG_META_TEXT_USER_MODIFIED
{
    (void) pself;
    (void) obj;
    ToOutputIfNotSelf(oself, message, &oself, sizeof(oself));
}

@extern method VisTextClass, MSG_META_TEXT_EMPTY_STATUS_CHANGED
{
    struct { optr object; word hasText; } a;

    (void) pself;
    (void) object;
    a.object = oself;
    a.hasText = hasTextFlag;
    ToOutputIfNotSelf(oself, message, &a, sizeof(a));
}

@extern method VisTextClass, MSG_META_TEXT_CR_FILTERED, MSG_META_TEXT_TAB_FILTERED
{
    struct { word character; MetaTextFilteredParameters params; } a;

    (void) pself;
    a.character = character;
    a.params = params;
    ToOutputIfNotSelf(oself, message, &a, sizeof(a));
}
