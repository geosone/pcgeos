/* SendToTextOutput (textUtils.asm): the message with the object to
 * VTI_output; a generic text object's goes as its action */
void SendToTextOutput(optr o, Message msg)
{
    optr out = VT(o)->VTI_output;
    EventHandle ev;

    if (!out)
	return;
    if (VT(o)->VI_typeFlags & VTF_IS_GEN) {
	CObjMessageP(MF_RECORD, 0, msg, &o, sizeof(o), &ev, sizeof(ev));
	@call o::MSG_GEN_OUTPUT_ACTION(ev, out);
    } else
	CObjMessageP(0, out, msg, &o, sizeof(o), NULL, 0);
}

/*
 * SendToTextOutputLowIfNotSelf: what the object tells itself goes on
 * to its output unless that is the object (a subclass that took the
 * message is the output then); a generic text object's as its action
 */
static void ToOutputIfNotSelf(optr o, Message msg, const void *args,
			      word size)
{
    optr out = VT(o)->VTI_output;
    EventHandle ev;

    if (!out || out == o)
	return;
    if (VT(o)->VI_typeFlags & VTF_IS_GEN) {
	CObjMessageP(MF_RECORD, 0, msg, args, size, &ev, sizeof(ev));
	@call o::MSG_GEN_OUTPUT_ACTION(ev, out);
    } else
	CObjMessageP(0, out, msg, args, size, NULL, 0);
}

@method VisTextClass, MSG_META_TEXT_USER_MODIFIED
{
    (void) pself;
    (void) obj;
    ToOutputIfNotSelf(oself, message, &oself, sizeof(oself));
}

@method VisTextClass, MSG_META_TEXT_EMPTY_STATUS_CHANGED
{
    struct { optr object; word hasText; } a;

    (void) pself;
    (void) object;
    a.object = oself;
    a.hasText = hasTextFlag;
    ToOutputIfNotSelf(oself, message, &a, sizeof(a));
}

@method VisTextClass, MSG_META_TEXT_CR_FILTERED, MSG_META_TEXT_TAB_FILTERED
{
    struct { word character; MetaTextFilteredParameters params; } a;

    (void) pself;
    a.character = character;
    a.params = params;
    ToOutputIfNotSelf(oself, message, &a, sizeof(a));
}
