/*
 * textMethodInstance.goc -- the states of a text object (after
 * textMethodInstance.asm): its size, its maximum length, the features,
 * the state and the modified flag.
 *
 * Port32 (Port32/ABI.md section 13z), not yet: open and close, the
 * cached GStates, the geometry, the wash color, the minimum dimensions,
 * the focus notification of MSG_VIS_TEXT_MODIFY_EDITABLE_SELECTABLE
 * (SendTextFocusNotification).
 */
@include "textInt.goh"
#include <Internal/specUI.h>
#include <font.h>

/* VisTextSetMaxLength: a shorter maximum cuts the text and keeps the
 * selection within it */
@extern method VisTextClass, MSG_VIS_TEXT_SET_MAX_LENGTH
{
    dword size = TS_GetTextSize(oself), start, end;

    if (newMaxLength < pself->VTI_maxLength && newMaxLength < size) {
	VisTextReplaceParameters p;

	memset(&p, 0, sizeof(p));
	p.VTRP_range.VTR_start = newMaxLength;
	p.VTRP_range.VTR_end = size;
	(void) @call self::MSG_VIS_TEXT_REPLACE_TEXT(&p);
	TSL_SelectGetSelection(oself, &start, &end);
	if (start > newMaxLength)
	    start = newMaxLength;
	if (end > newMaxLength)
	    end = newMaxLength;
	TSL_SelectSetSelection(oself, start, end);
    }
    VT(oself)->VTI_maxLength = newMaxLength;
}

@extern method VisTextClass, MSG_VIS_TEXT_GET_MAX_LENGTH
{
    return pself->VTI_maxLength;
}

@extern method VisTextClass, MSG_VIS_TEXT_GET_SELECTION_START
{
    return pself->VTI_selectStart;
}

@extern method VisTextClass, MSG_VIS_TEXT_GET_TEXT_SIZE
{
    return TS_GetTextSize(oself);
}

@extern method VisTextClass, MSG_VIS_TEXT_SET_NOT_USER_MODIFIED
{
    pself->VTI_state &= ~VTS_USER_MODIFIED;
}

@extern method VisTextClass, MSG_VIS_TEXT_SET_USER_MODIFIED
{
    pself->VTI_state |= VTS_USER_MODIFIED;
}

@extern method VisTextClass, MSG_VIS_TEXT_GET_STATE
{
    return pself->VTI_state;
}

@extern method VisTextClass, MSG_VIS_TEXT_GET_USER_MODIFIED_STATE
{
    return (pself->VTI_state & VTS_USER_MODIFIED) != 0;
}

@extern method VisTextClass, MSG_VIS_TEXT_GET_FEATURES
{
    return pself->VTI_features;
}

@extern method VisTextClass, MSG_VIS_TEXT_SET_FEATURES
{
    pself->VTI_features = (pself->VTI_features | bitsToSet) & ~bitsToClear;
}

/* VisTextModifyEditableSelectable: no longer editable, the cursor goes
 * off the screen; editable with the focus, it flashes; the controllers
 * told */
@extern method VisTextClass, MSG_VIS_TEXT_MODIFY_EDITABLE_SELECTABLE
{
    const byte on = VTISF_IS_FOCUS | VTISF_CURSOR_ENABLED | VTISF_CURSOR_ON;

    if ((clearBits & VTS_EDITABLE) && (pself->VTI_state & VTS_EDITABLE) &&
	(pself->VTI_intSelFlags & on) == on && TextCheckCanDraw(oself) &&
	!GrGetExclusive(NullHandle)) {
	CursorToggle(oself);
	VT(oself)->VTI_intSelFlags &= ~VTISF_CURSOR_ON;
    }
    pself = VT(oself);
    pself->VTI_state = (pself->VTI_state & ~clearBits) | setBits;
    if ((setBits & VTS_EDITABLE) && (pself->VTI_intSelFlags & VTISF_IS_FOCUS))
	TSL_StartCursorCommon(oself);
    TA_SendNotification(oself, VIS_TEXT_STANDARD_NOTIFICATION_FLAGS);
}

/* VisTextSetWashColor: the background; drawn again */
@extern method VisTextClass, MSG_VIS_TEXT_SET_WASH_COLOR
{
    pself->VTI_washColor.CQ_redOrIndex = modeRed.VTWCMR_redOrIndex;
    pself->VTI_washColor.CQ_info = modeRed.VTWCMR_mapMode;
    pself->VTI_washColor.CQ_green = blueGreen.VTWCBG_green;
    pself->VTI_washColor.CQ_blue = blueGreen.VTWCBG_blue;
    TextGStateCreate(oself);
    if (TextCheckCanDraw(oself)) {
	EditUnHilite(oself);
	TextDraw(oself, TCBF_DRAW_ALL_LINES, FALSE);
	EditHilite(oself);
    }
    TextGStateDestroy(oself);
}

@extern method VisTextClass, MSG_VIS_TEXT_GET_WASH_COLOR
{
    retVal->VTGWC_modeRed.VTWCMR_redOrIndex = pself->VTI_washColor.CQ_redOrIndex;
    retVal->VTGWC_modeRed.VTWCMR_mapMode = pself->VTI_washColor.CQ_info;
    retVal->VTGWC_blueGreen.VTWCBG_green = pself->VTI_washColor.CQ_green;
    retVal->VTGWC_blueGreen.VTWCBG_blue = pself->VTI_washColor.CQ_blue;
}

/* VisTextNotifyGeometryValid: the bounds are valid: the lines */
@extern method VisTextClass, MSG_VIS_NOTIFY_GEOMETRY_VALID
{
    @callsuper();
    pself = VT(oself);
    if (!pself->VTI_lines) {
	pself->VTI_height.WBF_int = 0;
	pself->VTI_height.WBF_frac = 0;
	TL_LineStorageCreate(oself);
    }
    TextCompleteRecalc(oself);
    TextScrollOneLine(oself, VT(oself)->VTI_selectStart);
}

/*
 * VisTextOpen (textMethodInstance.asm): on the screen: an object whose
 * geometry is valid but has no lines yet (one placed by hand, not by
 * the geometry manager) gets them now.  One that has the focus already
 * takes a gstate of the new window, shows its cursor and flashes it.
 */
@extern method VisTextClass, MSG_VIS_OPEN
{
    Boolean focus;

    @callsuper();
    pself = VT(oself);
    pself->VTI_timerHandle = NullHandle;
    pself->VTI_intSelFlags &= ~(VTISF_CURSOR_ON | VTISF_DOING_SELECTION |
				VTISF_DOING_DRAG_SELECTION);
    focus = (pself->VTI_intSelFlags & VTISF_IS_FOCUS) != 0;
    if (focus) {
	/* RecalcGStateIfNeeded */
	TextGStateDestroy(oself);
	TextGStateCreate(oself);
    }
    TextGStateCreate(oself);
    pself = VT(oself);
    if (!(pself->VI_optFlags & VOF_GEOMETRY_INVALID) && !pself->VTI_lines)
	@call oself::MSG_VIS_NOTIFY_GEOMETRY_VALID();
    if (focus) {
	EditHilite(oself);
	TSL_StartCursorCommon(oself);
    }
    TextGStateDestroy(oself);
}

/* VisTextClose: off the screen: no flashing; the gstate of one with
 * the focus is of no window any more */
@extern method VisTextClass, MSG_VIS_CLOSE
{
    TSL_StopCursorTimer(oself);
    @callsuper();
    pself = VT(oself);
    if (pself->VTI_intSelFlags & VTISF_IS_FOCUS) {
	TextGStateDestroy(oself);
	TextGStateCreate(oself);
    }
}

/* VisTextGetOneLineWidth: the text (or its first characters) on one
 * line */
@extern method VisTextClass, MSG_VIS_TEXT_GET_ONE_LINE_WIDTH
{
    VisTextCharAttr ca;
    GStateHandle g;
    const char *text;
    word after, w;

    TextGStateCreate(oself);
    g = VT(oself)->VTI_gstate;
    TA_GetCharAttrForPosition(oself, 0, FALSE, &ca, NULL);
    GrSetFont(g, ca.VTCA_fontID,
	      ((dword) ca.VTCA_pointSize.WBF_int << 16) |
	      ((dword) ca.VTCA_pointSize.WBF_frac << 8));
    GrSetTextStyle(g, ca.VTCA_textStyles, (TextStyle) ~ca.VTCA_textStyles);
    text = TS_LockTextPtr(oself, 0, &after);
    if (!charsToCalc || charsToCalc > after)
	charsToCalc = after;
    w = charsToCalc ? GrTextWidth(g, text, charsToCalc) : 0;
    TS_UnlockTextPtr(oself, text);
    TextGStateDestroy(oself);
    return w;
}

/* VisTextRecreateCachedGStates: the window changed: the gstate made
 * anew for those who hold it */
@extern method VisTextClass, MSG_VIS_RECREATE_CACHED_GSTATES
{
    VisTextInstance *t = VT(oself);
    byte count = t->VTI_gsRefCount;

    if (!t->VTI_gstate)
	return;
    GrDestroyState(t->VTI_gstate);
    t->VTI_gstate = NullHandle;
    t->VTI_gsRefCount &= ~GSRCAF_REF_COUNT;
    TextGStateCreate(oself);
    VT(oself)->VTI_gsRefCount = count;
}
