/*
 * textMethodDraw.goc -- a text object drawn (after textMethodDraw.asm;
 * of TextLine/ tlCommonDraw.asm and tlSmallDraw.asm the drawing of a
 * line, of TextRegion/ trSmallGState.asm and trSmallClear.asm the
 * region of a small object).
 *
 * The text stands inside the object's margins (VTI_lrMargin,
 * VTI_tbMargin): the gstate is moved there and clipped to it.  A line
 * is drawn field by field (GrDrawTextField, the attributes by a
 * callback) on its background (VTI_washColor, unless the object is
 * transparent and answers MSG_VIS_DRAW); the last field has the
 * line's space padding (full justification); the carriage return a
 * line ends in and the tab a field starts with are not drawn.  Below
 * the last line the background is cleared.
 *
 * MSG_VIS_DRAW draws the lines in the mask with the gstate it is
 * given; TextScreenUpdate those a calculation marked (LF_NEEDS_DRAW),
 * at once, with the object's own gstate.
 *
 * After the lines MSG_VIS_DRAW shows the selection again (the cursor,
 * the inverted range); TextScreenUpdate's callers take it away before
 * the change and show it afterwards (EditUnHilite, EditHilite).
 *
 * Behind a line its paragraph's own background and its border
 * (TextClearBehindLine).
 *
 * A field that starts with a tab has the tab's leader before it.
 *
 * Port32 (Port32/ABI.md section 13z): small objects.  Not yet:
 * extended styles, graphics, hidden characters shown, right
 * to left.
 */
@include "textInt.goh"

/* the text's width and height: the object's inside its margins */
void TextSize(optr o, sword *width, sword *height)
{
    VisTextInstance *t = VT(o);
    VisInstance *v = (VisInstance *) t;

    *width = v->VI_bounds.R_right - v->VI_bounds.R_left -
	     2 * t->VTI_lrMargin;
    *height = v->VI_bounds.R_bottom - v->VI_bounds.R_top -
	      2 * t->VTI_tbMargin;
}

/*
 * TL_LineDraw (CommonLineClearBehind, CommonLineDraw): a line with its
 * background; top is its top, start where its text starts.  The line
 * no longer needs drawing, unless this is printing.
 */
static void LineDraw(LICL_vars *l, dword line, sdword top, dword start,
		     byte flags, Boolean haveDrawn)
{
    optr o = l->LICL_object;
    GStateHandle g = VT(o)->VTI_gstate;
    LineInfo *li;
    word fields = TL_LineGetFieldCount(o, line), f;
    sword width, height;
    GDF_vars v;
    TextLockState lock;

    l->LICL_line = line;
    l->LICL_lineStart = start;
    TextClearBehindLine(l, top, flags, haveDrawn);
    li = TL_LineLock(o, line, NULL);
    if (!TEXT_WBF(&li->LI_hgt)) {
	TL_LineUnlock(o, li);
	return;
    }
    TextSize(o, &width, &height);
    if (!(flags & TCBF_PRINT) && (li->LI_flags & LF_NEEDS_DRAW)) {
	li->LI_flags &= ~LF_NEEDS_DRAW;
	TL_LineDirty(o, li);
    }

    for (f = 0; f < fields; f++) {
	const FieldInfo *fi;
	word n, limit;
	dword off = start;
	WWFixedAsDWord pad = 0;

	li = TL_LineRelock(o, line, li);
	fi = &li->LI_firstField + f;
	n = fi->FI_nChars;
	start += n;
	if (fi->FI_tab != RULER_TAB_TO_LINE_LEFT) {
	    /* the field starts with its tab: its leader drawn */
	    byte leader = FieldGetTabLeaderType(l, li, f,
						(sword) (top >> 8), off);

	    if (leader != TL_NONE)
		DrawTabLeader(l, TL_LineRelock(o, line, li), f,
			      (sword) (top >> 8), off, leader);
	    li = TL_LineRelock(o, line, li);
	    fi = &li->LI_firstField + f;
	    if (n) {
		n--;
		off++;
	    }
	}
	if (f == fields - 1) {
	    pad = ((dword) li->LI_spacePad.WBF_int << 16) |
		  ((dword) li->LI_spacePad.WBF_frac << 8);
	    if ((li->LI_flags & (LF_ENDS_IN_CR | LF_ENDS_IN_COLUMN_BREAK |
				 LF_ENDS_IN_SECTION_BREAK)) && n)
		n--;
	}
	GrSetTextSpacePad(g, pad);
	if (!n)
	    continue;
	memset(&v, 0, sizeof(v));
	lock.TLK_object = o;
	lock.TLK_locked = NULL;
	v.GDFV_other = &lock;
	v.GDFV_saved.GDFS_nChars = n;
	v.GDFV_saved.GDFS_drawPos.PWBF_x.WBF_int =
	    (sword) (li->LI_adjustment + VT(o)->VTI_leftOffset +
		     fi->FI_position);
	v.GDFV_saved.GDFS_drawPos.PWBF_y.WBF_int = (word) (top >> 8);
	v.GDFV_saved.GDFS_drawPos.PWBF_y.WBF_frac = (byte) top;
	v.GDFV_saved.GDFS_baseline = li->LI_blo;
	limit = (word) width;
	if (limit > li->LI_lineEnd)
	    limit = li->LI_lineEnd;
	v.GDFV_saved.GDFS_limit = limit;
	/* SetAutoHyphenFlag */
	if (f == fields - 1 && (li->LI_flags & LF_ENDS_IN_AUTO_HYPHEN))
	    v.GDFV_saved.GDFS_flags |= HF_AUTO_HYPHEN;
	v.GDFV_styleCallback = FieldDrawStyleCallback;
	v.GDFV_textOffset = off;
	GrDrawTextField(g, &v);
	TS_ReleaseTextPtr(&lock);
    }
    TL_LineUnlock(o, li);
    GrSetTextSpacePad(g, 0);
}

/*
 * TextDraw (TextDrawRegionCallback): the lines of each region from its
 * top to its bottom (in the region's coordinates), or all of them (TCBF_DRAW_ALL_LINES); with
 * onlyMarked those that need drawing (LF_NEEDS_DRAW).  The gstate is
 * VTI_gstate, moved to the text here and left as it was.
 */
void TextDraw(optr o, byte flags, Boolean onlyMarked)
{
    VisTextInstance *t = VT(o);
    GStateHandle g = t->VTI_gstate;
    dword n, line, start, last;
    sdword top;
    Rectangle mask;
    RectDWord md;
    LICL_vars l;
    Boolean drawn = FALSE, all = (flags & TCBF_DRAW_ALL_LINES) != 0,
	    large = (t->VTI_storageFlags & VTSF_LARGE) != 0;
    word region, regions = large ? LargeRegionCount(o) : 1;

    if (!t->VTI_lines || !g)
	return;				/* TextCheckCanDraw */
    memset(&l, 0, sizeof(l));
    l.LICL_object = o;
    n = TL_LineGetCount(o);
    /* (TextDrawRegionCallback for each region, LargeEnumRegionsInClipRect) */
    for (region = 0; region < regions; region++) {
	sdword h;

	if (large && (LargeRegionGetFlags(o, region) & VLTRF_EMPTY))
	    continue;
	GrSaveState(g);
	TR_RegionMoveGState(o, region, (flags & TCBF_PRINT) != 0);
	if (!all && !onlyMarked) {
	    if (!large)
		GrGetMaskBounds(g, &mask);
	    else {
		/* (the regions the mask does not touch are left out) */
		h = (sdword) TR_RegionGetTrueHeight(o, region);
		if (!GrGetMaskBoundsDWord(g, &md) || md.RD_bottom < 0 ||
		    md.RD_top > h) {
		    GrRestoreState(g);
		    continue;
		}
		mask.R_top = (sword) (md.RD_top < 0 ? 0 : md.RD_top);
		mask.R_bottom = (sword) (md.RD_bottom > h ? h : md.RD_bottom);
	    }
	}
	line = TR_RegionGetTopLine(o, region);
	last = line + TR_RegionGetLineCount(o, region);
	if (last > n)
	    last = n;
	(void) TR_RegionFromLineGetStartLineAndOffset(o, line, NULL, &start);
	top = 0;
	for (; line < last; line++) {
	    const LineInfo *li = TL_LineLock(o, line, NULL);
	    sdword hgt = TEXT_WBF(&li->LI_hgt);
	    dword count = TL_LineGetCharCount(li);
	    LineFlags lf = li->LI_flags;
	    Boolean draw;

	    TL_LineUnlock(o, li);
	    if (onlyMarked)
		draw = (lf & LF_NEEDS_DRAW) != 0;
	    else if (all)
		draw = TRUE;
	    else
		/* TextDrawCheckMask: the lines the mask touches */
		draw = (sword) (top >> 8) <= mask.R_bottom &&
		       (sword) ((top + hgt + 0xff) >> 8) >= mask.R_top;
	    if (draw) {
		LineDraw(&l, line, top, start, flags, drawn);
		drawn = TRUE;
	    }
	    start += count;
	    top += hgt;
	}
	if (!(flags & TCBF_PRINT) &&
	    !((flags & TCBF_MSG_DRAW) &&
	      (VT(o)->VTI_features & VTF_TRANSPARENT)))
	    TR_RegionClearToBottom(o, region);
	GrRestoreState(g);
    }
}

/*
 * TextScreenUpdate: the lines a calculation marked, drawn at once if
 * the object is on the screen
 */
void TextScreenUpdate(optr o)
{
    VisTextInstance *t = VT(o);

    if (!t->VTI_lines || !(((VisInstance *) t)->VI_attrs & VA_REALIZED))
	return;
    TextGStateCreate(o);
    TextDraw(o, 0, TRUE);
    TextGStateDestroy(o);
}

/*
 * VisTextDraw: with the gstate passed, as the object's while it draws
 */
@extern method VisTextClass, MSG_VIS_DRAW
{
    GStateHandle old = pself->VTI_gstate;
    byte count = pself->VTI_gsRefCount;
    word region = pself->VTI_gstateRegion;
    byte flags = TCBF_MSG_DRAW;

    GrSaveState(gstate);
    pself->VTI_gstate = gstate;
    pself->VTI_gsRefCount = (pself->VTI_gsRefCount & ~GSRCAF_REF_COUNT) | 1;
    pself->VTI_gstateRegion = (word) -1;
    if (drawFlags & DF_PRINT)
	flags = TCBF_MSG_DRAW | TCBF_PRINT;
    else if (drawFlags & DF_OBJECT_SPECIFIC)
	flags |= TCBF_DRAW_ALL_LINES;
    GrSetTextMode(gstate, TM_DRAW_BASE, 0);
    GrSetTextMaskSys(gstate, SDM_100);
    TextDraw(oself, flags, FALSE);
    if (!(drawFlags & DF_PRINT)) {
	/* the selection over the text just drawn: the cursor if it is
	 * on, the range of a selectable object */
	dword start, end;

	TSL_SelectGetSelection(oself, &start, &end);
	if (start == end)
	    TSL_CursorDrawIfOn(oself);
	else if ((VT(oself)->VTI_state & VTS_SELECTABLE) &&
		 TextCheckCanDraw(oself))
	    TSL_DrawHilite(oself, start, end);
    }
    pself = VT(oself);
    pself->VTI_gstateRegion = region;
    pself->VTI_gsRefCount = count;
    pself->VTI_gstate = old;
    GrRestoreState(gstate);
}

/* VisTextRecalcAndDraw: the lines made again, the text drawn */
static void RecalcAndDraw(optr oself)
{
    WBFixed before = VT(oself)->VTI_height;

    if (!VT(oself)->VTI_lines)
	return;				/* no geometry yet */
    TextGStateCreate(oself);
    EditUnHilite(oself);
    TextCompleteRecalc(oself);
    TextScreenUpdate(oself);
    EditHilite(oself);
    TextGStateDestroy(oself);
    TR_RegionAdjustHeight(oself, before);
}

@extern method VisTextClass, MSG_VIS_TEXT_RECALC_AND_DRAW
{
    RecalcAndDraw(oself);
}

/* (the same; relayed is for the managers that pass it on) */
@extern method VisTextClass, MSG_VIS_TEXT_RECALC_FOR_ATTR_CHANGE
{
    (void) relayed;
    RecalcAndDraw(oself);
}
