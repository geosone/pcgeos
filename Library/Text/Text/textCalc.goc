/*
 * textCalc.goc -- the lines of a text object calculated again (after
 * textCalc.asm and what textCalcObject.asm does for a small object; the
 * messages that start it are in textMethodInstance.goc).
 *
 * An object has lines once its geometry is valid (it knows how wide it
 * is): MSG_VIS_NOTIFY_GEOMETRY_VALID makes them and calculates all the
 * text.  A change of the text calculates them again: each line from
 * where the one before ended, on a paragraph's first line if that one
 * ended a paragraph, until the line with the null; lines left over are
 * deleted.  A line is marked to draw (LF_NEEDS_DRAW) if anything of it
 * changed, the change touches it, a line above it changed its height,
 * or other text came to stand in it.  VTI_height is the sum of the
 * lines.
 *
 * Port32 (Port32/ABI.md section 13z): a small object has one region,
 * so nothing ripples between regions, and the lines are few: all of
 * them are calculated, not only those from the change on (the asm
 * stops where the lines meet the old ones again).
 */
@include "textInt.goh"


/*
 * TextRecalc: the lines again after a change: at start, inserted
 * characters came for deleted ones
 */
void TextRecalc(optr o, dword start, dword inserted, dword deleted)
{
    LICL_vars l;
    LineFlags prev = LF_ENDS_PARAGRAPH;
    dword line, oldStart = 0, n;
    sdword bottom = 0;
    VisTextInstance *t;

    if (!VT(o)->VTI_lines)
	return;				/* no geometry yet */
    ObjMarkDirty(o);
    TextGStateCreate(o);
    memset(&l, 0, sizeof(l));
    l.LICL_object = o;
    l.LICL_calcFlags = CF_SAVE_RESULTS;
    l.LICL_startPos = start;
    l.LICL_range.VTR_end = start + inserted;
    if (l.LICL_range.VTR_end < start)
	l.LICL_range.VTR_end = TEXT_ADDRESS_PAST_END;
    T_GetNewParaAttr(&l, 0);
    for (line = 0;; line++) {
	dword oldCount = 0;

	if (line >= TL_LineGetCount(o)) {
	    TL_LineInsert(o, line, 1);
	    l.LICL_calcFlags |= CF_FORCE_CHANGED;
	} else
	    oldCount = TL_LineGetCharCount(TL_LinePtr(o, line, NULL));
	/* a line below a change of height, or other text in it */
	if (l.LICL_insertedSpace ||
	    (oldStart >= start + deleted &&
	     oldStart + inserted - deleted != l.LICL_range.VTR_start))
	    l.LICL_calcFlags |= CF_FORCE_CHANGED;
	oldStart += oldCount;
	l.LICL_line = line;
	l.LICL_lineHeight.WBF_int = 0;
	l.LICL_lineHeight.WBF_frac = 0;
	T_EnsureCorrectParaAttr(&l, l.LICL_range.VTR_start);
	TL_LineCalculate(&l, (prev & LF_ENDS_PARAGRAPH) ?
			     LF_STARTS_PARAGRAPH : 0);
	l.LICL_calcFlags &= ~CF_FORCE_CHANGED;
	bottom += ((sdword) l.LICL_lineHeight.WBF_int << 8) +
		  l.LICL_lineHeight.WBF_frac;
	l.LICL_lineBottom.WBF_int = (word) (bottom >> 8);
	l.LICL_lineBottom.WBF_frac = (byte) bottom;
	prev = l.LICL_lineFlags;
	if (prev & LF_ENDS_IN_NULL)
	    break;
    }
    /* TruncateLines */
    n = TL_LineGetCount(o);
    if (n > line + 1)
	TL_LineDelete(o, line + 1, (word) (n - line - 1));
    t = VT(o);
    t->VTI_height = l.LICL_lineBottom;
    TextGStateDestroy(o);
}

/*
 * TextHeightNotify (SmallRegionAdjustHeight): after a recalculation on
 * the screen: a height other than before (in whole pixels) is told to
 * the object (MSG_VIS_TEXT_HEIGHT_NOTIFY, with the margins: a subclass
 * resizes) and kept as the height at this width
 */
void TextHeightNotify(optr o, WBFixed before)
{
    VisTextInstance *t = VT(o);
    word h = (word) (t->VTI_height.WBF_int + (t->VTI_height.WBF_frac != 0));

    if (h == (word) (before.WBF_int + (before.WBF_frac != 0)))
	return;
    t->VTI_lastWidth = (word) (t->VI_bounds.R_right - t->VI_bounds.R_left);
    @call o::MSG_VIS_TEXT_HEIGHT_NOTIFY((word) (h + 2 * t->VTI_tbMargin));
}

/* TextCompleteRecalc: all of it, every line to draw */
void TextCompleteRecalc(optr o)
{
    TextRecalc(o, 0, TEXT_ADDRESS_PAST_END, TEXT_ADDRESS_PAST_END);
}

/* VisTextGetLineInfo: a line with its fields into a buffer (as much
 * as fits); TRUE if there is no such line */
@extern method VisTextClass, MSG_VIS_TEXT_GET_LINE_INFO
{
    word size;
    const LineInfo *li;

    retValue->VTGLIRV_unused = 0;
    retValue->VTGLIRV_byteCount = 0;
    if (!pself->VTI_lines || vtglip->VTGLIP_line >= TL_LineGetCount(oself))
	return TRUE;
    li = TL_LinePtr(oself, vtglip->VTGLIP_line, &size);
    if (size > vtglip->VTGLIP_bsize)
	size = vtglip->VTGLIP_bsize;
    retValue->VTGLIRV_byteCount = size;
    memcpy(vtglip->VTGLIP_buffer, li, size);
    return FALSE;
}

@extern method VisTextClass, MSG_VIS_TEXT_GET_LINE_FROM_OFFSET
{
    if (!pself->VTI_lines)
	return 0;
    return TL_LineFromOffset(oself, offset, FALSE, NULL);
}

/* VisTextGetLineOffsetAndFlags: TRUE if there is no such line */
@extern method VisTextClass, MSG_VIS_TEXT_GET_LINE_OFFSET_AND_FLAGS
{
    if (!pself->VTI_lines || params->VTGLOAFP_line >= TL_LineGetCount(oself))
	return TRUE;
    params->VTGLOAFP_offset = TL_LineToOffsetStart(oself,
						   params->VTGLOAFP_line);
    params->VTGLOAFP_flags = TL_LinePtr(oself, params->VTGLOAFP_line,
					NULL)->LI_flags;
    return FALSE;
}
