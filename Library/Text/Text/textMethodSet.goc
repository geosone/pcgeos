static void DeleteRange(optr o, dword start, dword end,
			VisTextReplaceFlags flags)
{
    VisTextReplaceParameters p;

    memset(&p, 0, sizeof(p));
    p.VTRP_range.VTR_start = start;
    p.VTRP_range.VTR_end = end;
    p.VTRP_flags = flags;
    (void) VisTextReplace(o, &p);
}

/* VisTextDeleteRangeOfChars: by the user */
@extern method VisTextClass, MSG_META_DELETE_RANGE_OF_CHARS
{
    DeleteRange(oself, rangeToDelete.VTR_start, rangeToDelete.VTR_end,
		VTRF_FILTER | VTRF_USER_MODIFICATION);
}

@extern method VisTextClass, MSG_VIS_TEXT_DELETE_ALL
{
    DeleteRange(oself, 0, TEXT_ADDRESS_PAST_END, 0);
}

/* VisTextDelete: the selection, by the user */
@extern method VisTextClass, MSG_META_DELETE
{
    DeleteRange(oself, VIS_TEXT_RANGE_SELECTION, 0,
		VTRF_FILTER | VTRF_USER_MODIFICATION);
}

@extern method VisTextClass, MSG_VIS_TEXT_DELETE_SELECTION
{
    DeleteRange(oself, VIS_TEXT_RANGE_SELECTION, 0, 0);
}
