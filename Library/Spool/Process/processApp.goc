/*
 * processApp.goc -- the spooler's process (the C port of the
 * SpoolProcClass methods of processApp.asm and processQueue.asm's
 * messages), and the messages and notifications the library routines
 * send.
 *
 * Port32: the process class is a ProcessClass, not the GenProcessClass
 * of the asm: the spooler has no UI yet (no application object, no
 * control panel, no detach confirmation).  So:
 *   - MSG_META_ATTACH cleans up the spool files of an earlier session
 *     (SpoolBirth);
 *   - MSG_SPOOL_CREATE_THREAD makes a queue and its thread for a job
 *     whose port has none;
 *   - MSG_META_DETACH makes the queues' threads stop at the next page
 *     (SI_DETACH) and lets no new job in.  The jobs are not saved to a
 *     state file yet.
 * The job added/removed notifications to the process updated the
 * control panel: there is none, so they are not sent.
 */
#include <geos.h>
#include <heap.h>
#include <geode.h>
@include <object.goh>
#include <object.h>
@include <Objects/metaC.goh>
@include <Objects/processC.goh>
#include <library.h>
#include "spoolLocal.h"
@include <gcnlist.goh>

@class SpoolProcClass, ProcessClass;
    @message void MSG_SPOOL_CREATE_THREAD(ChunkHandle job = cx);
@endc;

@classdecl SpoolProcClass, neverSaved;

/* spoolVariable.def */
MemHandle	queueHandle;
SemaphoreHandle	queueSemaphore;
word		spoolStateFlags;
word		nextJobID;
word		customQueueID;
ThreadLockHandle errorThreadLock;
word		errorBoxCount;
word		spoolAckID;
optr		spoolAckOD;
Boolean		spoolDetachHeld;

/* the library entry: the semaphores of the queue and the error box
 * (static Semaphores in the asm's idata) */
Boolean SpoolLibraryEntry(LibraryCallType ty, GeodeHandle client)
{
    (void) client;
    if (ty == LCT_ATTACH) {
	queueSemaphore = ThreadAllocSem(1);
	errorThreadLock = ThreadAllocThreadLock();
	HandleModifyOwner(queueSemaphore, GeodeGetCodeProcessHandle());
	HandleModifyOwner(errorThreadLock, GeodeGetCodeProcessHandle());
    }
    return FALSE;
}

@method SpoolProcClass, MSG_META_ATTACH_PROCESS
{
    (void) value1;
    (void) value2;
    SpoolBirth();
    SpoolSyncHostPrinters();
}

/* MSG_SPOOL_CREATE_THREAD: a queue for the job's port, unless one was
 * made since the job was added (CreateThreadStart) */
@method SpoolProcClass, MSG_SPOOL_CREATE_THREAD
{
    ChunkHandle queue;
    JobInfoStruct *j;

    if (LockQueue()) {
	UnlockQueue();
	return;
    }
    queue = FindRightQueue(&JOB(job)->JIS_info.JP_portInfo);
    if (!queue)
	queue = AllocDeviceQueue(job);
    if (!queue) {
	/* no thread: the job is dropped (the asm told the user) */
	j = JOB(job);
	if (j->JIS_info.JP_spoolOpts & SO_DELETE) {
	    FilePushDir();
	    FileSetStandardPath(SP_SPOOL);
	    FileDelete(j->JIS_info.JP_fname);
	    FilePopDir();
	}
	LMemFreeHandles(queueHandle, job);
	if (!PQ()->PQ_numQueues) {
	    MemHandle mh = queueHandle;
	    MemUnlockV(mh);
	    queueHandle = 0;
	    MemFree(mh);
	}
	UnlockQueue();
	return;
    }
    JOB(job)->JIS_queue = queue;
    InsertJobIntoQueue(job, queue);
    PQ()->PQ_numJobs++;
    SendJobAddedNotification(job);
    UnlockQueue();
}

/* MSG_META_DETACH (SpoolDetach, KillPrinting): no job is let in any
 * more.  While jobs are printing, their queues are written to the state
 * file and stopped at the next page, and the detach is held back until
 * the last thread is gone (MSG_PROCESS_NOTIFY_THREAD_EXIT). */
@method SpoolProcClass, MSG_META_DETACH
{
    ChunkHandle ch;

    if (LockQueue()) {
	spoolStateFlags |= SS_DETACHING;
	spoolDetachHeld = FALSE;
	UnlockQueue();
	@callsuper();
	return;
    }
    spoolStateFlags |= SS_DETACHING;
    spoolAckID = callerID;
    spoolAckOD = caller;
    spoolDetachHeld = TRUE;
    SaveQueueState();
    for (ch = PQ()->PQ_firstQueue; ch; ch = QUEUE(ch)->QI_next)
	QUEUE(ch)->QI_error = SI_DETACH;
    UnlockQueue();
}

/* MSG_PROCESS_NOTIFY_THREAD_EXIT (SpoolThreadExit): when the last
 * queue's thread is gone, the held-back detach goes on.  A thread still
 * in a queue was killed by something else: its queue goes, with its
 * jobs. */
@method SpoolProcClass, MSG_PROCESS_NOTIFY_THREAD_EXIT
{
    ChunkHandle ch, prev = 0;
    QueueInfo *q;

    (void) exitCode;
    if (!LockQueue()) {
	for (ch = PQ()->PQ_firstQueue; ch; prev = ch, ch = q->QI_next) {
	    q = QUEUE(ch);
	    if (q->QI_thread == exitProcess)
		break;
	}
	if (!ch) {				/* still printing */
	    UnlockQueue();
	    return;
	}
	if (q->QI_portHan)
	    GeodeFreeDriver(q->QI_portHan);
	if (q->QI_pdHan)
	    GeodeFreeDriver(q->QI_pdHan);
	if (PQ()->PQ_numQueues != 1) {
	    if (prev)
		QUEUE(prev)->QI_next = q->QI_next;
	    else
		PQ()->PQ_firstQueue = q->QI_next;
	    PQ()->PQ_numQueues--;
	    UnlockQueue();
	    return;
	}
	{
	    MemHandle mh = queueHandle;
	    MemUnlockV(mh);
	    queueHandle = 0;
	    MemFree(mh);
	}
    }
    /* no queue left */
    if (spoolDetachHeld && (spoolStateFlags & SS_DETACHING)) {
	spoolDetachHeld = FALSE;
	UnlockQueue();
	@send ,forceQueue oself::MSG_META_DETACH(spoolAckID, spoolAckOD);
	return;
    }
    UnlockQueue();
}

/* ---------------------------------------------------------------------
 * Sending
 * ------------------------------------------------------------------- */

void SpoolSendCreateThread(ChunkHandle job)
{
    optr spooler = ConstructOptr(GeodeGetCodeProcessHandle(), 0);

    @send ,forceQueue spooler::MSG_SPOOL_CREATE_THREAD(job);
}

void SpoolSendJobNotification(Boolean added, word jobID,
			      PrinterPortType type, word portNum)
{
    (void) added;
    (void) jobID;
    (void) type;
    (void) portNum;
}

/* SpoolSendStatusChange: MSG_PRINT_STATUS_CHANGE to the print job status
 * list of the system */
void SpoolSendStatusChange(word type, word jobID, word data)
{
    EventHandle ev;

    ev = @record null::MSG_PRINT_STATUS_CHANGE((PrintStatusChangeType) type,
					       jobID, data);
    GCNListSend(MANUFACTURER_ID_GEOWORKS, GCNSLT_PRINT_JOB_STATUS, ev, 0,
		GCNLSF_FORCE_QUEUE);
}

/* SpoolSendPrintersChanged: MSG_PRINTER_INSTALLED_REMOVED to the
 * installed printers list */
void SpoolSendPrintersChanged(void)
{
    EventHandle ev;

    ev = @record null::MSG_PRINTER_INSTALLED_REMOVED();
    GCNListSend(MANUFACTURER_ID_GEOWORKS, GCNSLT_INSTALLED_PRINTERS, ev, 0,
		GCNLSF_FORCE_QUEUE);
}
