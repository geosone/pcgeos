/*
 * genUIDocumentControl.goc -- GenDocumentControlClass (after
 * genUIDocumentControl.asm): the part of the document control that
 * runs in the UI thread: a controller with the user's side of the
 * documents (new, open, close, save, save as ...), working with the
 * GenDocumentGroup of the application thread.  Its path
 * (ATTR_GEN_PATH_DATA) is where the file selectors start.  All it does
 * is the specific UI's (SPIR_BUILD_UI_DOCUMENT_CONTROL).
 *
 * Port32 (Port32/ABI.md section 13y): as the asm.
 */
@include "uiInt.goh"
@include <Objects/gDocCtrl.goh>

@classdecl GenDocumentControlClass;

@method GenDocumentControlClass, MSG_META_RESOLVE_VARIANT_SUPERCLASS
{
    return GenQueryUICallSpecificUI(oself, SPIR_BUILD_UI_DOCUMENT_CONTROL,
				    MasterOffset);
}

/* GenDocumentControlInitializeVarData: the path starts as the document
 * directory */
@method GenDocumentControlClass, MSG_META_INITIALIZE_VAR_DATA
{
    GenFilePath *p;

    (void) pself;
    if (dataType != ATTR_GEN_PATH_DATA)
	return @callsuper();
    p = ObjVarAddData(oself, ATTR_GEN_PATH_DATA | VDF_SAVE_TO_STATE,
		      sizeof(GenFilePath));
    p->GFP_disk = SP_DOCUMENT;
    p->GFP_path[0] = 0;
    return (word) ((byte *) p - (byte *) MemDeref(OptrToHandle(oself)));
}

/* GenDocumentControlRelocOrUnReloc: the path's disk is restored when
 * the path is next used */
@method GenDocumentControlClass, _reloc
{
    (void) vmRelocType;
    if (message == MSG_META_UNRELOCATE)
	GenPathUnrelocObjectPath(oself, ATTR_GEN_PATH_DATA,
				 TEMP_GEN_PATH_SAVED_DISK_HANDLE);
    return @callsuper();
}
