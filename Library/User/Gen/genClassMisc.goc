/*
 * genClassMisc.goc -- GenClass, after genClassMisc.asm, which has its
 * class record; the methods are in genClassBuild.goc, genClassCommon.goc
 * and here, each beside its asm file.  The generic object: the generic tree, the
 * usable and enabled states, the moniker, the keyboard accelerator,
 * hints, upward queries and classed events.
 *
 * GenClass is a variant master class above VisClass: what a generic
 * object looks like comes from the specific UI, whose class the object
 * resolves when its specific part is first needed (a Gen subclass
 * answers MSG_META_RESOLVE_VARIANT_SUPERCLASS by
 * GenQueryUICallSpecificUI).  Many messages are passed to the specific
 * part only once it is grown, so that a generic tree that is not usable
 * stays without one.
 *
 * Port32 (Port32/ABI.md section 13x):
 *   - MSG_GEN_GUP_ENSURE_UPDATE_WINDOW returns its carry as
 *     MSG_GEN_P32_GUP_ENSURE_UPDATE_WINDOW, MSG_SPEC_GUP_QUERY has
 *     MSG_GEN_GUP_QUERY's parameters (MSG_SPEC_P32_GUP_QUERY), and
 *     MSG_SPEC_RESCAN_GEO_AND_UPDATE the VisOptFlags
 *     (MSG_SPEC_P32_RESCAN_GEO_AND_UPDATE; Internal/specC.goh);
 *   - the moniker's source is a VisMonikerSource (an optr);
 *   - not yet: MSG_GEN_BRANCH_REPLACE_PARAMS (dword optrs),
 *     MSG_META_BRING_UP_HELP, the view ranges.
 */
@include "uiInt.goh"
#include <initfile.h>
#include <string.h>
#include <localize.h>
