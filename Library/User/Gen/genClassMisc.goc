/* ---------------------------------------------------------------------
 * The object's path (genPathUtils.goc)
 * ------------------------------------------------------------------- */

@method GenClass, MSG_GEN_P32_GUP_ENSURE_UPDATE_WINDOW
{
    struct { UpdateWindowFlags f; VisUpdateMode m; } p;
    Boolean r = FALSE;

    if (@callsuper())
	return TRUE;
    p.f = updateFlags;
    p.m = updateMode;
    GenCallParent(oself, message, &p, sizeof(p), &r, sizeof(r));
    return r;
}

@method GenClass, MSG_GEN_CHANGE_ACCELERATOR
{
    pself->GI_kbdAccelerator = (KeyboardShortcut)
	((pself->GI_kbdAccelerator & ~bitsToClear) | bitsToSet);
}

/* ---------------------------------------------------------------------
 * Queries and classed events (genClassMisc.asm)
 * ------------------------------------------------------------------- */

@method GenClass, MSG_GEN_GUP_QUERY
{
    return @call oself::MSG_SPEC_P32_GUP_QUERY(retValue, queryType);
}

/* GenContinueGupQuery: the specific part first, then the parent */
@method GenClass, MSG_GEN_GUP_INTERACTION_COMMAND
{
    Boolean r = FALSE;

    if (@callsuper())
	return TRUE;
    GenCallParent(oself, message, &command, sizeof(command), &r, sizeof(r));
    return r;
}

@method GenClass, MSG_GEN_GUP_FINISH_QUIT
{
    @callsuper oself::GenClass::MSG_META_FINISH_QUIT(abortFlag);
    if (notifyParent) {
	struct { Boolean a, n; } p;
	p.a = abortFlag;
	p.n = notifyParent;
	GenCallParent(oself, message, &p, sizeof(p), NULL, 0);
    }
}

/* GenGenSendToChildren: a copy of the event to each child of its class
 * (all if it has none); the event is freed */
typedef struct {
    EventHandle event;
    ClassStruct *cls;
} SendEventData;

static Boolean SendEventCallback(optr parent, optr child, void *data)
{
    SendEventData *d = data;

    (void) parent;
    if (!d->cls || ObjIsObjectInClass(child, d->cls)) {
	EventHandle e = ObjDuplicateMessage(d->event);
	MessageSetDestination(e, child);
	CMessageDispatchP(e, MF_CALL, NULL, 0);
    }
    return FALSE;
}

@method GenClass, MSG_GEN_SEND_TO_CHILDREN
{
    SendEventData d;
    optr cls;

    ObjGetMessageInfo(event, &cls);
    d.event = event;
    d.cls = (ClassStruct *) (uintptr_t) cls;
    GenCallChildren(oself, SendEventCallback, &d);
    ObjFreeMessage(event);
}

/* GenSendClassedEvent: the generic travel options */
@method GenClass, MSG_META_SEND_CLASSED_EVENT
{
    word to = (word) whereTo;	/* TravelOption and GenTravelOption */

    if (to == TO_GEN_PARENT) {
	FlowMessageClassedEvent(GenFindParent(oself),
				MSG_GEN_GUP_SEND_TO_OBJECT_OF_CLASS, event,
				0, 0);
	return;
    }
    if (to >= TO_APP_FOCUS && to <= TO_APP_MODEL) {
	/* (a full TravelOption: no undefined padding) */
	struct { EventHandle e; TravelOption t; } p;

	p.e = event;
	p.t = (TravelOption) (to - (TO_APP_FOCUS - TO_FOCUS));
	if (!UserCallApplication(MSG_META_SEND_CLASSED_EVENT, &p, sizeof(p),
				 NULL, 0))
	    FlowDestroyMessage(event);
	return;
    }
    if (to >= TO_SYS_FOCUS && to <= TO_SYS_MODEL) {
	struct { EventHandle e; TravelOption t; } p;

	p.e = event;
	p.t = (TravelOption) (to - (TO_SYS_FOCUS - TO_FOCUS));
	if (!UserCallSystem(MSG_META_SEND_CLASSED_EVENT, &p, sizeof(p),
			    NULL, 0))
	    FlowDestroyMessage(event);
	return;
    }
    @callsuper();
}

@method GenClass, MSG_GEN_GUP_CALL_OBJECT_OF_CLASS
{
    FlowDispatchSendOnOrDestroyClassedEvent(NULL, oself, message, event, 0,
					    GenFindParent(oself), MF_CALL);
}

@method GenClass, MSG_GEN_GUP_SEND_TO_OBJECT_OF_CLASS
{
    FlowDispatchSendOnOrDestroyClassedEvent(NULL, oself, message, event, 0,
					    GenFindParent(oself), 0);
}

@method GenClass, MSG_GEN_GUP_TEST_FOR_OBJECT_OF_CLASS
{
    Boolean r = FALSE;

    if (ObjIsObjectInClass(oself, class))
	return TRUE;
    GenCallParent(oself, message, &class, sizeof(class), &r, sizeof(r));
    return r;
}

@method GenClass, MSG_GEN_GUP_FIND_OBJECT_OF_CLASS
{
    optr r = 0;

    if (ObjIsObjectInClass(oself, class))
	return oself;
    GenCallParent(oself, message, &class, sizeof(class), &r, sizeof(r));
    return r;
}

@method GenClass, MSG_GEN_COUNT_CHILDREN
{
    return GenCountChildren(oself);
}

@method GenClass, MSG_GEN_CALL_PARENT
{
    FlowMessageClassedEvent(GenFindParent(oself),
			    MSG_META_SEND_CLASSED_EVENT, event, TO_SELF,
			    MF_CALL);
}

@method GenClass, MSG_GEN_SEND_TO_PARENT
{
    FlowMessageClassedEvent(GenFindParent(oself),
			    MSG_META_SEND_CLASSED_EVENT, event, TO_SELF, 0);
}

@method GenClass, MSG_GEN_CALL_APPLICATION
{
    FlowMessageClassedEvent(GeodeGetAppObject(0),
			    MSG_META_SEND_CLASSED_EVENT, event, TO_SELF,
			    MF_CALL);
}

@method GenClass, MSG_GEN_SEND_TO_PROCESS
{
    MessageSetDestination(event, ConstructOptr(GeodeGetProcessHandle(), 0));
    CMessageDispatchP(event, 0, NULL, 0);
}

@method GenClass, MSG_GEN_CALL_SYSTEM
{
    FlowMessageClassedEvent(UserGetSystemObject(),
			    MSG_META_SEND_CLASSED_EVENT, event, TO_SELF,
			    MF_CALL);
}

