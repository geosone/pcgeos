/* GenDetachAbort: the detach's ack goes out now (queued) */
@method GenClass, MSG_META_DETACH_ABORT
{
    DetachDataEntry *d = ObjVarFindData(oself, DETACH_DATA);
    word id;
    optr ack;

    if (!d)
	return;
    id = d->DDE_callerID;
    ack = d->DDE_ackOD;
    @send ,forceQueue ack::MSG_META_ACK(id, oself);
    ObjVarDeleteData(oself, DETACH_DATA);
}

@method GenClass, MSG_GEN_GET_ENABLED
{
    return (pself->GI_states & GS_ENABLED) != 0;
}

@method GenClass, MSG_GEN_GET_USABLE
{
    return (pself->GI_states & GS_USABLE) != 0;
}

@method GenClass, MSG_GEN_CHECK_IF_FULLY_ENABLED
{
    return GenCheckIfFullyEnabled(oself, FALSE);
}

@method GenClass, MSG_GEN_CHECK_IF_FULLY_USABLE
{
    return GenCheckIfFullyUsable(oself, FALSE);
}

@method GenClass, MSG_META_GRAB_TARGET_EXCL
{
    if (pself->GI_attrs & GA_TARGETABLE)
	@callsuper();
}

/* LoadOrSaveOptions: with ATTR_GEN_INIT_FILE_KEY the object loads
 * (saves) its options under its category; on to the children with
 * ATTR_GEN_INIT_FILE_PROPAGATE_TO_CHILDREN */
static void LoadOrSaveOptions(optr oself, Message meta, Message gen)
{
    char *key = ObjVarFindData(oself, ATTR_GEN_INIT_FILE_KEY);

    if (key) {
	GenOptionsParams p;
	word n = (word) VarDataSizePtr(key);

	memset(&p, 0, sizeof(p));
	if (n >= sizeof(p.GOP_key))
	    n = sizeof(p.GOP_key) - 1;
	memcpy(p.GOP_key, key, n);
	@call oself::MSG_META_GET_INI_CATEGORY(p.GOP_category);
	/* (a structure of the stack: ABI.md section 5) */
	CObjMessageP(MF_CALL, oself, gen, &p, sizeof(p), NULL, 0);
    }
    if (OptrToHandle(GenLock(oself)->GI_comp.CP_firstChild)) {
	GenUnlock(oself);
	if (ObjVarFindData(oself, ATTR_GEN_INIT_FILE_PROPAGATE_TO_CHILDREN))
	    GenSendToChildren(oself, meta, NULL, 0);
    } else {
	GenUnlock(oself);
    }
}

@method GenClass, MSG_META_LOAD_OPTIONS
{
    LoadOrSaveOptions(oself, message, MSG_GEN_LOAD_OPTIONS);
}

@method GenClass, MSG_META_SAVE_OPTIONS
{
    LoadOrSaveOptions(oself, message, MSG_GEN_SAVE_OPTIONS);
}

/* GGetAttrCommon: the string attribute (without trailing spaces), else
 * the parent's answer */
static Boolean GetAttrString(optr oself, Message msg, word attr, char *buf)
{
    char *s = ObjVarFindData(oself, attr);
    Boolean r = FALSE;

    *buf = 0;
    if (s) {
	word n = (word) VarDataSizePtr(s);
	memcpy(buf, s, n);
	buf[n] = 0;
	while (n && (buf[n - 1] == ' ' || !buf[n - 1]))
	    buf[--n] = 0;
	return TRUE;
    }
    GenCallParent(oself, msg, &buf, sizeof(buf), &r, sizeof(r));
    return r;
}

@method GenClass, MSG_META_GET_INI_CATEGORY
{
    GetAttrString(oself, message, ATTR_GEN_INIT_FILE_CATEGORY, buf);
}

@method GenClass, MSG_META_GET_HELP_FILE
{
    if (ObjVarFindData(oself, ATTR_GEN_HELP_FILE_FROM_INIT_FILE)) {
	char cat[INI_CATEGORY_BUFFER_SIZE];
	word size;

	cat[0] = 0;
	@call oself::MSG_META_GET_INI_CATEGORY(cat);
	if (cat[0] && !InitFileReadStringBuffer(cat, "helpfile", buf,
						INI_CATEGORY_BUFFER_SIZE &
						IFRF_SIZE, &size))
	    return TRUE;
    }
    return GetAttrString(oself, message, ATTR_GEN_HELP_FILE, buf);
}

@method GenClass, MSG_META_SET_HELP_FILE
{
    word n = (word) (LocalStringLength(buf) + 1);

    memcpy(ObjVarAddData(oself, ATTR_GEN_HELP_FILE, n), buf, n);
}

@method GenClass, MSG_META_GET_HELP_TYPE
{
    HelpType *t;
    Boolean r = FALSE;

    if (@callsuper())
	return TRUE;
    t = ObjVarFindData(oself, ATTR_GEN_HELP_TYPE);
    if (t) {
	retValue->HTR_helpType = *t;
	return TRUE;
    }
    GenCallParent(oself, message, &retValue, sizeof(retValue), &r,
		  sizeof(r));
    return r;
}

/* GenGenDestroy: not usable, the children destroyed, out of the parent,
 * freed (after the queue) */
@method GenClass, MSG_GEN_DESTROY
{
    struct { VisUpdateMode m; CompChildFlags f; } p;

    @call oself::MSG_GEN_SET_NOT_USABLE(updateMode);
    p.m = updateMode;
    p.f = flags;
    GenSendToChildren(oself, MSG_GEN_DESTROY, &p, sizeof(p));
    {
	struct { optr c; CompChildFlags f; } q;
	q.c = oself;
	q.f = flags;
	GenCallParent(oself, MSG_GEN_REMOVE_CHILD, &q, sizeof(q), NULL, 0);
    }
    @call oself::MSG_META_OBJ_FREE();
}

/*
 * GenDestroyAndFreeBlock: the object (the top of its block) out of the
 * tree and the block freed after the queue.  An object on the
 * application's active list is removed the usual way; else the specific
 * part may do it faster (TRUE: then only the downward link goes).
 */
@method GenClass, MSG_GEN_DESTROY_AND_FREE_BLOCK
{
    optr app = GeodeGetAppObject(0);
    Boolean onList = FALSE;

    if (app)
	onList = @call app::MSG_META_GCN_LIST_FIND_ITEM(
			ConstructOptr(OptrToHandle(oself), 0),
			MGCNLT_ACTIVE_LIST, MANUFACTURER_ID_GEOWORKS);
    if (!onList && @callsuper())
	GenRemoveDownwardLink(OptrToHandle(oself), OptrToChunk(oself), 0);
    else
	@call oself::MSG_GEN_REMOVE(VUM_NOW, 0);
    @send ,forceQueue oself::MSG_META_BLOCK_FREE();
    return TRUE;
}
