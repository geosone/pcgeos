optr GenAppProcessOptr(void)
{
    return ConstructOptr(GeodeGetProcessHandle(), 0);
}

/* ---------------------------------------------------------------------
 * State
 * ------------------------------------------------------------------- */

/* ---------------------------------------------------------------------
 * IACP: the application object is the server of the application's
 * token (genAppCommonIACP.asm)
 * ------------------------------------------------------------------- */

/* IACP/iacpMain.goc */

optr GenAppIACPConnects(optr oself)
{
    ChunkHandle ch = AppPart(oself)->GAI_iacpConnects;

    return ch ? ConstructOptr(OptrToHandle(oself), ch) : NullOptr;
}

/* ---------------------------------------------------------------------
 * Attach
 * ------------------------------------------------------------------- */

/*
 * GenAppAttach: from MSG_GEN_PROCESS_OPEN_APPLICATION.  The application
 * is usable from here; the specific UI attaches it, the options load
 * (not when restoring from state), the active list attaches, the windows
 * update, and it comes to the top.  The system is busy meanwhile; the
 * application is (completely) busy until the queue is through.
 */
@method GenApplicationClass, MSG_META_ATTACH_OBJECT
{
    optr model = NullOptr;
    UpdateWindowFlags uwf;
    EventHandle ev;
    optr *save;

    pself->GAI_attachFlags = flags;
    UserCallSystem(MSG_GEN_SYSTEM_MARK_BUSY, NULL, 0, NULL, 0);

    /* whatever was built before does not count; the model exclusive the
     * document control took at startup stays */
    if (!@call oself::MSG_META_GET_MODEL_EXCL(&model))
	model = NullOptr;
    if (OptrToHandle(model))
	@call model::MSG_META_RELEASE_MODEL_EXCL();
    GenSpecShrinkBranch(oself);
    if (OptrToHandle(model))
	@call model::MSG_META_GRAB_MODEL_EXCL();

    pself = AppPart(oself);
    pself->GI_states |= GS_USABLE;
    pself->GAI_states |= AS_ATTACHING;
    pself->GAI_states &= ~(AS_QUITTING | AS_TRANSPARENT_DETACHING);
    pself->GAI_attachFlags = flags;
    if (UserGetLaunchModel() == UILM_TRANSPARENT) {
	pself->GAI_states |= AS_TRANSPARENT;
	if (!(UserGetLaunchOptions() & UILO_CLOSABLE_APPS) &&
	    (save = ObjVarFindData(oself,
				   ATTR_GEN_APPLICATION_SAVE_OPTIONS_TRIGGER))
	    != NULL) {
	    optr t = *save;
	    GenInstance *g = GenLock(t);
	    g->GI_states &= ~GS_USABLE;
	    GenUnlock(t);
	}
    }
    /* the Save Options trigger not enabled until options change */
    if (!(flags & AAF_RESTORING_FROM_STATE) &&
	(save = ObjVarFindData(oself,
			       ATTR_GEN_APPLICATION_SAVE_OPTIONS_TRIGGER))
	!= NULL) {
	optr t = *save;
	GenInstance *g = GenLock(t);
	g->GI_states &= ~GS_ENABLED;
	ObjMarkDirty(t);
	GenUnlock(t);
    }

    @callsuper();

    if (!(flags & AAF_RESTORING_FROM_STATE))
	@call oself::MSG_META_LOAD_OPTIONS();
    {
	struct { word f; MemHandle alb, extra; } p;

	p.f = flags;
	p.alb = appLaunchBlock;
	p.extra = extraState;
	SendToGenAppGCNList(oself, MGCNLT_ACTIVE_LIST, MSG_META_ATTACH_OBJECT, &p,
		      sizeof(p));
    }
    @call oself::MSG_GEN_APPLICATION_MARK_APP_COMPLETELY_BUSY();

    uwf = UWF_ATTACHING | UWF_FROM_WINDOWS_LIST;
    if (flags & AAF_RESTORING_FROM_STATE)
	uwf |= UWF_RESTORING_FROM_STATE;
    {
	struct { UpdateWindowFlags f; VisUpdateMode m; } p;

	p.f = uwf;
	p.m = VUM_NOW;
	SendToGenAppGCNList(oself, GAGCNLT_WINDOWS, MSG_META_UPDATE_WINDOW, &p,
		      sizeof(p));
    }
    if (!(AppPart(oself)->GAI_launchFlags & ALF_DO_NOT_OPEN_ON_TOP))
	@call oself::MSG_GEN_BRING_TO_TOP();
    @call oself::MSG_GEN_APPLICATION_IACP_REGISTER(
	IACPSM_USER_INTERACTIBLE);
    @send, forceQueue oself::MSG_GEN_APPLICATION_OPEN_COMPLETE();
    UserCallSystem(MSG_GEN_SYSTEM_MARK_NOT_BUSY, NULL, 0, NULL, 0);

    ev = @record oself::MSG_GEN_APPLICATION_MARK_APP_NOT_COMPLETELY_BUSY();
    @call oself::MSG_META_OBJ_FLUSH_INPUT_QUEUE(ev,
		OFIQNS_INPUT_OBJ_OF_OWNING_GEODE, OptrToHandle(oself));
}

/* ---------------------------------------------------------------------
 * Detach
 * ------------------------------------------------------------------- */

/* ---------------------------------------------------------------------
 * Quit
 * ------------------------------------------------------------------- */

@classdecl UIApplicationClass;
/* genAppCommonIACP.goc */
@extern method UIApplicationClass, MSG_META_FUP_KBD_CHAR;
@extern method UIApplicationClass, MSG_META_NOTIFY_NO_FOCUS_WITHIN_NODE;
@extern method UIApplicationClass, MSG_META_MUP_ALTER_FTVMC_EXCL;

/* UIAppSpecBuild: the system object the geode's parent object */
@method UIApplicationClass, MSG_SPEC_BUILD
{
    @callsuper();
    WinGeodeSetParentObj(MemOwner(OptrToHandle(oself)),
			 UserGetSystemObject());
}

/* GenAppBuild */
/* an application made at run time is targetable (as the @default of a
 * declared one) */
@method GenApplicationClass, MSG_META_INITIALIZE
{
    pself->GI_attrs |= GA_TARGETABLE;
    @callsuper();
}
@method GenApplicationClass, MSG_GEN_APPLICATION_GET_LAUNCH_FLAGS
{
    return pself->GAI_launchFlags;
}
/*
 * GenApplicationBuildDialogFromTemplate: a copy of the template's
 * block (owned by the caller's geode, run by its thread), the dialog
 * the application's last child and usable
 */
@method GenApplicationClass, MSG_GEN_APPLICATION_BUILD_DIALOG_FROM_TEMPLATE
{
    optr dialog = ConstructOptr(ObjDuplicateResource(OptrToHandle(template),
						     0, 0),
				OptrToChunk(template));

    (void) pself;
    @call oself::MSG_GEN_ADD_CHILD(dialog, CCO_LAST);
    @call dialog::MSG_GEN_SET_USABLE(VUM_MANUAL);
    memset(retValue, 0, sizeof(*retValue));
    retValue->ND_dialog = dialog;
}
