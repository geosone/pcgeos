/*
 * genItem.goc -- GenItemClass (after genItem.asm): an item of a
 * GenItemGroup, known to it by its identifier.  What it looks like is
 * the specific UI's (SPIR_BUILD_ITEM: a radio button, a check box, a
 * list entry, after its group).
 */
@include "uiInt.goh"
@include <Objects/gItemC.goh>

@classdecl GenItemClass;

@method GenItemClass, MSG_META_RESOLVE_VARIANT_SUPERCLASS
{
    return GenQueryUICallSpecificUI(oself, SPIR_BUILD_ITEM, MasterOffset);
}

@method GenItemClass, MSG_GEN_ITEM_GET_IDENTIFIER
{
    return pself->GII_identifier;
}

@method GenItemClass, MSG_GEN_ITEM_SET_IDENTIFIER
{
    if (pself->GII_identifier != identifier) {
	pself->GII_identifier = identifier;
	ObjMarkDirty(oself);
    }
}
