}

@method GenClass, MSG_GEN_GET_FIXED_SIZE
{
    GetSizeHint(oself, HINT_FIXED_SIZE, fixedSize);
}

/*
 * HandleWinGeometryChange: the window hints of one kind (first to last)
 * replaced by the one for the type, then the specific part told.
 */
static void WinHint(optr oself, word first, word last, const word *table,
		    word count, byte type, word x, word y)
{
    word hint;

    ObjVarDeleteDataRange(oself, first, last, FALSE);
    hint = type < count ? table[type] : 0;
    if (!hint)
	return;
    if (hint & VDF_EXTRA_DATA) {
	SpecWinSizePair *sp = ObjVarAddData(oself, hint | VDF_SAVE_TO_STATE,
					    sizeof(SpecWinSizePair));
	sp->SWSP_x = x;
	sp->SWSP_y = y;
    } else {
	ObjVarAddData(oself, hint | VDF_SAVE_TO_STATE, 0);
    }
}

