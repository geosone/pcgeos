/* ChangeSizeHint: the hint (saved to state) set, or removed if no size
 * is given */
static void ChangeSizeHint(optr oself, word hint, word width, word height,
			   word count)
{
    if (!width && !height) {
	ObjVarDeleteData(oself, hint);
	return;
    }
    if (count) {
	CompSizeHintArgs *c = ObjVarAddData(oself, hint | VDF_SAVE_TO_STATE,
					    sizeof(CompSizeHintArgs));
	c->CSHA_width = width;
	c->CSHA_height = height;
	c->CSHA_count = count;
    } else {
	GadgetSizeHintArgs *g = ObjVarAddData(oself,
					      hint | VDF_SAVE_TO_STATE,
					      sizeof(GadgetSizeHintArgs));
	g->GSHA_width = width;
	g->GSHA_height = height;
    }
}

static void SetSizeAndRescan(optr oself, word hint, word width,
			     word height, word count, VisUpdateMode mode)
{
    ChangeSizeHint(oself, hint, width, height, count);
    if (VisCheckIfSpecBuilt(oself))
	@call oself::MSG_SPEC_P32_RESCAN_GEO_AND_UPDATE(VOF_GEOMETRY_INVALID,
							mode);
}

@method GenClass, MSG_GEN_SET_INITIAL_SIZE
{
    ChangeSizeHint(oself, HINT_INITIAL_SIZE, width, height, count);
    (void) updateMode;
}

@method GenClass, MSG_GEN_SET_MINIMUM_SIZE
{
    SetSizeAndRescan(oself, HINT_MINIMUM_SIZE, width, height, count,
		     updateMode);
}

@method GenClass, MSG_GEN_SET_MAXIMUM_SIZE
{
    SetSizeAndRescan(oself, HINT_MAXIMUM_SIZE, width, height, count,
		     updateMode);
}

@method GenClass, MSG_GEN_SET_FIXED_SIZE
{
    SetSizeAndRescan(oself, HINT_FIXED_SIZE, width, height, count,
		     updateMode);
}

/* GetArgs: the hint's size and count (0 if there is no hint) */
static void GetSizeHint(optr oself, word hint, GetSizeArgs *r)
{
    CompSizeHintArgs *c = ObjVarFindData(oself, hint);

    memset(r, 0, sizeof(*r));
    if (!c)
	return;
    r->GSA_width = c->CSHA_width;
    r->GSA_height = c->CSHA_height;
    if (VarDataSizePtr(c) != sizeof(GadgetSizeHintArgs))
	r->GSA_count = c->CSHA_count;
}

@method GenClass, MSG_GEN_GET_INITIAL_SIZE
{
    GetSizeHint(oself, HINT_INITIAL_SIZE, initSize);
}

@method GenClass, MSG_GEN_GET_MINIMUM_SIZE
{
