/*
 * GenOutputAction: the event to the destination; with none (0, the
 * asm's cx = 0) it goes as a classed event: to ATTR_GEN_DESTINATION_CLASS
 * if there is one, from ATTR_GEN_OUTPUT_TRAVEL_START or this object, in
 * the travel option the event's destination holds.  A null event (dest
 * 0 and no travel option) is destroyed.
 */
@method GenClass, MSG_GEN_OUTPUT_ACTION
{
    optr cls, *start;
    DestinationClassArgs *dca;

    if (OptrToHandle(dest)) {
	MessageSetDestination(event, dest);
	CMessageDispatchP(event, 0, NULL, 0);
	return;
    }
    if (!OptrToChunk(dest)) {
	ObjFreeMessage(event);
	return;
    }
    dca = ObjVarFindData(oself, ATTR_GEN_DESTINATION_CLASS);
    if (dca) {
	cls = (optr) (uintptr_t) dca->DCA_class;
	MessageSetDestination(event, cls);
    }
    start = ObjVarFindData(oself, ATTR_GEN_OUTPUT_TRAVEL_START);
    if (start) {
	optr s = *start;
	@send s::MSG_META_SEND_CLASSED_EVENT(event, OptrToChunk(dest));
    } else
	@call oself::MSG_META_SEND_CLASSED_EVENT(event, OptrToChunk(dest));
}

/* HintRequiresOneWordData */
static Boolean HintOneWord(word hint)
{
    hint &= VDF_TYPE;
    return hint == HINT_CUSTOM_CHILD_SPACING || hint == ATTR_GEN_POSITION_X ||
	   hint == ATTR_GEN_POSITION_Y || hint == HINT_WRAP_AFTER_CHILD_COUNT;
}

@method GenClass, MSG_GEN_ADD_GEOMETRY_HINT
{
    if (HintOneWord(hint))
	*(word *) ObjVarAddData(oself, hint, sizeof(word)) = hintArgument;
    else
	ObjVarAddData(oself, hint, 0);
    @call oself::MSG_SPEC_P32_RESCAN_GEO_AND_UPDATE(
	VOF_GEOMETRY_INVALID | VOF_IMAGE_INVALID, updateMode);
}

@method GenClass, MSG_GEN_REMOVE_GEOMETRY_HINT
{
    ObjVarDeleteData(oself, hint);
    @call oself::MSG_SPEC_P32_RESCAN_GEO_AND_UPDATE(
	VOF_GEOMETRY_INVALID | VOF_IMAGE_INVALID, updateMode);
}

/*
 * GenFindTextMoniker: this object (unless GFTMF_SKIP_THIS_NODE) if its
 * text moniker starts with the text (or is it, GFTMF_EXACT_MATCH), else
 * the first child's answer.
 */
typedef struct {
    char *text;
    GenFindObjectWithMonikerFlags flags;
    optr found;
} FindTextData;

static Boolean FindTextCallback(optr parent, optr child, void *data)
{
    FindTextData *d = data;

    (void) parent;
    d->found = @call child::MSG_GEN_FIND_OBJECT_WITH_TEXT_MONIKER(d->text,
			  d->flags & GFTMF_EXACT_MATCH);
    return d->found != 0;
}

@method GenClass, MSG_GEN_FIND_OBJECT_WITH_TEXT_MONIKER
{
    FindTextData d;

    if (!(flags & GFTMF_SKIP_THIS_NODE) && pself->GI_visMoniker) {
	VisMoniker *m = LMemDeref(ConstructOptr(OptrToHandle(oself),
						pself->GI_visMoniker));
	const char *t = (const char *) m + VMWT_text;

	if (!(m->VM_type & (VMT_GSTRING | VMT_MONIKER_LIST)) && *t) {
	    word n = LocalStringLength(text);
	    if (!LocalCmpStrings(t, text, n) &&
		(!(flags & GFTMF_EXACT_MATCH) || !t[n]))
		return oself;
	}
    }
    d.text = text;
    d.flags = flags;
    d.found = 0;
    GenCallChildren(oself, FindTextCallback, &d);
    return d.found;
}

@method GenClass, MSG_GEN_FIND_OBJECT_WITH_TEXT_MONIKER_C
{
    return @call oself::MSG_GEN_FIND_OBJECT_WITH_TEXT_MONIKER(text, flags);
}

