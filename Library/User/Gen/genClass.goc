/*
 * genClass.goc -- GenClass (after genClassBuild.asm, genClassCommon.asm
 * and genClassMisc.asm), the generic object: the generic tree, the
 * usable and enabled states, the moniker, the keyboard accelerator,
 * hints, upward queries and classed events.
 *
 * GenClass is a variant master class above VisClass: what a generic
 * object looks like comes from the specific UI, whose class the object
 * resolves when its specific part is first needed (a Gen subclass
 * answers MSG_META_RESOLVE_VARIANT_SUPERCLASS by
 * GenQueryUICallSpecificUI).  Many messages are passed to the specific
 * part only once it is grown, so that a generic tree that is not usable
 * stays without one.
 *
 * Port32 (Port32/ABI.md section 13x):
 *   - all methods are in this file (goc wants them with @classdecl);
 *   - MSG_GEN_GUP_ENSURE_UPDATE_WINDOW returns its carry as
 *     MSG_GEN_P32_GUP_ENSURE_UPDATE_WINDOW, MSG_SPEC_GUP_QUERY has
 *     MSG_GEN_GUP_QUERY's parameters (MSG_SPEC_P32_GUP_QUERY), and
 *     MSG_SPEC_RESCAN_GEO_AND_UPDATE the VisOptFlags
 *     (MSG_SPEC_P32_RESCAN_GEO_AND_UPDATE; Internal/specC.goh);
 *   - the moniker's source is a VisMonikerSource (an optr);
 *   - not yet: MSG_GEN_BRANCH_REPLACE_PARAMS (dword optrs),
 *     MSG_META_BRING_UP_HELP, the view ranges.
 */
@include "uiInt.goh"
#include <initfile.h>
#include <string.h>
#include <localize.h>

@classdecl GenClass;

#define GEN_MASTER	word_offsetof(GenBase, Gen_offset)
#define GEN_COMP	word_offsetof(GenInstance, GI_comp)
#define GEN_LINK	word_offsetof(GenInstance, GI_link)

/*
 * GenCallMeta: a message the specific part has a say in only once it is
 * grown; before, MetaClass (VisClass's superclass) handles it, and the
 * specific UI is not resolved for it.
 */
static void CallMeta(optr oself, Message msg, const void *p, word ps,
		     void *r, word rs)
{
    CObjCallSuperP(GenCheckIfSpecGrown(oself) ? &GenClass : &VisClass,
		   oself, msg, p, ps, r, rs);
}

/* ---------------------------------------------------------------------
 * Building (genClassBuild.asm)
 * ------------------------------------------------------------------- */

/* GenInitialize: a new object is enabled, but not usable */
@method GenClass, MSG_META_INITIALIZE
{
    pself->GI_states |= GS_ENABLED;
}

/* GenBuild: only a subclass knows what to be built into */
@method GenClass, MSG_META_RESOLVE_VARIANT_SUPERCLASS
{
    (void) MasterOffset;
    FatalError(UI_ERROR_NO_SPECIFIC_UI);
    return NULL;
}

@method GenClass, MSG_META_FINAL_OBJ_FREE
{
    if (pself->GI_visMoniker)
	ObjFreeChunk(ConstructOptr(OptrToHandle(oself),
				   pself->GI_visMoniker));
    CallMeta(oself, message, NULL, 0, NULL, 0);
}

@method GenClass, MSG_META_BLOCK_FREE
{
    CallMeta(oself, message, NULL, 0, NULL, 0);
}

@method GenClass, MSG_META_OBJ_FREE
{
    CallMeta(oself, message, NULL, 0, NULL, 0);
}

@method GenClass, MSG_META_OBJ_FLUSH_INPUT_QUEUE
{
    struct { EventHandle e; ObjFlushInputQueueNextStop n; MemHandle b; } p;

    p.e = event;
    p.n = nextStop;
    p.b = objBlock;
    CallMeta(oself, message, &p, sizeof(p), NULL, 0);
}

@method GenClass, MSG_META_DETACH
{
    struct { word id; optr caller; } p;

    p.id = callerID;
    p.caller = caller;
    CallMeta(oself, message, &p, sizeof(p), NULL, 0);
}

@method GenClass, MSG_META_DETACH_COMPLETE
{
    struct { word id; optr ack; } p;

    p.id = callerID;
    p.ack = ackOD;
    CallMeta(oself, message, &p, sizeof(p), NULL, 0);
}

@method GenClass, MSG_META_WIN_DEC_REF_COUNT
{
    CallMeta(oself, message, &win, sizeof(win), NULL, 0);
}

@method GenClass, MSG_META_GCN_LIST_SEND
{
    struct {
	GCNListSendFlags f; EventHandle e; MemHandle b; word t;
	ManufacturerID m;
    } p;

    p.f = flags;
    p.e = event;
    p.b = block;
    p.t = listType;
    p.m = listManuf;
    CallMeta(oself, message, &p, sizeof(p), NULL, 0);
}

@method GenClass, MSG_META_ADD_VAR_DATA
{
    struct { word t; word s; void *d; } p;

    p.t = dataType;
    p.s = dataSize;
    p.d = data;
    CallMeta(oself, message, &p, sizeof(p), NULL, 0);
}

@method GenClass, MSG_META_SET_OBJ_BLOCK_OUTPUT
{
    CallMeta(oself, message, &output, sizeof(output), NULL, 0);
}

@method GenClass, MSG_META_SET_FLAGS
{
    struct { ChunkHandle c; ObjChunkFlags s, r; } p;

    p.c = objChunk;
    p.s = bitsToSet;
    p.r = bitsToClear;
    CallMeta(oself, message, &p, sizeof(p), NULL, 0);
}

@method GenClass, MSG_META_GET_FLAGS
{
    word r = 0;

    CallMeta(oself, message, &ch, sizeof(ch), &r, sizeof(r));
    return r;
}

/* GenInitializeVarData: the object's path starts as SP_TOP */
@method GenClass, MSG_META_INITIALIZE_VAR_DATA
{
    word r = 0;

    if (dataType == ATTR_GEN_PATH_DATA)
	return GenPathInitPathData(oself, ATTR_GEN_PATH_DATA);
    CallMeta(oself, message, &dataType, sizeof(dataType), &r, sizeof(r));
    return r;
}

/* ---------------------------------------------------------------------
 * The object's path (genPathUtils.goc)
 * ------------------------------------------------------------------- */

/* GenPathSet: then the specific part's.  TRUE if the path cannot be
 * set. */
@method GenClass, MSG_GEN_PATH_SET
{
    if (GenPathSetObjectPath(oself, path, ATTR_GEN_PATH_DATA,
			     TEMP_GEN_PATH_SAVED_DISK_HANDLE, disk, 0))
	return TRUE;
    if (GenCheckIfSpecGrown(oself))
	return @callsuper();
    return FALSE;
}

/* GenPathGet: non-zero if the path does not fit or has no disk.
 * MSG_GEN_PATH_GET_BLOCK (no buffer): the handle of a new block with
 * the path, 0 if it has no disk. */
@method GenClass, MSG_GEN_PATH_GET
{
    MemHandle block = 0;
    Boolean err = GenPathGetObjectPath(oself, ATTR_GEN_PATH_DATA,
				       TEMP_GEN_PATH_SAVED_DISK_HANDLE,
				       buffer, bufSize, 0, &block);

    if (buffer)
	return err ? 1 : 0;
    return err ? 0 : block;
}

@method GenClass, MSG_GEN_PATH_GET_DISK_HANDLE
{
    return GenPathFetchDiskHandleAndDerefPath(oself, ATTR_GEN_PATH_DATA,
				TEMP_GEN_PATH_SAVED_DISK_HANDLE, 0);
}

/* GenPathRestoreDiskPrompt: the specific UI may ask for the disk; else
 * a standard dialog does */
@method GenClass, MSG_META_GEN_PATH_RESTORE_DISK_PROMPT
{
    extern DiskRestoreError GenPathAskForDisk(
				const GenPathDiskRestoreArgs *args);

    if (GenCheckIfSpecGrown(oself) && @callsuper())
	return TRUE;
    *error = GenPathAskForDisk(args);
    return TRUE;
}

/*
 * GenAddGenChild: a child added to an object that has no specific part
 * loses its own (it is built with the parent); a child on the keyboard
 * accelerator path (or with an accelerator) puts the parents on it.
 */
@method GenClass, MSG_GEN_ADD_CHILD
{
    GenInstance *g;
    Boolean path;

    if (!GenCheckIfSpecGrown(oself)) {
	ObjLockObjBlock(OptrToHandle(child));
	GenSpecShrinkBranch(child);
	MemUnlock(OptrToHandle(child));
    }
    ObjCompAddChild(oself, child, flags, GEN_MASTER, GEN_COMP, GEN_LINK);
    g = GenLock(child);
    path = g->GI_attrs & GA_KBD_SEARCH_PATH ||
	   g->GI_kbdAccelerator & 0x00ff;		/* KS_CHAR */
    if (path)
	g->GI_attrs &= ~GA_KBD_SEARCH_PATH;
    GenUnlock(child);
    if (path)
	@call child::MSG_GEN_SET_KBD_MKR_PATH();
}

@method GenClass, MSG_GEN_ADD_CHILD_UPWARD_LINK_ONLY
{
    GenAddChildUpwardLinkOnly(oself, child);
}

@method GenClass, MSG_GEN_GROW_PARENTS
{
    GenSpecGrowParents(oself);
}

/* GenSetKbdMkrPath: up to the application */
@method GenClass, MSG_GEN_SET_KBD_MKR_PATH
{
    optr p;

    if (pself->GI_attrs & GA_KBD_SEARCH_PATH)
	return;
    pself->GI_attrs |= GA_KBD_SEARCH_PATH;
    if (ObjIsObjectInClass(oself, &GenApplicationClass))
	return;
    p = GenFindParent(oself);
    if (p)
	@call p::MSG_GEN_SET_KBD_MKR_PATH();
}

@method GenClass, MSG_GEN_REMOVE
{
    @call oself::MSG_GEN_SET_NOT_USABLE(updateMode);
    {
	struct { optr c; CompChildFlags f; } p;
	p.c = oself;
	p.f = flags;
	GenCallParent(oself, MSG_GEN_REMOVE_CHILD, &p, sizeof(p), NULL, 0);
    }
}

@method GenClass, MSG_GEN_REMOVE_CHILD
{
    GenRemoveGenChildLow(oself, child, flags);
}

@method GenClass, MSG_GEN_MOVE_CHILD
{
    ObjCompMoveChild(oself, child, flags, GEN_MASTER, GEN_COMP, GEN_LINK);
}

/* the child's number, -1 if it is not one */
@method GenClass, MSG_GEN_FIND_CHILD
{
    return ObjCompFindChildByOptr(oself, child, GEN_MASTER, GEN_COMP,
				  GEN_LINK);
}

@method GenClass, MSG_GEN_FIND_CHILD_AT_POSITION
{
    return ObjCompFindChildByNumber(oself, position, GEN_MASTER, GEN_COMP,
				    GEN_LINK);
}

@method GenClass, MSG_GEN_FIND_PARENT
{
    return GenFindParent(oself);
}

/*
 * GenCopyTree: a copy of the object (and its moniker) in destBlock,
 * added as the last child of parentChunk there (not usable while it is
 * added), then the children copied below it.
 */
@method GenClass, MSG_GEN_COPY_TREE
{
    MemHandle src = OptrToHandle(oself);
    word oflags = ObjGetFlags(oself);
    ChunkHandle ch, mk;
    optr copy;
    GenInstance *g;
    word srcMoniker = pself->GI_visMoniker;

    ch = GenCopyChunk(destBlock, src, OptrToChunk(oself),
		      flags & CCF_MARK_DIRTY);
    copy = ConstructOptr(destBlock, ch);
    ObjLockObjBlock(destBlock);
    ObjSetFlags(copy, oflags & (OCF_IS_OBJECT | OCF_VARDATA_RELOC), 0);
    mk = GenCopyChunk(destBlock, src, srcMoniker, flags & CCF_MARK_DIRTY);
    g = GenPart(copy);
    g->GI_visMoniker = mk;
    g->GI_link.LP_next = 0;
    g->GI_comp.CP_firstChild = 0;
    MemUnlock(destBlock);
    if (parentChunk) {
	optr parent = ConstructOptr(destBlock, parentChunk);
	GenStates st;

	g = GenLock(copy);
	st = g->GI_states;
	g->GI_states &= ~GS_USABLE;
	GenUnlock(copy);
	@call parent::MSG_GEN_ADD_CHILD(copy, flags);
	g = GenLock(copy);
	g->GI_states = st;
	GenUnlock(copy);
    }
    {
	struct { MemHandle b; ChunkHandle c; CompChildFlags f; } p;
	p.b = destBlock;
	p.c = ch;
	p.f = (flags & CCF_MARK_DIRTY) | CCO_LAST;
	GenSendToChildren(oself, MSG_GEN_COPY_TREE, &p, sizeof(p));
    }
    return copy;
}

/* ---------------------------------------------------------------------
 * States, attributes, monikers, accelerators, hints
 * (genClassCommon.asm)
 * ------------------------------------------------------------------- */

@method GenClass, MSG_GEN_ACTIVATE_INTERACTION_DEFAULT
{
    return @call oself::MSG_SPEC_ACTIVATE_INTERACTION_DEFAULT();
}

@method GenClass, MSG_GEN_START_BROADCAST_FOR_DEFAULT_FOCUS
{
    return @call oself::MSG_SPEC_START_BROADCAST_FOR_DEFAULT_FOCUS();
}

static void SetState(optr oself, GenStates set, GenStates clear)
{
    GenInstance *g = GenLock(oself);

    g->GI_states = (GenStates) ((g->GI_states | set) & ~clear);
    GenUnlock(oself);
    ObjMarkDirty(oself);
}

/*
 * GenGenSetUsable: once the whole branch up is usable, the specific UI
 * builds it (from scratch: what was grown before goes).
 */
@method GenClass, MSG_GEN_SET_USABLE
{
    if (pself->GI_states & GS_USABLE)
	return;
    SetState(oself, GS_USABLE, 0);
    if (!GenCheckIfFullyUsable(oself, TRUE))
	return;
    GenSpecShrinkBranch(oself);
    @call oself::MSG_SPEC_SET_USABLE(updateMode);
}

@method GenClass, MSG_GEN_SET_NOT_USABLE
{
    Boolean was;

    if (!(pself->GI_states & GS_USABLE))
	return;
    was = GenCheckIfFullyUsable(oself, TRUE);
    SetState(oself, 0, GS_USABLE);
    if (was && GenCheckIfSpecGrown(oself))
	@call oself::MSG_SPEC_SET_NOT_USABLE(updateMode);
}

@method GenClass, MSG_GEN_UPDATE_VISUAL
{
    if (GenCheckIfSpecGrown(oself))
	@call oself::MSG_SPEC_UPDATE_VISUAL(updateMode);
}

/* EnableCommon: the object of a usable, built branch notified (and
 * through it its children) */
static void EnableCommon(optr oself, GenStates set, GenStates clear,
			 Message notify, VisUpdateMode mode)
{
    struct { VisUpdateMode m; byte f; } p;
    Boolean r;

    SetState(oself, set, clear);
    if (!GenCheckIfFullyUsable(oself, FALSE) || !GenCheckIfSpecGrown(oself))
	return;
    p.m = mode;
    p.f = NEF_STATE_CHANGING;
    CObjMessageP(MF_CALL, oself, notify, &p, sizeof(p), &r, sizeof(r));
}

@method GenClass, MSG_GEN_SET_ENABLED
{
    if (!(pself->GI_states & GS_ENABLED))
	EnableCommon(oself, GS_ENABLED, 0, MSG_GEN_NOTIFY_ENABLED,
		     updateMode);
}

@method GenClass, MSG_GEN_SET_NOT_ENABLED
{
    if (pself->GI_states & GS_ENABLED)
	EnableCommon(oself, 0, GS_ENABLED, MSG_GEN_NOTIFY_NOT_ENABLED,
		     updateMode);
}

/* NotifyEnabledCommon: the specific part told; if that changed
 * something, the children too (their own state is not changing) */
static Boolean NotifyEnabledCommon(optr oself, Message spec,
				   Message gen, VisUpdateMode mode, byte flags)
{
    struct { VisUpdateMode m; byte f; } p;
    Boolean r = FALSE;
    GenStates st = GenLock(oself)->GI_states;

    GenUnlock(oself);
    if (!(st & GS_USABLE) || !GenCheckIfSpecGrown(oself))
	return FALSE;
    p.m = mode;
    p.f = flags;
    CObjMessageP(MF_CALL, oself, spec, &p, sizeof(p), &r, sizeof(r));
    if (!r)
	return FALSE;
    p.f = (byte) (flags & ~NEF_STATE_CHANGING);
    GenSendToChildren(oself, gen, &p, sizeof(p));
    return TRUE;
}

@method GenClass, MSG_GEN_NOTIFY_ENABLED
{
    return NotifyEnabledCommon(oself, MSG_SPEC_NOTIFY_ENABLED, message,
			       updateMode, flags);
}

@method GenClass, MSG_GEN_NOTIFY_NOT_ENABLED
{
    return NotifyEnabledCommon(oself, MSG_SPEC_NOTIFY_NOT_ENABLED, message,
			       updateMode, flags);
}

@method GenClass, MSG_GEN_GET_VIS_MONIKER
{
    return pself->GI_visMoniker;
}

/* the moniker's size (0, 0 if there is none, or it is a list) */
static SizeAsDWord MonikerSize(optr oself)
{
    ChunkHandle m = GenLock(oself)->GI_visMoniker;
    SizeAsDWord s = 0;

    GenUnlock(oself);
    if (m)
	s = VisGetMonikerSize(oself, m, 0, 0);
    return s;
}

/*
 * UpdateMoniker: the specific part shows the new moniker (a list is
 * resolved first if the object is usable); old width and height for
 * the geometry.
 */
static void UpdateMoniker(optr oself, VisUpdateMode mode, word oldWidth,
			  word oldHeight)
{
    ChunkHandle m;

    if (!GenCheckIfSpecGrown(oself))
	return;
    m = GenLock(oself)->GI_visMoniker;
    if (m && ((VisMoniker *) LMemDeref(ConstructOptr(OptrToHandle(oself),
						      m)))->VM_type &
	     VMT_MONIKER_LIST) {
	GenUnlock(oself);
	if (!GenCheckIfFullyUsable(oself, FALSE))
	    return;
	@call oself::MSG_SPEC_RESOLVE_MONIKER_LIST(m);
    } else {
	GenUnlock(oself);
    }
    @callsuper oself::GenClass::MSG_SPEC_UPDATE_VIS_MONIKER(mode, oldWidth,
							   oldHeight);
}

@method GenClass, MSG_GEN_USE_VIS_MONIKER
{
    SizeAsDWord old = 0;

    ObjMarkDirty(oself);
    if (GenCheckIfSpecGrown(oself))
	old = MonikerSize(oself);
    GenLock(oself)->GI_visMoniker = moniker;
    GenUnlock(oself);
    UpdateMoniker(oself, updateMode, DWORD_WIDTH(old), DWORD_HEIGHT(old));
}

@method GenClass, MSG_GEN_CREATE_VIS_MONIKER
{
    Boolean failed;

    return VisCreateMonikerChunk(oself, 0, flags, height, width, length,
				 dataType, sourceType, source, &failed);
}

/* ReplaceVisMonikerGetSize: the cached size of the current moniker
 * (computed if the object is grown and it is a gstring) */
static void ReplaceGetSize(optr oself, word *w, word *h)
{
    ChunkHandle m = GenLock(oself)->GI_visMoniker;
    VisMoniker *vm;

    *w = *h = 0;
    if (!m) {
	GenUnlock(oself);
	return;
    }
    vm = LMemDeref(ConstructOptr(OptrToHandle(oself), m));
    if (vm->VM_type & VMT_MONIKER_LIST) {
	GenUnlock(oself);
	return;
    }
    *w = vm->VM_width;
    if (!(vm->VM_type & VMT_GSTRING)) {
	GenUnlock(oself);
	return;
    }
    *h = ((VisMonikerWithGString *) vm)->VMWGS_height;
    GenUnlock(oself);
    if (GenCheckIfSpecGrown(oself)) {
	SizeAsDWord s = VisGetMonikerSize(oself, m, 0, 0);
	*w = DWORD_WIDTH(s);
	*h = DWORD_HEIGHT(s);
    }
}

/*
 * GenReplaceVisMoniker: a new moniker made over the current one (or a
 * new chunk if there is none); VMDT_NULL: no moniker.
 */
@method GenClass, MSG_GEN_REPLACE_VIS_MONIKER
{
    ChunkHandle old, m;
    word w, h;
    Boolean failed;

    ObjMarkDirty(oself);
    if (dataType != VMDT_NULL) {
	ReplaceGetSize(oself, &w, &h);
	old = GenLock(oself)->GI_visMoniker;
	GenUnlock(oself);
	m = VisCreateMonikerChunk(oself, old, CVMF_DIRTY, height, width,
				  length, dataType, sourceType, source,
				  &failed);
	if (!failed) {
	    if (old) {
		UpdateMoniker(oself, updateMode, w, h);
		return m;
	    }
	    if (ObjGetFlags(oself) & OCF_IGNORE_DIRTY)
		ObjSetFlags(ConstructOptr(OptrToHandle(oself), m),
			    OCF_IGNORE_DIRTY, 0);
	    @call oself::MSG_GEN_USE_VIS_MONIKER(m, updateMode);
	    return m;
	}
    }
    old = GenLock(oself)->GI_visMoniker;
    GenUnlock(oself);
    if (old) {
	@call oself::MSG_GEN_USE_VIS_MONIKER(0, updateMode);
	ObjFreeChunk(ConstructOptr(OptrToHandle(oself), old));
    }
    return 0;
}

@method GenClass, MSG_GEN_REPLACE_VIS_MONIKER_OPTR
{
    return @call oself::MSG_GEN_REPLACE_VIS_MONIKER(updateMode, 0, 0, 0,
						    VMDT_VIS_MONIKER,
						    VMST_OPTR, source);
}

@method GenClass, MSG_GEN_REPLACE_VIS_MONIKER_TEXT
{
    return @call oself::MSG_GEN_REPLACE_VIS_MONIKER(updateMode, 0, 0, 0,
				VMDT_TEXT, VMST_FPTR,
				(VisMonikerSource) (uintptr_t) source);
}

static void MonikerArgs(DrawMonikerArgs *a, word textHeight,
			GStateHandle gs, word yMax, word xMax, word yInset,
			word xInset)
{
    a->DMA_xInset = xInset;
    a->DMA_yInset = yInset;
    a->DMA_xMaximum = xMax;
    a->DMA_yMaximum = yMax;
    a->DMA_gState = gs;
    a->DMA_textHeight = textHeight;
}

@method GenClass, MSG_GEN_DRAW_MONIKER
{
    DrawMonikerArgs a;

    MonikerArgs(&a, textHeight, gState, yMaximum, xMaximum, yInset, xInset);
    VisDrawMoniker(oself, pself->GI_visMoniker, monikerFlags, &a);
}

@method GenClass, MSG_GEN_GET_MONIKER_POS
{
    DrawMonikerArgs a;

    MonikerArgs(&a, textHeight, gState, yMaximum, xMaximum, yInset, xInset);
    return VisGetMonikerPos(oself, pself->GI_visMoniker, monikerFlags, &a);
}

@method GenClass, MSG_GEN_GET_MONIKER_SIZE
{
    return VisGetMonikerSize(oself, pself->GI_visMoniker, textHeight,
			     gState);
}

/*
 * GenFindMoniker: the moniker of the object (or the application's,
 * MSG_GEN_APPLICATION_FIND_MONIKER), of a list the one fitting the
 * search flags and the display type best (VisFindMoniker); copied as
 * the flags ask.  0 if none.  Port32, not yet: the icon and text
 * combination (HINT_USE_ICON_TEXT_COMBINATION_MONIKER).
 */
@method GenClass, MSG_GEN_FIND_MONIKER
{
    optr src;
    MemHandle sh = OptrToHandle(oself);
    ChunkHandle m;
    VisMoniker *vm;

    if (useAppMonikerList) {
	src = GeodeGetAppObject(0);
	if (!src)
	    return 0;
	return @call src::MSG_GEN_APPLICATION_FIND_MONIKER(destBlock,
		searchFlags,
		UserLimitDisplayTypeToStandard(
		    (DisplayType) (UserGetDisplayType() >> 8)));
    }
    m = GenLock(oself)->GI_visMoniker;
    if (!(searchFlags & VMSF_COPY_CHUNK)) {
	/* no list: the moniker itself */
	if (!m) {
	    GenUnlock(oself);
	    return 0;
	}
	vm = LMemDeref(ConstructOptr(sh, m));
	if (!(vm->VM_type & VMT_MONIKER_LIST)) {
	    GenUnlock(oself);
	    return ConstructOptr(sh, m);
	}
    }
    GenUnlock(oself);
    return VisFindMoniker(ConstructOptr(sh, m), searchFlags, destBlock,
			  UserLimitDisplayTypeToStandard(
			      (DisplayType) (UserGetDisplayType() >> 8)));
}

/* GenFindKbdAccelerator: the specific part, then the accelerator, then
 * the children on the search path */
typedef struct {
    word c, f, s;
    Boolean found;
} FindAccelData;

static Boolean FindAccelCallback(optr parent, optr child, void *data)
{
    FindAccelData *d = data;
    GenAttrs a = GenLock(child)->GI_attrs;

    (void) parent;
    GenUnlock(child);
    if (!(a & GA_KBD_SEARCH_PATH))
	return FALSE;
    d->found = @call child::MSG_GEN_FIND_KBD_ACCELERATOR(d->c, d->f, d->s);
    return d->found;
}

@method GenClass, MSG_GEN_FIND_KBD_ACCELERATOR
{
    FindAccelData d;

    if (!(pself->GI_states & GS_USABLE))
	return FALSE;
    if (@callsuper())
	return TRUE;
    if (!(GenLock(oself)->GI_states & GS_ENABLED)) {
	GenUnlock(oself);
	return FALSE;
    }
    GenUnlock(oself);
    if (GenCheckKbdAccelerator(oself, charValue, charFlagsAndShiftState,
			       toggleStateAndScanCode)) {
	@send ,forceQueue,insertAtFront oself::MSG_GEN_ACTIVATE();
	return TRUE;
    }
    d.c = charValue;
    d.f = charFlagsAndShiftState;
    d.s = toggleStateAndScanCode;
    d.found = FALSE;
    GenCallChildren(oself, FindAccelCallback, &d);
    return d.found;
}

@method GenClass, MSG_GEN_GET_KBD_ACCELERATOR
{
    return pself->GI_kbdAccelerator;
}

@method GenClass, MSG_GEN_SET_KBD_ACCELERATOR
{
    optr o = oself;

    pself->GI_kbdAccelerator = accelerator;
    if (!accelerator)
	return;
    @call oself::MSG_GEN_SET_KBD_MKR_PATH();
    if (!GenCheckIfSpecGrown(oself))
	return;
    if (VisLock(oself)->VI_specAttrs & SA_USES_DUAL_BUILD) {
	VisUnlock(oself);
	o = VisGetSpecificVisObject(oself, 0);
    } else {
	VisUnlock(oself);
    }
    if (o)
	@call o::MSG_SPEC_UPDATE_KBD_ACCELERATOR(updateMode);
}

