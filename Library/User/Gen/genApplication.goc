/*
 * genApplication.goc -- GenApplicationClass (after genAppAttDet.asm,
 * genAppMisc.asm and genAppCommonIACP.asm): the top of the usable and
 * enabled checks (GenCheckIfFullyUsable), the class of the specific UI
 * it is built into, its state, and its part in the life of the process
 * (procClass.goc): the startup on its field, the attach (usable, the
 * active list and the windows), the detach, the close and shutdown
 * (off the field), and the quit levels.
 *
 * Port32 (Port32/ABI.md section 13x):
 *  - the application asks no field for its specific UI
 *    (MSG_SPEC_GUP_QUERY's GenReturnParams hold no 32-bit handle); it
 *    takes GAI_specificUI, else the UI's own (UserGetSpecificUI);
 *  - without a field in its AppLaunchBlock it goes on the system's
 *    default field (the asm asked the specific UI's system,
 *    MSG_SPEC_GUP_QUERY_VIS_PARENT);
 *  - MSG_GEN_APPLICATION_IACP_REGISTER has its parameter, the
 *    IACPServerMode (CL in the asm, missing in the C prototype);
 *  - not yet: state files and the restart list of the field, transparent
 *    detach, the floating keyboard, the removable disk list, the
 *    activation dialog, the save options query on quit.
 */
@include "uiInt.goh"
@include <Objects/gSysC.goh>
@include <Objects/gFieldC.goh>
@include <Objects/gDocC.goh>
@include <Objects/gDocGrpC.goh>
@include <Objects/gDocCtrl.goh>
@include <alb.goh>
@include <iacp.goh>
#include <chunkarr.h>
#include <file.h>
#include <initfile.h>
#include <string.h>

@classdecl GenApplicationClass;

/* GenAppBuild */
/* an application made at run time is targetable (as the @default of a
 * declared one) */
@method GenApplicationClass, MSG_META_INITIALIZE
{
    pself->GI_attrs |= GA_TARGETABLE;
    @callsuper();
}

/* GenAppSetAttrs: a change of GA_TARGETABLE goes to the specific UI
 * too, once grown (it lets the target go) */
@method GenApplicationClass, MSG_GEN_SET_ATTRS
{
    if (!((attrsToSet | attrsToClear) & GA_TARGETABLE) ||
	!GenCheckIfSpecGrown(oself)) {
	@callsuper();
	return;
    }
    pself->GI_attrs = (GenAttrs) ((pself->GI_attrs & ~attrsToClear) |
				  attrsToSet);
    @callsuper oself::GenClass::MSG_GEN_SET_ATTRS(attrsToSet, attrsToClear);
}

@method GenApplicationClass, MSG_META_RESOLVE_VARIANT_SUPERCLASS
{
    GeodeHandle ui = (GeodeHandle) pself->GAI_specificUI;
    SpecBuildRoutine *r;

    if (!ui)
	ui = UserGetSpecificUI();
    r = (SpecBuildRoutine *) ProcGetLibraryEntry(ui, SPIR_BUILD_APPLICATION);
    return r ? r(oself, MasterOffset) : NULL;
}

/* GenApplicationFindMoniker: of the application's moniker list the
 * one fitting the search and the display type best (its list is never
 * replaced) */
@method GenApplicationClass, MSG_GEN_APPLICATION_FIND_MONIKER
{
    ChunkHandle m = pself->GI_visMoniker;

    if (searchFlags & VMSF_REPLACE_LIST)
	FatalError(UI_CANNOT_REPLACE_APPLICATION_MONIKER_LIST);
    return VisFindMoniker(ConstructOptr(OptrToHandle(oself), m),
			  searchFlags, destBlock, displayType);
}

@method GenApplicationClass, MSG_GEN_APPLICATION_GET_STATE
{
    return pself->GAI_states;
}

#define AppPart(o)	((GenApplicationInstance *) ObjDerefGen(o))

static optr ProcessOptr(void)
{
    return ConstructOptr(GeodeGetProcessHandle(), 0);
}

/* SendToGenAppGCNList: the message (goc -cg parameters) to each object
 * on one of the application's GCN lists */
static void SendToGCNList(optr oself, word listType, Message msg,
			  const void *params, word size)
{
    struct {
	GCNListSendFlags f; EventHandle e; MemHandle b; word t;
	ManufacturerID m;
    } p;
    EventHandle ev;

    CObjMessageP(MF_RECORD, 0, msg, (void *) params, size, &ev, sizeof(ev));
    p.f = 0;
    p.e = ev;
    p.b = 0;
    p.t = listType;
    p.m = MANUFACTURER_ID_GEOWORKS;
    CObjMessageP(MF_CALL, oself, MSG_META_GCN_LIST_SEND, &p, sizeof(p),
		 NULL, 0);
}

/* SendToGenAppGCNListUppingDetachCount: MSG_META_DETACH or
 * MSG_META_APP_SHUTDOWN to each object on the list, one more ack each */
static void SendToGCNListUppingDetachCount(optr oself, word listType,
					   Message msg)
{
    TempMetaGCNData *g = ObjVarFindData(oself, TEMP_META_GCN);
    MemHandle mh = OptrToHandle(oself);
    ChunkHandle list;
    word i, n;

    if (!g)
	return;
    list = GCNListFindListInBlock(MANUFACTURER_ID_GEOWORKS, listType, mh,
				  g->TMGCND_listOfLists, FALSE);
    if (!list)
	return;
    n = ChunkArrayGetCount(ConstructOptr(mh, list));
    for (i = 0; i < n; i++) {
	optr item;
	struct { word id; optr ack; } p;

	memcpy(&item, ChunkArrayElementToPtr(ConstructOptr(mh, list), i,
					     NULL), sizeof(item));
	ObjIncDetach(oself);
	p.id = 0;
	p.ack = oself;
	CObjMessageP(0, item, msg, &p, sizeof(p), NULL, 0);
    }
}

/* ---------------------------------------------------------------------
 * State
 * ------------------------------------------------------------------- */

/* GenAppSetState (the transparent detach lists: not yet) */
@method GenApplicationClass, MSG_GEN_APPLICATION_SET_STATE
{
    pself->GAI_states = (pself->GAI_states | set) & ~clear;
    if (GenCheckIfSpecGrown(oself))
	@callsuper();
}

@method GenApplicationClass, MSG_GEN_APPLICATION_SET_ATTACHED_TO_STATE_FILE
{
    pself->GAI_states |= AS_ATTACHED_TO_STATE_FILE;
}

@method GenApplicationClass,
	MSG_GEN_APPLICATION_SET_NOT_ATTACHED_TO_STATE_FILE
{
    pself->GAI_states &= ~AS_ATTACHED_TO_STATE_FILE;
}

/* GenAppSetNotQuitting: interactable again, input flows again */
@method GenApplicationClass, MSG_GEN_APPLICATION_SET_NOT_QUITTING
{
    if (!(pself->GAI_states & AS_QUITTING))
	return;
    pself->GAI_states &= ~AS_QUITTING;
    @call oself::MSG_GEN_APPLICATION_IACP_REGISTER(
	IACPSM_USER_INTERACTIBLE);
    @call oself::MSG_GEN_APPLICATION_ACCEPT_INPUT();
}

@method GenApplicationClass, MSG_GEN_APPLICATION_SET_APP_MODE_MESSAGE
{
    pself->GAI_appMode = modeMessage;
}

@method GenApplicationClass, MSG_GEN_APPLICATION_GET_APP_MODE_MESSAGE
{
    return pself->GAI_appMode;
}

@method GenApplicationClass, MSG_GEN_APPLICATION_GET_ATTACH_FLAGS
{
    return pself->GAI_attachFlags;
}

@method GenApplicationClass, MSG_GEN_APPLICATION_GET_LAUNCH_FLAGS
{
    return pself->GAI_launchFlags;
}

/* ---------------------------------------------------------------------
 * IACP: the application object is the server of the application's
 * token (genAppCommonIACP.asm)
 * ------------------------------------------------------------------- */

/* IACP/iacpMain.goc */
extern MemHandle IACPDuplicateALB(MemHandle alb);

/* GAI_iacpConnects: the connections the application serves, and the
 * mode each asked for */
typedef struct {
    IACPConnection	GAIACPC_connection;
    word		GAIACPC_appMode;  /* MSG_GEN_PROCESS_OPEN_APPLICATION
					   * or ..._OPEN_ENGINE */
} GenAppIACPConnection;

static optr Connects(optr oself)
{
    ChunkHandle ch = AppPart(oself)->GAI_iacpConnects;

    return ch ? ConstructOptr(OptrToHandle(oself), ch) : NullOptr;
}

/*
 * GenAppRegisterUnregisterCommon: for the token of the application and
 * for those of ATTR_GEN_APPLICATION_ADDITIONAL_TOKENS
 */
static void RegisterUnregister(optr oself, IACPServerMode mode,
			       Boolean unregister)
{
    IACPServerFlags flags = 0;
    GeodeToken token, *more;
    word n, i;

    if (!unregister) {
	if (!(AppPart(oself)->GAI_states & AS_SINGLE_INSTANCE))
	    flags |= IACPSF_MULTIPLE_INSTANCES;
	if (ObjVarFindData(oself,
		HINT_APPLICATION_NO_INBOX_QUERY_WHEN_FOREGROUND_APP))
	    flags |= IACPSF_MAILBOX_DONT_NOTIFY_USER;
    }
    GeodeGetInfo(MemOwner(OptrToHandle(oself)), GGIT_TOKEN_ID, &token);
    more = ObjVarFindData(oself, ATTR_GEN_APPLICATION_ADDITIONAL_TOKENS);
    n = more ? VarDataSizePtr(more) / sizeof(GeodeToken) : 0;
    for (i = 0; ; i++) {
	if (unregister)
	    IACPUnregisterServer(&token, oself);
	else
	    IACPRegisterServer(&token, oself, mode, flags);
	if (i == n)
	    break;
	more = ObjVarFindData(oself, ATTR_GEN_APPLICATION_ADDITIONAL_TOKENS);
	token = more[i];
    }
}

/* GenAppRegisterAsIACPServer */
@method GenApplicationClass, MSG_GEN_APPLICATION_IACP_REGISTER
{
    (void) pself;
    RegisterUnregister(oself, (IACPServerMode) mode, FALSE);
}

@method GenApplicationClass, MSG_GEN_APPLICATION_IACP_UNREGISTER
{
    (void) pself;
    RegisterUnregister(oself, 0, TRUE);
}

/* GenAppCompleteConnections: in application mode now: what the clients
 * sent meanwhile goes on */
@method GenApplicationClass, MSG_GEN_APPLICATION_IACP_COMPLETE_CONNECTIONS
{
    optr arr = Connects(oself);
    word n = arr ? ChunkArrayGetCount(arr) : 0, i, size;

    (void) pself;
    for (i = 0; i < n; i++) {
	GenAppIACPConnection *c = ChunkArrayElementToPtr(arr, i, &size);

	IACPFinishConnect(c->GAIACPC_connection, oself);
    }
}

@method GenApplicationClass, MSG_GEN_APPLICATION_IACP_SHUTDOWN_ALL_CONNECTIONS
{
    (void) pself;
    IACPShutdownAll(oself);
}

@method GenApplicationClass,
	MSG_GEN_APPLICATION_IACP_GET_NUMBER_OF_CONNECTIONS
{
    optr arr = Connects(oself);

    (void) pself;
    return arr ? ChunkArrayGetCount(arr) : 0;
}

/* (those that keep an application opened for IACP only in application
 * mode) */
@method GenApplicationClass,
	MSG_GEN_APPLICATION_IACP_GET_NUMBER_OF_APP_MODE_CONNECTIONS
{
    optr arr = Connects(oself);
    word n = arr ? ChunkArrayGetCount(arr) : 0, i, size, count = 0;

    (void) pself;
    for (i = 0; i < n; i++) {
	GenAppIACPConnection *c = ChunkArrayElementToPtr(arr, i, &size);

	if (c->GAIACPC_appMode == MSG_GEN_PROCESS_OPEN_APPLICATION)
	    count++;
    }
    return count;
}

/* GenAppRecordConnection: so the application does not go while the
 * connection is there */
static void RecordConnection(optr oself, IACPConnection connection,
			     word appMode)
{
    GenAppIACPConnection *c;

    if (!AppPart(oself)->GAI_iacpConnects) {
	ChunkHandle ch = ChunkArrayCreate(OptrToHandle(oself),
					  sizeof(GenAppIACPConnection), 0,
					  OCF_IGNORE_DIRTY);

	AppPart(oself)->GAI_iacpConnects = ch;
    }
    c = ChunkArrayAppend(Connects(oself), 0);
    c->GAIACPC_connection = connection;
    c->GAIACPC_appMode = appMode;
}

/* GenAppInitDocumentCommonParams: the document of a launch block; one
 * below SP_TEMPLATE is opened as a template */
static void InitDocumentCommonParams(DocumentCommonParams *p,
				     const AppLaunchBlock *alb)
{
    memset(p, 0, sizeof(*p));
    memcpy(p->DCP_name, alb->ALB_dataFile, sizeof(p->DCP_name));
    p->DCP_diskHandle = alb->ALB_diskHandle;
    memcpy(p->DCP_path, alb->ALB_path, sizeof(p->DCP_path));
    if (alb->ALB_launchFlags & ALF_OPEN_FOR_IACP_ONLY)
	p->DCP_flags |= DOF_OPEN_FOR_IACP_ONLY;
    if (FileComparePaths("", SP_TEMPLATE, alb->ALB_path,
			 alb->ALB_diskHandle) <= PCT_SUBDIR)
	p->DCP_flags |= DOF_FORCE_TEMPLATE_BEHAVIOR;
}

/*
 * GenAppNotifyModelIfDoc: the document group opens the document of the
 * launch block; without one, the document control its default document
 * if asked for.
 */
static void NotifyModelIfDoc(optr oself, const AppLaunchBlock *alb,
			     Boolean openDefault)
{
    DocumentCommonParams p;
    EventHandle ev;

    if (alb->ALB_dataFile[0]) {
	InitDocumentCommonParams(&p, alb);
	CObjMessageP(MF_RECORD, (optr) (uintptr_t) &GenDocumentGroupClass,
		     MSG_GEN_DOCUMENT_GROUP_OPEN_DOC, &p, sizeof(p), &ev,
		     sizeof(ev));
    } else if (openDefault) {
	CObjMessageP(MF_RECORD, (optr) (uintptr_t) &GenDocumentControlClass,
		     MSG_GEN_DOCUMENT_CONTROL_OPEN_DEFAULT_DOC, NULL, 0, &ev,
		     sizeof(ev));
    } else {
	return;
    }
    @call oself::MSG_META_SEND_CLASSED_EVENT(ev,
					     (TravelOption) TO_MODEL);
}

/*
 * GenAppSwitchToAppMode: the application is to be open for the user.
 * Usable already: it comes to the top (FALSE).  Else the process takes
 * it from engine to application mode with a copy of the launch block
 * (TRUE: on the way; the document of the block is seen to then).
 */
static Boolean SwitchToAppMode(optr oself, MemHandle albHandle)
{
    GenApplicationInstance *pself = AppPart(oself);
    AppLaunchBlock *alb = MemLock(albHandle);
    AppLaunchFlags launchFlags = alb->ALB_launchFlags;
    Boolean dataFile = alb->ALB_dataFile[0] != 0;
    MemHandle copy;

    MemUnlock(albHandle);
    if (!(launchFlags & ALF_OPEN_FOR_IACP_ONLY)) {
	/* open for the user's general use from now on; a quit that has
	 * not detached yet can be given up */
	pself->GAI_launchFlags &= ~ALF_OPEN_FOR_IACP_ONLY;
	if (pself->GAI_states & AS_QUITTING)
	    (void) ObjVarAddData(oself, TEMP_GEN_APPLICATION_ABORT_QUIT, 0);
    }
    pself = AppPart(oself);
    if (pself->GI_states & GS_USABLE) {
	if (!(launchFlags & (ALF_DO_NOT_OPEN_ON_TOP | ALF_OPEN_IN_BACK))) {
	    @call oself::MSG_META_NOTIFY_TASK_SELECTED();
	    @call oself::MSG_GEN_BRING_TO_TOP();
	}
	return FALSE;
    }
    if (pself->GAI_states & AS_ATTACHING)
	return TRUE;
    /* (early, so a connection shut down before MSG_META_ATTACH comes
     * does not make the application exit) */
    pself->GAI_states |= AS_ATTACHING;
    copy = IACPDuplicateALB(albHandle);
    MemInitRefCount(copy, 1);
    @send, forceQueue ProcessOptr()::
	MSG_GEN_PROCESS_TRANSITION_FROM_ENGINE_TO_APPLICATION_MODE(
	    dataFile ? AAF_DATA_FILE_PASSED : 0, copy);
    /* the copy goes when the application is open */
    @send, forceQueue ProcessOptr()::MSG_META_DEC_BLOCK_REF_COUNT(copy, 0);
    return TRUE;
}

/*
 * GAINCRecordALBIfAppropriate: asked to open for the user while
 * detaching: a copy of the launch block is kept until the detach is
 * through (MSG_GEN_APPLICATION_APP_MODE_COMPLETE,
 * MSG_GEN_APPLICATION_QUIT_AFTER_UI), and the field shows that the
 * application is being activated.
 */
static void RecordALBIfAppropriate(optr oself, MemHandle albHandle)
{
    MemHandle copy, *saved;
    optr parent;

    if (ObjVarFindData(oself, TEMP_GEN_APPLICATION_SAVED_ALB))
	return;			/* the user is impatient */
    copy = IACPDuplicateALB(albHandle);
    saved = ObjVarAddData(oself, TEMP_GEN_APPLICATION_SAVED_ALB,
			  sizeof(MemHandle));
    *saved = copy;
    parent = GenFindParent(oself);
    if (OptrToHandle(parent)) {
	@call parent::MSG_GEN_FIELD_ACTIVATE_INITIATE(copy);
	@call parent::MSG_GEN_FIELD_ACTIVATE_UPDATE(
	    MemOwner(OptrToHandle(oself)), copy);
    }
}

/*
 * GenApplicationIACPNewConnection: a client has connected.  With a
 * launch block for application mode the application opens for the
 * user (unless it was launched for this, which the attach sees to) and
 * opens the document of the block; else the connection is for engine
 * mode.  The launch block is IACP's.
 */
@method GenApplicationClass, MSG_META_IACP_NEW_CONNECTION
{
    AppLaunchBlock *alb = appLaunchBlock ? MemLock(appLaunchBlock) : NULL;

    if (alb && (!alb->ALB_appMode ||
		alb->ALB_appMode == MSG_GEN_PROCESS_OPEN_APPLICATION)) {
	RecordConnection(oself, connection,
			 MSG_GEN_PROCESS_OPEN_APPLICATION);
	pself = AppPart(oself);
	if (justLaunched) {
	    /* what the block says was done at the launch */
	} else if (pself->GAI_states & (AS_DETACHING | AS_QUIT_DETACHING)) {
	    RecordALBIfAppropriate(oself, appLaunchBlock);
	} else if (!SwitchToAppMode(oself, appLaunchBlock)) {
	    /* in application mode: the document, and what the client
	     * sent meanwhile (while attaching: at
	     * MSG_GEN_APPLICATION_OPEN_COMPLETE) */
	    NotifyModelIfDoc(oself, MemDeref(appLaunchBlock), FALSE);
	    if (!(AppPart(oself)->GAI_states & AS_ATTACHING))
		IACPFinishConnect(connection, oself);
	}
    } else {
	RecordConnection(oself, connection, MSG_GEN_PROCESS_OPEN_ENGINE);
	IACPFinishConnect(connection, oself);
    }
    if (alb)
	MemUnlock(appLaunchBlock);
    /* Port32: not yet: GenAppUpdateTransparentDetachLists */
}

/*
 * GenApplicationIACPLostConnection: the client has gone: the documents
 * are told (through the document group, down the model hierarchy), and
 * the application leaves the connection once its queues are through.
 */
@method GenApplicationClass, MSG_META_IACP_LOST_CONNECTION
{
    struct { IACPConnection connection; word serverNum; } p;
    EventHandle lost, kids;

    (void) pself;
    if (serverNum)
	return;			/* another server went */
    p.connection = connection;
    p.serverNum = serverNum;
    CObjMessageP(MF_RECORD, (optr) (uintptr_t) &MetaClass,
		 MSG_META_IACP_LOST_CONNECTION, &p, sizeof(p), &lost,
		 sizeof(lost));
    CObjMessageP(MF_RECORD, (optr) (uintptr_t) &GenDocumentGroupClass,
		 MSG_GEN_SEND_TO_CHILDREN, &lost, sizeof(lost), &kids,
		 sizeof(kids));
    @call oself::MSG_META_SEND_CLASSED_EVENT(kids,
					     (TravelOption) TO_MODEL);
    IACPLostConnection(oself, connection);
}

/*
 * GenApplicationIACPShutdownConnection: out of the connection, and the
 * connection out of the application's; that may have been what kept it
 * (MSG_GEN_APPLICATION_APP_MODE_COMPLETE, with the ack that waits).
 */
@method GenApplicationClass, MSG_META_IACP_SHUTDOWN_CONNECTION
{
    optr arr, *ack;
    word n, i, size;

    (void) pself;
    IACPShutdownConnection(oself, connection);
    /* (no array: NO_MORE_CONNECTIONS has been through, the application
     * is going already) */
    arr = Connects(oself);
    if (!arr)
	return;
    n = ChunkArrayGetCount(arr);
    for (i = 0; i < n; i++) {
	GenAppIACPConnection *c = ChunkArrayElementToPtr(arr, i, &size);

	if (c->GAIACPC_connection == connection) {
	    ChunkArrayDelete(arr, c);
	    break;
	}
    }
    ack = ObjVarFindData(oself, TEMP_GEN_APPLICATION_APP_MODE_COMPLETE_ACK_OD);
    @call oself::MSG_GEN_APPLICATION_APP_MODE_COMPLETE(ack ? *ack : NullOptr);
}

/*
 * GenAppMetaIACPProcessMessage: a message over a connection.  The
 * completion message of MSG_META_IACP_ALLOW_FILE_ACCESS waits until
 * the document has closed its file
 * (MSG_GEN_APPLICATION_CLOSE_FILE_ACK).
 */
@method GenApplicationClass, MSG_META_IACP_PROCESS_MESSAGE
{
    optr dest;

    (void) pself;
    if (completionMsg && ObjGetMessageInfo(msgToSend, &dest) ==
			     MSG_META_IACP_ALLOW_FILE_ACCESS) {
	EventHandle *ev = ObjVarAddData(oself,
				TEMP_GEN_APPLICATION_CLOSE_FILE_ACK_EVENT,
				sizeof(EventHandle));

	*ev = completionMsg;
	completionMsg = 0;
    }
    IACPProcessMessage(oself, msgToSend, topt, completionMsg);
}

@method GenApplicationClass, MSG_GEN_APPLICATION_CLOSE_FILE_ACK
{
    EventHandle *ev = ObjVarFindData(oself,
				     TEMP_GEN_APPLICATION_CLOSE_FILE_ACK_EVENT);
    EventHandle done;

    (void) pself;
    if (!ev)
	return;
    done = *ev;
    ObjVarDeleteData(oself, TEMP_GEN_APPLICATION_CLOSE_FILE_ACK_EVENT);
    CMessageDispatchP(done, MF_FORCE_QUEUE, NULL, 0);
}

/*
 * GenAppIACPCloseReopenFile: someone needs the file of the document:
 * it closes it, and opens it again afterwards; an application with
 * HINT_APPLICATION_QUIT_ON_IACP_ALLOW_FILE_ACCESS detaches instead.
 */
@method GenApplicationClass, MSG_META_IACP_ALLOW_FILE_ACCESS,
			     MSG_META_IACP_NOTIFY_FILE_ACCESS_FINISHED
{
    EventHandle ev;

    (void) pself;
    if (ObjVarFindData(oself,
		       HINT_APPLICATION_QUIT_ON_IACP_ALLOW_FILE_ACCESS)) {
	if (message == MSG_META_IACP_ALLOW_FILE_ACCESS)
	    @call oself::MSG_META_TRANSPARENT_DETACH();
	return;
    }
    if (message == MSG_META_IACP_ALLOW_FILE_ACCESS)
	CObjMessageP(MF_RECORD, (optr) (uintptr_t) &GenDocumentClass,
		     MSG_GEN_DOCUMENT_CLOSE_FILE, &connection,
		     sizeof(connection), &ev, sizeof(ev));
    else
	CObjMessageP(MF_RECORD, (optr) (uintptr_t) &GenDocumentClass,
		     MSG_GEN_DOCUMENT_REOPEN_FILE, NULL, 0, &ev, sizeof(ev));
    @call oself::MSG_META_SEND_CLASSED_EVENT(ev,
					     (TravelOption) TO_MODEL);
}

/* ---------------------------------------------------------------------
 * Attach
 * ------------------------------------------------------------------- */

/*
 * GenAppAppStartup: the application's reference and launch flags from the
 * AppLaunchBlock, a one-way link to its field, the specific UI told, the
 * field told, the MGCNLT_APP_STARTUP list told.  AS_QUITTING until it
 * attaches, so nothing is saved if it never does.
 */
@method GenApplicationClass, MSG_META_APP_STARTUP
{
    AppLaunchBlock *a;
    optr parent;
    Message mode;
    GeodeHandle gh = GeodeGetProcessHandle();

    pself->GAI_states |= AS_QUITTING;
    if (!(GeodeGetInfo(gh, GGIT_ATTRIBUTES, NULL) & GA_MULTI_LAUNCHABLE))
	pself->GAI_states |= AS_SINGLE_INSTANCE;
    a = MemLock(appLaunchBlock);
    memcpy(&pself->GAI_appRef, &a->ALB_appRef, sizeof(AppInstanceReference));
    pself->GAI_launchFlags = a->ALB_launchFlags;
    mode = a->ALB_appMode;
    parent = a->ALB_genParent;
    MemUnlock(appLaunchBlock);
    if (mode != MSG_GEN_PROCESS_OPEN_ENGINE)
	pself->GAI_states |= AS_ATTACHING;
    if (!OptrToHandle(parent)) {
	UserCallSystem(MSG_GEN_SYSTEM_GET_DEFAULT_FIELD, NULL, 0, &parent,
		       sizeof(parent));
	if (!OptrToHandle(parent))
	    FatalError(UI_GEN_APPLICATION_COULDNT_FIND_A_VIS_PARENT);
    }
    GenSetUpwardLink(OptrToHandle(oself), OptrToChunk(oself), parent);

    @callsuper();

    if (@call parent::MSG_META_IS_OBJECT_IN_CLASS(
	    (ClassStruct *) &GenFieldClass))
	@call parent::MSG_GEN_FIELD_ADD_GEN_APPLICATION(oself, CCO_LAST);
    SendToGCNList(oself, MGCNLT_APP_STARTUP, MSG_META_APP_STARTUP,
		  &appLaunchBlock, sizeof(appLaunchBlock));
    @call oself::MSG_GEN_APPLICATION_IACP_REGISTER(
	IACPSM_NOT_USER_INTERACTIBLE);
}

/*
 * GenAppAttach: from MSG_GEN_PROCESS_OPEN_APPLICATION.  The application
 * is usable from here; the specific UI attaches it, the options load
 * (not when restoring from state), the active list attaches, the windows
 * update, and it comes to the top.  The system is busy meanwhile; the
 * application is (completely) busy until the queue is through.
 */
@method GenApplicationClass, MSG_META_ATTACH_OBJECT
{
    optr model = NullOptr;
    UpdateWindowFlags uwf;
    EventHandle ev;
    optr *save;

    pself->GAI_attachFlags = flags;
    UserCallSystem(MSG_GEN_SYSTEM_MARK_BUSY, NULL, 0, NULL, 0);

    /* whatever was built before does not count; the model exclusive the
     * document control took at startup stays */
    if (!@call oself::MSG_META_GET_MODEL_EXCL(&model))
	model = NullOptr;
    if (OptrToHandle(model))
	@call model::MSG_META_RELEASE_MODEL_EXCL();
    GenSpecShrinkBranch(oself);
    if (OptrToHandle(model))
	@call model::MSG_META_GRAB_MODEL_EXCL();

    pself = AppPart(oself);
    pself->GI_states |= GS_USABLE;
    pself->GAI_states |= AS_ATTACHING;
    pself->GAI_states &= ~(AS_QUITTING | AS_TRANSPARENT_DETACHING);
    pself->GAI_attachFlags = flags;
    if (UserGetLaunchModel() == UILM_TRANSPARENT) {
	pself->GAI_states |= AS_TRANSPARENT;
	if (!(UserGetLaunchOptions() & UILO_CLOSABLE_APPS) &&
	    (save = ObjVarFindData(oself,
				   ATTR_GEN_APPLICATION_SAVE_OPTIONS_TRIGGER))
	    != NULL) {
	    optr t = *save;
	    GenInstance *g = GenLock(t);
	    g->GI_states &= ~GS_USABLE;
	    GenUnlock(t);
	}
    }
    /* the Save Options trigger not enabled until options change */
    if (!(flags & AAF_RESTORING_FROM_STATE) &&
	(save = ObjVarFindData(oself,
			       ATTR_GEN_APPLICATION_SAVE_OPTIONS_TRIGGER))
	!= NULL) {
	optr t = *save;
	GenInstance *g = GenLock(t);
	g->GI_states &= ~GS_ENABLED;
	ObjMarkDirty(t);
	GenUnlock(t);
    }

    @callsuper();

    if (!(flags & AAF_RESTORING_FROM_STATE))
	@call oself::MSG_META_LOAD_OPTIONS();
    {
	struct { word f; MemHandle alb, extra; } p;

	p.f = flags;
	p.alb = appLaunchBlock;
	p.extra = extraState;
	SendToGCNList(oself, MGCNLT_ACTIVE_LIST, MSG_META_ATTACH_OBJECT, &p,
		      sizeof(p));
    }
    @call oself::MSG_GEN_APPLICATION_MARK_APP_COMPLETELY_BUSY();

    uwf = UWF_ATTACHING | UWF_FROM_WINDOWS_LIST;
    if (flags & AAF_RESTORING_FROM_STATE)
	uwf |= UWF_RESTORING_FROM_STATE;
    {
	struct { UpdateWindowFlags f; VisUpdateMode m; } p;

	p.f = uwf;
	p.m = VUM_NOW;
	SendToGCNList(oself, GAGCNLT_WINDOWS, MSG_META_UPDATE_WINDOW, &p,
		      sizeof(p));
    }
    if (!(AppPart(oself)->GAI_launchFlags & ALF_DO_NOT_OPEN_ON_TOP))
	@call oself::MSG_GEN_BRING_TO_TOP();
    @call oself::MSG_GEN_APPLICATION_IACP_REGISTER(
	IACPSM_USER_INTERACTIBLE);
    @send, forceQueue oself::MSG_GEN_APPLICATION_OPEN_COMPLETE();
    UserCallSystem(MSG_GEN_SYSTEM_MARK_NOT_BUSY, NULL, 0, NULL, 0);

    ev = @record oself::MSG_GEN_APPLICATION_MARK_APP_NOT_COMPLETELY_BUSY();
    @call oself::MSG_META_OBJ_FLUSH_INPUT_QUEUE(ev,
		OFIQNS_INPUT_OBJ_OF_OWNING_GEODE, OptrToHandle(oself));
}

/* GenAppOpenComplete: up on the screen */
@method GenApplicationClass, MSG_GEN_APPLICATION_OPEN_COMPLETE
{
    pself->GAI_launchFlags &= ~(ALF_OPEN_IN_BACK | ALF_DO_NOT_OPEN_ON_TOP);
    pself->GAI_states &= ~AS_ATTACHING;
    @send, forceQueue oself::MSG_GEN_APPLICATION_IACP_COMPLETE_CONNECTIONS();
    @callsuper();
}

/* ---------------------------------------------------------------------
 * Detach
 * ------------------------------------------------------------------- */

/*
 * GenAppDetach: from the process (procClass.goc), which takes care of a
 * detach while one is in progress.  The specific UI is told (it brings
 * down modal dialogs), the windows update, the active list detaches,
 * and the queue is flushed (an ack to ourselves) before the
 * detach completes.
 */
@method GenApplicationClass, MSG_META_DETACH
{
    if ((pself->GAI_states & AS_DETACHING) || !(pself->GI_states & GS_USABLE)) {
	/* not in application mode: detached already */
	@send, forceQueue caller::MSG_META_ACK(callerID, oself);
	return;
    }
    pself->GAI_states |= AS_DETACHING;
    @call oself::MSG_GEN_APPLICATION_DETACH_PENDING();
    ObjInitDetach(message, oself, callerID, caller);
    {
	struct { UpdateWindowFlags f; VisUpdateMode m; } p;

	p.f = UWF_DETACHING;
	p.m = VUM_NOW;
	SendToGCNList(oself, GAGCNLT_WINDOWS, MSG_META_UPDATE_WINDOW, &p,
		      sizeof(p));
    }
    SendToGCNListUppingDetachCount(oself, MGCNLT_ACTIVE_LIST,
				   MSG_META_DETACH);
    @callsuper();
    ObjIncDetach(oself);
    @send, forceQueue oself::MSG_META_ACK(0, oself);
    ObjEnableDetach(oself);
}

/* GenAppCloseComplete: the process closed; not usable any more; what
 * next (APP_MODE_COMPLETE) */
@method GenApplicationClass, MSG_GEN_APPLICATION_CLOSE_COMPLETE
{
    pself->GI_states &= ~GS_USABLE;
    pself->GAI_states &= ~(AS_DETACHING | AS_QUIT_DETACHING |
			   AS_RECEIVED_APP_OBJECT_DETACH);
    /* Port32: MSG_FLOW_RELEASE_MOUSE_IF_GRABBED to the UI's flow object
     * (uiFlowObj) once the UI's process makes one */
    @callsuper();
    @call oself::MSG_GEN_APPLICATION_APP_MODE_COMPLETE(ackOD);
}

/*
 * GenAppAppModeComplete: out of application mode (or a reason to stay
 * open went): an application open for the user stays; one opened for
 * IACP only quits once the last connection in application mode goes;
 * one not usable goes when it has no connections left.
 */
@method GenApplicationClass, MSG_GEN_APPLICATION_APP_MODE_COMPLETE
{
    MemHandle *saved;

    if ((pself->GI_states & GS_USABLE) || (pself->GAI_states & AS_ATTACHING)) {
	if (!(pself->GAI_launchFlags & ALF_OPEN_FOR_IACP_ONLY))
	    return;
	if (@call oself::MSG_GEN_APPLICATION_IACP_GET_NUMBER_OF_APP_MODE_CONNECTIONS())
	    return;
	GenAppQuitCommon(oself, QL_AFTER_UI);
	return;
    }
    @call oself::MSG_GEN_APPLICATION_IACP_REGISTER(
	IACPSM_NOT_USER_INTERACTIBLE);
    /* asked to open for the user while it detached (GenAppLazarus):
     * back into application mode with the launch block kept then */
    saved = ObjVarFindData(oself, TEMP_GEN_APPLICATION_SAVED_ALB);
    if (saved) {
	MemHandle alb = *saved;

	ObjVarDeleteData(oself, TEMP_GEN_APPLICATION_SAVED_ALB);
	(void) SwitchToAppMode(oself, alb);
	MemFree(alb);
	return;
    }
    if (@call oself::MSG_GEN_APPLICATION_IACP_GET_NUMBER_OF_CONNECTIONS()) {
	optr *ack;

	if (!OptrToHandle(ackOD))
	    return;
	ack = ObjVarAddData(oself,
			    TEMP_GEN_APPLICATION_APP_MODE_COMPLETE_ACK_OD,
			    sizeof(optr));
	*ack = ackOD;
	return;
    }
    @call oself::MSG_GEN_APPLICATION_IACP_UNREGISTER();
    @send, forceQueue oself::MSG_GEN_APPLICATION_IACP_NO_MORE_CONNECTIONS(
	ackOD);
}

/* GenApplicationIACPNoMoreConnections: still nothing to stay for: the
 * process really detaches, after the input queue */
@method GenApplicationClass, MSG_GEN_APPLICATION_IACP_NO_MORE_CONNECTIONS
{
    EventHandle ev;

    (void) ackOD;
    /* usable again, or on the way there, or a connection came in
     * while it quits: a server again, for a while */
    if (pself->GI_states & GS_USABLE) {
	@call oself::MSG_GEN_APPLICATION_IACP_REGISTER(
	    IACPSM_USER_INTERACTIBLE);
	return;
    }
    if ((pself->GAI_states & AS_ATTACHING) ||
	(@call oself::MSG_GEN_APPLICATION_IACP_GET_NUMBER_OF_CONNECTIONS() &&
	 (AppPart(oself)->GAI_states & AS_QUITTING))) {
	@call oself::MSG_GEN_APPLICATION_IACP_REGISTER(
	    IACPSM_NOT_USER_INTERACTIBLE);
	return;
    }
    pself = AppPart(oself);
    if (pself->GAI_iacpConnects) {
	ChunkHandle c = pself->GAI_iacpConnects;

	pself->GAI_iacpConnects = 0;
	LMemFree(ConstructOptr(OptrToHandle(oself), c));
    }
    ev = @record oself::MSG_GEN_APPLICATION_IACP_SHUTDOWN_ALL_CONNECTIONS();
    @call oself::MSG_META_OBJ_FLUSH_INPUT_QUEUE(ev, OFIQNS_SYSTEM_INPUT_OBJ,
						OptrToHandle(oself));
    pself = AppPart(oself);
    if (pself->GAI_states & AS_REAL_DETACHING)
	FatalError(UI_ERROR_SECOND_REAL_DETACH);
    pself->GAI_states |= AS_REAL_DETACHING;
    ev = @record ProcessOptr()::MSG_GEN_PROCESS_REAL_DETACH();
    @call oself::MSG_META_OBJ_FLUSH_INPUT_QUEUE(ev, OFIQNS_SYSTEM_INPUT_OBJ,
						OptrToHandle(oself));
}

/*
 * GenAppAppShutdown: off the field, after the MGCNLT_APP_STARTUP list
 * shut down; GenAppShutdownComplete then lets go of the exclusives,
 * leaves the field and cuts the link.
 */
@method GenApplicationClass, MSG_META_APP_SHUTDOWN
{
    ObjInitDetach(message, oself, callerID, ackOD);
    SendToGCNListUppingDetachCount(oself, MGCNLT_APP_STARTUP,
				   MSG_META_APP_SHUTDOWN);
    @callsuper();
    ObjEnableDetach(oself);
}

@method GenApplicationClass, MSG_META_SHUTDOWN_COMPLETE
{
    optr parent = GenFindParent(oself);

    if (OptrToHandle(parent)) {
	@call parent::MSG_META_MUP_ALTER_FTVMC_EXCL(oself, MAEF_FOCUS |
						    MAEF_TARGET | MAEF_MODEL);
	if (@call parent::MSG_META_IS_OBJECT_IN_CLASS(
		(ClassStruct *) &GenFieldClass))
	    @call parent::MSG_GEN_FIELD_REMOVE_GEN_APPLICATION(oself);
	if (AppPart(oself)->GAI_states & AS_FOCUSABLE)
	    @call parent::MSG_META_ENSURE_ACTIVE_FT();
    }
    pself = AppPart(oself);
    pself->GI_link.LP_next = NullOptr;
    ObjMarkDirty(oself);
    @callsuper();
}

/* ---------------------------------------------------------------------
 * Quit
 * ------------------------------------------------------------------- */

/* GenAppQuitCommon: the quit starts (once): input ignored, the process
 * goes through the quit levels from the one given */
void GenAppQuitCommon(optr oself, word quitLevel)
{
    GenApplicationInstance *pself = AppPart(oself);

    if (pself->GAI_states & (AS_QUITTING | AS_DETACHING | AS_QUIT_DETACHING))
	return;
    pself->GAI_states |= AS_QUITTING;
    @call oself::MSG_GEN_APPLICATION_IACP_REGISTER(
	IACPSM_IN_FLUX);
    @call oself::MSG_GEN_APPLICATION_IGNORE_INPUT();
    ObjVarDeleteData(oself, TEMP_GEN_APPLICATION_ABORT_QUIT);
    @send ProcessOptr()::MSG_META_QUIT_PROCESS(quitLevel, 0);
}

/* GenAppQuit (Port32: without the [ui] askSaveOptions query) */
@method GenApplicationClass, MSG_META_QUIT
{
    GenAppQuitCommon(oself, QL_BEFORE_UI);
}

/* GenAppInitiateQuit: the windows quit, then the active list (MetaClass's
 * quit sequence, which ends with MSG_META_FINISH_QUIT) */
@method GenApplicationClass, MSG_GEN_APPLICATION_INITIATE_UI_QUIT
{
    if (!(pself->GI_states & GS_USABLE)) {
	@send ProcessOptr()::MSG_META_QUIT_ACK(QL_UI, 0);
	return;
    }
    SendToGCNList(oself, GAGCNLT_WINDOWS, MSG_META_QUIT, NULL, 0);
    CObjCallSuperP((ClassStruct *) &GenApplicationClass, oself,
		   MSG_META_QUIT_ACK, NULL, 0, NULL, 0);
}

/* GenAppFinishQuit: the abort flag to the process */
@method GenApplicationClass, MSG_META_FINISH_QUIT
{
    @send ProcessOptr()::MSG_META_QUIT_ACK(QL_UI, abortFlag);
    @callsuper();
}

/* GenAppQuitAfterUI: the last chance to abort; else detach for the quit */
@method GenApplicationClass, MSG_GEN_APPLICATION_QUIT_AFTER_UI
{
    word abort = 0;
    MemHandle *saved;
    Boolean stay = ObjVarFindData(oself, TEMP_GEN_APPLICATION_ABORT_QUIT) != 0;

    if (!stay &&
	(saved = ObjVarFindData(oself, TEMP_GEN_APPLICATION_SAVED_ALB)) != 0) {
	/* asked to open for the user while it quit: the document of
	 * that launch block (or the default one), and what the clients
	 * sent meanwhile */
	MemHandle alb = *saved;

	ObjVarDeleteData(oself, TEMP_GEN_APPLICATION_SAVED_ALB);
	NotifyModelIfDoc(oself, MemLock(alb), TRUE);
	MemFree(alb);
	@call oself::MSG_GEN_APPLICATION_IACP_COMPLETE_CONNECTIONS();
	stay = TRUE;
    }
    if (stay ||
	@call oself::MSG_GEN_APPLICATION_IACP_GET_NUMBER_OF_APP_MODE_CONNECTIONS()) {
	@call oself::MSG_GEN_APPLICATION_IACP_REGISTER(
	    IACPSM_USER_INTERACTIBLE);
	abort = (word) -1;
    } else {
	pself = AppPart(oself);
	pself->GAI_launchFlags |= ALF_OPEN_FOR_IACP_ONLY;
	pself->GAI_states |= AS_QUIT_DETACHING;
    }
    @send, forceQueue ProcessOptr()::MSG_META_QUIT_ACK(QL_AFTER_UI, abort);
}

/*
 * GenApplicationBuildDialogFromTemplate: a copy of the template's
 * block (owned by the caller's geode, run by its thread), the dialog
 * the application's last child and usable
 */
@method GenApplicationClass, MSG_GEN_APPLICATION_BUILD_DIALOG_FROM_TEMPLATE
{
    optr dialog = ConstructOptr(ObjDuplicateResource(OptrToHandle(template),
						     0, 0),
				OptrToChunk(template));

    (void) pself;
    @call oself::MSG_GEN_ADD_CHILD(dialog, CCO_LAST);
    @call dialog::MSG_GEN_SET_USABLE(VUM_MANUAL);
    memset(retValue, 0, sizeof(*retValue));
    retValue->ND_dialog = dialog;
}
