/*
 * uiInt.goh -- internal definitions of the UI library in Port32.
 *
 * The asm routines of Library/User take an object in *ds:si and
 * registers; their C forms here take the optr and arguments.  The
 * object's block must be run by the current thread (as in the asm:
 * the routines are called from methods); a routine that goes to
 * another block of the thread locks it.  Pointers into object blocks
 * (VisInstance *) are good until the next message or LMem change, as
 * in the asm after an ObjCallInstanceNoLock.
 *
 * The public C forms are in visC.goh (GEOS_PORT32); Port32/ABI.md
 * section 13x describes the library.
 */
#ifndef __UIINT_GOH
#define __UIINT_GOH

@include <stdapp.goh>
@include <Objects/visC.goh>
@include <Objects/vCompC.goh>

#include <Internal/grWinInt.h>

/* winC.goh's MSG_META_EXPOSED_FOR_PRINT has it; no C header defines it */
typedef GStateHandle GStringHandle;

/* winIndividual.c: not in the C API of win.h (screen coordinates) */
void WinInvalTree(Handle win, const Region *reg, word axParam,
		  word bxParam, word cxParam, word dxParam);

/* visC.def: not in visC.goh */
#define VA_INITIAL_BITS		(VA_MANAGED | VA_DRAWABLE | VA_DETECTABLE | \
				 VA_FULLY_ENABLED)
#define VOF_PATH_BITS		(VOF_GEO_UPDATE_PATH | VOF_WINDOW_UPDATE_PATH | \
				 VOF_IMAGE_UPDATE_PATH)
#define VOF_INVALID_BITS	(VOF_GEOMETRY_INVALID | VOF_WINDOW_INVALID | \
				 VOF_IMAGE_INVALID)
#define VOF_INITIAL_BITS	(VOF_INVALID_BITS | VOF_PATH_BITS)
#define VOF_UPDATING		VOF_EC_UPDATING
#define SA_INITIAL_BITS		SA_ATTACHED
#define VARF_UPDATE_WILL_HAPPEN	0x20

/* the parts of an object */
#define VisPart(o)	((VisInstance *) ObjDerefVis(o))
#define VisCompPart(o)	((VisCompInstance *) ObjDerefVis(o))

/* ---------------------------------------------------------------------
 * Vis/visUtilsResident.goc
 * ------------------------------------------------------------------- */
/* the Vis part, its block locked (VisUnlock: unlocked) */
VisInstance *VisLock(optr obj);
void VisUnlock(optr obj);

/* the children: callback until it returns TRUE (then TRUE) */
typedef Boolean VisChildCallback(optr parent, optr child, void *data);
Boolean VisCallChildren(optr obj, VisChildCallback *cb, void *data);
word VisCountChildren(optr obj);
optr VisFirstChild(optr obj);

Boolean VisVupUpdateWinGroup(optr obj, VisUpdateMode mode);

/* the parameters of the mouse messages (MSG_UI_BUTTON, MSG_META_PTR)
 * as goc -cg passes them: the return structure by pointer */
typedef struct {
    MouseReturnParams	*VMP_ret;
    sword		VMP_x;
    sword		VMP_y;
    word		VMP_inputState;
} VisMouseParams;

/* input grabs (VisAlterInputFlowCommon) */
void VisAlterInputFlow(optr obj, byte flags, byte grabType);

/* ---------------------------------------------------------------------
 * Vis/visClass.goc
 * ------------------------------------------------------------------- */
/* VisEmptyClass (visC.def; not in the C headers): a master class with
 * no instance data, for objects that are not in a visual tree */
@class VisEmptyClass, MetaClass, master;
@endc

/* AddOurBoundsToUpdateRegion */
void VisAddOurBoundsToUpdateRegion(optr obj, VisAddRectFlags flags);
Boolean VisShouldObjBeDrawn(optr obj, DrawFlags flags);
void VisSaveAsInvalChunk(optr obj, ChunkHandle region);

/* ---------------------------------------------------------------------
 * Vis/visComp.goc
 * ------------------------------------------------------------------- */
Boolean VisCompVupUpdateWinGroup(optr obj, VisUpdateMode mode);
/* VisInvalOldBounds: the rectangle (if it is one) added to the update
 * region */
void VisInvalOldBounds(optr oself, VisAddRectFlags flags, sword left,
		       sword top, sword right, sword bottom);
void VisCompUpdateWinGroup(optr obj);

/* ---------------------------------------------------------------------
 * Vis/visUtilsClass.goc (static parts of the geometry)
 * ------------------------------------------------------------------- */
void VisSaveOldBounds(optr obj);

/* ---------------------------------------------------------------------
 * Vis/visContent.goc
 * ------------------------------------------------------------------- */
/* VUM_NOW if the content may be updated (its view's window is there and
 * it is linked to the view), else VUM_MANUAL */
VisUpdateMode VisContentGetVUM(optr obj);

/* ---------------------------------------------------------------------
 * User/userMain.goc: the input map (userConstant.def)
 * ------------------------------------------------------------------- */
/* a button with exactly these modifiers starts this function */
typedef struct {
    byte		BME_button;
    ShiftState		BME_shiftState;
    Message		BME_genericMethod;	/* MSG_META_START_* */
    UIFunctionsActive	BME_preferences;	/* UIFA_PREF_* bits */
} ButtonMapEntry;

typedef struct {
    const ButtonMapEntry *IMH_buttonMapTable;
    word		IMH_buttonMapCount;
    ShiftState		IMH_constrain1;
    ShiftState		IMH_constrain2;
    UIButtonFlags	IMH_flags;
} InputMapHeader;

extern InputMapHeader uiInputMap;
extern UIButtonFlags uiButtonFlags;
extern Boolean uiFloatingKbdEnabled;
/* SetDefaultInputMap: the map for the mouse's buttons, the [input]
 * flags */
void UserSetDefaultInputMap(void);

/* ---------------------------------------------------------------------
 * Gen/: the generic UI
 * ------------------------------------------------------------------- */
@include <Internal/specC.goh>
#include <Internal/specUI.h>

#define GenPart(o)	((GenInstance *) ObjDerefGen(o))
/* the Gen part, its block locked (GenUnlock: unlocked) */
GenInstance *GenLock(optr obj);
void GenUnlock(optr obj);

typedef Boolean GenChildCallback(optr parent, optr child, void *data);
Boolean GenCallChildren(optr obj, GenChildCallback *cb, void *data);
word GenCountChildren(optr obj);
void GenRemoveGenChildLow(optr obj, optr child, CompChildFlags flags);
void GenAddChildUpwardLinkOnly(optr obj, optr child);
/* the application object of the current process (FALSE: none) */
Boolean UserCallApplication(Message msg, const void *params,
			    word paramSize, void *reply, word replySize);

/* the UI's FatalErrors (uiConstant.def), as far as the C UI raises them */
#define UI_ERROR_NO_SPECIFIC_UI	18
#define UI_PROCESS_INVALID_QUIT_LEVEL	1
#define UI_GEN_APPLICATION_COULDNT_FIND_A_VIS_PARENT	27
/* these by their place among the FatalErrors of uiConstant.def */
#define UI_STARTUP_DONE_MSG_RECEIVED_BEFORE_STARTUP_NOTIFY	184
#define UI_CANNOT_REPLACE_APPLICATION_MONIKER_LIST		187
#define UI_GEN_FIELD_GEN_APPLICATION_LIST_CORRUPT		191
#define UI_GEN_DISPLAY_BAD_ATTRS				275
#define UI_ERROR_SECOND_REAL_DETACH				355
#define NOT_A_DISCARDABLE_OBJECT				358
#define INTERACTION_CANNOT_BE_MODAL_AND_SYS_MODAL		365

/* ---------------------------------------------------------------------
 * Gen/genSystem.goc: the UI's state (userVariable.def), the system
 * ------------------------------------------------------------------- */
typedef ByteFlags UIFlags;
#define UIF_DETACHING_SYSTEM	0x80
#define UIF_DETACHING_APP	0x40
#define UIF_HAVE_DISPLAY_TYPE	0x20
#define UIF_INIT		0x10

extern UIFlags uiFlags;
extern byte uiDisplayType;
/* the display type for monikers: standard size at most, not squished */
extern DisplayType UserLimitDisplayTypeToStandard(DisplayType t);
/* the system object (0 until UserCreateSystemObject) */
optr UserGetSystemObject(void);

/* ---------------------------------------------------------------------
 * Proc/procClass.goc: GenProcessClass
 * ------------------------------------------------------------------- */
/* a detach of the process in progress: who to ack at its end (the asm
 * passed it on in registers); in the process's geode private data */
typedef struct {
    word	GPDD_flags;
    word	GPDD_callerID;
    optr	GPDD_ackOD;
} GenProcessDetachData;
#define GPDF_DETACHING		0x0001
#define GEN_PROCESS_PRIV_WORDS	((sizeof(GenProcessDetachData) + 1) / 2)

/* GenAppQuitCommon (genApplication.goc): the quit from that level */
void GenAppQuitCommon(optr app, word quitLevel);

/* the offset of the words (GeodePrivAlloc, in UILibraryEntry) */
extern word genProcessPrivOffset;
/* the current process's */
void GenProcessGetDetach(GenProcessDetachData *d);

/* ---------------------------------------------------------------------
 * Vis/visSpec.goc: the specific part of a generic object
 * ------------------------------------------------------------------- */
void VisSpecBuildSetEnabledState(optr obj, SpecBuildFlags flags);
optr VisGetVisParent(optr obj, SpecBuildFlags *flags);
void VisAddChildRelativeToGen(optr genObj, optr visObj, optr visParent,
			      SpecBuildFlags flags);
Boolean VisSpecCheckForPosHints(optr obj, sword *x, sword *y);
void VisIfFlagSetCallGenChildren(optr obj, Message msg, const void *params,
				 word paramSize, byte flags);
optr VisGetSpecificVisObject(optr obj, SpecBuildFlags flags);
void VisSetNonWinGroupUsable(optr obj, VisUpdateMode mode);
void VisUnbuildChildren(optr obj, SpecBuildFlags flags);
void VisSetNotRealized(optr obj);
GenBranchInfo VisGetGenBranchInfo(optr obj);
/* GAI_states of the current process's application (FALSE: none) */
Boolean QuickGenAppGetState(ApplicationStates *states);
/* the UpdateWindowFlags of the application's state (attaching,
 * detaching) */
UpdateWindowFlags VisAppUpdateWindowFlags(Boolean attaching);
ChunkHandle VisCreateMonikerChunk(optr obj, ChunkHandle chunk,
				  CreateVisMonikerFlags flags, word height,
				  word width, word length,
				  VisMonikerDataType dataType,
				  VisMonikerSourceType sourceType,
				  VisMonikerSource source, Boolean *failed);
/* MSG_META_UPDATE_WINDOW of VisCompClass */
void VisCompUpdateWindow(optr obj, UpdateWindowFlags flags,
			 VisUpdateMode mode);

/* ---------------------------------------------------------------------
 * The UI's process (User/userMain.goc, userScreen.goc, userUtils.goc)
 * ------------------------------------------------------------------- */

/* alb.def: AppLaunchFlags the C header lacks (it has an older name for
 * the IACP bit) */
#ifndef ALF_OPEN_FOR_IACP_ONLY
#define ALF_OPEN_FOR_IACP_ONLY		0x04
#endif
#define ALF_NO_ACTIVATION_DIALOG	0x02

/* no error from GeodeLoad, as the kernel has it (kernelC.h) */
#ifndef GLE_OK
#define GLE_OK	GLE_LAST_GEODE_LOAD_ERROR
#endif

/* the flow object of the UI's process (0 while there is none) */
extern optr uiFlowObj;

GeodeLoadError PrepAppLaunchBlock(MemHandle *albp, AppLaunchFlags alf,
				  Message attachMethod, const char *filename,
				  DiskHandle disk, optr genParent);
GeodeHandle UserLoadExtendedDriver(const char *category, StandardPath sp,
				   word protoMajor, word protoMinor,
				   word testAndSetBX, GeodeLoadError *err);
void UserScreenNoVideoDriverError(void);
void UserMakeScreens(MemHandle block);
void UserMakeScreenFields(void);
void UserScreenExit(void);

/* genItemGroup.goc, shared with GenBooleanGroupClass (the identifier of
 * a GenItem and a GenBoolean in the same place) */
struct _GenScanItemsReturn;
optr GenItemGroupFindItem(optr obj, word identifier);
Boolean GenItemGroupScan(optr obj, struct _GenScanItemsReturn *r,
			 byte flags, word initial, sword amount);
Boolean GenOptGetInteger(const GenOptionsParams *params, Boolean boolean,
			 word *value);
void GenOptWriteInteger(const GenOptionsParams *params, Boolean boolean,
			word value);

#endif
