/* ---------------------------------------------------------------------
 * Construction
 * ------------------------------------------------------------------- */

/* VisInitialize (static) */
@method VisClass, MSG_META_INITIALIZE
{
    pself->VI_attrs = VA_INITIAL_BITS;
    pself->VI_optFlags = VOF_INITIAL_BITS;
    pself->VI_specAttrs = SA_INITIAL_BITS;
    if (ObjIsObjectInClass(oself, &GenClass))
	pself->VI_typeFlags = VTF_IS_GEN;
}

/* VisReloc: read from a state file, nothing is realized */
@method VisClass, _reloc
{
    VisInstance *v = VisPart(oself);

    if (message == MSG_META_RELOCATE &&
	vmRelocType == VMRT_RELOCATE_AFTER_READ) {
	v->VI_attrs &= ~VA_REALIZED;
	if (v->VI_typeFlags & VTF_IS_COMPOSITE)
	    ((VisCompInstance *) v)->VCI_window = 0;
    }
    return @callsuper();
}

/* VisDestroy: out of the tree, the children too, then freed */
@method VisClass, MSG_VIS_DESTROY
{
    VisRemove(oself, updateMode);
    if (VisPart(oself)->VI_typeFlags & VTF_IS_COMPOSITE) {
	struct { VisUpdateMode m; } p;
	p.m = updateMode;
	VisSendToChildren(oself, MSG_VIS_DESTROY, &p, sizeof(p));
    }
    @call oself::MSG_META_OBJ_FREE();
}

@method VisClass, MSG_VIS_REMOVE
{
    VisRemove(oself, updateMode);
}

/* ---------------------------------------------------------------------
 * Opening and closing
 * ------------------------------------------------------------------- */

/* OpenWindowHere: the window of a window or portal (MSG_VIS_OPEN_WIN),
 * the composite's window (its own or the one passed); realized.  Returns
 * the window for the children. */
static WindowHandle OpenWindowHere(optr oself, WindowHandle win)
{
    VisInstance *v = VisPart(oself);

    if (v->VI_typeFlags & (VTF_IS_WINDOW | VTF_IS_PORTAL)) {
	ObjIncInUseCount(OptrToHandle(oself));
	@call oself::MSG_VIS_OPEN_WIN(win);
	v = VisPart(oself);
	if (v->VI_typeFlags & VTF_IS_COMPOSITE) {
	    /* a portal with its children outside its window is as a
	     * composite without one: the window passed is its window
	     * and its children's */
	    if (v->VI_typeFlags & VTF_CHILDREN_OUTSIDE_PORTAL_WIN)
		((VisCompInstance *) v)->VCI_window = win;
	    else
		win = ((VisCompInstance *) v)->VCI_window;
	}
    } else if (v->VI_typeFlags & VTF_IS_COMPOSITE)
	((VisCompInstance *) v)->VCI_window = win;
    v->VI_attrs |= VA_REALIZED;
    return win;
}

/* VisOpen: realize this object and the branch below it.  The top of the
 * branch (window 0) looks for the parent's window; there, a non-window
 * object is part of an open window and only its image is invalid. */
@method VisClass, MSG_VIS_OPEN
{
    VisInstance *v = VisPart(oself);
    struct { WindowHandle w; } p;
    Boolean top = !window;

    if (v->VI_typeFlags & VTF_IS_GEN &&
	GenPart(oself)->GI_attrs & GA_NOTIFY_VISIBILITY) {
	@call oself::MSG_SPEC_VIS_OPEN_NOTIFY();
	v = VisPart(oself);
    }
    ObjIncInteractibleCount(OptrToHandle(oself));
    if (top && !(v->VI_typeFlags & VTF_IS_CONTENT))
	window = VisQueryParentWin(oself);
    v = VisPart(oself);
    if (top && !(v->VI_typeFlags & VTF_IS_WINDOW)) {
	p.w = OpenWindowHere(oself, window);
	v = VisPart(oself);
	v->VI_optFlags &= ~(VOF_WINDOW_INVALID | VOF_WINDOW_UPDATE_PATH);
	VisMarkInvalid(oself, VOF_IMAGE_INVALID, VUM_MANUAL);
    } else {
	p.w = OpenWindowHere(oself, window);
	v = VisPart(oself);
	v->VI_optFlags &= ~(VOF_WINDOW_INVALID | VOF_WINDOW_UPDATE_PATH |
			    VOF_IMAGE_INVALID | VOF_IMAGE_UPDATE_PATH);
    }
    VisIfFlagSetCallVisChildren(oself, MSG_VIS_OPEN, &p, sizeof(p), 0);
}

/* VisClose: the branch closed (the children first, then the window);
 * not realized */
@method VisClass, MSG_VIS_CLOSE
{
    VisInstance *v = VisPart(oself);

    if (v->VI_typeFlags & VTF_IS_GEN &&
	GenPart(oself)->GI_attrs & GA_NOTIFY_VISIBILITY) {
	@call oself::MSG_SPEC_VIS_CLOSE_NOTIFY();
	v = VisPart(oself);
    }
    if (v->VI_attrs & VA_REALIZED) {
	if (v->VI_typeFlags & VTF_IS_COMPOSITE) {
	    if (v->VI_typeFlags & VTF_IS_WINDOW)
		@call oself::MSG_VIS_WIN_ABOUT_TO_BE_CLOSED();
	    VisIfFlagSetCallVisChildren(oself, MSG_VIS_CLOSE, NULL, 0, 0);
	}
	v = VisPart(oself);
	if (v->VI_typeFlags & (VTF_IS_WINDOW | VTF_IS_PORTAL)) {
	    @call oself::MSG_VIS_CLOSE_WIN();
	    ObjDecInUseCount(OptrToHandle(oself));
	    v = VisPart(oself);
	    if (v->VI_typeFlags & VTF_IS_PORTAL &&
		v->VI_typeFlags & VTF_CHILDREN_OUTSIDE_PORTAL_WIN &&
		v->VI_typeFlags & VTF_IS_COMPOSITE)
		((VisCompInstance *) v)->VCI_window = 0;
	} else if (v->VI_typeFlags & VTF_IS_COMPOSITE)
	    ((VisCompInstance *) v)->VCI_window = 0;
	v->VI_attrs &= ~VA_REALIZED;
	ObjDecInteractibleCount(OptrToHandle(oself));
    }
    v = VisPart(oself);
    v->VI_optFlags &= ~(VOF_WINDOW_INVALID | VOF_WINDOW_UPDATE_PATH);
}

/* VisWindowAboutToBeClosed: a window with child windows moves off the
 * screen first, so they are not exposed one by one */
@method VisClass, MSG_VIS_WIN_ABOUT_TO_BE_CLOSED
{
    WindowHandle w = ((VisCompInstance *) pself)->VCI_window;
    Handle child = 0;
    Rectangle b;

    if (!w)
	return;
    WinGetInfo(w, WIT_FIRST_CHILD_WIN, &child);
    if (!child)
	return;
    WinGetWinScreenBounds(w, &b);
    if (b.R_right < 0)
	return;
    WinMove(w, -b.R_right - 1, 0, 0);
}

/* ---------------------------------------------------------------------
 * The update
 * ------------------------------------------------------------------- */

/* ReturnInvalidatedIfChildrenInWindow: the flags for the parent (high
 * byte) and the children (low byte) once this window was invalidated */
static word InvalidatedInWindow(VisInstance *v, word flags)
{
    flags &= ~(VUIF_ALREADY_INVALIDATED | (VUIF_ALREADY_INVALIDATED << 8));
    if (v->VI_typeFlags & VTF_CHILDREN_OUTSIDE_PORTAL_WIN)
	return flags;
    flags |= VUIF_ALREADY_INVALIDATED;
    if (!(v->VI_typeFlags & VTF_IS_PORTAL))
	flags |= VUIF_ALREADY_INVALIDATED << 8;
    return flags;
}

/* UpdateWindowHere: open if not realized, move and resize an invalid
 * window.  Returns the flags for the parent (high byte, the "ch" of the
 * asm) and the children (low byte). */
static word UpdateWindowHere(optr oself, VisUpdateImageFlags f)
{
    VisInstance *v = VisPart(oself);
    word flags = f | (f << 8);

    if (v->VI_typeFlags & VTF_IS_WINDOW)
	flags &= ~(VUIF_ALREADY_INVALIDATED | (VUIF_ALREADY_INVALIDATED << 8));
    if (!(v->VI_attrs & VA_REALIZED)) {
	@call oself::MSG_VIS_OPEN(0);
	flags |= VUIF_JUST_OPENED << 8;
	v = VisPart(oself);
	if (v->VI_typeFlags & VTF_IS_WINDOW)
	    flags = InvalidatedInWindow(v, flags);
    }
    v = VisPart(oself);
    if (v->VI_typeFlags & (VTF_IS_WINDOW | VTF_IS_PORTAL) &&
	!(v->VI_typeFlags & VTF_IS_CONTENT) &&
	v->VI_optFlags & VOF_WINDOW_INVALID) {
	@call oself::MSG_VIS_MOVE_RESIZE_WIN();
	flags = InvalidatedInWindow(VisPart(oself), flags);
    }
    return flags;
}

/* DocInvalRegion: the region (document coordinates) invalidated in the
 * window, moved by the window's translation */
static void DocInvalRegion(WindowHandle win, optr region)
{
    TransMatrix tm;
    sword x, y;
    Region *r;

    WinGetTransform(win, &tm);
    x = (sword) (tm.TM_e31.DWF_int + (tm.TM_e31.DWF_frac >= 0x8000));
    y = (sword) (tm.TM_e32.DWF_int + (tm.TM_e32.DWF_frac >= 0x8000));
    r = LMemDeref(region);
    if (x || y)
	GrMoveReg(r, x, y);
    WinInvalReg(win, r, 0, 0, 0, 0);
}

/* InvalUpdateRegionIfNeeded: the region of TEMP_VIS_INVAL_REGION
 * invalidated in the window, then emptied */
static void InvalUpdateRegionIfNeeded(optr oself)
{
    ChunkHandle *ch = ObjVarFindData(oself, TEMP_VIS_INVAL_REGION);
    optr reg;

    if (!ch)
	return;
    reg = ConstructOptr(OptrToHandle(oself), *ch);
    if (!LMemGetChunkSize(reg))
	return;
    DocInvalRegion(VisCompPart(oself)->VCI_window, reg);
    LMemReAlloc(reg, 0);
}

/* VisUpdateWindowsAndImage: the windows of the branch brought up to
 * date and the invalid images invalidated (in the window, so they are
 * exposed and drawn), along the path bits */
@method VisClass, MSG_VIS_UPDATE_WINDOWS_AND_IMAGE
{
    VisInstance *v;
    word flags = UpdateWindowHere(oself, updateImageFlags);
    byte parentFlags = (byte) (flags >> 8), childFlags = (byte) flags;
    byte test = 0;
    Boolean toChildren = TRUE;
    struct { VisUpdateImageFlags f; } p;

    v = VisPart(oself);
    if (!(parentFlags & VUIF_ALREADY_INVALIDATED) &&
	v->VI_optFlags & VOF_IMAGE_INVALID) {
	VisAddOurBoundsToUpdateRegion(oself,
	    parentFlags & VUIF_JUST_OPENED ? 0 : VARF_ONLY_REDRAW_MARGINS);
	v = VisPart(oself);
	if (v->VI_typeFlags & VTF_IS_COMPOSITE &&
	    ((VisCompInstance *) v)->VCI_geoAttrs &
	    VCGA_ONLY_DRAWS_IN_MARGINS) {
	    /* only the margins were invalidated: all children too */
	    childFlags = VUIF_SEND_TO_ALL_CHILDREN;
	    goto call;
	}
	childFlags = VUIF_ALREADY_INVALIDATED;
    }
    /* sending to all (the flags passed), or along the path bits */
    if (parentFlags & VUIF_SEND_TO_ALL_CHILDREN)
	test = 0;
    else if (v->VI_optFlags & (VOF_WINDOW_UPDATE_PATH |
			       VOF_IMAGE_UPDATE_PATH))
	test = VOF_WINDOW_INVALID | VOF_WINDOW_UPDATE_PATH |
	       VOF_IMAGE_INVALID | VOF_IMAGE_UPDATE_PATH;
    else
	toChildren = FALSE;
call:
    if (toChildren) {
	p.f = childFlags;
	VisIfFlagSetCallVisChildren(oself, MSG_VIS_UPDATE_WINDOWS_AND_IMAGE,
				    &p, sizeof(p), test);
    }
    v = VisPart(oself);
    v->VI_optFlags &= ~(VOF_IMAGE_INVALID | VOF_IMAGE_UPDATE_PATH |
			VOF_WINDOW_INVALID | VOF_WINDOW_UPDATE_PATH);
    if (v->VI_typeFlags & VTF_IS_WIN_GROUP)
	InvalUpdateRegionIfNeeded(oself);
}

/* VisVupUpdateWinGroup (static) */
@method VisClass, MSG_VIS_VUP_UPDATE_WIN_GROUP
{
    return VisVupUpdateWinGroup(oself, updateMode);
}

/* VisSetVisAttrs: the attributes changed; what depends on them marked
 * invalid (geometry on the parent for VA_MANAGED, the window for
 * VA_VISIBLE, the image for VA_DRAWABLE) */
@method VisClass, MSG_VIS_SET_ATTRS
{
    VisAttrs old = pself->VI_attrs, now, changed;
    VisOptFlags here = 0, parent = 0;

    now = (old | attrsToSet) & ~attrsToClear;
    changed = old ^ now;
    if (changed & VA_MANAGED)
	parent |= VOF_GEOMETRY_INVALID | VOF_GEO_UPDATE_PATH;
    if (changed & VA_VISIBLE)
	here |= VOF_WINDOW_INVALID;
    if (changed & VA_DRAWABLE)
	here |= VOF_IMAGE_INVALID;
    if (here)
	VisMarkInvalid(oself, here, VUM_MANUAL);
    if (parent)
	VisMarkInvalidOnParent(oself, parent, VUM_MANUAL);
    VisPart(oself)->VI_attrs = now;
    if (updateMode != VUM_MANUAL)
	VisVupUpdateWinGroup(oself, updateMode);
}

@method VisClass, MSG_VIS_GET_ATTRS
{
    return pself->VI_attrs;
}

@method VisClass, MSG_VIS_GET_OPT_FLAGS
{
    return pself->VI_optFlags;
}

@method VisClass, MSG_VIS_SET_TYPE_FLAGS
{
    pself->VI_typeFlags = (pself->VI_typeFlags | flagsToSet) & ~flagsToClear;
}

@method VisClass, MSG_VIS_GET_TYPE_FLAGS
{
    return pself->VI_typeFlags;
}

/* VisInvalidate: our bounds into the update region */
@method VisClass, MSG_VIS_INVALIDATE
{
    VisAddOurBoundsToUpdateRegion(oself, VARF_ONLY_REDRAW_MARGINS);
}

/* AddOurBoundsToUpdateRegion: the bounds (a window's in its own
 * coordinates) to MSG_VIS_ADD_RECT_TO_UPDATE_REGION */
void VisAddOurBoundsToUpdateRegion(optr obj, VisAddRectFlags flags)
{
    VisInstance *v = VisLock(obj);
    Rectangle b = v->VI_bounds;

    if (!(v->VI_typeFlags & VTF_IS_CONTENT) &&
	v->VI_typeFlags & VTF_IS_WINDOW) {
	b.R_right -= b.R_left;
	b.R_bottom -= b.R_top;
	b.R_left = b.R_top = 0;
    }
    VisUnlock(obj);
    @call obj::MSG_VIS_ADD_RECT_TO_UPDATE_REGION(0, flags, b.R_bottom,
						 b.R_right, b.R_top, b.R_left);
}

/* InvalidateArea: the rectangle invalidated through a gstate */
static void InvalidateArea(optr oself, const Rectangle *r)
{
    GStateHandle gs = @call oself::MSG_VIS_VUP_CREATE_GSTATE();
    sword right = r->R_right, bottom = r->R_bottom;

    if (!gs)
	return;
    if (r->R_left != right)
	right--;
    if (r->R_top != bottom)
	bottom--;
    GrInvalRect(gs, r->R_left, r->R_top, right, bottom);
    GrDestroyState(gs);
}

void VisSaveAsInvalChunk(optr obj, ChunkHandle region)
{
    *(ChunkHandle *) ObjVarAddData(obj, TEMP_VIS_INVAL_REGION,
				   sizeof(ChunkHandle)) = region;
}

/* AddToInvalRegion: the rectangle or'ed into the region of
 * TEMP_VIS_INVAL_REGION (a rectangle region to start with) */
static void AddToInvalRegion(optr oself, const Rectangle *r)
{
    MemHandle mh = OptrToHandle(oself);
    ChunkHandle rect = LMemAlloc(mh, 11 * sizeof(word)), *old, dst;
    sword *p = LMemDeref(ConstructOptr(mh, rect));
    optr oldReg;

    p[0] = r->R_top - 1;
    p[1] = EOREGREC;
    p[2] = r->R_bottom - 1;
    p[3] = r->R_left;
    p[4] = r->R_right - 1;
    p[5] = EOREGREC;
    p[6] = EOREGREC;
    old = ObjVarFindData(oself, TEMP_VIS_INVAL_REGION);
    if (!old) {
	VisSaveAsInvalChunk(oself, rect);
	return;
    }
    oldReg = ConstructOptr(mh, *old);
    if (!LMemGetChunkSize(oldReg))
	dst = rect;
    else {
	dst = LMemAlloc(mh, 0);
	GrChunkRegOp(ROF_OR_OP, oldReg, ConstructOptr(mh, rect),
		     ConstructOptr(mh, dst));
	LMemFree(ConstructOptr(mh, rect));
    }
    LMemFree(oldReg);
    VisSaveAsInvalChunk(oself, dst);
}

/* VisAddRectToUpdateRegion (static): up to the win group (or the top of
 * a branch being removed); there invalidated, or kept in the update
 * region while the win group updates (or will) */
@method VisClass, MSG_VIS_ADD_RECT_TO_UPDATE_REGION
{
    optr o = oself, p;
    Rectangle r;
    VisInstance *v;

    (void) unused;
    r.R_left = left;
    r.R_top = top;
    r.R_right = right;
    r.R_bottom = bottom;
    for (;;) {
	VisTypeFlags t = VisLock(o)->VI_typeFlags;
	VisUnlock(o);
	if (t & VTF_IS_WIN_GROUP)
	    break;
	p = VisFindParent(o);
	if (!p) {
	    addRectFlags &= ~VARF_UPDATE_WILL_HAPPEN;
	    break;
	}
	addRectFlags &= ~VARF_ONLY_REDRAW_MARGINS;
	if (OptrToHandle(p) != OptrToHandle(oself)) {
	    @call p::MSG_VIS_ADD_RECT_TO_UPDATE_REGION(0, addRectFlags,
						r.R_bottom, r.R_right,
						r.R_top, r.R_left);
	    return;
	}
	o = p;
    }
    if (r.R_left == r.R_right || r.R_top == r.R_bottom)
	return;
    v = VisLock(o);
    if (addRectFlags & VARF_UPDATE_WILL_HAPPEN ||
	v->VI_optFlags & VOF_UPDATING) {
	VisUnlock(o);
	AddToInvalRegion(o, &r);
	return;
    }
    VisUnlock(o);
    InvalidateArea(o, &r);
}

/* VisInvalTree: the window's tree invalidated */
@method VisClass, MSG_VIS_INVAL_TREE
{
    WindowHandle w = VisQueryWindow(oself);
    Rectangle b;
    Region *none = NULL;

    if (!w)
	return;
    VisGetBounds(oself, &b);
    WinInvalTree(w, none, 0, 0, b.R_right - 1 - b.R_left,
		 b.R_bottom - 1 - b.R_top);
}

/* ---------------------------------------------------------------------
 * Geometry (visGeometry.asm, visUtilsClass.asm)
 * ------------------------------------------------------------------- */

@method VisClass, MSG_VIS_GET_POSITION
{
    return MAKE_XY_DWORD(pself->VI_bounds.R_left, pself->VI_bounds.R_top);
}

@method VisClass, MSG_VIS_GET_BOUNDS
{
    *retValue = pself->VI_bounds;
}

/* VisRemove: closed and out of the visual tree; the parent's geometry
 * is invalid and updated with the mode */
void VisRemove(optr obj, VisUpdateMode mode)
{
    VisInstance *v;
    VisTypeFlags t;
    VisAttrs a;
    optr parent;

    if (!VisCheckIfSpecBuilt(obj))
	return;
    parent = VisFindParent(obj);
    if (parent)
	@call parent::MSG_VIS_RELEASE_GADGET_EXCL(obj);
    v = VisLock(obj);
    t = v->VI_typeFlags;
    VisUnlock(obj);
    if (!(t & VTF_IS_CONTENT))
	@call obj::MSG_META_MUP_ALTER_FTVMC_EXCL(obj, MAEF_FOCUS |
						 MAEF_TARGET | MAEF_NOT_HERE);
    if (!(t & VTF_IS_WIN_GROUP))
	VisAddOurBoundsToUpdateRegion(obj, VARF_UPDATE_WILL_HAPPEN);
    VisSetNotRealized(obj);

    v = VisLock(obj);
    if ((v->VI_typeFlags & VTF_IS_WIN_GROUP &&
	 v->VI_specAttrs & SA_TREE_BUILT_BUT_NOT_REALIZED) ||
	v->VI_typeFlags & VTF_IS_CONTENT) {
	/* a one-way link: only cleared */
	v->VI_link.LP_next = 0;
	v->VI_specAttrs &= ~SA_TREE_BUILT_BUT_NOT_REALIZED;
	VisUnlock(obj);
	return;
    }
    t = v->VI_typeFlags;
    a = v->VI_attrs;
    VisUnlock(obj);
    parent = VisFindParent(obj);
    if (!parent)
	return;
    @call parent::MSG_VIS_REMOVE_CHILD(obj, 0);
    if (!(t & VTF_IS_WIN_GROUP) && a & VA_MANAGED) {
	VisCompInstance *p = (VisCompInstance *) VisLock(parent);
	Boolean realized = p->VI_attrs & VA_REALIZED;
	Boolean custom = p->VCI_geoAttrs & VCGA_CUSTOM_MANAGE_CHILDREN;
	VisUnlock(parent);
	if (!custom)
	    VisVupInvalGeoToHere(parent, realized ? mode : VUM_MANUAL);
    }
}

/* ---------------------------------------------------------------------
 * Queries up the tree, the parent, the children
 * ------------------------------------------------------------------- */

/* VisVupCreateGState: the win group's window (or none) gets a gstate */
@method VisClass, MSG_VIS_VUP_CREATE_GSTATE
{
    GStateHandle gs;

    if (pself->VI_typeFlags & VTF_IS_WIN_GROUP)
	return GrCreateState(((VisCompInstance *) pself)->VCI_window);
    if (VisCallParent(oself, MSG_VIS_VUP_CREATE_GSTATE, NULL, 0, &gs,
		      sizeof(gs)) && gs)
	return gs;
    return GrCreateState(0);
}

/* VisVupQueryClass: this object if of the class, else up the tree */
@method VisClass, MSG_VIS_VUP_FIND_OBJECT_OF_CLASS
{
    struct { ClassStruct *c; } p;
    optr found;

    if (ObjIsObjectInClass(oself, class))
	return oself;
    p.c = class;
    VisCallParent(oself, MSG_VIS_VUP_FIND_OBJECT_OF_CLASS, &p, sizeof(p),
		  &found, sizeof(found));
    return found;
}

@method VisClass, MSG_VIS_VUP_TEST_FOR_OBJECT_OF_CLASS
{
    struct { ClassStruct *c; } p;
    Boolean found;

    if (ObjIsObjectInClass(oself, class))
	return TRUE;
    p.c = class;
    VisCallParent(oself, MSG_VIS_VUP_TEST_FOR_OBJECT_OF_CLASS, &p,
		  sizeof(p), &found, sizeof(found));
    return found;
}

/* VisVisVupQuery: up the tree, unanswered at the top */
@method VisClass, MSG_VIS_P32_VUP_QUERY
{
    optr p = VisFindParent(oself);

    if (!p) {
	memset(retValue, 0, sizeof(*retValue));
	return FALSE;
    }
    return @call p::MSG_VIS_P32_VUP_QUERY(retValue, queryType, data1, data2);
}

@method VisClass, MSG_VIS_FIND_PARENT
{
    return VisFindParent(oself);
}

@method VisClass, MSG_VIS_QUERY_WINDOW
{
    return VisQueryWindow(oself);
}

@method VisClass, MSG_VIS_COUNT_CHILDREN
{
    return pself->VI_typeFlags & VTF_IS_COMPOSITE ? VisCountChildren(oself)
						  : 0;
}

/* ---------------------------------------------------------------------
 * Classed events (the Flow routines are in User/userFlowUtils.goc)
 * ------------------------------------------------------------------- */

static void MessageClassedEvent(optr dest, Message msg, EventHandle event,
				MessageFlags flags)
{
    FlowMessageClassedEvent(dest, msg, event, 0, flags);
}

static void DispatchSendOnOrDestroy(optr oself, EventHandle event,
				    optr next, Message msg,
				    MessageFlags flags)
{
    FlowDispatchSendOnOrDestroyClassedEvent(NULL, oself, msg, event, 0,
					    next, flags);
}

/* VisSendClassedEvent: TO_VIS_PARENT up the visual tree, TO_APP_* to
 * the application object, TO_SYS_* to the system object */
@method VisClass, MSG_META_SEND_CLASSED_EVENT
{
    word to = (word) whereTo;

    if (to == (word) TO_VIS_PARENT) {
	MessageClassedEvent(VisFindParent(oself),
			    MSG_VIS_VUP_SEND_TO_OBJECT_OF_CLASS, event, 0);
	return;
    }
    if (to >= (word) TO_APP_FOCUS && to <= (word) TO_APP_MODEL) {
	optr app = GeodeGetAppObject(0);
	if (!app) {
	    FlowDestroyMessage(event);
	    return;
	}
	@call app::MSG_META_SEND_CLASSED_EVENT(event,
				(TravelOption) (to - (TO_APP_FOCUS - TO_FOCUS)));
	return;
    }
    if (to >= (word) TO_SYS_FOCUS && to <= (word) TO_SYS_MODEL) {
	/* (a full TravelOption: no undefined padding) */
	struct { EventHandle e; TravelOption t; } p;

	p.e = event;
	p.t = (TravelOption) (to - (TO_SYS_FOCUS - TO_FOCUS));
	if (!UserCallSystem(MSG_META_SEND_CLASSED_EVENT, &p, sizeof(p),
			    NULL, 0))
	    FlowDestroyMessage(event);
	return;
    }
    @callsuper();
}

@method VisClass, MSG_VIS_VUP_CALL_OBJECT_OF_CLASS
{
    DispatchSendOnOrDestroy(oself, event, VisFindParent(oself),
			    MSG_VIS_VUP_CALL_OBJECT_OF_CLASS, MF_CALL);
}

@method VisClass, MSG_VIS_VUP_SEND_TO_OBJECT_OF_CLASS
{
    DispatchSendOnOrDestroy(oself, event, VisFindParent(oself),
			    MSG_VIS_VUP_SEND_TO_OBJECT_OF_CLASS, 0);
}

/* VisVupWinGroupCommon: at the win group as a classed event, else to
 * it */
static void WinGroupCommon(optr oself, EventHandle event, Message msg,
			   MessageFlags flags)
{
    VisTypeFlags t = VisPart(oself)->VI_typeFlags;

    if (t & VTF_IS_WIN_GROUP)
	DispatchSendOnOrDestroy(oself, event, VisFindParent(oself), msg,
				flags);
    else
	MessageClassedEvent(VisFindParentOfVisType(oself, VTF_IS_WIN_GROUP),
			    msg, event, flags);
}

@method VisClass, MSG_VIS_VUP_CALL_WIN_GROUP
{
    WinGroupCommon(oself, event, MSG_VIS_VUP_CALL_WIN_GROUP, MF_CALL);
}

@method VisClass, MSG_VIS_VUP_SEND_TO_WIN_GROUP
{
    WinGroupCommon(oself, event, MSG_VIS_VUP_SEND_TO_WIN_GROUP, 0);
}

/* VisParentCommon: the event to the parent, as is (TO_SELF) */
@method VisClass, MSG_VIS_CALL_PARENT
{
    optr p = VisFindParent(oself);

    if (!p)
	ObjFreeMessage(event);
    else
	@call p::MSG_META_SEND_CLASSED_EVENT(event, TO_SELF);
}

@method VisClass, MSG_VIS_SEND_TO_PARENT
{
    optr p = VisFindParent(oself);

    if (!p)
	ObjFreeMessage(event);
    else
	@send p::MSG_META_SEND_CLASSED_EVENT(event, TO_SELF);
}

/* ---------------------------------------------------------------------
 * Drawing
 * ------------------------------------------------------------------- */

/* ShouldObjBeDrawn?: drawable, realized (unless printing), the image
 * valid (unless the composite only draws in its margins), not empty */
Boolean VisShouldObjBeDrawn(optr obj, DrawFlags flags)
{
    VisInstance *v = VisLock(obj);
    Boolean draw = FALSE;

    if (!(v->VI_attrs & VA_DRAWABLE))
	goto out;
    if (!(flags & DF_PRINT)) {
	if (!(v->VI_attrs & VA_REALIZED))
	    goto out;
	if (!(!(flags & DF_DONT_DRAW_CHILDREN) &&
	      v->VI_typeFlags & VTF_IS_COMPOSITE &&
	      ((VisCompInstance *) v)->VCI_geoAttrs &
	      VCGA_ONLY_DRAWS_IN_MARGINS) &&
	    v->VI_optFlags & VOF_IMAGE_INVALID)
	    goto out;
    }
    draw = v->VI_bounds.R_left < v->VI_bounds.R_right;
out:
    VisUnlock(obj);
    return draw;
}

/* VisRedrawEntireObject: drawn now through a gstate of its own */
@method VisClass, MSG_VIS_REDRAW_ENTIRE_OBJECT
{
    GStateHandle gs;

    if ((pself->VI_attrs & (VA_REALIZED | VA_DRAWABLE)) !=
	(VA_REALIZED | VA_DRAWABLE))
	return;
    gs = @call oself::MSG_VIS_VUP_CREATE_GSTATE();
    if (!gs)
	return;
    @call oself::MSG_VIS_DRAW(0, gs);
    GrDestroyState(gs);
}

@method VisClass, MSG_VIS_DRAW_MONIKER
{
    DrawMonikerArgs a;

    a.DMA_xInset = xInset;
    a.DMA_yInset = yInset;
    a.DMA_xMaximum = xMaximum;
    a.DMA_yMaximum = yMaximum;
    a.DMA_gState = gstate;
    a.DMA_textHeight = textHeight;
    VisDrawMoniker(oself, visMoniker, monikerFlags, &a);
}

@method VisClass, MSG_VIS_GET_MONIKER_POS
{
    DrawMonikerArgs a;

    a.DMA_xInset = xInset;
    a.DMA_yInset = yInset;
    a.DMA_xMaximum = xMaximum;
    a.DMA_yMaximum = yMaximum;
    a.DMA_gState = gstate;
    a.DMA_textHeight = textHeight;
    return VisGetMonikerPos(oself, visMoniker, monikerFlags, &a);
}

@method VisClass, MSG_VIS_GET_MONIKER_SIZE
{
    (void) monikerFlags;
    (void) yMaximum;
    (void) xMaximum;
    (void) yInset;
    (void) xInset;
    return VisGetMonikerSize(oself, visMoniker, textHeight, gstate);
}

/* ---------------------------------------------------------------------
 * Input
 * ------------------------------------------------------------------- */

/* VisVupAlterInputFlow: on to the input node */
@method VisClass, MSG_VIS_VUP_ALTER_INPUT_FLOW
{
    optr node = VisFindParentOfVisType(oself, VTF_IS_INPUT_NODE);

    if (node)
	@call node::MSG_VIS_VUP_ALTER_INPUT_FLOW(translation, window, object,
						 grabType,
						 grabFlags & ~VIFGF_NOT_HERE);
}

/* VisVupAlterFTVMCExcl: focus and target to the input node or win group
 * up the tree; the model through the generic parent */
@method VisClass, MSG_META_MUP_ALTER_FTVMC_EXCL
{
    optr up;

    flags &= ~MAEF_NOT_HERE;
    if (flags & MAEF_MODEL && pself->VI_typeFlags & VTF_IS_GEN) {
	struct { optr o; MetaAlterFTVMCExclFlags f; } p;
	p.o = objectWantingControl;
	p.f = flags & (MAEF_GRAB | MAEF_MODEL);
	GenCallParent(oself, message, &p, sizeof(p), NULL, 0);
    }
    flags &= ~MAEF_MODEL;
    if (!(flags & MAEF_MASK_OF_ALL_HIERARCHIES))
	return;
    up = VisFindParentOfVisType(oself, VTF_IS_INPUT_NODE |
				VTF_IS_WIN_GROUP);
    if (up)
	@call up::MSG_META_MUP_ALTER_FTVMC_EXCL(objectWantingControl, flags);
}

/* the object grabs or releases an exclusive from the node above
 * (MetaGrabFocusExclLow and the others, as the asm's VisClass) */
@method VisClass, MSG_META_GRAB_FOCUS_EXCL
{
    MetaGrabFocusExclLow(oself);
}

@method VisClass, MSG_META_RELEASE_FOCUS_EXCL
{
    MetaReleaseFocusExclLow(oself);
}

@method VisClass, MSG_META_GRAB_TARGET_EXCL
{
    MetaGrabTargetExclLow(oself);
}

@method VisClass, MSG_META_RELEASE_TARGET_EXCL
{
    MetaReleaseTargetExclLow(oself);
}

@method VisClass, MSG_META_GRAB_MODEL_EXCL
{
    MetaGrabModelExclLow(oself);
}

@method VisClass, MSG_META_RELEASE_MODEL_EXCL
{
    MetaReleaseModelExclLow(oself);
}

@method VisClass, MSG_META_RELEASE_FT_EXCL
{
    MetaReleaseFTExclLow(oself);
}

/* VisFupQueryFocusExcl: asked of the input node or win group above */
@method VisClass, MSG_VIS_FUP_QUERY_FOCUS_EXCL,
		  MSG_VIS_VUP_QUERY_FOCUS_EXCL
{
    optr up = VisFindParentOfVisType(oself, VTF_IS_INPUT_NODE |
				     VTF_IS_WIN_GROUP);
    struct { ObjectAndGrabParams *r; } p;

    memset(retValue, 0, sizeof(*retValue));
    if (!up)
	return;
    p.r = retValue;
    CObjMessageP(MF_CALL, up, message, &p, sizeof(p), NULL, 0);
}

/* VisKbdChar: to the focus parent */
@method VisClass, MSG_META_KBD_CHAR
{
    (void) @call oself::MSG_META_FUP_KBD_CHAR(character, flags, state);
}

/* VisEnsureMouseNotActivelyTrespassing: a window that may not be
 * interacted with lets go of the gadget exclusive */
@method VisClass, MSG_META_ENSURE_MOUSE_NOT_ACTIVELY_TRESPASSING
{
    optr app, p;

    if (!(pself->VI_typeFlags & (VTF_IS_WINDOW | VTF_IS_PORTAL)) ||
	pself->VI_typeFlags & VTF_IS_WIN_GROUP)
	return 0;
    app = GeodeGetAppObject(0);
    if (!app || @call app::MSG_META_TEST_WIN_INTERACTIBILITY(oself, 0))
	return 0;
    p = VisFindParent(oself);
    if (p)
	@call p::MSG_VIS_RELEASE_GADGET_EXCL(oself);
    return 0;
}

/* VisEndMoveCopy: the quick transfer ends (no clipboard yet: nothing to
 * end) */
@method VisClass, MSG_META_END_MOVE_COPY
{
    (void) xPosition;
    (void) yPosition;
    (void) inputState;
    retVal->flags = MRF_PROCESSED;
}

@method VisClass, MSG_META_QUERY_IF_PRESS_IS_INK
{
    (void) xPosition;
    (void) yPosition;
    retVal->inkType = IRV_NO_INK;
}

/* (MSG_GEN_MAKE_APPLYABLE and _NOT_APPLYABLE up the visual tree: not
 * yet, goc gives VisClass no Gen messages) */

@method VisClass, MSG_SPEC_P32_GUP_QUERY
{
    struct { GenReturnParams *r; GenUpwardQueryType t; } p;
    Boolean r = FALSE;

    p.r = retValue;
    p.t = queryType;
    GenCallParent(oself, message, &p, sizeof(p), &r, sizeof(r));
    return r;
}

/*
 * VisSpecRescanGeoAndUpdate: the geometry hints scanned again (the
 * size hints may apply again), then both visual parts marked invalid.
 */
@method VisClass, MSG_SPEC_P32_RESCAN_GEO_AND_UPDATE
{
    optr a, b;

    @call oself::MSG_VIS_SET_GEO_ATTRS(0, VGA_NO_SIZE_HINTS, VUM_MANUAL);
    @call oself::MSG_SPEC_SCAN_GEOMETRY_HINTS();
    a = VisGetSpecificVisObject(oself, 0);
    b = VisGetSpecificVisObject(oself, SBF_WIN_GROUP);
    if (a && a != b)
	@call a::MSG_VIS_MARK_INVALID(flags, updateMode);
    if (b)
	@call b::MSG_VIS_MARK_INVALID(flags, updateMode);
}

@method VisClass, MSG_VIS_CREATE_VIS_MONIKER
{
    Boolean failed;

    return VisCreateMonikerChunk(oself, 0, flags, height, width, length,
				 dataType, sourceType, source, &failed);
}

/* ---------------------------------------------------------------------
 * Moniker chunks (VisCreateMonikerChunk of visClass.asm)
 * ------------------------------------------------------------------- */

/* LockSource: the source's bytes (UnlockSource: unlocked) */
static const byte *LockSource(VisMonikerSourceType st, VisMonikerSource src,
			      word *chunkSize)
{
    *chunkSize = 0;
    switch (st) {
    case VMST_FPTR:
	return (const byte *) (uintptr_t) src;
    case VMST_OPTR: {
	const byte *p;
	MemLock(OptrToHandle(src));
	p = LMemDeref(src);
	*chunkSize = p ? LMemGetChunkSize(src) : 0;
	return p;
    }
    default:
	return (const byte *) MemLock(OptrToHandle(src)) + OptrToChunk(src);
    }
}

static void UnlockSource(VisMonikerSourceType st, VisMonikerSource src)
{
    if (st != VMST_FPTR)
	MemUnlock(OptrToHandle(src));
}

/*
 * VisCreateMonikerChunk: a moniker made in the object's block from the
 * source: a VisMoniker as it is, text or a gstring with the moniker
 * header put in front; over `chunk' if it is not 0.  The chunk is marked
 * dirty with CVMF_DIRTY.  Port32: the source is copied directly (the
 * block is run by the calling thread), not by
 * MSG_PROCESS_COPY_CHUNK_OVER; VMDT_TOKEN fails (*failed TRUE).
 */
ChunkHandle VisCreateMonikerChunk(optr obj, ChunkHandle chunk,
				  CreateVisMonikerFlags flags, word height,
				  word width, word length,
				  VisMonikerDataType dataType,
				  VisMonikerSourceType sourceType,
				  VisMonikerSource source, Boolean *failed)
{
    MemHandle mh = OptrToHandle(obj);
    word hdr = 0, size, csize;
    const byte *s;
    byte *d;
    Boolean addNull = FALSE;

    *failed = FALSE;
    if (dataType == VMDT_NULL || dataType == VMDT_TOKEN) {
	*failed = TRUE;
	return chunk;
    }
    if (dataType == VMDT_TEXT)
	hdr = VMWT_text;
    else if (dataType == VMDT_GSTRING)
	hdr = VMWGS_gString;
    s = LockSource(sourceType, source, &csize);
    size = sourceType == VMST_OPTR ? csize : length;
    if (dataType == VMDT_TEXT) {
	if (!size)
	    size = (word) (LocalStringLength((const char *) s) + 1);
	addNull = !size || s[size - 1] != 0;
    }
    UnlockSource(sourceType, source);
    ObjLockObjBlock(mh);
    if (chunk) {
	LMemReAlloc(ConstructOptr(mh, chunk), (word) (hdr + size + addNull));
    } else {
	chunk = LMemAlloc(mh, (word) (hdr + size + addNull));
    }
    s = LockSource(sourceType, source, &csize);
    d = LMemDeref(ConstructOptr(mh, chunk));
    memset(d, 0, hdr);
    memcpy(d + hdr, s, size);
    UnlockSource(sourceType, source);
    if (addNull)
	d[hdr + size] = 0;
    if (dataType == VMDT_TEXT) {
	VisMonikerWithText *t = (VisMonikerWithText *) d;
	t->VMWT_common.VM_type = 0;
	t->VMWT_common.VM_width = 0;
	t->VMWT_mnemonicOffset = (char) 0xff;	/* VMO_NO_MNEMONIC */
    } else if (dataType == VMDT_GSTRING) {
	VisMonikerWithGString *g = (VisMonikerWithGString *) d;
	g->VMWGS_common.VM_type = VMT_GSTRING;
	g->VMWGS_common.VM_width = width;
	g->VMWGS_height = height;
    }
    if (flags & CVMF_DIRTY)
	ObjSetFlags(ConstructOptr(mh, chunk), OCF_DIRTY, 0);
    MemUnlock(mh);
    return chunk;
}

word VisCountChildren(optr obj)
{
    word n = 0;

    ObjCompProcessChildren(obj, 0, OCCT_COUNT_CHILDREN, &n,
			   word_offsetof(VisBase, Vis_offset),
			   word_offsetof(VisCompInstance, VCI_comp),
			   word_offsetof(VisInstance, VI_link), NULL);
    return n;
}

/* VisVupUpdateWinGroup (static): up to the win group, which updates
 * (VisCompVupUpdateWinGroup); TRUE if one was reached */
Boolean VisVupUpdateWinGroup(optr obj, VisUpdateMode mode)
{
    optr o = obj;

    if (mode == VUM_MANUAL)
	return FALSE;
    while (o) {
	VisTypeFlags t = VisLock(o)->VI_typeFlags;
	VisUnlock(o);
	if (t & VTF_IS_WIN_GROUP)
	    return VisCompVupUpdateWinGroup(o, mode);
	o = VisFindParent(o);
    }
    return FALSE;
}
