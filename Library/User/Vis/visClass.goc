/*
 * visClass.goc -- VisClass, after visClass.asm, which has its class
 * record; its other methods are in visGeometry.goc, visSpec.goc,
 * visUtilsClass.goc and visUtilsResident.goc, each beside its asm file.
 *
 * VisClass is the base of the visual tree: bounds, the opening and
 * closing of the visible branch (MSG_VIS_OPEN/CLOSE), the update
 * mechanism (the invalid and path bits of VI_optFlags, the win group's
 * update, the update region), drawing, the queries up the tree and the
 * classed events.
 *
 * Port32:
 *   - messages that answered with the carry return their value (0: not
 *     answered), as the C prototypes of visC.goh have them;
 *   - the clipboard is not in the library yet: the quick transfer of
 *     MSG_META_END_MOVE_COPY goes nowhere (Port32/ABI.md section 13x);
 *   - MSG_VIS_VUP_QUERY goes up with its query
 *     (MSG_VIS_P32_VUP_QUERY, Internal/specC.goh);
 *   - MSG_VIS_CALL_ROUTINE (registers and a far routine) is not handled
 *     yet.
 */
@include "uiInt.goh"
#include <string.h>
#include <stdint.h>
@include <Objects/gFieldC.goh>
#include <localize.h>
#include <Internal/grWinInt.h>

@classdecl VisClass, neverSaved;
/* visGeometry.goc */
@extern method VisClass, MSG_VIS_UPDATE_GEOMETRY;
@extern method VisClass, MSG_VIS_BOUNDS_CHANGED;
@extern method VisClass, MSG_VIS_RESET_TO_INITIAL_SIZE, MSG_SPEC_RESET_SIZE_TO_STAY_ONSCREEN;
@extern method VisClass, MSG_VIS_SET_GEO_ATTRS;
@extern method VisClass, MSG_VIS_GET_GEO_ATTRS;
/* visSpec.goc */
@extern method VisClass, MSG_SPEC_BUILD_BRANCH;
