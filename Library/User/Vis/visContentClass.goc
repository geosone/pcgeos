/*
 * visContentClass.goc -- VisContentClass, after visContentClass.asm,
 * which has its class record; what visContentCommon.asm has is in
 * visContentCommon.goc.  The content is the top of a visual tree that
 * is shown in the window of a view (VCNI_view, VCNI_window), and its
 * input node.
 *
 * Here:
 *   - the view: its window opened and closed, its size (the content's
 *     geometry follows it), origin and scale factor, the document
 *     bounds set in it;
 *   - mouse events: to the pre-passive grabs, the active grab or else
 *     the implied one (the object the window under the mouse belongs
 *     to), the post-passive grabs, in the coordinates of the grab
 *     (small ones, or large ones in the document); a replay when the
 *     grab changed;
 *   - the grabs themselves (MSG_VIS_VUP_ALTER_INPUT_FLOW), keyboard
 *     events to the keyboard grab or the focus;
 *   - input held up in a queue (MSG_VIS_CONTENT_HOLD_UP_INPUT_FLOW)
 *     until it may flow again;
 *   - the content as a node of the focus and target hierarchies.
 *
 * Port32 (Port32/ABI.md section 13x):
 *   - a grab's coordinates are worked out on a copy of the VisMouseGrab
 *     (chunks move); MSG_VIS_CONTENT_UNWANTED_MOUSE_EVENT gets that
 *     copy;
 *   - an event held up is recorded again with its parameter structure;
 *     the MouseReturnParams of a mouse event do not come back to a
 *     sender that has gone on meanwhile (the pointer is cleared);
 *   - the pointer events combined in the hold-up queue (MF_CUSTOM in
 *     the asm) use QueuePeekLastMessage and ObjSetMessageParams;
 *   - not yet: ink (MSG_META_NOTIFY_WITH_DATA_BLOCK of GWNT_INK needs
 *     VisCallChildrenInBounds), the quick transfer's end
 *     (ClipboardHandleEndMoveCopy), UserStandardSound for an unwanted
 *     press, the EC messages (MSG_VIS_VUP_EC_ENSURE_*);
 *   - goc has no discardOnSave: the class is declared without
 *     CLASSF_DISCARD_ON_SAVE (nothing is saved to state yet).
 */
@include "uiInt.goh"
@include <Objects/vCntC.goh>
#include <string.h>
#include <chunkarr.h>
#include <thread.h>
@classdecl VisContentClass;
/* visContentCommon.goc */
@extern method VisContentClass, MSG_VIS_FORCE_GRAB_LARGE_MOUSE, MSG_VIS_FORCE_GRAB_MOUSE, MSG_VIS_GRAB_LARGE_MOUSE, MSG_VIS_GRAB_MOUSE, MSG_VIS_RELEASE_MOUSE;
@extern method VisContentClass, MSG_VIS_INVALIDATE;
@extern method VisContentClass, MSG_META_CONTENT_VIEW_LOST_GADGET_EXCL;
@extern method VisContentClass, MSG_META_CONTENT_VIEW_ORIGIN_CHANGED;
@extern method VisContentClass, MSG_VIS_VUP_SET_MOUSE_INTERACTION_BOUNDS;
@extern method VisContentClass, MSG_VIS_DRAW;
@extern method VisContentClass, MSG_META_FORCE_GRAB_KBD, MSG_META_GRAB_KBD, MSG_META_RELEASE_KBD;
@extern method VisContentClass, MSG_VIS_CONTENT_DISABLE_HOLD_UP;
@extern method VisContentClass, MSG_VIS_CONTENT_ENABLE_HOLD_UP;
@extern method VisContentClass, MSG_VIS_CONTENT_HOLD_UP_INPUT_FLOW;
@extern method VisContentClass, MSG_VIS_CONTENT_RESUME_INPUT_FLOW;
@extern method VisContentClass, MSG_META_OBJ_FLUSH_INPUT_QUEUE;
@extern method VisContentClass, MSG_META_PTR, MSG_META_START_SELECT, MSG_META_END_SELECT, MSG_META_DRAG_SELECT, MSG_META_START_MOVE_COPY, MSG_META_END_MOVE_COPY, MSG_META_DRAG_MOVE_COPY, MSG_META_START_FEATURES, MSG_META_END_FEATURES, MSG_META_DRAG_FEATURES, MSG_META_START_OTHER, MSG_META_END_OTHER, MSG_META_DRAG_OTHER;
@extern method VisContentClass, MSG_META_SCROLL_VERTICAL;
@extern method VisContentClass, MSG_VIS_CONTENT_UNWANTED_MOUSE_EVENT;
@extern method VisContentClass, MSG_META_QUERY_IF_PRESS_IS_INK;
@extern method VisContentClass, MSG_META_IMPLIED_WIN_CHANGE;
@extern method VisContentClass, MSG_VIS_CONTENT_TEST_IF_ACTIVE_OR_IMPLIED_WIN;
@extern method VisContentClass, MSG_VIS_VUP_ALTER_INPUT_FLOW;
@extern method VisContentClass, MSG_META_KBD_CHAR;
@extern method VisContentClass, MSG_META_LOST_FOCUS_EXCL, MSG_META_LOST_SYS_FOCUS_EXCL, MSG_META_GAINED_FOCUS_EXCL, MSG_META_GAINED_SYS_FOCUS_EXCL;
@extern method VisContentClass, MSG_META_GAINED_TARGET_EXCL, MSG_META_GAINED_SYS_TARGET_EXCL, MSG_META_LOST_SYS_TARGET_EXCL, MSG_META_LOST_TARGET_EXCL;
@extern method VisContentClass, MSG_META_MUP_ALTER_FTVMC_EXCL;
@extern method VisContentClass, MSG_META_GET_FOCUS_EXCL;
@extern method VisContentClass, MSG_VIS_VUP_QUERY_FOCUS_EXCL, MSG_VIS_FUP_QUERY_FOCUS_EXCL;
@extern method VisContentClass, MSG_META_GET_TARGET_EXCL;
@extern method VisContentClass, MSG_META_SEND_CLASSED_EVENT;
@extern method VisContentClass, MSG_META_CONTENT_TRACK_SCROLLING;
@extern method VisContentClass, MSG_META_LARGE_PTR, MSG_META_LARGE_START_SELECT, MSG_META_LARGE_START_MOVE_COPY, MSG_META_LARGE_START_FEATURES, MSG_META_LARGE_START_OTHER, MSG_META_LARGE_DRAG_SELECT, MSG_META_LARGE_DRAG_MOVE_COPY, MSG_META_LARGE_DRAG_FEATURES, MSG_META_LARGE_DRAG_OTHER, MSG_META_LARGE_END_SELECT, MSG_META_LARGE_END_MOVE_COPY, MSG_META_LARGE_END_FEATURES, MSG_META_LARGE_END_OTHER;
@extern method VisContentClass, MSG_META_LARGE_QUERY_IF_PRESS_IS_INK;
@extern method VisContentClass, MSG_META_CONTENT_ENTER, MSG_META_CONTENT_LEAVE;

/* the large messages follow the small ones in the same order */
typedef char VisContentLargeOrder[
    (MSG_META_LARGE_DRAG_OTHER - MSG_META_LARGE_START_SELECT ==
     MSG_META_DRAG_OTHER - MSG_META_START_SELECT) ? 1 : -1];

#define ContentPart(o)	((VisContentInstance *) ObjDerefVis(o))

/* ---------------------------------------------------------------------
 * Creation and the end
 * ------------------------------------------------------------------- */

/* ViewUpdateContentTargetInfo: the view told the target here and its
 * class (called: the structure is the caller's) */
void VisContentUpdateViewTargetInfo(optr oself)
{
    VisContentInstance *c = ContentPart(oself);
    ViewTargetInfo info;
    optr view = c->VCNI_view;

    memset(&info, 0, sizeof(info));
    info.VTI_content.TR_object = oself;
    info.VTI_content.TR_class = @call oself::MSG_META_GET_CLASS();
    info.VTI_target.TR_object = c->VCNI_targetExcl.FTVMC_OD;
    if (info.VTI_target.TR_object)
	info.VTI_target.TR_class =
	    @call info.VTI_target.TR_object::MSG_META_GET_CLASS();
    if (view)
	@call view::MSG_GEN_VIEW_UPDATE_CONTENT_TARGET_INFO(&info);
}

/* VisContentReloc: nothing has the focus or target when saved; the GCN
 * lists unrelocated */
@method VisContentClass, _reloc
{
    VisContentInstance *c = ContentPart(oself);
    TempMetaGCNData *d;

    (void) vmRelocType;
    if (message != MSG_META_RELOCATE) {
	c->VCNI_focusExcl.FTVMC_OD = 0;
	c->VCNI_targetExcl.FTVMC_OD = 0;
	c->VCNI_view = 0;
	d = ObjVarFindData(oself, TEMP_META_GCN);
	if (d && d->TMGCND_flags & TMGCNF_RELOCATED) {
	    d->TMGCND_flags &= ~TMGCNF_RELOCATED;
	    if (GCNListUnRelocateBlock(OptrToHandle(oself),
				       d->TMGCND_listOfLists,
				       OptrToHandle(oself)))
		ObjVarDeleteData(oself, TEMP_META_GCN);
	}
    }
    return @callsuper();
}

/* ---------------------------------------------------------------------
 * The view and its window
 * ------------------------------------------------------------------- */

/* VisContentSendToLargeDocumentLayers */
void VisContentSendToLayers(optr oself, Message msg, const void *params,
			 word size)
{
    if (ContentPart(oself)->VCNI_attrs & VCNA_LARGE_DOCUMENT_MODEL)
	VisSendToChildren(oself, msg, params, size);
}

