/*
 * visUtilsClass.goc -- moniker lists (after VisFindMoniker,
 * GetBestMonikerFromList and VisTestMoniker in visUtilsClass.asm): the
 * moniker of a list that fits a search (text or gstring, the style) and
 * a display type (a gstring's size, colors and aspect ratio) best, the
 * moniker itself if it is none; copied into a block or over the list.
 *
 * Port32: the copy is made by the calling thread (the asm asked it by
 * MSG_PROCESS_COPY_CHUNK_OVER): it must run the destination block, as
 * the asm required.
 */
@include "uiInt.goh"
#include <string.h>
#include <stdint.h>
#include <Internal/grWinInt.h>

/* VisMonikerScore: the fields by priority (highest first) */
#define SCORE_TEXT_OR_GSTRING	0x1000
#define SCORE_STYLE		0x0f00
#define SCORE_GS_ASPECT_RATIO	0x00c0
#define SCORE_GS_SIZE		0x0030
#define SCORE_GS_COLOR		0x000f
#define SCORE_GS_SIZE_OFFSET	4

/*
 * VisTestMoniker: how well a list entry of type `t' fits the search
 * flags (the DisplayType in their low byte, VisUpdateSearchSpec)
 */
static word TestMoniker(word t, word f)
{
    word score = 0;
    int d;

    if (((t & VMLET_GSTRING) != 0) == ((f & VMSF_GSTRING) != 0))
	score |= SCORE_TEXT_OR_GSTRING;
    if (((f & VMSF_STYLE) >> VMSF_STYLE_OFFSET) ==
	((t & VMLET_STYLE) >> VMLET_STYLE_OFFSET))
	score |= SCORE_STYLE;
    if (!(t & VMLET_GSTRING))
	return score;
    /* the size: 3 matching, less for each size apart */
    d = (int) ((f & DT_DISP_SIZE) >> DT_DISP_SIZE_OFFSET) -
	(int) ((t & VMLET_GS_SIZE) >> VMLET_GS_SIZE_OFFSET);
    if (d < 0)
	d = -d;
    score |= (word) (((word) d << SCORE_GS_SIZE_OFFSET) ^ SCORE_GS_SIZE);
    /* the colors: none if the moniker needs more than the display has */
    d = (int) ((f & DT_DISP_CLASS) >> DT_DISP_CLASS_OFFSET) -
	(int) ((t & VMLET_GS_COLOR) >> VMLET_GS_COLOR_OFFSET);
    if (d >= 0)
	score |= (word) ((word) d ^ SCORE_GS_COLOR);
    /* the aspect ratio: matching or nothing */
    if (((f & DT_DISP_ASPECT_RATIO) >> DT_DISP_ASPECT_RATIO_OFFSET) ==
	((t & VMLET_GS_ASPECT_RATIO) >> VMLET_GS_ASPECT_RATIO_OFFSET))
	score |= SCORE_GS_ASPECT_RATIO;
    return score;
}

/* GetBestMonikerFromList: the best entry (the first of equal ones) */
static optr BestFromList(const VisMonikerListEntry *e, word n, word f)
{
    optr best = 0;
    int bestScore = -1;
    word s;

    for (; n; n--, e++) {
	s = TestMoniker(e->VMLE_type, f);
	if ((int) s > bestScore) {
	    bestScore = s;
	    best = e->VMLE_moniker;
	}
    }
    return best;
}

/* a copy of the moniker `m' in `dest' (over the chunk `over' if not 0;
 * the chunk resized first, both chunks found again after).  The source
 * may be a data block (the monikers of a list in their own resource). */
static optr CopyMoniker(optr m, MemHandle dest, ChunkHandle over)
{
    MemHandle sh = OptrToHandle(m);
    optr o = ConstructOptr(dest, over);
    word size;

    if (!over)
	return ConstructOptr(dest, GenCopyChunk(dest, sh, OptrToChunk(m), 0));
    ObjLockObjBlock(dest);
    if (dest != sh)
	(void) MemLock(sh);
    size = LMemGetChunkSize(m);
    LMemReAlloc(o, size);
    memmove(LMemDeref(o), LMemDeref(m), size);
    if (dest != sh)
	MemUnlock(sh);
    MemUnlock(dest);
    return o;
}

/*
 * VisFindMoniker: the moniker or list `moniker' (0: none); of a list the
 * entry that fits best (there always is one); then VMSF_REPLACE_LIST
 * copies it over the list, VMSF_COPY_CHUNK into `destBlock'.  The
 * moniker found (0 if none).
 */
optr VisFindMoniker(optr moniker, VisMonikerSearchFlags searchFlags,
		    MemHandle destBlock, DisplayType displayType)
{
    MemHandle h = OptrToHandle(moniker);
    VisMoniker *vm;
    optr r;
    word f = (word) ((searchFlags & 0xff00) | displayType);

    if (!OptrToChunk(moniker))
	return 0;
    ObjLockObjBlock(h);
    vm = LMemDeref(moniker);
    if (!(vm->VM_type & VMT_MONIKER_LIST)) {
	MemUnlock(h);
	if (searchFlags & VMSF_COPY_CHUNK)
	    return CopyMoniker(moniker, destBlock, 0);
	return moniker;
    }
    r = BestFromList((const VisMonikerListEntry *) vm,
		     (word) (LMemGetChunkSize(moniker) /
			     sizeof(VisMonikerListEntry)), f);
    MemUnlock(h);
    if (!r)
	return 0;
    if (searchFlags & VMSF_REPLACE_LIST)
	return CopyMoniker(r, h, OptrToChunk(moniker));
    if (searchFlags & VMSF_COPY_CHUNK)
	return CopyMoniker(r, destBlock, 0);
    return r;
}

/* VisCompRemoveNonDiscardable */
@extern method VisClass, MSG_VIS_REMOVE_NON_DISCARDABLE
{
    @call oself::MSG_VIS_REMOVE(updateMode);
    ObjDecInUseCount(OptrToHandle(oself));
}

/* VisRecalcSizeAndInvalIfNeeded: MSG_VIS_RECALC_SIZE unless the size
 * passed is the one there (or the object only recalculates when
 * invalid) */
@extern method VisClass, MSG_VIS_RECALC_SIZE_AND_INVAL_IF_NEEDED
{
    VisInstance *v = VisPart(oself);
    SizeAsDWord s = VisGetSize(oself);
    Boolean call;

    if (v->VI_optFlags & (VOF_GEOMETRY_INVALID | VOF_GEO_UPDATE_PATH) ||
	v->VI_geoAttrs & VGA_ALWAYS_RECALC_SIZE)
	call = TRUE;
    else if (v->VI_geoAttrs & VGA_ONLY_RECALC_SIZE_WHEN_INVALID)
	call = FALSE;
    else
	call = (!(width & RSA_CHOOSE_OWN_SIZE) && width != DWORD_WIDTH(s)) ||
	       (!(height & RSA_CHOOSE_OWN_SIZE) &&
		height != DWORD_HEIGHT(s));
    if (call) {
	if (v->VI_geoAttrs & VGA_GEOMETRY_CALCULATED)
	    VisSaveOldBounds(oself);
	else
	    VisMarkInvalid(oself, VOF_WINDOW_INVALID | VOF_IMAGE_INVALID,
			   VUM_MANUAL);
	s = @call oself::MSG_VIS_RECALC_SIZE(width, height);
    }
    VisPart(oself)->VI_optFlags &= ~(VOF_GEOMETRY_INVALID |
				     VOF_GEO_UPDATE_PATH);
    return s;
}

/* CheckForBoundsChange: TRUE if the bounds changed since SaveOldBounds
 * (or none were saved) */
static Boolean CheckForBoundsChange(optr oself)
{
    Rectangle *saved, old, now;

    VisPart(oself)->VI_attrs &= ~VA_OLD_BOUNDS_SAVED;
    saved = ObjVarFindData(oself, TEMP_VIS_OLD_BOUNDS);
    if (!saved)
	return TRUE;
    old = *saved;
    ObjVarDeleteData(oself, TEMP_VIS_OLD_BOUNDS);
    VisGetBounds(oself, &now);
    if (!memcmp(&old, &now, sizeof(old)))
	return FALSE;
    VisBoundsChanged(oself, &old);
    return TRUE;
}

/* VisSendPositionAndInvalIfNeeded: placed (MSG_VIS_POSITION_BRANCH, or
 * VisSetPosition or VisCompPosition directly); TRUE if the bounds
 * changed */
@extern method VisClass, MSG_VIS_POSITION_AND_INVAL_IF_NEEDED
{
    VisInstance *v = VisPart(oself);
    Boolean changed;

    if (v->VI_geoAttrs & VGA_GEOMETRY_CALCULATED)
	VisSaveOldBounds(oself);
    v = VisPart(oself);
    if (v->VI_geoAttrs & VGA_USE_VIS_SET_POSITION) {
	if (v->VI_typeFlags & VTF_IS_COMPOSITE)
	    VisCompPosition(oself, xPosition, yPosition, 0);
	else
	    VisSetPosition(oself, xPosition, yPosition);
    } else
	@call oself::MSG_VIS_POSITION_BRANCH(xPosition, yPosition);
    VisPart(oself)->VI_geoAttrs |= VGA_GEOMETRY_CALCULATED;
    changed = CheckForBoundsChange(oself);
    if (VisPart(oself)->VI_geoAttrs & VGA_NOTIFY_GEOMETRY_VALID)
	@call oself::MSG_VIS_NOTIFY_GEOMETRY_VALID();
    return changed;
}

/* VisInvalAllGeometry: the geometry of the managed branch invalid */
@extern method VisClass, MSG_VIS_INVAL_ALL_GEOMETRY
{
    struct { VisUpdateMode m; } p;

    if (!(pself->VI_attrs & VA_MANAGED))
	return;
    if (pself->VI_typeFlags & VTF_IS_COMPOSITE) {
	p.m = VUM_MANUAL;
	VisSendToChildren(oself, MSG_VIS_INVAL_ALL_GEOMETRY, &p, sizeof(p));
    }
    VisMarkInvalid(oself, VOF_GEOMETRY_INVALID, updateMode);
}

@extern method VisClass, MSG_VIS_ADD_BUTTON_PRE_PASSIVE
{
    VisAlterInputFlow(oself, VIFGF_MOUSE | VIFGF_GRAB, VIFGT_PRE_PASSIVE);
}

@extern method VisClass, MSG_VIS_REMOVE_BUTTON_PRE_PASSIVE
{
    VisAlterInputFlow(oself, VIFGF_MOUSE, VIFGT_PRE_PASSIVE);
}

@extern method VisClass, MSG_VIS_ADD_BUTTON_POST_PASSIVE
{
    VisAlterInputFlow(oself, VIFGF_MOUSE | VIFGF_GRAB, VIGFT_POST_PASSIVE);
}

@extern method VisClass, MSG_VIS_REMOVE_BUTTON_POST_PASSIVE
{
    VisAlterInputFlow(oself, VIFGF_MOUSE, VIGFT_POST_PASSIVE);
}

/* VisSendCenter: the center, directly if the object says so
 * (VGA_USE_VIS_CENTER) */
void VisSendCenter(optr obj, GetCenterParams *c)
{
    VisInstance *v = VisLock(obj);
    Boolean direct = (v->VI_geoAttrs & VGA_USE_VIS_CENTER) != 0;
    Boolean comp = (v->VI_typeFlags & VTF_IS_COMPOSITE) != 0;

    VisUnlock(obj);
    if (!direct)
	@call obj::MSG_VIS_GET_CENTER(c);
    else if (comp)
	VisCompGetCenter(obj, c);
    else
	VisGetCenter(obj, c);
}

void VisGetParentCenter(optr obj, GetCenterParams *c)
{
    optr p = VisFindParent(obj);

    memset(c, 0, sizeof(*c));
    if (p)
	VisSendCenter(p, c);
}

/* the methods of VisClass (visClass.goc) as routines */
SizeAsDWord VisRecalcSizeAndInvalIfNeeded(optr obj, word width, word height)
{
    return @call obj::MSG_VIS_RECALC_SIZE_AND_INVAL_IF_NEEDED(width, height);
}

Boolean VisSendPositionAndInvalIfNeeded(optr obj, sword x, sword y)
{
    return @call obj::MSG_VIS_POSITION_AND_INVAL_IF_NEEDED(x, y);
}
