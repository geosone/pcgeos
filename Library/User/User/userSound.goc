/*
 * userSound.goc -- the sounds of the UI: UserStandardSound,
 * UserStopStandardSound and the standard sounds (userUtils.asm),
 * MSG_USER_UPDATE_SOUND_PARAMS and MSG_USER_FREE_SOUND_HANDLE
 * (userMain.asm).
 *
 * The UI does not import the sound library: it loads sound.geo from
 * SYSTEM when it attaches (MSG_USER_UPDATE_SOUND_PARAMS) and calls its
 * routines by entry number (Library/Sound/sound32.gp).  "[ui] sound"
 * (default true) turns the sounds on and off, "[ui] soundMask" each
 * standard sound (StandardSoundFlags, a bit per StandardSoundType).
 *
 * Port32:
 *  - the library stays loaded while "[ui] sound" is false (the asm freed
 *    it), so that a sound with SST_IGNORE_SOUND_OFF is heard then too;
 *    the asm went on to call the library it had not loaded;
 *  - UserStandardSound is a C routine (ui.goh), the asm's register
 *    routine and its C stub (_UserStandardSound) in one;
 *  - UserStopStandardSound ignores the type SST_IGNORE_SOUND_OFF + 7 too
 *    (the asm let it index past its table);
 *  - the standard sounds are songs of the UI's data, not resources;
 *  - the UI frees them and the library when it ends (UserSoundExit):
 *    the kernel does not free what a geode used while it ran.
 */
@include "uiInt.goh"
@include <Objects/gProcC.goh>
@include <Internal/uProcC.goh>
#include <sound.h>
#include <initfile.h>
#include <file.h>
#include <library.h>
#include <Internal/soundCtl.h>
#include <stdarg.h>
#include <string.h>

#define NUM_STANDARD_SOUNDS	7
#define STANDARD_TEMPO		8
#define STANDARD_PRIORITY	SP_SYSTEM_LEVEL
#define VOICE_HIGH		DYNAMIC_FFFF
#define VOICE_LOW		DYNAMIC_FFF
#define ChangePriority(p)	General(GE_SET_PRIORITY), (p)

static GeodeHandle soundLib;
static Boolean soundOn;
static word soundMask = SOUND_MASK_ALL;
static MemHandle standardSoundHandles[NUM_STANDARD_SOUNDS];
static word standardSoundCounts[NUM_STANDARD_SOUNDS];

/* the sound library's routines (sound32.gp's entry numbers) */
#define SND(n, f)	((__typeof__(&f)) ProcGetLibraryEntry(soundLib, (n)))
#define S_AllocMusic		SND(3, SoundAllocMusic)
#define S_PlayMusic		SND(4, SoundPlayMusic)
#define S_StopMusic		SND(5, SoundStopMusic)
#define S_FreeMusic		SND(7, SoundFreeMusic)
#define S_InitMusic		SND(8, SoundInitMusic)
#define S_AllocMusicNote	SND(9, SoundAllocMusicNote)
#define S_PlayMusicNote		SND(10, SoundPlayMusicNote)
#define S_FreeMusicStream	SND(16, SoundFreeMusicStream)
#define S_ChangeOwnerSimple	SND(18, SoundChangeOwnerSimple)
#define S_FreeSampleStream	SND(21, SoundFreeSampleStream)

/* ------------------------------------------------- the standard sounds */

static const word stdErrorBeep[] = {
    ChangePriority(SP_SYSTEM_LEVEL + SP_IMMEDIATE),
    ChangeEnvelope(0, IP_TROMBONE, IT_STANDARD_TABLE),
    DeltaTick(1),
    VoiceOn(0, 500, VOICE_HIGH), DeltaTick(3),	/* 3 tick beep */
    VoiceOff(0), DeltaTick(2),			/* 2 tick pause */
    VoiceOn(0, 500, VOICE_HIGH), DeltaTick(3),
    VoiceOff(0), DeltaTick(2),
    VoiceOn(0, 500, VOICE_HIGH), DeltaTick(3),
    VoiceOff(0),
    General(GE_END_OF_SONG)
};

static const word stdWarningBeep[] = {
    ChangePriority(SP_SYSTEM_LEVEL + SP_IMMEDIATE),
    ChangeEnvelope(0, IP_OBOE, IT_STANDARD_TABLE),
    DeltaTick(1),
    VoiceOn(0, 198, VOICE_HIGH), DeltaTick(15),
    VoiceOff(0),
    General(GE_END_OF_SONG)
};

static const word stdNotifyBeep[] = {
    ChangePriority(SP_SYSTEM_LEVEL),
    ChangeEnvelope(0, IP_TINKLE_BELL, IT_STANDARD_TABLE),
    DeltaTick(1),
    VoiceOn(0, 400, VOICE_HIGH), DeltaTick(5),	/* 5 tick beep */
    VoiceOff(0), DeltaTick(3),			/* 3 tick pause */
    VoiceOn(0, 400, VOICE_HIGH), DeltaTick(5),
    VoiceOff(0),
    General(GE_END_OF_SONG)
};

static const word stdNoInputBeep[] = {
    ChangePriority(SP_SYSTEM_LEVEL),
    ChangeEnvelope(0, IP_OVERDRIVEN_GUITAR, IT_STANDARD_TABLE),
    DeltaTick(1),
    VoiceOn(0, 800, VOICE_LOW), DeltaTick(1),	/* 1 tick beep */
    VoiceOff(0),				/* no pause */
    VoiceOn(0, 500, VOICE_HIGH), DeltaTick(1),
    VoiceOff(0),
    General(GE_END_OF_SONG)
};

static const word stdKeyClick[] = {
    ChangePriority(SP_SYSTEM_LEVEL + SP_THEME),
    ChangeEnvelope(0, IP_HI_MID_TOM, IT_STANDARD_TABLE),
    DeltaTick(1),
    VoiceOn(0, 400, VOICE_HIGH), DeltaTick(1),
    VoiceOff(0), DeltaTick(1),
    VoiceOn(0, 100, VOICE_HIGH), DeltaTick(1),
    VoiceOff(0),
    General(GE_END_OF_SONG)
};

#define ALARM_NOTE(f, t) \
    VoiceOn(0, f, VOICE_LOW), DeltaTick(t), VoiceOff(0), DeltaTick(2)

static const word stdAlarm[] = {
    ChangePriority(SP_SYSTEM_LEVEL + SP_IMMEDIATE),
    ChangeEnvelope(0, IP_FLUTE, IT_STANDARD_TABLE),
    DeltaTick(1),
    ALARM_NOTE(MIDDLE_A, 8), ALARM_NOTE(MIDDLE_G, 8), ALARM_NOTE(MIDDLE_F, 8),
    ALARM_NOTE(MIDDLE_A, 8), ALARM_NOTE(MIDDLE_G, 8), ALARM_NOTE(MIDDLE_F, 8),
    ALARM_NOTE(MIDDLE_A, 8), ALARM_NOTE(MIDDLE_G, 10),
    VoiceOn(0, MIDDLE_F, VOICE_LOW), DeltaTick(12),
    VoiceOff(0),
    General(GE_END_OF_SONG)
};

static const word stdNoHelpBeep[] = {
    ChangePriority(SP_SYSTEM_LEVEL),
    ChangeEnvelope(0, IP_OVERDRIVEN_GUITAR, IT_STANDARD_TABLE),
    DeltaTick(1),
    VoiceOn(0, 600, VOICE_LOW), DeltaTick(1),
    VoiceOff(0),
    VoiceOn(0, 400, VOICE_HIGH), DeltaTick(1),
    VoiceOff(0),
    General(GE_END_OF_SONG)
};

static const word *const standardSongs[NUM_STANDARD_SOUNDS] = {
    stdErrorBeep, stdWarningBeep, stdNotifyBeep, stdNoInputBeep,
    stdKeyClick, stdAlarm, stdNoHelpBeep
};

/* SetUpStandardSounds: a sound of one voice for each, the UI's */
static Boolean SetUpStandardSounds(void)
{
    word i;

    for (i = 0; i < NUM_STANDARD_SOUNDS; i++) {
	if (standardSoundHandles[i])
	    continue;
	if (S_AllocMusic(standardSongs[i], 1, &standardSoundHandles[i]) !=
	    SOUND_ERROR_NO_ERRORS) {
	    standardSoundHandles[i] = 0;
	    return FALSE;
	}
	S_ChangeOwnerSimple(standardSoundHandles[i],
			    (MemHandle) GeodeGetCodeProcessHandle());
    }
    return TRUE;
}

/* a song of the caller's, copied into a block of the UI that goes away
 * when it is played */
static void PlayCustomBuffer(const word *buffer, word size)
{
    MemHandle mh;
    byte *p;

    mh = MemAllocSetOwner(GeodeGetCodeProcessHandle(),
			  (word) (SOUND_CONTROL_SIZE(1) + size),
			  HF_SWAPABLE | HF_SHARABLE, HAF_LOCK);
    if (!mh)
	return;
    p = MemDeref(mh);
    memcpy(p + SOUND_CONTROL_SIZE(1), buffer, size);
    S_InitMusic(mh, 1);
    (void) S_PlayMusic(mh, STANDARD_PRIORITY, STANDARD_TEMPO,
		       UNLOCK_ON_EOS | DESTROY_ON_EOS);
}

/* PlayStandardSound */
static void PlayStandardSound(word type, va_list ap)
{
    switch (type) {
    case SST_CUSTOM_SOUND: {
	MemHandle mh = va_arg(ap, MemHandle);
	word tempo = (word) va_arg(ap, int);

	(void) S_PlayMusic(mh, SP_SYSTEM_LEVEL, tempo, UNLOCK_ON_EOS);
	break;
    }
    case SST_CUSTOM_NOTE: {
	word freq = (word) va_arg(ap, int);
	word ticks = (word) va_arg(ap, int);
	MemHandle mh;

	if (S_AllocMusicNote(IP_REED_ORGAN, IT_STANDARD_TABLE, freq,
			     DYNAMIC_MF, SSDTT_TICKS, ticks, &mh) ==
	    SOUND_ERROR_NO_ERRORS)
	    (void) S_PlayMusicNote(mh, STANDARD_PRIORITY, STANDARD_TEMPO,
				   UNLOCK_ON_EOS | DESTROY_ON_EOS);
	break;
    }
    case SST_CUSTOM_BUFFER: {
	const word *buffer = va_arg(ap, const word *);
	word size = (word) va_arg(ap, int);

	PlayCustomBuffer(buffer, size);
	break;
    }
    default:
	if (type >= NUM_STANDARD_SOUNDS || !SetUpStandardSounds())
	    break;
	(void) S_PlayMusic(standardSoundHandles[type],
			   STANDARD_PRIORITY + SP_IMMEDIATE, STANDARD_TEMPO,
			   UNLOCK_ON_EOS);
	break;
    }
}

word _cdecl UserStandardSound(StandardSoundType stype, ...)
{
    word type = (word) stype, count;
    va_list ap;

    if (!soundLib)
	return 0;
    if ((type & 0xff00) == SST_IGNORE_SOUND_OFF)
	type &= 0x00ff;			/* heard whatever the settings */
    else {
	if (!soundOn)
	    return 0;
	/* the custom sounds are not masked */
	if (type < NUM_STANDARD_SOUNDS && !(soundMask & (1 << type)))
	    return 0;
    }
    va_start(ap, stype);
    PlayStandardSound(type, ap);
    va_end(ap);
    if (type >= NUM_STANDARD_SOUNDS)
	return 0;
    count = standardSoundCounts[type];
    do
	count++;
    while (!count);
    standardSoundCounts[type] = count;
    return count;
}

void _pascal UserStopStandardSound(StandardSoundType stype, word countID)
{
    word type = (word) stype & 0x00ff;

    if (!countID || !soundLib || ((word) stype & 0x7f00) ||
	type >= NUM_STANDARD_SOUNDS)
	return;
    if (standardSoundCounts[type] == countID && standardSoundHandles[type])
	(void) S_StopMusic(standardSoundHandles[type]);
}

/* UserSoundExit: the UI ends */
void UserSoundExit(void)
{
    word i;

    if (!soundLib)
	return;
    for (i = 0; i < NUM_STANDARD_SOUNDS; i++)
	if (standardSoundHandles[i]) {
	    (void) S_StopMusic(standardSoundHandles[i]);
	    S_FreeMusic(standardSoundHandles[i]);
	    standardSoundHandles[i] = 0;
	}
    GeodeFreeLibrary(soundLib);
    soundLib = 0;
}

/* ------------------------------------------------------- UserClass */

/* UserUpdateSoundParams: "[ui] soundMask" and "[ui] sound" read again,
 * the library loaded */
@extern method UserClass, MSG_USER_UPDATE_SOUND_PARAMS
{
    Boolean on = TRUE;
    word mask = SOUND_MASK_ALL;

    if (InitFileReadInteger("ui", "soundMask", &mask))
	mask = SOUND_MASK_ALL;
    soundMask = mask;
    if (InitFileReadBoolean("ui", "sound", &on))
	on = TRUE;			/* no setting: sound */
    soundOn = on;
    if (!soundLib) {
	GeodeLoadError err;

	FilePushDir();
	FileSetStandardPath(SP_SYSTEM);
	soundLib = GeodeUseLibrary("sound.geo", 0, 0, &err);
	FilePopDir();
    }
}

/* UserFreeSoundHandle: a sound that ended (the sound library cannot
 * free it in its timer routine), freed as its type wants */
@extern method UserClass, MSG_USER_FREE_SOUND_HANDLE
{
    SoundControl *sc;
    word type;

    if (!sound || !soundLib)
	return;
    sc = MemLock(sound);
    if (!sc)
	return;
    type = sc->SC_status.SBS_type;
    MemUnlock(sound);
    switch (type) {
    case ST_SIMPLE_FM:
	S_FreeMusic(sound);
	break;
    case ST_STREAM_FM:
	S_FreeMusicStream(sound);
	break;
    case ST_STREAM_DAC:
	S_FreeSampleStream(sound);
	break;
    default:			/* ST_SIMPLE_DAC: never made */
	MemFree(sound);
	break;
    }
}
