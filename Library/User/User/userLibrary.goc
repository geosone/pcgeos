/*
 * userLibrary.goc -- the UI library's entry (after userLibrary.asm,
 * whose LibraryEntry is not assembled).
 *
 * Port32: until the UI's process starts the system (UserAttach in
 * userMain.asm), the library sets up the input map when it is loaded,
 * which the asm did first thing in UserAttach.  It also allocates the
 * geode private words of GenProcessClass (procClass.goc) and the block
 * of IACP's lists (a resource in the asm).
 */
@include "uiInt.goh"
#include <library.h>

/* IACP/iacpMain.goc: the block of IACP's lists */
extern Boolean IACPInit(void);
extern void IACPExit(void);

Boolean UILibraryEntry(LibraryCallType ty, GeodeHandle client)
{
    (void) client;
    switch (ty) {
    case LCT_ATTACH:
	UserSetDefaultInputMap();
	/* GenProcessClass's words in each process */
	genProcessPrivOffset = GeodePrivAlloc(GeodeGetCodeProcessHandle(),
					      GEN_PROCESS_PRIV_WORDS);
	/* the undo block's handle (userMain.asm's undoOffset) */
	genProcessUndoOffset = GeodePrivAlloc(GeodeGetCodeProcessHandle(),
					      UNDO_PRIV_WORDS);
	return !genProcessPrivOffset || !genProcessUndoOffset ||
	       !IACPInit();
    case LCT_DETACH:
	IACPExit();
	GeodePrivFree(genProcessUndoOffset, UNDO_PRIV_WORDS);
	GeodePrivFree(genProcessPrivOffset, GEN_PROCESS_PRIV_WORDS);
	break;
    default:
	break;
    }
    return FALSE;
}
