/*
 * userUtils.goc -- utility routines of the UI (after userUtils.asm):
 * object blocks for the UI, loading applications (UserLoadApplication,
 * PrepAppLaunchBlock, LoadApplication) and extended drivers
 * (UserLoadExtendedDriver).
 *
 * Port32:
 *  - an application without a field in its AppLaunchBlock goes on the
 *    system's default field; the asm asked the specific UI's system
 *    (MSG_SPEC_GUP_QUERY_VIS_PARENT, SQT_VIS_PARENT_FOR_APPLICATION),
 *    whose answer is that field;
 *  - the acknowledgement of a load (ALB_userLoadAckOutput, its message)
 *    takes the parameters of MSG_GEN_FIELD_RESTORE_APP_ACK: the geode,
 *    the error (0 when loaded), the caller's ID; it is sent when there
 *    is a message;
 *  - the log entries of the asm (LogWriteInitEntry) are not written.
 *  - Not yet: the default launcher replaced on a restart
 *    (DefaultLauncherCheck), multi-language paths.
 */
@include "uiInt.goh"
@include "userMacro.goh"
@include <Objects/gSysC.goh>
@include <Objects/gFieldC.goh>
@include <Internal/uProcC.goh>
#include <file.h>
#include <driver.h>
#include <geosdriver.h>
#include <initfile.h>
#include <string.h>
#include <system.h>
#include <win.h>
#include <Internal/im.h>
#include <library.h>
@include <Objects/gProcC.goh>
#include <sound.h>
#include <Internal/soundCtl.h>
#include <stdarg.h>
#include <stdint.h>
#include <Internal/grWinInt.h>

/* userStrings.asm */
static const char deskAccessoryPathname[] = "Desk Accessories";

/*
 * PrepAppLaunchBlock: the AppLaunchBlock for a launch (a new one for
 * 0), owned by the UI, with the flags, the mode (0: the block's, else
 * OPEN_APPLICATION), the file (unless NULL: the one in the block), the
 * current path when none is set, the field.  GLE_FIELD_DETACHING when
 * there is no field.
 */
GeodeLoadError PrepAppLaunchBlock(MemHandle *albp,
					 AppLaunchFlags alf,
					 Message attachMethod,
					 const char *filename,
					 DiskHandle disk, optr genParent)
{
    MemHandle alb = *albp;
    AppLaunchBlock *a;
    GeodeLoadError e = GLE_OK;

    if (!alb) {
	alb = MemAlloc(sizeof(AppLaunchBlock), HF_SHARABLE | HF_SWAPABLE,
		       HAF_ZERO_INIT);
	if (!alb)
	    return GLE_MEMORY_ALLOCATION_ERROR;
	*albp = alb;
    }
    HandleModifyOwner(alb, GeodeGetCodeProcessHandle());
    a = MemLock(alb);
    if (!a->ALB_genParent)
	a->ALB_genParent = genParent;
    if (alf)
	a->ALB_launchFlags = alf;
    if (attachMethod)
	a->ALB_appMode = attachMethod;
    if (!a->ALB_appMode)
	a->ALB_appMode = MSG_GEN_PROCESS_OPEN_APPLICATION;
    if (filename) {
	word n = 0;

	while (filename[n] && n < sizeof(a->ALB_appRef.AIR_fileName) - 1)
	    n++;
	memcpy(a->ALB_appRef.AIR_fileName, filename, n);
	a->ALB_appRef.AIR_fileName[n] = '\0';
	a->ALB_appRef.AIR_diskHandle = disk;
    }
    if (!a->ALB_diskHandle)
	a->ALB_diskHandle = FileGetCurrentPath(a->ALB_path,
					       sizeof(a->ALB_path));
    if (!a->ALB_genParent) {
	optr field = NullOptr;

	/* Port32: the default field (the specific UI's answer) */
	UserCallSystem(MSG_GEN_SYSTEM_GET_DEFAULT_FIELD, NULL, 0,
		       &field, sizeof(field));
	if (!field)
	    e = GLE_FIELD_DETACHING;
	a->ALB_genParent = field;
    }
    MemUnlock(alb);
    return e;
}

/*
 * SetDeskAccessoryFlag: ALF_DESK_ACCESSORY for an application in
 * WORLD/Desk Accessories, where the launch options allow them
 */
static void SetDeskAccessoryFlag(MemHandle alb)
{
    char cur[PATH_BUFFER_SIZE];
    DiskHandle disk;
    AppLaunchBlock *a;

    if (!(UserGetLaunchOptions() & UILO_DESK_ACCESSORIES))
	return;
    disk = FileGetCurrentPath(cur, sizeof(cur));
    if (FileComparePaths(cur, disk, deskAccessoryPathname,
			 SP_APPLICATION) != PCT_EQUAL)
	return;
    a = MemLock(alb);
    a->ALB_launchFlags |= ALF_DESK_ACCESSORY;
    MemUnlock(alb);
}

/*
 * LoadApplication: the field told (it may say no), the activation, the
 * path of the file, GeodeLoad; on an error the field told again; the
 * acknowledgement sent.  The block goes to the application.
 */
static GeodeHandle LoadApplication(MemHandle alb, const char *name,
				   Boolean ignoreFileNotFound,
				   GeodeLoadError *err)
{
    AppLaunchBlock *a = MemLock(alb);
    optr ackOD = a->ALB_userLoadAckOutput;
    Message ackMsg = a->ALB_userLoadAckMessage;
    word ackID = a->ALB_userLoadAckID;
    optr field = a->ALB_genParent;
    DiskHandle disk = a->ALB_appRef.AIR_diskHandle;
    GeodeHandle gh = 0;
    GeodeLoadError e = GLE_OK;
    const char *file = name, *p;

    MemUnlock(alb);
    if (@call field::MSG_GEN_FIELD_APP_STARTUP_NOTIFY())
	e = GLE_FIELD_DETACHING;
    else {
	char dir[PATH_BUFFER_SIZE];

	@call field::MSG_GEN_FIELD_ACTIVATE_INITIATE(alb);
	if (disk & DISK_IS_STD_PATH_MASK)
	    FileSetStandardPath((StandardPath) disk);
	for (p = name; *p; p++)
	    if (*p == '\\')
		file = p + 1;
	if (file != name) {
	    word n = (word) (file - name - 1);

	    if (n >= sizeof(dir))
		n = sizeof(dir) - 1;
	    memcpy(dir, name, n);
	    dir[n] = '\0';
	    if (!n)
		memcpy(dir, "\\", sizeof("\\"));
	    if (!FileSetCurrentPath(0, dir))
		e = (GeodeLoadError) ThreadGetError();
	}
	if (e == GLE_OK) {
	    SetDeskAccessoryFlag(alb);
	    gh = GeodeLoad(file, GA_PROCESS | GA_APPLICATION, 0,
			   PRIORITY_STANDARD, (dword) alb, &e);
	}
    }
    if (!gh) {
	if (e != GLE_FIELD_DETACHING) {
	    @call field::MSG_GEN_FIELD_APP_STARTUP_DONE();
	    if (!ignoreFileNotFound || e != GLE_FILE_NOT_FOUND)
		@call field::MSG_GEN_FIELD_ACTIVATE_DISMISS(0, alb);
	}
    } else
	e = GLE_OK;
    if (ackMsg && OptrToHandle(ackOD) &&
	(!ignoreFileNotFound || e != GLE_FILE_NOT_FOUND)) {
	struct { GeodeHandle geode; word error; word ackID; } ack;

	ack.geode = gh;
	ack.error = gh ? 0 : (word) e;	/* 0: loaded */
	ack.ackID = ackID;
	CObjMessageP(MF_FORCE_QUEUE, ackOD, ackMsg, &ack, sizeof(ack),
		     NULL, 0);
    }
    *err = e;
    return gh;
}

/*
 * UserLoadApplication: an application loaded with its AppLaunchBlock
 * (0 for a new one): the file as given (a full path, or a name in
 * SP_APPLICATION, then SP_SYS_APPLICATION, or the standard path), or
 * the block's (filename NULL).  ALF_SEND_LAUNCH_REQUEST_TO_UI_TO_HANDLE
 * leaves the load to the UI's process (0 returned).
 */
GeodeHandle UserLoadApplication(AppLaunchFlags alf, Message attachMethod,
				MemHandle appLaunchBlock, char *filename,
				StandardPath sPath, GeodeLoadError *err)
{
    MemHandle alb = appLaunchBlock;
    AppLaunchBlock *a;
    GeodeLoadError e;
    GeodeHandle gh = 0;
    char name[PATH_BUFFER_SIZE];
    DiskHandle disk;

    e = PrepAppLaunchBlock(&alb, alf, attachMethod, filename,
			   (DiskHandle) sPath, NullOptr);
    if (e != GLE_OK) {
	if (alb)
	    MemFree(alb);
	if (err)
	    *err = e;
	return 0;
    }
    a = MemLock(alb);
    if (a->ALB_launchFlags & ALF_NO_ACTIVATION_DIALOG)
	uiFlags |= UIF_INIT;
    if (a->ALB_launchFlags & ALF_SEND_LAUNCH_REQUEST_TO_UI_TO_HANDLE) {
	a->ALB_launchFlags &= ~ALF_SEND_LAUNCH_REQUEST_TO_UI_TO_HANDLE;
	MemUnlock(alb);
	@send ConstructOptr(GeodeGetCodeProcessHandle(), 0)::
	    MSG_USER_LAUNCH_APPLICATION(alb);
	uiFlags &= ~UIF_INIT;
	if (err)
	    *err = GLE_OK;
	return 0;
    }
    memcpy(name, a->ALB_appRef.AIR_fileName, sizeof(name));
    name[sizeof(name) - 1] = '\0';
    disk = a->ALB_appRef.AIR_diskHandle;
    MemUnlock(alb);

    FilePushDir();
    if (disk && !(disk & DISK_IS_STD_PATH_MASK)) {
	/* a disk: the name is a full path */
	FileSetCurrentPath(disk, "\\");
	gh = LoadApplication(alb, name, FALSE, &e);
    } else {
	e = GLE_FILE_NOT_FOUND;
	if (disk) {
	    gh = LoadApplication(alb, name, TRUE, &e);
	    if (!gh && e != GLE_FILE_NOT_FOUND)
		goto done;
	}
	if (!gh) {
	    a = MemLock(alb);
	    a->ALB_appRef.AIR_diskHandle = SP_APPLICATION;
	    MemUnlock(alb);
	    gh = LoadApplication(alb, name, TRUE, &e);
	}
	if (!gh && e == GLE_FILE_NOT_FOUND) {
	    a = MemLock(alb);
	    a->ALB_appRef.AIR_diskHandle = SP_SYS_APPLICATION;
	    MemUnlock(alb);
	    gh = LoadApplication(alb, name, FALSE, &e);
	}
    }
done:
    if (!gh)
	MemFree(alb);
    FilePopDir();
    uiFlags &= ~UIF_INIT;
    if (err)
	*err = e;
    return gh;
}

/*
 * UserLoadExtendedDriver: the driver of "driver" in the category, from
 * the standard path, with the device of "device" tested and set
 * (testAndSetBX in bx).  GLE_FILE_NOT_FOUND without a driver,
 * GLE_DRIVER_INIT_ERROR when the device is missing or not there.
 */
GeodeHandle UserLoadExtendedDriver(const char *category, StandardPath sp,
				   word protoMajor, word protoMinor,
				   word testAndSetBX, GeodeLoadError *err)
{
    char name[FILE_LONGNAME_BUFFER_SIZE], device[128];
    word n;
    GeodeHandle gh;
    DriverInfoStruct *dis;
    DriverRegs r;

    if (InitFileReadStringBuffer(category, "driver", name, sizeof(name),
				 &n) || !n) {
	*err = GLE_FILE_NOT_FOUND;
	return 0;
    }
    FilePushDir();
    FileSetStandardPath(sp);
    gh = GeodeUseDriver(name, protoMajor, protoMinor, err);
    FilePopDir();
    if (!gh)
	return 0;
    dis = GeodeInfoDriver(gh);
    if (InitFileReadStringBuffer(category, "device", device, sizeof(device),
				 &n))
	goto cannotInit;
    memset(&r, 0, sizeof(r));
    r.DR_dsSi = device;
    r.DR_bx = testAndSetBX;
    if (DriverCall(dis, DRE_TEST_DEVICE, &r) ||
	(word) r.DR_ax == (word) DP_NOT_PRESENT)
	goto cannotInit;
    memset(&r, 0, sizeof(r));
    r.DR_dsSi = device;
    r.DR_bx = testAndSetBX;
    (void) DriverCall(dis, DRE_SET_DEVICE, &r);
    *err = GLE_OK;
    return gh;

cannotInit:
    GeodeFreeDriver(gh);
    *err = GLE_DRIVER_INIT_ERROR;
    return 0;
}

/* ---------------------------------------------------------------------
 * Keys that are shortcuts, not text (userUtils.asm)
 * ------------------------------------------------------------------- */

/* UserCheckAcceleratorChar: a key that may be a shortcut rather than
 * text: with Ctrl or Alt, a UI function, a control key (but Tab,
 * Enter, Ctrl-L and Backspace) */
Boolean UserCheckAcceleratorChar(word character, word flags, word state)
{
    byte cs = character >> 8, ch = character & 0xff, ss = flags >> 8;

    (void) state;
    if (cs == CS_UI_FUNCS)
	return TRUE;
    if (flags & CF_TEMP_ACCENT)
	return FALSE;
    if (ss & (SS_LCTRL | SS_RCTRL))
	return !(ss & (SS_LALT | SS_RALT)) || cs == CS_CONTROL;
    if (ss & (SS_LALT | SS_RALT))
	return TRUE;
    return cs == CS_CONTROL && ch != VC_TAB && ch != VC_ENTER &&
	   ch != VC_CTRL_L && ch != VC_BACKSPACE;
}

/* UserCheckInsertableCtrlChar: a key of the keypad that is text */
Boolean UserCheckInsertableCtrlChar(word character, word flags, word state)
{
    byte ch = character & 0xff;

    if ((character >> 8) != CS_CONTROL ||
	((flags >> 8) & (SS_LCTRL | SS_RCTRL)))
	return FALSE;
    if ((ch >= '*' && ch <= '-') || ch == '/')
	return TRUE;
    return (state & TS_NUMLOCK) && !(flags & CF_EXTENDED) &&
	   ch >= '.' && ch <= '9';
}

UIInterfaceLevel UserGetDefaultUILevel(void)
{
    return uiInterfaceLevel;
}

UIInterfaceLevel UserGetDefaultLaunchLevel(void)
{
    return uiDefaultLaunchLevel;
}

UILaunchModel UserGetLaunchModel(void)
{
    return uiLaunchModel;
}

UILaunchOptions UserGetLaunchOptions(void)
{
    return uiLaunchOptions;
}

UIInterfaceOptions UserGetInterfaceOptions(void)
{
    return uiInterfaceOptions;
}

/* UserGetDisplayType: the DisplayType in the high byte, TRUE in the low
 * byte once a screen set it */
word UserGetDisplayType(void)
{
    return (word) (((word) uiDisplayType << 8) |
		   ((uiFlags & UIF_HAVE_DISPLAY_TYPE) ? 0xff : 0));
}

/* UserSendToApplicationViaProcess: the message recorded for the
 * application object, dispatched by the process from its queue */
void UserSendToApplicationViaProcess(Message msg, const void *params,
				     word paramSize)
{
    EventHandle ev = 0;
    optr proc = ConstructOptr(GeodeGetProcessHandle(), 0);

    CObjMessageP(MF_RECORD, GeodeGetAppObject(0), msg, params, paramSize,
		 &ev, sizeof(ev));
    @send, forceQueue proc::MSG_META_DISPATCH_EVENT(ev, MF_FORCE_QUEUE);
}

/* UserGetKbdAcceleratorMode: [ui] kbdAcceleratorMode, on by default
 * (the asm read it once when the UI attached) */
Boolean UserGetKbdAcceleratorMode(void)
{
    Boolean on;

    if (InitFileReadBoolean("ui", "kbdAcceleratorMode", &on))
	return TRUE;
    return on;
}
/* UserGetOverstrikeMode: overstrike mode allowed */
Boolean UserGetOverstrikeMode(void)
{
    return uiOverstrikeMode != 0;
}

/* UserSetOverstrikeMode: allowed or not, kept in [ui] overstrikeMode */
void UserSetOverstrikeMode(Boolean on)
{
    uiOverstrikeMode = on ? (byte) -1 : 0;
    InitFileWriteBoolean("ui", "overstrikeMode", on ? TRUE : FALSE);
}

/* UserCallApplication: the message to the application object of the
 * current process (FALSE if there is none) */
Boolean UserCallApplication(Message msg, const void *params,
			    word paramSize, void *reply, word replySize)
{
    optr app = GeodeGetAppObject(0);

    if (replySize)
	memset(reply, 0, replySize);
    if (!app)
	return FALSE;
    CObjMessageP(MF_CALL, app, msg, (void *) params, paramSize, reply,
		 replySize);
    return TRUE;
}

/*
 * The sounds of the UI.  The UI does not import the sound library: it
 * loads sound.geo from SYSTEM when it attaches
 * (MSG_USER_UPDATE_SOUND_PARAMS, userMain.goc) and calls its routines by
 * entry number (Library/Sound/sound32.gp).  "[ui] sound" (default true)
 * turns the sounds on and off, "[ui] soundMask" each standard sound
 * (StandardSoundFlags, a bit per StandardSoundType).
 *
 * Port32:
 *  - the library stays loaded while "[ui] sound" is false (the asm freed
 *    it), so that a sound with SST_IGNORE_SOUND_OFF is heard then too;
 *    the asm went on to call the library it had not loaded;
 *  - UserStandardSound is a C routine (ui.goh), the asm's register
 *    routine and its C stub (_UserStandardSound) in one;
 *  - UserStopStandardSound ignores the type SST_IGNORE_SOUND_OFF + 7 too
 *    (the asm let it index past its table);
 *  - the standard sounds are songs of the UI's data, not resources;
 *  - the UI frees them and the library when it ends (UserSoundExit, a
 *    Port32 routine): the kernel does not free what a geode used while
 *    it ran.
 */
GeodeHandle uiSoundLib;
Boolean uiSoundOn;
MemHandle uiStandardSoundHandles[NUM_STANDARD_SOUNDS];

#define S_StopMusic		SND(5, SoundStopMusic)

#define STANDARD_TEMPO		8
#define STANDARD_PRIORITY	SP_SYSTEM_LEVEL
#define VOICE_HIGH		DYNAMIC_FFFF
#define VOICE_LOW		DYNAMIC_FFF
#define ChangePriority(p)	General(GE_SET_PRIORITY), (p)
static word standardSoundCounts[NUM_STANDARD_SOUNDS];
#define S_AllocMusic		SND(3, SoundAllocMusic)
#define S_PlayMusic		SND(4, SoundPlayMusic)
#define S_InitMusic		SND(8, SoundInitMusic)
#define S_AllocMusicNote	SND(9, SoundAllocMusicNote)
#define S_PlayMusicNote		SND(10, SoundPlayMusicNote)
#define S_ChangeOwnerSimple	SND(18, SoundChangeOwnerSimple)
static const word stdErrorBeep[] = {
    ChangePriority(SP_SYSTEM_LEVEL + SP_IMMEDIATE),
    ChangeEnvelope(0, IP_TROMBONE, IT_STANDARD_TABLE),
    DeltaTick(1),
    VoiceOn(0, 500, VOICE_HIGH), DeltaTick(3),	/* 3 tick beep */
    VoiceOff(0), DeltaTick(2),			/* 2 tick pause */
    VoiceOn(0, 500, VOICE_HIGH), DeltaTick(3),
    VoiceOff(0), DeltaTick(2),
    VoiceOn(0, 500, VOICE_HIGH), DeltaTick(3),
    VoiceOff(0),
    General(GE_END_OF_SONG)
};

static const word stdWarningBeep[] = {
    ChangePriority(SP_SYSTEM_LEVEL + SP_IMMEDIATE),
    ChangeEnvelope(0, IP_OBOE, IT_STANDARD_TABLE),
    DeltaTick(1),
    VoiceOn(0, 198, VOICE_HIGH), DeltaTick(15),
    VoiceOff(0),
    General(GE_END_OF_SONG)
};

static const word stdNotifyBeep[] = {
    ChangePriority(SP_SYSTEM_LEVEL),
    ChangeEnvelope(0, IP_TINKLE_BELL, IT_STANDARD_TABLE),
    DeltaTick(1),
    VoiceOn(0, 400, VOICE_HIGH), DeltaTick(5),	/* 5 tick beep */
    VoiceOff(0), DeltaTick(3),			/* 3 tick pause */
    VoiceOn(0, 400, VOICE_HIGH), DeltaTick(5),
    VoiceOff(0),
    General(GE_END_OF_SONG)
};

static const word stdNoInputBeep[] = {
    ChangePriority(SP_SYSTEM_LEVEL),
    ChangeEnvelope(0, IP_OVERDRIVEN_GUITAR, IT_STANDARD_TABLE),
    DeltaTick(1),
    VoiceOn(0, 800, VOICE_LOW), DeltaTick(1),	/* 1 tick beep */
    VoiceOff(0),				/* no pause */
    VoiceOn(0, 500, VOICE_HIGH), DeltaTick(1),
    VoiceOff(0),
    General(GE_END_OF_SONG)
};

static const word stdKeyClick[] = {
    ChangePriority(SP_SYSTEM_LEVEL + SP_THEME),
    ChangeEnvelope(0, IP_HI_MID_TOM, IT_STANDARD_TABLE),
    DeltaTick(1),
    VoiceOn(0, 400, VOICE_HIGH), DeltaTick(1),
    VoiceOff(0), DeltaTick(1),
    VoiceOn(0, 100, VOICE_HIGH), DeltaTick(1),
    VoiceOff(0),
    General(GE_END_OF_SONG)
};
#define ALARM_NOTE(f, t) \
    VoiceOn(0, f, VOICE_LOW), DeltaTick(t), VoiceOff(0), DeltaTick(2)

static const word stdAlarm[] = {
    ChangePriority(SP_SYSTEM_LEVEL + SP_IMMEDIATE),
    ChangeEnvelope(0, IP_FLUTE, IT_STANDARD_TABLE),
    DeltaTick(1),
    ALARM_NOTE(MIDDLE_A, 8), ALARM_NOTE(MIDDLE_G, 8), ALARM_NOTE(MIDDLE_F, 8),
    ALARM_NOTE(MIDDLE_A, 8), ALARM_NOTE(MIDDLE_G, 8), ALARM_NOTE(MIDDLE_F, 8),
    ALARM_NOTE(MIDDLE_A, 8), ALARM_NOTE(MIDDLE_G, 10),
    VoiceOn(0, MIDDLE_F, VOICE_LOW), DeltaTick(12),
    VoiceOff(0),
    General(GE_END_OF_SONG)
};

static const word stdNoHelpBeep[] = {
    ChangePriority(SP_SYSTEM_LEVEL),
    ChangeEnvelope(0, IP_OVERDRIVEN_GUITAR, IT_STANDARD_TABLE),
    DeltaTick(1),
    VoiceOn(0, 600, VOICE_LOW), DeltaTick(1),
    VoiceOff(0),
    VoiceOn(0, 400, VOICE_HIGH), DeltaTick(1),
    VoiceOff(0),
    General(GE_END_OF_SONG)
};

static const word *const standardSongs[NUM_STANDARD_SOUNDS] = {
    stdErrorBeep, stdWarningBeep, stdNotifyBeep, stdNoInputBeep,
    stdKeyClick, stdAlarm, stdNoHelpBeep
};

/* SetUpStandardSounds: a sound of one voice for each, the UI's */
static Boolean SetUpStandardSounds(void)
{
    word i;

    for (i = 0; i < NUM_STANDARD_SOUNDS; i++) {
	if (uiStandardSoundHandles[i])
	    continue;
	if (S_AllocMusic(standardSongs[i], 1, &uiStandardSoundHandles[i]) !=
	    SOUND_ERROR_NO_ERRORS) {
	    uiStandardSoundHandles[i] = 0;
	    return FALSE;
	}
	S_ChangeOwnerSimple(uiStandardSoundHandles[i],
			    (MemHandle) GeodeGetCodeProcessHandle());
    }
    return TRUE;
}

/* a song of the caller's, copied into a block of the UI that goes away
 * when it is played */
static void PlayCustomBuffer(const word *buffer, word size)
{
    MemHandle mh;
    byte *p;

    mh = MemAllocSetOwner(GeodeGetCodeProcessHandle(),
			  (word) (SOUND_CONTROL_SIZE(1) + size),
			  HF_SWAPABLE | HF_SHARABLE, HAF_LOCK);
    if (!mh)
	return;
    p = MemDeref(mh);
    memcpy(p + SOUND_CONTROL_SIZE(1), buffer, size);
    S_InitMusic(mh, 1);
    (void) S_PlayMusic(mh, STANDARD_PRIORITY, STANDARD_TEMPO,
		       UNLOCK_ON_EOS | DESTROY_ON_EOS);
}

/* PlayStandardSound */
static void PlayStandardSound(word type, va_list ap)
{
    switch (type) {
    case SST_CUSTOM_SOUND: {
	MemHandle mh = va_arg(ap, MemHandle);
	word tempo = (word) va_arg(ap, int);

	(void) S_PlayMusic(mh, SP_SYSTEM_LEVEL, tempo, UNLOCK_ON_EOS);
	break;
    }
    case SST_CUSTOM_NOTE: {
	word freq = (word) va_arg(ap, int);
	word ticks = (word) va_arg(ap, int);
	MemHandle mh;

	if (S_AllocMusicNote(IP_REED_ORGAN, IT_STANDARD_TABLE, freq,
			     DYNAMIC_MF, SSDTT_TICKS, ticks, &mh) ==
	    SOUND_ERROR_NO_ERRORS)
	    (void) S_PlayMusicNote(mh, STANDARD_PRIORITY, STANDARD_TEMPO,
				   UNLOCK_ON_EOS | DESTROY_ON_EOS);
	break;
    }
    case SST_CUSTOM_BUFFER: {
	const word *buffer = va_arg(ap, const word *);
	word size = (word) va_arg(ap, int);

	PlayCustomBuffer(buffer, size);
	break;
    }
    default:
	if (type >= NUM_STANDARD_SOUNDS || !SetUpStandardSounds())
	    break;
	(void) S_PlayMusic(uiStandardSoundHandles[type],
			   STANDARD_PRIORITY + SP_IMMEDIATE, STANDARD_TEMPO,
			   UNLOCK_ON_EOS);
	break;
    }
}

word _cdecl UserStandardSound(StandardSoundType stype, ...)
{
    word type = (word) stype, count;
    va_list ap;

    if (!uiSoundLib)
	return 0;
    if ((type & 0xff00) == SST_IGNORE_SOUND_OFF)
	type &= 0x00ff;			/* heard whatever the settings */
    else {
	if (!uiSoundOn)
	    return 0;
	/* the custom sounds are not masked */
	if (type < NUM_STANDARD_SOUNDS && !(soundMask & (1 << type)))
	    return 0;
    }
    va_start(ap, stype);
    PlayStandardSound(type, ap);
    va_end(ap);
    if (type >= NUM_STANDARD_SOUNDS)
	return 0;
    count = standardSoundCounts[type];
    do
	count++;
    while (!count);
    standardSoundCounts[type] = count;
    return count;
}

void _pascal UserStopStandardSound(StandardSoundType stype, word countID)
{
    word type = (word) stype & 0x00ff;

    if (!countID || !uiSoundLib || ((word) stype & 0x7f00) ||
	type >= NUM_STANDARD_SOUNDS)
	return;
    if (standardSoundCounts[type] == countID && uiStandardSoundHandles[type])
	(void) S_StopMusic(uiStandardSoundHandles[type]);
}

/* UserLimitDisplayTypeToStandard: no larger than standard, not
 * squished (the monikers for bigger displays are scaled) */
DisplayType UserLimitDisplayTypeToStandard(DisplayType t)
{
    if (((t & DT_DISP_SIZE) >> DT_DISP_SIZE_OFFSET) > DS_STANDARD)
	t = (DisplayType) ((t & ~DT_DISP_SIZE) |
			   (DS_STANDARD << DT_DISP_SIZE_OFFSET));
    if (((t & DT_DISP_ASPECT_RATIO) >> DT_DISP_ASPECT_RATIO_OFFSET) ==
	DAR_SQUISHED)
	t = (DisplayType) ((t & ~DT_DISP_ASPECT_RATIO) |
			   (DAR_NORMAL << DT_DISP_ASPECT_RATIO_OFFSET));
    return t;
}

void UserSetDefaultMonikerFont(FontID id, word pointSize)
{
    uiDefaultMonikerFont = id;
    uiDefaultMonikerPointSize = pointSize;
}

/* UserGetDefaultMonikerFont: the UI's moniker font (the asm asked for an
 * object; every object has the same) */
void UserGetDefaultMonikerFont(FontID *id, word *pointSize)
{
    *id = uiDefaultMonikerFont;
    *pointSize = uiDefaultMonikerPointSize;
}

#define NUM_STANDARD_SOUNDS	7

/* UserSoundExit: the UI ends */
void UserSoundExit(void)
{
    word i;

    if (!uiSoundLib)
	return;
    for (i = 0; i < NUM_STANDARD_SOUNDS; i++)
	if (uiStandardSoundHandles[i]) {
	    (void) S_StopMusic(uiStandardSoundHandles[i]);
	    S_FreeMusic(uiStandardSoundHandles[i]);
	    uiStandardSoundHandles[i] = 0;
	}
    GeodeFreeLibrary(uiSoundLib);
    uiSoundLib = 0;
}
