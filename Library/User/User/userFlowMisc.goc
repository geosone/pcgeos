/*
 * userFlowMisc.goc -- small Flow routines (after userFlowMisc.asm).
 */
@include "uiInt.goh"
#include <string.h>
#include <driver.h>
#include <geosdriver.h>
#include <Internal/kbdDr.h>

/*
 * FlowTranslatePassiveButton: MSG_META_PRE_PASSIVE_BUTTON or
 * MSG_META_POST_PASSIVE_BUTTON as the passive message of the button
 * function that is active (inputState: ButtonInfo, and
 * UIFunctionsActive in the high byte): MSG_META_PRE_PASSIVE_START_SELECT
 * and so on, the END message for a release.
 */
Message FlowTranslatePassiveButton(Message msg, word inputState)
{
    byte active = (byte) (inputState >> 8);
    Message m = msg == MSG_META_PRE_PASSIVE_BUTTON
		? MSG_META_PRE_PASSIVE_START_SELECT - MSG_META_START_SELECT
		: MSG_META_POST_PASSIVE_START_SELECT - MSG_META_START_SELECT;

    if (active & UIFA_SELECT)
	m += MSG_META_START_SELECT;
    else if (active & UIFA_MOVE_COPY)
	m += MSG_META_START_MOVE_COPY;
    else if (active & UIFA_FEATURES)
	m += MSG_META_START_FEATURES;
    else
	m += MSG_META_START_OTHER;
    if (!(inputState & BI_PRESS))
	m++;				/* the END message */
    return m;
}

/*
 * FlowCheckKbdShortcut: is the key press (as MSG_META_KBD_CHAR has it)
 * one of the shortcuts of the table?  The keyboard driver knows which
 * characters are on which key (DR_KBD_CHECK_SHORTCUT).  The offset of
 * the entry in the table, or -1.
 */
word FlowCheckKbdShortcut(KeyboardShortcut *shortcutTable,
			  word numEntriesInTable, word character, word flags,
			  word state)
{
    GeodeHandle drv = GeodeGetDefaultDriver(GDDT_KEYBOARD);
    DriverInfoStruct *dis = drv ? GeodeInfoDriver(drv) : NULL;
    DriverRegs r;

    if (!dis || !dis->DIS_strategy) {
	/* no keyboard driver (a test): the plain match by character set,
	 * character and the modifiers held (Shift only for the control
	 * set: a printable character took it already); a KS_PHYSICAL
	 * entry matches only a key of the control set (a function key,
	 * one key whatever the layout) */
	word shift = flags >> 8, want, i;

	if ((character >> 8) == CS_UI_FUNCS)
	    return (word) -1;
	want = (word) ((((character >> 8) & 0x0f) << 8) | (character & 0xff));
	if (shift & (SS_LCTRL | SS_RCTRL))
	    want |= KS_CTRL;
	if (shift & (SS_LALT | SS_RALT))
	    want |= KS_ALT;
	if ((shift & (SS_LSHIFT | SS_RSHIFT)) &&
	    (character >> 8) == CS_CONTROL)
	    want |= KS_SHIFT;
	(void) state;
	for (i = 0; i < numEntriesInTable; i++)
	    if (shortcutTable[i] == want ||
		((character >> 8) == CS_CONTROL &&
		 shortcutTable[i] == (want | KS_PHYSICAL)))
		return (word) (i * sizeof(KeyboardShortcut));
	return (word) -1;
    }
    memset(&r, 0, sizeof(r));
    r.DR_ax = numEntriesInTable;
    r.DR_cx = character;
    r.DR_dx = flags;
    r.DR_bp = state;
    r.DR_dsSi = shortcutTable;
    if (!((DriverStrategy *) (void *) dis->DIS_strategy)(
	    DR_KBD_CHECK_SHORTCUT, &r))
	return (word) -1;
    return (word) r.DR_si;
}

/* FlowGetUIButtonFlags: the UIButtonFlags of the input map */
UIButtonFlags FlowGetUIButtonFlags(void)
{
    return uiButtonFlags;
}
