#define DEFAULT_FLAGS	(UIBF_CLICK_TO_TYPE | UIBF_SELECT_ALWAYS_RAISES | \
			 UIBF_BLINKING_CURSOR)
#define MAP(t)		{ t, sizeof(t) / sizeof(t[0]), SS_LSHIFT, \
			  SS_RSHIFT, DEFAULT_FLAGS }

/* inputMapTable: by the number of buttons */
static const InputMapHeader inputMapTable[] = {
    MAP(oneButtonMap), MAP(twoButtonMap), MAP(threeButtonMap)
};

#define DEFAULT_NUM_BUTTONS	3

static const char inputCategoryStr[] = "input";

/* the mouse driver's information, if there is one */
static const MouseDriverInfo *MouseInfo(void)
{
    GeodeHandle drv = GeodeGetDefaultDriver(GDDT_MOUSE);

    return drv ? (const MouseDriverInfo *) GeodeInfoDriver(drv) : NULL;
}

/* CheckNumMouseButtons: the map for numberOfMouseButtons, else for the
 * mouse driver's buttons */
static const InputMapHeader *CheckNumMouseButtons(void)
{
    word n;

    if (InitFileReadInteger(inputCategoryStr, "numberOfMouseButtons", &n)) {
	const MouseDriverInfo *mi = MouseInfo();
	n = mi ? mi->MDI_numButtons : DEFAULT_NUM_BUTTONS;
    }
    if (n < 1 || n > sizeof(inputMapTable) / sizeof(inputMapTable[0]))
	n = DEFAULT_NUM_BUTTONS;
    return &inputMapTable[n - 1];
}

/* CheckKey: the flag into in or out by the key's boolean; FALSE if the
 * key is not there */
static Boolean CheckKey(const char *key, UIButtonFlags flag,
			UIButtonFlags *in, UIButtonFlags *out)
{
    Boolean b;

    if (InitFileReadBoolean(inputCategoryStr, key, &b))
	return FALSE;
    if (b)
	*in |= flag;
    else
	*out |= flag;
    return TRUE;
}

/* SetDefaultInputMap */
void UserSetDefaultInputMap(void)
{
    UIButtonFlags in = 0, out = 0;
    const InputMapHeader *map = CheckNumMouseButtons();
    Boolean b;

    CheckKey("clickToType", UIBF_CLICK_TO_TYPE, &in, &out);
    CheckKey("selectRaises", UIBF_SELECT_ALWAYS_RAISES, &in, &out);
    CheckKey("selectDisplaysMenu", UIBF_SELECT_DISPLAYS_MENU, &in, &out);
    CheckKey("clickGoesThrough", UIBF_CLICK_GOES_THRU, &in, &out);
    CheckKey("specificUICompatible", UIBF_SPECIFIC_UI_COMPATIBLE, &in,
	     &out);
    CheckKey("blinkingCursor", UIBF_BLINKING_CURSOR, &in, &out);
    if (!CheckKey("keyboardOnly", UIBF_KEYBOARD_ONLY, &in, &out) &&
	!SysGetPenMode()) {
	/* keyboard only without a mouse driver, or if it says so */
	const MouseDriverInfo *mi = MouseInfo();
	if (!mi || (mi->MDI_flags & MDIF_KEYBOARD_ONLY))
	    in |= UIBF_KEYBOARD_ONLY;
    }
    CheckKey("noKeyboard", UIBF_NO_KEYBOARD, &in, &out);

    if (InitFileReadBoolean(inputCategoryStr, "floatingKbd", &b))
	b = FALSE;
    uiFloatingKbdEnabled = b;

    uiInputMap = *map;
    uiInputMap.IMH_flags = (UIButtonFlags) ((map->IMH_flags | in) & ~out);
    uiButtonFlags = uiInputMap.IMH_flags;
}


/* ---------------------------------------------------------------------
 * UserClass, the UI's process
 * ------------------------------------------------------------------- */

@classdecl UserClass, neverSaved;


optr uiFlowObj;

/* UserCallFlow's object (Port32) */
optr UserGetFlowObject(void)
{
    return uiFlowObj;
}

static word uiAckID;
static optr uiAckOD;

static optr Self(void)
{
    return ConstructOptr(GeodeGetProcessHandle(), 0);
}

/* the system's UI (BootLoadUI), not a library of another geode */
static Boolean SystemUI(void)
{
    return (GeodeHandle) SysGetInfo(SGIT_UI_PROCESS) ==
	GeodeGetProcessHandle();
}

/* UserAttach: the system started */
@method UserClass, MSG_META_ATTACH_PROCESS
{
    MemHandle block, alb = 0;
    optr screen = NullOptr;
    struct { word value1, value2; } p;

    (void) value1;
    (void) value2;
    if (!SystemUI()) {
	/* Port32: a library only; the process ends */
	@send, forceQueue Self()::MSG_META_DETACH(0, NullOptr);
	return;
    }
    uiFlags |= UIF_INIT;
    uiFlags &= ~(UIF_DETACHING_SYSTEM | UIF_DETACHING_APP);
    /* between "focus" and "high" */
    ThreadModify(0, PRIORITY_HIGH + (PRIORITY_FOCUS - PRIORITY_HIGH) / 2,
		 TMF_BASE_PRIO);

    /* the flow object, for the user's input */
    block = UserAllocObjBlock(0);
    uiFlowObj = ObjInstantiate(block, (ClassStruct *) &FlowClass);
    ImGrabInput(uiFlowObj);
    WinGrabChange(0, uiFlowObj);

    /* the specific UI and the system object */
    FileSetStandardPath(SP_SYSTEM);
    UserCreateSystemObject(block);

    UserMakeScreens(block);
    UserSetDefaultInputMap();

    /* the UI as an application, below the default screen */
    UserCallSystem(MSG_GEN_SYSTEM_GET_DEFAULT_SCREEN, NULL, 0,
		   &screen, sizeof(screen));
    (void) PrepAppLaunchBlock(&alb, 0, MSG_GEN_PROCESS_RESTORE_FROM_STATE,
			      "ui", SP_SYSTEM, screen);
    p.value1 = (word) ((dword) alb >> 16);
    p.value2 = (word) alb;
    CObjCallSuperP((ClassStruct *) &UserClass, oself,
		   MSG_META_ATTACH_PROCESS, &p, sizeof(p), NULL, 0);
    uiFlags &= ~UIF_INIT;
}

/* UserOpenApplication: the UI's own field, then the rest of the start */
@method UserClass, MSG_GEN_PROCESS_OPEN_APPLICATION
{
    optr screen = NullOptr, field;
    GenFieldInstance *g;

    @callsuper();
    UserCallSystem(MSG_GEN_SYSTEM_GET_DEFAULT_SCREEN, NULL, 0,
		   &screen, sizeof(screen));
    field = ObjInstantiate(OptrToHandle(UserGetSystemObject()),
			   (ClassStruct *) &GenFieldClass);
    @call field::MSG_META_ATTACH();
    ObjLockObjBlock(OptrToHandle(field));
    g = (GenFieldInstance *) ObjDerefGen(field);
    g->GFI_notificationDestination = Self();
    MemUnlock(OptrToHandle(field));
    @call field::MSG_GEN_FIELD_SET_VIS_PARENT(screen);
    @call field::MSG_GEN_SET_USABLE(VUM_NOW);
    @call field::MSG_GEN_BRING_TO_TOP();
    UserCallSystem(MSG_GEN_SYSTEM_SET_DEFAULT_FIELD, &field, sizeof(field),
		   NULL, 0);
    @call Self()::MSG_USER_CONTINUE_STARTUP();
}

/* ShowDefaultPtr: the default video driver shows the pointer */
static void ShowDefaultPtr(void)
{
    GeodeHandle vid = GeodeGetDefaultDriver(GDDT_VIDEO);
    DriverRegs r;

    if (!vid)
	return;
    memset(&r, 0, sizeof(r));
    (void) DriverCall(GeodeInfoDriver(vid), DR_VID_SHOWPTR, &r);
}

/* LoadMouseDriver: "[mouse]" unless there is a mouse driver, then
 * "[secondMouse]" */
static void LoadMouseDriver(void)
{
    GeodeHandle gh;
    GeodeLoadError e;

    if (!GeodeGetDefaultDriver(GDDT_MOUSE)) {
	gh = UserLoadExtendedDriver("mouse", SP_MOUSE_DRIVERS,
				    MOUSE_PROTO_MAJOR, MOUSE_PROTO_MINOR, 0,
				    &e);
	if (gh) {
	    GeodeSetDefaultDriver(GDDT_MOUSE, gh);
	    ShowDefaultPtr();
	}
    }
    (void) UserLoadExtendedDriver("secondMouse", SP_MOUSE_DRIVERS,
				  MOUSE_PROTO_MAJOR, MOUSE_PROTO_MINOR, 0, &e);
}

/* UserContinueStartup: the mouse, the input map again, the state files
 * left alone (none) */
@method UserClass, MSG_USER_CONTINUE_STARTUP
{
    LoadMouseDriver();
    UserSetDefaultInputMap();
    @call Self()::MSG_USER_DELETE_STATE_FILES_DIALOG_RESPONSE(IC_YES);
}

/* UserDeleteStateFilesDialogResponse: Port32 has no state files; the
 * system fields, the applications to start */
@method UserClass, MSG_USER_DELETE_STATE_FILES_DIALOG_RESPONSE
{
    (void) response;
    UserMakeScreenFields();
    (void) @call Self()::MSG_USER_STARTUP_APPLS(0);
}

typedef struct {
    AppLaunchFlags	SAD_flags;
    word		SAD_extraData;
    Boolean		SAD_shutdown;
} StartupApplsData;

/* LoadApplicationWithErrorMessage: Port32 shows no error yet */
static Boolean StartupApplsCB(const char *name, word sectionNum,
			      void *data)
{
    StartupApplsData *d = data;
    MemHandle alb;
    AppLaunchBlock *a;
    GeodeLoadError e;

    (void) sectionNum;
    alb = MemAlloc(sizeof(AppLaunchBlock), HF_SHARABLE | HF_SWAPABLE,
		   HAF_ZERO_INIT);
    if (!alb)
	return FALSE;
    a = MemLock(alb);
    a->ALB_extraData = d->SAD_extraData;
    MemUnlock(alb);
    (void) UserLoadApplication(d->SAD_flags,
			       MSG_GEN_PROCESS_OPEN_APPLICATION, alb,
			       (char *) name, 0, &e);
    return FALSE;
}

/* StartupAppls: "[ui] execOnStartup", then "execOnStartupBG" in the
 * back */
@method UserClass, MSG_USER_STARTUP_APPLS
{
    StartupApplsData d;

    d.SAD_extraData = extraData;
    d.SAD_shutdown = FALSE;
    d.SAD_flags = ALF_NO_ACTIVATION_DIALOG;
    InitFileEnumStringSection("ui", "execOnStartup", IFRF_READ_ALL,
			      StartupApplsCB, &d);
    d.SAD_flags = ALF_NO_ACTIVATION_DIALOG | ALF_OPEN_IN_BACK |
		  ALF_DO_NOT_OPEN_ON_TOP;
    InitFileEnumStringSection("ui", "execOnStartupBG", IFRF_READ_ALL,
			      StartupApplsCB, &d);
    return d.SAD_shutdown;
}

/* UserLaunchApplication: a launch left to the UI */
@method UserClass, MSG_USER_LAUNCH_APPLICATION
{
    GeodeLoadError e;

    (void) UserLoadApplication(0, 0, appLaunchBlock, NULL, 0, &e);
}

/*
 * UserDetach: the first detach detaches the system object (its ack
 * comes to UserAck); the system's detach of the UI as an application
 * goes to GenProcessClass; others are acked
 */
@method UserClass, MSG_META_DETACH
{
    optr self = Self();

    if (!SystemUI()) {
	/* Port32: a library only, the process just ends */
	struct { word id; optr caller; } d;

	d.id = callerID;
	d.caller = caller;
	CObjCallSuperP((ClassStruct *) &GenProcessClass, oself,
		       MSG_META_DETACH, &d, sizeof(d), NULL, 0);
	return;
    }
    if (uiFlags & UIF_DETACHING_SYSTEM) {
	if (!caller)
	    return;
	if (caller != UserGetSystemObject() ||
	    (uiFlags & UIF_DETACHING_APP)) {
	    @send caller::MSG_META_ACK(callerID, self);
	    return;
	}
	uiFlags |= UIF_DETACHING_APP;
	@callsuper();
	return;
    }
    uiFlags |= UIF_DETACHING_SYSTEM;
    uiAckID = callerID;
    uiAckOD = caller;
    {
	struct { word id; optr caller; } d;

	d.id = 0;
	d.caller = self;
	UserCallSystem(MSG_META_DETACH, &d, sizeof(d), NULL, 0);
    }
}

@method UserClass, MSG_META_DETACH_ABORT
{
    uiFlags &= ~UIF_DETACHING_SYSTEM;
}

/* UserAck: the system object detached: the UI lets go and ends */
@method UserClass, MSG_META_ACK
{
    struct { word id; optr caller; } d;

    if (!SystemUI() || caller != UserGetSystemObject() || !caller) {
	@callsuper();
	return;
    }
    UserDestroySystemObject();
    UserScreenExit();
    ImReleaseInput(uiFlowObj);
    WinReleaseChange(0, uiFlowObj);
    @send, forceQueue Self()::MSG_USER_FREE_SPECIFIC_UI(UserGetSpecificUI());
    d.id = uiAckID;
    d.caller = uiAckOD;
    CObjCallSuperP((ClassStruct *) &GenProcessClass, oself, MSG_META_DETACH,
		   &d, sizeof(d), NULL, 0);
}

@method UserClass, MSG_USER_FREE_SPECIFIC_UI
{
    (void) specificUI;
    UserFreeSpecificUI();
}

/* UserNotifyProcessExit: the fields and GCNSLT_APPLICATION told */
@method UserClass, MSG_PROCESS_NOTIFY_PROCESS_EXIT
{
    EventHandle ev;

    (void) exitCode;
    ev = @record GenFieldClass::MSG_GEN_FIELD_PROCESS_EXIT(exitProcess);
    UserCallSystem(MSG_GEN_SEND_TO_CHILDREN, &ev, sizeof(ev), NULL, 0);
    ev = @record null::MSG_NOTIFY_APP_EXITED(exitProcess);
    GCNListSend(MANUFACTURER_ID_GEOWORKS, GCNSLT_APPLICATION, ev, 0, 0);
}
