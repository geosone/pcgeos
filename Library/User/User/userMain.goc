/*
 * userMain.goc -- the UI's process (after userMain.asm): UserClass and
 * the input map.
 *
 * UserClass, the process of ui.geo (a GenProcessClass), starts the
 * system at its attach (UserAttach): the flow object with the input
 * manager's and the window system's events, the specific UI, the system
 * object, the screens (userScreen.goc), the input map; then its own
 * application object UIApp (UI/uiMain.goc) is opened below the default
 * screen, with a field of its own, and the startup goes on
 * (UserContinueStartup): the mouse driver, the system fields, the
 * applications of "[ui] execOnStartup" and "execOnStartupBG".  The
 * UI's process hears of the exit of the applications' processes (the
 * fields make it their parent) and tells the fields and
 * GCNSLT_APPLICATION.  Its detach (from SysShutdown) detaches the
 * system object, which detaches the fields with their applications and
 * then the UI's process as an application; the system's ack ends the
 * process (the screens, the input grabs and the specific UI let go).
 *
 * The input map says which UI function a button starts with which
 * modifiers (the flow object's TranslateButton) and holds the
 * UIButtonFlags of the [input] category.
 *
 * Port32:
 *  - ui.geo is the system's UI when the kernel loads it (BootLoadUI,
 *    SGIT_UI_PROCESS).  Loaded as a library of another geode, as the
 *    tests of its parts do, its process ends at once and it is a
 *    library only;
 *  - the input map is a structure of the library, not a block; the
 *    library also sets it up when it is loaded (UILibraryEntry,
 *    userLibrary.goc), for the library only UI;
 *  - no state files: the UI opens its application without one and
 *    never asks to delete them (DeleteStateConfirmBox);
 *  - not yet: undo, overstrike, the activation dialog and keyboard
 *    accelerator modes, sound, the busy timer, the token database, the
 *    screen blanker, pen mode and handwriting, the spooler and mailbox
 *    loaded at the start, the help objects, the graphical setup of
 *    "[system] continueSetup", the clipboard file, the task driver,
 *    passwords, MSG_META_INVAL_TREE and _BOUNDS, the log; the mouse
 *    driver without "[mouse] driver" (the asm's kbmouse.geo).
 */
@include "uiInt.goh"
@include <Objects/gSysC.goh>
@include <Objects/gFieldC.goh>
@include <Internal/uProcC.goh>
@include <Internal/flowC.goh>
#include <initfile.h>
#include <system.h>
#include <sysstats.h>
#include <driver.h>
#include <geosdriver.h>
#include <Internal/im.h>
#include <Internal/mouseDr.h>
#include <Internal/videoDr.h>
#include <string.h>

