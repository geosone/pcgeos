/*
 * uivis.goc -- a process geode for the library.ui.vis test (Port32/Tests):
 * a visual tree of the UI library's VisClass and VisCompClass in a window.
 *
 * UVTop (a VisCompClass window and win group) has two rectangles, UVRectA
 * and UVRectB, that count what they get.  The test (test_ui_vis.c) gives
 * the root window in uvState and runs the steps one by one through
 * UVStep, which calls the process (MSG_UV_STEP runs on its thread, which
 * runs the objects); the exposures come after a step, on the queue.  The
 * checks made here count in uvState (the first failing line kept).
 *
 * UVGeo is a composite outside the window whose children the geometry
 * manager sizes and places (steps 7 to 9): three rectangles of fixed
 * sizes, and UVGeo2 with a rectangle and a child that takes the length
 * it is offered.
 *
 * UVNode has a basic and a hierarchical grab for the Flow routines
 * (step 10), UVLeaf1 and UVLeaf2 count the messages they get from it.
 *
 * UVContent is a VisContentClass with the gadgets UVCA and UVCB, which
 * record what they get; UVView stands in for its view (steps 11 to 14).
 * Its window is opened here, on the root.
 */
@include <stdapp.goh>
@include <Objects/vCompC.goh>
@include <Objects/vCntC.goh>
#include <string.h>
#include <chunkarr.h>

/* visC.def (uiInt.goh has them for the library) */
#define VOF_PATH_BITS		(VOF_GEO_UPDATE_PATH | VOF_WINDOW_UPDATE_PATH | \
				 VOF_IMAGE_UPDATE_PATH)
#define VOF_INVALID_BITS	(VOF_GEOMETRY_INVALID | VOF_WINDOW_INVALID | \
				 VOF_IMAGE_INVALID)
#define VOF_UPDATING		VOF_EC_UPDATING

/* what a gadget of the content got */
typedef struct {
    word	UG_msg;			/* the last mouse message */
    sword	UG_x, UG_y;
    word	UG_state;
    word	UG_selects, UG_ptrs, UG_others, UG_pre, UG_post;
    word	UG_firstPtrX;
    word	UG_mouse[2], UG_kbd[2], UG_focus[2];	/* gained, lost */
    word	UG_chars, UG_pings;
    word	UG_large;		/* large mouse messages */
    sdword	UG_largeX, UG_largeY;
} UVGad;

typedef struct {
    WindowHandle	UVS_root;	/* from the test */
    GeodeHandle		UVS_process;
    word		UVS_attached;
    word		UVS_checks, UVS_fails, UVS_failLine;
    word		UVS_drawsA, UVS_drawsB;
    word		UVS_selectsA, UVS_selectsB;
    word		UVS_lostA, UVS_lostB;
    word		UVS_pings;
    WindowHandle	UVS_win;	/* UVTop's window */
    word		UVS_failLines[8];
    /* by UVNI_which: gained, lost, gained system, lost system */
    word		UVS_flow[3][4];
    word		UVS_cdraws[2];	/* the content's gadgets drawn */
    WindowHandle	UVS_cwin;	/* the content's ("the view's") window */
    /* (the test does not look at what follows) */
    UVGad		UVS_gad[2];
    word		UVS_winChanged, UVS_unwantedMouse, UVS_unwantedKbd;
    /* what the view was told */
    sdword		UVS_doc[4];	/* bottom, right, top, left */
    word		UVS_docSets, UVS_targetInfos;
    ViewTargetInfo	UVS_targetInfo;
} UVState;

UVState uvState;

#define UVCHECK(c) \
    do { uvState.UVS_checks++; if (!(c)) { \
	if (uvState.UVS_fails < 8) \
	    uvState.UVS_failLines[uvState.UVS_fails] = __LINE__; \
	uvState.UVS_fails++; \
	if (!uvState.UVS_failLine) uvState.UVS_failLine = __LINE__; } \
    } while (0)

@class UVProcessClass, ProcessClass;
    @message void MSG_UV_STEP(word step);
@endc
@classdecl UVProcessClass, neverSaved;

/* the window: opened on the root, with the bounds */
@class UVWinClass, VisCompClass;
    @message void MSG_UV_PING();
@endc
@classdecl UVWinClass;

/* a rectangle of its colour */
@class UVRectClass, VisClass;
    @instance Color UVRI_color = C_BLACK;
    @instance word UVRI_which = 0;
@endc
@classdecl UVRectClass;

/* takes the size it is offered; 10x10 if it may choose */
@class UVFlexClass, VisClass;
@endc
@classdecl UVFlexClass;

@method UVFlexClass, MSG_VIS_RECALC_SIZE
{
    return MAKE_SIZE_DWORD(width & RSA_CHOOSE_OWN_SIZE ? 10 : width,
			   height & RSA_CHOOSE_OWN_SIZE ? 10 : height);
}

/* a node of a hierarchy, and what is below it */
@class UVNodeClass, VisClass;
    @message void MSG_UVN_GAINED();	/* the four in this order */
    @message void MSG_UVN_LOST();
    @message void MSG_UVN_GAINED_SYS();
    @message void MSG_UVN_LOST_SYS();
    @instance BasicGrab UVNI_grab = { 0, 0 };
    @instance HierarchicalGrab UVNI_excl = { 0, 0 };
    @instance word UVNI_which = 0;
@endc
@classdecl UVNodeClass;

@method UVNodeClass, MSG_UVN_GAINED, MSG_UVN_LOST, MSG_UVN_GAINED_SYS,
		     MSG_UVN_LOST_SYS
{
    uvState.UVS_flow[pself->UVNI_which][message - MSG_UVN_GAINED]++;
}

/* the content: counts what it tells itself */
@class UVContentClass, VisContentClass;
@endc
@classdecl UVContentClass;

@method UVContentClass, MSG_VIS_CONTENT_NOTIFY_ACTIVE_MOUSE_GRAB_WIN_CHANGED
{
    uvState.UVS_winChanged++;
}

@method UVContentClass, MSG_VIS_CONTENT_UNWANTED_MOUSE_EVENT
{
    (void) mouseGrab;
    (void) inputState;
    uvState.UVS_unwantedMouse++;
}

@method UVContentClass, MSG_VIS_CONTENT_UNWANTED_KBD_EVENT
{
    (void) character;
    (void) flags;
    (void) state;
    uvState.UVS_unwantedKbd++;
}

/* a gadget in the content */
@class UVGadClass, VisClass;
    @message void MSG_UVG_PING();
    /* what it returns for a pre-passive button; whether it lets go of
     * the mouse at the next press and wants that replayed */
    @message void MSG_UVG_SET(word preRet, Boolean replay);
    @instance Color UVGI_color = C_BLACK;
    @instance word UVGI_which = 0;
    @instance word UVGI_preRet = 0;
    @instance Boolean UVGI_replay = FALSE;
@endc
@classdecl UVGadClass;

@method UVGadClass, MSG_UVG_PING
{
    uvState.UVS_gad[pself->UVGI_which].UG_pings++;
}

@method UVGadClass, MSG_UVG_SET
{
    pself->UVGI_preRet = preRet;
    pself->UVGI_replay = replay;
}

@method UVGadClass, MSG_VIS_DRAW
{
    (void) drawFlags;
    GrSetAreaColor(gstate, CF_INDEX, pself->UVGI_color, 0, 0);
    GrFillRect(gstate, pself->VI_bounds.R_left, pself->VI_bounds.R_top,
	       pself->VI_bounds.R_right, pself->VI_bounds.R_bottom);
    uvState.UVS_cdraws[pself->UVGI_which]++;
}

@method UVGadClass, MSG_META_PTR, MSG_META_START_SELECT, MSG_META_END_OTHER,
		    MSG_META_DRAG_OTHER, MSG_META_PRE_PASSIVE_BUTTON,
		    MSG_META_POST_PASSIVE_BUTTON
{
    UVGad *g = &uvState.UVS_gad[pself->UVGI_which];
    word ret = MRF_PROCESSED;

    if (message == MSG_META_PRE_PASSIVE_BUTTON) {
	g->UG_pre++;
	retVal->flags = pself->UVGI_preRet;
	return;
    }
    if (message == MSG_META_POST_PASSIVE_BUTTON) {
	g->UG_post++;
	retVal->flags = 0;
	return;
    }
    g->UG_msg = message;
    g->UG_x = xPosition;
    g->UG_y = yPosition;
    g->UG_state = inputState;
    if (message == MSG_META_PTR) {
	if (!g->UG_ptrs++)
	    g->UG_firstPtrX = xPosition;
    } else if (message == MSG_META_START_SELECT) {
	g->UG_selects++;
	if (pself->UVGI_replay) {
	    pself->UVGI_replay = FALSE;
	    @call oself::MSG_VIS_RELEASE_MOUSE();
	    ret |= MRF_REPLAY;
	}
    } else
	g->UG_others++;
    retVal->flags = ret;
}

@method UVGadClass, MSG_META_LARGE_PTR, MSG_META_LARGE_START_SELECT
{
    UVGad *g = &uvState.UVS_gad[pself->UVGI_which];

    g->UG_msg = message;
    g->UG_large++;
    g->UG_largeX = largeMouseDataStruct->LMD_location.PDF_x.DWF_int;
    g->UG_largeY = largeMouseDataStruct->LMD_location.PDF_y.DWF_int;
    g->UG_state = largeMouseDataStruct->LMD_buttonInfo |
		  (largeMouseDataStruct->LMD_uiFunctionsActive << 8);
    retVal->flags = MRF_PROCESSED;
}

@method UVGadClass, MSG_META_GAINED_MOUSE_EXCL, MSG_META_LOST_MOUSE_EXCL
{
    uvState.UVS_gad[pself->UVGI_which]
	.UG_mouse[message - MSG_META_GAINED_MOUSE_EXCL]++;
}

@method UVGadClass, MSG_META_GAINED_KBD_EXCL, MSG_META_LOST_KBD_EXCL
{
    uvState.UVS_gad[pself->UVGI_which]
	.UG_kbd[message - MSG_META_GAINED_KBD_EXCL]++;
}

@method UVGadClass, MSG_META_GAINED_FOCUS_EXCL, MSG_META_LOST_FOCUS_EXCL
{
    uvState.UVS_gad[pself->UVGI_which]
	.UG_focus[message - MSG_META_GAINED_FOCUS_EXCL]++;
}

@method UVGadClass, MSG_META_KBD_CHAR
{
    (void) character;
    (void) flags;
    (void) state;
    uvState.UVS_gad[pself->UVGI_which].UG_chars++;
}

/* stands in for the content's GenView: keeps what it is told */
@class UVViewClass, MetaClass;
    @uses GenViewClass;		/* handles some of its messages */
@endc
@classdecl UVViewClass;

@method UVViewClass, MSG_GEN_VIEW_SET_DOC_BOUNDS
{
    uvState.UVS_doc[0] = bottom;
    uvState.UVS_doc[1] = right;
    uvState.UVS_doc[2] = top;
    uvState.UVS_doc[3] = left;
    uvState.UVS_docSets++;
}

@method UVViewClass, MSG_GEN_VIEW_UPDATE_CONTENT_TARGET_INFO
{
    uvState.UVS_targetInfo = *targetInfo;
    uvState.UVS_targetInfos++;
}

@start UVObjects;
@object UVContentClass UVContent = {
    VCI_comp = @UVCA, @UVCB;
    /* as MSG_META_INITIALIZE sets them */
    VCI_geoAttrs = VCGA_ORIENT_CHILDREN_VERTICALLY;
    VCI_geoDimensionAttrs = VCGDA_EXPAND_WIDTH_TO_FIT_PARENT |
			    VCGDA_EXPAND_HEIGHT_TO_FIT_PARENT;
}
@object UVGadClass UVCA = {
    VI_bounds = { 0, 0, 50, 40 };
    UVGI_color = C_GREEN;
    UVGI_which = 0;
}
@object UVGadClass UVCB = {
    VI_bounds = { 0, 0, 30, 20 };
    UVGI_color = C_CYAN;
    UVGI_which = 1;
}
@object UVViewClass UVView = {
}
@object UVWinClass UVTop = {
    VI_bounds = { 10, 10, 210, 110 };
    VI_typeFlags = VTF_IS_COMPOSITE | VTF_IS_WINDOW | VTF_IS_WIN_GROUP;
    VCI_comp = @UVRectA, @UVRectB;
    /* the rectangles stay where they are */
    VCI_geoAttrs = VCGA_CUSTOM_MANAGE_CHILDREN;
}
@object UVRectClass UVRectA = {
    VI_bounds = { 5, 5, 55, 45 };
    UVRI_color = C_RED;
    UVRI_which = 0;
}
@object UVRectClass UVRectB = {
    VI_bounds = { 100, 20, 150, 60 };
    UVRI_color = C_BLUE;
    UVRI_which = 1;
}

/* the geometry manager's: 50x40, 30x20, 20x60 */
@object VisCompClass UVGeo = {
    VCI_comp = @UVGeoA, @UVGeoB, @UVGeoC;
}
@object UVRectClass UVGeoA = {
    VI_bounds = { 0, 0, 50, 40 };
}
@object UVRectClass UVGeoB = {
    VI_bounds = { 0, 0, 30, 20 };
}
@object UVRectClass UVGeoC = {
    VI_bounds = { 0, 0, 20, 60 };
}
@object VisCompClass UVGeo2 = {
    VCI_comp = @UVGeoD, @UVFlex;
    VCI_geoDimensionAttrs = VCGDA_EXPAND_WIDTH_TO_FIT_PARENT;
}
@object UVRectClass UVGeoD = {
    VI_bounds = { 0, 0, 50, 40 };
}
@object UVFlexClass UVFlex = {
}
@object UVNodeClass UVNode = {
    UVNI_which = 0;
}
@object UVNodeClass UVLeaf1 = {
    UVNI_which = 1;
}
@object UVNodeClass UVLeaf2 = {
    UVNI_which = 2;
}
@end UVObjects;

@method UVWinClass, MSG_VIS_OPEN_WIN
{
    Rectangle b = pself->VI_bounds;

    pself->VCI_window = WinOpen(parentWindow ? parentWindow
					     : uvState.UVS_root,
				oself, oself, CMT_CLOSEST, C_WHITE, 0, 0, 0,
				0, 0, NULL, b.R_left, b.R_top, b.R_right - 1,
				b.R_bottom - 1);
    uvState.UVS_win = pself->VCI_window;
}

@method UVWinClass, MSG_UV_PING
{
    uvState.UVS_pings++;
}

@method UVRectClass, MSG_VIS_DRAW
{
    (void) drawFlags;
    GrSetAreaColor(gstate, CF_INDEX, pself->UVRI_color, 0, 0);
    GrFillRect(gstate, pself->VI_bounds.R_left, pself->VI_bounds.R_top,
	       pself->VI_bounds.R_right, pself->VI_bounds.R_bottom);
    if (pself->UVRI_which)
	uvState.UVS_drawsB++;
    else
	uvState.UVS_drawsA++;
}

@method UVRectClass, MSG_META_START_SELECT
{
    (void) xPosition;
    (void) yPosition;
    (void) inputState;
    if (pself->UVRI_which)
	uvState.UVS_selectsB++;
    else
	uvState.UVS_selectsA++;
    retVal->flags = MRF_PROCESSED;
}

@method UVRectClass, MSG_VIS_LOST_GADGET_EXCL
{
    if (pself->UVRI_which)
	uvState.UVS_lostB++;
    else
	uvState.UVS_lostA++;
}

@method UVProcessClass, MSG_META_ATTACH_PROCESS
{
    (void) value1;
    (void) value2;
    uvState.UVS_process = GeodeGetProcessHandle();
    uvState.UVS_attached++;
}

static VisAttrs Attrs(optr o)
{
    return @call o::MSG_VIS_GET_ATTRS();
}

static VisOptFlags Opt(optr o)
{
    return @call o::MSG_VIS_GET_OPT_FLAGS();
}

static WindowHandle TopWin(void)
{
    VisCompInstance *v;
    WindowHandle w;

    ObjLockObjBlock(OptrToHandle(@UVTop));
    v = ObjDerefVis(@UVTop);
    w = v->VCI_window;
    MemUnlock(OptrToHandle(@UVTop));
    return w;
}

/* the geometry of a composite for the size passed, at (x, y) */
static SizeAsDWord Geo(optr comp, word width, word height, sword x, sword y,
		       word info)
{
    SizeAsDWord s = VisCompRecalcSize(comp, width, height, info);

    VisSetSize(comp, DWORD_WIDTH(s), DWORD_HEIGHT(s));
    VisCompPosition(comp, x, y, info);
    return s;
}

static void GeoAttrs(optr comp, byte geo, byte dim)
{
    GeoAndDimensionAttrs set, clear;

    set.GADA_geoAttrs = geo;
    set.GADA_geoDimensionAttrs = dim;
    clear.GADA_geoAttrs = ~geo;
    clear.GADA_geoDimensionAttrs = ~dim;
    @call comp::MSG_VIS_COMP_SET_GEO_ATTRS(set, clear);
}

/* an object's bounds */
static Boolean At(optr o, sword l, sword t, sword r, sword b)
{
    Rectangle x;

    @call o::MSG_VIS_GET_BOUNDS(&x);
    return x.R_left == l && x.R_top == t && x.R_right == r &&
	   x.R_bottom == b;
}

#define OWN	RSA_CHOOSE_OWN_SIZE

/* UVNode's grabs */
#define NODE_MASTER	word_offsetof(VisBase, Vis_offset)
#define NODE_GRAB	word_offsetof(UVNodeInstance, UVNI_grab)
#define NODE_EXCL	word_offsetof(UVNodeInstance, UVNI_excl)

static Boolean NodeGrab(optr od, word data)
{
    UVNodeInstance *n;
    Boolean ok;

    ObjLockObjBlock(OptrToHandle(@UVNode));
    n = ObjDerefVis(@UVNode);
    ok = n->UVNI_grab.BG_OD == od && n->UVNI_grab.BG_data == data;
    MemUnlock(OptrToHandle(@UVNode));
    return ok;
}

static Boolean NodeExcl(optr od, word flags)
{
    UVNodeInstance *n;
    Boolean ok;

    ObjLockObjBlock(OptrToHandle(@UVNode));
    n = ObjDerefVis(@UVNode);
    ok = n->UVNI_excl.HG_OD == od && n->UVNI_excl.HG_flags == flags;
    MemUnlock(OptrToHandle(@UVNode));
    return ok;
}

/* what a leaf has got: gained, lost, gained system, lost system */
static Boolean Got(word which, word g, word l, word gs, word ls)
{
    word *f = uvState.UVS_flow[which];

    return f[0] == g && f[1] == l && f[2] == gs && f[3] == ls;
}

/* a copy of the content's instance data */
static VisContentInstance Content(void)
{
    VisContentInstance c;

    ObjLockObjBlock(OptrToHandle(@UVContent));
    c = *(VisContentInstance *) ObjDerefVis(@UVContent);
    MemUnlock(OptrToHandle(@UVContent));
    return c;
}

static Boolean ActiveGrab(optr o, WindowHandle w)
{
    VisContentInstance c = Content();

    return c.VCNI_activeMouseGrab.VMG_object == o &&
	   c.VCNI_activeMouseGrab.VMG_gWin == w;
}

static Boolean ImpliedGrab(optr o, WindowHandle w)
{
    VisContentInstance c = Content();

    return c.VCNI_impliedMouseGrab.VMG_object == o &&
	   c.VCNI_impliedMouseGrab.VMG_gWin == w;
}

/* the grabs of a passive list */
static word Passive(ChunkHandle list)
{
    word n;

    if (!list)
	return 0;
    ObjLockObjBlock(OptrToHandle(@UVContent));
    n = ChunkArrayGetCount(ConstructOptr(OptrToHandle(@UVContent), list));
    MemUnlock(OptrToHandle(@UVContent));
    return n;
}

static Boolean Doc(sdword b, sdword r, sdword t, sdword l)
{
    return uvState.UVS_doc[0] == b && uvState.UVS_doc[1] == r &&
	   uvState.UVS_doc[2] == t && uvState.UVS_doc[3] == l;
}

@method UVProcessClass, MSG_UV_STEP
{
    UVGad *ga = &uvState.UVS_gad[0], *gb = &uvState.UVS_gad[1];

    switch (step) {
    case 1: {
	/* the tree, then opened by making the win group visible */
	GStateHandle gs;
	EventHandle ev;

	UVCHECK(@call UVRectA::MSG_VIS_FIND_PARENT() == @UVTop);
	UVCHECK(@call UVTop::MSG_VIS_FIND_PARENT() == 0);
	UVCHECK(@call UVTop::MSG_VIS_COUNT_CHILDREN() == 2);
	UVCHECK(@call UVTop::MSG_VIS_FIND_CHILD(@UVRectB) == 1);
	UVCHECK(@call UVTop::MSG_VIS_FIND_CHILD(@UVTop) == (word) -1);
	UVCHECK(@call UVTop::MSG_VIS_FIND_CHILD_AT_POSITION(0) == @UVRectA);
	UVCHECK(@call UVRectB::MSG_VIS_VUP_FIND_OBJECT_OF_CLASS(&UVWinClass)
		== @UVTop);
	UVCHECK(@call UVRectB::MSG_VIS_VUP_TEST_FOR_OBJECT_OF_CLASS(
		    &UVRectClass));
	UVCHECK(!@call UVTop::MSG_VIS_VUP_TEST_FOR_OBJECT_OF_CLASS(
		    &UVRectClass));
	UVCHECK(@call UVRectA::MSG_VIS_GET_SIZE() == MAKE_SIZE_DWORD(50, 40));
	UVCHECK(@call UVTop::MSG_VIS_GET_TYPE_FLAGS() ==
		(VTF_IS_COMPOSITE | VTF_IS_WINDOW | VTF_IS_WIN_GROUP));
	UVCHECK(!(Attrs(@UVTop) & VA_REALIZED) && !TopWin());

	/* a classed event up the tree to the window's class */
	ev = @record UVWinClass::MSG_UV_PING();
	@call UVRectA::MSG_META_SEND_CLASSED_EVENT(ev,
						   (TravelOption) TO_VIS_PARENT);
	UVCHECK(uvState.UVS_pings == 1);

	@call UVTop::MSG_VIS_SET_ATTRS(VA_VISIBLE, 0, VUM_NOW);
	UVCHECK(Attrs(@UVTop) & VA_REALIZED && TopWin() &&
		TopWin() == uvState.UVS_win);
	UVCHECK(Attrs(@UVRectA) & VA_REALIZED &&
		Attrs(@UVRectB) & VA_REALIZED);
	UVCHECK(!(Opt(@UVTop) & (VOF_INVALID_BITS | VOF_PATH_BITS |
				 VOF_UPDATING | VOF_UPDATE_PENDING)));
	UVCHECK(!(Opt(@UVRectA) & (VOF_IMAGE_INVALID | VOF_WINDOW_INVALID)));
	/* VisQueryWindow wants a built object (VI_link set): UVTop has no
	 * parent (the field, in a real UI), so there is none above A */
	UVCHECK(@call UVRectA::MSG_VIS_QUERY_WINDOW() == 0);

	/* a gstate of the win group's window */
	gs = @call UVRectA::MSG_VIS_VUP_CREATE_GSTATE();
	UVCHECK(gs && GrGetWinHandle(gs) == TopWin());
	GrDestroyState(gs);
	break;
    }
    case 2:
	/* A's image invalid, updated now: only A is drawn again */
	@call UVRectA::MSG_VIS_MARK_INVALID(VOF_IMAGE_INVALID, VUM_NOW);
	UVCHECK(!(Opt(@UVRectA) & VOF_IMAGE_INVALID) &&
		!(Opt(@UVTop) & (VOF_IMAGE_UPDATE_PATH | VOF_UPDATING)));
	break;
    case 3: {
	/* the mouse to the child under the point */
	MouseReturnParams r;

	@call UVTop::MSG_META_START_SELECT(&r, 120, 30, 0);
	UVCHECK(r.flags == MRF_PROCESSED && uvState.UVS_selectsB == 1 &&
		!uvState.UVS_selectsA);
	@call UVTop::MSG_META_START_SELECT(&r, 10, 10, 0);
	UVCHECK(r.flags == MRF_PROCESSED && uvState.UVS_selectsA == 1);
	@call UVTop::MSG_META_START_SELECT(&r, 80, 80, 0);
	UVCHECK(r.flags == 0 && uvState.UVS_selectsA == 1 &&
		uvState.UVS_selectsB == 1);
	@call UVTop::MSG_META_PTR(&r, 80, 80, 0);
	UVCHECK(r.flags == MRF_CLEAR_POINTER_IMAGE);

	/* the gadget exclusive */
	@call UVTop::MSG_VIS_TAKE_GADGET_EXCL(@UVRectA);
	@call UVTop::MSG_VIS_TAKE_GADGET_EXCL(@UVRectB);
	UVCHECK(uvState.UVS_lostA == 1 && !uvState.UVS_lostB);
	@call UVTop::MSG_VIS_RELEASE_GADGET_EXCL(@UVRectA);
	UVCHECK(!uvState.UVS_lostB);
	@call UVTop::MSG_VIS_RELEASE_GADGET_EXCL(@UVRectB);
	UVCHECK(uvState.UVS_lostB == 1);
	break;
    }
    case 4:
	/* B out of the tree: closed.  Its parent manages its children
	 * itself, so its geometry is not touched and nothing updates: the
	 * area waits in the win group's update region for the next one. */
	@call UVRectB::MSG_VIS_REMOVE(VUM_NOW);
	(void) @call UVTop::MSG_VIS_VUP_UPDATE_WIN_GROUP(VUM_NOW);
	UVCHECK(@call UVTop::MSG_VIS_COUNT_CHILDREN() == 1);
	UVCHECK(!(Attrs(@UVRectB) & VA_REALIZED));
	UVCHECK(@call UVRectB::MSG_VIS_FIND_PARENT() == 0);
	break;
    case 5:
	/* B back: opened by the update, drawn */
	@call UVTop::MSG_VIS_ADD_CHILD(@UVRectB, CCO_LAST);
	@call UVRectB::MSG_VIS_MARK_INVALID(VOF_WINDOW_INVALID |
					    VOF_IMAGE_INVALID, VUM_NOW);
	UVCHECK(@call UVTop::MSG_VIS_FIND_CHILD(@UVRectB) == 1);
	UVCHECK(Attrs(@UVRectB) & VA_REALIZED);
	break;
    case 6:
	/* closed: the window goes */
	@call UVTop::MSG_VIS_SET_ATTRS(0, VA_VISIBLE, VUM_NOW);
	UVCHECK(!(Attrs(@UVTop) & VA_REALIZED) && !TopWin());
	UVCHECK(!(Attrs(@UVRectA) & VA_REALIZED) &&
		!(Attrs(@UVRectB) & VA_REALIZED));
	break;
    case 7: {
	/* the geometry manager: a horizontal line with the default
	 * spacing (3), through the update */
	GeoAndDimensionAttrs a;
	GetCenterParams c;

	UVCHECK(@call UVGeo::MSG_VIS_COMP_GET_CHILD_SPACING() ==
		MAKE_SPACING_DWORD(3, 3));
	@call UVGeo::MSG_VIS_SET_POSITION(10, 20);
	@call UVGeo::MSG_VIS_UPDATE_GEOMETRY();
	UVCHECK(At(@UVGeo, 10, 20, 116, 80));
	UVCHECK(At(@UVGeoA, 10, 20, 60, 60) && At(@UVGeoB, 63, 20, 93, 40) &&
		At(@UVGeoC, 96, 20, 116, 80));
	UVCHECK(!(Opt(@UVGeo) & (VOF_GEOMETRY_INVALID | VOF_GEO_UPDATE_PATH)));

	/* vertical */
	GeoAttrs(@UVGeo, VCGA_ORIENT_CHILDREN_VERTICALLY, 0);
	a = @call UVGeo::MSG_VIS_COMP_GET_GEO_ATTRS();
	UVCHECK(a.GADA_geoAttrs == VCGA_ORIENT_CHILDREN_VERTICALLY &&
		!a.GADA_geoDimensionAttrs);
	UVCHECK(Geo(@UVGeo, OWN, OWN, 10, 20, 0) == MAKE_SIZE_DWORD(50, 126));
	UVCHECK(At(@UVGeoA, 10, 20, 60, 60) && At(@UVGeoB, 10, 63, 40, 83) &&
		At(@UVGeoC, 10, 86, 30, 146));
	/* centered across */
	GeoAttrs(@UVGeo, VCGA_ORIENT_CHILDREN_VERTICALLY,
		 WJ_CENTER_CHILDREN_HORIZONTALLY);
	UVCHECK(Geo(@UVGeo, OWN, OWN, 10, 20, 0) == MAKE_SIZE_DWORD(50, 126));
	UVCHECK(At(@UVGeoA, 10, 20, 60, 60) && At(@UVGeoB, 20, 63, 50, 83) &&
		At(@UVGeoC, 25, 86, 45, 146));
	@call UVGeo::MSG_VIS_GET_CENTER(&c);
	UVCHECK(c.GCP_leftOfCenter == 25 && c.GCP_rightOfCenter == 25 &&
		c.GCP_aboveCenter == 63 && c.GCP_belowCenter == 63);

	/* horizontal, the children at the bottom, in the middle */
	GeoAttrs(@UVGeo, 0, HJ_BOTTOM_JUSTIFY_CHILDREN);
	UVCHECK(Geo(@UVGeo, OWN, OWN, 10, 20, 0) == MAKE_SIZE_DWORD(106, 60));
	UVCHECK(At(@UVGeoA, 10, 40, 60, 80) && At(@UVGeoB, 63, 60, 93, 80) &&
		At(@UVGeoC, 96, 20, 116, 80));
	GeoAttrs(@UVGeo, 0, HJ_CENTER_CHILDREN_VERTICALLY);
	UVCHECK(Geo(@UVGeo, OWN, OWN, 10, 20, 0) == MAKE_SIZE_DWORD(106, 60));
	UVCHECK(At(@UVGeoA, 10, 30, 60, 70) && At(@UVGeoB, 63, 40, 93, 60) &&
		At(@UVGeoC, 96, 20, 116, 80));
	break;
    }
    case 8:
	/* expanding to 200 wide: at the right, centered, spread out */
	GeoAttrs(@UVGeo, 0, VCGDA_EXPAND_WIDTH_TO_FIT_PARENT |
			    WJ_RIGHT_JUSTIFY_CHILDREN);
	UVCHECK(Geo(@UVGeo, 200, OWN, 10, 20, 0) == MAKE_SIZE_DWORD(200, 60));
	UVCHECK(At(@UVGeoA, 104, 20, 154, 60) &&
		At(@UVGeoB, 157, 20, 187, 40) &&
		At(@UVGeoC, 190, 20, 210, 80));
	GeoAttrs(@UVGeo, 0, VCGDA_EXPAND_WIDTH_TO_FIT_PARENT |
			    WJ_CENTER_CHILDREN_HORIZONTALLY);
	UVCHECK(Geo(@UVGeo, 200, OWN, 10, 20, 0) == MAKE_SIZE_DWORD(200, 60));
	UVCHECK(At(@UVGeoA, 57, 20, 107, 60) &&
		At(@UVGeoB, 110, 20, 140, 40) &&
		At(@UVGeoC, 143, 20, 163, 80));
	GeoAttrs(@UVGeo, 0, VCGDA_EXPAND_WIDTH_TO_FIT_PARENT |
			    WJ_FULL_JUSTIFY_CHILDREN_HORIZONTALLY);
	UVCHECK(Geo(@UVGeo, 200, OWN, 10, 20, 0) == MAKE_SIZE_DWORD(200, 60));
	UVCHECK(At(@UVGeoA, 10, 20, 60, 60) &&
		At(@UVGeoB, 110, 20, 140, 40) &&
		At(@UVGeoC, 190, 20, 210, 80));
	/* not expanding: its own size whatever is passed */
	GeoAttrs(@UVGeo, 0, 0);
	UVCHECK(Geo(@UVGeo, 200, 200, 0, 0, 0) == MAKE_SIZE_DWORD(106, 60));

	/* spacing 5 and margins 2, 1, 2, 1 passed */
	UVCHECK(Geo(@UVGeo, OWN, OWN, 0, 0,
		    VCSMI_USE_THIS_INFO | 2 << 12 | 1 << 9 | 2 << 6 | 1 << 3 |
		    5) == MAKE_SIZE_DWORD(114, 62));
	UVCHECK(At(@UVGeoA, 2, 1, 52, 41) && At(@UVGeoB, 57, 1, 87, 21) &&
		At(@UVGeoC, 92, 1, 112, 61));
	/* the ends in the spacing */
	GeoAttrs(@UVGeo, VCGA_INCLUDE_ENDS_IN_CHILD_SPACING, 0);
	UVCHECK(Geo(@UVGeo, OWN, OWN, 0, 0, 0) == MAKE_SIZE_DWORD(112, 60));
	UVCHECK(At(@UVGeoA, 3, 0, 53, 40) && At(@UVGeoB, 56, 0, 86, 20) &&
		At(@UVGeoC, 89, 0, 109, 60));
	break;
    case 9:
	/* wrapping in 90: two on the first line, the third below it (the
	 * line width 60, the spacing 3) */
	GeoAttrs(@UVGeo, VCGA_ALLOW_CHILDREN_TO_WRAP, 0);
	UVCHECK(Geo(@UVGeo, 90, OWN, 0, 0, 0) == MAKE_SIZE_DWORD(83, 123));
	UVCHECK(At(@UVGeoA, 0, 0, 50, 40) && At(@UVGeoB, 53, 0, 83, 20) &&
		At(@UVGeoC, 0, 63, 20, 123));
	/* a child out of the geometry */
	GeoAttrs(@UVGeo, 0, 0);
	@call UVGeoB::MSG_VIS_SET_ATTRS(0, VA_MANAGED, VUM_MANUAL);
	UVCHECK(Geo(@UVGeo, OWN, OWN, 0, 0, 0) == MAKE_SIZE_DWORD(73, 60));
	UVCHECK(At(@UVGeoA, 0, 0, 50, 40) && At(@UVGeoB, 53, 0, 83, 20) &&
		At(@UVGeoC, 53, 0, 73, 60));
	@call UVGeoB::MSG_VIS_SET_ATTRS(VA_MANAGED, 0, VUM_MANUAL);

	/* a child that takes what is left of 200; then squeezed to 120 */
	UVCHECK(Geo(@UVGeo2, 200, OWN, 0, 0, 0) == MAKE_SIZE_DWORD(200, 40));
	UVCHECK(At(@UVGeoD, 0, 0, 50, 40) && At(@UVFlex, 53, 0, 200, 40));
	UVCHECK(Geo(@UVGeo2, 120, OWN, 0, 0, 0) == MAKE_SIZE_DWORD(120, 40));
	UVCHECK(At(@UVGeoD, 0, 0, 50, 40) && At(@UVFlex, 53, 0, 120, 40));
	/* left to choose, an object with valid geometry keeps its size;
	 * invalid, it is asked */
	UVCHECK(Geo(@UVGeo2, OWN, OWN, 0, 0, 0) == MAKE_SIZE_DWORD(120, 40));
	@call UVFlex::MSG_VIS_MARK_INVALID(VOF_GEOMETRY_INVALID, VUM_MANUAL);
	UVCHECK(Geo(@UVGeo2, OWN, OWN, 0, 0, 0) == MAKE_SIZE_DWORD(63, 40));
	/* a composite in a composite, the inner one expanding */
	@call UVGeo::MSG_VIS_ADD_CHILD(@UVGeo2, CCO_LAST);
	GeoAttrs(@UVGeo, VCGA_ORIENT_CHILDREN_VERTICALLY, 0);
	UVCHECK(Geo(@UVGeo, OWN, OWN, 0, 0, 0) == MAKE_SIZE_DWORD(63, 169));
	UVCHECK(At(@UVGeo2, 0, 129, 63, 169) && At(@UVGeoD, 0, 129, 50, 169) &&
		At(@UVFlex, 53, 129, 63, 169));
	break;
    case 10: {
	/* the Flow routines.  A basic grab: asked for, forced, released */
	GetTargetParams t;
	EventHandle ev, outer;

	UVCHECK(FlowRequestGrab(@UVNode, MSG_UVN_GAINED, NODE_MASTER,
				NODE_GRAB, @UVLeaf1, 7));
	UVCHECK(NodeGrab(@UVLeaf1, 7) && Got(1, 1, 0, 0, 0));
	UVCHECK(!FlowRequestGrab(@UVNode, MSG_UVN_GAINED, NODE_MASTER,
				 NODE_GRAB, @UVLeaf2, 8));
	UVCHECK(NodeGrab(@UVLeaf1, 7) && Got(2, 0, 0, 0, 0));
	UVCHECK(FlowForceGrab(@UVNode, MSG_UVN_GAINED, NODE_MASTER, NODE_GRAB,
			      @UVLeaf2, 8));
	UVCHECK(NodeGrab(@UVLeaf2, 8) && Got(1, 1, 1, 0, 0) &&
		Got(2, 1, 0, 0, 0));
	UVCHECK(!FlowForceGrab(@UVNode, MSG_UVN_GAINED, NODE_MASTER,
			       NODE_GRAB, @UVLeaf2, 9));
	UVCHECK(NodeGrab(@UVLeaf2, 9) && Got(2, 1, 0, 0, 0));
	UVCHECK(!FlowReleaseGrab(@UVNode, MSG_UVN_GAINED, NODE_MASTER,
				 NODE_GRAB, @UVLeaf1));
	UVCHECK(FlowReleaseGrab(@UVNode, MSG_UVN_GAINED, NODE_MASTER,
				NODE_GRAB, @UVLeaf2));
	UVCHECK(NodeGrab(0, 0) && Got(2, 1, 1, 0, 0));
	memset(uvState.UVS_flow, 0, sizeof(uvState.UVS_flow));

	/* a hierarchical grab.  The node has no exclusive: only noted */
	FlowAlterHierarchicalGrab(@UVNode, MSG_UVN_GAINED, NODE_MASTER,
				  NODE_EXCL, @UVLeaf1, HGF_GRAB | 5);
	UVCHECK(NodeExcl(@UVLeaf1, HGF_GRAB | 5) && Got(1, 0, 0, 0, 0));
	/* the node gains the exclusive: so does the one below */
	FlowUpdateHierarchicalGrab(@UVNode, MSG_UVN_GAINED, NODE_MASTER,
				   NODE_EXCL, MSG_UVN_GAINED);
	UVCHECK(NodeExcl(@UVLeaf1, HGF_APP_EXCL | HGF_GRAB | 5) &&
		Got(1, 1, 0, 0, 0));
	/* another one below */
	FlowAlterHierarchicalGrab(@UVNode, MSG_UVN_GAINED, NODE_MASTER,
				  NODE_EXCL, @UVLeaf2, HGF_GRAB);
	UVCHECK(NodeExcl(@UVLeaf2, HGF_APP_EXCL | HGF_GRAB) &&
		Got(1, 1, 1, 0, 0) && Got(2, 1, 0, 0, 0));
	/* the system exclusive, and a change under it */
	FlowUpdateHierarchicalGrab(@UVNode, MSG_UVN_GAINED, NODE_MASTER,
				   NODE_EXCL, MSG_UVN_GAINED_SYS);
	UVCHECK(NodeExcl(@UVLeaf2, HGF_SYS_EXCL | HGF_APP_EXCL | HGF_GRAB) &&
		Got(2, 1, 0, 1, 0));
	FlowAlterHierarchicalGrab(@UVNode, MSG_UVN_GAINED, NODE_MASTER,
				  NODE_EXCL, @UVLeaf1, HGF_GRAB);
	UVCHECK(NodeExcl(@UVLeaf1, HGF_SYS_EXCL | HGF_APP_EXCL | HGF_GRAB) &&
		Got(2, 1, 1, 1, 1) && Got(1, 2, 1, 1, 0));

	/* the target at a level: the node's own, the leaf, none */
	FlowGetTargetAtTargetLevel(@UVNode, NODE_MASTER, NODE_EXCL, 5, 5, &t);
	UVCHECK(t.GTP_target == @UVNode && t.GTP_class == &UVNodeClass);
	FlowGetTargetAtTargetLevel(@UVNode, NODE_MASTER, NODE_EXCL, 5, 0, &t);
	UVCHECK(t.GTP_target == @UVLeaf1 && t.GTP_class == &UVNodeClass);
	FlowGetTargetAtTargetLevel(@UVNode, NODE_MASTER, NODE_EXCL, 5, 7, &t);
	UVCHECK(!t.GTP_target && !t.GTP_class);

	/* released by one that does not have it, by the one that has */
	FlowAlterHierarchicalGrab(@UVNode, MSG_UVN_GAINED, NODE_MASTER,
				  NODE_EXCL, @UVLeaf2, 0);
	UVCHECK(Got(1, 2, 1, 1, 0));
	FlowAlterHierarchicalGrab(@UVNode, MSG_UVN_GAINED, NODE_MASTER,
				  NODE_EXCL, @UVLeaf1, 0);
	UVCHECK(NodeExcl(0, HGF_SYS_EXCL | HGF_APP_EXCL) &&
		Got(1, 2, 2, 1, 1));
	FlowGetTargetAtTargetLevel(@UVNode, NODE_MASTER, NODE_EXCL, 5, 0, &t);
	UVCHECK(t.GTP_target == @UVNode);
	FlowUpdateHierarchicalGrab(@UVNode, MSG_UVN_GAINED, NODE_MASTER,
				   NODE_EXCL, MSG_UVN_LOST_SYS);
	FlowUpdateHierarchicalGrab(@UVNode, MSG_UVN_GAINED, NODE_MASTER,
				   NODE_EXCL, MSG_UVN_LOST);
	UVCHECK(NodeExcl(0, 0) && Got(1, 2, 2, 1, 1) && Got(2, 1, 1, 1, 1));

	/* classed events: dispatched at an object of the class, sent on,
	 * destroyed (with the event it carries) */
	memset(uvState.UVS_flow, 0, sizeof(uvState.UVS_flow));
	ev = @record UVNodeClass::MSG_UVN_GAINED();
	UVCHECK(FlowDispatchSendOnOrDestroyClassedEvent(NULL, @UVLeaf1,
		    MSG_META_SEND_CLASSED_EVENT, ev, TO_SELF, 0, 0));
	UVCHECK(Got(1, 1, 0, 0, 0));
	ev = @record UVWinClass::MSG_UV_PING();
	UVCHECK(!FlowDispatchSendOnOrDestroyClassedEvent(NULL, @UVLeaf1,
		    MSG_META_SEND_CLASSED_EVENT, ev, TO_SELF, 0, 0));
	ev = @record UVNodeClass::MSG_UVN_LOST();
	UVCHECK(FlowMessageClassedEvent(@UVLeaf2, MSG_META_SEND_CLASSED_EVENT,
					ev, TO_SELF, 0));
	UVCHECK(Got(2, 0, 1, 0, 0));
	ev = @record UVNodeClass::MSG_UVN_LOST();
	outer = @record UVNodeClass::MSG_META_SEND_CLASSED_EVENT(ev, TO_SELF);
	FlowDestroyMessage(outer);
	UVCHECK(Got(2, 0, 1, 0, 0) && uvState.UVS_pings == 1);
	break;
    }
    case 11: {
	/* a content made at run time: what MSG_META_INITIALIZE sets */
	optr dyn = ObjInstantiate(OptrToHandle(@UVContent),
				  &VisContentClass);
	GeoAndDimensionAttrs a;
	WindowHandle win;

	UVCHECK(@call dyn::MSG_VIS_GET_TYPE_FLAGS() ==
		(VTF_IS_COMPOSITE | VTF_IS_WINDOW | VTF_IS_WIN_GROUP |
		 VTF_IS_CONTENT | VTF_IS_INPUT_NODE));
	a = @call dyn::MSG_VIS_COMP_GET_GEO_ATTRS();
	UVCHECK(a.GADA_geoAttrs == VCGA_ORIENT_CHILDREN_VERTICALLY &&
		a.GADA_geoDimensionAttrs ==
		(VCGDA_EXPAND_WIDTH_TO_FIT_PARENT |
		 VCGDA_EXPAND_HEIGHT_TO_FIT_PARENT));
	UVCHECK(@call dyn::MSG_VIS_CONTENT_GET_ATTRS() == 0);

	/* the view, told who the content is (no target yet) */
	@call UVContent::MSG_META_CONTENT_SET_VIEW(@UVView);
	UVCHECK(uvState.UVS_targetInfos == 1 &&
		uvState.UVS_targetInfo.VTI_content.TR_object == @UVContent &&
		uvState.UVS_targetInfo.VTI_content.TR_class ==
		&UVContentClass &&
		!uvState.UVS_targetInfo.VTI_target.TR_object &&
		!uvState.UVS_targetInfo.VTI_target.TR_class);

	/* its window opened: the size known, nothing shown yet */
	win = WinOpen(uvState.UVS_root, @UVContent, @UVContent, CMT_CLOSEST,
		      C_WHITE, 0, 0, 0, 0, 0, NULL, 300, 100, 499, 249);
	uvState.UVS_cwin = win;
	@call UVContent::MSG_META_CONTENT_VIEW_WIN_OPENED(200, 150, win);
	UVCHECK(@call UVContent::MSG_VIS_CONTENT_GET_WIN_SIZE() ==
		MAKE_SIZE_DWORD(200, 150));
	UVCHECK(!(Attrs(@UVContent) & VA_REALIZED) &&
		Content().VCNI_window == win && !Content().VCI_window);
	/* not linked to the view yet: no update, even "now" */
	UVCHECK(!@call UVContent::MSG_VIS_VUP_UPDATE_WIN_GROUP(VUM_NOW) &&
		Opt(@UVContent) & VOF_GEOMETRY_INVALID);

	/* the view opens: linked up to it, the geometry done (the
	 * gadgets one above the other), realized in the view's window,
	 * the view told the document's bounds */
	@call UVContent::MSG_META_CONTENT_VIEW_OPENING(@UVView);
	UVCHECK(@call UVContent::MSG_VIS_FIND_PARENT() == @UVView);
	UVCHECK(Attrs(@UVContent) & VA_REALIZED && Attrs(@UVCA) & VA_REALIZED);
	UVCHECK(Content().VCI_window == win);
	UVCHECK(At(@UVContent, 0, 0, 50, 63));
	UVCHECK(At(@UVCA, 0, 0, 50, 40) && At(@UVCB, 0, 43, 30, 63));
	UVCHECK(uvState.UVS_docSets && Doc(63, 50, 0, 0));
	UVCHECK(ImpliedGrab(@UVContent, win));
	UVCHECK(@call UVCA::MSG_VIS_QUERY_WINDOW() == win);
	break;
    }
    case 12: {
	MouseReturnParams r;
	WindowHandle win = uvState.UVS_cwin;

	/* as wide and high as the view */
	@call UVContent::MSG_VIS_CONTENT_SET_ATTRS(VCNA_SAME_WIDTH_AS_VIEW |
						   VCNA_SAME_HEIGHT_AS_VIEW,
						   0);
	UVCHECK(@call UVContent::MSG_VIS_CONTENT_GET_ATTRS() ==
		(VCNA_SAME_WIDTH_AS_VIEW | VCNA_SAME_HEIGHT_AS_VIEW));
	@call UVContent::MSG_META_CONTENT_VIEW_SIZE_CHANGED(220, 160, win);
	UVCHECK(At(@UVContent, 0, 0, 220, 160) && Doc(160, 220, 0, 0));
	UVCHECK(At(@UVCA, 0, 0, 50, 40) && At(@UVCB, 0, 43, 30, 63));

	/* the implied grab is the content: the child under the point */
	@call UVContent::MSG_META_START_SELECT(&r, 10, 10, 0);
	UVCHECK(r.flags == MRF_PROCESSED && ga->UG_selects == 1 &&
		!gb->UG_selects && ga->UG_x == 10 && ga->UG_y == 10);
	@call UVContent::MSG_META_START_SELECT(&r, 10, 50, 0);
	UVCHECK(gb->UG_selects == 1 && gb->UG_y == 50);
	@call UVContent::MSG_META_START_SELECT(&r, 100, 100, 0);
	UVCHECK(r.flags == MRF_PROCESSED && ga->UG_selects == 1 &&
		gb->UG_selects == 1);
	UVCHECK(!@call UVContent::MSG_VIS_CONTENT_TEST_IF_ACTIVE_OR_IMPLIED_WIN(
		    win));
	UVCHECK(@call UVContent::MSG_VIS_CONTENT_TEST_IF_ACTIVE_OR_IMPLIED_WIN(
		    uvState.UVS_root));

	/* B grabs the mouse: it gets everything, with UIFA_IN where the
	 * point is in its bounds */
	@call UVCB::MSG_VIS_GRAB_MOUSE();
	UVCHECK(ActiveGrab(@UVCB, win) && gb->UG_mouse[0] == 1 &&
		uvState.UVS_winChanged == 1);
	UVCHECK(Content().VCNI_activeMouseGrab.VMG_flags ==
		(VIFGF_MOUSE | VIFGF_GRAB | VIFGF_PTR));
	@call UVContent::MSG_META_START_SELECT(&r, 10, 10, 0);
	UVCHECK(gb->UG_selects == 2 && ga->UG_selects == 1 &&
		gb->UG_x == 10 && gb->UG_y == 10 && gb->UG_state == 0);
	@call UVContent::MSG_META_START_SELECT(&r, 10, 50, 0);
	UVCHECK(gb->UG_selects == 3 && gb->UG_state == (UIFA_IN << 8));
	@call UVContent::MSG_META_PTR(&r, 12, 52, 0);
	UVCHECK(r.flags == MRF_PROCESSED && gb->UG_ptrs == 1 &&
		gb->UG_x == 12);

	/* A asks: B keeps it.  A forces it.  Released by its owner only */
	@call UVCA::MSG_VIS_GRAB_MOUSE();
	UVCHECK(ActiveGrab(@UVCB, win) && !ga->UG_mouse[0]);
	@call UVCA::MSG_VIS_FORCE_GRAB_MOUSE();
	UVCHECK(ActiveGrab(@UVCA, win) && gb->UG_mouse[1] == 1 &&
		ga->UG_mouse[0] == 1 && uvState.UVS_winChanged == 1);
	@call UVCB::MSG_VIS_RELEASE_MOUSE();
	UVCHECK(ActiveGrab(@UVCA, win) && !ga->UG_mouse[1]);
	@call UVCA::MSG_VIS_RELEASE_MOUSE();
	UVCHECK(ActiveGrab(0, 0) && ga->UG_mouse[1] == 1 &&
		uvState.UVS_winChanged == 2);

	/* no active grab: ends and drags are those of "other" */
	@call UVContent::MSG_META_END_SELECT(&r, 10, 10, 0);
	UVCHECK(ga->UG_others == 1 && ga->UG_msg == MSG_META_END_OTHER);
	@call UVContent::MSG_META_DRAG_SELECT(&r, 10, 50, 0);
	UVCHECK(gb->UG_others == 1 && gb->UG_msg == MSG_META_DRAG_OTHER);

	/* passive grabs: before and after whoever gets the press, not
	 * for the pointer; an object is on a list once */
	@call UVCA::MSG_VIS_ADD_BUTTON_PRE_PASSIVE();
	@call UVCA::MSG_VIS_ADD_BUTTON_PRE_PASSIVE();
	@call UVCB::MSG_VIS_ADD_BUTTON_POST_PASSIVE();
	UVCHECK(Passive(Content().VCNI_prePassiveMouseGrabList) == 1 &&
		Passive(Content().VCNI_postPassiveMouseGrabList) == 1);
	@call UVContent::MSG_META_START_SELECT(&r, 10, 50, 0);
	UVCHECK(ga->UG_pre == 1 && gb->UG_post == 1 && gb->UG_selects == 4);
	@call UVContent::MSG_META_PTR(&r, 10, 50, 0);
	UVCHECK(ga->UG_pre == 1 && gb->UG_post == 1 && gb->UG_ptrs == 2);
	/* the pre-passive grab keeps the press to itself */
	@call UVCA::MSG_UVG_SET(MRF_PREVENT_PASS_THROUGH, FALSE);
	@call UVContent::MSG_META_START_SELECT(&r, 10, 50, 0);
	UVCHECK(ga->UG_pre == 2 && gb->UG_post == 2 && gb->UG_selects == 4);
	@call UVCA::MSG_UVG_SET(0, FALSE);
	@call UVCA::MSG_VIS_REMOVE_BUTTON_PRE_PASSIVE();
	@call UVCB::MSG_VIS_REMOVE_BUTTON_POST_PASSIVE();
	UVCHECK(!Passive(Content().VCNI_prePassiveMouseGrabList) &&
		!Passive(Content().VCNI_postPassiveMouseGrabList));
	@call UVContent::MSG_META_START_SELECT(&r, 10, 50, 0);
	UVCHECK(ga->UG_pre == 2 && gb->UG_post == 2 && gb->UG_selects == 5);

	/* a replay: B lets go at the press and wants it sent again: it
	 * goes to the child under the point */
	@call UVCB::MSG_VIS_GRAB_MOUSE();
	@call UVCB::MSG_UVG_SET(0, TRUE);
	@call UVContent::MSG_META_START_SELECT(&r, 10, 10, 0);
	UVCHECK(r.flags == MRF_PROCESSED && gb->UG_selects == 6 &&
		ga->UG_selects == 2 && ActiveGrab(0, 0) &&
		uvState.UVS_winChanged == 4);

	/* the mouse over a window that is nobody's */
	@call UVContent::MSG_META_IMPLIED_WIN_CHANGE(0, uvState.UVS_root);
	UVCHECK(ImpliedGrab(0, uvState.UVS_root));
	@call UVContent::MSG_META_START_SELECT(&r, 10, 10, 0);
	UVCHECK(uvState.UVS_unwantedMouse == 1 && ga->UG_selects == 2);
	/* back over its own: the content, whoever the view names */
	@call UVContent::MSG_META_IMPLIED_WIN_CHANGE(@UVView, win);
	UVCHECK(ImpliedGrab(@UVContent, win));

	/* a large grab gets large events, in the document */
	@call UVCA::MSG_VIS_GRAB_LARGE_MOUSE();
	@call UVContent::MSG_META_START_SELECT(&r, 10, 20, 0x0105);
	UVCHECK(ga->UG_large == 1 &&
		ga->UG_msg == MSG_META_LARGE_START_SELECT &&
		ga->UG_largeX == 10 && ga->UG_largeY == 20 &&
		ga->UG_state == 0x0105);
	/* events in window coordinates: through the scale factor and
	 * the document's origin */
	@call UVContent::MSG_VIS_CONTENT_SET_ATTRS(
	    VCNA_WINDOW_COORDINATE_MOUSE_EVENTS, 0);
	@call UVContent::MSG_META_CONTENT_VIEW_ORIGIN_CHANGED(win, 2000, 1000);
	@call UVContent::MSG_META_CONTENT_VIEW_SCALE_FACTOR_CHANGED(
	    win, MakeWWFixed(2), MakeWWFixed(2));
	@call UVContent::MSG_META_PTR(&r, 10, 20, 0);
	UVCHECK(ga->UG_large == 2 && ga->UG_msg == MSG_META_LARGE_PTR &&
		ga->UG_largeX == 1005 && ga->UG_largeY == 2010);
	@call UVCA::MSG_VIS_RELEASE_MOUSE();
	/* small ones too */
	@call UVContent::MSG_META_START_SELECT(&r, 20, 40, 0);
	UVCHECK(ga->UG_selects == 2 && gb->UG_selects == 6);
	@call UVContent::MSG_META_CONTENT_VIEW_ORIGIN_CHANGED(win, 40, 0);
	@call UVContent::MSG_META_START_SELECT(&r, 20, 20, 0);
	UVCHECK(gb->UG_selects == 7 && gb->UG_x == 10 && gb->UG_y == 50);
	@call UVContent::MSG_VIS_CONTENT_SET_ATTRS(
	    0, VCNA_WINDOW_COORDINATE_MOUSE_EVENTS);
	@call UVContent::MSG_META_CONTENT_VIEW_ORIGIN_CHANGED(win, 0, 0);
	@call UVContent::MSG_META_CONTENT_VIEW_SCALE_FACTOR_CHANGED(
	    win, MakeWWFixed(1), MakeWWFixed(1));
	break;
    }
    case 13: {
	MouseReturnParams r;
	ObjectAndGrabParams og;
	GetTargetParams t;
	LargeMouseData l;
	EventHandle ev;
	optr o = 0;
	word n;

	memset(uvState.UVS_gad, 0, sizeof(uvState.UVS_gad));
	/* a key nobody wants */
	@call UVContent::MSG_META_KBD_CHAR('a', 0, 0);
	UVCHECK(uvState.UVS_unwantedKbd == 1);

	/* A has the focus below the content; it hears of it when the
	 * content gains the focus itself.  Keys go to the focus */
	MetaGrabFocusExclLow(@UVCA);
	UVCHECK(@call UVContent::MSG_META_GET_FOCUS_EXCL(&o) &&
		o == @UVCA && !ga->UG_focus[0]);
	@call UVContent::MSG_META_GAINED_FOCUS_EXCL();
	UVCHECK(ga->UG_focus[0] == 1);
	@call UVCB::MSG_VIS_VUP_QUERY_FOCUS_EXCL(&og);
	UVCHECK(og.OAGP_object == @UVCA && og.OAGP_grabFlags & HGF_APP_EXCL);
	@call UVContent::MSG_META_KBD_CHAR('b', 0, 0);
	UVCHECK(ga->UG_chars == 1 && uvState.UVS_unwantedKbd == 1);
	/* a keyboard grab comes first */
	@call UVCB::MSG_META_GRAB_KBD();
	UVCHECK(gb->UG_kbd[0] == 1);
	@call UVContent::MSG_META_KBD_CHAR('c', 0, 0);
	UVCHECK(gb->UG_chars == 1 && ga->UG_chars == 1);
	@call UVCB::MSG_META_RELEASE_KBD();
	UVCHECK(gb->UG_kbd[1] == 1);
	@call UVContent::MSG_META_KBD_CHAR('d', 0, 0);
	UVCHECK(gb->UG_chars == 1 && ga->UG_chars == 2);
	/* the focus to B; the content loses it */
	MetaGrabFocusExclLow(@UVCB);
	UVCHECK(ga->UG_focus[1] == 1 && gb->UG_focus[0] == 1);
	@call UVContent::MSG_META_LOST_FOCUS_EXCL();
	UVCHECK(gb->UG_focus[1] == 1);

	/* the target: the view hears of it */
	n = uvState.UVS_targetInfos;
	MetaGrabTargetExclLow(@UVCA);
	UVCHECK(@call UVContent::MSG_META_GET_TARGET_EXCL(&o) && o == @UVCA);
	UVCHECK(uvState.UVS_targetInfos == n + 1 &&
		uvState.UVS_targetInfo.VTI_target.TR_object == @UVCA &&
		uvState.UVS_targetInfo.VTI_target.TR_class == &UVGadClass &&
		uvState.UVS_targetInfo.VTI_content.TR_object == @UVContent);
	@call UVContent::MSG_META_GET_TARGET_AT_TARGET_LEVEL(&t, TL_CONTENT);
	UVCHECK(t.GTP_target == @UVContent && t.GTP_class == &UVContentClass);
	@call UVContent::MSG_META_GET_TARGET_AT_TARGET_LEVEL(&t, TL_TARGET);
	UVCHECK(t.GTP_target == @UVCA && t.GTP_class == &UVGadClass);

	/* classed events to the target and to the focus */
	ev = @record UVGadClass::MSG_UVG_PING();
	@call UVContent::MSG_META_SEND_CLASSED_EVENT(ev,
						     (TravelOption) TO_TARGET);
	UVCHECK(ga->UG_pings == 1 && !gb->UG_pings);
	ev = @record UVGadClass::MSG_UVG_PING();
	@call UVContent::MSG_META_SEND_CLASSED_EVENT(ev,
						     (TravelOption) TO_FOCUS);
	UVCHECK(ga->UG_pings == 1 && gb->UG_pings == 1);

	/* a large mouse event to the content goes to the target */
	memset(&l, 0, sizeof(l));
	l.LMD_location.PDF_x.DWF_int = 7;
	@call UVContent::MSG_META_LARGE_START_SELECT(&r, &l);
	UVCHECK(r.flags == MRF_PROCESSED && ga->UG_large == 1 &&
		ga->UG_largeX == 7);

	/* input held up: it waits (pointer events with the same buttons
	 * as one), and comes after this step when it may flow again */
	@call UVContent::MSG_VIS_CONTENT_HOLD_UP_INPUT_FLOW();
	@call UVContent::MSG_VIS_CONTENT_HOLD_UP_INPUT_FLOW();
	@call UVContent::MSG_META_START_SELECT(&r, 10, 10, 0);
	UVCHECK(r.flags == MRF_PROCESSED);
	@call UVContent::MSG_META_PTR(&r, 1, 1, 0);
	@call UVContent::MSG_META_PTR(&r, 2, 2, 0);
	@call UVContent::MSG_META_PTR(&r, 3, 3, 0x0100);
	@call UVContent::MSG_META_KBD_CHAR('e', 0, 0);
	UVCHECK(Content().VCNI_holdUpInputQueue &&
		GeodeInfoQueue(Content().VCNI_holdUpInputQueue) == 4);
	UVCHECK(!ga->UG_selects && !ga->UG_ptrs && gb->UG_chars == 1);
	@call UVContent::MSG_VIS_CONTENT_RESUME_INPUT_FLOW();
	UVCHECK(Content().VCNI_holdUpInputQueue && !ga->UG_selects);
	@call UVContent::MSG_VIS_CONTENT_RESUME_INPUT_FLOW();
	UVCHECK(!Content().VCNI_holdUpInputQueue && !ga->UG_selects);
	break;
    }
    case 14: {
	WindowHandle win = uvState.UVS_cwin;

	/* what was held up has come, in order */
	UVCHECK(ga->UG_selects == 1 && ga->UG_ptrs == 2 &&
		ga->UG_firstPtrX == 2 && ga->UG_x == 3 &&
		ga->UG_state == (0x0100 | (UIFA_IN << 8)));
	UVCHECK(gb->UG_chars == 2);

	/* held up, but not while that is disabled */
	@call UVContent::MSG_VIS_CONTENT_HOLD_UP_INPUT_FLOW();
	@call UVContent::MSG_VIS_CONTENT_DISABLE_HOLD_UP();
	@call UVContent::MSG_META_KBD_CHAR('f', 0, 0);
	UVCHECK(gb->UG_chars == 3);
	@call UVContent::MSG_VIS_CONTENT_ENABLE_HOLD_UP();
	@call UVContent::MSG_VIS_CONTENT_RESUME_INPUT_FLOW();

	/* the view closes: not realized, unlinked, no window */
	@call UVContent::MSG_META_CONTENT_VIEW_CLOSING();
	UVCHECK(!(Attrs(@UVContent) & VA_REALIZED) &&
		!(Attrs(@UVCA) & VA_REALIZED));
	UVCHECK(@call UVContent::MSG_VIS_FIND_PARENT() == 0);
	UVCHECK(!Content().VCI_window && Content().VCNI_window == win);
	UVCHECK(ImpliedGrab(0, 0));
	@call UVContent::MSG_META_CONTENT_VIEW_WIN_CLOSED(win);
	UVCHECK(!Content().VCNI_window);
	WinClose(win);
	uvState.UVS_cwin = 0;
	break;
    }
    }
}

/* the test's way in: a step on the process thread */
void UVStep(word step)
{
    optr p = ConstructOptr(uvState.UVS_process, 0);

    @call p::MSG_UV_STEP(step);
}
