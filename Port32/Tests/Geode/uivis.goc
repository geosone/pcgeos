/*
 * uivis.goc -- a process geode for the library.ui.vis test (Port32/Tests):
 * a visual tree of the UI library's VisClass and VisCompClass in a window.
 *
 * UVTop (a VisCompClass window and win group) has two rectangles, UVRectA
 * and UVRectB, that count what they get.  The test (test_ui_vis.c) gives
 * the root window in uvState and runs the steps one by one through
 * UVStep, which calls the process (MSG_UV_STEP runs on its thread, which
 * runs the objects); the exposures come after a step, on the queue.  The
 * checks made here count in uvState (the first failing line kept).
 *
 * UVGeo is a composite outside the window whose children the geometry
 * manager sizes and places (steps 7 to 9): three rectangles of fixed
 * sizes, and UVGeo2 with a rectangle and a child that takes the length
 * it is offered.
 *
 * UVNode has a basic and a hierarchical grab for the Flow routines
 * (step 10), UVLeaf1 and UVLeaf2 count the messages they get from it.
 */
@include <stdapp.goh>
@include <Objects/vCompC.goh>
#include <string.h>

/* visC.def (uiInt.goh has them for the library) */
#define VOF_PATH_BITS		(VOF_GEO_UPDATE_PATH | VOF_WINDOW_UPDATE_PATH | \
				 VOF_IMAGE_UPDATE_PATH)
#define VOF_INVALID_BITS	(VOF_GEOMETRY_INVALID | VOF_WINDOW_INVALID | \
				 VOF_IMAGE_INVALID)
#define VOF_UPDATING		VOF_EC_UPDATING

typedef struct {
    WindowHandle	UVS_root;	/* from the test */
    GeodeHandle		UVS_process;
    word		UVS_attached;
    word		UVS_checks, UVS_fails, UVS_failLine;
    word		UVS_drawsA, UVS_drawsB;
    word		UVS_selectsA, UVS_selectsB;
    word		UVS_lostA, UVS_lostB;
    word		UVS_pings;
    WindowHandle	UVS_win;	/* UVTop's window */
    word		UVS_failLines[8];
    /* by UVNI_which: gained, lost, gained system, lost system */
    word		UVS_flow[3][4];
} UVState;

UVState uvState;

#define UVCHECK(c) \
    do { uvState.UVS_checks++; if (!(c)) { \
	if (uvState.UVS_fails < 8) \
	    uvState.UVS_failLines[uvState.UVS_fails] = __LINE__; \
	uvState.UVS_fails++; \
	if (!uvState.UVS_failLine) uvState.UVS_failLine = __LINE__; } \
    } while (0)

@class UVProcessClass, ProcessClass;
    @message void MSG_UV_STEP(word step);
@endc
@classdecl UVProcessClass, neverSaved;

/* the window: opened on the root, with the bounds */
@class UVWinClass, VisCompClass;
    @message void MSG_UV_PING();
@endc
@classdecl UVWinClass;

/* a rectangle of its colour */
@class UVRectClass, VisClass;
    @instance Color UVRI_color = C_BLACK;
    @instance word UVRI_which = 0;
@endc
@classdecl UVRectClass;

/* takes the size it is offered; 10x10 if it may choose */
@class UVFlexClass, VisClass;
@endc
@classdecl UVFlexClass;

@method UVFlexClass, MSG_VIS_RECALC_SIZE
{
    return MAKE_SIZE_DWORD(width & RSA_CHOOSE_OWN_SIZE ? 10 : width,
			   height & RSA_CHOOSE_OWN_SIZE ? 10 : height);
}

/* a node of a hierarchy, and what is below it */
@class UVNodeClass, VisClass;
    @message void MSG_UVN_GAINED();	/* the four in this order */
    @message void MSG_UVN_LOST();
    @message void MSG_UVN_GAINED_SYS();
    @message void MSG_UVN_LOST_SYS();
    @instance BasicGrab UVNI_grab = { 0, 0 };
    @instance HierarchicalGrab UVNI_excl = { 0, 0 };
    @instance word UVNI_which = 0;
@endc
@classdecl UVNodeClass;

@method UVNodeClass, MSG_UVN_GAINED, MSG_UVN_LOST, MSG_UVN_GAINED_SYS,
		     MSG_UVN_LOST_SYS
{
    uvState.UVS_flow[pself->UVNI_which][message - MSG_UVN_GAINED]++;
}

@start UVObjects;
@object UVWinClass UVTop = {
    VI_bounds = { 10, 10, 210, 110 };
    VI_typeFlags = VTF_IS_COMPOSITE | VTF_IS_WINDOW | VTF_IS_WIN_GROUP;
    VCI_comp = @UVRectA, @UVRectB;
    /* the rectangles stay where they are */
    VCI_geoAttrs = VCGA_CUSTOM_MANAGE_CHILDREN;
}
@object UVRectClass UVRectA = {
    VI_bounds = { 5, 5, 55, 45 };
    UVRI_color = C_RED;
    UVRI_which = 0;
}
@object UVRectClass UVRectB = {
    VI_bounds = { 100, 20, 150, 60 };
    UVRI_color = C_BLUE;
    UVRI_which = 1;
}

/* the geometry manager's: 50x40, 30x20, 20x60 */
@object VisCompClass UVGeo = {
    VCI_comp = @UVGeoA, @UVGeoB, @UVGeoC;
}
@object UVRectClass UVGeoA = {
    VI_bounds = { 0, 0, 50, 40 };
}
@object UVRectClass UVGeoB = {
    VI_bounds = { 0, 0, 30, 20 };
}
@object UVRectClass UVGeoC = {
    VI_bounds = { 0, 0, 20, 60 };
}
@object VisCompClass UVGeo2 = {
    VCI_comp = @UVGeoD, @UVFlex;
    VCI_geoDimensionAttrs = VCGDA_EXPAND_WIDTH_TO_FIT_PARENT;
}
@object UVRectClass UVGeoD = {
    VI_bounds = { 0, 0, 50, 40 };
}
@object UVFlexClass UVFlex = {
}
@object UVNodeClass UVNode = {
    UVNI_which = 0;
}
@object UVNodeClass UVLeaf1 = {
    UVNI_which = 1;
}
@object UVNodeClass UVLeaf2 = {
    UVNI_which = 2;
}
@end UVObjects;

@method UVWinClass, MSG_VIS_OPEN_WIN
{
    Rectangle b = pself->VI_bounds;

    pself->VCI_window = WinOpen(parentWindow ? parentWindow
					     : uvState.UVS_root,
				oself, oself, CMT_CLOSEST, C_WHITE, 0, 0, 0,
				0, 0, NULL, b.R_left, b.R_top, b.R_right - 1,
				b.R_bottom - 1);
    uvState.UVS_win = pself->VCI_window;
}

@method UVWinClass, MSG_UV_PING
{
    uvState.UVS_pings++;
}

@method UVRectClass, MSG_VIS_DRAW
{
    (void) drawFlags;
    GrSetAreaColor(gstate, CF_INDEX, pself->UVRI_color, 0, 0);
    GrFillRect(gstate, pself->VI_bounds.R_left, pself->VI_bounds.R_top,
	       pself->VI_bounds.R_right, pself->VI_bounds.R_bottom);
    if (pself->UVRI_which)
	uvState.UVS_drawsB++;
    else
	uvState.UVS_drawsA++;
}

@method UVRectClass, MSG_META_START_SELECT
{
    (void) xPosition;
    (void) yPosition;
    (void) inputState;
    if (pself->UVRI_which)
	uvState.UVS_selectsB++;
    else
	uvState.UVS_selectsA++;
    retVal->flags = MRF_PROCESSED;
}

@method UVRectClass, MSG_VIS_LOST_GADGET_EXCL
{
    if (pself->UVRI_which)
	uvState.UVS_lostB++;
    else
	uvState.UVS_lostA++;
}

@method UVProcessClass, MSG_META_ATTACH_PROCESS
{
    (void) value1;
    (void) value2;
    uvState.UVS_process = GeodeGetProcessHandle();
    uvState.UVS_attached++;
}

static VisAttrs Attrs(optr o)
{
    return @call o::MSG_VIS_GET_ATTRS();
}

static VisOptFlags Opt(optr o)
{
    return @call o::MSG_VIS_GET_OPT_FLAGS();
}

static WindowHandle TopWin(void)
{
    VisCompInstance *v;
    WindowHandle w;

    ObjLockObjBlock(OptrToHandle(@UVTop));
    v = ObjDerefVis(@UVTop);
    w = v->VCI_window;
    MemUnlock(OptrToHandle(@UVTop));
    return w;
}

/* the geometry of a composite for the size passed, at (x, y) */
static SizeAsDWord Geo(optr comp, word width, word height, sword x, sword y,
		       word info)
{
    SizeAsDWord s = VisCompRecalcSize(comp, width, height, info);

    VisSetSize(comp, DWORD_WIDTH(s), DWORD_HEIGHT(s));
    VisCompPosition(comp, x, y, info);
    return s;
}

static void GeoAttrs(optr comp, byte geo, byte dim)
{
    GeoAndDimensionAttrs set, clear;

    set.GADA_geoAttrs = geo;
    set.GADA_geoDimensionAttrs = dim;
    clear.GADA_geoAttrs = ~geo;
    clear.GADA_geoDimensionAttrs = ~dim;
    @call comp::MSG_VIS_COMP_SET_GEO_ATTRS(set, clear);
}

/* an object's bounds */
static Boolean At(optr o, sword l, sword t, sword r, sword b)
{
    Rectangle x;

    @call o::MSG_VIS_GET_BOUNDS(&x);
    return x.R_left == l && x.R_top == t && x.R_right == r &&
	   x.R_bottom == b;
}

#define OWN	RSA_CHOOSE_OWN_SIZE

/* UVNode's grabs */
#define NODE_MASTER	word_offsetof(VisBase, Vis_offset)
#define NODE_GRAB	word_offsetof(UVNodeInstance, UVNI_grab)
#define NODE_EXCL	word_offsetof(UVNodeInstance, UVNI_excl)

static Boolean NodeGrab(optr od, word data)
{
    UVNodeInstance *n;
    Boolean ok;

    ObjLockObjBlock(OptrToHandle(@UVNode));
    n = ObjDerefVis(@UVNode);
    ok = n->UVNI_grab.BG_OD == od && n->UVNI_grab.BG_data == data;
    MemUnlock(OptrToHandle(@UVNode));
    return ok;
}

static Boolean NodeExcl(optr od, word flags)
{
    UVNodeInstance *n;
    Boolean ok;

    ObjLockObjBlock(OptrToHandle(@UVNode));
    n = ObjDerefVis(@UVNode);
    ok = n->UVNI_excl.HG_OD == od && n->UVNI_excl.HG_flags == flags;
    MemUnlock(OptrToHandle(@UVNode));
    return ok;
}

/* what a leaf has got: gained, lost, gained system, lost system */
static Boolean Got(word which, word g, word l, word gs, word ls)
{
    word *f = uvState.UVS_flow[which];

    return f[0] == g && f[1] == l && f[2] == gs && f[3] == ls;
}

@method UVProcessClass, MSG_UV_STEP
{
    switch (step) {
    case 1: {
	/* the tree, then opened by making the win group visible */
	GStateHandle gs;
	EventHandle ev;

	UVCHECK(@call UVRectA::MSG_VIS_FIND_PARENT() == @UVTop);
	UVCHECK(@call UVTop::MSG_VIS_FIND_PARENT() == 0);
	UVCHECK(@call UVTop::MSG_VIS_COUNT_CHILDREN() == 2);
	UVCHECK(@call UVTop::MSG_VIS_FIND_CHILD(@UVRectB) == 1);
	UVCHECK(@call UVTop::MSG_VIS_FIND_CHILD(@UVTop) == (word) -1);
	UVCHECK(@call UVTop::MSG_VIS_FIND_CHILD_AT_POSITION(0) == @UVRectA);
	UVCHECK(@call UVRectB::MSG_VIS_VUP_FIND_OBJECT_OF_CLASS(&UVWinClass)
		== @UVTop);
	UVCHECK(@call UVRectB::MSG_VIS_VUP_TEST_FOR_OBJECT_OF_CLASS(
		    &UVRectClass));
	UVCHECK(!@call UVTop::MSG_VIS_VUP_TEST_FOR_OBJECT_OF_CLASS(
		    &UVRectClass));
	UVCHECK(@call UVRectA::MSG_VIS_GET_SIZE() == MAKE_SIZE_DWORD(50, 40));
	UVCHECK(@call UVTop::MSG_VIS_GET_TYPE_FLAGS() ==
		(VTF_IS_COMPOSITE | VTF_IS_WINDOW | VTF_IS_WIN_GROUP));
	UVCHECK(!(Attrs(@UVTop) & VA_REALIZED) && !TopWin());

	/* a classed event up the tree to the window's class */
	ev = @record UVWinClass::MSG_UV_PING();
	@call UVRectA::MSG_META_SEND_CLASSED_EVENT(ev,
						   (TravelOption) TO_VIS_PARENT);
	UVCHECK(uvState.UVS_pings == 1);

	@call UVTop::MSG_VIS_SET_ATTRS(VA_VISIBLE, 0, VUM_NOW);
	UVCHECK(Attrs(@UVTop) & VA_REALIZED && TopWin() &&
		TopWin() == uvState.UVS_win);
	UVCHECK(Attrs(@UVRectA) & VA_REALIZED &&
		Attrs(@UVRectB) & VA_REALIZED);
	UVCHECK(!(Opt(@UVTop) & (VOF_INVALID_BITS | VOF_PATH_BITS |
				 VOF_UPDATING | VOF_UPDATE_PENDING)));
	UVCHECK(!(Opt(@UVRectA) & (VOF_IMAGE_INVALID | VOF_WINDOW_INVALID)));
	/* VisQueryWindow wants a built object (VI_link set): UVTop has no
	 * parent (the field, in a real UI), so there is none above A */
	UVCHECK(@call UVRectA::MSG_VIS_QUERY_WINDOW() == 0);

	/* a gstate of the win group's window */
	gs = @call UVRectA::MSG_VIS_VUP_CREATE_GSTATE();
	UVCHECK(gs && GrGetWinHandle(gs) == TopWin());
	GrDestroyState(gs);
	break;
    }
    case 2:
	/* A's image invalid, updated now: only A is drawn again */
	@call UVRectA::MSG_VIS_MARK_INVALID(VOF_IMAGE_INVALID, VUM_NOW);
	UVCHECK(!(Opt(@UVRectA) & VOF_IMAGE_INVALID) &&
		!(Opt(@UVTop) & (VOF_IMAGE_UPDATE_PATH | VOF_UPDATING)));
	break;
    case 3: {
	/* the mouse to the child under the point */
	MouseReturnParams r;

	@call UVTop::MSG_META_START_SELECT(&r, 120, 30, 0);
	UVCHECK(r.flags == MRF_PROCESSED && uvState.UVS_selectsB == 1 &&
		!uvState.UVS_selectsA);
	@call UVTop::MSG_META_START_SELECT(&r, 10, 10, 0);
	UVCHECK(r.flags == MRF_PROCESSED && uvState.UVS_selectsA == 1);
	@call UVTop::MSG_META_START_SELECT(&r, 80, 80, 0);
	UVCHECK(r.flags == 0 && uvState.UVS_selectsA == 1 &&
		uvState.UVS_selectsB == 1);
	@call UVTop::MSG_META_PTR(&r, 80, 80, 0);
	UVCHECK(r.flags == MRF_CLEAR_POINTER_IMAGE);

	/* the gadget exclusive */
	@call UVTop::MSG_VIS_TAKE_GADGET_EXCL(@UVRectA);
	@call UVTop::MSG_VIS_TAKE_GADGET_EXCL(@UVRectB);
	UVCHECK(uvState.UVS_lostA == 1 && !uvState.UVS_lostB);
	@call UVTop::MSG_VIS_RELEASE_GADGET_EXCL(@UVRectA);
	UVCHECK(!uvState.UVS_lostB);
	@call UVTop::MSG_VIS_RELEASE_GADGET_EXCL(@UVRectB);
	UVCHECK(uvState.UVS_lostB == 1);
	break;
    }
    case 4:
	/* B out of the tree: closed.  Its parent manages its children
	 * itself, so its geometry is not touched and nothing updates: the
	 * area waits in the win group's update region for the next one. */
	@call UVRectB::MSG_VIS_REMOVE(VUM_NOW);
	(void) @call UVTop::MSG_VIS_VUP_UPDATE_WIN_GROUP(VUM_NOW);
	UVCHECK(@call UVTop::MSG_VIS_COUNT_CHILDREN() == 1);
	UVCHECK(!(Attrs(@UVRectB) & VA_REALIZED));
	UVCHECK(@call UVRectB::MSG_VIS_FIND_PARENT() == 0);
	break;
    case 5:
	/* B back: opened by the update, drawn */
	@call UVTop::MSG_VIS_ADD_CHILD(@UVRectB, CCO_LAST);
	@call UVRectB::MSG_VIS_MARK_INVALID(VOF_WINDOW_INVALID |
					    VOF_IMAGE_INVALID, VUM_NOW);
	UVCHECK(@call UVTop::MSG_VIS_FIND_CHILD(@UVRectB) == 1);
	UVCHECK(Attrs(@UVRectB) & VA_REALIZED);
	break;
    case 6:
	/* closed: the window goes */
	@call UVTop::MSG_VIS_SET_ATTRS(0, VA_VISIBLE, VUM_NOW);
	UVCHECK(!(Attrs(@UVTop) & VA_REALIZED) && !TopWin());
	UVCHECK(!(Attrs(@UVRectA) & VA_REALIZED) &&
		!(Attrs(@UVRectB) & VA_REALIZED));
	break;
    case 7: {
	/* the geometry manager: a horizontal line with the default
	 * spacing (3), through the update */
	GeoAndDimensionAttrs a;
	GetCenterParams c;

	UVCHECK(@call UVGeo::MSG_VIS_COMP_GET_CHILD_SPACING() ==
		MAKE_SPACING_DWORD(3, 3));
	@call UVGeo::MSG_VIS_SET_POSITION(10, 20);
	@call UVGeo::MSG_VIS_UPDATE_GEOMETRY();
	UVCHECK(At(@UVGeo, 10, 20, 116, 80));
	UVCHECK(At(@UVGeoA, 10, 20, 60, 60) && At(@UVGeoB, 63, 20, 93, 40) &&
		At(@UVGeoC, 96, 20, 116, 80));
	UVCHECK(!(Opt(@UVGeo) & (VOF_GEOMETRY_INVALID | VOF_GEO_UPDATE_PATH)));

	/* vertical */
	GeoAttrs(@UVGeo, VCGA_ORIENT_CHILDREN_VERTICALLY, 0);
	a = @call UVGeo::MSG_VIS_COMP_GET_GEO_ATTRS();
	UVCHECK(a.GADA_geoAttrs == VCGA_ORIENT_CHILDREN_VERTICALLY &&
		!a.GADA_geoDimensionAttrs);
	UVCHECK(Geo(@UVGeo, OWN, OWN, 10, 20, 0) == MAKE_SIZE_DWORD(50, 126));
	UVCHECK(At(@UVGeoA, 10, 20, 60, 60) && At(@UVGeoB, 10, 63, 40, 83) &&
		At(@UVGeoC, 10, 86, 30, 146));
	/* centered across */
	GeoAttrs(@UVGeo, VCGA_ORIENT_CHILDREN_VERTICALLY,
		 WJ_CENTER_CHILDREN_HORIZONTALLY);
	UVCHECK(Geo(@UVGeo, OWN, OWN, 10, 20, 0) == MAKE_SIZE_DWORD(50, 126));
	UVCHECK(At(@UVGeoA, 10, 20, 60, 60) && At(@UVGeoB, 20, 63, 50, 83) &&
		At(@UVGeoC, 25, 86, 45, 146));
	@call UVGeo::MSG_VIS_GET_CENTER(&c);
	UVCHECK(c.GCP_leftOfCenter == 25 && c.GCP_rightOfCenter == 25 &&
		c.GCP_aboveCenter == 63 && c.GCP_belowCenter == 63);

	/* horizontal, the children at the bottom, in the middle */
	GeoAttrs(@UVGeo, 0, HJ_BOTTOM_JUSTIFY_CHILDREN);
	UVCHECK(Geo(@UVGeo, OWN, OWN, 10, 20, 0) == MAKE_SIZE_DWORD(106, 60));
	UVCHECK(At(@UVGeoA, 10, 40, 60, 80) && At(@UVGeoB, 63, 60, 93, 80) &&
		At(@UVGeoC, 96, 20, 116, 80));
	GeoAttrs(@UVGeo, 0, HJ_CENTER_CHILDREN_VERTICALLY);
	UVCHECK(Geo(@UVGeo, OWN, OWN, 10, 20, 0) == MAKE_SIZE_DWORD(106, 60));
	UVCHECK(At(@UVGeoA, 10, 30, 60, 70) && At(@UVGeoB, 63, 40, 93, 60) &&
		At(@UVGeoC, 96, 20, 116, 80));
	break;
    }
    case 8:
	/* expanding to 200 wide: at the right, centered, spread out */
	GeoAttrs(@UVGeo, 0, VCGDA_EXPAND_WIDTH_TO_FIT_PARENT |
			    WJ_RIGHT_JUSTIFY_CHILDREN);
	UVCHECK(Geo(@UVGeo, 200, OWN, 10, 20, 0) == MAKE_SIZE_DWORD(200, 60));
	UVCHECK(At(@UVGeoA, 104, 20, 154, 60) &&
		At(@UVGeoB, 157, 20, 187, 40) &&
		At(@UVGeoC, 190, 20, 210, 80));
	GeoAttrs(@UVGeo, 0, VCGDA_EXPAND_WIDTH_TO_FIT_PARENT |
			    WJ_CENTER_CHILDREN_HORIZONTALLY);
	UVCHECK(Geo(@UVGeo, 200, OWN, 10, 20, 0) == MAKE_SIZE_DWORD(200, 60));
	UVCHECK(At(@UVGeoA, 57, 20, 107, 60) &&
		At(@UVGeoB, 110, 20, 140, 40) &&
		At(@UVGeoC, 143, 20, 163, 80));
	GeoAttrs(@UVGeo, 0, VCGDA_EXPAND_WIDTH_TO_FIT_PARENT |
			    WJ_FULL_JUSTIFY_CHILDREN_HORIZONTALLY);
	UVCHECK(Geo(@UVGeo, 200, OWN, 10, 20, 0) == MAKE_SIZE_DWORD(200, 60));
	UVCHECK(At(@UVGeoA, 10, 20, 60, 60) &&
		At(@UVGeoB, 110, 20, 140, 40) &&
		At(@UVGeoC, 190, 20, 210, 80));
	/* not expanding: its own size whatever is passed */
	GeoAttrs(@UVGeo, 0, 0);
	UVCHECK(Geo(@UVGeo, 200, 200, 0, 0, 0) == MAKE_SIZE_DWORD(106, 60));

	/* spacing 5 and margins 2, 1, 2, 1 passed */
	UVCHECK(Geo(@UVGeo, OWN, OWN, 0, 0,
		    VCSMI_USE_THIS_INFO | 2 << 12 | 1 << 9 | 2 << 6 | 1 << 3 |
		    5) == MAKE_SIZE_DWORD(114, 62));
	UVCHECK(At(@UVGeoA, 2, 1, 52, 41) && At(@UVGeoB, 57, 1, 87, 21) &&
		At(@UVGeoC, 92, 1, 112, 61));
	/* the ends in the spacing */
	GeoAttrs(@UVGeo, VCGA_INCLUDE_ENDS_IN_CHILD_SPACING, 0);
	UVCHECK(Geo(@UVGeo, OWN, OWN, 0, 0, 0) == MAKE_SIZE_DWORD(112, 60));
	UVCHECK(At(@UVGeoA, 3, 0, 53, 40) && At(@UVGeoB, 56, 0, 86, 20) &&
		At(@UVGeoC, 89, 0, 109, 60));
	break;
    case 9:
	/* wrapping in 90: two on the first line, the third below it (the
	 * line width 60, the spacing 3) */
	GeoAttrs(@UVGeo, VCGA_ALLOW_CHILDREN_TO_WRAP, 0);
	UVCHECK(Geo(@UVGeo, 90, OWN, 0, 0, 0) == MAKE_SIZE_DWORD(83, 123));
	UVCHECK(At(@UVGeoA, 0, 0, 50, 40) && At(@UVGeoB, 53, 0, 83, 20) &&
		At(@UVGeoC, 0, 63, 20, 123));
	/* a child out of the geometry */
	GeoAttrs(@UVGeo, 0, 0);
	@call UVGeoB::MSG_VIS_SET_ATTRS(0, VA_MANAGED, VUM_MANUAL);
	UVCHECK(Geo(@UVGeo, OWN, OWN, 0, 0, 0) == MAKE_SIZE_DWORD(73, 60));
	UVCHECK(At(@UVGeoA, 0, 0, 50, 40) && At(@UVGeoB, 53, 0, 83, 20) &&
		At(@UVGeoC, 53, 0, 73, 60));
	@call UVGeoB::MSG_VIS_SET_ATTRS(VA_MANAGED, 0, VUM_MANUAL);

	/* a child that takes what is left of 200; then squeezed to 120 */
	UVCHECK(Geo(@UVGeo2, 200, OWN, 0, 0, 0) == MAKE_SIZE_DWORD(200, 40));
	UVCHECK(At(@UVGeoD, 0, 0, 50, 40) && At(@UVFlex, 53, 0, 200, 40));
	UVCHECK(Geo(@UVGeo2, 120, OWN, 0, 0, 0) == MAKE_SIZE_DWORD(120, 40));
	UVCHECK(At(@UVGeoD, 0, 0, 50, 40) && At(@UVFlex, 53, 0, 120, 40));
	/* left to choose, an object with valid geometry keeps its size;
	 * invalid, it is asked */
	UVCHECK(Geo(@UVGeo2, OWN, OWN, 0, 0, 0) == MAKE_SIZE_DWORD(120, 40));
	@call UVFlex::MSG_VIS_MARK_INVALID(VOF_GEOMETRY_INVALID, VUM_MANUAL);
	UVCHECK(Geo(@UVGeo2, OWN, OWN, 0, 0, 0) == MAKE_SIZE_DWORD(63, 40));
	/* a composite in a composite, the inner one expanding */
	@call UVGeo::MSG_VIS_ADD_CHILD(@UVGeo2, CCO_LAST);
	GeoAttrs(@UVGeo, VCGA_ORIENT_CHILDREN_VERTICALLY, 0);
	UVCHECK(Geo(@UVGeo, OWN, OWN, 0, 0, 0) == MAKE_SIZE_DWORD(63, 169));
	UVCHECK(At(@UVGeo2, 0, 129, 63, 169) && At(@UVGeoD, 0, 129, 50, 169) &&
		At(@UVFlex, 53, 129, 63, 169));
	break;
    case 10: {
	/* the Flow routines.  A basic grab: asked for, forced, released */
	GetTargetParams t;
	EventHandle ev, outer;

	UVCHECK(FlowRequestGrab(@UVNode, MSG_UVN_GAINED, NODE_MASTER,
				NODE_GRAB, @UVLeaf1, 7));
	UVCHECK(NodeGrab(@UVLeaf1, 7) && Got(1, 1, 0, 0, 0));
	UVCHECK(!FlowRequestGrab(@UVNode, MSG_UVN_GAINED, NODE_MASTER,
				 NODE_GRAB, @UVLeaf2, 8));
	UVCHECK(NodeGrab(@UVLeaf1, 7) && Got(2, 0, 0, 0, 0));
	UVCHECK(FlowForceGrab(@UVNode, MSG_UVN_GAINED, NODE_MASTER, NODE_GRAB,
			      @UVLeaf2, 8));
	UVCHECK(NodeGrab(@UVLeaf2, 8) && Got(1, 1, 1, 0, 0) &&
		Got(2, 1, 0, 0, 0));
	UVCHECK(!FlowForceGrab(@UVNode, MSG_UVN_GAINED, NODE_MASTER,
			       NODE_GRAB, @UVLeaf2, 9));
	UVCHECK(NodeGrab(@UVLeaf2, 9) && Got(2, 1, 0, 0, 0));
	UVCHECK(!FlowReleaseGrab(@UVNode, MSG_UVN_GAINED, NODE_MASTER,
				 NODE_GRAB, @UVLeaf1));
	UVCHECK(FlowReleaseGrab(@UVNode, MSG_UVN_GAINED, NODE_MASTER,
				NODE_GRAB, @UVLeaf2));
	UVCHECK(NodeGrab(0, 0) && Got(2, 1, 1, 0, 0));
	memset(uvState.UVS_flow, 0, sizeof(uvState.UVS_flow));

	/* a hierarchical grab.  The node has no exclusive: only noted */
	FlowAlterHierarchicalGrab(@UVNode, MSG_UVN_GAINED, NODE_MASTER,
				  NODE_EXCL, @UVLeaf1, HGF_GRAB | 5);
	UVCHECK(NodeExcl(@UVLeaf1, HGF_GRAB | 5) && Got(1, 0, 0, 0, 0));
	/* the node gains the exclusive: so does the one below */
	FlowUpdateHierarchicalGrab(@UVNode, MSG_UVN_GAINED, NODE_MASTER,
				   NODE_EXCL, MSG_UVN_GAINED);
	UVCHECK(NodeExcl(@UVLeaf1, HGF_APP_EXCL | HGF_GRAB | 5) &&
		Got(1, 1, 0, 0, 0));
	/* another one below */
	FlowAlterHierarchicalGrab(@UVNode, MSG_UVN_GAINED, NODE_MASTER,
				  NODE_EXCL, @UVLeaf2, HGF_GRAB);
	UVCHECK(NodeExcl(@UVLeaf2, HGF_APP_EXCL | HGF_GRAB) &&
		Got(1, 1, 1, 0, 0) && Got(2, 1, 0, 0, 0));
	/* the system exclusive, and a change under it */
	FlowUpdateHierarchicalGrab(@UVNode, MSG_UVN_GAINED, NODE_MASTER,
				   NODE_EXCL, MSG_UVN_GAINED_SYS);
	UVCHECK(NodeExcl(@UVLeaf2, HGF_SYS_EXCL | HGF_APP_EXCL | HGF_GRAB) &&
		Got(2, 1, 0, 1, 0));
	FlowAlterHierarchicalGrab(@UVNode, MSG_UVN_GAINED, NODE_MASTER,
				  NODE_EXCL, @UVLeaf1, HGF_GRAB);
	UVCHECK(NodeExcl(@UVLeaf1, HGF_SYS_EXCL | HGF_APP_EXCL | HGF_GRAB) &&
		Got(2, 1, 1, 1, 1) && Got(1, 2, 1, 1, 0));

	/* the target at a level: the node's own, the leaf, none */
	FlowGetTargetAtTargetLevel(@UVNode, NODE_MASTER, NODE_EXCL, 5, 5, &t);
	UVCHECK(t.GTP_target == @UVNode && t.GTP_class == &UVNodeClass);
	FlowGetTargetAtTargetLevel(@UVNode, NODE_MASTER, NODE_EXCL, 5, 0, &t);
	UVCHECK(t.GTP_target == @UVLeaf1 && t.GTP_class == &UVNodeClass);
	FlowGetTargetAtTargetLevel(@UVNode, NODE_MASTER, NODE_EXCL, 5, 7, &t);
	UVCHECK(!t.GTP_target && !t.GTP_class);

	/* released by one that does not have it, by the one that has */
	FlowAlterHierarchicalGrab(@UVNode, MSG_UVN_GAINED, NODE_MASTER,
				  NODE_EXCL, @UVLeaf2, 0);
	UVCHECK(Got(1, 2, 1, 1, 0));
	FlowAlterHierarchicalGrab(@UVNode, MSG_UVN_GAINED, NODE_MASTER,
				  NODE_EXCL, @UVLeaf1, 0);
	UVCHECK(NodeExcl(0, HGF_SYS_EXCL | HGF_APP_EXCL) &&
		Got(1, 2, 2, 1, 1));
	FlowGetTargetAtTargetLevel(@UVNode, NODE_MASTER, NODE_EXCL, 5, 0, &t);
	UVCHECK(t.GTP_target == @UVNode);
	FlowUpdateHierarchicalGrab(@UVNode, MSG_UVN_GAINED, NODE_MASTER,
				   NODE_EXCL, MSG_UVN_LOST_SYS);
	FlowUpdateHierarchicalGrab(@UVNode, MSG_UVN_GAINED, NODE_MASTER,
				   NODE_EXCL, MSG_UVN_LOST);
	UVCHECK(NodeExcl(0, 0) && Got(1, 2, 2, 1, 1) && Got(2, 1, 1, 1, 1));

	/* classed events: dispatched at an object of the class, sent on,
	 * destroyed (with the event it carries) */
	memset(uvState.UVS_flow, 0, sizeof(uvState.UVS_flow));
	ev = @record UVNodeClass::MSG_UVN_GAINED();
	UVCHECK(FlowDispatchSendOnOrDestroyClassedEvent(NULL, @UVLeaf1,
		    MSG_META_SEND_CLASSED_EVENT, ev, TO_SELF, 0, 0));
	UVCHECK(Got(1, 1, 0, 0, 0));
	ev = @record UVWinClass::MSG_UV_PING();
	UVCHECK(!FlowDispatchSendOnOrDestroyClassedEvent(NULL, @UVLeaf1,
		    MSG_META_SEND_CLASSED_EVENT, ev, TO_SELF, 0, 0));
	ev = @record UVNodeClass::MSG_UVN_LOST();
	UVCHECK(FlowMessageClassedEvent(@UVLeaf2, MSG_META_SEND_CLASSED_EVENT,
					ev, TO_SELF, 0));
	UVCHECK(Got(2, 0, 1, 0, 0));
	ev = @record UVNodeClass::MSG_UVN_LOST();
	outer = @record UVNodeClass::MSG_META_SEND_CLASSED_EVENT(ev, TO_SELF);
	FlowDestroyMessage(outer);
	UVCHECK(Got(2, 0, 1, 0, 0) && uvState.UVS_pings == 1);
	break;
    }
    }
}

/* the test's way in: a step on the process thread */
void UVStep(word step)
{
    optr p = ConstructOptr(uvState.UVS_process, 0);

    @call p::MSG_UV_STEP(step);
}
