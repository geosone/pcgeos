typedef struct {
    GeodeHandle		UBS_process;
    word		UBS_attached;
    word		UBS_opened;
    word		UBS_checks, UBS_fails, UBS_failLine;
    word		UBS_failLines[8];
    WindowHandle	UBS_primaryWin;
    WindowHandle	UBS_groupWin;
    word		UBS_displayNotices;	/* GWNT_DISPLAY_CHANGE */
    word		UBS_listNotices;	/* GWNT_DISPLAY_LIST_CHANGE */
    word		UBS_lastNum;		/* the last display's */
    char		UBS_lastName[16];
    byte		UBS_lastOverlapping;
    sword		UBS_gw, UBS_gh;		/* the group's size */
    sword		UBS_dl, UBS_dt, UBS_dw, UBS_dh;	/* UBDoc1's */
    /* the primary's system menu button (left, top, width, height) and
     * the left and right of its title bar */
    sword		UBS_sys[6];
    optr		UBS_maxIcon, UBS_restoreIcon;
    optr		UBS_pin;
    sword		UBS_pinned[4];
    sword		UBS_long[4];
    word		UBS_itemApplies, UBS_itemApply[3];
    word		UBS_boolApplies, UBS_boolApply[3];
    word		UBS_radioApplies, UBS_radioSel;
    word		UBS_checkApplies, UBS_checkSel;
    word		UBS_sizeApplies, UBS_sizeSel;
    sword		UBS_sizeButton[2];
    word		UBS_scrollApplies, UBS_scrollAction;
    dword		UBS_scrollValue;
    sword		UBS_scrollBar[3];
    word		UBS_scrollDrag;
    /* the view's page (width, height) and window size */
    sword		UBS_view[4];
    /* the scrolling list's item length, items shown, view window size
     * and the top item after paging down */
    sword		UBS_slist[5];
    /* the dynamic list: monikers asked for, items made, the top item
     * and the first item's number after scrolling to item 12 */
    word		UBS_dlist[4];
    short		UBS_glyph[5];
    word		UBS_text[6];
    word		UBS_text2[8];
    word		UBS_text3[8];
    word		UBS_text4[6];
    word		UBS_gtext[16];
    char		UBS_name[12];
    sword		UBS_scroll[4];	/* left offset, cursor: typed, Home */
    word		UBS_gadget[4];	/* draws, width, height, font */
    /* response, the dialog open when answered, the message held: seen
     * during the dialog, handled */
    word		UBS_dlg[4];
    /* a standard dialog when answered: its response, on the screen,
     * its children, the second trigger the default focus; the response
     * of the one not waited for (+ 0x100) */
    word		UBS_std[5];
    char		UBS_stdText[32];
    /* the spin gadget: applies, the value applied, its state flags */
    word		UBS_count[3];
    char		UBS_countText[8];
    /* the file selector: notifications, the entry and the flags of the
     * last; the entries and flags of the selections asked for */
    word		UBS_fsel[3];
    word		UBS_fselSel[6][2];
    char		UBS_fselName[6][FILE_LONGNAME_BUFFER_SIZE];
    char		UBS_fselPath[2][64];
    /* the controller: updates, the features and the data of the last,
     * messages at its output and the value of the last */
    word		UBS_ctl[6];
    /* per check: the features, the interactable flags, enabled, the
     * children of the group (of the tool holder) */
    word		UBS_ctlAt[8][4];
    /* the tool group: its children, enabled, highlighted (each bit 0:
     * built, 1: highlighted, 2: the highlight gone) */
    word		UBS_tgrp[3];
    /* the document control (step 80): children; usable, enabled without
     * a document; enabled with a clean one, with a dirty one */
    word		UBS_docCtl[5];
    /* its dialogs (steps 82 to 90): the control's task */
    word		UBS_docDlg[9];
    /* the document group (step 91): attributes, protocol, the disk of
     * the default name, searched, the id of a file (low word, twice),
     * of none */
    word		UBS_docGrp[7];
    /* IACP (steps 92 to 94): connection, servers, sent, the document's
     * connection, the error without a server; new connections, pings
     * of the server (value), of the client (value), completions; lost
     * and shut down at the server, lost at the client; the error after
     * all is unregistered */
    word		UBS_iacp[14];
    /* a document (steps 95 to 98): an untitled one's attributes, is
     * the group's by its file, has the model, closed (DocQuitStatus),
     * documents and file left; a named one's attributes, dirty, after
     * saving, closed, file left; opened again: attributes, a second
     * open, closed, documents left */
    word		UBS_doc[14];
    /* save as and revert (steps 98 to 100): save as failed, attributes
     * after it, dirty, reverted, operation, closed, files left */
    word		UBS_docAs[7];
    /* copy to, move to, type (step 100 on): copy failed, files after
     * the copy; after the move: name is the new one, files; type and
     * attributes read only, and normal again */
    word		UBS_docOb[8];
    /* file change notification (steps 205, 206): count, the types; the
     * create's directory and name, the rename's file; the batch's
     * items and their types */
    word		UBS_fcn[16];
    /* the dialog of a full disk (steps 207 to 209) */
    word		UBS_low[8];
    /* the standard sounds (step 300): the counts returned */
    word		UBS_snd[6];
    /* the interim stubs filled in (steps 302 on): [0] classed events
     * that came to the application TO_SYS_* from a visual object;
     * [1] the application lowered lost the field's focus, [2], [3] a
     * point in the primary on the screen, [4] the application had it
     * after a click there, [5], [6] the field's focus before and after
     * (steps 303, 304); [8] to [10] the application's focus (1 the
     * primary, 2 the tool box, 0 other) with the tool box up, after
     * going to the next window, after again (step 305); [11] the
     * Tools menu up after the click, [12] the primary maximized then,
     * [13] the primary restored by Alt+F5 (1) and the menu gone (2),
     * [14] maximized again by Alt+F10 (steps 306 to 309); [15] the
     * Yes trigger's actions sent by the dialog's activate command, [7]
     * the dialog's response (step 310); [6] a slider of a GenValue
     * made with HINT_VALUE_DELAYED_DRAG_NOTIFICATION: 1 built, 2 no
     * update during drags (step 311); [5] the primary minimized (1),
     * not minimized after the application is chosen as a task (2)
     * (steps 312, 313); [16] a display with a document: 1 the document
     * kept, 2 the model grabbed for it (in the application), 4 its
     * name the moniker, 8 its close closes the document (steps 314,
     * 315) */
    word		UBS_stub[24];
} UBState;

UBState ubState;
static MemHandle lowDiskRes;	/* the dialog of a full disk */

#define UBCHECK(c) \
    do { ubState.UBS_checks++; if (!(c)) { \
	if (ubState.UBS_fails < 8) \
	    ubState.UBS_failLines[ubState.UBS_fails] = __LINE__; \
	ubState.UBS_fails++; \
	if (!ubState.UBS_failLine) ubState.UBS_failLine = __LINE__; } \
    } while (0)

/* a file of SP_DOCUMENT (steps 95 to 98) */
static Boolean DocExists(const char *name)
{
    FileHandle fh;

    FilePushDir();
    FileSetStandardPath(SP_DOCUMENT);
    fh = FileOpen(name, FILE_ACCESS_R | FILE_DENY_NONE);
    if (fh)
	FileClose(fh, FALSE);
    FilePopDir();
    return fh != 0;
}

static void DocDelete(const char *name)
{
    FilePushDir();
    FileSetStandardPath(SP_DOCUMENT);
    (void) FileDelete(name);
    FilePopDir();
}

@class UBProcessClass, GenProcessClass;
    @message void MSG_UB_STEP(word step);
    @message (GEN_ITEM_GROUP_APPLY_MSG) MSG_UB_ITEMS_APPLIED;
    @message (GEN_ITEM_GROUP_APPLY_MSG) MSG_UB_RADIO_APPLIED;
    @message (GEN_ITEM_GROUP_APPLY_MSG) MSG_UB_SIZE_APPLIED;
    @message (GEN_BOOLEAN_GROUP_APPLY_MSG) MSG_UB_CHECKS_APPLIED;
    @message (GEN_BOOLEAN_GROUP_APPLY_MSG) MSG_UB_BOOLEANS_APPLIED;
    /* a scrollbar's apply message plus the part pressed less one */
    @message (GEN_VALUE_APPLY_MSG) MSG_UB_SCROLL_TOP;
    @message (GEN_VALUE_APPLY_MSG) MSG_UB_SCROLL_PAGE_UP;
    @message (GEN_VALUE_APPLY_MSG) MSG_UB_SCROLL_UP;
    @message (GEN_VALUE_APPLY_MSG) MSG_UB_SCROLL_DRAG;
    @message (GEN_VALUE_APPLY_MSG) MSG_UB_SCROLL_DOWN;
    @message (GEN_VALUE_APPLY_MSG) MSG_UB_SCROLL_PAGE_DOWN;
    @message (GEN_VALUE_APPLY_MSG) MSG_UB_SCROLL_BOTTOM;
    @message (GEN_DYNAMIC_LIST_QUERY_MSG) MSG_UB_QUERY_ITEM;
    @message (GEN_TEXT_APPLY_MSG) MSG_UB_NAME_APPLIED;
    @message (GEN_TEXT_STATUS_MSG) MSG_UB_NAME_STATUS;
    @message void MSG_UB_HELD();
    @message (GEN_APP_DO_STANDARD_DIALOG_MSG) MSG_UB_STD_RESPONSE;
    @message (GEN_VALUE_APPLY_MSG) MSG_UB_COUNT_APPLIED;
    @message (GEN_FILE_SELECTOR_NOTIFICATION_MSG) MSG_UB_FILE_SELECTED;
    @message void MSG_UB_CTL_OUT(word value);
@endc
@classdecl UBProcessClass, neverSaved;

/* the application answers its standard dialog (its last child) with
 * ubAnswer, noting what the dialog is made of */
@class UBAppClass, GenApplicationClass;
    @message void MSG_UB_ANSWER();
    @message void MSG_UB_SYS_PING();
@endc
@classdecl UBAppClass;

/* what file change notification it gets (steps 205, 206) */
@class UBWatchClass, MetaClass;
@endc
@classdecl UBWatchClass;

/* a document whose save can fail as on a full disk (steps 207 to 209) */
@class UBDocClass, GenDocumentClass;
@endc
@classdecl UBDocClass;

/* a stand-in document of a display: what closes it (steps 314, 315) */
@class UBFakeDocClass, GenDocumentClass;
@endc
@classdecl UBFakeDocClass;

@method UBFakeDocClass, MSG_GEN_DOCUMENT_CLOSE
{
    (void) pself; (void) oself; (void) connection;
    ubState.UBS_stub[16] |= 8;
    return 0;
}

@method UBFakeDocClass, MSG_META_GAINED_MODEL_EXCL, MSG_META_LOST_MODEL_EXCL
{
    (void) pself; (void) oself; (void) message;
}

static optr ubFakeDoc;

static Boolean ubDiskFull;

static word ubAnswer;

/* a classed event TO_SYS_FOCUS from a visual object (step 302) */
@method UBAppClass, MSG_UB_SYS_PING
{
    ubState.UBS_stub[0]++;
}

@method UBAppClass, MSG_UB_ANSWER
{
    word n = @call oself::MSG_GEN_COUNT_CHILDREN();
    optr dlg = @call oself::MSG_GEN_FIND_CHILD_AT_POSITION(n - 1);
    optr top = @call dlg::MSG_GEN_FIND_CHILD_AT_POSITION(0);
    optr text = @call top::MSG_GEN_FIND_CHILD_AT_POSITION(1);
    optr second = @call dlg::MSG_GEN_FIND_CHILD_AT_POSITION(2);

    (void) pself;
    ubState.UBS_std[1] = @call dlg::MSG_VIS_QUERY_WINDOW() != 0;
    ubState.UBS_std[2] = @call dlg::MSG_GEN_COUNT_CHILDREN();
    ubState.UBS_std[3] = second &&
			 ObjVarFindData(second, HINT_DEFAULT_FOCUS) != NULL;
    if (text && @call text::MSG_VIS_TEXT_GET_TEXT_SIZE() <
		sizeof(ubState.UBS_stdText))
	(void) @call text::MSG_VIS_TEXT_GET_ALL_PTR(ubState.UBS_stdText);
    @call dlg::MSG_GEN_INTERACTION_ACTIVATE_COMMAND(ubAnswer);
}

@method UBProcessClass, MSG_UB_STD_RESPONSE
{
    ubState.UBS_std[4] = 0x100 + response;
}

/* the trigger that answers the dialog of step 53: whether the dialog
 * is on the screen then, and whether a message to the process waited */
/* the two ends of an IACP connection (steps 92 to 94) */
@class UBIacpClass, GenGlyphClass;
    @message void MSG_UB_IACP_PING(word value);
    @message void MSG_UB_IACP_DONE();
@endc
@classdecl UBIacpClass;

@class UBYesClass, GenTriggerClass;
@endc
@classdecl UBYesClass;

/* the dialog's MSG_GEN_INTERACTION_ACTIVATE_COMMAND sends the action of
 * its standard trigger (step 310) */
@method UBYesClass, MSG_GEN_TRIGGER_SEND_ACTION
{
    ubState.UBS_stub[15]++;
    @callsuper();
}

@method UBYesClass, MSG_GEN_ACTIVATE
{
    optr dlg = @call oself::MSG_GEN_FIND_PARENT();

    (void) pself;
    ubState.UBS_dlg[1] = @call dlg::MSG_VIS_QUERY_WINDOW() != 0;
    ubState.UBS_dlg[2] = ubState.UBS_dlg[3];
    @callsuper();
}

@method UBProcessClass, MSG_UB_FILE_SELECTED
{
    ubState.UBS_fsel[0]++;
    ubState.UBS_fsel[1] = entryNum;
    ubState.UBS_fsel[2] = entryFlags;
}

@method UBProcessClass, MSG_UB_COUNT_APPLIED
{
    ubState.UBS_count[0]++;
    ubState.UBS_count[1] = (word) (value >> 16);
    ubState.UBS_count[2] = stateFlags.GVSFAW_flags;
}

@method UBProcessClass, MSG_UB_HELD
{
    ubState.UBS_dlg[3]++;
}

/*
 * a controller of our own: two features in its normal UI (a group with
 * the triggers A and B), one tool; it listens to the character
 * attributes of the target
 */
#define UBCF_B	2
#define UBCF_A	1

@class UBCtlClass, GenControlClass;
@endc
@classdecl UBCtlClass;

static GCNListType ubCtlLists[] = {
    { MANUFACTURER_ID_GEOWORKS,
      GAGCNLT_APP_TARGET_NOTIFY_TEXT_CHAR_ATTR_CHANGE }
};
static NotificationType ubCtlTypes[] = {
    { MANUFACTURER_ID_GEOWORKS, GWNT_TEXT_CHAR_ATTR_CHANGE }
};
static GenControlChildInfo ubCtlChildren[1];
static GenControlFeaturesInfo ubCtlFeatures[2];	/* bit 0 first */
static GenControlChildInfo ubCtlTools[1];
static GenControlFeaturesInfo ubCtlToolFeatures[1];

@method UBCtlClass, MSG_GEN_CONTROL_UPDATE_UI
{
    (void) pself; (void) toolBlock; (void) childBlock; (void) manufID;
    ubState.UBS_ctl[0]++;
    ubState.UBS_ctl[1] = features;
    ubState.UBS_ctl[2] = toolboxFeatures;
    ubState.UBS_ctl[3] = data != 0 && changeID == GWNT_TEXT_CHAR_ATTR_CHANGE;
}

@method UBProcessClass, MSG_UB_CTL_OUT
{
    ubState.UBS_ctl[4]++;
    ubState.UBS_ctl[5] = value;
}

/* a gadget of our own: 30 x 20, a filled rectangle */
@class UBGadgetClass, GenGadgetClass;
@endc
@classdecl UBGadgetClass;

@method UBGadgetClass, MSG_VIS_RECALC_SIZE
{
    (void) pself; (void) width; (void) height;
    return MAKE_SIZE_DWORD(30, 20);
}

@method UBGadgetClass, MSG_VIS_DRAW
{
    Rectangle r;

    (void) pself; (void) drawFlags;
    VisGetBounds(oself, &r);
    GrSetAreaColor(gstate, CF_INDEX, C_BLUE, 0, 0);
    GrFillRect(gstate, r.R_left, r.R_top, r.R_right, r.R_bottom);
    ubState.UBS_gadget[0]++;
}

@start UBAppObjects;
@object UBAppClass UBApp = {
    GI_visMoniker = "Boot";
    GI_comp = @UBPrimary, @UBList, @UBBools, @UBFiles, @UBCtl, @UBToolBox;
    /* the displays on the windows list too, to come up with it */
    gcnList(MANUFACTURER_ID_GEOWORKS, GAGCNLT_WINDOWS) = @UBPrimary, @UBDoc1,
						      @UBDoc2;
}
