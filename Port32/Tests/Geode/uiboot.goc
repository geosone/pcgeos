static IACPConnection ubIacpConn, ubIacpDocConn, ubIacpHeldConn;

@method UBIacpClass, MSG_META_IACP_NEW_CONNECTION
{
    (void) pself; (void) appLaunchBlock; (void) justLaunched;
    if (oself == @UBIacpSrv &&
	(connection == ubIacpConn || connection == ubIacpDocConn ||
	 connection == ubIacpHeldConn))
	ubState.UBS_iacp[5]++;
}

@method UBIacpClass, MSG_META_IACP_PROCESS_MESSAGE
{
    (void) pself;
    IACPProcessMessage(oself, msgToSend, topt, completionMsg);
}

@method UBIacpClass, MSG_UB_IACP_PING
{
    (void) pself;
    if (oself == @UBIacpSrv) {
	ubState.UBS_iacp[6]++;
	ubState.UBS_iacp[7] = value;
    } else {
	ubState.UBS_iacp[8] = value;
    }
}

static FileID ubFcnDirID, ubFcnFileID;
static Boolean StrIs(const char *a, const char *b);

@method UBWatchClass, MSG_NOTIFY_FILE_CHANGE
{
    word n = ubState.UBS_fcn[0];

    (void) oself;
    (void) pself;
    if (n < 8)
	ubState.UBS_fcn[1 + n] = (word) notifyType;
    ubState.UBS_fcn[0] = n + 1;
    if (data) {
	byte *b = MemLock(data);
	FileChangeNotificationData *d = (void *) b;

	if (notifyType == FCNT_CREATE && n == 0) {
	    ubState.UBS_fcn[9] = d->FCND_id == ubFcnDirID;
	    ubState.UBS_fcn[10] = StrIs(d->FCND_name, "UBNOTE");
	} else if (notifyType == FCNT_RENAME) {
	    ubState.UBS_fcn[11] = d->FCND_id == ubFcnFileID &&
				  StrIs(d->FCND_name, "UBNOTE2");
	} else if (notifyType == FCNT_BATCH) {
	    FileChangeBatchNotificationData *bd = (void *) b;
	    word at = word_offsetof(FileChangeBatchNotificationData,
				    FCBND_notifications), k = 0;

	    while (at < bd->FCBND_end) {
		FileChangeBatchNotificationItem *it = (void *) (b + at);

		if (k < 2)
		    ubState.UBS_fcn[13 + k] = (word) it->FCBNI_type;
		k++;
		at += word_offsetof(FileChangeBatchNotificationItem,
				    FCBNI_name);
		if (it->FCBNI_type <= FCNT_RENAME)
		    at += sizeof(FileLongName);
	    }
	    ubState.UBS_fcn[12] = k;
	}
	MemUnlock(data);
    }
}

@method UBDocClass, MSG_GEN_DOCUMENT_PHYSICAL_SAVE
{
    if (ubDiskFull) {
	*error = VM_UPDATE_INSUFFICIENT_DISK_SPACE;
	return TRUE;
    }
    return @callsuper();
}

@method UBIacpClass, MSG_UB_IACP_DONE
{
    (void) pself;
    /* behind the message it completes */
    if (oself == @UBIacpCli && ubState.UBS_iacp[6])
	ubState.UBS_iacp[9]++;
}

@method UBIacpClass, MSG_META_IACP_LOST_CONNECTION
{
    (void) pself;
    if (oself == @UBIacpSrv) {
	/* the client has gone (server number 0) */
	if (!serverNum)
	    ubState.UBS_iacp[10]++;
	IACPLostConnection(oself, connection);
    } else {
	ubState.UBS_iacp[12] += serverNum;
    }
}

@method UBIacpClass, MSG_META_IACP_SHUTDOWN_CONNECTION
{
    (void) pself;
    ubState.UBS_iacp[11]++;
    IACPShutdownConnection(oself, connection);
}

@method UBCtlClass, MSG_GEN_CONTROL_GET_INFO
{
    (void) pself;
    ubCtlChildren[0].GCCI_object = OptrToChunk(@UBCtlGroup);
    ubCtlChildren[0].GCCI_featureMask = UBCF_A | UBCF_B;
    ubCtlFeatures[0].GCFI_object = OptrToChunk(@UBCtlA);
    ubCtlFeatures[1].GCFI_object = OptrToChunk(@UBCtlB);
    ubCtlTools[0].GCCI_object = OptrToChunk(@UBCtlToolA);
    ubCtlTools[0].GCCI_featureMask = 1;
    ubCtlTools[0].GCCI_flags = GCCF_IS_DIRECTLY_A_FEATURE;
    ubCtlToolFeatures[0].GCFI_object = OptrToChunk(@UBCtlToolA);
    memset(info, 0, sizeof(*info));
    info->GCBI_gcnList = ubCtlLists;
    info->GCBI_gcnCount = 1;
    info->GCBI_notificationList = ubCtlTypes;
    info->GCBI_notificationCount = 1;
    info->GCBI_dupBlock = OptrToHandle(@UBCtlGroup);
    info->GCBI_childList = ubCtlChildren;
    info->GCBI_childCount = 1;
    info->GCBI_featuresList = ubCtlFeatures;
    info->GCBI_featuresCount = 2;
    info->GCBI_features = UBCF_A | UBCF_B;
    info->GCBI_toolBlock = OptrToHandle(@UBCtlToolA);
    info->GCBI_toolList = ubCtlTools;
    info->GCBI_toolCount = 1;
    info->GCBI_toolFeaturesList = ubCtlToolFeatures;
    info->GCBI_toolFeaturesCount = 1;
    info->GCBI_toolFeatures = 1;
}

/* the controller's state for a check */
static void UBCtlState(word n)
{
    TempGenControlInstance *t;
    optr group = 0;
    word *a = ubState.UBS_ctlAt[n];

    ObjLockObjBlock(OptrToHandle(@UBCtl));
    t = ObjVarFindData(@UBCtl, TEMP_GEN_CONTROL_INSTANCE);
    a[0] = t ? t->TGCI_features | (t->TGCI_toolboxFeatures << 8) |
	       (t->TGCI_childBlock ? 0x1000 : 0) |
	       (t->TGCI_toolBlock ? 0x2000 : 0) |
	       (t->TGCI_toolParent ? 0x4000 : 0) : 0xffff;
    a[1] = t ? t->TGCI_interactableFlags : 0xffff;
    MemUnlock(OptrToHandle(@UBCtl));
    a[2] = @call UBCtl::MSG_GEN_GET_ENABLED() != 0;
    a[2] |= (@call UBToolBox::MSG_GEN_GET_ENABLED() != 0) << 1;
    a[3] = @call UBCtl::MSG_GEN_COUNT_CHILDREN();
    if (a[3])
	group = @call UBCtl::MSG_GEN_FIND_CHILD_AT_POSITION(0);
    if (group)
	a[3] |= @call group::MSG_GEN_COUNT_CHILDREN() << 4;
    a[3] |= @call UBToolBox::MSG_GEN_COUNT_CHILDREN() << 8;
}

/* the status of the controller's list: a block, or none */
static void UBCtlNotify(Boolean withData)
{
    MemHandle bh = 0;
    EventHandle ev;

    if (withData) {
	bh = MemAlloc(16, HF_SWAPABLE | HF_SHARABLE, HAF_ZERO_INIT);
	MemInitRefCount(bh, 1);
    }
    ev = @record null::MSG_META_NOTIFY_WITH_DATA_BLOCK(
		MANUFACTURER_ID_GEOWORKS, GWNT_TEXT_CHAR_ATTR_CHANGE, bh);
    @call UBApp::MSG_META_GCN_LIST_SEND(GCNLSF_SET_STATUS, ev, bh,
		GAGCNLT_APP_TARGET_NOTIFY_TEXT_CHAR_ATTR_CHANGE,
		MANUFACTURER_ID_GEOWORKS);
}

/* the dynamic list's monikers: "Item n" */
@method UBProcessClass, MSG_UB_QUERY_ITEM
{
    char t[12] = "Item ", *p = t + 5;

    ubState.UBS_dlist[0]++;
    if (item >= 10)
	*p++ = (char) ('0' + item / 10 % 10);
    *p++ = (char) ('0' + item % 10);
    *p = 0;
    @call list::MSG_GEN_DYNAMIC_LIST_REPLACE_ITEM_TEXT(item, t);
}

@method UBProcessClass, MSG_UB_NAME_APPLIED
{
    ubState.UBS_gtext[8]++;
    ubState.UBS_gtext[9] = stateFlags;
}

@method UBProcessClass, MSG_UB_NAME_STATUS
{
    ubState.UBS_gtext[10]++;
    ubState.UBS_gtext[11] = stateFlags;
}

@method UBProcessClass, MSG_UB_ITEMS_APPLIED
{
    ubState.UBS_itemApplies++;
    ubState.UBS_itemApply[0] = selection;
    ubState.UBS_itemApply[1] = numSelections;
    ubState.UBS_itemApply[2] = stateFlags;
}

@method UBProcessClass, MSG_UB_RADIO_APPLIED
{
    (void) numSelections;
    (void) stateFlags;
    ubState.UBS_radioApplies++;
    ubState.UBS_radioSel = selection;
}

@method UBProcessClass, MSG_UB_SCROLL_TOP, MSG_UB_SCROLL_PAGE_UP,
		       MSG_UB_SCROLL_UP, MSG_UB_SCROLL_DRAG, MSG_UB_SCROLL_DOWN,
		       MSG_UB_SCROLL_PAGE_DOWN, MSG_UB_SCROLL_BOTTOM
{
    (void) stateFlags;
    ubState.UBS_scrollApplies++;
    ubState.UBS_scrollAction = message - MSG_UB_SCROLL_TOP;
    ubState.UBS_scrollValue = value;
}

@method UBProcessClass, MSG_UB_SIZE_APPLIED
{
    (void) numSelections;
    (void) stateFlags;
    ubState.UBS_sizeApplies++;
    ubState.UBS_sizeSel = selection;
}

@method UBProcessClass, MSG_UB_CHECKS_APPLIED
{
    (void) indeterminateBooleans;
    (void) modifiedBooleans;
    ubState.UBS_checkApplies++;
    ubState.UBS_checkSel = selectedBooleans;
}

@method UBProcessClass, MSG_UB_BOOLEANS_APPLIED
{
    ubState.UBS_boolApplies++;
    ubState.UBS_boolApply[0] = selectedBooleans;
    ubState.UBS_boolApply[1] = indeterminateBooleans;
    ubState.UBS_boolApply[2] = modifiedBooleans;
}

@method UBProcessClass, MSG_META_ATTACH_PROCESS
{
    ubState.UBS_process = GeodeGetProcessHandle();
    ubState.UBS_attached++;
    @callsuper();
}

/* on the display lists before the displays open */
@method UBProcessClass, MSG_GEN_PROCESS_OPEN_APPLICATION
{
    optr self = ConstructOptr(GeodeGetProcessHandle(), 0);

    (void) @call UBApp::MSG_META_GCN_LIST_ADD(self,
		GAGCNLT_APP_TARGET_NOTIFY_DISPLAY_CHANGE,
		MANUFACTURER_ID_GEOWORKS);
    (void) @call UBApp::MSG_META_GCN_LIST_ADD(self,
		GAGCNLT_APP_TARGET_NOTIFY_DISPLAY_LIST_CHANGE,
		MANUFACTURER_ID_GEOWORKS);
    @callsuper();
    ubState.UBS_opened++;
}

/* the notifications: the display with the target, the list changed */
@method UBProcessClass, MSG_META_NOTIFY_WITH_DATA_BLOCK
{
    if (manufID == MANUFACTURER_ID_GEOWORKS &&
	notificationType == GWNT_DISPLAY_CHANGE) {
	ubState.UBS_displayNotices++;
	if (data) {
	    NotifyDisplayChange *n = MemLock(data);

	    ubState.UBS_lastNum = n->NDC_displayNum;
	    memcpy(ubState.UBS_lastName, n->NDC_name,
		   sizeof(ubState.UBS_lastName) - 1);
	    ubState.UBS_lastOverlapping = n->NDC_overlapping;
	    MemUnlock(data);
	} else
	    ubState.UBS_lastName[0] = 0;
    } else if (manufID == MANUFACTURER_ID_GEOWORKS &&
	       notificationType == GWNT_DISPLAY_LIST_CHANGE)
	ubState.UBS_listNotices++;
    @callsuper();
}

static Boolean InClass(optr o, ClassStruct *c)
{
    return o && ObjIsObjectInClass(o, c);
}

static void VisData(optr o, void *buf, word size)
{
    ObjLockObjBlock(OptrToHandle(o));
    memcpy(buf, ObjDerefVis(o), size);
    MemUnlock(OptrToHandle(o));
}

static GenAttrs GenAttrsOf(optr o)
{
    GenAttrs a;

    ObjLockObjBlock(OptrToHandle(o));
    a = ((GenInstance *) ObjDerefGen(o))->GI_attrs;
    MemUnlock(OptrToHandle(o));
    return a;
}

/* the text of a generic object's moniker is t */
static Boolean MonikerIs(optr o, const char *t)
{
    ChunkHandle m;
    VisMoniker *v;
    Boolean r = FALSE;

    if (!o)
	return FALSE;
    ObjLockObjBlock(OptrToHandle(o));
    m = ((GenInstance *) ObjDerefGen(o))->GI_visMoniker;
    if (m) {
	v = LMemDerefHandles(OptrToHandle(o), m);
	if (!(v->VM_type & VMT_GSTRING)) {
	    const char *c = (const char *) v + VMWT_text;

	    while (*c && *c == *t)
		c++, t++;
	    r = *c == *t;
	}
    }
    MemUnlock(OptrToHandle(o));
    return r;
}

/* a key for the text object in the view: to the content, as the view
 * with the focus passes it; shift: ShiftState */
#define UKEY(k)		((VC_ISCTRL << 8) | (k))
static void TextKey(word c, word shift)
{
    @call UBContent::MSG_META_KBD_CHAR(c, CF_FIRST_PRESS | (shift << 8), 0);
    @call UBContent::MSG_META_KBD_CHAR(c, CF_RELEASE | (shift << 8), 0);
}

static void TextKeys(const char *s)
{
    while (*s)
	TextKey((byte) *s++, 0);
}

static Rectangle Bounds(optr o)
{
    Rectangle r;

    ObjLockObjBlock(OptrToHandle(o));
    VisGetBounds(o, &r);
    MemUnlock(OptrToHandle(o));
    return r;
}

static WindowHandle ParentWin(WindowHandle w)
{
    WindowHandle p = 0;

    if (w)
	WinGetInfo(w, WIT_PARENT_WIN, &p);
    return p;
}

/* a display maximized in the group: no header, the group's window */
static Boolean Maximized(optr d)
{
    OLDisplayWinInstance w;

    VisData(d, &w, sizeof(w));
    return (w.OLWI_specState & OLWSS_MAXIMIZED) &&
	   !(w.OLWI_attrs & (OWA_HEADER | OWA_TITLED));
}

static Boolean HasHeader(optr d)
{
    OLDisplayWinInstance w;

    VisData(d, &w, sizeof(w));
    return (w.OLWI_attrs & (OWA_HEADER | OWA_TITLED)) ==
	   (OWA_HEADER | OWA_TITLED);
}

static OLDisplayGroupInstance ubGroup;

static OLDisplayWinFlags DFlags(optr d)
{
    OLDisplayWinInstance w;

    VisData(d, &w, sizeof(w));
    return w.OLDW_flags;
}

/* the button of the display's menu (in the primary's menu bar) shown */
static Boolean MenuShown(void)
{
    optr b = @call UBDocMenu::MSG_OL_POPUP_FIND_BUTTON();
    VisInstance v;

    if (!b)
	return FALSE;
    VisData(b, &v, sizeof(v));
    return (v.VI_attrs & (VA_DRAWABLE | VA_DETECTABLE)) ==
	   (VA_DRAWABLE | VA_DETECTABLE);
}

/* (no strcmp in a geode) */
static Boolean StrIs(const char *p, const char *n)
{
    while (*n && *p == *n)
	p++, n++;
    return *p == *n;
}

/* without regard to case (a DOS host has upper case names) */
static Boolean StrIsCI(const char *p, const char *n)
{
    for (; *n; p++, n++)
	if ((*p | 0x20) != (*n | 0x20))
	    return FALSE;
    return !*p;
}

/* the file selector's selection: its entry and flags to slot n */
static void FSelSelection(word n)
{
    dword d = @call UBFSel::MSG_GEN_FILE_SELECTOR_GET_SELECTION(
			ubState.UBS_fselName[n]);

    ubState.UBS_fselSel[n][0] = GFS_GET_ENTRY_NUMBER(d);
    ubState.UBS_fselSel[n][1] = GFS_GET_ENTRY_FLAGS(d);
}

/* the last notice's display name */
static Boolean NameIs(const char *n)
{
    const char *p = ubState.UBS_lastName;

    while (*n && *p == *n)
	p++, n++;
    return *p == *n;
}

static OLMenuItemGroupSpecState MIGState(optr g)
{
    OLMenuItemGroupInstance m;

    VisData(g, &m, sizeof(m));
    return m.OLMIGI_specState;
}

static sword Width(optr o)
{
    Rectangle r = Bounds(o);

    return r.R_right - r.R_left;
}

static Boolean Drawable(optr o)
{
    VisInstance v;

    VisData(o, &v, sizeof(v));
    return (v.VI_attrs & VA_DRAWABLE) != 0;
}

static sword Height(optr o)
{
    Rectangle r = Bounds(o);

    return r.R_bottom - r.R_top;
}

/* the moniker's text is that given */
static Boolean TextIs(optr o, const char *text)
{
    ChunkHandle c;
    Boolean is = FALSE;

    ObjLockObjBlock(OptrToHandle(o));
    c = ((GenInstance *) ObjDerefGen(o))->GI_visMoniker;
    if (c) {
	const char *t = (const char *)
		LMemDerefHandles(OptrToHandle(o), c) + VMWT_text;

	while (*text && *t == *text)
	    t++, text++;
	is = *t == *text;
    }
    MemUnlock(OptrToHandle(o));
    return is;
}

static optr GroupTarget(void)
{
    optr t = 0;

    (void) @call UBGroup::MSG_META_GET_TARGET_EXCL(&t);
    return t;
}

/*
 * SysIcons: the system menu icons of the window shown (drawable): which
 * (by their action), each in the title bar's right part at the button's
 * top; the maximize and restore icons kept in ubState
 */
#define SI_MINIMIZE	1
#define SI_MAXIMIZE	2
#define SI_RESTORE	4
static word SysIcons(OLWinInstance *w, sword top)
{
    word i, n = @call UBPrimary::MSG_VIS_COUNT_CHILDREN(), shown = 0;

    for (i = 0; i < n; i++) {
	optr c = @call UBPrimary::MSG_VIS_FIND_CHILD_AT_POSITION(i);
	VisInstance v;
	Rectangle r;
	Message msg;
	word bit;

	if (!c || OptrToHandle(c) != w->OLWI_sysMenu ||
	    OptrToChunk(c) == w->OLWI_sysMenuButton)
	    continue;
	msg = @call c::MSG_GEN_TRIGGER_GET_ACTION_MSG();
	bit = msg == MSG_OL_WIN_MINIMIZE ? SI_MINIMIZE :
	      msg == MSG_OL_WIN_MAXIMIZE ? SI_MAXIMIZE :
	      msg == MSG_OL_RESTORE_WIN ? SI_RESTORE : 8;
	if (bit == SI_MAXIMIZE)
	    ubState.UBS_maxIcon = c;
	if (bit == SI_RESTORE)
	    ubState.UBS_restoreIcon = c;
	VisData(c, &v, sizeof(v));
	if (!(v.VI_attrs & VA_DRAWABLE))
	    continue;
	r = Bounds(c);
	if (r.R_left < w->OLWI_titleBarBounds.R_right || r.R_top != top)
	    bit = 8;
	shown |= bit;
    }
    return shown;
}

/* the scroller's window (up or down) of the menu (0: none) */
static WindowHandle ScrollerWin(optr m, Boolean down, optr *sc)
{
    MenuWinScrollerStruct *p;
    WindowHandle w = 0;

    *sc = 0;
    ObjLockObjBlock(OptrToHandle(m));
    p = ObjVarFindData(m, TEMP_OL_MENU_WIN_SCROLLERS);
    if (p) {
	*sc = ConstructOptr(OptrToHandle(m),
			    down ? p->MWSS_downScroller : p->MWSS_upScroller);
	w = ((MenuWinScrollerInstance *) LMemDeref(*sc))->MWSI_window;
    }
    MemUnlock(OptrToHandle(m));
    return w;
}

/* the text of UBCount's item */
static const char *ItemText(ChunkHandle item)
{
    static char buf[8];
    MemHandle mh = OptrToHandle(@UBCount);
    const char *s;
    word i;

    ObjLockObjBlock(mh);
    s = LMemDeref(ConstructOptr(mh, item));
    for (i = 0; i < sizeof(buf) - 1 && s[i]; i++)
	buf[i] = s[i];
    buf[i] = 0;
    MemUnlock(mh);
    return buf;
}

static Boolean ItemIs(ChunkHandle item, const char *want)
{
    const char *s = ItemText(item);

    while (*s && *s == *want)
	s++, want++;
    return *s == *want;
}

static Rectangle ScreenBounds(WindowHandle w)
{
    Rectangle r = { 0, 0, 0, 0 };

    if (w)
	WinGetWinScreenBounds(w, &r);
    return r;
}

/* a click on the n-th button of the primary's menu bar: the bar is the
 * child of the primary that is no generic object and whose children
 * are none either */
static void UBClickMenu(word n)
{
    optr bar = 0, c, b;
    word i;
    Rectangle r;
    MouseReturnParams mr;

    for (i = 0; (c = @call UBPrimary::MSG_VIS_FIND_CHILD_AT_POSITION(i)) != 0;
	 i++) {
	if (@call c::MSG_META_IS_OBJECT_IN_CLASS(&GenClass))
	    continue;
	b = @call c::MSG_VIS_FIND_CHILD_AT_POSITION(0);
	if (b && !@call b::MSG_META_IS_OBJECT_IN_CLASS(&GenClass)) {
	    bar = c;
	    break;
	}
    }
    if (!bar || (b = @call bar::MSG_VIS_FIND_CHILD_AT_POSITION(n)) == 0)
	return;
    @call b::MSG_VIS_GET_BOUNDS(&r);
    @call b::MSG_META_START_SELECT(&mr, r.R_left + 3, r.R_top + 3,
		((UIFA_SELECT | UIFA_IN) << 8) | BI_PRESS | BI_B0_DOWN);
    @call b::MSG_META_END_SELECT(&mr, r.R_left + 3, r.R_top + 3,
		UIFA_IN << 8);
}

@method UBProcessClass, MSG_UB_STEP
{
    OLItemInstance ii;

    switch (step) {
    case 1: {
	/* the application and its primary, built by Motif; the display
	 * group in the primary with its window, full sized: both
	 * displays maximized in it, the first with the target; its menu
	 * in the primary's menu bar */
	VisInstance v;
	OLDisplayGroupInstance g;
	optr app = GeodeGetAppObject(0);
	WindowHandle w1, w2;
	Rectangle gb, b1;

	UBCHECK(app == @UBApp);
	UBCHECK(InClass(app, (ClassStruct *) &OLApplicationClass));
	UBCHECK(InClass(@UBPrimary, (ClassStruct *) &OLBaseWinClass));
	VisData(@UBPrimary, &v, sizeof(v));
	UBCHECK(v.VI_attrs & VA_REALIZED);
	ubState.UBS_primaryWin = @call UBPrimary::MSG_VIS_QUERY_WINDOW();
	UBCHECK(ubState.UBS_primaryWin != 0);
	UBCHECK(InClass(@UBGroup, (ClassStruct *) &OLDisplayGroupClass));
	UBCHECK(InClass(@UBDoc1, (ClassStruct *) &OLDisplayWinClass));
	UBCHECK(InClass(@UBDoc2, (ClassStruct *) &OLDisplayWinClass));
	VisData(@UBGroup, &g, sizeof(g));
	UBCHECK(g.VI_attrs & VA_REALIZED);
	UBCHECK(g.OLDGI_states & OLDGS_MAXIMIZED);
	UBCHECK(@call UBGroup::MSG_GEN_DISPLAY_GROUP_GET_FULL_SIZED());
	ubState.UBS_groupWin = g.VCI_window;
	UBCHECK(g.VCI_window != 0 &&
		ParentWin(g.VCI_window) == ubState.UBS_primaryWin);
	UBCHECK(@call UBDoc1::MSG_VIS_FIND_PARENT() == @UBGroup);
	w1 = @call UBDoc1::MSG_VIS_QUERY_WINDOW();
	w2 = @call UBDoc2::MSG_VIS_QUERY_WINDOW();
	UBCHECK(w1 != 0 && ParentWin(w1) == g.VCI_window);
	UBCHECK(w2 != 0 && ParentWin(w2) == g.VCI_window);
	UBCHECK(Maximized(@UBDoc1) && Maximized(@UBDoc2));
	gb = Bounds(@UBGroup);
	b1 = Bounds(@UBDoc1);
	ubState.UBS_gw = gb.R_right - gb.R_left;
	ubState.UBS_gh = gb.R_bottom - gb.R_top;
	ubState.UBS_dl = b1.R_left;
	ubState.UBS_dt = b1.R_top;
	ubState.UBS_dw = b1.R_right - b1.R_left;
	ubState.UBS_dh = b1.R_bottom - b1.R_top;
	/* maximized: the group's size, the frame outside its window */
	UBCHECK(b1.R_left == -1 && b1.R_top == -1 &&
		ubState.UBS_dw == ubState.UBS_gw &&
		ubState.UBS_dh == ubState.UBS_gh);
	UBCHECK(GroupTarget() == @UBDoc1);
	UBCHECK(DFlags(@UBDoc1) & OLDWF_TARGET);
	UBCHECK(!(DFlags(@UBDoc2) & OLDWF_TARGET));
	UBCHECK(ubState.UBS_displayNotices >= 1 && ubState.UBS_lastNum == 0 &&
		NameIs("Doc 1") &&
		!ubState.UBS_lastOverlapping);
	UBCHECK(ubState.UBS_listNotices >= 1);
	UBCHECK(MenuShown());
	/* overlapping (the displays told through the UI queue) */
	@call UBGroup::MSG_GEN_DISPLAY_GROUP_SET_OVERLAPPING();
	VisData(@UBGroup, &g, sizeof(g));
	UBCHECK(!(g.OLDGI_states & (OLDGS_MAXIMIZED | OLDGS_TILED)));
	UBCHECK(!@call UBGroup::MSG_GEN_DISPLAY_GROUP_GET_FULL_SIZED());
	break;
    }
    case 2: {
	/* overlapping: the displays with their headers, staggered in the
	 * group's slots; the notice says so */
	Rectangle b1, b2;

	UBCHECK(!Maximized(@UBDoc1) && !Maximized(@UBDoc2));
	UBCHECK(HasHeader(@UBDoc1) && HasHeader(@UBDoc2));
	b1 = Bounds(@UBDoc1);
	b2 = Bounds(@UBDoc2);
	UBCHECK(b1.R_left != b2.R_left && b1.R_top != b2.R_top);
	UBCHECK(b1.R_left >= 0 && b2.R_left >= 0 &&
		b1.R_right < ubState.UBS_gw && b2.R_right < ubState.UBS_gw);
	UBCHECK(GroupTarget() == @UBDoc1);
	UBCHECK(ubState.UBS_lastOverlapping && NameIs("Doc 1"));
	/* the second display selected */
	ubState.UBS_displayNotices = 0;
	@call UBGroup::MSG_GEN_DISPLAY_GROUP_SELECT_DISPLAY(1);
	break;
    }
    case 3:
	/* the second on top with the target; the first's menu hidden */
	UBCHECK(GroupTarget() == @UBDoc2);
	UBCHECK((DFlags(@UBDoc2) & OLDWF_TARGET) &&
		!(DFlags(@UBDoc1) & OLDWF_TARGET));
	UBCHECK(@call UBGroup::MSG_VIS_FIND_CHILD_AT_POSITION(0) == @UBDoc2);
	UBCHECK(ubState.UBS_displayNotices >= 1 && ubState.UBS_lastNum == 1 &&
		NameIs("Doc 2"));
	UBCHECK(!MenuShown());
	/* tiled */
	@call UBGroup::MSG_GEN_DISPLAY_GROUP_TILE_DISPLAYS();
	VisData(@UBGroup, &ubGroup, sizeof(ubGroup));
	UBCHECK(ubGroup.OLDGI_states & OLDGS_TILED);
	break;
    case 4: {
	/* tiled: side by side, each half the group's width and all its
	 * height (a ratio position lands a pixel up and left, as the
	 * asm's ConvertSpecWinSizePairsToPixels) */
	Rectangle b1 = Bounds(@UBDoc1), b2 = Bounds(@UBDoc2);
	Rectangle gb = Bounds(@UBGroup);
	sword half = (gb.R_right - gb.R_left) / 2, gh = gb.R_bottom - gb.R_top;

	UBCHECK(b1.R_left == -1 && b1.R_top == -1);
	UBCHECK(b2.R_left == half - 1 && b2.R_top == -1);
	UBCHECK(b1.R_right - b1.R_left == half &&
		b2.R_right - b2.R_left == half);
	UBCHECK(b1.R_bottom - b1.R_top == gh && b2.R_bottom - b2.R_top == gh);
	/* full sized again */
	@call UBGroup::MSG_GEN_DISPLAY_GROUP_SET_FULL_SIZED();
	break;
    }
    case 5:
	/* both maximized again, the second still with the target */
	UBCHECK(Maximized(@UBDoc1) && Maximized(@UBDoc2));
	UBCHECK(@call UBGroup::MSG_GEN_DISPLAY_GROUP_GET_FULL_SIZED());
	UBCHECK(GroupTarget() == @UBDoc2);
	UBCHECK(!ubState.UBS_lastOverlapping && NameIs("Doc 2"));
	/* Ctrl+F6: the next display (queued) */
	(void) @call UBDoc2::MSG_META_FUP_KBD_CHAR(VC_F6 | (CS_CONTROL << 8),
			CF_FIRST_PRESS | (SS_LCTRL << 8), 0);
	break;
    case 6:
	/* the second to the bottom, the first on top with the target */
	UBCHECK(@call UBGroup::MSG_VIS_FIND_CHILD_AT_POSITION(0) == @UBDoc1);
	UBCHECK(GroupTarget() == @UBDoc1);
	UBCHECK(MenuShown());
	/* the first not usable: the second on top */
	@call UBDoc1::MSG_GEN_SET_NOT_USABLE(VUM_NOW);
	break;
    case 7:
	UBCHECK(GroupTarget() == @UBDoc2);
	UBCHECK(!@call UBDoc1::MSG_VIS_QUERY_WINDOW());
	UBCHECK(NameIs("Doc 2") && ubState.UBS_lastNum == 0);
	/* the Tools menu up */
	@call UBTools::MSG_GEN_INTERACTION_INITIATE();
	break;
    case 8: {
	/* a group between items: separators above and below, room for
	 * them (two lines each in color) around its items */
	OLMenuItemGroupSpecState g;
	sword h;

	UBCHECK(InClass(@UBItems, (ClassStruct *) &OLMenuItemGroupClass));
	UBCHECK(InClass(@UBSame, (ClassStruct *) &OLMenuItemGroupClass));
	UBCHECK(@call UBItems::MSG_VIS_FIND_PARENT() == @UBTools);
	g = MIGState(@UBItems);
	UBCHECK((g & (OLMIGSS_SEPARATORS | OLMIGSS_TOP_SEP |
		      OLMIGSS_BOTTOM_SEP | OLMIGSS_HAS_USABLE_CHILD)) ==
		(OLMIGSS_SEPARATORS | OLMIGSS_TOP_SEP | OLMIGSS_BOTTOM_SEP |
		 OLMIGSS_HAS_USABLE_CHILD));
	h = Height(@UBItems);
	UBCHECK(h == Height(@UBItemA) + Height(@UBItemB) + 4);
	UBCHECK(Bounds(@UBItemA).R_top == Bounds(@UBItems).R_top + 2);
	/* the same category: no separators at all, though a group is
	 * above it */
	g = MIGState(@UBSame);
	UBCHECK(!(g & OLMIGSS_SEPARATORS) && (g & OLMIGSS_TOP_SEP));
	UBCHECK(Height(@UBSame) == Height(@UBItemC));
	/* the items around it not usable: no separators */
	@call UBLast::MSG_GEN_SET_NOT_USABLE(VUM_NOW);
	UBCHECK(!(MIGState(@UBItems) & OLMIGSS_BOTTOM_SEP));
	UBCHECK(MIGState(@UBItems) & OLMIGSS_TOP_SEP);
	@call UBFirst::MSG_GEN_SET_NOT_USABLE(VUM_NOW);
	UBCHECK(!(MIGState(@UBItems) & (OLMIGSS_TOP_SEP | OLMIGSS_BOTTOM_SEP)));
	/* the last one usable again: below it again */
	@call UBLast::MSG_GEN_SET_USABLE(VUM_NOW);
	UBCHECK((MIGState(@UBItems) & (OLMIGSS_TOP_SEP | OLMIGSS_BOTTOM_SEP)) ==
		OLMIGSS_BOTTOM_SEP);
	break;
    }
    case 9:
	/* the geometry done again (queued): only the bottom one's room */
	UBCHECK(Height(@UBItems) ==
		Height(@UBItemA) + Height(@UBItemB) + 2);
	UBCHECK(Bounds(@UBItemA).R_top == Bounds(@UBItems).R_top);
	(void) @call UBTools::MSG_GEN_GUP_INTERACTION_COMMAND(IC_DISMISS);
	/* the File menu up */
	@call UBFile::MSG_GEN_INTERACTION_INITIATE();
	break;
    case 10: {
	/* Exit last in the File menu (not a generic child), named with
	 * the application, F3, IC_EXIT; the pin first */
	optr e = @call UBFile::MSG_VIS_FIND_CHILD_AT_POSITION(2);
	InteractionCommand *ic;
	OLMenuWinInstance m;

	UBCHECK(@call UBFile::MSG_VIS_FIND_CHILD_AT_POSITION(1) == @UBOpen);
	UBCHECK(e && !@call UBFile::MSG_VIS_FIND_CHILD_AT_POSITION(3));
	UBCHECK(e && InClass(e, (ClassStruct *) &GenTriggerClass));
	UBCHECK(e && @call UBFile::MSG_GEN_FIND_CHILD(e) == (word) -1);
	UBCHECK(e && @call e::MSG_GEN_FIND_PARENT() == @UBFile);
	UBCHECK(e && TextIs(e, "Exit Boot"));
	UBCHECK(e && @call e::MSG_GEN_GET_KBD_ACCELERATOR() ==
		((KS_CHAR_SET_CONTROL << 8) | VC_F3));
	if (e) {
	    ObjLockObjBlock(OptrToHandle(e));
	    ic = ObjVarFindData(e, ATTR_GEN_TRIGGER_INTERACTION_COMMAND);
	    UBCHECK(ic && *ic == IC_EXIT);
	    MemUnlock(OptrToHandle(e));
	}
	VisData(@UBFile, &m, sizeof(m));
	UBCHECK(m.OLMWI_specState & (OMWSS_FILE_MENU | OMWSS_EXIT_CREATED));
	(void) @call UBFile::MSG_GEN_GUP_INTERACTION_COMMAND(IC_DISMISS);
	break;
    }
    case 11: {
	/* the primary's system menu: a copy of the standard one, its
	 * output the primary, linked up to it; its button in the title
	 * bar (under the gadget area, as the asm puts it), left, the
	 * title bar starting after it */
	OLWinInstance w;
	optr b, m, it;
	VisMoniker *vm;
	Rectangle r;
	VisInstance v;

	VisData(@UBPrimary, &w, sizeof(w));
	UBCHECK(w.OLWI_attrs & OWA_HAS_SYS_MENU);
	UBCHECK(w.OLWI_sysMenu != 0 && w.OLWI_sysMenuButton != 0);
	if (!w.OLWI_sysMenu || !w.OLWI_sysMenuButton)
	    break;
	b = ConstructOptr(w.OLWI_sysMenu, w.OLWI_sysMenuButton);
	UBCHECK(InClass(b, (ClassStruct *) &OLMenuButtonClass));
	UBCHECK(@call b::MSG_VIS_QUERY_WINDOW() == ubState.UBS_primaryWin);
	VisData(b, &v, sizeof(v));
	UBCHECK((v.VI_attrs & (VA_DRAWABLE | VA_DETECTABLE)) ==
		(VA_DRAWABLE | VA_DETECTABLE));
	r = Bounds(b);
	ubState.UBS_sys[0] = r.R_left;
	ubState.UBS_sys[1] = r.R_top;
	ubState.UBS_sys[2] = r.R_right - r.R_left;
	ubState.UBS_sys[3] = r.R_bottom - r.R_top;
	ubState.UBS_sys[4] = w.OLWI_titleBarBounds.R_left;
	ubState.UBS_sys[5] = w.OLWI_titleBarBounds.R_right;
	UBCHECK(w.OLWI_titleBarBounds.R_left > r.R_left);
	UBCHECK(w.OLWI_titleBarBounds.R_left == r.R_right);
	ObjLockObjBlock(w.OLWI_sysMenu);
	UBCHECK(ObjBlockGetOutput(w.OLWI_sysMenu) == @UBPrimary);
	MemUnlock(w.OLWI_sysMenu);
	/* the menu (the button's generic part): linked up only, its
	 * moniker list reduced to one moniker */
	{
	    OLButtonInstance bi;

	    VisData(b, &bi, sizeof(bi));
	    m = ConstructOptr(w.OLWI_sysMenu, bi.OLBI_genChunk);
	}
	UBCHECK(@call m::MSG_GEN_FIND_PARENT() == @UBPrimary);
	UBCHECK(@call UBPrimary::MSG_GEN_FIND_CHILD(m) == (word) -1);
	UBCHECK(InClass(m, (ClassStruct *) &OLMenuWinClass));
	UBCHECK(@call m::MSG_GEN_COUNT_CHILDREN() == 6);
	ObjLockObjBlock(w.OLWI_sysMenu);
	{
	    ChunkHandle mk = ((GenInstance *) ObjDerefGen(m))->GI_visMoniker;

	    vm = mk ? LMemDeref(ConstructOptr(w.OLWI_sysMenu, mk)) : NULL;
	    UBCHECK(vm && !(vm->VM_type & VMT_MONIKER_LIST) &&
		    (vm->VM_type & VMT_GSTRING));
	}
	MemUnlock(w.OLWI_sysMenu);
	/* Restore off (not maximized), Close and Maximize on, Close with
	 * Alt */
	it = @call m::MSG_GEN_FIND_CHILD_AT_POSITION(0);
	UBCHECK(it && !@call it::MSG_GEN_CHECK_IF_FULLY_ENABLED());
	UBCHECK(it && TextIs(it, "Restore"));
	it = @call m::MSG_GEN_FIND_CHILD_AT_POSITION(5);
	UBCHECK(it && TextIs(it, "Close"));
	UBCHECK(it && @call it::MSG_GEN_CHECK_IF_FULLY_ENABLED());
	UBCHECK(it && @call it::MSG_GEN_GET_KBD_ACCELERATOR() ==
		(KS_ALT | (KS_CHAR_SET_CONTROL << 8) | VC_F4));
	it = @call m::MSG_GEN_FIND_CHILD_AT_POSITION(4);
	UBCHECK(it && TextIs(it, "Maximize") &&
		@call it::MSG_GEN_CHECK_IF_FULLY_ENABLED());
	/* with a mouse: the minimize and maximize icons at the right end
	 * of the title bar, the restore icon hidden */
	UBCHECK(w.OLWI_specState & OLWSS_SYS_ICONS_ATTACHED);
	UBCHECK(SysIcons(&w, r.R_top) == (SI_MINIMIZE | SI_MAXIMIZE));
	/* maximized by its icon */
	if (ubState.UBS_maxIcon)
	    @call ubState.UBS_maxIcon::MSG_GEN_TRIGGER_SEND_ACTION(FALSE);
	break;
    }
    case 12: {
	/* maximized: the restore icon instead of the maximize one, the
	 * Restore item on; restored by the icon */
	OLWinInstance w;
	Rectangle r;

	VisData(@UBPrimary, &w, sizeof(w));
	UBCHECK(w.OLWI_specState & OLWSS_MAXIMIZED);
	r = Bounds(ConstructOptr(w.OLWI_sysMenu, w.OLWI_sysMenuButton));
	UBCHECK(SysIcons(&w, r.R_top) == (SI_MINIMIZE | SI_RESTORE));
	if (ubState.UBS_restoreIcon)
	    @call ubState.UBS_restoreIcon::MSG_GEN_TRIGGER_SEND_ACTION(FALSE);
	break;
    }
    case 13: {
	OLWinInstance w;
	Rectangle r;

	VisData(@UBPrimary, &w, sizeof(w));
	UBCHECK(!(w.OLWI_specState & OLWSS_MAXIMIZED));
	r = Bounds(ConstructOptr(w.OLWI_sysMenu, w.OLWI_sysMenuButton));
	UBCHECK(SysIcons(&w, r.R_top) == (SI_MINIMIZE | SI_MAXIMIZE));
	/* the File menu up again, for its pin */
	@call UBFile::MSG_GEN_INTERACTION_INITIATE();
	break;
    }
    case 14: {
	/* the pin: a group first in the menu, shown, holding a trigger
	 * that toggles the pushpin at once, its moniker the pin's
	 * picture; pressed */
	OLMenuWinInstance m;
	optr g, t;

	VisData(@UBFile, &m, sizeof(m));
	UBCHECK(m.OLWI_attrs & OWA_PINNABLE);
	UBCHECK(m.OLPWI_pinTrigger != 0);
	if (!m.OLPWI_pinTrigger)
	    break;
	g = ConstructOptr(OptrToHandle(@UBFile), m.OLPWI_pinTrigger);
	UBCHECK(@call UBFile::MSG_VIS_FIND_CHILD_AT_POSITION(0) == g);
	UBCHECK(Drawable(g));
	t = @call g::MSG_GEN_FIND_CHILD_AT_POSITION(0);
	UBCHECK(t && InClass(t, (ClassStruct *) &GenTriggerClass));
	if (!t)
	    break;
	ubState.UBS_pin = t;
	UBCHECK(@call t::MSG_GEN_TRIGGER_GET_ACTION_MSG() ==
		MSG_OL_POPUP_TOGGLE_PUSHPIN);
	UBCHECK(Drawable(t) && Width(t) >= 32);
	ObjLockObjBlock(OptrToHandle(t));
	{
	    VisMoniker *vm = LMemDeref(ConstructOptr(OptrToHandle(t),
			((GenInstance *) ObjDerefGen(t))->GI_visMoniker));

	    UBCHECK(!(vm->VM_type & VMT_MONIKER_LIST) &&
		    (vm->VM_type & VMT_GSTRING));
	}
	MemUnlock(OptrToHandle(t));
	@call t::MSG_GEN_TRIGGER_SEND_ACTION(FALSE);
	break;
    }
    case 15: {
	/* pinned: still up, titled, movable, with its system menu; the
	 * pin hidden.  Then opened by its button: not pinned meanwhile */
	OLMenuWinInstance m;
	Rectangle r = Bounds(@UBFile);

	VisData(@UBFile, &m, sizeof(m));
	UBCHECK(m.OLWI_specState & OLWSS_PINNED);
	UBCHECK((m.OLWI_attrs & (OWA_MOVABLE | OWA_TITLED | OWA_HAS_SYS_MENU))
		== (OWA_MOVABLE | OWA_TITLED | OWA_HAS_SYS_MENU));
	UBCHECK(@call UBFile::MSG_VIS_QUERY_WINDOW() != 0);
	UBCHECK(m.OLWI_sysMenu && m.OLWI_sysMenuButton);
	if (m.OLWI_sysMenu && m.OLWI_sysMenuButton)
	    UBCHECK(Drawable(ConstructOptr(m.OLWI_sysMenu,
					   m.OLWI_sysMenuButton)));
	UBCHECK(!Drawable(ubState.UBS_pin));
	ubState.UBS_pinned[0] = r.R_left;
	ubState.UBS_pinned[1] = r.R_top;
	ubState.UBS_pinned[2] = r.R_right - r.R_left;
	ubState.UBS_pinned[3] = r.R_bottom - r.R_top;
	@call UBFile::MSG_OL_POPUP_ACTIVATE(20, 20);
	break;
    }
    case 16: {
	/* opened by its button: unpinned for the while, no title; closed:
	 * pinned again */
	OLMenuWinInstance m;

	VisData(@UBFile, &m, sizeof(m));
	UBCHECK(!(m.OLWI_specState & OLWSS_PINNED));
	UBCHECK(m.OLMWI_specState & OMWSS_WAS_PINNED);
	UBCHECK(!(m.OLWI_attrs & OWA_TITLED));
	UBCHECK(m.OLWI_sysMenu && m.OLWI_sysMenuButton &&
		!Drawable(ConstructOptr(m.OLWI_sysMenu,
					m.OLWI_sysMenuButton)));
	(void) @call UBFile::MSG_GEN_GUP_INTERACTION_COMMAND(IC_DISMISS);
	break;
    }
    case 17: {
	/* pinned again, up; closed by its system menu: unpinned, down */
	OLMenuWinInstance m;

	VisData(@UBFile, &m, sizeof(m));
	UBCHECK(m.OLWI_specState & OLWSS_PINNED);
	UBCHECK(!(m.OLMWI_specState & OMWSS_WAS_PINNED));
	UBCHECK((m.OLWI_attrs & (OWA_TITLED | OWA_PINNABLE)) ==
		(OWA_TITLED | OWA_PINNABLE));
	UBCHECK(@call UBFile::MSG_VIS_QUERY_WINDOW() != 0);
	@call UBFile::MSG_OL_WIN_CLOSE();
	break;
    }
    case 18: {
	OLMenuWinInstance m;

	VisData(@UBFile, &m, sizeof(m));
	UBCHECK(!(m.OLWI_specState & OLWSS_PINNED));
	UBCHECK(!(m.OLWI_attrs & OWA_TITLED));
	UBCHECK(!@call UBFile::MSG_VIS_QUERY_WINDOW());
	UBCHECK(Drawable(ubState.UBS_pin));
	/* the long menu up */
	@call UBLong::MSG_GEN_INTERACTION_INITIATE();
	break;
    }
    case 19: {
	/* below the bottom of the screen: the down scroller over the
	 * bottom, no up one; pressed, the menu goes up a step */
	WindowHandle mw = @call UBLong::MSG_VIS_QUERY_WINDOW(), pw;
	Rectangle m = ScreenBounds(mw), p, d;
	optr up, down;
	MouseReturnParams mr;

	UBCHECK(mw != 0);
	pw = mw ? VisQueryParentWin(@UBLong) : 0;
	p = ScreenBounds(pw);
	UBCHECK(m.R_top >= p.R_top && m.R_bottom > p.R_bottom);
	UBCHECK(!ScrollerWin(@UBLong, FALSE, &up) && up);
	d = ScreenBounds(ScrollerWin(@UBLong, TRUE, &down));
	UBCHECK(d.R_bottom == p.R_bottom &&
		d.R_bottom - d.R_top == MENU_WIN_SCROLL_DELTA);
	UBCHECK(d.R_left == m.R_left + 2 && d.R_right == m.R_right - 2);
	ubState.UBS_long[0] = m.R_top;
	ubState.UBS_long[1] = m.R_bottom;
	ubState.UBS_long[2] = d.R_top;
	if (down)
	    @call down::MSG_META_START_SELECT(&mr, 10, 5, 0);
	break;
    }
    case 20: {
	/* a step up: now the up scroller too; the last item focused: up
	 * till it is above the down scroller */
	Rectangle m = ScreenBounds(@call UBLong::MSG_VIS_QUERY_WINDOW()), d,
		  l;
	optr up, down;
	WindowHandle mw;

	UBCHECK(m.R_top == ubState.UBS_long[0] - MENU_WIN_SCROLL_DELTA);
	UBCHECK(ScrollerWin(@UBLong, FALSE, &up) != 0);
	UBCHECK(ScrollerWin(@UBLong, TRUE, &down) != 0);
	@call UBLongLast::MSG_META_GRAB_FOCUS_EXCL();
	@call UBLong::MSG_OL_MENU_WIN_UPDATE_SCROLLABLE_MENU();
	mw = @call UBLong::MSG_VIS_QUERY_WINDOW();
	m = ScreenBounds(mw);
	l = Bounds(@UBLongLast);
	d = ScreenBounds(ScrollerWin(@UBLong, TRUE, &down));
	ubState.UBS_long[3] = m.R_top;
	UBCHECK(m.R_top < ubState.UBS_long[0] - MENU_WIN_SCROLL_DELTA);
	UBCHECK(!d.R_bottom || m.R_top + l.R_bottom <= d.R_top);
	(void) @call UBLong::MSG_GEN_GUP_INTERACTION_COMMAND(IC_DISMISS);
	break;
    }
    case 21: {
	/* down: the scrollers' windows closed */
	optr up, down;

	UBCHECK(!@call UBLong::MSG_VIS_QUERY_WINDOW());
	UBCHECK(!ScrollerWin(@UBLong, FALSE, &up) && up);
	UBCHECK(!ScrollerWin(@UBLong, TRUE, &down) && down);
	break;
    }
    case 22: {
	/* the generic item group: one, several, items added and taken,
	 * none; the scan over the usable and enabled items (UBList3 is
	 * disabled); a drag from 1 to 3 selects 1 and 2 (3 is disabled),
	 * clears 5; applied */
	word l[4] = { 1, 5, 2, 0 };
	GenScanItemsReturn r;
	GenOptionsParams op;
	word v = 0;

	UBCHECK(@call UBList::MSG_GEN_ITEM_GROUP_GET_SELECTION() ==
		GIGS_NONE);
	UBCHECK(!@call UBList::MSG_GEN_ITEM_GROUP_GET_NUM_SELECTIONS());
	@call UBList::MSG_GEN_ITEM_GROUP_SET_SINGLE_SELECTION(2, FALSE);
	UBCHECK(@call UBList::MSG_GEN_ITEM_GROUP_GET_SELECTION() == 2);
	UBCHECK(@call UBList::MSG_GEN_ITEM_GROUP_IS_ITEM_SELECTED(2));
	UBCHECK(!@call UBList::MSG_GEN_ITEM_GROUP_IS_ITEM_SELECTED(1));
	@call UBList::MSG_GEN_ITEM_GROUP_SET_MULTIPLE_SELECTIONS(l, 3);
	memset(l, 0, sizeof(l));
	UBCHECK(@call UBList::MSG_GEN_ITEM_GROUP_GET_MULTIPLE_SELECTIONS(l,
								4) == 3);
	UBCHECK(l[0] == 1 && l[1] == 5 && l[2] == 2);
	UBCHECK(@call UBList::MSG_GEN_ITEM_GROUP_GET_SELECTION() == 1);
	UBCHECK(@call UBList::MSG_GEN_ITEM_GROUP_GET_MULTIPLE_SELECTIONS(l,
								2) == 3);
	@call UBList::MSG_GEN_ITEM_GROUP_SET_ITEM_STATE(5, FALSE);
	UBCHECK(@call UBList::MSG_GEN_ITEM_GROUP_GET_NUM_SELECTIONS() == 2);
	UBCHECK(!@call UBList::MSG_GEN_ITEM_GROUP_IS_ITEM_SELECTED(5));
	@call UBList::MSG_GEN_ITEM_GROUP_SET_ITEM_STATE(3, TRUE);
	UBCHECK(@call UBList::MSG_GEN_ITEM_GROUP_GET_NUM_SELECTIONS() == 3);
	UBCHECK(@call UBList::MSG_GEN_ITEM_GROUP_IS_ITEM_SELECTED(3));
	@call UBList::MSG_GEN_ITEM_GROUP_SET_NONE_SELECTED(TRUE);
	UBCHECK(!@call UBList::MSG_GEN_ITEM_GROUP_GET_NUM_SELECTIONS());
	UBCHECK(@call UBList::MSG_GEN_ITEM_GROUP_IS_INDETERMINATE());
	@call UBList::MSG_GEN_ITEM_GROUP_SET_INDETERMINATE_STATE(FALSE);
	UBCHECK(!@call UBList::MSG_GEN_ITEM_GROUP_IS_INDETERMINATE());
	UBCHECK(@call UBList::MSG_GEN_ITEM_GROUP_GET_ITEM_OPTR(5) ==
		@UBList5);
	UBCHECK(!@call UBList::MSG_GEN_ITEM_GROUP_GET_ITEM_OPTR(4));
	UBCHECK(@call UBList::MSG_GEN_ITEM_GROUP_GET_UNIQUE_IDENTIFIER() == 0);
	UBCHECK(@call UBList::MSG_GEN_ITEM_GROUP_P32_SCAN_ITEMS(&r,
		    GSIF_FROM_START | GSIF_FORWARD, 0, 0) && r.GSIR_item == 1);
	UBCHECK(@call UBList::MSG_GEN_ITEM_GROUP_P32_SCAN_ITEMS(&r,
		    GSIF_FORWARD, 2, 1) && r.GSIR_item == 5);
	UBCHECK(@call UBList::MSG_GEN_ITEM_GROUP_P32_SCAN_ITEMS(&r, 0, 5, 1) &&
		r.GSIR_item == 2);
	UBCHECK(@call UBList::MSG_GEN_ITEM_GROUP_P32_SCAN_ITEMS(&r,
		    GSIF_FORWARD, 5, 1) && r.GSIR_item == 5);
	UBCHECK(@call UBList::MSG_GEN_ITEM_GROUP_P32_SCAN_ITEMS(&r,
		    GSIF_FORWARD | GSIF_WRAP_AROUND, 5, 1) && r.GSIR_item == 1);
	@call UBList::MSG_GEN_ITEM_GROUP_SET_SINGLE_SELECTION(5, FALSE);
	@call UBList::MSG_GEN_ITEM_GROUP_UPDATE_EXTENDED_SELECTION(
		ESF_INITIAL_SELECTION | ESF_SELECT | ESF_CLEAR_UNSELECTED_ITEMS,
		MSG_GEN_ITEM_GROUP_SET_ITEM_STATE, 1, 3, 1);
	UBCHECK(@call UBList::MSG_GEN_ITEM_GROUP_GET_NUM_SELECTIONS() == 2);
	UBCHECK(@call UBList::MSG_GEN_ITEM_GROUP_IS_ITEM_SELECTED(1) &&
		@call UBList::MSG_GEN_ITEM_GROUP_IS_ITEM_SELECTED(2));
	UBCHECK(!@call UBList::MSG_GEN_ITEM_GROUP_IS_ITEM_SELECTED(5));
	@call UBList::MSG_GEN_APPLY();
	/* the options: the (first) selection saved */
	memcpy(op.GOP_category, "ubtest", 7);
	memcpy(op.GOP_key, "list", 5);
	@call UBList::MSG_GEN_SAVE_OPTIONS(&op);
	UBCHECK(!InitFileReadInteger("ubtest", "list", &v) && v == 1);

	/* the generic boolean group */
	@call UBBools::MSG_GEN_BOOLEAN_GROUP_SET_GROUP_STATE(5, 0);
	UBCHECK(@call UBBools::MSG_GEN_BOOLEAN_GROUP_GET_SELECTED_BOOLEANS()
		== 5);
	UBCHECK(@call UBBools::MSG_GEN_BOOLEAN_GROUP_IS_BOOLEAN_SELECTED(4));
	UBCHECK(!@call UBBools::MSG_GEN_BOOLEAN_GROUP_IS_BOOLEAN_SELECTED(2));
	@call UBBools::MSG_GEN_BOOLEAN_GROUP_SET_BOOLEAN_STATE(2, TRUE);
	@call UBBools::MSG_GEN_BOOLEAN_GROUP_SET_BOOLEAN_INDETERMINATE_STATE(
								4, TRUE);
	UBCHECK(@call UBBools::MSG_GEN_BOOLEAN_GROUP_GET_SELECTED_BOOLEANS()
		== 7);
	UBCHECK(@call
		UBBools::MSG_GEN_BOOLEAN_GROUP_GET_INDETERMINATE_BOOLEANS() == 4);
	UBCHECK(@call UBBools::MSG_GEN_BOOLEAN_GROUP_GET_BOOLEAN_OPTR(4) ==
		@UBBool4);
	UBCHECK(@call UBBools::MSG_GEN_BOOLEAN_GROUP_P32_SCAN_BOOLEANS(&r,
		    GSIF_FROM_START | GSIF_FORWARD, 0, 0) && r.GSIR_item == 1);
	@call UBBools::MSG_GEN_APPLY();
	break;
    }
    case 23: {
	/* the applies, queued */
	UBCHECK(ubState.UBS_itemApplies == 1 &&
		ubState.UBS_itemApply[0] == 1 &&
		ubState.UBS_itemApply[1] == 2 && !ubState.UBS_itemApply[2]);
	UBCHECK(ubState.UBS_boolApplies == 1 &&
		ubState.UBS_boolApply[0] == 7 &&
		ubState.UBS_boolApply[1] == 4 && !ubState.UBS_boolApply[2]);
	break;
    }
    case 24: {
	/* Doc 2's radio group and check boxes built by Motif: an
	 * OLItemGroup each, OLItems and OLCheckedItems, the first radio
	 * item and the first check box selected, at least a diamond high;
	 * Doc 2 on top, drawn.  The user's choices: the second radio
	 * item activated, then down: the third (each one applied
	 * through the queue); the second check box activated */
	OLItemInstance it;

	UBCHECK(InClass(@UBRadio, (ClassStruct *) &OLItemGroupClass));
	UBCHECK(InClass(@UBChecks, (ClassStruct *) &OLItemGroupClass));
	UBCHECK(InClass(@UBRadio1, (ClassStruct *) &OLItemClass) &&
		!InClass(@UBRadio1, (ClassStruct *) &OLCheckedItemClass));
	UBCHECK(InClass(@UBCheck1, (ClassStruct *) &OLCheckedItemClass));
	VisData(@UBRadio1, &it, sizeof(it));
	UBCHECK(it.OLII_state & OLIS_SELECTED);
	UBCHECK(!(it.OLII_state & OLIS_IS_CHECKBOX));
	VisData(@UBRadio2, &it, sizeof(it));
	UBCHECK(!(it.OLII_state & OLIS_SELECTED));
	VisData(@UBCheck1, &it, sizeof(it));
	UBCHECK((it.OLII_state & (OLIS_SELECTED | OLIS_IS_CHECKBOX)) ==
		(OLIS_SELECTED | OLIS_IS_CHECKBOX));
	UBCHECK(Height(@UBRadio1) >= 13 && Width(@UBRadio1) > 0);
	UBCHECK(Height(@UBCheck1) >= 11);
	@call UBDoc2::MSG_GEN_BRING_TO_TOP();
	@call UBRadio2::MSG_GEN_ACTIVATE();
	UBCHECK(@call UBRadio::MSG_GEN_ITEM_GROUP_GET_SELECTION() == 2);
	VisData(@UBRadio2, &it, sizeof(it));
	UBCHECK(it.OLII_state & OLIS_SELECTED);
	VisData(@UBRadio1, &it, sizeof(it));
	UBCHECK(!(it.OLII_state & OLIS_SELECTED));
	@call UBRadio::MSG_META_KBD_CHAR((VC_ISCTRL << 8) | VC_DOWN, 0, 0);
	UBCHECK(@call UBRadio::MSG_GEN_ITEM_GROUP_GET_SELECTION() == 3);
	@call UBCheck2::MSG_GEN_ACTIVATE();
	UBCHECK(@call UBChecks::MSG_GEN_BOOLEAN_GROUP_GET_SELECTED_BOOLEANS()
		== 3);
	VisData(@UBCheck2, &it, sizeof(it));
	UBCHECK(it.OLII_state & OLIS_SELECTED);
	break;
    }
    case 25: {
	/* applied (the radio group's two changes by one apply: the
	 * second finds it no longer modified); drawn (the state drawn
	 * known) */
	OLItemInstance it;

	UBCHECK(ubState.UBS_radioApplies == 1 && ubState.UBS_radioSel == 3);
	UBCHECK(ubState.UBS_checkApplies == 1 && ubState.UBS_checkSel == 3);
	VisData(@UBRadio3, &it, sizeof(it));
	UBCHECK(it.OLBI_optFlags & OLBOF_DRAW_STATE_KNOWN);
	UBCHECK(it.OLBI_optFlags & OLBOF_DRAWN_SELECTED);
	VisData(@UBCheck2, &it, sizeof(it));
	UBCHECK(it.OLBI_optFlags & OLBOF_DRAW_STATE_KNOWN);
	break;
    }
    case 26: {
	/* Doc 2's popup list: the group in a new popup (a menu window,
	 * not in the generic tree below Doc 2) with a popup list's
	 * button, which shows the selection ("Small") and is as wide as
	 * the list; down on the button: the next one */
	OLItemGroupInstance ig;
	OLMenuButtonInstance mb;
	OLPopupWinInstance pw;
	optr win, b;
	Rectangle r;

	VisData(@UBSize, &ig, sizeof(ig));
	UBCHECK(ig.OLIGI_moreState & OLIGMS_POPUP_LIST);
	UBCHECK(ig.OLIGI_moreState & OLIGMS_DISPLAYS_CURRENT_SELECTION);
	win = @call UBSize::MSG_VIS_FIND_PARENT();
	UBCHECK(InClass(win, (ClassStruct *) &OLMenuWinClass));
	UBCHECK(@call UBDoc2::MSG_GEN_FIND_CHILD(win) == 0xffff);
	UBCHECK(@call UBSize::MSG_GEN_FIND_PARENT() == @UBDoc2);
	if (!win)
	    break;
	VisData(win, &pw, sizeof(pw));
	b = ConstructOptr(OptrToHandle(win), pw.OLPWI_button);
	UBCHECK(pw.OLPWI_button &&
		InClass(b, (ClassStruct *) &OLMenuButtonClass));
	if (!pw.OLPWI_button)
	    break;
	VisData(b, &mb, sizeof(mb));
	UBCHECK(mb.OLMBI_specState & OLMBSS_OPENS_POPUP_LIST);
	UBCHECK(mb.OLBI_specState & OLBSS_MENU_DOWN_MARK);
	UBCHECK(MonikerIs(win, "Small"));
	r = Bounds(b);
	ubState.UBS_sizeButton[0] = r.R_right - r.R_left;
	ubState.UBS_sizeButton[1] = r.R_bottom - r.R_top;
	UBCHECK(r.R_right - r.R_left >= Width(@UBSize2));
	/* the list is in a menu: down on the closed list's button
	 * leaves the selection (as the original does, uiref variant
	 * 9); the second item activated takes it */
	@call b::MSG_META_KBD_CHAR((VC_ISCTRL << 8) | VC_DOWN,
				   CF_FIRST_PRESS, 0);
	UBCHECK(@call UBSize::MSG_GEN_ITEM_GROUP_GET_SELECTION() == 1);
	@call UBSize2::MSG_GEN_ACTIVATE();
	UBCHECK(@call UBSize::MSG_GEN_ITEM_GROUP_GET_SELECTION() == 2);
	break;
    }
    case 27: {
	/* applied once; the button shows the new selection; space on
	 * the button opens the list */
	OLPopupWinInstance pw;
	OLMenuButtonInstance mb;
	optr win, b;
	Rectangle r;

	UBCHECK(ubState.UBS_sizeApplies == 1 && ubState.UBS_sizeSel == 2);
	win = @call UBSize::MSG_VIS_FIND_PARENT();
	UBCHECK(MonikerIs(win, "Very large"));
	VisData(win, &pw, sizeof(pw));
	b = ConstructOptr(OptrToHandle(win), pw.OLPWI_button);
	r = Bounds(b);
	UBCHECK(r.R_right - r.R_left >= Width(@UBSize2));
	@call b::MSG_META_KBD_CHAR(VC_BLANK, CF_FIRST_PRESS, 0);
	VisData(b, &mb, sizeof(mb));
	UBCHECK(mb.OLMBI_specState & OLMBSS_POPUP_OPEN);
	break;
    }
    case 28: {
	/* the list up (realized), then closed by its item: the
	 * selection taken, the button again showing it */
	OLMenuButtonInstance mb;
	OLPopupWinInstance pw;
	VisInstance v;
	optr win, b;

	win = @call UBSize::MSG_VIS_FIND_PARENT();
	VisData(win, &v, sizeof(v));
	UBCHECK(v.VI_attrs & VA_REALIZED);
	@call UBSize1::MSG_GEN_ACTIVATE();
	UBCHECK(@call UBSize::MSG_GEN_ITEM_GROUP_GET_SELECTION() == 1);
	(void) @call win::MSG_GEN_GUP_INTERACTION_COMMAND(
						IC_INTERACTION_COMPLETE);
	VisData(win, &pw, sizeof(pw));
	b = ConstructOptr(OptrToHandle(win), pw.OLPWI_button);
	VisData(b, &mb, sizeof(mb));
	UBCHECK(!(mb.OLMBI_specState & OLMBSS_POPUP_OPEN));
	break;
    }
    case 29: {
	/* closed: the button shows the selection again ("Small"),
	 * applied a second time */
	optr win = @call UBSize::MSG_VIS_FIND_PARENT();

	UBCHECK(MonikerIs(win, "Small"));
	UBCHECK(ubState.UBS_sizeApplies == 2 && ubState.UBS_sizeSel == 1);
	break;
    }
    case 30: {
	/* Doc 2's scrollbar: Motif's OLScrollbar, vertical, the arrow
	 * size; a press on its down arrow: one increment down, applied as
	 * the down action; released: up again */
	OLScrollbarInstance sb;
	MouseReturnParams mr;
	Rectangle r;

	UBCHECK(InClass(@UBScroll, (ClassStruct *) &OLScrollbarClass));
	VisData(@UBScroll, &sb, sizeof(sb));
	UBCHECK(sb.OLSBI_attrs & OLSA_VERTICAL);
	UBCHECK(sb.OLSBI_arrowSize >= 8 && sb.OLSBI_arrowSize <= 14);
	r = Bounds(@UBScroll);
	ubState.UBS_scrollBar[0] = r.R_right - r.R_left;
	ubState.UBS_scrollBar[1] = r.R_bottom - r.R_top;
	/* Doc 2 is behind Doc 1: drawn into a GState without a window
	 * (the offsets figured: the thumb a fifth of the scroll area) */
	{
	    GStateHandle gs = GrCreateState(0);

	    @call UBScroll::MSG_VIS_DRAW(DF_EXPOSED, gs);
	    GrDestroyState(gs);
	}
	VisData(@UBScroll, &sb, sizeof(sb));
	UBCHECK(sb.OLSBI_scrArea ==
		r.R_bottom - r.R_top - (sb.OLSBI_arrowSize + 3) * 2);
	/* (the ratio a WWFixed fraction: a fifth rounded either way; the
	 * bar is as short as the lists beside it, where a fifth is less
	 * than the default thumb) */
	UBCHECK(sb.OLSBI_elevOffset == 0 &&
		sb.OLSBI_elevLen >= sb.OLSBI_scrArea / 5 - 1 &&
		sb.OLSBI_elevLen <= sb.OLSBI_scrArea / 2);
	UBCHECK(sb.OLSBI_state & OLSS_AT_TOP);
	UBCHECK(r.R_right - r.R_left == sb.OLSBI_arrowSize + 2);
	UBCHECK(r.R_bottom - r.R_top >= (sb.OLSBI_arrowSize + 3) * 2);
	@call UBScroll::MSG_META_START_SELECT(&mr, r.R_left + 3, r.R_bottom - 3,
		(UIFA_SELECT << 8) | BI_PRESS | BI_B0_DOWN);
	UBCHECK(mr.flags & MRF_PROCESSED);
	UBCHECK(IntegerOf(@call UBScroll::MSG_GEN_VALUE_GET_VALUE()) == 5);
	VisData(@UBScroll, &sb, sizeof(sb));
	UBCHECK((sb.OLSBI_state & OLSS_DOWN_FLAGS) == OLSS_INC_DOWN);
	@call UBScroll::MSG_META_END_SELECT(&mr, r.R_left + 3, r.R_bottom - 3,
					    0);
	VisData(@UBScroll, &sb, sizeof(sb));
	UBCHECK(!(sb.OLSBI_state & OLSS_DOWN_FLAGS));
	break;
    }
    case 31: {
	/* applied once as the down action with 5; the up arrow: back to
	 * 0 */
	OLScrollbarInstance sb;
	MouseReturnParams mr;
	Rectangle r;

	UBCHECK(ubState.UBS_scrollApplies == 1);
	UBCHECK(ubState.UBS_scrollAction == OLSS_INC_DOWN - 1);
	UBCHECK(ubState.UBS_scrollValue == 0x50000UL);
	VisData(@UBScroll, &sb, sizeof(sb));
	ubState.UBS_scrollBar[2] = sb.OLSBI_scrArea;
	r = Bounds(@UBScroll);
	@call UBScroll::MSG_META_START_SELECT(&mr, r.R_left + 3, r.R_top + 3,
		(UIFA_SELECT << 8) | BI_PRESS | BI_B0_DOWN);
	@call UBScroll::MSG_META_END_SELECT(&mr, r.R_left + 3, r.R_top + 3, 0);
	UBCHECK(IntegerOf(@call UBScroll::MSG_GEN_VALUE_GET_VALUE()) == 0);
	/* set from outside: kept in 0 .. 100 - 20 */
	@call UBScroll::MSG_GEN_VALUE_SET_INTEGER_VALUE(95, FALSE);
	UBCHECK(IntegerOf(@call UBScroll::MSG_GEN_VALUE_GET_VALUE()) == 80);
	break;
    }
    case 32: {
	/* the up action applied; at the bottom now */
	OLScrollbarInstance sb;

	UBCHECK(ubState.UBS_scrollApplies == 2);
	UBCHECK(ubState.UBS_scrollAction == OLSS_INC_UP - 1);
	VisData(@UBScroll, &sb, sizeof(sb));
	UBCHECK(sb.OLSBI_state & OLSS_AT_BOTTOM);
	UBCHECK(!(sb.OLSBI_state & OLSS_AT_TOP));
	/* back to the top, the thumb dragged half the scroll area down:
	 * the value from the thumb's place set on the release */
	@call UBScroll::MSG_GEN_VALUE_SET_INTEGER_VALUE(0, FALSE);
	{
	    GStateHandle gs = GrCreateState(0);
	    MouseReturnParams mr;
	    Rectangle r = Bounds(@UBScroll);
	    sword y, d;

	    @call UBScroll::MSG_VIS_DRAW(DF_EXPOSED, gs);
	    GrDestroyState(gs);
	    VisData(@UBScroll, &sb, sizeof(sb));
	    y = r.R_top + sb.OLSBI_arrowSize + 3 + sb.OLSBI_elevLen / 2;
	    d = sb.OLSBI_scrArea / 2;
	    @call UBScroll::MSG_META_START_SELECT(&mr, r.R_left + 3, y,
		(UIFA_SELECT << 8) | BI_PRESS | BI_B0_DOWN);
	    VisData(@UBScroll, &sb, sizeof(sb));
	    UBCHECK((sb.OLSBI_state & OLSS_DOWN_FLAGS) == OLSS_DRAG_AREA);
	    @call UBScroll::MSG_META_PTR(&mr, r.R_left + 3, y + d,
					 (UIFA_SELECT << 8) | BI_B0_DOWN);
	    VisData(@UBScroll, &sb, sizeof(sb));
	    UBCHECK(sb.OLSBI_xorElevOff == d);
	    UBCHECK(IntegerOf(@call UBScroll::MSG_GEN_VALUE_GET_VALUE()) == 0);
	    @call UBScroll::MSG_META_END_SELECT(&mr, r.R_left + 3, y + d, 0);
	    /* d / (scroll area - thumb) of the 80 available */
	    ubState.UBS_scrollDrag = IntegerOf(
			@call UBScroll::MSG_GEN_VALUE_GET_VALUE());
	    UBCHECK(ubState.UBS_scrollDrag >= 45 && ubState.UBS_scrollDrag <= 55);
	    VisData(@UBScroll, &sb, sizeof(sb));
	    UBCHECK(sb.OLSBI_xorElevOff == NO_XOR_ELEVATOR &&
		    !(sb.OLSBI_state & OLSS_DOWN_FLAGS));
	}
	break;
    }
    case 33: {
	/* the drag applied as such */
	UBCHECK(ubState.UBS_scrollApplies == 3);
	UBCHECK(ubState.UBS_scrollAction == OLSS_DRAG_AREA - 1);
	UBCHECK(IntegerOf(ubState.UBS_scrollValue) == ubState.UBS_scrollDrag);
	break;
    }
    case 34: {
	/* Doc 2's view: Motif's OLPane with a scrollbar each way and a
	 * window; its page the window's size (no scale); a step down, then
	 * an origin past the document's end: kept at the end less the
	 * page */
	OLPaneInstance p;
	GenViewInstance g;

	UBCHECK(InClass(@UBView, (ClassStruct *) &OLPaneClass));
	VisData(@UBView, &p, sizeof(p));
	UBCHECK(p.OLPI_vertScrollbar && p.OLPI_horizScrollbar);
	UBCHECK(InClass(ConstructOptr(OptrToHandle(@UBView),
				      p.OLPI_vertScrollbar),
			(ClassStruct *) &OLScrollbarClass));
	UBCHECK(p.OLPI_window != 0);
	UBCHECK(p.OLPI_pageWidth == p.OLPI_winWidth &&
		p.OLPI_pageHeight == p.OLPI_winHeight);
	UBCHECK(p.OLPI_winWidth > 0 && p.OLPI_winHeight > 0 &&
		p.OLPI_winWidth < 2000 && p.OLPI_winHeight < 300);
	ubState.UBS_view[0] = p.OLPI_pageWidth;
	ubState.UBS_view[1] = p.OLPI_pageHeight;
	{
	    Rectangle r = Bounds(@UBView);

	    ubState.UBS_view[2] = r.R_right - r.R_left;
	    ubState.UBS_view[3] = r.R_bottom - r.R_top;
	}
	@call UBView::MSG_GEN_VIEW_SCROLL_DOWN();
	ObjLockObjBlock(OptrToHandle(@UBView));
	g = *(GenViewInstance *) ObjDerefGen(@UBView);
	MemUnlock(OptrToHandle(@UBView));
	UBCHECK(g.GVI_origin.PDF_y.DWF_int == 10 &&
		g.GVI_origin.PDF_x.DWF_int == 0);
	@call UBView::MSG_GEN_VIEW_SET_ORIGIN(5000, 5000);
	ObjLockObjBlock(OptrToHandle(@UBView));
	g = *(GenViewInstance *) ObjDerefGen(@UBView);
	MemUnlock(OptrToHandle(@UBView));
	UBCHECK(g.GVI_origin.PDF_x.DWF_int == 2000 - p.OLPI_pageWidth);
	UBCHECK(g.GVI_origin.PDF_y.DWF_int == 300 - p.OLPI_pageHeight);
	VisData(@UBView, &p, sizeof(p));
	UBCHECK((p.OLPI_flags & (OLPF_AT_RIGHT_EDGE | OLPF_AT_BOTTOM_EDGE)) ==
		(OLPF_AT_RIGHT_EDGE | OLPF_AT_BOTTOM_EDGE));
	break;
    }
    case 35: {
	/* the content was given the window and told the origin; the
	 * scrollbars show it (a view's scrollbar values are document
	 * coordinates, not WWFixed); to the top: the vertical origin 0 */
	VisContentInstance c;
	OLPaneInstance p;
	optr sb;

	VisData(@UBView, &p, sizeof(p));
	VisData(@UBContent, &c, sizeof(c));
	UBCHECK(c.VCNI_window == p.OLPI_window);
	UBCHECK(c.VCNI_docOrigin.PD_x == 2000 - p.OLPI_pageWidth &&
		c.VCNI_docOrigin.PD_y == 300 - p.OLPI_pageHeight);
	sb = ConstructOptr(OptrToHandle(@UBView), p.OLPI_vertScrollbar);
	UBCHECK((sdword) @call sb::MSG_GEN_VALUE_GET_VALUE() ==
		300 - p.OLPI_pageHeight);
	sb = ConstructOptr(OptrToHandle(@UBView), p.OLPI_horizScrollbar);
	UBCHECK((sdword) @call sb::MSG_GEN_VALUE_GET_VALUE() ==
		2000 - p.OLPI_pageWidth);
	@call UBView::MSG_GEN_VIEW_SCROLL_TOP();
	VisData(@UBView, &p, sizeof(p));
	UBCHECK(!(p.OLPI_flags & OLPF_AT_BOTTOM_EDGE) &&
		(p.OLPI_flags & OLPF_AT_RIGHT_EDGE));
	sb = ConstructOptr(OptrToHandle(@UBView), p.OLPI_vertScrollbar);
	UBCHECK(@call sb::MSG_GEN_VALUE_GET_VALUE() == 0);
	/* the generic view: its content an OLContent in its window, the
	 * trigger built inside it */
	{
	    OLPaneInstance p2;
	    VisContentInstance c2;

	    UBCHECK(InClass(@UBGContent, (ClassStruct *) &OLContentClass));
	    VisData(@UBView2, &p2, sizeof(p2));
	    VisData(@UBGContent, &c2, sizeof(c2));
	    UBCHECK(p2.OLPI_window && c2.VCNI_window == p2.OLPI_window);
	    UBCHECK(VisCheckIfSpecBuilt(@UBInside) &&
		    @call UBInside::MSG_VIS_FIND_PARENT() == @UBGContent);
	}
	break;
    }
    case 36: {
	/* the scrolling list: in a view of its own (the list's moniker),
	 * as the only child of the view's content; its items as wide as
	 * the content, five of them shown; page down moves the selection
	 * four items on and scrolls it into view */
	OLScrollListInstance l;
	VisContentInstance c;
	OLPaneInstance p;
	GenViewInstance g;
	optr view, content;
	Rectangle r0, r1;

	UBCHECK(InClass(@UBSList, (ClassStruct *) &OLScrollListClass));
	UBCHECK(InClass(@UBSL0, (ClassStruct *) &OLScrollableItemClass));
	VisData(@UBSList, &l, sizeof(l));
	UBCHECK(l.OLSLI_view != 0 && (l.OLSLI_attrs & OLSLA_VERTICAL));
	view = ConstructOptr(OptrToHandle(@UBSList), l.OLSLI_view);
	UBCHECK(InClass(view, (ClassStruct *) &OLPaneClass));
	content = @call UBSList::MSG_VIS_FIND_PARENT();
	UBCHECK(InClass(content, (ClassStruct *) &OLContentClass));
	VisData(view, &p, sizeof(p));
	VisData(content, &c, sizeof(c));
	UBCHECK(p.OLPI_window && c.VCNI_window == p.OLPI_window);
	UBCHECK(l.OLSLI_itemLength > 0 && l.OLSLI_numVisibleItems == 5);
	UBCHECK(c.VCNI_viewHeight == 5 * l.OLSLI_itemLength);
	r0 = Bounds(@UBSL0);
	r1 = Bounds(@UBSL1);
	UBCHECK(r1.R_top == r0.R_bottom &&
		r0.R_bottom - r0.R_top == l.OLSLI_itemLength);
	UBCHECK(r0.R_right - r0.R_left == c.VCNI_viewWidth);
	UBCHECK(@call UBSList::MSG_GEN_ITEM_GROUP_GET_SELECTION() == 2);
	@call UBSList::MSG_OL_SLIST_PAGE_DOWN();
	UBCHECK(@call UBSList::MSG_GEN_ITEM_GROUP_GET_SELECTION() == 6);
	VisData(@UBSList, &l, sizeof(l));
	UBCHECK(l.OLSLI_topItem > 1 && l.OLSLI_topItem <= 6);
	ubState.UBS_slist[0] = l.OLSLI_itemLength;
	ubState.UBS_slist[1] = l.OLSLI_numVisibleItems;
	ubState.UBS_slist[2] = c.VCNI_viewWidth;
	ubState.UBS_slist[3] = c.VCNI_viewHeight;
	ubState.UBS_slist[4] = l.OLSLI_topItem;
	/* (the content hears of the new origin later, from the queue) */
	ObjLockObjBlock(OptrToHandle(view));
	g = *(GenViewInstance *) ObjDerefGen(view);
	MemUnlock(OptrToHandle(view));
	UBCHECK(g.GVI_origin.PDF_y.DWF_int ==
		(sdword) l.OLSLI_topItem * l.OLSLI_itemLength);
	@call UBSList::MSG_OL_SLIST_PAGE_UP();
	UBCHECK(@call UBSList::MSG_GEN_ITEM_GROUP_GET_SELECTION() == 2);
	VisData(@UBSList, &l, sizeof(l));
	UBCHECK(l.OLSLI_topItem <= 2);
	/* the dynamic list: a scrolling list; its items made once its
	 * view's size was known (done by the next step) */
	UBCHECK(InClass(@UBDList, (ClassStruct *) &OLScrollListClass));
	VisData(@UBDList, &l, sizeof(l));
	UBCHECK(l.OLIGI_state & OLIGS_DYNAMIC);
	break;
    }
    case 37: {
	/* every item shown asked for and answered: numbered from 0,
	 * interactable, with its moniker; then scrolled to item 12 */
	OLScrollListInstance l;
	optr i0, i4;

	VisData(@UBDList, &l, sizeof(l));
	ubState.UBS_dlist[1] = @call UBDList::MSG_GEN_COUNT_CHILDREN();
	UBCHECK(ubState.UBS_dlist[1] == l.OLSLI_numVisibleItems &&
		l.OLSLI_numVisibleItems == 5);
	UBCHECK(ubState.UBS_dlist[0] >= 5);
	i0 = @call UBDList::MSG_GEN_FIND_CHILD_AT_POSITION(0);
	i4 = @call UBDList::MSG_GEN_FIND_CHILD_AT_POSITION(4);
	UBCHECK(InClass(i0, (ClassStruct *) &OLScrollableItemClass));
	UBCHECK(@call i0::MSG_GEN_ITEM_GET_IDENTIFIER() == 0 &&
		@call i4::MSG_GEN_ITEM_GET_IDENTIFIER() == 4);
	UBCHECK(@call i0::MSG_GEN_GET_VIS_MONIKER() != 0);
	VisData(i0, &ii, sizeof(ii));
	UBCHECK(!(ii.OLII_state & OLIS_MONIKER_INVALID));
	UBCHECK(@call UBDList::MSG_GEN_DYNAMIC_LIST_GET_NUM_ITEMS() == 20);
	@call UBDList::MSG_GEN_ITEM_GROUP_SET_SINGLE_SELECTION(12, FALSE);
	@call UBDList::MSG_GEN_ITEM_GROUP_MAKE_ITEM_VISIBLE(12);
	break;
    }
    case 38: {
	/* scrolled: the top item, the items renumbered from it, 12
	 * among them, its new moniker answered */
	OLScrollListInstance l;
	optr i0, it;

	VisData(@UBDList, &l, sizeof(l));
	ubState.UBS_dlist[2] = l.OLSLI_topItem;
	UBCHECK(l.OLSLI_topItem > 7 && l.OLSLI_topItem <= 12);
	i0 = @call UBDList::MSG_GEN_FIND_CHILD_AT_POSITION(0);
	ubState.UBS_dlist[3] = @call i0::MSG_GEN_ITEM_GET_IDENTIFIER();
	UBCHECK(ubState.UBS_dlist[3] == l.OLSLI_topItem);
	it = @call UBDList::MSG_GEN_ITEM_GROUP_GET_ITEM_OPTR(12);
	UBCHECK(it != 0 && @call it::MSG_GEN_GET_VIS_MONIKER() != 0);
	VisData(it, &ii, sizeof(ii));
	UBCHECK(!(ii.OLII_state & OLIS_MONIKER_INVALID));
	UBCHECK(ii.OLBI_specState & OLBSS_SELECTED);
	UBCHECK(@call UBDList::MSG_GEN_ITEM_GROUP_GET_SELECTION() == 12);
	break;
    }
    case 39: {
	/* Doc 2's glyph: Motif's OLGlyphDisplay, as large as its text;
	 * the separator two pixels high, expanded to the display's
	 * width; a longer moniker: wider; not enabled */
	OLGlyphDisplayInstance g;
	Rectangle r = Bounds(@UBLabel), sr = Bounds(@UBSep);
	sword w = r.R_right - r.R_left;

	UBCHECK(InClass(@UBLabel, (ClassStruct *) &OLGlyphDisplayClass));
	UBCHECK(InClass(@UBSep, (ClassStruct *) &OLGlyphDisplayClass));
	VisData(@UBLabel, &g, sizeof(g));
	UBCHECK(!g.OLGDI_flags);
	UBCHECK(g.VI_attrs & VA_FULLY_ENABLED);
	ubState.UBS_glyph[0] = w;
	ubState.UBS_glyph[1] = r.R_bottom - r.R_top;
	UBCHECK(w >= 20 && w <= 80);
	UBCHECK(ubState.UBS_glyph[1] >= 8 && ubState.UBS_glyph[1] <= 20);
	VisData(@UBSep, &g, sizeof(g));
	UBCHECK(g.OLGDI_flags ==
		(OLGDF_SEPARATOR | OLGDF_EXPAND_WIDTH_TO_FIT_PARENT));
	ubState.UBS_glyph[2] = sr.R_right - sr.R_left;
	ubState.UBS_glyph[3] = sr.R_bottom - sr.R_top;
	UBCHECK(ubState.UBS_glyph[3] == 2);
	UBCHECK(ubState.UBS_glyph[2] > 200 && sr.R_left == r.R_left &&
		sr.R_top >= r.R_bottom);
	(void) @call UBLabel::MSG_GEN_REPLACE_VIS_MONIKER_TEXT(
		"A label that is longer", VUM_NOW);
	r = Bounds(@UBLabel);
	ubState.UBS_glyph[4] = r.R_right - r.R_left;
	UBCHECK(ubState.UBS_glyph[4] > w * 2);
	@call UBLabel::MSG_GEN_SET_NOT_ENABLED(VUM_NOW);
	VisData(@UBLabel, &g, sizeof(g));
	UBCHECK(!(g.VI_attrs & VA_FULLY_ENABLED));
	@call UBSep::MSG_GEN_SET_NOT_ENABLED(VUM_NOW);
	@call UBSep::MSG_GEN_SET_ENABLED(VUM_NOW);
	VisData(@UBSep, &g, sizeof(g));
	UBCHECK(g.VI_attrs & VA_FULLY_ENABLED);
	break;
    }
    case 40: {
	/* the text object in the view's document: its lines calculated
	 * when its geometry became valid (two of Berkeley 12), drawn
	 * with the document; a change of the text drawn at once */
	VisTextInstance t;
	VisTextGetLineOffsetAndFlagsParameters op;

	{
	    GenViewInstance gv;

	    ObjLockObjBlock(OptrToHandle(@UBView));
	    gv = *(GenViewInstance *) ObjDerefGen(@UBView);
	    MemUnlock(OptrToHandle(@UBView));
	    ubState.UBS_text[5] = (word) gv.GVI_origin.PDF_x.DWF_int;
	}
	/* (the view was scrolled to the right before) */
	@call UBView::MSG_GEN_VIEW_SET_ORIGIN(0, 0);
	VisData(@UBText, &t, sizeof(t));
	ubState.UBS_text[0] = t.VTI_lines;
	ubState.UBS_text[1] = t.VTI_height.WBF_int;
	ubState.UBS_text[2] = t.VI_attrs;
	UBCHECK(t.VTI_lines != 0 && (t.VI_attrs & VA_REALIZED));
	UBCHECK(t.VTI_height.WBF_int == 30 && !t.VTI_gstate);
	op.VTGLOAFP_line = 1;
	UBCHECK(!@call UBText::MSG_VIS_TEXT_GET_LINE_OFFSET_AND_FLAGS(&op));
	ubState.UBS_text[3] = (word) op.VTGLOAFP_offset;
	UBCHECK(op.VTGLOAFP_offset > 20 && op.VTGLOAFP_offset < 45 &&
		!(op.VTGLOAFP_flags & LF_NEEDS_DRAW));
	@call UBText::MSG_VIS_TEXT_APPEND_PTR(" :-)", 0);
	VisData(@UBText, &t, sizeof(t));
	ubState.UBS_text[4] = t.VTI_height.WBF_int;
	UBCHECK(t.VTI_height.WBF_int == 30 && !t.VTI_gstate);
	op.VTGLOAFP_line = 1;
	UBCHECK(!@call UBText::MSG_VIS_TEXT_GET_LINE_OFFSET_AND_FLAGS(&op));
	UBCHECK(!(op.VTGLOAFP_flags & LF_NEEDS_DRAW));
	break;
    }
    case 41: {
	/* editable, with the focus: the cursor at the selection (the
	 * end of the text after the append), flashing; moved with the
	 * selection; a range instead; back to a cursor */
	VisTextInstance t;

	@call UBText::MSG_VIS_TEXT_MODIFY_EDITABLE_SELECTABLE(
		VTS_EDITABLE | VTS_SELECTABLE, 0);
	/* (as a press in the display does: the display group, then the
	 * view take the focus; the view tells its content) */
	@call UBGroup::MSG_META_GRAB_FOCUS_EXCL();
	@call UBView::MSG_META_GRAB_FOCUS_EXCL();
	@call UBText::MSG_META_GRAB_FOCUS_EXCL();
	VisData(@UBText, &t, sizeof(t));
	UBCHECK(t.VTI_intFlags & VTIF_HILITED);
	break;
    }
    case 42: {
	/* (the view told its content by the queue) */
	VisTextInstance t;

	VisData(@UBText, &t, sizeof(t));
	ubState.UBS_text2[0] = t.VTI_intSelFlags;
	ubState.UBS_text2[1] = t.VTI_intFlags;
	ubState.UBS_text2[2] = t.VTI_cursorPos.P_x;
	ubState.UBS_text2[3] = t.VTI_cursorPos.P_y;
	UBCHECK(t.VTI_intSelFlags & VTISF_IS_FOCUS);
	UBCHECK(t.VTI_intSelFlags & VTISF_CURSOR_ENABLED);
	UBCHECK(t.VTI_intSelFlags & VTISF_CURSOR_ON);
	UBCHECK(t.VTI_intFlags & VTIF_HILITED);
	UBCHECK(t.VTI_gstate != 0 && t.VTI_timerHandle != 0);
	UBCHECK(t.VTI_cursorPos.P_y == 1 && t.VTI_cursorPos.P_x == 0);
	@call UBText::MSG_VIS_TEXT_SELECT_RANGE_SMALL(5, 5);
	VisData(@UBText, &t, sizeof(t));
	ubState.UBS_text2[4] = t.VTI_cursorPos.P_x;
	ubState.UBS_text2[5] = t.VTI_cursorPos.P_y;
	UBCHECK(t.VTI_cursorPos.P_y == 1 && t.VTI_cursorPos.P_x > 30 &&
		t.VTI_cursorPos.P_x < 50);
	UBCHECK(t.VTI_intSelFlags & VTISF_CURSOR_ENABLED);
	@call UBText::MSG_VIS_TEXT_SELECT_RANGE_SMALL(8, 30);
	VisData(@UBText, &t, sizeof(t));
	UBCHECK(!(t.VTI_intSelFlags & VTISF_CURSOR_ENABLED) &&
		(t.VTI_intFlags & VTIF_HILITED));
	break;
    }
    case 43: {
	/* typed over the range (as a replacement of the selection): a
	 * cursor after it, on the second line now */
	VisTextInstance t;

	@call UBText::MSG_VIS_TEXT_REPLACE_SELECTION_PTR("C, in two lines", 0);
	VisData(@UBText, &t, sizeof(t));
	ubState.UBS_text2[6] = t.VTI_cursorPos.P_x;
	ubState.UBS_text2[7] = t.VTI_cursorPos.P_y;
	UBCHECK(t.VTI_selectStart == 23 && t.VTI_selectEnd == 23);
	UBCHECK(t.VTI_intSelFlags & VTISF_CURSOR_ENABLED);
	UBCHECK(t.VTI_cursorPos.P_y == 16 && t.VTI_cursorPos.P_x > 20 &&
		t.VTI_cursorPos.P_x < 60);
	UBCHECK(t.VTI_height.WBF_int == 30);
	break;
    }
    case 44: {
	/* keys, as the view passes them to its content: text typed at
	 * the cursor; Home, Up, Right; Shift-Right selects, typing
	 * replaces the range; End, Ctrl-Left, Ctrl-Shift-Right, Delete, text;
	 * Down; Enter makes a line, Backspace takes it away; Ctrl-End */
	VisTextInstance t;
	VisTextGetLineOffsetAndFlagsParameters op;
	char buf[64];
	word n;

	TextKeys(" VisT");
	n = @call UBText::MSG_VIS_TEXT_GET_ALL_PTR(buf);
	UBCHECK(n == 44 &&
		!memcmp(buf, "Text in C, in two lines VisText, wrapped :-)", 45));
	VisData(@UBText, &t, sizeof(t));
	UBCHECK(t.VTI_selectStart == 28 && t.VTI_selectEnd == 28);
	UBCHECK(t.VTI_state & VTS_USER_MODIFIED);
	op.VTGLOAFP_line = 1;
	(void) @call UBText::MSG_VIS_TEXT_GET_LINE_OFFSET_AND_FLAGS(&op);
	ubState.UBS_text3[0] = (word) op.VTGLOAFP_offset;
	TextKey(UKEY(VC_HOME), 0);
	VisData(@UBText, &t, sizeof(t));
	UBCHECK(t.VTI_selectStart == op.VTGLOAFP_offset &&
		t.VTI_cursorPos.P_x == 0 && t.VTI_cursorPos.P_y == 16);
	TextKey(UKEY(VC_UP), 0);
	VisData(@UBText, &t, sizeof(t));
	UBCHECK(t.VTI_selectStart == 0 && t.VTI_cursorPos.P_y == 1);
	TextKey(UKEY(VC_RIGHT), 0);
	TextKey(UKEY(VC_RIGHT), 0);
	TextKey(UKEY(VC_RIGHT), SS_LSHIFT);
	TextKey(UKEY(VC_RIGHT), SS_LSHIFT);
	VisData(@UBText, &t, sizeof(t));
	ubState.UBS_text3[1] = (word) t.VTI_selectStart;
	ubState.UBS_text3[2] = (word) t.VTI_selectEnd;
	UBCHECK(t.VTI_selectStart == 2 && t.VTI_selectEnd == 4);
	TextKey(UKEY(VC_LEFT), SS_LSHIFT);
	VisData(@UBText, &t, sizeof(t));
	UBCHECK(t.VTI_selectStart == 2 && t.VTI_selectEnd == 3);
	TextKeys("X");
	n = @call UBText::MSG_VIS_TEXT_GET_ALL_PTR(buf);
	UBCHECK(n == 44 && !memcmp(buf, "TeXt in C", 9));
	TextKey(UKEY(VC_END), 0);
	VisData(@UBText, &t, sizeof(t));
	ubState.UBS_text3[3] = (word) t.VTI_selectStart;
	UBCHECK(t.VTI_selectStart == op.VTGLOAFP_offset - 1 &&
		t.VTI_cursorPos.P_y == 1);
	TextKey(UKEY(VC_LEFT), SS_LCTRL);
	VisData(@UBText, &t, sizeof(t));
	ubState.UBS_text3[4] = (word) t.VTI_selectStart;
	UBCHECK(t.VTI_selectStart == 18);
	TextKey(UKEY(VC_RIGHT), SS_LCTRL | SS_LSHIFT);
	VisData(@UBText, &t, sizeof(t));
	UBCHECK(t.VTI_selectStart == 18 && t.VTI_selectEnd == 23);
	TextKey(UKEY(VC_DEL), 0);
	n = @call UBText::MSG_VIS_TEXT_GET_ALL_PTR(buf);
	UBCHECK(n == 39 && !memcmp(buf, "TeXt in C, in two  VisText", 26));
	TextKeys("rows");
	TextKey(UKEY(VC_DOWN), 0);
	VisData(@UBText, &t, sizeof(t));
	ubState.UBS_text3[5] = (word) t.VTI_selectStart;
	UBCHECK(t.VTI_cursorPos.P_y == 16 && t.VTI_selectStart > 20);
	TextKey(UKEY(VC_ENTER), 0);
	VisData(@UBText, &t, sizeof(t));
	ubState.UBS_text3[6] = t.VTI_height.WBF_int;
	UBCHECK(t.VTI_height.WBF_int == 45 && t.VTI_cursorPos.P_y == 31 &&
		t.VTI_cursorPos.P_x == 0);
	TextKey(UKEY(VC_BACKSPACE), 0);
	VisData(@UBText, &t, sizeof(t));
	UBCHECK(t.VTI_height.WBF_int == 30 && t.VTI_cursorPos.P_y == 16);
	TextKey(UKEY(VC_END), SS_LCTRL);
	VisData(@UBText, &t, sizeof(t));
	ubState.UBS_text3[7] = (word) t.VTI_selectStart;
	UBCHECK(t.VTI_selectStart == 43 && t.VTI_selectEnd == 43);
	TextKeys("!");
	n = @call UBText::MSG_VIS_TEXT_GET_ALL_PTR(buf);
	UBCHECK(n == 44 &&
		!memcmp(buf, "TeXt in C, in two rows VisText, wrapped :-)!",
			45));
	break;
    }
    case 45: {
	/* the mouse, as the content gets it from the view: a press in
	 * the first line puts the cursor there and takes the mouse;
	 * dragged into the second line: a range; the release ends it; a
	 * double press selects the word */
	VisTextInstance t;
	MouseReturnParams mr;
	dword at;

	@call UBContent::MSG_META_START_SELECT(&mr, 50, 8,
		BI_PRESS | BI_B0_DOWN | (UIFA_SELECT << 8));
	VisData(@UBText, &t, sizeof(t));
	at = t.VTI_selectStart;
	ubState.UBS_text4[0] = (word) at;
	ubState.UBS_text4[1] = t.VTI_cursorPos.P_x;
	UBCHECK(at > 3 && at < 10 && t.VTI_selectEnd == at);
	UBCHECK(t.VTI_intSelFlags & VTISF_DOING_SELECTION);
	UBCHECK(t.VTI_cursorPos.P_y == 1 && t.VTI_cursorPos.P_x > 36 &&
		t.VTI_cursorPos.P_x < 56);
	@call UBContent::MSG_META_PTR(&mr, 70, 24,
		BI_B0_DOWN | (UIFA_SELECT << 8));
	VisData(@UBText, &t, sizeof(t));
	ubState.UBS_text4[2] = (word) t.VTI_selectEnd;
	UBCHECK(t.VTI_selectStart == at && t.VTI_selectEnd > 26 &&
		t.VTI_selectEnd < 36);
	@call UBContent::MSG_META_PTR(&mr, 20, 8,
		BI_B0_DOWN | (UIFA_SELECT << 8));
	VisData(@UBText, &t, sizeof(t));
	ubState.UBS_text4[3] = (word) t.VTI_selectStart;
	UBCHECK(t.VTI_selectStart < at && t.VTI_selectEnd == at);
	@call UBContent::MSG_META_END_SELECT(&mr, 20, 8, UIFA_SELECT << 8);
	VisData(@UBText, &t, sizeof(t));
	UBCHECK(!(t.VTI_intSelFlags & VTISF_DOING_SELECTION));
	@call UBContent::MSG_META_START_SELECT(&mr, 70, 24,
		BI_PRESS | BI_DOUBLE_PRESS | BI_B0_DOWN | (UIFA_SELECT << 8));
	@call UBContent::MSG_META_END_SELECT(&mr, 70, 24, UIFA_SELECT << 8);
	VisData(@UBText, &t, sizeof(t));
	ubState.UBS_text4[4] = (word) t.VTI_selectStart;
	ubState.UBS_text4[5] = (word) t.VTI_selectEnd;
	UBCHECK(t.VTI_selectStart == 32 && t.VTI_selectEnd == 39);
	break;
    }
    case 46:
	/* Doc 1 usable again: on top, with the texts in it */
	@call UBDoc1::MSG_GEN_SET_USABLE(VUM_NOW);
	break;
    case 47: {
	/* Doc 1's GenTexts are Motif's OLTexts.  The one to edit: one
	 * line in a frame with the frame's margins, the generic text its
	 * text, in a composite of its own that has the moniker; as wide
	 * as its hint, one line high.  The one to show: no frame, no
	 * margins, its text wrapped at its width, whole lines high. */
	OLTextInstance t;
	OLCtrlInstance c;
	GenTextInstance g;
	Rectangle r, cr;
	optr comp, texts;

	UBCHECK(GroupTarget() == @UBDoc1);
	UBCHECK(InClass(@UBName, (ClassStruct *) &OLTextClass));
	UBCHECK(InClass(@UBNote, (ClassStruct *) &OLTextClass));
	VisData(@UBName, &t, sizeof(t));
	ObjLockObjBlock(OptrToHandle(@UBName));
	memcpy(&g, ObjDerefGen(@UBName), sizeof(g));
	MemUnlock(OptrToHandle(@UBName));
	ubState.UBS_gtext[0] = t.OLTDI_specState;
	ubState.UBS_gtext[1] = t.OLTDI_moreState;
	UBCHECK(t.OLTDI_specState == (TDSS_IN_FRAME | TDSS_EDITABLE |
				      TDSS_IN_COMPOSITE));
	UBCHECK((t.OLTDI_moreState & TDSS_SELECTABLE) &&
		!(t.OLTDI_moreState & TDSS_EXPAND_WIDTH_TO_FIT_PARENT));
	UBCHECK((t.VTI_state & (VTS_ONE_LINE | VTS_EDITABLE | VTS_SELECTABLE))
		== (VTS_ONE_LINE | VTS_EDITABLE | VTS_SELECTABLE));
	UBCHECK(t.VTI_lrMargin == 2 && t.VTI_tbMargin == 2 &&
		t.VTI_maxLength == 10 && (t.VTI_filters & VTF_NO_TABS));
	UBCHECK(t.VTI_text && t.VTI_text == g.GTXI_text && t.VTI_lines);
	UBCHECK(t.VTI_washColor.CQ_info == CF_INDEX &&
		t.VTI_washColor.CQ_redOrIndex != C_BLACK);
	comp = @call UBName::MSG_VIS_FIND_PARENT();
	texts = @call UBNote::MSG_VIS_FIND_PARENT();
	UBCHECK(comp && OptrToChunk(comp) == t.OLTDI_viewObj &&
		InClass(comp, (ClassStruct *) &OLCtrlClass));
	UBCHECK(@call comp::MSG_VIS_FIND_PARENT() == texts);
	UBCHECK(@call UBName::MSG_SPEC_GET_SPECIFIC_VIS_OBJECT(0) == comp);
	UBCHECK(MonikerIs(comp, "Name"));
	VisData(comp, &c, sizeof(c));
	UBCHECK(c.OLCI_optFlags & OLCOF_DISPLAY_MONIKER);
	r = Bounds(@UBName);
	cr = Bounds(comp);
	ubState.UBS_gtext[2] = r.R_right - r.R_left;
	ubState.UBS_gtext[3] = r.R_bottom - r.R_top;
	ubState.UBS_gtext[4] = r.R_left - cr.R_left;
	UBCHECK(r.R_right - r.R_left == 110 + 4);	/* with the margins */
	UBCHECK(r.R_bottom - r.R_top ==
		@call UBName::MSG_VIS_TEXT_GET_LINE_HEIGHT() + 4);
	UBCHECK(r.R_left - cr.R_left > 20 && r.R_right <= cr.R_right &&
		r.R_top >= cr.R_top && r.R_bottom <= cr.R_bottom);

	VisData(@UBNote, &t, sizeof(t));
	UBCHECK(!t.OLTDI_specState);
	UBCHECK(!(t.OLTDI_moreState & TDSS_SELECTABLE) &&
		(t.OLTDI_moreState & TDSS_EXPAND_WIDTH_TO_FIT_PARENT));
	UBCHECK(!(t.VTI_state & (VTS_ONE_LINE | VTS_EDITABLE |
				 VTS_SELECTABLE)));
	UBCHECK(!t.VTI_lrMargin && !t.VTI_tbMargin && t.VTI_lines);
	UBCHECK(texts && InClass(texts, (ClassStruct *) &OLCtrlClass));
	r = Bounds(@UBNote);
	ubState.UBS_gtext[5] = r.R_right - r.R_left;
	ubState.UBS_gtext[6] = r.R_bottom - r.R_top;
	ubState.UBS_gtext[7] = t.VTI_height.WBF_int;
	UBCHECK(r.R_right - r.R_left == 100);
	UBCHECK(r.R_bottom - r.R_top == t.VTI_height.WBF_int &&
		t.VTI_height.WBF_int >=
		2 * @call UBNote::MSG_VIS_TEXT_GET_LINE_HEIGHT());
	/* neither takes the focus unless selectable */
	@call UBNote::MSG_META_GRAB_FOCUS_EXCL();
	@call UBName::MSG_META_GRAB_FOCUS_EXCL();
	break;
    }
    case 48: {
	/* the text to edit has the focus: its cursor;
	 * typed text makes the generic object modified; no more than
	 * the maximum length; Enter sends the status message (modified)
	 * and, by the queue, the apply message */
	OLTextInstance t;
	char buf[16];

	VisData(@UBName, &t, sizeof(t));
	ubState.UBS_gtext[12] = t.VTI_intSelFlags;
	/* (not the target: a generic object takes that only if it is
	 * GA_TARGETABLE) */
	UBCHECK((t.VTI_intSelFlags & VTISF_IS_FOCUS) &&
		!(t.VTI_intSelFlags & VTISF_IS_TARGET) && t.VTI_gstate);
	UBCHECK(t.VTI_intSelFlags & VTISF_CURSOR_ENABLED);
	VisData(@UBNote, &t, sizeof(t));
	UBCHECK(!(t.VTI_intSelFlags & VTISF_IS_FOCUS));
	UBCHECK(!@call UBName::MSG_GEN_TEXT_IS_MODIFIED());
	@call UBName::MSG_VIS_TEXT_SELECT_RANGE(TEXT_ADDRESS_PAST_END,
						TEXT_ADDRESS_PAST_END);
	@call UBName::MSG_META_KBD_CHAR('3', CF_FIRST_PRESS, 0);
	@call UBName::MSG_META_KBD_CHAR('3', CF_RELEASE, 0);
	@call UBName::MSG_META_KBD_CHAR('2', CF_FIRST_PRESS, 0);
	@call UBName::MSG_META_KBD_CHAR('2', CF_RELEASE, 0);
	(void) @call UBName::MSG_VIS_TEXT_GET_ALL_PTR(buf);
	memcpy(ubState.UBS_name, buf, 7);
	UBCHECK(!memcmp(buf, "Geos32", 7));
	UBCHECK(@call UBName::MSG_GEN_TEXT_IS_MODIFIED());
	UBCHECK(!ubState.UBS_gtext[8] && !ubState.UBS_gtext[10]);
	@call UBName::MSG_META_KBD_CHAR('x', CF_FIRST_PRESS, 0);
	@call UBName::MSG_META_KBD_CHAR('y', CF_FIRST_PRESS, 0);
	@call UBName::MSG_META_KBD_CHAR('z', CF_FIRST_PRESS, 0);
	@call UBName::MSG_META_KBD_CHAR('w', CF_FIRST_PRESS, 0);
	@call UBName::MSG_META_KBD_CHAR('v', CF_FIRST_PRESS, 0);
	UBCHECK(@call UBName::MSG_VIS_TEXT_GET_TEXT_SIZE() == 10);
	@call UBName::MSG_META_KBD_CHAR(UKEY(VC_ENTER), CF_FIRST_PRESS, 0);
	UBCHECK(ubState.UBS_gtext[10] == 1 &&
		ubState.UBS_gtext[11] == GTSF_MODIFIED);
	UBCHECK(!ubState.UBS_gtext[8]);
	UBCHECK(@call UBName::MSG_VIS_TEXT_GET_TEXT_SIZE() == 10);
	break;
    }
    case 49: {
	/* applied (modified), and no longer modified; not enabled: not
	 * editable, the focus gone, the composite not enabled either;
	 * enabled again.  The text to show gets more text: by the queue
	 * its geometry again. */
	OLTextInstance t;
	OLCtrlInstance c;
	optr comp = @call UBName::MSG_VIS_FIND_PARENT();

	UBCHECK(ubState.UBS_gtext[8] == 1 &&
		ubState.UBS_gtext[9] == GTSF_MODIFIED);
	UBCHECK(!@call UBName::MSG_GEN_TEXT_IS_MODIFIED());
	UBCHECK(!@call UBName::MSG_VIS_TEXT_GET_USER_MODIFIED_STATE());
	@call UBName::MSG_GEN_SET_NOT_ENABLED(VUM_NOW);
	VisData(@UBName, &t, sizeof(t));
	ubState.UBS_gtext[13] = t.VTI_intSelFlags;
	UBCHECK(!(t.VI_attrs & VA_FULLY_ENABLED) &&
		!(t.VTI_state & (VTS_EDITABLE | VTS_SELECTABLE)) &&
		!(t.VTI_intSelFlags & VTISF_IS_FOCUS));
	VisData(comp, &c, sizeof(c));
	UBCHECK(!(c.VI_attrs & VA_FULLY_ENABLED));
	@call UBName::MSG_GEN_SET_ENABLED(VUM_NOW);
	VisData(@UBName, &t, sizeof(t));
	UBCHECK((t.VI_attrs & VA_FULLY_ENABLED) &&
		(t.VTI_state & VTS_EDITABLE) && (t.VTI_state & VTS_SELECTABLE));
	VisData(comp, &c, sizeof(c));
	UBCHECK(c.VI_attrs & VA_FULLY_ENABLED);
	@call UBName::MSG_META_GRAB_FOCUS_EXCL();
	@call UBNote::MSG_VIS_TEXT_APPEND_PTR(
		", and more words that make it taller", 0);
	break;
    }
    case 50: {
	/* the text to show grew with its text; the one to edit has the
	 * focus again */
	OLTextInstance t;
	Rectangle r = Bounds(@UBNote);

	VisData(@UBNote, &t, sizeof(t));
	ubState.UBS_gtext[14] = r.R_bottom - r.R_top;
	ubState.UBS_gtext[15] = t.VTI_height.WBF_int;
	UBCHECK(r.R_bottom - r.R_top == t.VTI_height.WBF_int &&
		(word) (r.R_bottom - r.R_top) > ubState.UBS_gtext[6] &&
		r.R_right - r.R_left == 100);
	VisData(@UBName, &t, sizeof(t));
	UBCHECK(t.VTI_intSelFlags & VTISF_IS_FOCUS);
	break;
    }
    case 51: {
	/* one line scrolls: more text than fits moves the line left,
	 * the cursor at its end stays inside (no room after the text);
	 * Home brings the start back, End the end */
	OLTextInstance t;
	sword display, i;

	VisData(@UBName, &t, sizeof(t));
	display = t.VI_bounds.R_right - t.VI_bounds.R_left -
		  2 * t.VTI_lrMargin;
	UBCHECK(t.VTI_leftOffset == 0);
	@call UBName::MSG_VIS_TEXT_SET_MAX_LENGTH(40);
	@call UBName::MSG_VIS_TEXT_SELECT_RANGE(TEXT_ADDRESS_PAST_END,
						TEXT_ADDRESS_PAST_END);
	for (i = 0; i < 20; i++)
	    @call UBName::MSG_META_KBD_CHAR('a' + i, CF_FIRST_PRESS, 0);
	UBCHECK(@call UBName::MSG_VIS_TEXT_GET_TEXT_SIZE() == 30);
	VisData(@UBName, &t, sizeof(t));
	ubState.UBS_scroll[0] = (sword) t.VTI_leftOffset;
	ubState.UBS_scroll[1] = t.VTI_cursorPos.P_x;
	UBCHECK((sword) t.VTI_leftOffset < -50 &&
		t.VTI_cursorPos.P_x == display);
	@call UBName::MSG_META_KBD_CHAR(UKEY(VC_HOME), CF_FIRST_PRESS, 0);
	VisData(@UBName, &t, sizeof(t));
	ubState.UBS_scroll[2] = (sword) t.VTI_leftOffset;
	ubState.UBS_scroll[3] = t.VTI_cursorPos.P_x;
	UBCHECK(t.VTI_leftOffset == 0 && t.VTI_cursorPos.P_x == 0);
	@call UBName::MSG_META_KBD_CHAR(UKEY(VC_END), CF_FIRST_PRESS, 0);
	VisData(@UBName, &t, sizeof(t));
	UBCHECK((sword) t.VTI_leftOffset == ubState.UBS_scroll[0] &&
		t.VTI_cursorPos.P_x == display);
	/* text deleted from the end: the room it leaves is filled */
	@call UBName::MSG_META_KBD_CHAR(UKEY(VC_BACKSPACE), CF_FIRST_PRESS,
					0);
	VisData(@UBName, &t, sizeof(t));
	UBCHECK((sword) t.VTI_leftOffset > ubState.UBS_scroll[0] &&
		t.VTI_cursorPos.P_x == display);
	break;
    }
    case 52: {
	/* GenGadgets: Motif's OLGadget, sized and drawn by our class,
	 * and OLGadgetComp, the visible parent of its generic child;
	 * both answer the display scheme.  The window's default focus
	 * is the object with HINT_DEFAULT_FOCUS (found through the
	 * controls), not the first to navigate to */
	GenReturnParams q;
	Rectangle r = Bounds(@UBGadget), cr = Bounds(@UBGadgetC),
		  tr = Bounds(@UBGTrig);

	UBCHECK(ObjIsObjectInClass(@UBGadget, &OLGadgetClass));
	UBCHECK(ObjIsObjectInClass(@UBGadgetC, &OLGadgetCompClass));
	ubState.UBS_gadget[1] = r.R_right - r.R_left;
	ubState.UBS_gadget[2] = r.R_bottom - r.R_top;
	UBCHECK(ubState.UBS_gadget[1] == 30 && ubState.UBS_gadget[2] == 20);
	UBCHECK(ubState.UBS_gadget[0] >= 1);
	UBCHECK(@call UBGTrig::MSG_VIS_FIND_PARENT() == @UBGadgetC);
	UBCHECK(cr.R_right - cr.R_left >= tr.R_right - tr.R_left &&
		tr.R_right > tr.R_left && tr.R_left >= cr.R_left &&
		tr.R_top >= cr.R_top);
	memset(&q, 0, sizeof(q));
	UBCHECK(@call UBGadget::MSG_VIS_P32_VUP_QUERY(&q, VUQ_DISPLAY_SCHEME,
						      0, 0));
	ubState.UBS_gadget[3] = q.GRP_cx;
	UBCHECK(q.GRP_cx != 0);
	memset(&q, 0, sizeof(q));
	UBCHECK(@call UBGadgetC::MSG_VIS_P32_VUP_QUERY(&q,
						VUQ_DISPLAY_SCHEME, 0, 0) &&
		q.GRP_cx == ubState.UBS_gadget[3]);
	UBCHECK(@call UBDoc1::MSG_GEN_START_BROADCAST_FOR_DEFAULT_FOCUS() ==
		@UBName);
	break;
    }
    case 53: {
	/* UserCreateDialog: a copy of the template, a usable child of
	 * the application.  UserDoDialog: this thread runs the dialog
	 * and dispatches its own queue meanwhile: a timer presses Yes
	 * (the dialog is on the screen), a message to the process
	 * waits; the response is the trigger's command, the dialog
	 * down again.  UserDestroyDialog takes the copy away. */
	word kids = @call UBApp::MSG_GEN_COUNT_CHILDREN(), id;
	optr d = UserCreateDialog(@UBAsk), yes;

	UBCHECK(d && OptrToHandle(d) != OptrToHandle(@UBAsk) &&
		OptrToChunk(d) == OptrToChunk(@UBAsk));
	if (!d)
	    break;
	UBCHECK(@call d::MSG_GEN_FIND_PARENT() == @UBApp &&
		@call UBApp::MSG_GEN_COUNT_CHILDREN() == kids + 1);
	UBCHECK(@call d::MSG_GEN_GET_USABLE());
	yes = ConstructOptr(OptrToHandle(d), OptrToChunk(@UBAskYes));
	@send, forceQueue process::MSG_UB_HELD();
	(void) TimerStart(TIMER_EVENT_ONE_SHOT, yes, 20, MSG_GEN_ACTIVATE, 0,
			  &id);
	ubState.UBS_dlg[0] = UserDoDialog(d);
	UBCHECK(ubState.UBS_dlg[0] == IC_YES);
	UBCHECK(ubState.UBS_dlg[1] == 1);
	UBCHECK(ubState.UBS_dlg[2] == 0 && ubState.UBS_dlg[3] == 0);
	UBCHECK(!@call d::MSG_VIS_QUERY_WINDOW());
	UBCHECK(!@call UBApp::MSG_GEN_APPLICATION_CHECK_IF_RUNNING_USER_DO_DIALOG());
	UserDestroyDialog(d);
	UBCHECK(@call UBApp::MSG_GEN_COUNT_CHILDREN() == kids);
	break;
    }
    case 54:
	/* the message that waited came after the dialog */
	UBCHECK(ubState.UBS_dlg[3] == 1);
	break;
    case 55: {
	/* UserStandardDialog: a question with triggers of its own, the
	 * arguments in its text; a destructive action whose first
	 * trigger says yes has the default focus on the second.  A
	 * timer has the application answer "no". */
	StandardDialog2ResponseTriggerTable triggers;
	word kids = @call UBApp::MSG_GEN_COUNT_CHILDREN(), id;

	/* (filled here: an optr in constant data is not relocated) */
	triggers.SD2RTT_numTriggers = 2;
	triggers.SD2RTT_trigger1.SDRTE_moniker = @UBDeleteMoniker;
	triggers.SD2RTT_trigger1.SDRTE_responseValue = IC_YES;
	triggers.SD2RTT_trigger2.SDRTE_moniker = @UBKeepMoniker;
	triggers.SD2RTT_trigger2.SDRTE_responseValue = IC_NO;
	ubAnswer = IC_NO;
	(void) TimerStart(TIMER_EVENT_ONE_SHOT, @UBApp, 20, MSG_UB_ANSWER, 0,
			  &id);
	ubState.UBS_std[0] = UserStandardDialog(NULL, (char *) &triggers,
		"Disk", "Notes", "Delete \001 from \002?",
		(CDT_QUESTION << CDBF_DIALOG_TYPE_OFFSET) |
		(GIT_MULTIPLE_RESPONSE << CDBF_INTERACTION_TYPE_OFFSET) |
		CDBF_DESTRUCTIVE_ACTION);
	UBCHECK(ubState.UBS_std[0] == IC_NO);
	UBCHECK(ubState.UBS_std[1] == 1);
	/* (the group of picture and text, two triggers) */
	UBCHECK(ubState.UBS_std[2] == 3 && ubState.UBS_std[3] == 1);
	UBCHECK(!memcmp(ubState.UBS_stdText, "Delete Notes from Disk?",
			sizeof("Delete Notes from Disk?")));
	UBCHECK(@call UBApp::MSG_GEN_COUNT_CHILDREN() == kids);
	break;
    }
    case 56: {
	/* a standard dialog nobody waits for: an error, its response
	 * sent to the process */
	word kids = @call UBApp::MSG_GEN_COUNT_CHILDREN();

	ubState.UBS_std[4] = 0;
	ubState.UBS_stdText[0] = 0;
	@call UBApp::MSG_GEN_APPLICATION_DO_STANDARD_DIALOG(
		MSG_UB_STD_RESPONSE, ConstructOptr(GeodeGetProcessHandle(), 0),
		NULL, NULL, NULL, "42", "Error \001 happened.",
		(CDT_ERROR << CDBF_DIALOG_TYPE_OFFSET) |
		(GIT_NOTIFICATION << CDBF_INTERACTION_TYPE_OFFSET));
	UBCHECK(@call UBApp::MSG_GEN_COUNT_CHILDREN() == kids + 1);
	break;
    }
    case 57:
	/* it is on the screen; answered */
	UBCHECK(ubState.UBS_std[4] == 0);
	ubAnswer = IC_OK;
	@call UBApp::MSG_UB_ANSWER();
	UBCHECK(ubState.UBS_std[1] == 1);
	UBCHECK(!memcmp(ubState.UBS_stdText, "Error 42 happened.",
			sizeof("Error 42 happened.")));
	break;
    case 58:
	/* the response came, the dialog is gone */
	UBCHECK(ubState.UBS_std[4] == 0x100 + IC_OK);
	UBCHECK(@call UBApp::MSG_GEN_COUNT_CHILDREN() == 6);
	break;
    case 59: {
	/* a GenValue is a spin gadget: its value as text in a frame,
	 * a scrollbar of two arrows right of it; a press on the upper
	 * arrow steps the value up: modified, applied by the queue */
	OLValueInstance v;
	OLScrollbarInstance sb;
	Rectangle r, a, b;
	MouseReturnParams mr;
	optr bar;

	UBCHECK(InClass(@UBCount, (ClassStruct *) &OLValueClass));
	VisData(@UBCount, &v, sizeof(v));
	UBCHECK(v.OLSGI_attrs == OLSGA_TEXT);
	UBCHECK(v.OLSGI_states & OLSGS_DRAW_FRAME);
	UBCHECK(v.OLVLI_item && v.OLSGI_scrollbar && !v.OLSGI_text);
	UBCHECK(v.OLVLI_maxLength == 2);
	UBCHECK(ItemIs(v.OLVLI_item, "5"));
	bar = ConstructOptr(OptrToHandle(@UBCount), v.OLSGI_scrollbar);
	UBCHECK(@call bar::MSG_VIS_FIND_PARENT() == @UBCount);
	VisData(bar, &sb, sizeof(sb));
	UBCHECK((sb.OLSBI_attrs & (OLSA_STUPID | OLSA_VERTICAL)) ==
		(OLSA_STUPID | OLSA_VERTICAL));
	r = Bounds(@UBCount);
	b = Bounds(bar);
	@call UBCount::MSG_SPEC_SPIN_GET_BOUNDS(&a);
	UBCHECK(a.R_left > r.R_left && a.R_right < b.R_left &&
		b.R_right <= r.R_right);
	UBCHECK(a.R_right - a.R_left == (sword) v.OLSGI_desWidth);
	UBCHECK(a.R_top > r.R_top && a.R_bottom < r.R_bottom);
	UBCHECK(b.R_top >= r.R_top && b.R_bottom <= r.R_bottom);
	memset(&mr, 0, sizeof(mr));
	@call bar::MSG_META_START_SELECT(&mr, b.R_left + 3, b.R_top + 2,
		(UIFA_SELECT << 8) | BI_PRESS | BI_B0_DOWN);
	UBCHECK(mr.flags & MRF_PROCESSED);
	@call bar::MSG_META_END_SELECT(&mr, b.R_left + 3, b.R_top + 2, 0);
	UBCHECK(@call UBCount::MSG_GEN_VALUE_GET_INTEGER_VALUE() == 6);
	UBCHECK(@call UBCount::MSG_GEN_VALUE_IS_MODIFIED());
	UBCHECK(ItemIs(v.OLVLI_item, "6"));
	UBCHECK(!ubState.UBS_count[0]);
	break;
    }
    case 60: {
	/* applied; a press in the text gives the gadget the focus: a
	 * text object on the item's chunk (through the queue) */
	Rectangle a;
	MouseReturnParams mr;

	UBCHECK(ubState.UBS_count[0] == 1 && ubState.UBS_count[1] == 6);
	UBCHECK(ubState.UBS_count[2] & GVSF_MODIFIED);
	UBCHECK(!@call UBCount::MSG_GEN_VALUE_IS_MODIFIED());
	@call UBCount::MSG_SPEC_SPIN_GET_BOUNDS(&a);
	memset(&mr, 0, sizeof(mr));
	@call UBCount::MSG_META_START_SELECT(&mr, a.R_left + 2, a.R_top + 2,
		(UIFA_SELECT << 8) | BI_PRESS | BI_B0_DOWN);
	@call UBCount::MSG_META_END_SELECT(&mr, a.R_left + 2, a.R_top + 2, 0);
	break;
    }
    case 61: {
	/* the text object has the focus (the gadget gave it on), its
	 * cursor where the press was, before the 6: a typed digit goes
	 * in (only as many as the longest value has, no letters), the
	 * value is modified; asking for the value reads the text */
	OLValueInstance v;
	VisTextInstance t;
	optr text;

	VisData(@UBCount, &v, sizeof(v));
	UBCHECK(v.OLSGI_text && !(v.OLSGI_states & OLSGS_HAS_FOCUS));
	if (!v.OLSGI_text)
	    break;
	text = ConstructOptr(OptrToHandle(@UBCount), v.OLSGI_text);
	VisData(text, &t, sizeof(t));
	UBCHECK(t.VTI_text == v.OLVLI_item);
	UBCHECK(t.VTI_maxLength == 2);
	UBCHECK(t.VTI_state & VTS_ONE_LINE);
	UBCHECK(@call text::MSG_VIS_FIND_PARENT() == @UBCount);
	@call text::MSG_META_KBD_CHAR('1', CF_FIRST_PRESS, 0);
	@call text::MSG_META_KBD_CHAR('x', CF_FIRST_PRESS, 0);
	@call text::MSG_META_KBD_CHAR('2', CF_FIRST_PRESS, 0);
	@call text::MSG_META_KBD_CHAR('3', CF_FIRST_PRESS, 0);
	UBCHECK(ItemIs(v.OLVLI_item, "16"));
	UBCHECK(@call UBCount::MSG_GEN_VALUE_IS_MODIFIED());
	UBCHECK(@call UBCount::MSG_GEN_VALUE_GET_INTEGER_VALUE() == 16);
	/* the up arrow key steps, shift with it goes to the maximum */
	@call text::MSG_META_KBD_CHAR(UKEY(VC_UP), CF_FIRST_PRESS, 0);
	UBCHECK(@call UBCount::MSG_GEN_VALUE_GET_INTEGER_VALUE() == 17);
	UBCHECK(ItemIs(v.OLVLI_item, "17"));
	@call text::MSG_META_KBD_CHAR(UKEY(VC_UP),
			CF_FIRST_PRESS | (SS_LSHIFT << 8), 0);
	UBCHECK(@call UBCount::MSG_GEN_VALUE_GET_INTEGER_VALUE() == 20);
	break;
    }
    case 62: {
	/* the applies of the typed value and the steps came; the focus
	 * back to the name: the text object goes (through the queue) */
	OLValueInstance v;

	VisData(@UBCount, &v, sizeof(v));
	UBCHECK(ubState.UBS_count[0] >= 2 && ubState.UBS_count[1] == 20);
	UBCHECK(!@call UBCount::MSG_GEN_VALUE_IS_MODIFIED());
	/* a value from the application: shown, not modified */
	@call UBCount::MSG_GEN_VALUE_SET_INTEGER_VALUE(14, FALSE);
	UBCHECK(ItemIs(v.OLVLI_item, "14"));
	UBCHECK(!@call UBCount::MSG_GEN_VALUE_IS_MODIFIED());
	@call UBName::MSG_META_GRAB_FOCUS_EXCL();
	break;
    }
    case 63: {
	OLValueInstance v;

	VisData(@UBCount, &v, sizeof(v));
	UBCHECK(!v.OLSGI_text && !(v.OLSGI_states & OLSGS_HAS_FOCUS));
	UBCHECK(v.OLVLI_item && ItemIs(v.OLVLI_item, "14"));
	/* the focus by the keyboard (as navigation gives it) */
	@call UBCount::MSG_META_MUP_ALTER_FTVMC_EXCL(@UBCount,
				MAEF_GRAB | MAEF_FOCUS | MAEF_NOT_HERE);
	break;
    }
    case 64: {
	/* a text object again, all its text selected: a typed digit
	 * replaces it; the focus gone, the typed value is taken */
	OLValueInstance v;
	optr text;

	VisData(@UBCount, &v, sizeof(v));
	UBCHECK(v.OLSGI_text);
	if (!v.OLSGI_text)
	    break;
	text = ConstructOptr(OptrToHandle(@UBCount), v.OLSGI_text);
	@call text::MSG_META_KBD_CHAR('9', CF_FIRST_PRESS, 0);
	UBCHECK(ItemIs(v.OLVLI_item, "9"));
	@call UBName::MSG_META_GRAB_FOCUS_EXCL();
	UBCHECK(@call UBCount::MSG_GEN_VALUE_IS_MODIFIED());
	memcpy(ubState.UBS_countText, ItemText(v.OLVLI_item), 3);
	break;
    }
    case 65:
	UBCHECK(ubState.UBS_count[1] == 9);
	break;
    case 66: {
	/* the sliders: a GenValue with HINT_VALUE_ANALOG_DISPLAY is a
	 * spin gadget with an OLSlider below its text (a vertical one
	 * beside it), with the minimum and maximum and hash marks; one
	 * that also merges its text is the OLSlider itself */
	OLValueInstance v;
	OLSliderInstance sl;
	MouseReturnParams mr;
	Rectangle b;
	optr bar;
	WWFixedAsDWord half = 0x8000;
	GenValueStateFlagsAsWord sf;

	memset(&sf, 0, sizeof(sf));
	@call UBDoc1::MSG_GEN_BRING_TO_TOP();
	@call UBPrimary::MSG_GEN_UPDATE_VISUAL(VUM_NOW);
	UBCHECK(InClass(@UBSlide, (ClassStruct *) &OLValueClass));
	VisData(@UBSlide, &v, sizeof(v));
	UBCHECK((v.OLSGI_attrs & (OLSGA_SLIDER | OLSGA_SHOW_MIN_MAX_MKRS |
				  OLSGA_SHOW_HASH_MARKS |
				  OLSGA_ORIENT_VERTICALLY |
				  OLSGA_CANT_EDIT_TEXT)) ==
		(OLSGA_SLIDER | OLSGA_SHOW_MIN_MAX_MKRS |
		 OLSGA_SHOW_HASH_MARKS));
	UBCHECK(!(v.OLSGI_states & OLSGS_DRAW_FRAME));
	UBCHECK(v.VCI_geoAttrs & VCGA_ORIENT_CHILDREN_VERTICALLY);
	UBCHECK(v.OLSGI_desWidth == 200 && v.OLSGI_scrollbar);
	bar = ConstructOptr(OptrToHandle(@UBSlide), v.OLSGI_scrollbar);
	UBCHECK(InClass(bar, (ClassStruct *) &OLSliderClass));
	VisData(bar, &sl, sizeof(sl));
	UBCHECK((sl.OLSBI_attrs & (OLSA_SLIDER | OLSA_VERTICAL | OLSA_STUPID |
				   OLSA_UPDATE_DURING_DRAGS)) ==
		(OLSA_SLIDER | OLSA_UPDATE_DURING_DRAGS));
	UBCHECK(sl.OLSI_numMajorIntervals == 4 &&
		sl.OLSI_numMinorIntervals == 20);
	b = Bounds(bar);
	/* (the hash marks: five pixels and two more below the bar) */
	UBCHECK(b.R_bottom - b.R_top == (sword) sl.OLSBI_arrowSize + 2 + 7);
	UBCHECK(b.R_right - b.R_left >= 200);
	UBCHECK(ItemIs(v.OLVLI_item, "30"));
	/* the thumb dragged to the middle */
	@call UBSlide::MSG_SPEC_SPIN_VALUE_CHANGED(half, sf);
	UBCHECK(@call UBSlide::MSG_GEN_VALUE_GET_INTEGER_VALUE() == 50);
	UBCHECK(@call UBSlide::MSG_GEN_VALUE_IS_MODIFIED());
	UBCHECK(ItemIs(v.OLVLI_item, "50"));
	/* a press left of the thumb: down by the increment */
	memset(&mr, 0, sizeof(mr));
	@call bar::MSG_META_START_SELECT(&mr, b.R_left + 3, b.R_top + 3,
		(UIFA_SELECT << 8) | BI_PRESS | BI_B0_DOWN);
	UBCHECK(mr.flags & MRF_PROCESSED);
	@call bar::MSG_META_END_SELECT(&mr, b.R_left + 3, b.R_top + 3, 0);
	UBCHECK(@call UBSlide::MSG_GEN_VALUE_GET_INTEGER_VALUE() == 45);
	/* the gauge: read-only, its bar too */
	VisData(@UBGauge, &v, sizeof(v));
	UBCHECK((v.OLSGI_attrs & (OLSGA_SLIDER | OLSGA_CANT_EDIT_TEXT |
				  OLSGA_NO_UP_DOWN_ARROWS)) ==
		(OLSGA_SLIDER | OLSGA_CANT_EDIT_TEXT));
	bar = ConstructOptr(OptrToHandle(@UBGauge), v.OLSGI_scrollbar);
	UBCHECK(InClass(bar, (ClassStruct *) &OLSliderClass));
	UBCHECK(GenAttrsOf(bar) & GA_READ_ONLY);
	/* the merged one */
	UBCHECK(InClass(@UBMerged, (ClassStruct *) &OLSliderClass));
	VisData(@UBMerged, &sl, sizeof(sl));
	UBCHECK((sl.OLSBI_attrs & (OLSA_SLIDER | OLSA_TEXT_TOO)) ==
		(OLSA_SLIDER | OLSA_TEXT_TOO));
	/* the vertical one */
	VisData(@UBVSlide, &v, sizeof(v));
	UBCHECK(v.OLSGI_attrs & OLSGA_ORIENT_VERTICALLY);
	UBCHECK(!(v.VCI_geoAttrs & VCGA_ORIENT_CHILDREN_VERTICALLY));
	UBCHECK(v.OLSGI_desHeight == 100);
	bar = ConstructOptr(OptrToHandle(@UBVSlide), v.OLSGI_scrollbar);
	VisData(bar, &sl, sizeof(sl));
	UBCHECK(sl.OLSBI_attrs & OLSA_VERTICAL);
	b = Bounds(bar);
	UBCHECK(b.R_bottom - b.R_top >= 100);
	UBCHECK(b.R_right - b.R_left == (sword) sl.OLSBI_arrowSize + 2 + 7);
	break;
    }
    case 67: {
	/* the paths of a generic object (MSG_GEN_PATH_SET, _GET) and the
	 * generic part of a file selector that is not built (and in no
	 * tree: there is no specific class for it yet): its criteria
	 * and match attributes, the selection and the full selection
	 * path; what only the specific part does fails */
	char buf[PATH_BUFFER_SIZE + FILE_LONGNAME_BUFFER_SIZE];
	GetTokenCreatorParams tok;
	GetActionParams act;
	MemHandle mh;
	dword d;
	optr fs = ObjInstantiate(OptrToHandle(@UBTexts),
				 (ClassStruct *) &GenFileSelectorClass);

	UBCHECK(!GenCheckIfSpecGrown(fs));
	UBCHECK(@call fs::MSG_GEN_PATH_GET_DISK_HANDLE() == SP_TOP);
	UBCHECK(!@call fs::MSG_GEN_PATH_SET("", SP_TOP));
	buf[0] = 'x';
	UBCHECK(!@call fs::MSG_GEN_PATH_GET(buf, sizeof(buf)));
	UBCHECK(!buf[0]);
	UBCHECK(@call fs::MSG_GEN_PATH_GET(buf, 0));
	UBCHECK(@call fs::MSG_GEN_PATH_GET_DISK_HANDLE() == SP_TOP);
	UBCHECK(ObjVarFindData(fs, TEMP_GEN_PATH_SAVED_DISK_HANDLE));
	mh = @call fs::MSG_GEN_PATH_GET_BLOCK(NULL, 0);
	UBCHECK(mh);
	UBCHECK(!*(char *) MemLock(mh));
	MemFree(mh);
	/* a path that does not exist */
	UBCHECK(@call fs::MSG_GEN_PATH_SET("NOSUCH.DIR", 0));
	UBCHECK(@call fs::MSG_GEN_PATH_GET_DISK_HANDLE() == SP_TOP);

	@call fs::MSG_GEN_FILE_SELECTOR_SET_FILE_CRITERIA(
			FSFC_DIRS | FSFC_NON_GEOS_FILES);
	UBCHECK(@call fs::MSG_GEN_FILE_SELECTOR_GET_FILE_CRITERIA() ==
		(FSFC_DIRS | FSFC_NON_GEOS_FILES));
	@call fs::MSG_GEN_FILE_SELECTOR_SET_ATTRS(
			FSA_ALLOW_CHANGE_DIRS | FSA_HAS_FILE_LIST);
	UBCHECK(@call fs::MSG_GEN_FILE_SELECTOR_GET_ATTRS() ==
		(FSA_ALLOW_CHANGE_DIRS | FSA_HAS_FILE_LIST));
	@call fs::MSG_GEN_FILE_SELECTOR_SET_MASK("*.TXT");
	buf[0] = 0;
	@call fs::MSG_GEN_FILE_SELECTOR_GET_MASK(buf);
	UBCHECK(StrIs(buf, "*.TXT"));
	UBCHECK(@call fs::MSG_GEN_FILE_SELECTOR_GET_FILE_ATTRS() ==
		((FA_SYSTEM | FA_HIDDEN) << 8));
	@call fs::MSG_GEN_FILE_SELECTOR_SET_FILE_ATTRS(FA_RDONLY,
							    FA_SYSTEM);
	UBCHECK(@call fs::MSG_GEN_FILE_SELECTOR_GET_FILE_ATTRS() ==
		(FA_RDONLY | (FA_SYSTEM << 8)));
	@call fs::MSG_GEN_FILE_SELECTOR_SET_GEODE_ATTRS(GA_APPLICATION,
							     GA_LIBRARY);
	d = @call fs::MSG_GEN_FILE_SELECTOR_GET_GEODE_ATTRS();
	UBCHECK(GET_MATCH_ATTRS(d) == GA_APPLICATION &&
		GET_MISMATCH_ATTRS(d) == GA_LIBRARY);
	@call fs::MSG_GEN_FILE_SELECTOR_GET_TOKEN(&tok);
	UBCHECK(!tok.GTP_token.GT_chars[0]);
	@call fs::MSG_GEN_FILE_SELECTOR_SET_TOKEN(
			SET_TOKEN_CHARS('T', 'E', 'S', 'T'), 7);
	@call fs::MSG_GEN_FILE_SELECTOR_GET_TOKEN(&tok);
	UBCHECK(!memcmp(tok.GTP_token.GT_chars, "TEST", 4) &&
		tok.GTP_token.GT_manufID == 7);
	@call fs::MSG_GEN_FILE_SELECTOR_SET_CREATOR(
			SET_TOKEN_CHARS('M', 'A', 'K', 'E'), 0);
	@call fs::MSG_GEN_FILE_SELECTOR_GET_CREATOR(&tok);
	UBCHECK(!memcmp(tok.GTP_token.GT_chars, "MAKE", 4));
	@call fs::MSG_GEN_FILE_SELECTOR_SET_ACTION(@UBApp,
						       MSG_GEN_APPLY);
	@call fs::MSG_GEN_FILE_SELECTOR_GET_ACTION(&act);
	UBCHECK(act.GAP_output == @UBApp && act.GAP_message == MSG_GEN_APPLY);

	/* no selection yet: the flags say "error" */
	d = @call fs::MSG_GEN_FILE_SELECTOR_GET_SELECTION(buf);
	UBCHECK(GFS_GET_ENTRY_FLAGS(d) == GFSEF_ERROR && !buf[0]);
	UBCHECK(!@call fs::MSG_GEN_FILE_SELECTOR_SET_SELECTION("FOO"));
	(void) @call fs::MSG_GEN_FILE_SELECTOR_GET_SELECTION(buf);
	UBCHECK(StrIs(buf, "FOO"));
	d = @call fs::MSG_GEN_FILE_SELECTOR_GET_FULL_SELECTION_PATH(buf);
	UBCHECK(GFS_GET_FULL_SELECTION_PATH_DISK_HANDLE(d) == SP_TOP);
	UBCHECK(StrIs(buf, "\\FOO"));
	d = @call fs::MSG_GEN_FILE_SELECTOR_GET_FULL_SELECTION_PATH(NULL);
	UBCHECK(GFS_GET_FULL_SELECTION_PATH_DISK_HANDLE(d) == SP_TOP);
	/* a full path: the root's backslash is the path, the rest the
	 * selection; a relative name is all selection */
	UBCHECK(!@call fs::MSG_GEN_FILE_SELECTOR_SET_FULL_SELECTION_PATH(
			"\\BAR.TXT", SP_TOP));
	(void) @call fs::MSG_GEN_FILE_SELECTOR_GET_SELECTION(buf);
	UBCHECK(StrIs(buf, "BAR.TXT"));
	UBCHECK(@call fs::MSG_GEN_PATH_GET_DISK_HANDLE() == SP_TOP);
	UBCHECK(!@call fs::MSG_GEN_FILE_SELECTOR_SET_FULL_SELECTION_PATH(
			"BAZ", 0));
	(void) @call fs::MSG_GEN_FILE_SELECTOR_GET_SELECTION(buf);
	UBCHECK(StrIs(buf, "BAZ"));
	/* the selection is no directory: the destination is the path */
	buf[0] = 'x';
	UBCHECK(!@call fs::MSG_GEN_FILE_SELECTOR_GET_DESTINATION_PATH(
			buf, sizeof(buf)));
	UBCHECK(!buf[0]);
	UBCHECK(@call fs::MSG_GEN_FILE_SELECTOR_OPEN_ENTRY(0));
	UBCHECK(@call fs::MSG_GEN_FILE_SELECTOR_SUSPEND());
	UBCHECK(@call fs::MSG_GEN_FILE_SELECTOR_END_SUSPEND());
	break;
    }
    case 68: {
	/* the file selector on screen (Motif's OLFileSelectorClass): in
	 * DOCUMENT\FSTEST with a directory and two files.  The list
	 * starts with the current directory, then the directories, then
	 * the files by name; the first entry is selected and told to
	 * the destination. */
	UBCHECK(!@call UBFSel::MSG_GEN_PATH_SET("FSTEST", SP_DOCUMENT));
	@call UBFiles::MSG_GEN_INTERACTION_INITIATE();
	@call UBFiles::MSG_GEN_UPDATE_VISUAL(VUM_NOW);
	UBCHECK(@call UBFiles::MSG_VIS_QUERY_WINDOW() != 0);
	UBCHECK(GenCheckIfSpecGrown(@UBFSel));
	break;
    }
    case 69: {
	UBCHECK(ubState.UBS_fsel[0] >= 1);
	UBCHECK(ubState.UBS_fsel[1] == 0);
	FSelSelection(0);
	UBCHECK(ubState.UBS_fselSel[0][0] == 0);
	UBCHECK(ubState.UBS_fselSel[0][1] & GFSEF_PARENT_DIR);
	UBCHECK(GFS_GET_ENTRY_TYPE(ubState.UBS_fselSel[0][1]) ==
		GFSET_SUBDIR);
	/* a file selected by its name; one that is not there */
	ubState.UBS_fsel[0] = 0;
	UBCHECK(!@call UBFSel::MSG_GEN_FILE_SELECTOR_SET_SELECTION("BETA.TXT"));
	FSelSelection(1);
	UBCHECK(ubState.UBS_fselSel[1][0] == 3);
	UBCHECK(GFS_GET_ENTRY_TYPE(ubState.UBS_fselSel[1][1]) == GFSET_FILE);
	UBCHECK(StrIsCI(ubState.UBS_fselName[1], "BETA.TXT"));
	UBCHECK(@call UBFSel::MSG_GEN_FILE_SELECTOR_SET_SELECTION("NONE.TXT"));
	FSelSelection(2);
	UBCHECK(ubState.UBS_fselSel[2][0] == 3);
	UBCHECK(@call UBFSel::MSG_GEN_FILE_SELECTOR_OPEN_ENTRY(9));
	break;
    }
    case 70: {
	/* the directory opened (as a double press on it): the list is
	 * its files, the path the directory */
	UBCHECK(ubState.UBS_fsel[0] == 1 && ubState.UBS_fsel[1] == 3);
	ubState.UBS_fsel[0] = 0;
	UBCHECK(!@call UBFSel::MSG_GEN_FILE_SELECTOR_OPEN_ENTRY(1));
	UBCHECK(!@call UBFSel::MSG_GEN_PATH_GET(ubState.UBS_fselPath[0],
			sizeof(ubState.UBS_fselPath[0])));
	UBCHECK(StrIsCI(ubState.UBS_fselPath[0], "FSTEST\\LETTERS"));
	UBCHECK(!@call UBFSel::MSG_GEN_FILE_SELECTOR_SET_SELECTION("NOTE.TXT"));
	FSelSelection(3);
	UBCHECK(ubState.UBS_fselSel[3][0] == 1);
	UBCHECK(@call UBFSel::MSG_GEN_FILE_SELECTOR_OPEN_ENTRY(2));
	break;
    }
    case 71: {
	/* up: the selection goes to the current directory first, then
	 * the parent is shown with the directory left selected */
	@call UBFSel::MSG_GEN_FILE_SELECTOR_UP_DIRECTORY();
	FSelSelection(4);
	UBCHECK(ubState.UBS_fselSel[4][0] == 0);
	@call UBFSel::MSG_GEN_FILE_SELECTOR_UP_DIRECTORY();
	UBCHECK(!@call UBFSel::MSG_GEN_PATH_GET(ubState.UBS_fselPath[1],
			sizeof(ubState.UBS_fselPath[1])));
	UBCHECK(StrIsCI(ubState.UBS_fselPath[1], "FSTEST"));
	FSelSelection(5);
	UBCHECK(ubState.UBS_fselSel[5][0] == 1);
	UBCHECK(StrIsCI(ubState.UBS_fselName[5], "LETTERS"));
	break;
    }
    case 72: {
	/* a mask: only the files that match are listed (the
	 * directories all); suspended, a change waits */
	char name[FILE_LONGNAME_BUFFER_SIZE];

	@call UBFSel::MSG_GEN_FILE_SELECTOR_SET_MASK("A*");
	UBCHECK(@call UBFSel::MSG_GEN_FILE_SELECTOR_SET_SELECTION("BETA.TXT"));
	UBCHECK(!@call UBFSel::MSG_GEN_FILE_SELECTOR_SET_SELECTION("ALPHA.TXT"));
	UBCHECK(GFS_GET_ENTRY_NUMBER(@call UBFSel::
		MSG_GEN_FILE_SELECTOR_GET_SELECTION(name)) == 2);
	UBCHECK(!@call UBFSel::MSG_GEN_FILE_SELECTOR_SUSPEND());
	UBCHECK(@call UBFSel::MSG_GEN_FILE_SELECTOR_SUSPEND());
	@call UBFSel::MSG_GEN_FILE_SELECTOR_SET_MASK("*");
	UBCHECK(!@call UBFSel::MSG_GEN_FILE_SELECTOR_END_SUSPEND());
	UBCHECK(@call UBFSel::MSG_GEN_FILE_SELECTOR_END_SUSPEND());
	UBCHECK(!@call UBFSel::MSG_GEN_FILE_SELECTOR_SET_SELECTION("BETA.TXT"));
	UBCHECK(GFS_GET_ENTRY_NUMBER(@call UBFSel::
		MSG_GEN_FILE_SELECTOR_GET_SELECTION(name)) == 3);
	break;
    }
    case 73:
	/* the dialog closed */
	(void) @call UBFiles::MSG_GEN_GUP_INTERACTION_COMMAND(IC_DISMISS);
	@call UBFiles::MSG_GEN_UPDATE_VISUAL(VUM_NOW);
	UBCHECK(!@call UBFiles::MSG_VIS_QUERY_WINDOW());
	break;
    case 74: {
	/* a controller (GenControlClass) in a dialog: built, it copies
	 * its normal UI and adds the children of its features; seen, it
	 * is on its lists; disabled until a list has something to say */
	GenControlGetFeaturesReturn r;

	memset(&r, 0, sizeof(r));
	@call UBCtl::MSG_GEN_CONTROL_GET_NORMAL_FEATURES(&r);
	UBCHECK(r.GCSR_features == 3 && r.GCSR_supported == 3);
	UBCHECK(!@call UBCtl::MSG_GEN_COUNT_CHILDREN());
	@call UBCtl::MSG_GEN_INTERACTION_INITIATE();
	@call UBCtl::MSG_GEN_UPDATE_VISUAL(VUM_NOW);
	UBCHECK(@call UBCtl::MSG_VIS_QUERY_WINDOW() != 0);
	UBCtlState(0);
	UBCHECK(ubState.UBS_ctlAt[0][0] == 0x1003);
	UBCHECK(ubState.UBS_ctlAt[0][1] & GCIF_NORMAL_UI);
	UBCHECK(!(ubState.UBS_ctlAt[0][2] & 1));
	UBCHECK((ubState.UBS_ctlAt[0][3] & 0xff) == 0x21);
	UBCHECK(!ubState.UBS_ctl[0]);
	break;
    }
    case 75:
	/* the list's status: a block enables the controller and has it
	 * update its UI; none disables it */
	UBCtlNotify(TRUE);
	UBCtlState(1);
	UBCHECK(ubState.UBS_ctlAt[1][2] & 1);
	UBCHECK(ubState.UBS_ctl[0] == 1 && ubState.UBS_ctl[1] == 3);
	UBCHECK(ubState.UBS_ctl[3]);
	UBCtlNotify(FALSE);
	UBCHECK(!@call UBCtl::MSG_GEN_GET_ENABLED());
	UBCHECK(ubState.UBS_ctl[0] == 1);
	UBCtlNotify(TRUE);
	UBCHECK(@call UBCtl::MSG_GEN_GET_ENABLED());
	UBCHECK(ubState.UBS_ctl[0] == 2);
	break;
    case 76:
	/* a feature removed by the user: the UI is made again without
	 * it; added again */
	@call UBCtl::MSG_GEN_CONTROL_REMOVE_FEATURE(UBCF_B);
	UBCtlState(2);
	UBCHECK(ubState.UBS_ctlAt[2][0] == 0x1001);
	UBCHECK((ubState.UBS_ctlAt[2][3] & 0xff) == 0x11);
	@call UBCtl::MSG_GEN_CONTROL_ADD_FEATURE(UBCF_B);
	UBCtlState(3);
	UBCHECK(ubState.UBS_ctlAt[3][0] == 0x1003);
	UBCHECK((ubState.UBS_ctlAt[3][3] & 0xff) == 0x21);
	break;
    case 77: {
	/* the tools below another object, enabled as the controller;
	 * the tool feature removed and added; a message to the output */
	word v = 0x77;

	UBCHECK(@call UBCtl::MSG_VIS_QUERY_WINDOW() != 0);
	@call UBCtl::MSG_GEN_CONTROL_GENERATE_TOOLBOX_UI(@UBToolBox);
	UBCtlState(4);
	UBCHECK(ubState.UBS_ctlAt[4][0] == 0x7103);
	UBCHECK(ubState.UBS_ctlAt[4][1] & GCIF_TOOLBOX_UI);
	UBCHECK(ubState.UBS_ctlAt[4][2] == 3);
	UBCHECK((ubState.UBS_ctlAt[4][3] >> 8) == 1);
	@call UBCtl::MSG_GEN_CONTROL_REMOVE_TOOLBOX_FEATURE(1);
	UBCtlState(5);
	UBCHECK(ubState.UBS_ctlAt[5][0] == 0x5003);
	UBCHECK((ubState.UBS_ctlAt[5][3] >> 8) == 0);
	@call UBCtl::MSG_GEN_CONTROL_ADD_TOOLBOX_FEATURE(1);
	UBCtlState(6);
	UBCHECK(ubState.UBS_ctlAt[6][0] == 0x7103);
	UBCHECK((ubState.UBS_ctlAt[6][3] >> 8) == 1);
	GenControlOutputAction(@UBCtl, MSG_UB_CTL_OUT, &v, sizeof(v), NULL);
	break;
    }
    case 78:
	/* closed, the normal UI is no longer seen; not usable, all the
	 * UI is destroyed */
	UBCHECK(ubState.UBS_ctl[4] == 1 && ubState.UBS_ctl[5] == 0x77);
	(void) @call UBCtl::MSG_GEN_GUP_INTERACTION_COMMAND(IC_DISMISS);
	@call UBCtl::MSG_GEN_UPDATE_VISUAL(VUM_NOW);
	UBCHECK(!@call UBCtl::MSG_VIS_QUERY_WINDOW());
	@call UBCtl::MSG_GEN_SET_NOT_USABLE(VUM_NOW);
	UBCtlState(7);
	UBCHECK(ubState.UBS_ctlAt[7][0] == 0);
	UBCHECK(ubState.UBS_ctlAt[7][1] == 0);
	UBCHECK(ubState.UBS_ctlAt[7][3] == 0);
	@call UBCtl::MSG_GEN_SET_USABLE(VUM_NOW);
	break;
    case 79: {
	/* a tool group (GenToolGroupClass): built, it has its
	 * controller make the tools below it; highlighted it is
	 * enabled, then again as the controller is */
	word i;

	@call UBToolBox::MSG_GEN_ADD_CHILD(@UBToolGrp, CCO_LAST);
	@call UBToolGrp::MSG_GEN_SET_USABLE(VUM_NOW);
	@call UBToolBox::MSG_GEN_INTERACTION_INITIATE();
	@call UBToolBox::MSG_GEN_UPDATE_VISUAL(VUM_NOW);
	UBCHECK(@call UBToolBox::MSG_VIS_QUERY_WINDOW() != 0);
	for (i = 0; i < 3; i++) {
	    if (i == 1) {
		@call UBCtl::MSG_GEN_SET_NOT_ENABLED(VUM_NOW);
		@call UBToolGrp::MSG_GEN_TOOL_GROUP_SET_HIGHLIGHT(
			TGHT_ACTIVE_HIGHLIGHT);
	    } else if (i == 2)
		@call UBToolGrp::MSG_GEN_TOOL_GROUP_SET_HIGHLIGHT(
			TGHT_NO_HIGHLIGHT);
	    ubState.UBS_tgrp[0] |=
		(@call UBToolGrp::MSG_GEN_COUNT_CHILDREN() == 1) << i;
	    ubState.UBS_tgrp[1] |=
		(@call UBToolGrp::MSG_GEN_GET_ENABLED() != 0) << i;
	    ObjLockObjBlock(OptrToHandle(@UBToolGrp));
	    ubState.UBS_tgrp[2] |= (ObjVarFindData(@UBToolGrp,
			TEMP_TOOL_GROUP_HIGHLIGHT) != NULL) << i;
	    MemUnlock(OptrToHandle(@UBToolGrp));
	}
	UBCHECK(ubState.UBS_tgrp[0] == 7);
	UBCHECK(ubState.UBS_tgrp[1] == 3);
	UBCHECK(ubState.UBS_tgrp[2] == 2);
	@call UBCtl::MSG_GEN_SET_ENABLED(VUM_NOW);
	UBCHECK(@call UBToolGrp::MSG_GEN_GET_ENABLED());
	(void) @call UBToolBox::MSG_GEN_GUP_INTERACTION_COMMAND(IC_DISMISS);
	@call UBToolBox::MSG_GEN_UPDATE_VISUAL(VUM_NOW);
	break;
    }
    case 80: {
	/* the document control (OLDocumentControlClass) in the File
	 * menu: its entries are its children (New/Open, Open (not
	 * usable: Motif has none), Close, Save, Save As, Backup,
	 * Other); without a document New/Open alone is enabled, with
	 * a clean one (GWNT_DOCUMENT_CHANGE) also Close, Save As,
	 * Backup and Other, with a dirty one Save too, but not New/Open
	 * (one document at a time, and it has changes) */
	@call UBFile::MSG_GEN_ADD_CHILD(@UBDocCtl, CCO_FIRST);
	@call UBDocCtl::MSG_GEN_SET_USABLE(VUM_NOW);
	@call UBFile::MSG_GEN_INTERACTION_INITIATE();
	break;
    }
    case 81: {
	word pass, i, n;

	n = @call UBDocCtl::MSG_GEN_COUNT_CHILDREN();
	ubState.UBS_docCtl[0] = n;
	for (pass = 0; pass < 3; pass++) {
	    if (pass) {
		MemHandle bh = MemAlloc(sizeof(NotifyDocumentChange),
					HF_SWAPABLE | HF_SHARABLE,
					HAF_ZERO_INIT);
		NotifyDocumentChange *ndc = MemLock(bh);
		EventHandle ev;

		ndc->NDC_attrs = GDA_ON_WRITABLE_MEDIA |
				 (pass == 2 ? GDA_DIRTY : 0);
		MemUnlock(bh);
		MemInitRefCount(bh, 1);
		@call UBDocCtl::MSG_GEN_CONTROL_ENABLE_DISABLE(
			MSG_GEN_SET_ENABLED, VUM_NOW);
		ev = @record null::MSG_META_NOTIFY_WITH_DATA_BLOCK(
			MANUFACTURER_ID_GEOWORKS, GWNT_DOCUMENT_CHANGE, bh);
		@call UBApp::MSG_META_GCN_LIST_SEND(GCNLSF_SET_STATUS, ev, bh,
			GAGCNLT_APP_TARGET_NOTIFY_DOCUMENT_CHANGE,
			MANUFACTURER_ID_GEOWORKS);
	    }
	    for (i = 0; i < n && i < 16; i++) {
		optr c = @call UBDocCtl::MSG_GEN_FIND_CHILD_AT_POSITION(i);

		if (!pass && @call c::MSG_GEN_GET_USABLE())
		    ubState.UBS_docCtl[1] |= 1 << i;
		if (@call c::MSG_GEN_GET_ENABLED())
		    ubState.UBS_docCtl[2 + pass] |= 1 << i;
	    }
	}
	UBCHECK(ubState.UBS_docCtl[0] == 7);
	UBCHECK(ubState.UBS_docCtl[1] == 0x7d);
	UBCHECK(ubState.UBS_docCtl[2] == 0x63);
	UBCHECK(ubState.UBS_docCtl[3] == 0x77);
	UBCHECK(ubState.UBS_docCtl[4] == 0x7c);
	break;
    }
    case 82:
    case 83:
    case 84:
    case 85:
    case 86:
    case 87:
    case 88:
    case 89:
    case 90: {
	/* the dialogs of the document control (cmainUIDocOperations):
	 * each is a copy of its resource, up as the control's task says,
	 * and takes the place of the one before (but for the main dialog,
	 * which leaves a dialog alone); save as, open, use
	 * template, type, password, copy to, move to, the main dialog;
	 * then none */
	static const struct { Message msg; word task; } dlg[] = {
	    { MSG_GEN_DOCUMENT_CONTROL_INITIATE_SAVE_AS_DOC, GDCT_SAVE_AS },
	    { MSG_GEN_DOCUMENT_CONTROL_INITIATE_OPEN_DOC, GDCT_OPEN },
	    { MSG_GEN_DOCUMENT_CONTROL_INITIATE_USE_TEMPLATE_DOC,
	      GDCT_USE_TEMPLATE },
	    { MSG_GEN_DOCUMENT_CONTROL_INITIATE_SET_TYPE_DOC, GDCT_TYPE },
	    { MSG_GEN_DOCUMENT_CONTROL_INITIATE_SET_PASSWORD_DOC,
	      GDCT_PASSWORD },
	    { MSG_GEN_DOCUMENT_CONTROL_INITIATE_COPY_TO_DOC, GDCT_COPY_TO },
	    { MSG_GEN_DOCUMENT_CONTROL_INITIATE_MOVE_TO_DOC, GDCT_MOVE_TO },
	    { MSG_GEN_DOCUMENT_CONTROL_DISPLAY_DIALOG, GDCT_DIALOG },
	    { MSG_GEN_DOCUMENT_CONTROL_FILE_EXPORTED, GDCT_NONE }
	};
	word k = step - 82, task;

	if (!k)
	    (void) @call UBFile::MSG_GEN_GUP_INTERACTION_COMMAND(IC_DISMISS);
	/* (the main dialog does not come up over another) */
	if (dlg[k].task == GDCT_DIALOG)
	    @call UBDocCtl::MSG_GEN_DOCUMENT_CONTROL_FILE_EXPORTED();
	CObjMessageP(MF_CALL, @UBDocCtl, dlg[k].msg, NULL, 0, NULL, 0);
	task = (@call UBDocCtl::MSG_GEN_DOCUMENT_CONTROL_GET_ATTRS() &
		GDCA_CURRENT_TASK) >> GDCA_CURRENT_TASK_OFFSET;
	ubState.UBS_docDlg[k] = task;
	UBCHECK(task == dlg[k].task);
	break;
    }
    case 91: {
	/* the document group (OLDocumentGroupClass): what it has itself
	 * and what it asks the control; the model node without a
	 * document; no document has a file open; the id of a file
	 * (IACPGetDocumentID) */
	DocumentCommonParams p;
	optr model = @UBApp;
	DiskHandle d1 = SP_DOCUMENT, d2 = SP_DOCUMENT, d3 = SP_DOCUMENT;
	dword id1, id2, id3;

	ubState.UBS_docGrp[0] =
	    @call UBDocGrp::MSG_GEN_DOCUMENT_GROUP_GET_ATTRS();
	UBCHECK(ubState.UBS_docGrp[0] & GDGA_VM_FILE);
	ubState.UBS_docGrp[1] =
	    (word) @call UBDocGrp::MSG_GEN_DOCUMENT_GROUP_GET_PROTOCOL();
	UBCHECK(@call UBDocGrp::MSG_GEN_DOCUMENT_GROUP_GET_PROTOCOL() == 1);
	UBCHECK(@call UBDocGrp::MSG_GEN_DOCUMENT_GROUP_GET_UI_ATTRS() ==
		@call UBDocCtl::MSG_GEN_DOCUMENT_CONTROL_GET_ATTRS());
	UBCHECK(@call UBDocGrp::MSG_GEN_DOCUMENT_GROUP_GET_UI_FEATURES() ==
		@call UBDocCtl::MSG_GEN_DOCUMENT_CONTROL_GET_FEATURES());
	memset(&p, 0, sizeof(p));
	UBCHECK(@call UBDocGrp::MSG_GEN_DOCUMENT_GROUP_GET_DEFAULT_NAME(
		    (char *) &p) == ubState.UBS_docGrp[0]);
	ubState.UBS_docGrp[2] = p.DCP_diskHandle;
	UBCHECK(p.DCP_diskHandle == SP_DOCUMENT && !p.DCP_path[0]);
	UBCHECK(StrIs(p.DCP_name, "Untitled"));
	UBCHECK(@call UBDocGrp::MSG_META_GET_MODEL_EXCL(&model) && !model);
	UBCHECK(!@call UBDocGrp::MSG_GEN_DOCUMENT_GROUP_GET_DOC_BY_FILE(1));
	@call UBDocGrp::MSG_GEN_DOCUMENT_GROUP_SET_OUTPUT(@UBApp);
	UBCHECK(@call UBDocGrp::MSG_GEN_DOCUMENT_GROUP_GET_OUTPUT() == @UBApp);
	/* (the name and the disk are as before after the search) */
	memset(&p, 0, sizeof(p));
	p.DCP_diskHandle = SP_DOCUMENT;
	memcpy(p.DCP_name, "FSTEST", 7);
	ubState.UBS_docGrp[3] =
	    @call UBDocGrp::MSG_GEN_DOCUMENT_GROUP_SEARCH_FOR_DOC(&p);
	UBCHECK(!ubState.UBS_docGrp[3]);
	UBCHECK(p.DCP_diskHandle == SP_DOCUMENT && !p.DCP_flags &&
		StrIs(p.DCP_name, "FSTEST"));
	id1 = IACPGetDocumentID("", "FSTEST", &d1);
	id2 = IACPGetDocumentID("", "FSTEST", &d2);
	id3 = IACPGetDocumentID("", "NOSUCH", &d3);
	ubState.UBS_docGrp[4] = (word) id1;
	ubState.UBS_docGrp[5] = (word) id2;
	ubState.UBS_docGrp[6] = (word) id3;
	UBCHECK(id1 != FILE_NO_ID && id1 == id2 && d1 == d2 &&
		d1 != SP_DOCUMENT);
	UBCHECK(id3 == FILE_NO_ID && d3 == SP_DOCUMENT);
	/* nothing to ask when quitting: the control is told at once */
	@call UBDocGrp::MSG_META_QUIT();
	break;
    }
    case 92: {
	/* IACP: a server registers for a token, a client connects and
	 * sends it a message with a completion message, the server one
	 * back; the server of an open document; nobody to connect to */
	GeodeToken tok = { { 'U', 'B', 'I', 'T' }, 7 },
		   none = { { 'N', 'O', 'N', 'E' }, 7 },
		   low = { { 'U', 'B', 'I', 'L' }, 7 }, own;
	DiskHandle disk = SP_DOCUMENT;
	dword id = IACPGetDocumentID("", "FSTEST", &disk);
	EventHandle ev, done;
	word n = 0, v;

	GeodeGetInfo(GeodeGetProcessHandle(), GGIT_TOKEN_ID, &own);
	IACPRegisterServer(&tok, @UBIacpSrv, IACPSM_USER_INTERACTIBLE, 0);
	IACPRegisterServer(&own, @UBIacpSrv, IACPSM_NOT_USER_INTERACTIBLE,
			   0);
	ubIacpConn = IACPConnect(&tok, IACPCF_CLIENT_OD_SPECIFIED |
				 IACPSM_USER_INTERACTIBLE, 0, @UBIacpCli, &n);
	ubState.UBS_iacp[0] = ubIacpConn;
	ubState.UBS_iacp[1] = n;
	UBCHECK(ubIacpConn != IACP_NO_CONNECTION && n == 1);
	UBCHECK(IACPGetServerNumber(ubIacpConn, @UBIacpSrv) == 1);
	UBCHECK(!IACPGetServerNumber(ubIacpConn, @UBIacpCli));
	v = 42;
	CObjMessageP(MF_RECORD, (optr) (uintptr_t) &UBIacpClass,
		     MSG_UB_IACP_PING, &v, sizeof(v), &ev, sizeof(ev));
	done = @record UBIacpCli::MSG_UB_IACP_DONE();
	ubState.UBS_iacp[2] = IACPSendMessage(ubIacpConn, ev, TO_SELF, done,
					      IACPS_CLIENT);
	UBCHECK(ubState.UBS_iacp[2] == 1);
	v = 7;
	CObjMessageP(MF_RECORD, (optr) (uintptr_t) &UBIacpClass,
		     MSG_UB_IACP_PING, &v, sizeof(v), &ev, sizeof(ev));
	UBCHECK(IACPSendMessageToServer(ubIacpConn, ev, TO_SELF, 0, 1) == 1);
	v = 9;
	CObjMessageP(MF_RECORD, (optr) (uintptr_t) &UBIacpClass,
		     MSG_UB_IACP_PING, &v, sizeof(v), &ev, sizeof(ev));
	UBCHECK(IACPSendMessage(ubIacpConn, ev, TO_SELF, 0, IACPS_SERVER)
		== 1);
	/* the file is open at the server */
	UBCHECK(IACPConnectToDocumentServer("", "FSTEST", SP_DOCUMENT,
		    IACPCF_CLIENT_OD_SPECIFIED, @UBIacpCli) ==
		IACP_NO_CONNECTION);
	IACPRegisterDocument(@UBIacpSrv, disk, id);
	ubIacpDocConn = IACPConnectToDocumentServer("", "FSTEST", SP_DOCUMENT,
			    IACPCF_CLIENT_OD_SPECIFIED, @UBIacpCli);
	ubState.UBS_iacp[3] = ubIacpDocConn;
	UBCHECK(ubIacpDocConn != IACP_NO_CONNECTION &&
		ubIacpDocConn != ubIacpConn);
	UBCHECK(IACPGetServerNumber(ubIacpDocConn, @UBIacpSrv) == 1);
	n = 0;
	UBCHECK(IACPConnect(&none, IACPCF_CLIENT_OD_SPECIFIED, 0, @UBIacpCli,
			    &n) == IACP_NO_CONNECTION);
	ubState.UBS_iacp[4] = n;
	UBCHECK(n == IACPCE_NO_SERVER);
	UBCHECK(!IACPLocateServer(&none));
	/* a server in a lower mode than asked for: what the client
	 * sends waits until the server has finished the connection */
	IACPRegisterServer(&low, @UBIacpSrv, IACPSM_NOT_USER_INTERACTIBLE,
			   0);
	ubIacpHeldConn = IACPConnect(&low, IACPCF_CLIENT_OD_SPECIFIED |
				     IACPSM_USER_INTERACTIBLE, 0, @UBIacpCli,
				     &n);
	UBCHECK(ubIacpHeldConn != IACP_NO_CONNECTION && n == 1);
	v = 5;
	CObjMessageP(MF_RECORD, (optr) (uintptr_t) &UBIacpClass,
		     MSG_UB_IACP_PING, &v, sizeof(v), &ev, sizeof(ev));
	UBCHECK(IACPSendMessage(ubIacpHeldConn, ev, TO_SELF, 0, IACPS_CLIENT)
		== 1);
	break;
    }
    case 93:
	/* all of it has arrived; the client leaves its connections */
	UBCHECK(ubState.UBS_iacp[5] == 3);
	UBCHECK(ubState.UBS_iacp[6] == 2 && ubState.UBS_iacp[7] == 7);
	UBCHECK(ubState.UBS_iacp[8] == 9);
	UBCHECK(ubState.UBS_iacp[9] == 1);
	/* (the held message goes on before the client is lost) */
	IACPFinishConnect(ubIacpHeldConn, @UBIacpSrv);
	IACPShutdownAll(@UBIacpCli);
	break;
    case 94: {
	/* the server was told, and has left them too: they are gone,
	 * and with its last server the list */
	GeodeToken tok = { { 'U', 'B', 'I', 'T' }, 7 },
		   low = { { 'U', 'B', 'I', 'L' }, 7 }, own;
	DiskHandle disk = SP_DOCUMENT;
	dword id = IACPGetDocumentID("", "FSTEST", &disk);
	word n = 0;

	UBCHECK(ubState.UBS_iacp[10] == 3 && ubState.UBS_iacp[11] == 3);
	UBCHECK(ubState.UBS_iacp[6] == 3 && ubState.UBS_iacp[7] == 5);
	IACPUnregisterServer(&low, @UBIacpSrv);
	UBCHECK(!ubState.UBS_iacp[12]);
	GeodeGetInfo(GeodeGetProcessHandle(), GGIT_TOKEN_ID, &own);
	IACPUnregisterDocument(@UBIacpSrv, disk, id);
	UBCHECK(IACPConnectToDocumentServer("", "FSTEST", SP_DOCUMENT,
		    IACPCF_CLIENT_OD_SPECIFIED, @UBIacpCli) ==
		IACP_NO_CONNECTION);
	IACPUnregisterServer(&own, @UBIacpSrv);
	IACPUnregisterServer(&tok, @UBIacpSrv);
	UBCHECK(IACPConnect(&tok, IACPCF_CLIENT_OD_SPECIFIED, 0, @UBIacpCli,
			    &n) == IACP_NO_CONNECTION);
	ubState.UBS_iacp[13] = n;
	UBCHECK(n == IACPCE_NO_SERVER);
	break;
    }
    case 95: {
	/* a document (OLDocumentClass): the group makes an untitled
	 * one, a VM file in SP_DOCUMENT under the group's default name;
	 * closed clean it goes, with its file */
	DocumentCommonParams p;
	FileLongName name;
	optr doc, model = 0;
	FileHandle file;

	DocDelete("Untitled");
	DocDelete("UBDOC");
	memset(&p, 0, sizeof(p));
	p.DCP_docAttrs = GDA_UNTITLED;
	p.DCP_flags = DOF_FORCE_REAL_EMPTY_DOCUMENT;
	doc = @call UBDocGrp::MSG_GEN_DOCUMENT_GROUP_NEW_DOC(&p);
	UBCHECK(doc != 0);
	if (!doc)
	    break;
	UBCHECK(@call UBDocGrp::MSG_GEN_COUNT_CHILDREN() == 1);
	ubState.UBS_doc[0] = @call doc::MSG_GEN_DOCUMENT_GET_ATTRS();
	UBCHECK(ubState.UBS_doc[0] & GDA_UNTITLED);
	UBCHECK(!(ubState.UBS_doc[0] & (GDA_DIRTY | GDA_CLOSING)));
	file = @call doc::MSG_GEN_DOCUMENT_GET_FILE_HANDLE();
	UBCHECK(file != 0);
	memset(name, 0, sizeof(name));
	@call doc::MSG_GEN_DOCUMENT_GET_FILE_NAME(name);
	UBCHECK(StrIs(name, "Untitled"));
	ubState.UBS_doc[1] =
	    @call UBDocGrp::MSG_GEN_DOCUMENT_GROUP_GET_DOC_BY_FILE(file) ==
	    doc;
	UBCHECK(ubState.UBS_doc[1]);
	(void) @call UBDocGrp::MSG_META_GET_MODEL_EXCL(&model);
	ubState.UBS_doc[2] = model == doc;
	UBCHECK(model == doc);
	ubState.UBS_doc[3] = @call doc::MSG_GEN_DOCUMENT_CLOSE(0);
	UBCHECK(ubState.UBS_doc[3] == DQS_OK);
	break;
    }
    case 96: {
	/* the object and the file are gone.  One with a name: marked
	 * dirty, saved, closed: the file stays */
	DocumentCommonParams p;
	optr doc;

	ubState.UBS_doc[4] = @call UBDocGrp::MSG_GEN_COUNT_CHILDREN();
	UBCHECK(!ubState.UBS_doc[4]);
	ubState.UBS_doc[5] = DocExists("Untitled");
	UBCHECK(!ubState.UBS_doc[5]);
	memset(&p, 0, sizeof(p));
	p.DCP_diskHandle = SP_DOCUMENT;
	memcpy(p.DCP_name, "UBDOC", 6);
	doc = @call UBDocGrp::MSG_GEN_DOCUMENT_GROUP_NEW_DOC(&p);
	UBCHECK(doc != 0);
	if (!doc)
	    break;
	ubState.UBS_doc[6] = @call doc::MSG_GEN_DOCUMENT_GET_ATTRS();
	UBCHECK(!(ubState.UBS_doc[6] & (GDA_UNTITLED | GDA_DIRTY)));
	@call doc::MSG_GEN_DOCUMENT_MARK_DIRTY();
	ubState.UBS_doc[7] = @call doc::MSG_GEN_DOCUMENT_GET_ATTRS();
	UBCHECK(ubState.UBS_doc[7] & GDA_DIRTY);
	UBCHECK(!@call doc::MSG_GEN_DOCUMENT_SAVE());
	ubState.UBS_doc[8] = @call doc::MSG_GEN_DOCUMENT_GET_ATTRS();
	UBCHECK(!(ubState.UBS_doc[8] & GDA_DIRTY));
	ubState.UBS_doc[9] = @call doc::MSG_GEN_DOCUMENT_CLOSE(0);
	UBCHECK(ubState.UBS_doc[9] == DQS_OK);
	break;
    }
    case 97: {
	/* it is opened again; a second open finds it open */
	DocumentCommonParams p;
	FileLongName name;
	optr doc;

	UBCHECK(!@call UBDocGrp::MSG_GEN_COUNT_CHILDREN());
	ubState.UBS_doc[10] = DocExists("UBDOC");
	UBCHECK(ubState.UBS_doc[10]);
	memset(&p, 0, sizeof(p));
	p.DCP_diskHandle = SP_DOCUMENT;
	memcpy(p.DCP_name, "UBDOC", 6);
	doc = @call UBDocGrp::MSG_GEN_DOCUMENT_GROUP_OPEN_DOC(&p);
	UBCHECK(doc != 0);
	if (!doc)
	    break;
	ubState.UBS_doc[11] = @call doc::MSG_GEN_DOCUMENT_GET_ATTRS();
	UBCHECK(!(ubState.UBS_doc[11] & (GDA_UNTITLED | GDA_DIRTY)));
	memset(name, 0, sizeof(name));
	@call doc::MSG_GEN_DOCUMENT_GET_FILE_NAME(name);
	UBCHECK(StrIs(name, "UBDOC"));
	UBCHECK(@call doc::MSG_GEN_DOCUMENT_GET_FILE_HANDLE() != 0);
	memset(&p, 0, sizeof(p));
	p.DCP_diskHandle = SP_DOCUMENT;
	memcpy(p.DCP_name, "UBDOC", 6);
	UBCHECK(!@call UBDocGrp::MSG_GEN_DOCUMENT_GROUP_OPEN_DOC(&p));
	UBCHECK(@call UBDocGrp::MSG_GEN_COUNT_CHILDREN() == 1);
	ubState.UBS_doc[12] = @call doc::MSG_GEN_DOCUMENT_CLOSE(0);
	UBCHECK(ubState.UBS_doc[12] == DQS_OK);
	break;
    }
    case 98:
	ubState.UBS_doc[13] = @call UBDocGrp::MSG_GEN_COUNT_CHILDREN();
	UBCHECK(!ubState.UBS_doc[13]);
	UBCHECK(DocExists("UBDOC"));
	DocDelete("UBDOC");
	UBCHECK(!DocExists("UBDOC"));
    {
	/* save as: the document is the new file from now on, the old
	 * one stays; then changed and reverted */
	DocumentCommonParams p;
	DocFileOrError file = 0;
	FileLongName name;
	optr doc;

	DocDelete("UBDOC2");
	memset(&p, 0, sizeof(p));
	p.DCP_diskHandle = SP_DOCUMENT;
	memcpy(p.DCP_name, "UBDOC", 6);
	doc = @call UBDocGrp::MSG_GEN_DOCUMENT_GROUP_NEW_DOC(&p);
	UBCHECK(doc != 0);
	if (!doc)
	    break;
	@call doc::MSG_GEN_DOCUMENT_MARK_DIRTY();
	memset(&p, 0, sizeof(p));
	p.DCP_diskHandle = SP_DOCUMENT;
	memcpy(p.DCP_name, "UBDOC2", 7);
	ubState.UBS_docAs[0] = @call doc::MSG_GEN_DOCUMENT_SAVE_AS(&file, &p);
	UBCHECK(!ubState.UBS_docAs[0]);
	UBCHECK(file && file == @call doc::MSG_GEN_DOCUMENT_GET_FILE_HANDLE());
	memset(name, 0, sizeof(name));
	@call doc::MSG_GEN_DOCUMENT_GET_FILE_NAME(name);
	UBCHECK(StrIs(name, "UBDOC2"));
	ubState.UBS_docAs[1] = @call doc::MSG_GEN_DOCUMENT_GET_ATTRS();
	UBCHECK(!(ubState.UBS_docAs[1] &
		  (GDA_DIRTY | GDA_UNTITLED | GDA_CLOSING)));
	UBCHECK(@call doc::MSG_GEN_DOCUMENT_GET_OPERATION() == GDO_NORMAL);
	@call doc::MSG_GEN_DOCUMENT_MARK_DIRTY();
	ubState.UBS_docAs[2] = @call doc::MSG_GEN_DOCUMENT_GET_ATTRS();
	UBCHECK(ubState.UBS_docAs[2] & GDA_DIRTY);
	@call doc::MSG_GEN_DOCUMENT_REVERT_NO_PROMPT();
	break;
    }
    case 99: {
	optr doc = @call UBDocGrp::MSG_GEN_FIND_CHILD_AT_POSITION(0);

	UBCHECK(doc != 0);
	if (!doc)
	    break;
	ubState.UBS_docAs[3] = @call doc::MSG_GEN_DOCUMENT_GET_ATTRS();
	UBCHECK(!(ubState.UBS_docAs[3] & GDA_DIRTY));
	ubState.UBS_docAs[4] = @call doc::MSG_GEN_DOCUMENT_GET_OPERATION();
	UBCHECK(ubState.UBS_docAs[4] == GDO_NORMAL);
	ubState.UBS_docAs[5] = @call doc::MSG_GEN_DOCUMENT_CLOSE(0);
	UBCHECK(ubState.UBS_docAs[5] == DQS_OK);
	break;
    }
    case 100:
	UBCHECK(!@call UBDocGrp::MSG_GEN_COUNT_CHILDREN());
	ubState.UBS_docAs[6] = DocExists("UBDOC") + 2 * DocExists("UBDOC2");
	UBCHECK(ubState.UBS_docAs[6] == 3);
	DocDelete("UBDOC");
	DocDelete("UBDOC2");
	break;
    /* (101 to 113 are the reference mode's, below) */
    case 200: {
	/* a copy of the document elsewhere; then the document moves */
	DocumentCommonParams p;
	optr doc;

	DocDelete("UBDOC3");
	DocDelete("UBDOC4");
	memset(&p, 0, sizeof(p));
	p.DCP_diskHandle = SP_DOCUMENT;
	memcpy(p.DCP_name, "UBDOC", 6);
	doc = @call UBDocGrp::MSG_GEN_DOCUMENT_GROUP_NEW_DOC(&p);
	UBCHECK(doc != 0);
	if (!doc)
	    break;
	memset(&p, 0, sizeof(p));
	p.DCP_diskHandle = SP_DOCUMENT;
	memcpy(p.DCP_name, "UBDOC3", 7);
	ubState.UBS_docOb[0] = @call doc::MSG_GEN_DOCUMENT_COPY_TO(&p);
	UBCHECK(!ubState.UBS_docOb[0]);
	ubState.UBS_docOb[1] = DocExists("UBDOC3");
	UBCHECK(ubState.UBS_docOb[1]);
	memset(&p, 0, sizeof(p));
	p.DCP_diskHandle = SP_DOCUMENT;
	memcpy(p.DCP_name, "UBDOC4", 7);
	(void) @call doc::MSG_GEN_DOCUMENT_MOVE_TO(&p);
	break;
    }
    case 201: {
	/* moved and open again; its type becomes read only */
	optr doc = @call UBDocGrp::MSG_GEN_FIND_CHILD_AT_POSITION(0);
	FileLongName name;

	UBCHECK(doc != 0);
	if (!doc)
	    break;
	memset(name, 0, sizeof(name));
	@call doc::MSG_GEN_DOCUMENT_GET_FILE_NAME(name);
	ubState.UBS_docOb[2] = StrIs(name, "UBDOC4");
	UBCHECK(ubState.UBS_docOb[2]);
	UBCHECK(@call doc::MSG_GEN_DOCUMENT_GET_FILE_HANDLE() != 0);
	ubState.UBS_docOb[3] = DocExists("UBDOC") + 2 * DocExists("UBDOC3");
	UBCHECK(ubState.UBS_docOb[3] == 2);
	@call doc::MSG_GEN_DOCUMENT_CHANGE_TYPE(GDT_READ_ONLY);
	break;
    }
    case 202: {
	optr doc = @call UBDocGrp::MSG_GEN_FIND_CHILD_AT_POSITION(0);

	UBCHECK(doc != 0);
	if (!doc)
	    break;
	ubState.UBS_docOb[4] = @call doc::MSG_GEN_DOCUMENT_GET_ATTRS();
	UBCHECK(ubState.UBS_docOb[4] & GDA_READ_ONLY);
	UBCHECK(@call doc::MSG_GEN_DOCUMENT_GET_FILE_HANDLE() != 0);
	@call doc::MSG_GEN_DOCUMENT_CHANGE_TYPE(GDT_NORMAL);
	break;
    }
    case 203: {
	/* normal again; no password; closed */
	optr doc = @call UBDocGrp::MSG_GEN_FIND_CHILD_AT_POSITION(0);
	char none[2];

	UBCHECK(doc != 0);
	if (!doc)
	    break;
	ubState.UBS_docOb[5] = @call doc::MSG_GEN_DOCUMENT_GET_ATTRS();
	UBCHECK(!(ubState.UBS_docOb[5] & GDA_READ_ONLY));
	UBCHECK(@call doc::MSG_GEN_DOCUMENT_GET_FILE_HANDLE() != 0);
	none[0] = 0;
	@call doc::MSG_GEN_DOCUMENT_CHANGE_PASSWORD(none);
	ubState.UBS_docOb[6] = @call doc::MSG_GEN_DOCUMENT_CLOSE(0);
	UBCHECK(ubState.UBS_docOb[6] == DQS_OK);
	break;
    }
    case 204:
	ubState.UBS_docOb[7] = @call UBDocGrp::MSG_GEN_COUNT_CHILDREN();
	UBCHECK(!ubState.UBS_docOb[7]);
	UBCHECK(DocExists("UBDOC4"));
	DocDelete("UBDOC3");
	DocDelete("UBDOC4");
	break;
    case 205: {
	/* file change notification: made, written, renamed, attributes
	 * set; then a delete and a new directory in one batch */
	FileHandle fh;
	MemHandle mh = MemAllocLMem(LMEM_TYPE_GENERAL, 0);
	ChunkHandle ids;

	memset(ubState.UBS_fcn, 0, sizeof(ubState.UBS_fcn));
	FilePushDir();
	FileSetStandardPath(SP_DOCUMENT);
	(void) FileDelete("UBNOTE");
	(void) FileDelete("UBNOTE2");
	(void) FileDeleteDir("UBNDIR");
	ids = FileGetCurrentPathIDs(mh);
	UBCHECK(ids != 0);
	if (ids) {
	    FilePathID *pid;

	    MemLock(mh);
	    pid = LMemDerefHandles(mh, ids);
	    ubFcnDirID = pid->FPID_id;
	    MemUnlock(mh);
	}
	MemFree(mh);
	UBCHECK(GCNListAdd(@UBWatch, MANUFACTURER_ID_GEOWORKS,
			   GCNSLT_FILE_SYSTEM));
	fh = FileCreate("UBNOTE", FILE_CREATE_ONLY | FCF_NATIVE |
			FILE_ACCESS_RW | FILE_DENY_RW, 0);
	UBCHECK(fh != 0);
	if (fh) {
	    (void) FileWrite(fh, "note", 4, FALSE);
	    (void) FileClose(fh, FALSE);
	}
	UBCHECK(!FileGetPathExtAttributes("UBNOTE", FEA_FILE_ID, &ubFcnFileID,
					  sizeof(ubFcnFileID)));
	UBCHECK(!FileRename("UBNOTE", "UBNOTE2"));
	UBCHECK(!FileSetAttributes("UBNOTE2", FA_ARCHIVE));
	FileBatchChangeNotifications();
	UBCHECK(!FileDelete("UBNOTE2"));
	UBCHECK(!FileCreateDir("UBNDIR"));
	FileFlushChangeNotifications();
	FilePopDir();
	break;
    }
    case 206:
	/* create, contents, rename, attributes, the batch: delete,
	 * create */
	UBCHECK(ubState.UBS_fcn[0] == 5);
	UBCHECK(ubState.UBS_fcn[1] == FCNT_CREATE &&
		ubState.UBS_fcn[2] == FCNT_CONTENTS &&
		ubState.UBS_fcn[3] == FCNT_RENAME &&
		ubState.UBS_fcn[4] == FCNT_ATTRIBUTES &&
		ubState.UBS_fcn[5] == FCNT_BATCH);
	UBCHECK(ubState.UBS_fcn[9] && ubState.UBS_fcn[10] &&
		ubState.UBS_fcn[11]);
	UBCHECK(ubState.UBS_fcn[12] == 2 &&
		ubState.UBS_fcn[13] == FCNT_DELETE &&
		ubState.UBS_fcn[14] == FCNT_CREATE);
	UBCHECK(GCNListRemove(@UBWatch, MANUFACTURER_ID_GEOWORKS,
			      GCNSLT_FILE_SYSTEM));
	FilePushDir();
	FileSetStandardPath(SP_DOCUMENT);
	UBCHECK(!FileDeleteDir("UBNDIR"));
	FilePopDir();
	break;
    case 207: {
	/* a full disk on close: the close asks whether to save
	 * (answered yes), the save fails, the dialog of a full disk comes
	 * up and the close waits; the document listens for deletes */
	DocumentCommonParams p;
	optr doc;
	FileHandle fh;
	word id;
	MemHandle res;

	memset(ubState.UBS_low, 0, sizeof(ubState.UBS_low));
	DocDelete("UBLOW");
	DocDelete("UBJUNK");
	FilePushDir();
	FileSetStandardPath(SP_DOCUMENT);
	fh = FileCreate("UBJUNK", FILE_CREATE_ONLY | FCF_NATIVE |
			FILE_ACCESS_RW | FILE_DENY_RW, 0);
	if (fh)
	    (void) FileClose(fh, FALSE);
	FilePopDir();
	UBCHECK(fh != 0);
	memset(&p, 0, sizeof(p));
	p.DCP_diskHandle = SP_DOCUMENT;
	memcpy(p.DCP_name, "UBLOW", 6);
	doc = @call UBDocGrp::MSG_GEN_DOCUMENT_GROUP_NEW_DOC(&p);
	UBCHECK(doc != 0);
	if (!doc)
	    break;
	UBCHECK(InClass(doc, (ClassStruct *) &UBDocClass));
	@call doc::MSG_GEN_DOCUMENT_MARK_DIRTY();
	ubDiskFull = TRUE;
	ubAnswer = IC_YES;
	(void) TimerStart(TIMER_EVENT_ONE_SHOT, @UBApp, 20, MSG_UB_ANSWER, 0,
			  &id);
	ubState.UBS_low[0] = @call doc::MSG_GEN_DOCUMENT_CLOSE(0);
	UBCHECK(ubState.UBS_low[0] == DQS_DELAYED);
	res = ((OLDocumentInstance *) ObjDerefVis(doc))->OLDI_saveErrorRes;
	ubState.UBS_low[1] = res != 0;
	lowDiskRes = res;
	UBCHECK(res != 0);
	ubState.UBS_low[2] = ObjVarFindData(doc,
		TEMP_OL_DOCUMENT_NO_DISK_SPACE_MESSAGE) != NULL;
	UBCHECK(ubState.UBS_low[2]);
	if (res)
	    UBCHECK(ObjBlockGetOutput(res) == doc);
	ubState.UBS_low[3] = @call doc::MSG_GEN_DOCUMENT_GET_ATTRS();
	UBCHECK(ubState.UBS_low[3] & GDA_SAVE_FAILED);
	break;
    }
    case 208: {
	/* room made: the notification of the delete has it saved, and
	 * the close goes on (it asks again: the save kept the document
	 * dirty, as on DOS16; answered yes) */
	word id;

	{
	    /* the dialog is system modal: the system's focus is the UI's
	     * application, whose focus is the dialog, whose focus is its
	     * first trigger (the default ring) */
	    optr uiApp = GeodeGetAppObject((GeodeHandle)
					   SysGetInfo(SGIT_UI_PROCESS));
	    optr f = 0, af = 0, sf = 0, *sfp = &sf;

	    TimerSleep(10);
	    (void) @call uiApp::MSG_META_GET_FOCUS_EXCL(&af);
	    (void) UserCallSystem(MSG_META_GET_FOCUS_EXCL, &sfp, sizeof(sfp),
				  NULL, 0);
	    UBCHECK(sf == uiApp);
	    UBCHECK(af && OptrToHandle(af) == lowDiskRes);
	    if (af)
		(void) @call af::MSG_META_GET_FOCUS_EXCL(&f);
	    UBCHECK(f != 0);
	    ubState.UBS_low[7] = (sf == uiApp) | ((af != 0) << 1) |
		((f != 0) << 2);
	}
	ubDiskFull = FALSE;
	ubAnswer = IC_YES;
	(void) TimerStart(TIMER_EVENT_ONE_SHOT, @UBApp, 20, MSG_UB_ANSWER, 0,
			  &id);
	FilePushDir();
	FileSetStandardPath(SP_DOCUMENT);
	UBCHECK(!FileDelete("UBJUNK"));
	FilePopDir();
	break;
    }
    case 209: {
	/* saved and closed, the dialog gone (the test waits for the
	 * group to be empty first: the application's thread gets there
	 * after the answer's timer, and calls the process on the way) */
	ubState.UBS_low[4] = @call UBDocGrp::MSG_GEN_COUNT_CHILDREN();
	UBCHECK(!ubState.UBS_low[4]);
	ubState.UBS_low[5] = DocExists("UBLOW");
	UBCHECK(ubState.UBS_low[5]);
	DocDelete("UBLOW");
	break;
    }
    case 300: {
	/* the standard sounds: a count for each one played, none for a
	 * custom one; "[ui] sound = false" silences them but those with
	 * SST_IGNORE_SOUND_OFF; "[ui] soundMask" each */
	optr uiProc = ConstructOptr((GeodeHandle)
				    SysGetInfo(SGIT_UI_PROCESS), 0);

	ubState.UBS_snd[0] = UserStandardSound(SST_ERROR);
	UBCHECK(ubState.UBS_snd[0] != 0);
	/* not this one: it goes on */
	UserStopStandardSound(SST_ERROR, ubState.UBS_snd[0] + 1);
	UBCHECK(UserStandardSound(SST_CUSTOM_NOTE, 880, 2) == 0);
	InitFileWriteBoolean("ui", "sound", FALSE);
	@call uiProc::MSG_USER_UPDATE_SOUND_PARAMS();
	ubState.UBS_snd[1] = UserStandardSound(SST_WARNING);
	UBCHECK(ubState.UBS_snd[1] == 0);
	ubState.UBS_snd[2] = UserStandardSound(SST_IGNORE_SOUND_OFF +
					      SST_NOTIFY);
	UBCHECK(ubState.UBS_snd[2] != 0);
	InitFileWriteBoolean("ui", "sound", TRUE);
	InitFileWriteInteger("ui", "soundMask",
			     SOUND_MASK_ALL & ~SSF_ALARM);
	@call uiProc::MSG_USER_UPDATE_SOUND_PARAMS();
	UBCHECK(UserStandardSound(SST_ALARM) == 0);
	ubState.UBS_snd[3] = UserStandardSound(SST_NO_HELP);
	UBCHECK(ubState.UBS_snd[3] != 0);
	InitFileDeleteEntry("ui", "soundMask");
	@call uiProc::MSG_USER_UPDATE_SOUND_PARAMS();
	break;
    }
    case 301:
	/* a press nobody takes in a content beeps (the no input beep's
	 * 800 Hz), a release not (once the sounds of step 300 are over:
	 * they hold all the test driver's voices) */
	@call UBContent::MSG_VIS_CONTENT_UNWANTED_MOUSE_EVENT(NULL,
							       BI_PRESS);
	@call UBContent::MSG_VIS_CONTENT_UNWANTED_MOUSE_EVENT(NULL, 0);
	break;
    case 302: {
	/* a visual object's classed event TO_SYS_FOCUS goes to the
	 * system object and down its focus to this application
	 * (VisSendClassedEvent) */
	EventHandle ev = @record UBAppClass::MSG_UB_SYS_PING();
	@call UBContent::MSG_META_SEND_CLASSED_EVENT(ev,
						    (TravelOption) TO_SYS_FOCUS);
	break;
    }
    case 303:
    case 304: {
	/* a click in a geode's window brings it to the top with the
	 * focus (DefaultBehaviorOnMousePress): the application lowered
	 * to the bottom first has lost it, the test clicks into the
	 * primary */
	optr sf = 0, *sfp = &sf, af = 0;
	Rectangle r;

	(void) UserCallSystem(MSG_META_GET_FOCUS_EXCL, &sfp, sizeof(sfp),
			      NULL, 0);
	if (step == 303 && sf) {
	    /* the application lets go of the field's focus and target */
	    @call sf::MSG_META_MUP_ALTER_FTVMC_EXCL(@UBApp,
						   MAEF_FOCUS | MAEF_TARGET);
	    r = ScreenBounds(@call UBPrimary::MSG_VIS_QUERY_WINDOW());
	    ubState.UBS_stub[2] = (r.R_left + r.R_right) / 2;
	    ubState.UBS_stub[3] = (r.R_top + r.R_bottom) / 2;
	}
	/* the system's focus is the field, the field's the application */
	(void) UserCallSystem(MSG_META_GET_FOCUS_EXCL, &sfp, sizeof(sfp),
			      NULL, 0);
	if (sf)
	    (void) @call sf::MSG_META_GET_TARGET_EXCL(&af);
	ubState.UBS_stub[5 + (step - 303)] = OptrToHandle(af);
	if (step == 303)
	    ubState.UBS_stub[1] = af != @UBApp;
	else
	    ubState.UBS_stub[4] = af == @UBApp;
	break;
    }
    case 305: {
	/* the next window (MSG_OL_APP_NAVIGATE_TO_NEXT_WINDOW): with the
	 * tool box up the application goes from it to the primary and
	 * back */
	word k;

	@call UBToolBox::MSG_GEN_INTERACTION_INITIATE();
	for (k = 0; k < 3; k++) {
	    optr af = 0;

	    if (k)
		@call UBApp::MSG_OL_APP_NAVIGATE_TO_NEXT_WINDOW();
	    TimerSleep(5);
	    (void) @call UBApp::MSG_META_GET_FOCUS_EXCL(&af);
	    ubState.UBS_stub[8 + k] = af == @UBPrimary ? 1
				     : af == @UBToolBox ? 2 : 0;
	}
	(void) @call UBToolBox::MSG_GEN_GUP_INTERACTION_COMMAND(IC_DISMISS);
	break;
    }
    case 306:
	/* a menu in stay up mode (opened by a click on its button) */
	@call UBPrimary::MSG_GEN_DISPLAY_SET_MAXIMIZED();
	{
	    word k;
	    for (k = 0; k < 4 && !ubState.UBS_stub[11]; k++) {
		UBClickMenu(k);
		TimerSleep(5);
		if (@call UBTools::MSG_VIS_GET_ATTRS() & VA_REALIZED)
		    ubState.UBS_stub[11] = 1 + k;
	    }
	}
	ubState.UBS_stub[12] = @call UBPrimary::MSG_GEN_DISPLAY_GET_MAXIMIZED();
	break;
    case 307:
	/* Alt+F5, the system menu's Restore (activated through the
	 * queue: looked at in the next step) */
	(void) @call UBPrimary::MSG_META_FUP_KBD_CHAR(
			VC_F5 | (CS_CONTROL << 8),
			CF_FIRST_PRESS | (SS_LALT << 8), 0);
	break;
    case 308:
	/* the primary restored, the menu in stay up mode dismissed;
	 * Alt+F10, Maximize */
	ubState.UBS_stub[13] =
	    (!@call UBPrimary::MSG_GEN_DISPLAY_GET_MAXIMIZED()) |
	    ((!(@call UBTools::MSG_VIS_GET_ATTRS() & VA_REALIZED)) << 1);
	(void) @call UBPrimary::MSG_META_FUP_KBD_CHAR(
			VC_F10 | (CS_CONTROL << 8),
			CF_FIRST_PRESS | (SS_LALT << 8), 0);
	break;
    case 309:
	ubState.UBS_stub[14] = @call UBPrimary::MSG_GEN_DISPLAY_GET_MAXIMIZED();
	break;
    case 310: {
	/* MSG_GEN_INTERACTION_ACTIVATE_COMMAND: the dialog's trigger for
	 * the command sends its action (it ends the dialog with Yes) */
	optr d = UserCreateDialog(@UBAsk);

	if (!d)
	    break;
	ubState.UBS_stub[15] = 0;
	@send, forceQueue d::MSG_GEN_INTERACTION_ACTIVATE_COMMAND(IC_YES);
	ubState.UBS_stub[7] = UserDoDialog(d);
	UserDestroyDialog(d);
	break;
    }
    case 311: {
	/* a slider takes its GenValue's HINT_VALUE_DELAYED_DRAG_
	 * NOTIFICATION (OpenAddScrollbar): no update during drags */
	optr par = @call UBSlide::MSG_GEN_FIND_PARENT(), v;
	OLValueInstance vi;
	OLSliderInstance sl;
	GenValueInstance *g;

	ubState.UBS_stub[6] = 0;
	v = ObjInstantiate(OptrToHandle(@UBSlide),
			   (ClassStruct *) &GenValueClass);
	ObjLockObjBlock(OptrToHandle(v));
	g = (GenValueInstance *) ObjDerefGen(v);
	g->GVLI_maximum = 0x640000;
	(void) ObjVarAddData(v, HINT_VALUE_ANALOG_DISPLAY, 0);
	(void) ObjVarAddData(v, HINT_VALUE_DELAYED_DRAG_NOTIFICATION, 0);
	MemUnlock(OptrToHandle(v));
	@call par::MSG_GEN_ADD_CHILD(v, CCO_LAST);
	@call v::MSG_GEN_SET_USABLE(VUM_NOW);
	if (InClass(v, (ClassStruct *) &OLValueClass)) {
	    VisData(v, &vi, sizeof(vi));
	    if (vi.OLSGI_scrollbar) {
		ubState.UBS_stub[6] = 1;
		VisData(ConstructOptr(OptrToHandle(v), vi.OLSGI_scrollbar),
			&sl, sizeof(sl));
		if (!(sl.OLSBI_attrs & OLSA_UPDATE_DURING_DRAGS))
		    ubState.UBS_stub[6] |= 2;
	    }
	}
	@call v::MSG_GEN_SET_NOT_USABLE(VUM_NOW);
	@call par::MSG_GEN_REMOVE_CHILD(v, 0);
	@call v::MSG_META_OBJ_FREE();
	break;
    }
    case 312:
	/* chosen as a task (the express menu): the primaries come back
	 * from minimized (looked at in the next step) */
	@call UBPrimary::MSG_GEN_DISPLAY_SET_MINIMIZED(VUM_NOW);
	ubState.UBS_stub[5] =
	    @call UBPrimary::MSG_GEN_DISPLAY_GET_MINIMIZED() ? 1 : 0;
	@call UBApp::MSG_META_NOTIFY_TASK_SELECTED();
	break;
    case 313:
	if (!@call UBPrimary::MSG_GEN_DISPLAY_GET_MINIMIZED())
	    ubState.UBS_stub[5] |= 2;
	break;
    case 314: {
	/* the display of a document: the document control's file change
	 * gives it the document and its name (the moniker on the UI
	 * queue, looked at in the next step); as the target it grabs
	 * the model for the document */
	DocumentFileChangedParams fc;
	optr m = 0;

	@call UBDoc1::MSG_GEN_BRING_TO_TOP();
	ubState.UBS_stub[16] = 0;
	ubFakeDoc = ObjInstantiate(OptrToHandle(@UBDoc1),
				   (ClassStruct *) &UBFakeDocClass);
	memset(&fc, 0, sizeof(fc));
	memcpy(fc.DFCP_name, "Report", sizeof("Report"));
	fc.DFCP_display = @UBDoc1;
	fc.DFCP_document = ubFakeDoc;
	CObjMessageP(MF_CALL, @UBDoc1, MSG_GEN_DISPLAY_UPDATE_FROM_DOCUMENT,
		     &fc, sizeof(fc), NULL, 0);
	if (@call UBDoc1::MSG_GEN_DISPLAY_GET_DOCUMENT() == ubFakeDoc)
	    ubState.UBS_stub[16] |= 1;
	/* (the display's own grab: up to the application, the model node) */
	(void) @call UBApp::MSG_META_GET_MODEL_EXCL(&m);
	if (m == ubFakeDoc)
	    ubState.UBS_stub[16] |= 2;
	break;
    }
    case 315: {
	/* the name as the moniker; closing the display closes the
	 * document; the display as it was */
	GenInstance *g;
	ChunkHandle mk;

	ObjLockObjBlock(OptrToHandle(@UBDoc1));
	g = (GenInstance *) ObjDerefGen(@UBDoc1);
	mk = g->GI_visMoniker;
	if (mk && !LocalCmpStrings((char *) LMemDerefHandles(
					OptrToHandle(@UBDoc1), mk) + VMWT_text,
				   "Report", 0))
	    ubState.UBS_stub[16] |= 4;
	MemUnlock(OptrToHandle(@UBDoc1));
	@call UBDoc1::MSG_GEN_DISPLAY_CLOSE();
	@call UBApp::MSG_META_MUP_ALTER_FTVMC_EXCL(ubFakeDoc, MAEF_MODEL);
	ObjLockObjBlock(OptrToHandle(@UBDoc1));
	((GenDisplayInstance *) ObjDerefGen(@UBDoc1))->GDI_document = 0;
	MemUnlock(OptrToHandle(@UBDoc1));
	(void) @call UBDoc1::MSG_GEN_REPLACE_VIS_MONIKER_TEXT("Doc 1",
							      VUM_NOW);
	@call ubFakeDoc::MSG_META_OBJ_FREE();
	break;
    }
    case 210:
	/* (the documents left, while the test waits for step 209) */
	ubState.UBS_low[6] = @call UBDocGrp::MSG_GEN_COUNT_CHILDREN();
	break;
    /* the reference mode (UIBOOT_REF, Port32/tools/uiref-gen.py): the
     * variants of the reference application */
    case 101:
    case 104:
    case 110:
	@call UBDoc1::MSG_GEN_BRING_TO_TOP();
	@call UBDoc1::MSG_GEN_DISPLAY_SET_MAXIMIZED();
	if (step == 110) {
	    (void) @call UBFSel::MSG_GEN_PATH_SET("FSTEST", SP_DOCUMENT);
	    @call UBFiles::MSG_GEN_INTERACTION_INITIATE();
	}
	if (step == 104)
	    @call UBApp::MSG_GEN_APPLICATION_DO_STANDARD_DIALOG(
		MSG_UB_STD_RESPONSE, ConstructOptr(GeodeGetProcessHandle(), 0),
		NULL, NULL, NULL, "42", "Error \001 happened.",
		(CDT_ERROR << CDBF_DIALOG_TYPE_OFFSET) |
		(GIT_NOTIFICATION << CDBF_INTERACTION_TYPE_OFFSET));
	break;
    case 102:
	@call UBDoc2::MSG_GEN_BRING_TO_TOP();
	@call UBDoc2::MSG_GEN_DISPLAY_SET_MAXIMIZED();
	break;
    case 103:
	break;
    case 105:
    case 109: {
	/* the popup list opened: space on its button, the one child of
	 * the list's row that is no generic object */
	optr p, c;
	word i;

	@call UBDoc2::MSG_GEN_BRING_TO_TOP();
	@call UBDoc2::MSG_GEN_DISPLAY_SET_MAXIMIZED();
	@call UBDoc2::MSG_GEN_UPDATE_VISUAL(VUM_NOW);
	p = @call UBChecks::MSG_VIS_FIND_PARENT();
	for (i = 0; p && (c = @call p::MSG_VIS_FIND_CHILD_AT_POSITION(i)) != 0;
	     i++)
	    if (!@call c::MSG_META_IS_OBJECT_IN_CLASS(&GenClass)) {
		if (step == 109)
		    @call c::MSG_META_KBD_CHAR((VC_ISCTRL << 8) | VC_DOWN,
					       CF_FIRST_PRESS, 0);
		else
		    @call c::MSG_META_KBD_CHAR(VC_BLANK, CF_FIRST_PRESS, 0);
		break;
	    }
	break;
    }
    case 106:
    case 107:
    case 108:
	/* the File, Tools, Long menu opened by a click on its button */
	@call UBDoc1::MSG_GEN_BRING_TO_TOP();
	@call UBDoc1::MSG_GEN_DISPLAY_SET_MAXIMIZED();
	@call UBPrimary::MSG_GEN_UPDATE_VISUAL(VUM_NOW);
	UBClickMenu(step - 106);
	break;
    case 112:
    case 113: {
	/* a dirty document of the group closed (queued): the dialog of a
	 * full disk (its save fails; failed before, so the close does not
	 * ask) or "save changes?" */
	DocumentCommonParams p;
	optr doc;

	@call UBDoc1::MSG_GEN_BRING_TO_TOP();
	@call UBDoc1::MSG_GEN_DISPLAY_SET_MAXIMIZED();
	DocDelete("URDOC");
	memset(&p, 0, sizeof(p));
	p.DCP_diskHandle = SP_DOCUMENT;
	memcpy(p.DCP_name, "URDOC", 6);
	doc = @call UBDocGrp::MSG_GEN_DOCUMENT_GROUP_NEW_DOC(&p);
	if (doc) {
	    ubDiskFull = TRUE;
	    @call doc::MSG_GEN_DOCUMENT_MARK_DIRTY();
	    if (step == 112)
		((GenDocumentInstance *) ObjDerefGen(doc))->GDI_attrs |=
		    GDA_SAVE_FAILED;
	    @send, forceQueue doc::MSG_GEN_DOCUMENT_CLOSE(0);
	}
	break;
    }
    case 111:
	/* the File menu with a document control in it */
	@call UBDoc1::MSG_GEN_BRING_TO_TOP();
	@call UBDoc1::MSG_GEN_DISPLAY_SET_MAXIMIZED();
	@call UBFile::MSG_GEN_ADD_CHILD(@UBDocCtl, CCO_FIRST);
	@call UBDocCtl::MSG_GEN_SET_USABLE(VUM_NOW);
	@call UBPrimary::MSG_GEN_UPDATE_VISUAL(VUM_NOW);
	UBClickMenu(0);
	break;
    }
}

/* a step on the process thread, from the test (MF_CALL) */
void UBStep(word step)
{
    @call ConstructOptr(ubState.UBS_process, 0)::MSG_UB_STEP(step);
}
