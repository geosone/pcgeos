@include <Internal/SpecUI/olContentClass.goh>
@include <Internal/SpecUI/olGlyphDisplayClass.goh>
@include <Objects/gGlyphC.goh>
#include <string.h>
#include <initfile.h>

typedef struct {
    GeodeHandle		UBS_process;
    word		UBS_attached;
    word		UBS_opened;
    word		UBS_checks, UBS_fails, UBS_failLine;
    word		UBS_failLines[8];
    WindowHandle	UBS_primaryWin;
    WindowHandle	UBS_groupWin;
    word		UBS_displayNotices;	/* GWNT_DISPLAY_CHANGE */
    word		UBS_listNotices;	/* GWNT_DISPLAY_LIST_CHANGE */
    word		UBS_lastNum;		/* the last display's */
    char		UBS_lastName[16];
    byte		UBS_lastOverlapping;
    sword		UBS_gw, UBS_gh;		/* the group's size */
    sword		UBS_dl, UBS_dt, UBS_dw, UBS_dh;	/* UBDoc1's */
    /* the primary's system menu button (left, top, width, height) and
     * the left and right of its title bar */
    sword		UBS_sys[6];
    optr		UBS_maxIcon, UBS_restoreIcon;
    optr		UBS_pin;
    sword		UBS_pinned[4];
    sword		UBS_long[4];
    word		UBS_itemApplies, UBS_itemApply[3];
    word		UBS_boolApplies, UBS_boolApply[3];
    word		UBS_radioApplies, UBS_radioSel;
    word		UBS_checkApplies, UBS_checkSel;
    word		UBS_sizeApplies, UBS_sizeSel;
    sword		UBS_sizeButton[2];
    word		UBS_scrollApplies, UBS_scrollAction;
    dword		UBS_scrollValue;
    sword		UBS_scrollBar[3];
    word		UBS_scrollDrag;
    /* the view's page (width, height) and window size */
    sword		UBS_view[4];
    /* the scrolling list's item length, items shown, view window size
     * and the top item after paging down */
    sword		UBS_slist[5];
    /* the dynamic list: monikers asked for, items made, the top item
     * and the first item's number after scrolling to item 12 */
    word		UBS_dlist[4];
    short		UBS_glyph[5];
} UBState;

UBState ubState;

#define UBCHECK(c) \
    do { ubState.UBS_checks++; if (!(c)) { \
	if (ubState.UBS_fails < 8) \
	    ubState.UBS_failLines[ubState.UBS_fails] = __LINE__; \
	ubState.UBS_fails++; \
	if (!ubState.UBS_failLine) ubState.UBS_failLine = __LINE__; } \
    } while (0)

@class UBProcessClass, GenProcessClass;
    @message void MSG_UB_STEP(word step);
    @message (GEN_ITEM_GROUP_APPLY_MSG) MSG_UB_ITEMS_APPLIED;
    @message (GEN_ITEM_GROUP_APPLY_MSG) MSG_UB_RADIO_APPLIED;
    @message (GEN_ITEM_GROUP_APPLY_MSG) MSG_UB_SIZE_APPLIED;
    @message (GEN_BOOLEAN_GROUP_APPLY_MSG) MSG_UB_CHECKS_APPLIED;
    @message (GEN_BOOLEAN_GROUP_APPLY_MSG) MSG_UB_BOOLEANS_APPLIED;
    /* a scrollbar's apply message plus the part pressed less one */
    @message (GEN_VALUE_APPLY_MSG) MSG_UB_SCROLL_TOP;
    @message (GEN_VALUE_APPLY_MSG) MSG_UB_SCROLL_PAGE_UP;
    @message (GEN_VALUE_APPLY_MSG) MSG_UB_SCROLL_UP;
    @message (GEN_VALUE_APPLY_MSG) MSG_UB_SCROLL_DRAG;
    @message (GEN_VALUE_APPLY_MSG) MSG_UB_SCROLL_DOWN;
    @message (GEN_VALUE_APPLY_MSG) MSG_UB_SCROLL_PAGE_DOWN;
    @message (GEN_VALUE_APPLY_MSG) MSG_UB_SCROLL_BOTTOM;
    @message (GEN_DYNAMIC_LIST_QUERY_MSG) MSG_UB_QUERY_ITEM;
@endc
@classdecl UBProcessClass, neverSaved;

