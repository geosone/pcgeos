/*
 * uimotif.goc -- a process geode for the library.ui.motif test
 * (Port32/Tests): the UI's system object made in this geode's block
 * with the Motif specific UI (motif.geo), a screen on the default video
 * driver and a field on it, as the UI makes them (userScreen.goc).  The
 * test (test_ui_motif.c) runs the steps through UMStep on the process
 * thread; the checks made here count in umState, the windows are there
 * for the test to look at.  The objects run on that thread too, so a
 * message queued to them (MF_FORCE_QUEUE) is handled only after the
 * step returns: what follows from it is checked in the next step.
 */
@include <stdapp.goh>
@include <Objects/vCompC.goh>
@include <Objects/gSysC.goh>
@include <Objects/gFieldC.goh>
@include <Objects/gScrnC.goh>
@include <Internal/specC.goh>
@include <Internal/SpecUI/olSystemClass.goh>
@include <Internal/SpecUI/olScreenClass.goh>
@include <Internal/SpecUI/olFieldClass.goh>
@include <Internal/SpecUI/olApplicationClass.goh>
@include <Internal/SpecUI/olWinIconClass.goh>
@include <Objects/gInterC.goh>
@include <Internal/SpecUI/olWinClass.goh>
@include <Internal/SpecUI/olGadgetAreaClass.goh>
@include <Internal/SpecUI/olBaseWinClass.goh>
@include <Internal/SpecUI/olPopupWinClass.goh>
@include <Internal/SpecUI/olButtonClass.goh>
@include <Internal/SpecUI/olMenuWinClass.goh>
@include <Internal/SpecUI/olMenuButtonClass.goh>
@include <Internal/SpecUI/olMenuBarClass.goh>
#include <Internal/specUI.h>
#include <Internal/videoDr.h>
#include <initfile.h>
#include <string.h>

typedef struct {
    GeodeHandle		UMS_process;
    word		UMS_attached;
    word		UMS_checks, UMS_fails, UMS_failLine;
    word		UMS_failLines[8];
    WindowHandle	UMS_screenWin;
    WindowHandle	UMS_fieldWin;
    word		UMS_timerExpired;
    word		UMS_triggered;		/* actions of the triggers */
    optr		UMS_trigger;		/* the last one's trigger */
    word		UMS_trigData;		/* ATTR_GEN_TRIGGER_ACTION_DATA */
    sword		UMS_markX, UMS_markY;	/* a sub menu's mark (screen) */
    sword		UMS_iconX, UMS_iconY;	/* a window icon (screen) */
} UMState;

UMState umState;

#define UMCHECK(c) \
    do { umState.UMS_checks++; if (!(c)) { \
	if (umState.UMS_fails < 8) \
	    umState.UMS_failLines[umState.UMS_fails] = __LINE__; \
	umState.UMS_fails++; \
	if (!umState.UMS_failLine) umState.UMS_failLine = __LINE__; } \
    } while (0)

@class UMProcessClass, ProcessClass;
    @message void MSG_UM_STEP(word step);
    @message (GEN_TRIGGER_ACTION) MSG_UM_TRIGGERED;
    @message void MSG_UM_TRIGGER_DATA(word data);
@endc
@classdecl UMProcessClass, neverSaved;

/* generic groups built as OLCtrls whatever their parent (the steps
 * look at them before they are in a tree: OLBuildInteraction would make
 * a group no parent answers for a dialog window) */
@class UMGroupClass, GenInteractionClass;
@endc
@classdecl UMGroupClass;

@method UMGroupClass, MSG_META_RESOLVE_VARIANT_SUPERCLASS
{
    (void) MasterOffset;
    return (ClassStruct *) &OLCtrlClass;
}

/* a command window: OLWin with a command window's type and attributes
 * (the subclasses of OLWinClass are not ported yet) */
@class UMCmdWinClass, OLWinClass;
@endc
@classdecl UMCmdWinClass, neverSaved;

@method UMCmdWinClass, MSG_META_INITIALIZE
{
    OLWinInstance *w;

    @callsuper();
    w = (OLWinInstance *) ObjDerefVis(oself);
    w->OLWI_type = MOWT_COMMAND_WINDOW;
    w->OLWI_attrs = MO_ATTRS_COMMAND_WINDOW;
    /* the window classes scan their geometry hints here (cwinDialog) */
    @call oself::MSG_SPEC_SCAN_GEOMETRY_HINTS();
}

@class UMWinClass, GenInteractionClass;
@endc
@classdecl UMWinClass;

@method UMWinClass, MSG_META_RESOLVE_VARIANT_SUPERCLASS
{
    (void) MasterOffset;
    return (ClassStruct *) &UMCmdWinClass;
}

