static optr umSystem, umScreen, umField, umApp;

/* the specific UI's SGQT_BUILD_INFO, OLBF_MENUABLE, OLBR_TOP_MENU
 * (CommonUI/cGeode.goh) */
#define UM_SGQT_BUILD_INFO	2000
#define UM_OLBF_MENUABLE	0x8000
#define UM_OLBR_TOP_MENU	1

/* the application's gadget timer, started for the process */
@method UMProcessClass, MSG_TIMER_EXPIRED
{
    (void) tick;
    (void) timerID;
    umState.UMS_timerExpired++;
}

@method UMProcessClass, MSG_UM_TRIGGERED
{
    umState.UMS_triggered++;
    umState.UMS_trigger = trigger;
}

@method UMProcessClass, MSG_UM_TRIGGER_DATA
{
    umState.UMS_triggered++;
    umState.UMS_trigData = data;
}

@method UMProcessClass, MSG_META_ATTACH_PROCESS
{
    (void) value1;
    (void) value2;
    umState.UMS_process = GeodeGetProcessHandle();
    umState.UMS_attached++;
}

/* the object's Vis instance, copied (its block is ours) */
static void VisData(optr o, void *buf, word size)
{
    ObjLockObjBlock(OptrToHandle(o));
    memcpy(buf, ObjDerefVis(o), size);
    MemUnlock(OptrToHandle(o));
}

/* the text of a generic object's moniker is that given */
/* a key pressed, as the window gets it (flags: the ShiftState << 8) */
#define UM_K(c)	((CS_CONTROL << 8) | (c))
static Boolean UMPress(optr o, word c, word f)
{
    return @call o::MSG_META_FUP_KBD_CHAR(c, CF_FIRST_PRESS | f, 0);
}

static Boolean MonikerIs(optr o, const char *text)
{
    ChunkHandle ch = @call o::MSG_GEN_GET_VIS_MONIKER();
    MemHandle mh = OptrToHandle(o);
    const char *t;
    word i;
    Boolean ok = FALSE;

    if (!ch)
	return FALSE;
    ObjLockObjBlock(mh);
    t = (const char *) LMemDeref(ConstructOptr(mh, ch)) + VMWT_text;
    for (i = 0; text[i] && t[i] == text[i]; i++)
	;
    ok = !text[i] && !t[i];
    MemUnlock(mh);
    return ok;
}

static Boolean InClass(optr o, ClassStruct *c)
{
    Boolean r;

    ObjLockObjBlock(OptrToHandle(o));
    r = ObjIsObjectInClass(o, c);
    MemUnlock(OptrToHandle(o));
    return r;
}

/* a stagger slot of the field: its slot, its position */
static word Slot(byte req, sword *x, sword *y)
{
    GenReturnParams r;

    UMCHECK(@call umField::MSG_VIS_P32_VUP_QUERY(&r,
		    SPEC_VIS_QUERY_START + 0, req, 0));
    *x = (sword) r.GRP_cx;
    *y = (sword) r.GRP_dx;
    return (word) r.GRP_bp;
}

@method UMProcessClass, MSG_UM_STEP
{
    switch (step) {
    case 1: {
	/* the system object, built by Motif */
	umSystem = UserCreateSystemObject(OptrToHandle(@UMApp));
	UMCHECK(umSystem != 0);
	(void) @call umSystem::MSG_VIS_GET_ATTRS();
	UMCHECK(InClass(umSystem, (ClassStruct *) &OLSystemClass));
	break;
    }
    case 2: {
	/* the screen: usable, built and opened: the root window on the
	 * driver, of its size */
	OLScreenInstance s;
	VideoDriverInfo *info;
	WindowHandle parent = 1;

	umScreen = ObjInstantiate(OptrToHandle(@UMApp),
				  (ClassStruct *) &GenScreenClass);
	@call umScreen::MSG_GEN_SCREEN_SET_VIDEO_DRIVER(0);
	@call umSystem::MSG_GEN_SYSTEM_ADD_SCREEN_CHILD(umScreen, CCO_LAST);
	@call umSystem::MSG_GEN_SYSTEM_SET_DEFAULT_SCREEN(umScreen);
	@call umScreen::MSG_GEN_SET_USABLE(VUM_NOW);
	UMCHECK(InClass(umScreen, (ClassStruct *) &OLScreenClass));
	VisData(umScreen, &s, sizeof(s));
	info = (VideoDriverInfo *) GeodeInfoDriver(
				GeodeGetDefaultDriver(GDDT_VIDEO));
	UMCHECK(s.VI_bounds.R_right == info->VDI_pageW &&
		s.VI_bounds.R_bottom == info->VDI_pageH);
	UMCHECK(s.VCI_geoAttrs & VCGA_CUSTOM_MANAGE_CHILDREN);
	umState.UMS_screenWin = s.VCI_window;
	if (s.VCI_window)
	    WinGetInfo(s.VCI_window, WIT_PARENT_WIN, &parent);
	UMCHECK(s.VCI_window != 0 && parent == 0);
	break;
    }
    case 3: {
	/* the field: attached on the screen, usable, on top */
	OLFieldInstance f;
	optr o = 0;
	WindowHandle parent = 0;
	GenReturnParams r;

	/* the windows of this geode take the focus and target (the
	 * application object would say so) */
	WinGeodeSetFlags(umState.UMS_process, WinGeodeGetFlags(
			     umState.UMS_process) | GWF_FOCUSABLE |
			 GWF_TARGETABLE);
	umField = ObjInstantiate(OptrToHandle(@UMApp),
				 (ClassStruct *) &GenFieldClass);
	@call umField::MSG_META_ATTACH();
	@call umField::MSG_GEN_FIELD_SET_VIS_PARENT(umScreen);
	@call umField::MSG_GEN_SET_USABLE(VUM_NOW);
	@call umField::MSG_GEN_BRING_TO_TOP();
	UMCHECK(InClass(umField, (ClassStruct *) &OLFieldClass));
	VisData(umField, &f, sizeof(f));
	UMCHECK(@call umField::MSG_VIS_FIND_PARENT() == umScreen);
	{
	    OLScreenInstance s;

	    VisData(umScreen, &s, sizeof(s));
	    UMCHECK(f.VI_bounds.R_right == s.VI_bounds.R_right &&
		    f.VI_bounds.R_bottom == s.VI_bounds.R_bottom);
	}
	UMCHECK(f.VI_attrs & VA_REALIZED);
	umState.UMS_fieldWin = f.VCI_window;
	if (f.VCI_window)
	    WinGetInfo(f.VCI_window, WIT_PARENT_WIN, &parent);
	UMCHECK(f.VCI_window != 0 && parent == umState.UMS_screenWin);
	/* the field in the system's hierarchies, the default field */
	(void) @call umSystem::MSG_META_GET_TARGET_EXCL(&o);
	UMCHECK(o == umField);
	o = 0;
	(void) @call umSystem::MSG_META_GET_FOCUS_EXCL(&o);
	UMCHECK(o == umField);
	UMCHECK(@call umSystem::MSG_GEN_SYSTEM_GET_DEFAULT_FIELD() ==
		umField);
	/* the queries: the field's screen, the video driver, the display
	 * scheme */
	memset(&r, 0, sizeof(r));
	UMCHECK(@call umField::MSG_SPEC_P32_GUP_QUERY(&r, GUQT_SCREEN) &&
		ConstructOptr(r.GRP_cx, r.GRP_dx) == umScreen &&
		r.GRP_bp == umState.UMS_screenWin);
	UMCHECK(@call umField::MSG_SPEC_P32_GUP_QUERY(&r, GUQT_FIELD) &&
		ConstructOptr(r.GRP_cx, r.GRP_dx) == umField &&
		r.GRP_bp == umState.UMS_fieldWin);
	UMCHECK(@call umField::MSG_VIS_P32_VUP_QUERY(&r, VUQ_VIDEO_DRIVER,
						     0, 0) &&
		r.GRP_ax == GeodeGetDefaultDriver(GDDT_VIDEO));
	UMCHECK(@call umField::MSG_VIS_P32_VUP_QUERY(&r, VUQ_DISPLAY_SCHEME,
						     0, 0) &&
		((r.GRP_ax >> 16) & 0xff) == C_LIGHT_GREY &&
		((r.GRP_ax >> 24) & 0xff) == C_DARK_GREY);
	UMCHECK(@call umField::MSG_SPEC_GUP_QUERY_VIS_PARENT(
		    SQT_VIS_PARENT_FOR_APPLICATION) == umField);
	UMCHECK(@call umSystem::MSG_SPEC_GUP_QUERY_VIS_PARENT(
		    SQT_VIS_PARENT_FOR_FIELD) == umScreen);
	break;
    }
    case 4: {
	/* the stagger slots of the field's windows */
	sword x, y;
	GenReturnParams r;

	UMCHECK(Slot(0, &x, &y) == 1 && x == 10 && y == 8);
	UMCHECK(Slot(0, &x, &y) == 2 && x == 10 + 31 && y == 8 + 20);
	UMCHECK(Slot(0x80 | 1, &x, &y) == 3);
	UMCHECK(@call umField::MSG_VIS_P32_VUP_QUERY(&r,
		    SPEC_VIS_QUERY_START + 2, 1, 0));
	UMCHECK(Slot(0, &x, &y) == 1);
	/* a slot asked for without reassigning is taken as it is */
	UMCHECK(Slot(5, &x, &y) == 5 && x == 10 + 4 * 31);
	break;
    }
    case 5:
	/* a new background color */
	InitFileWriteInteger("ui", "backgroundcolor", C_GREEN);
	@call umField::MSG_GEN_FIELD_RESET_BG();
	break;
    case 6: {
	/* the field lowered: it lets go of the system's hierarchies, which
	 * the system gives back to the only field there is (closing the
	 * last field would shut the system down, as in the asm) */
	OLFieldInstance f;
	optr o = 0;

	@call umField::MSG_GEN_LOWER_TO_BOTTOM();
	(void) @call umSystem::MSG_META_GET_TARGET_EXCL(&o);
	UMCHECK(o == umField);
	o = 0;
	(void) @call umSystem::MSG_META_GET_FOCUS_EXCL(&o);
	UMCHECK(o == umField);
	VisData(umField, &f, sizeof(f));
	UMCHECK((f.VI_attrs & VA_REALIZED) && f.VCI_window);
	break;
    }
    case 7: {
	/* an application on the field (not the geode's application
	 * object: the specific UI asked that for its size while the field
	 * came up): an OLApplication, the geode's input object, the
	 * field's and the screen's windows; built: on the field (an
	 * upward link), its window and size */
	OLApplicationInstance a;
	OLFieldInstance f;
	GenReturnParams r;
	WholeMeasurementType w;
	DisplayScheme ds;

	umApp = ObjInstantiate(OptrToHandle(@UMApp),
			       (ClassStruct *) &GenApplicationClass);
	/* its generic part built before the field links it (as a message
	 * to it would) */
	ObjInitializePart(umApp, word_offsetof(GenBase, Gen_offset));
	/* focusable and modelable (the @default of a declared one) */
	@call umApp::MSG_GEN_APPLICATION_SET_STATE(AS_FOCUSABLE |
						   AS_MODELABLE, 0);
	@call umField::MSG_GEN_ADD_CHILD_UPWARD_LINK_ONLY(umApp);
	UMCHECK(@call umField::MSG_GEN_FIELD_APP_STARTUP_NOTIFY() == 0);
	@call umField::MSG_GEN_FIELD_ADD_GEN_APPLICATION(umApp, CCO_LAST);
	/* its specific part grown (MSG_META_ATTACH would do it with an
	 * AppLaunchBlock) */
	ObjInitializePart(umApp, word_offsetof(VisBase, Vis_offset));
	UMCHECK(InClass(umApp, (ClassStruct *) &OLApplicationClass));
	UMCHECK(WinGeodeGetInputObj(umState.UMS_process) == umApp);
	UMCHECK((WinGeodeGetFlags(umState.UMS_process) &
		 (GWF_FOCUSABLE | GWF_TARGETABLE | GWF_MODELABLE)) ==
		(GWF_FOCUSABLE | GWF_TARGETABLE | GWF_MODELABLE));
	VisData(umApp, &a, sizeof(a));
	UMCHECK(a.OLAI_fieldWin == umState.UMS_fieldWin &&
		a.OLAI_screenWin == umState.UMS_screenWin);
	UMCHECK(a.OLAI_units == AMT_DEFAULT &&
		(a.VCNI_focusExcl.FTVMC_flags & HGF_APP_EXCL) &&
		(a.OLAI_modelExcl.FTVMC_flags & HGF_APP_EXCL));

	@call umApp::MSG_SPEC_BUILD(0);
	VisData(umApp, &a, sizeof(a));
	VisData(umField, &f, sizeof(f));
	UMCHECK(@call umApp::MSG_VIS_FIND_PARENT() == umField);
	UMCHECK(a.VCNI_window == umState.UMS_fieldWin);
	UMCHECK(a.VI_bounds.R_right == f.VI_bounds.R_right &&
		a.VI_bounds.R_bottom == f.VI_bounds.R_bottom);
	UMCHECK(WinGeodeGetParentObj(umState.UMS_process) == umField);
	/* the queries: the vis parents, the display scheme (the field's),
	 * the build info, the units */
	UMCHECK(@call umApp::MSG_SPEC_GUP_QUERY_VIS_PARENT(
		    SQT_VIS_PARENT_FOR_PRIMARY) == umApp);
	UMCHECK(@call umApp::MSG_SPEC_GUP_QUERY_VIS_PARENT(
		    SQT_VIS_PARENT_FOR_SYS_MODAL) == umApp);
	UMCHECK(@call umApp::MSG_SPEC_GUP_QUERY_VIS_PARENT(
		    SQT_VIS_PARENT_FOR_APPLICATION) == umField);
	memset(&r, 0, sizeof(r));
	UMCHECK(@call umApp::MSG_VIS_P32_VUP_QUERY(&r, VUQ_DISPLAY_SCHEME,
						   0, 0) &&
		((r.GRP_ax >> 16) & 0xff) == C_LIGHT_GREY);
	memset(&r, 0, sizeof(r));
	r.GRP_bp = UM_OLBF_MENUABLE;
	UMCHECK(@call umApp::MSG_SPEC_P32_GUP_QUERY(&r, UM_SGQT_BUILD_INFO) &&
		r.GRP_bp == (UM_OLBF_MENUABLE | UM_OLBR_TOP_MENU) &&
		!r.GRP_cx && !r.GRP_dx);
	w = @call umApp::MSG_GEN_APPLICATION_GET_MEASUREMENT_TYPE();
	UMCHECK(w.WMT_appMeasurementType == AMT_DEFAULT);
	memset(&ds, 0, sizeof(ds));
	@call umApp::MSG_GEN_APPLICATION_GET_DISPLAY_SCHEME(&ds);
	UMCHECK(ds.DS_lightColor == C_LIGHT_GREY &&
		ds.DS_darkColor == C_DARK_GREY);
	break;
    }
    case 8: {
	/* on top: the field's focus and target, the focus application
	 * (the system's focus within it); busy and ignoring input; the
	 * gadget timer for the process */
	OLApplicationInstance a;
	optr o = 0;

	@call umApp::MSG_GEN_BRING_TO_TOP();
	(void) @call umField::MSG_META_GET_FOCUS_EXCL(&o);
	UMCHECK(o == umApp);
	o = 0;
	(void) @call umField::MSG_META_GET_TARGET_EXCL(&o);
	UMCHECK(o == umApp);
	VisData(umApp, &a, sizeof(a));
	UMCHECK(a.OLAI_flowFlags & AFF_FOCUS_APP);
	UMCHECK(a.VCNI_focusExcl.FTVMC_flags & HGF_SYS_EXCL);

	@call umApp::MSG_GEN_APPLICATION_MARK_BUSY();
	@call umApp::MSG_GEN_APPLICATION_HOLD_UP_INPUT();
	VisData(umApp, &a, sizeof(a));
	UMCHECK(a.OLAI_busyCount == 1 && a.OLAI_holdUpInputCount == 1 &&
		(a.OLAI_flowFlags & AFF_FLOW_HOLDING_INPUT_FOR_APP));
	@call umApp::MSG_GEN_APPLICATION_RESUME_INPUT();
	@call umApp::MSG_GEN_APPLICATION_MARK_NOT_BUSY();
	VisData(umApp, &a, sizeof(a));
	UMCHECK(!a.OLAI_busyCount && !a.OLAI_holdUpInputCount &&
		!(a.OLAI_flowFlags & AFF_FLOW_HOLDING_INPUT_FOR_APP));
	@call umApp::MSG_GEN_APPLICATION_IGNORE_INPUT();
	VisData(umApp, &a, sizeof(a));
	UMCHECK(a.OLAI_ignoreInputCount == 1 &&
		!(a.VCNI_focusExcl.FTVMC_flags & HGF_SYS_EXCL));
	@call umApp::MSG_GEN_APPLICATION_ACCEPT_INPUT();
	VisData(umApp, &a, sizeof(a));
	UMCHECK(!a.OLAI_ignoreInputCount &&
		(a.VCNI_focusExcl.FTVMC_flags & HGF_SYS_EXCL));

	@call umApp::MSG_OL_APP_START_TIMER(
		ConstructOptr(umState.UMS_process, 0), 1);
	break;
    }
    case 9: {
	/* no longer targetable: the target leaves the application */
	optr o = 0;

	@call umApp::MSG_GEN_SET_ATTRS(0, GA_TARGETABLE);
	UMCHECK(!(WinGeodeGetFlags(umState.UMS_process) & GWF_TARGETABLE));
	(void) @call umField::MSG_META_GET_TARGET_EXCL(&o);
	UMCHECK(o != umApp);
	o = 0;
	(void) @call umField::MSG_META_GET_FOCUS_EXCL(&o);
	UMCHECK(o == umApp);
	break;
    }
    case 10: {
	/* OLCtrl: the hints of a framed group with a moniker above, its
	 * margins, spacing and sizes; a horizontal toolbox */
	OLCtrlInstance c;
	Rectangle m;
	SpacingAsDWord sp;
	SizeAsDWord sz, mk;
	OLCtrlOptFlags of = 0;
	OLBuildFlags bf = 0;
	GenReturnParams r;
	GStateHandle gs;

	(void) @call UMGroup::MSG_VIS_COMP_GET_CHILD_SPACING();
	UMCHECK(InClass(@UMGroup, (ClassStruct *) &OLCtrlClass));
	@call UMGroup::MSG_SPEC_SCAN_GEOMETRY_HINTS();
	VisData(@UMGroup, &c, sizeof(c));
	UMCHECK(c.VI_typeFlags & VTF_IS_GEN);
	UMCHECK((c.OLCI_optFlags & (OLCOF_DISPLAY_BORDER |
				    OLCOF_DISPLAY_MKR_ABOVE |
				    OLCOF_DISPLAY_MONIKER |
				    OLCOF_CUSTOM_SPACING)) ==
		(OLCOF_DISPLAY_BORDER | OLCOF_DISPLAY_MKR_ABOVE |
		 OLCOF_DISPLAY_MONIKER | OLCOF_CUSTOM_SPACING));
	UMCHECK(!(c.OLCI_moreFlags & OLCOF_LEFT_JUSTIFY_MONIKER));
	UMCHECK((c.VCI_geoAttrs & (VCGA_ORIENT_CHILDREN_VERTICALLY |
				   VCGA_ONLY_DRAWS_IN_MARGINS |
				   VCGA_HAS_MINIMUM_SIZE)) ==
		(VCGA_ORIENT_CHILDREN_VERTICALLY | VCGA_ONLY_DRAWS_IN_MARGINS |
		 VCGA_HAS_MINIMUM_SIZE));
	UMCHECK((c.VCI_geoDimensionAttrs & VCGDA_WIDTH_JUSTIFICATION) ==
		WJ_CENTER_CHILDREN_HORIZONTALLY);
	UMCHECK(c.VI_geoAttrs & VGA_USE_VIS_CENTER);
	sp = @call UMGroup::MSG_VIS_COMP_GET_CHILD_SPACING();
	UMCHECK(DWORD_CHILD_SPACING(sp) == 3 && DWORD_WRAP_SPACING(sp) == 2);
	/* the moniker above, in the frame */
	@call UMGroup::MSG_VIS_COMP_GET_MARGINS(&m);
	UMCHECK(m.R_left == 7 && m.R_right == 7 && m.R_bottom == 7);
	/* (at least the frame's: the test has no fonts, so no moniker
	 * height) */
	UMCHECK(m.R_top >= 7);
	UMCHECK(@call UMGroup::MSG_SPEC_GET_TYPICAL_CHILD_EXTRA_SIZE() ==
		0x0812);
	sz = @call UMGroup::MSG_SPEC_CONVERT_DESIRED_SIZE_HINT(
						SST_PIXELS | 100, 0, 0);
	UMCHECK(DWORD_WIDTH(sz) == 114 && DWORD_HEIGHT(sz) == 0);
	mk = VisGetMonikerSize(@UMGroup,
			       @call UMGroup::MSG_GEN_GET_VIS_MONIKER(), 0, 0);
	UMCHECK(DWORD_WIDTH(mk) > 0);
	sz = @call UMGroup::MSG_VIS_COMP_GET_MINIMUM_SIZE();
	UMCHECK(DWORD_WIDTH(sz) == DWORD_WIDTH(mk) + 28 &&
		DWORD_HEIGHT(sz) == (word) (m.R_top + m.R_bottom));
	memset(&r, 0, sizeof(r));
	UMCHECK(@call UMGroup::MSG_SPEC_P32_GUP_QUERY(&r, UM_SGQT_BUILD_INFO) &&
		ConstructOptr(r.GRP_cx, r.GRP_dx) == @UMGroup);
	/* oversized children: no spacing with default rings */
	@call UMGroup::MSG_SPEC_CTRL_SET_MORE_FLAGS(OLCOF_OVERSIZED_CHILDREN,
						    0);
	sp = @call UMGroup::MSG_VIS_COMP_GET_CHILD_SPACING();
	UMCHECK(DWORD_CHILD_SPACING(sp) == 3 && !DWORD_WRAP_SPACING(sp));
	@call UMGroup::MSG_SPEC_CTRL_SET_MORE_FLAGS(0,
						    OLCOF_OVERSIZED_CHILDREN);
	gs = GrCreateState(0);
	@call UMGroup::MSG_VIS_DRAW(0, gs);
	GrDestroyState(gs);

	/* the toolbox: centering on monikers orients it vertically after
	 * all, the toolbox spacing, delayed */
	@call UMGroup2::MSG_SPEC_SCAN_GEOMETRY_HINTS();
	VisData(@UMGroup2, &c, sizeof(c));
	UMCHECK(c.VCI_geoAttrs & VCGA_ORIENT_CHILDREN_VERTICALLY);
	UMCHECK(@call UMGroup2::MSG_VUP_GET_BUILD_FLAGS(&bf) &&
		(bf & (OLBF_TOOLBOX | OLBF_DELAYED_MODE)) ==
		(OLBF_TOOLBOX | OLBF_DELAYED_MODE));
	sp = @call UMGroup2::MSG_VIS_COMP_GET_CHILD_SPACING();
	UMCHECK(DWORD_CHILD_SPACING(sp) >= 2 &&
		DWORD_CHILD_SPACING(sp) <= 3 && DWORD_WRAP_SPACING(sp) == 1);
	memset(&r, 0, sizeof(r));
	UMCHECK(@call UMGroup2::MSG_SPEC_P32_GUP_QUERY(&r,
						GUQT_DELAYED_OPERATION) &&
		r.GRP_ax == OLBF_DELAYED_MODE);
	UMCHECK(@call UMGroup2::MSG_QUERY_CENTER_BY_MONIKERS(&of) &&
		of == (OLCOF_CENTER_ON_MONIKER | OLCOF_LEFT_JUSTIFY_MONIKERS));
	of = 0;
	UMCHECK(@call UMGroup::MSG_QUERY_CENTER_BY_MONIKERS(&of) && !of);
	break;
    }
    case 11: {
	/* OLWin: a command window under the application: its defaults;
	 * usable, attached and realizable (the application too): built on
	 * the application, staggered in a slot of the field, as large as
	 * it wants, its window opened on the field's */
	OLWinInstance w;
	OLFieldInstance f;
	OLApplicationInstance a;
	Rectangle m;
	SizeAsDWord sz;
	optr o = 0;
	WindowHandle parent = 0;
	byte slot;
	sword x, y;

	@call umApp::MSG_GEN_ADD_CHILD(@UMWin, CCO_LAST);
	(void) @call UMWin::MSG_VIS_GET_ATTRS();
	UMCHECK(InClass(@UMWin, (ClassStruct *) &OLWinClass));
	VisData(@UMWin, &w, sizeof(w));
	UMCHECK((w.VI_typeFlags & (VTF_IS_WIN_GROUP | VTF_IS_WINDOW)) ==
		(VTF_IS_WIN_GROUP | VTF_IS_WINDOW));
	UMCHECK(w.OLWI_type == MOWT_COMMAND_WINDOW &&
		(w.OLWI_fixedAttr & OWFA_PRESERVE_FOCUS) &&
		(w.OLWI_defaultExcl.HG_flags & HGF_APP_EXCL));
	UMCHECK((w.OLWI_winPosSizeFlags & WPSF_POSITION_TYPE) ==
		(WPT_STAGGER << 3) &&
		(w.OLWI_winPosSizeFlags & WPSF_SIZE_TYPE) == WST_AS_DESIRED);
	UMCHECK(w.OLWI_winPosSizeState &
		(WPSS_POSITION_INVALID | WPSS_SIZE_INVALID));

	ObjLockObjBlock(OptrToHandle(umApp));
	((GenInstance *) ObjDerefGen(umApp))->GI_states |= GS_USABLE;
	MemUnlock(OptrToHandle(umApp));
	@call umApp::MSG_SPEC_SET_ATTRS(SA_REALIZABLE | SA_ATTACHED, 0,
					VUM_NOW);
	VisData(umApp, &a, sizeof(a));
	UMCHECK((a.VI_attrs & VA_REALIZED) &&
		a.VCI_window == umState.UMS_fieldWin);
	@call UMWin::MSG_GEN_SET_USABLE(VUM_NOW);
	@call UMWin::MSG_SPEC_SET_ATTRS(SA_REALIZABLE | SA_ATTACHED, 0,
					VUM_NOW);
	VisData(@UMWin, &w, sizeof(w));
	UMCHECK(@call UMWin::MSG_VIS_FIND_PARENT() == umApp);
	UMCHECK(!(w.OLWI_winPosSizeState &
		  (WPSS_POSITION_INVALID | WPSS_SIZE_INVALID)));
	slot = (byte) (w.OLWI_winPosSizeState >> 8) & 0x3f;
	UMCHECK(slot != 0);
	/* the field's position for the slot (asked for as it is) */
	UMCHECK(Slot(slot, &x, &y) == slot);
	UMCHECK(w.VI_bounds.R_left == x && w.VI_bounds.R_top == y);
	UMCHECK((w.VI_attrs & VA_REALIZED) && w.VCI_window);
	if (w.VCI_window)
	    WinGetInfo(w.VCI_window, WIT_PARENT_WIN, &parent);
	UMCHECK(parent == umState.UMS_fieldWin);
	/* at least its minimum size, a title bar in the header inside the
	 * resize border; inside the field */
	sz = @call UMWin::MSG_VIS_COMP_GET_MINIMUM_SIZE();
	UMCHECK(DWORD_WIDTH(sz) >= 7 && DWORD_HEIGHT(sz) >= 7);
	UMCHECK(w.VI_bounds.R_right - w.VI_bounds.R_left >=
		(sword) DWORD_WIDTH(sz));
	UMCHECK(w.OLWI_titleBarBounds.R_top == 5 &&
		w.OLWI_titleBarBounds.R_bottom > w.OLWI_titleBarBounds.R_top);
	VisData(umField, &f, sizeof(f));
	UMCHECK(w.VI_bounds.R_right <= f.VI_bounds.R_right &&
		w.VI_bounds.R_bottom <= f.VI_bounds.R_bottom);
	/* the margins: a titled, resizable window in color */
	@call UMWin::MSG_VIS_COMP_GET_MARGINS(&m);
	UMCHECK(m.R_left == 6 && m.R_right == 6 && m.R_bottom == 6 &&
		m.R_top > m.R_bottom);

	/* on top: the application's focus */
	@call UMWin::MSG_GEN_BRING_TO_TOP();
	(void) @call umApp::MSG_META_GET_FOCUS_EXCL(&o);
	UMCHECK(o == @UMWin);
	VisData(@UMWin, &w, sizeof(w));
	UMCHECK(w.OLWI_focusExcl.FTVMC_flags & HGF_APP_EXCL);

	/* closed: the focus gone, the slot back */
	@call UMWin::MSG_SPEC_SET_ATTRS(0, SA_REALIZABLE, VUM_NOW);
	VisData(@UMWin, &w, sizeof(w));
	UMCHECK(!(w.VI_attrs & VA_REALIZED) && !w.VCI_window);
	UMCHECK(!((w.OLWI_winPosSizeState >> 8) & 0x3f));
	o = 0;
	(void) @call umApp::MSG_META_GET_FOCUS_EXCL(&o);
	UMCHECK(o != @UMWin);
	break;
    }
    case 12: {
	/* OLBaseWin: a GenPrimary under the application (built by
	 * OLBuildPrimary): a primary window, staggered and extended near
	 * the field's bottom right; usable: its gadget area holds the
	 * group, a title bar group the toolbox; maximized and restored,
	 * minimized and restored, not usable */
	OLBaseWinInstance b;
	OLCtrlInstance c;
	OLFieldInstance f;
	optr ga, tg;
	sword w0, h0;
	WindowHandle parent = 0;
	OLWinAttr resizable;

	@call umApp::MSG_GEN_ADD_CHILD(@UMPrimary, CCO_LAST);
	(void) @call UMPrimary::MSG_VIS_GET_ATTRS();
	UMCHECK(InClass(@UMPrimary, (ClassStruct *) &OLBaseWinClass));
	VisData(@UMPrimary, &b, sizeof(b));
	UMCHECK(b.OLWI_type == MOWT_PRIMARY_WINDOW && b.OLCI_visParent == umApp);
	/* (resizable only with a mouse: the test has none, the UI is
	 * keyboard only) */
	resizable = (FlowGetUIButtonFlags() & UIBF_KEYBOARD_ONLY) ? 0
							      : OWA_RESIZABLE;
	UMCHECK((b.OLWI_attrs & (OWA_HEADER | OWA_TITLED | OWA_MOVABLE |
				 OWA_RESIZABLE | OWA_MAXIMIZABLE |
				 OWA_CLOSABLE)) ==
		(OWA_HEADER | OWA_TITLED | OWA_MOVABLE | resizable |
		 OWA_MAXIMIZABLE | OWA_CLOSABLE));
	UMCHECK(b.OLWI_winPosSizeFlags == (WPSF_PERSIST |
					   (WCT_KEEP_PARTIALLY_VISIBLE << 6) |
					   (WPT_STAGGER << 3) |
					   WST_EXTEND_NEAR_BOTTOM_RIGHT));
	UMCHECK((b.OLMDWI_iconWinPosSizeState >> 8) == 0x40);	/* SSPR_ICON */
	UMCHECK(b.VI_specAttrs & SA_REALIZABLE);

	/* usable and attached: built, its window on the field's */
	@call UMPrimary::MSG_GEN_SET_USABLE(VUM_NOW);
	@call UMPrimary::MSG_SPEC_SET_ATTRS(SA_REALIZABLE | SA_ATTACHED, 0,
					    VUM_NOW);
	VisData(@UMPrimary, &b, sizeof(b));
	UMCHECK((b.VI_attrs & VA_REALIZED) && b.VCI_window);
	if (b.VCI_window)
	    WinGetInfo(b.VCI_window, WIT_PARENT_WIN, &parent);
	UMCHECK(parent == umState.UMS_fieldWin);
	UMCHECK(@call UMPrimary::MSG_VIS_FIND_PARENT() == umApp);
	/* the gadget area: the window's children vertical, the group in
	 * it; the toolbox in the right title bar group */
	UMCHECK(b.OLMDWI_gadgetArea != 0);
	ga = ConstructOptr(OptrToHandle(@UMPrimary), b.OLMDWI_gadgetArea);
	UMCHECK(InClass(ga, (ClassStruct *) &OLGadgetAreaClass));
	UMCHECK(@call ga::MSG_VIS_FIND_PARENT() == @UMPrimary);
	UMCHECK(b.VCI_geoAttrs & VCGA_ORIENT_CHILDREN_VERTICALLY);
	UMCHECK(@call UMPrimGroup::MSG_VIS_FIND_PARENT() == ga);
	tg = b.OLWI_titleBarRightGroup;
	UMCHECK(tg != 0 && !b.OLWI_titleBarLeftGroup);
	if (tg) {
	    UMCHECK(InClass(tg, (ClassStruct *) &OLTitleGroupClass));
	    UMCHECK(@call UMPrimTool::MSG_VIS_FIND_PARENT() == tg);
	    UMCHECK(@call tg::MSG_VIS_FIND_PARENT() == @UMPrimary);
	    VisData(tg, &c, sizeof(c));
	    UMCHECK(((c.OLCI_buildFlags & OLBF_TARGET) >> OLBF_TARGET_OFFSET)
		    == OLBT_FOR_TITLE_BAR_RIGHT &&
		    (c.OLCI_buildFlags & OLBF_TOOLBOX));
	}
	/* staggered, extended near the field's bottom right (Motif keeps
	 * no margin at the right: the window ends one past the field, as
	 * a maximized one) */
	VisData(umField, &f, sizeof(f));
	w0 = b.VI_bounds.R_right - b.VI_bounds.R_left;
	h0 = b.VI_bounds.R_bottom - b.VI_bounds.R_top;
	UMCHECK(b.VI_bounds.R_right == f.VI_bounds.R_right + 1 &&
		b.VI_bounds.R_bottom < f.VI_bounds.R_bottom &&
		w0 > (f.VI_bounds.R_right - f.VI_bounds.R_left) / 2);
	UMCHECK(((b.OLWI_winPosSizeState >> 8) & 0x3f) != 0);

	/* maximized: the whole field, not movable or resizable */
	@call UMPrimary::MSG_GEN_DISPLAY_SET_MAXIMIZED();
	UMCHECK(@call UMPrimary::MSG_GEN_DISPLAY_GET_MAXIMIZED());
	VisData(@UMPrimary, &b, sizeof(b));
	UMCHECK(b.OLWI_specState & OLWSS_MAXIMIZED);
	UMCHECK(!(b.OLWI_attrs & (OWA_MOVABLE | OWA_RESIZABLE)));
	UMCHECK(b.VI_bounds.R_left == -1 && b.VI_bounds.R_top == -1 &&
		b.VI_bounds.R_right == f.VI_bounds.R_right + 1 &&
		b.VI_bounds.R_bottom == f.VI_bounds.R_bottom + 1);
	/* restored: as before */
	@call UMPrimary::MSG_GEN_DISPLAY_SET_NOT_MAXIMIZED();
	VisData(@UMPrimary, &b, sizeof(b));
	UMCHECK(!(b.OLWI_specState & OLWSS_MAXIMIZED) &&
		(b.OLWI_attrs & (OWA_MOVABLE | OWA_RESIZABLE)) ==
		(OWA_MOVABLE | resizable));
	UMCHECK(b.VI_bounds.R_right - b.VI_bounds.R_left == w0 &&
		b.VI_bounds.R_bottom - b.VI_bounds.R_top == h0);

	/* minimized: closed; restored: open again */
	@call UMPrimary::MSG_GEN_DISPLAY_SET_MINIMIZED();
	UMCHECK(@call UMPrimary::MSG_GEN_DISPLAY_GET_MINIMIZED());
	VisData(@UMPrimary, &b, sizeof(b));
	UMCHECK((b.OLWI_specState & OLWSS_MINIMIZED) &&
		(b.VI_specAttrs & SA_BRANCH_MINIMIZED) &&
		!(b.VI_attrs & VA_REALIZED));
	@call UMPrimary::MSG_GEN_DISPLAY_SET_NOT_MINIMIZED();
	VisData(@UMPrimary, &b, sizeof(b));
	UMCHECK(!(b.OLWI_specState & OLWSS_MINIMIZED) &&
		!(b.VI_specAttrs & SA_BRANCH_MINIMIZED) &&
		(b.VI_attrs & VA_REALIZED) && b.VCI_window);

	/* not usable: closed, its slot back */
	@call UMPrimary::MSG_GEN_SET_NOT_USABLE(VUM_NOW);
	VisData(@UMPrimary, &b, sizeof(b));
	UMCHECK(!(b.VI_attrs & VA_REALIZED));
	UMCHECK(!((b.OLWI_winPosSizeState >> 8) & 0x3f));
	break;
    }
    case 13: {
	/* OLDialogWin: a command dialog under the application (built by
	 * OLBuildInteraction): a popup built twice, centered; usable it
	 * stays closed until initiated; its children in the gadget area,
	 * the left title bar group and its reply bar (kept last);
	 * dismissed, initiated again, complete (it stays); a modal
	 * notification (a notice) with a reply bar it made, single usage:
	 * complete closes it; not usable */
	OLDialogWinInstance d;
	OLReplyBarInstance rb;
	OLFieldInstance f;
	WindowHandle parent = 0;
	optr ga, tg, rbo;
	sword cx, fcx;

	/* the application on top again (minimized in step 12, it was
	 * lowered, queued: the user brings it back) */
	@call umApp::MSG_GEN_BRING_TO_TOP();

	@call umApp::MSG_GEN_ADD_CHILD(@UMDialog, CCO_LAST);
	(void) @call UMDialog::MSG_VIS_GET_ATTRS();
	UMCHECK(InClass(@UMDialog, (ClassStruct *) &OLDialogWinClass));
	VisData(@UMDialog, &d, sizeof(d));
	UMCHECK(d.OLWI_type == MOWT_COMMAND_WINDOW);
	UMCHECK((d.OLWI_attrs & (OWA_CLOSABLE | OWA_TITLED | OWA_MOVABLE)) ==
		(OWA_CLOSABLE | OWA_TITLED | OWA_MOVABLE));
	UMCHECK((d.OLWI_moreFixedAttr & OWMFA_IS_POPUP) &&
		(d.VI_specAttrs & SA_USES_DUAL_BUILD) &&
		!(d.OLPWI_flags & (OLPWF_APP_MODAL | OLPWF_SYS_MODAL)));
	UMCHECK(!(d.OLDWI_optFlags & (OLDOF_SINGLE_USAGE |
				      OLDOF_DELAYED_MODE)));
	UMCHECK(d.OLWI_winPosSizeFlags ==
		(WPSF_PERSIST | (WCT_KEEP_PARTIALLY_VISIBLE << 6) |
		 (WPT_CENTER << 3) | WST_AS_DESIRED |
		 WPSF_SHRINK_DESIRED_SIZE_TO_FIT_IN_PARENT));

	/* usable: built, not open */
	@call UMDialog::MSG_GEN_SET_USABLE(VUM_NOW);
	VisData(@UMDialog, &d, sizeof(d));
	UMCHECK(!(d.VI_attrs & VA_REALIZED));
	/* initiated: open on the field, centered */
	@call UMDialog::MSG_GEN_INTERACTION_INITIATE();
	VisData(@UMDialog, &d, sizeof(d));
	UMCHECK((d.VI_attrs & VA_REALIZED) && d.VCI_window &&
		(d.VI_specAttrs & SA_REALIZABLE));
	if (d.VCI_window)
	    WinGetInfo(d.VCI_window, WIT_PARENT_WIN, &parent);
	UMCHECK(parent == umState.UMS_fieldWin);
	VisData(umField, &f, sizeof(f));
	cx = (sword) ((d.VI_bounds.R_left + d.VI_bounds.R_right) / 2);
	fcx = (sword) ((f.VI_bounds.R_left + f.VI_bounds.R_right) / 2);
	UMCHECK(cx >= fcx - 1 && cx <= fcx + 1);
	/* the children: the group in the gadget area, the toolbox in the
	 * left title bar group, the reply bar ours and last */
	UMCHECK(d.OLDWI_gadgetArea != 0);
	ga = ConstructOptr(OptrToHandle(@UMDialog), d.OLDWI_gadgetArea);
	UMCHECK(InClass(ga, (ClassStruct *) &OLGadgetAreaClass));
	UMCHECK(InClass(@UMDlgGroup, (ClassStruct *) &OLCtrlClass));
	UMCHECK(@call UMDlgGroup::MSG_VIS_FIND_PARENT() == ga);
	tg = d.OLWI_titleBarLeftGroup;
	UMCHECK(tg && @call UMDlgTool::MSG_VIS_FIND_PARENT() == tg);
	UMCHECK(InClass(@UMDlgReply, (ClassStruct *) &OLReplyBarClass));
	UMCHECK(d.OLDWI_replyBar == @UMDlgReply &&
		!(d.OLDWI_optFlags & OLDOF_REPLY_BAR_CREATED));
	VisData(@UMDlgReply, &rb, sizeof(rb));
	UMCHECK(rb.OLRBI_dialog == @UMDialog &&
		(rb.OLRBI_flags & OLRBF_UNDER_DIALOG));
	UMCHECK(@call UMDlgReply::MSG_VIS_FIND_PARENT() == @UMDialog);
	UMCHECK(@call UMDialog::MSG_VIS_FIND_CHILD(@UMDlgReply) ==
		@call UMDialog::MSG_VIS_COUNT_CHILDREN() - 1);
	UMCHECK(@call UMDlgReplyGroup::MSG_VIS_FIND_PARENT() == @UMDlgReply);

	/* dismissed: closed, not realizable; initiated again: open */
	(void) @call UMDialog::MSG_GEN_GUP_INTERACTION_COMMAND(IC_DISMISS);
	VisData(@UMDialog, &d, sizeof(d));
	UMCHECK(!(d.VI_attrs & VA_REALIZED) &&
		!(d.VI_specAttrs & SA_REALIZABLE));
	@call UMDialog::MSG_GEN_INTERACTION_INITIATE();
	VisData(@UMDialog, &d, sizeof(d));
	UMCHECK(d.VI_attrs & VA_REALIZED);
	/* a command dialog stays when complete */
	(void) @call UMDialog::MSG_GEN_GUP_INTERACTION_COMMAND(
						IC_INTERACTION_COMPLETE);
	VisData(@UMDialog, &d, sizeof(d));
	UMCHECK(d.VI_attrs & VA_REALIZED);

	/* the notice: modal, not closable, single usage */
	@call umApp::MSG_GEN_ADD_CHILD(@UMNotice, CCO_LAST);
	@call UMNotice::MSG_GEN_SET_USABLE(VUM_NOW);
	UMCHECK(InClass(@UMNotice, (ClassStruct *) &OLDialogWinClass));
	VisData(@UMNotice, &d, sizeof(d));
	UMCHECK(d.OLWI_type == MOWT_NOTICE_WINDOW &&
		(d.OLPWI_flags & OLPWF_APP_MODAL) &&
		!(d.OLWI_attrs & (OWA_CLOSABLE | OWA_HAS_SYS_MENU)) &&
		(d.VI_attrs & VA_BRANCH_NOT_MINIMIZABLE) &&
		(d.OLDWI_optFlags & OLDOF_SINGLE_USAGE));
	UMCHECK(d.OLWI_winPosSizeFlags == (WPSF_PERSIST |
		(WCT_KEEP_VISIBLE << 6) | (WPT_CENTER << 3) | WST_AS_DESIRED));
	@call UMNotice::MSG_GEN_INTERACTION_INITIATE();
	VisData(@UMNotice, &d, sizeof(d));
	UMCHECK(d.VI_attrs & VA_REALIZED);
	/* the reply bar it made, last, holding the group */
	rbo = d.OLDWI_replyBar;
	UMCHECK(rbo && (d.OLDWI_optFlags & OLDOF_REPLY_BAR_CREATED));
	if (rbo) {
	    UMCHECK(InClass(rbo, (ClassStruct *) &OLReplyBarClass));
	    UMCHECK(@call rbo::MSG_VIS_FIND_PARENT() == @UMNotice);
	    UMCHECK(@call UMNotice::MSG_VIS_FIND_CHILD(rbo) ==
		    @call UMNotice::MSG_VIS_COUNT_CHILDREN() - 1);
	}
	(void) @call UMNotice::MSG_GEN_GUP_INTERACTION_COMMAND(
						IC_INTERACTION_COMPLETE);
	VisData(@UMNotice, &d, sizeof(d));
	UMCHECK(!(d.VI_attrs & VA_REALIZED) &&
		!(d.OLDWI_optFlags & OLDOF_DOING_COMPLETE));

	/* not usable: closed */
	@call UMDialog::MSG_GEN_SET_NOT_USABLE(VUM_NOW);
	VisData(@UMDialog, &d, sizeof(d));
	UMCHECK(!(d.VI_attrs & VA_REALIZED));
	@call UMNotice::MSG_GEN_SET_NOT_USABLE(VUM_NOW);
	break;
    }

    case 14: {
	/* GenTrigger as OLButton (OLBuildTrigger): in the dialog's
	 * gadget area, bordered, sized by its moniker and insets; the
	 * window mark of HINT_TRIGGER_BRINGS_UP_WINDOW makes it wider; a
	 * dismiss trigger seeking the reply bar is there and the
	 * dialog's standard trigger; a press depresses it and grabs the
	 * mouse, the release in it activates it (through the queue, the
	 * test waits for the action); MSG_GEN_ACTIVATE too (the data) */
	OLDialogWinInstance d;
	OLButtonInstance b, bd;
	MouseReturnParams mr;
	optr ga;
	SizeAsDWord sz, szd;
	word in;

	@call umApp::MSG_GEN_ADD_CHILD(@UMTrigDialog, CCO_LAST);
	@call UMTrigDialog::MSG_GEN_SET_USABLE(VUM_NOW);
	@call UMTrigDialog::MSG_GEN_INTERACTION_INITIATE();
	VisData(@UMTrigDialog, &d, sizeof(d));
	UMCHECK(d.VI_attrs & VA_REALIZED);
	ga = ConstructOptr(OptrToHandle(@UMTrigDialog), d.OLDWI_gadgetArea);
	UMCHECK(InClass(@UMTrig, (ClassStruct *) &OLButtonClass));
	UMCHECK(@call UMTrig::MSG_VIS_FIND_PARENT() == ga);
	VisData(@UMTrig, &b, sizeof(b));
	UMCHECK(b.OLBI_genChunk == OptrToChunk(@UMTrig));
	UMCHECK((b.OLBI_specState & OLBSS_BORDERED) &&
		!(b.OLBI_specState & (OLBSS_IN_MENU | OLBSS_IN_MENU_BAR |
				      OLBSS_SYS_ICON | OLBSS_WINDOW_MARK)));
	UMCHECK((b.VI_specAttrs & SA_CUSTOM_VIS_PARENT) &&
		(b.VI_attrs & VA_REALIZED) && (b.VI_attrs & VA_FULLY_ENABLED));
	UMCHECK(b.OLBI_optFlags & OLBOF_ENABLED);
	sz = @call UMTrig::MSG_VIS_GET_SIZE();
	UMCHECK(DWORD_WIDTH(sz) > 2 * 6 &&
		DWORD_HEIGHT(sz) >= 5);
	VisData(@UMTrigData, &bd, sizeof(bd));
	UMCHECK(bd.OLBI_specState & OLBSS_WINDOW_MARK);
	szd = @call UMTrigData::MSG_VIS_GET_SIZE();
	UMCHECK(DWORD_HEIGHT(szd) == DWORD_HEIGHT(sz));
	/* the dismiss trigger in the reply bar the dialog made */
	UMCHECK(InClass(@UMTrigClose, (ClassStruct *) &OLButtonClass));
	UMCHECK(d.OLDWI_replyBar &&
		@call UMTrigClose::MSG_VIS_FIND_PARENT() == d.OLDWI_replyBar);
	UMCHECK(@call UMTrigDialog::MSG_OL_DIALOG_WIN_FIND_STANDARD_TRIGGER(
						IC_DISMISS) == @UMTrigClose);
	VisData(@UMTrigClose, &b, sizeof(b));
	UMCHECK(b.OLBI_fixedAttrs & OLBFA_IMMEDIATE_ACTION);

	/* pressed in it: depressed, the mouse grabbed */
	in = (UIFA_SELECT | UIFA_IN) << 8;
	@call UMTrig::MSG_META_START_SELECT(&mr, 0, 0, in);
	UMCHECK(mr.flags & MRF_PROCESSED);
	VisData(@UMTrig, &b, sizeof(b));
	UMCHECK((b.OLBI_specState & (OLBSS_DEPRESSED | OLBSS_HAS_MOUSE_GRAB)) ==
		(OLBSS_DEPRESSED | OLBSS_HAS_MOUSE_GRAB));
	/* moved out while pressed: not depressed, still grabbed */
	@call UMTrig::MSG_META_PTR(&mr, 0, 0, UIFA_SELECT << 8);
	VisData(@UMTrig, &b, sizeof(b));
	UMCHECK(!(b.OLBI_specState & OLBSS_DEPRESSED) &&
		(b.OLBI_specState & OLBSS_HAS_MOUSE_GRAB));
	@call UMTrig::MSG_META_PTR(&mr, 0, 0, in);
	/* released in it: activated, back up, the mouse released */
	@call UMTrig::MSG_META_END_SELECT(&mr, 0, 0, UIFA_IN << 8);
	VisData(@UMTrig, &b, sizeof(b));
	UMCHECK(!(b.OLBI_specState & (OLBSS_DEPRESSED |
				      OLBSS_HAS_MOUSE_GRAB)));
	/* the data trigger activated */
	@call UMTrigData::MSG_GEN_ACTIVATE();
	/* disabled: no action */
	@call UMTrig::MSG_GEN_SET_NOT_ENABLED(VUM_NOW);
	VisData(@UMTrig, &b, sizeof(b));
	UMCHECK(!(b.VI_attrs & VA_FULLY_ENABLED));
	@call UMTrig::MSG_GEN_ACTIVATE();
	@call UMTrig::MSG_GEN_SET_ENABLED(VUM_NOW);
	break;
    }

    case 15: {
	/* the actions arrived (the test waited); the trigger's generic
	 * messages; the dismiss trigger closes the dialog at once */
	OLDialogWinInstance d;

	UMCHECK(umState.UMS_triggered == 2);
	UMCHECK(umState.UMS_trigger == @UMTrig);
	UMCHECK(umState.UMS_trigData == 0x1234);
	UMCHECK(@call UMTrig::MSG_GEN_TRIGGER_GET_ACTION_MSG() ==
		MSG_UM_TRIGGERED);
	@call UMTrig::MSG_GEN_TRIGGER_SET_ACTION_MSG(MSG_UM_TRIGGER_DATA);
	UMCHECK(@call UMTrig::MSG_GEN_TRIGGER_GET_ACTION_MSG() ==
		MSG_UM_TRIGGER_DATA);
	@call UMTrig::MSG_GEN_TRIGGER_SET_ACTION_MSG(MSG_UM_TRIGGERED);
	UMCHECK(@call UMTrig::MSG_GEN_TRIGGER_GET_DESTINATION() ==
		ConstructOptr(umState.UMS_process, 0));
	@call UMTrigClose::MSG_GEN_ACTIVATE();
	VisData(@UMTrigDialog, &d, sizeof(d));
	UMCHECK(!(d.VI_attrs & VA_REALIZED));
	@call UMTrigDialog::MSG_GEN_SET_NOT_USABLE(VUM_NOW);
	break;
    }

    case 16: {
	/* the standard triggers a dialog adds to its reply bar (in it,
	 * noted, with the standard monikers): a command dialog's Close
	 * (last in its own reply bar), a notice's OK, an affirmation's
	 * Yes and No (Yes the default, signalling completion: sent, the
	 * single usage dialog closes), delayed properties' Apply (first,
	 * disabled), Reset and Close; not usable they go */
	OLDialogWinInstance d;
	optr t, t2, t3;
	GenInstance g;

	@call UMDialog::MSG_GEN_SET_USABLE(VUM_NOW);
	@call UMDialog::MSG_GEN_INTERACTION_INITIATE();
	t = @call UMDialog::MSG_OL_DIALOG_WIN_FIND_STANDARD_TRIGGER(IC_DISMISS);
	UMCHECK(t && InClass(t, (ClassStruct *) &OLButtonClass));
	if (t) {
	    UMCHECK(@call t::MSG_GEN_FIND_PARENT() == @UMDlgReply);
	    UMCHECK(@call UMDlgReply::MSG_GEN_FIND_CHILD(t) ==
		    @call UMDlgReply::MSG_GEN_COUNT_CHILDREN() - 1);
	    UMCHECK(@call t::MSG_VIS_FIND_PARENT() == @UMDlgReply);
	    UMCHECK(MonikerIs(t, "Close"));
	}
	@call UMDialog::MSG_GEN_SET_NOT_USABLE(VUM_NOW);
	UMCHECK(!@call UMDialog::MSG_OL_DIALOG_WIN_FIND_STANDARD_TRIGGER(
								IC_DISMISS));

	@call UMNotice::MSG_GEN_SET_USABLE(VUM_NOW);
	@call UMNotice::MSG_GEN_INTERACTION_INITIATE();
	t = @call UMNotice::MSG_OL_DIALOG_WIN_FIND_STANDARD_TRIGGER(IC_OK);
	UMCHECK(t && MonikerIs(t, "OK"));
	(void) @call UMNotice::MSG_GEN_GUP_INTERACTION_COMMAND(IC_DISMISS);
	@call UMNotice::MSG_GEN_SET_NOT_USABLE(VUM_NOW);

	@call umApp::MSG_GEN_ADD_CHILD(@UMAffirm, CCO_LAST);
	@call UMAffirm::MSG_GEN_SET_USABLE(VUM_NOW);
	@call UMAffirm::MSG_GEN_INTERACTION_INITIATE();
	VisData(@UMAffirm, &d, sizeof(d));
	UMCHECK(d.VI_attrs & VA_REALIZED);
	t = @call UMAffirm::MSG_OL_DIALOG_WIN_FIND_STANDARD_TRIGGER(IC_YES);
	t2 = @call UMAffirm::MSG_OL_DIALOG_WIN_FIND_STANDARD_TRIGGER(IC_NO);
	UMCHECK(t && t2 && MonikerIs(t, "Yes") && MonikerIs(t2, "No"));
	if (t && t2) {
	    UMCHECK(@call t::MSG_VIS_FIND_PARENT() == d.OLDWI_replyBar);
	    UMCHECK(ObjVarFindData(t, HINT_DEFAULT_DEFAULT_ACTION) != NULL);
	    ObjLockObjBlock(OptrToHandle(t));
	    g = *(GenInstance *) ObjDerefGen(t);
	    MemUnlock(OptrToHandle(t));
	    UMCHECK(g.GI_attrs & GA_SIGNAL_INTERACTION_COMPLETE);
	    @call t::MSG_GEN_TRIGGER_SEND_ACTION(FALSE);
	    VisData(@UMAffirm, &d, sizeof(d));
	    UMCHECK(!(d.VI_attrs & VA_REALIZED));
	}
	@call UMAffirm::MSG_GEN_SET_NOT_USABLE(VUM_NOW);

	@call umApp::MSG_GEN_ADD_CHILD(@UMProps, CCO_LAST);
	@call UMProps::MSG_GEN_SET_USABLE(VUM_NOW);
	@call UMProps::MSG_GEN_INTERACTION_INITIATE();
	VisData(@UMProps, &d, sizeof(d));
	UMCHECK((d.OLDWI_optFlags & (OLDOF_DELAYED_MODE |
				     OLDOF_COMPLEX_PROPERTIES)) ==
		(OLDOF_DELAYED_MODE | OLDOF_COMPLEX_PROPERTIES));
	t = @call UMProps::MSG_OL_DIALOG_WIN_FIND_STANDARD_TRIGGER(IC_APPLY);
	t2 = @call UMProps::MSG_OL_DIALOG_WIN_FIND_STANDARD_TRIGGER(IC_RESET);
	t3 = @call UMProps::MSG_OL_DIALOG_WIN_FIND_STANDARD_TRIGGER(
								IC_DISMISS);
	UMCHECK(t && t2 && t3);
	if (t && t2 && t3) {
	    UMCHECK(MonikerIs(t, "Apply") && MonikerIs(t2, "Reset") &&
		    MonikerIs(t3, "Close"));
	    UMCHECK(@call d.OLDWI_replyBar::MSG_GEN_FIND_CHILD(t) == 0);
	    UMCHECK(!@call t::MSG_GEN_GET_ENABLED() &&
		    !@call t2::MSG_GEN_GET_ENABLED() &&
		    @call t3::MSG_GEN_GET_ENABLED());
	}
	@call UMProps::MSG_GEN_SET_NOT_USABLE(VUM_NOW);
	break;
    }

    case 17: {
	/* a dialog the user brings up: an OLButton made beside it (its
	 * generic part the dialog, the window mark), in the host's
	 * gadget area, the dialog closed; activated (queued) */
	OLDialogWinInstance d, pd;
	OLButtonInstance bi;
	optr b, ga;

	@call umApp::MSG_GEN_ADD_CHILD(@UMHost, CCO_LAST);
	@call UMHost::MSG_GEN_SET_USABLE(VUM_NOW);
	@call UMHost::MSG_GEN_INTERACTION_INITIATE();
	VisData(@UMHost, &d, sizeof(d));
	UMCHECK(d.VI_attrs & VA_REALIZED);
	ga = ConstructOptr(OptrToHandle(@UMHost), d.OLDWI_gadgetArea);
	VisData(@UMPopDlg, &pd, sizeof(pd));
	UMCHECK(pd.OLPWI_button != 0 && !(pd.VI_attrs & VA_REALIZED));
	b = ConstructOptr(OptrToHandle(@UMPopDlg), pd.OLPWI_button);
	UMCHECK(@call UMPopDlg::MSG_OL_POPUP_FIND_BUTTON() == b);
	UMCHECK(InClass(b, (ClassStruct *) &OLButtonClass));
	UMCHECK(@call b::MSG_VIS_FIND_PARENT() == ga);
	UMCHECK(@call b::MSG_OL_BUTTON_GET_GEN_PART() == @UMPopDlg);
	VisData(b, &bi, sizeof(bi));
	UMCHECK((bi.OLBI_specState & OLBSS_WINDOW_MARK) &&
		(bi.VI_attrs & VA_REALIZED) &&
		(bi.VI_attrs & VA_FULLY_ENABLED));
	@call b::MSG_GEN_ACTIVATE();
	break;
    }

    case 18: {
	/* the dialog came up; closed and the host not usable, the
	 * button goes with it */
	OLDialogWinInstance pd;

	VisData(@UMPopDlg, &pd, sizeof(pd));
	UMCHECK((pd.VI_attrs & VA_REALIZED) && pd.VCI_window);
	(void) @call UMPopDlg::MSG_GEN_GUP_INTERACTION_COMMAND(IC_DISMISS);
	VisData(@UMPopDlg, &pd, sizeof(pd));
	UMCHECK(!(pd.VI_attrs & VA_REALIZED));
	@call UMHost::MSG_GEN_SET_NOT_USABLE(VUM_NOW);
	VisData(@UMPopDlg, &pd, sizeof(pd));
	UMCHECK(!pd.OLPWI_button);
	break;
    }

    case 19: {
	/* menus (OLMenuWin, OLMenuButton, OLMenuBar): the primary makes
	 * its menu bar (first in it); each menu's button is in the bar
	 * (the Edit menu with its group type's moniker); pressed, the
	 * menu comes up below the button, its item in it; released on
	 * the button, the menu stays up; the other menu's button pressed
	 * closes it and opens its own; a press outside a menu in stay up
	 * mode closes it (replayed); activated, the menu is up in stay up
	 * mode; complete, it goes and the button is as it was */
	OLMenuedWinInstance mw;
	OLMenuWinInstance m;
	OLMenuButtonInstance b;
	OLButtonInstance it;
	MouseReturnParams mr;
	optr bar, eb, vb;
	word press = (UIFA_SELECT | UIFA_IN) << 8;

	@call umApp::MSG_GEN_ADD_CHILD(@UMMenuPrim, CCO_LAST);
	@call UMMenuPrim::MSG_GEN_SET_USABLE(VUM_NOW);
	VisData(@UMMenuPrim, &mw, sizeof(mw));
	UMCHECK(mw.VI_attrs & VA_REALIZED);
	UMCHECK(mw.OLMDWI_menuBar != 0);
	bar = ConstructOptr(OptrToHandle(@UMMenuPrim), mw.OLMDWI_menuBar);
	UMCHECK(InClass(bar, (ClassStruct *) &OLMenuBarClass));
	UMCHECK(@call UMMenuPrim::MSG_VIS_FIND_CHILD(bar) == 0);
	UMCHECK(@call UMMenuPrim::MSG_OL_WIN_QUERY_MENU_BAR() == bar);
	UMCHECK(InClass(@UMEditMenu, (ClassStruct *) &OLMenuWinClass));
	VisData(@UMEditMenu, &m, sizeof(m));
	UMCHECK(m.OLWI_type == MOWT_MENU &&
		(m.OLWI_fixedAttr & OWFA_IS_MENU) &&
		!(m.VI_attrs & VA_REALIZED));
	UMCHECK(MonikerIs(@UMEditMenu, "Edit"));
	UMCHECK(m.OLPWI_button != 0);
	eb = ConstructOptr(OptrToHandle(@UMEditMenu), m.OLPWI_button);
	VisData(@UMViewMenu, &m, sizeof(m));
	vb = ConstructOptr(OptrToHandle(@UMViewMenu), m.OLPWI_button);
	UMCHECK(InClass(eb, (ClassStruct *) &OLMenuButtonClass) &&
		InClass(vb, (ClassStruct *) &OLMenuButtonClass));
	UMCHECK(@call eb::MSG_VIS_FIND_PARENT() == bar &&
		@call vb::MSG_VIS_FIND_PARENT() == bar);
	UMCHECK(@call bar::MSG_VIS_FIND_CHILD(eb) == 0 &&
		@call bar::MSG_VIS_FIND_CHILD(vb) == 1);
	VisData(eb, &b, sizeof(b));
	UMCHECK(b.OLMBI_popupType == MOWT_MENU &&
		(b.OLBI_specState & OLBSS_IN_MENU_BAR) &&
		(b.VI_attrs & VA_REALIZED) && (b.VI_attrs & VA_FULLY_ENABLED));

	/* pressed: open, bordered, the mouse grabbed */
	@call eb::MSG_META_START_SELECT(&mr, 2, 2, press);
	UMCHECK(mr.flags & MRF_PROCESSED);
	VisData(eb, &b, sizeof(b));
	UMCHECK((b.OLMBI_specState & OLMBSS_POPUP_OPEN) &&
		(b.OLBI_specState & OLBSS_BORDERED) &&
		(b.OLBI_specState & OLBSS_HAS_MOUSE_GRAB));
	VisData(@UMEditMenu, &m, sizeof(m));
	UMCHECK((m.VI_attrs & VA_REALIZED) && m.VCI_window &&
		!(m.OLMWI_specState & OMWSS_IN_STAY_UP_MODE));
	UMCHECK(InClass(@UMCopy, (ClassStruct *) &OLButtonClass) &&
		@call UMCopy::MSG_VIS_FIND_PARENT() == @UMEditMenu);
	VisData(@UMCopy, &it, sizeof(it));
	UMCHECK(it.OLBI_specState & OLBSS_IN_MENU);
	/* released on the button: stays up */
	@call eb::MSG_META_END_SELECT(&mr, 2, 2, UIFA_IN << 8);
	VisData(eb, &b, sizeof(b));
	UMCHECK((b.OLMBI_specState & OLMBSS_POPUP_OPEN) &&
		!(b.OLBI_specState & OLBSS_HAS_MOUSE_GRAB) &&
		!(b.OLMBI_specState & OLMBSS_MENU_FUNCTION_PENDING));
	VisData(@UMEditMenu, &m, sizeof(m));
	UMCHECK((m.VI_attrs & VA_REALIZED) &&
		(m.OLMWI_specState & OMWSS_IN_STAY_UP_MODE));

	/* the View menu's button pressed: Edit closes, View opens */
	@call vb::MSG_META_START_SELECT(&mr, 2, 2, press);
	VisData(eb, &b, sizeof(b));
	UMCHECK(!(b.OLMBI_specState & OLMBSS_POPUP_OPEN) &&
		!(b.OLBI_specState & OLBSS_BORDERED));
	VisData(@UMEditMenu, &m, sizeof(m));
	UMCHECK(!(m.VI_attrs & VA_REALIZED));
	VisData(@UMViewMenu, &m, sizeof(m));
	UMCHECK(m.VI_attrs & VA_REALIZED);
	@call vb::MSG_META_END_SELECT(&mr, 2, 2, UIFA_IN << 8);
	VisData(@UMViewMenu, &m, sizeof(m));
	UMCHECK(m.OLMWI_specState & OMWSS_IN_STAY_UP_MODE);
	/* a press outside it: closed, replayed */
	@call UMViewMenu::MSG_META_PRE_PASSIVE_BUTTON(&mr, -100, -100,
						BI_PRESS | (UIFA_SELECT << 8));
	UMCHECK(mr.flags & MRF_REPLAY);
	VisData(@UMViewMenu, &m, sizeof(m));
	UMCHECK(!(m.VI_attrs & VA_REALIZED) &&
		!(m.OLMWI_specState & OMWSS_IN_STAY_UP_MODE));
	VisData(vb, &b, sizeof(b));
	UMCHECK(!(b.OLMBI_specState & OLMBSS_POPUP_OPEN));

	/* activated: up in stay up mode; complete: down */
	@call eb::MSG_GEN_ACTIVATE();
	VisData(@UMEditMenu, &m, sizeof(m));
	UMCHECK((m.VI_attrs & VA_REALIZED) &&
		(m.OLMWI_specState & OMWSS_IN_STAY_UP_MODE));
	VisData(eb, &b, sizeof(b));
	UMCHECK((b.OLMBI_specState & OLMBSS_POPUP_OPEN) &&
		(b.OLBI_specState & OLBSS_BORDERED));
	(void) @call UMEditMenu::MSG_GEN_GUP_INTERACTION_COMMAND(
						IC_INTERACTION_COMPLETE);
	VisData(@UMEditMenu, &m, sizeof(m));
	UMCHECK(!(m.VI_attrs & VA_REALIZED));
	VisData(eb, &b, sizeof(b));
	UMCHECK(!(b.OLMBI_specState & OLMBSS_POPUP_OPEN) &&
		!(b.OLBI_specState & OLBSS_BORDERED));
	@call UMMenuPrim::MSG_GEN_SET_NOT_USABLE(VUM_NOW);
	break;
    }
    case 20: {
	/* the mouse in a window (cwinPtr): a press starts the window's
	 * grab (post-passive) and, not taken on the title, a move: a
	 * click without a drag moves nothing, dragged and released the
	 * window moves by the pointer's way; on the bottom right corner
	 * a resize of the two edges; all buttons up the grab ends; the
	 * pointer in the window watches for a press (pre-passive); a sub
	 * menu's button with its right mark (the test checks its pixels) */
	OLWinInstance w;
	OLMenuButtonInstance b;
	OLMenuWinInstance m;
	MouseReturnParams mr;
	Rectangle r0;
	sword tx, ty, wd, ht;
	word sel = (UIFA_SELECT | UIFA_IN) << 8;
	optr sb;
	XYValueAsDWord s;

	@call UMMenuPrim::MSG_GEN_SET_USABLE(VUM_NOW);
	/* resizable as with a mouse (the test has none: keyboard only) */
	ObjLockObjBlock(OptrToHandle(@UMMenuPrim));
	((OLWinInstance *) ObjDerefVis(@UMMenuPrim))->OLWI_attrs |=
	    OWA_RESIZABLE;
	MemUnlock(OptrToHandle(@UMMenuPrim));
	VisData(@UMMenuPrim, &w, sizeof(w));
	UMCHECK((w.VI_attrs & VA_REALIZED) && !(w.OLWI_specState &
						 OLWSS_MAXIMIZED));
	UMCHECK((w.OLWI_attrs & (OWA_MOVABLE | OWA_RESIZABLE | OWA_TITLED)) ==
		(OWA_MOVABLE | OWA_RESIZABLE | OWA_TITLED));
	r0 = w.VI_bounds;
	tx = (w.OLWI_titleBarBounds.R_left + w.OLWI_titleBarBounds.R_right) / 2;
	ty = (w.OLWI_titleBarBounds.R_top + w.OLWI_titleBarBounds.R_bottom) / 2;
	@call UMMenuPrim::MSG_META_START_SELECT(&mr, tx, ty, sel | BI_PRESS);
	VisData(@UMMenuPrim, &w, sizeof(w));
	UMCHECK((mr.flags & MRF_PROCESSED) &&
		(w.OLWI_specState & OLWSS_GRABBED) &&
		w.OLWI_moveResizeState == (OLWMRS_MOVING |
					   OLWMRS_MOVE_RESIZE_PENDING));
	@call UMMenuPrim::MSG_META_END_SELECT(&mr, tx, ty, sel);
	VisData(@UMMenuPrim, &w, sizeof(w));
	UMCHECK(!w.OLWI_moveResizeState &&
		w.VI_bounds.R_left == r0.R_left && w.VI_bounds.R_top == r0.R_top);
	/* all buttons up: the grab ends */
	@call UMMenuPrim::MSG_META_POST_PASSIVE_BUTTON(&mr, tx, ty, 0);
	VisData(@UMMenuPrim, &w, sizeof(w));
	UMCHECK(!(w.OLWI_specState & OLWSS_GRABBED));

	/* moved */
	@call UMMenuPrim::MSG_META_START_SELECT(&mr, tx, ty, sel | BI_PRESS);
	@call UMMenuPrim::MSG_META_DRAG_SELECT(&mr, tx, ty, sel);
	VisData(@UMMenuPrim, &w, sizeof(w));
	UMCHECK(w.OLWI_moveResizeState == OLWMRS_MOVING);
	@call UMMenuPrim::MSG_META_END_SELECT(&mr, tx + 10, ty + 6, sel);
	@call UMMenuPrim::MSG_META_POST_PASSIVE_BUTTON(&mr, tx, ty, 0);
	VisData(@UMMenuPrim, &w, sizeof(w));
	UMCHECK(!w.OLWI_moveResizeState &&
		(w.OLWI_winPosSizeState & WPSS_HAS_MOVED_OR_RESIZED));
	UMCHECK(w.VI_bounds.R_left == r0.R_left + 10 &&
		w.VI_bounds.R_top == r0.R_top + 6 &&
		w.VI_bounds.R_right == r0.R_right + 10 &&
		w.VI_bounds.R_bottom == r0.R_bottom + 6);
	r0 = w.VI_bounds;

	/* resized at the bottom right corner */
	wd = r0.R_right - r0.R_left;
	ht = r0.R_bottom - r0.R_top;
	@call UMMenuPrim::MSG_META_START_SELECT(&mr, wd - 2, ht - 2,
						sel | BI_PRESS);
	VisData(@UMMenuPrim, &w, sizeof(w));
	UMCHECK(w.OLWI_moveResizeState == (OLWMRS_RESIZING_DOWN |
					   OLWMRS_RESIZING_RIGHT |
					   OLWMRS_MOVE_RESIZE_PENDING));
	@call UMMenuPrim::MSG_META_DRAG_SELECT(&mr, wd - 2, ht - 2, sel);
	@call UMMenuPrim::MSG_META_END_SELECT(&mr, wd + 18, ht + 8, sel);
	@call UMMenuPrim::MSG_META_POST_PASSIVE_BUTTON(&mr, 0, 0, 0);
	VisData(@UMMenuPrim, &w, sizeof(w));
	UMCHECK(!w.OLWI_moveResizeState &&
		!(w.OLWI_specState & OLWSS_GRABBED));
	UMCHECK(w.VI_bounds.R_left == r0.R_left &&
		w.VI_bounds.R_top == r0.R_top &&
		w.VI_bounds.R_right == r0.R_right + 20 &&
		w.VI_bounds.R_bottom == r0.R_bottom + 10);

	/* the pointer in the window and out */
	@call UMMenuPrim::MSG_META_RAW_UNIV_ENTER();
	VisData(@UMMenuPrim, &w, sizeof(w));
	UMCHECK(w.OLWI_specState & OLWSS_PTR_IN_RAW_UNIV);
	@call UMMenuPrim::MSG_META_RAW_UNIV_LEAVE();
	VisData(@UMMenuPrim, &w, sizeof(w));
	UMCHECK(!(w.OLWI_specState & OLWSS_PTR_IN_RAW_UNIV));

	/* the sub menu's button, in the Edit menu brought up */
	VisData(@UMEditMenu, &m, sizeof(m));
	sb = ConstructOptr(OptrToHandle(@UMEditMenu), m.OLPWI_button);
	@call sb::MSG_GEN_ACTIVATE();
	UMCHECK(InClass(@UMMoreMenu, (ClassStruct *) &OLMenuWinClass));
	VisData(@UMMoreMenu, &m, sizeof(m));
	UMCHECK(m.OLWI_type == MOWT_SUBMENU && m.OLPWI_button);
	sb = ConstructOptr(OptrToHandle(@UMMoreMenu), m.OLPWI_button);
	UMCHECK(@call sb::MSG_VIS_FIND_PARENT() == @UMEditMenu);
	VisData(sb, &b, sizeof(b));
	UMCHECK(b.OLMBI_popupType == MOWT_SUBMENU &&
		(b.OLBI_specState & (OLBSS_MENU_RIGHT_MARK | OLBSS_IN_MENU)) ==
		(OLBSS_MENU_RIGHT_MARK | OLBSS_IN_MENU) &&
		(b.VI_attrs & VA_REALIZED));
	VisData(@UMEditMenu, &m, sizeof(m));
	s = WinTransform(m.VCI_window,
			 b.VI_bounds.R_right - (12 + 6),	/* the mark, inset */
			 b.VI_bounds.R_top +
			 (b.VI_bounds.R_bottom - b.VI_bounds.R_top -
			  8) / 2);
	umState.UMS_markX = (sword) DWORD_X(s);
	umState.UMS_markY = (sword) DWORD_Y(s);
	break;
    }
    case 21: {
	/* the Edit menu down, the primary not usable */
	OLMenuWinInstance m;

	(void) @call UMEditMenu::MSG_GEN_GUP_INTERACTION_COMMAND(IC_DISMISS);
	VisData(@UMEditMenu, &m, sizeof(m));
	UMCHECK(!(m.VI_attrs & VA_REALIZED));
	@call UMMenuPrim::MSG_GEN_SET_NOT_USABLE(VUM_NOW);
	break;
    }
    case 22: {
	/* the keyboard in the menus: Alt pressed and released alone puts
	 * the focus on the first menu button (menu related, drawn
	 * cursored); right and left move along the bar; down opens the
	 * menu with the focus (the menu the primary's focus, its first
	 * item its own); down and up through the items; right on a sub
	 * menu's button opens it, left in it back to its button; right
	 * in a menu goes to the next menu of the bar (the menu opened);
	 * Escape completes it */
	OLWinInstance w;
	OLMenuWinInstance m;
	OLMenuButtonInstance b;
	optr eb, vb, mb;
	word alt = (CS_CONTROL << 8) | VC_LALT;
#define K(c)	((CS_CONTROL << 8) | (c))

	@call UMMenuPrim::MSG_GEN_SET_USABLE(VUM_NOW);
	VisData(@UMEditMenu, &m, sizeof(m));
	eb = ConstructOptr(OptrToHandle(@UMEditMenu), m.OLPWI_button);
	VisData(@UMViewMenu, &m, sizeof(m));
	vb = ConstructOptr(OptrToHandle(@UMViewMenu), m.OLPWI_button);

	/* Alt */
	UMCHECK(@call UMMenuPrim::MSG_META_FUP_KBD_CHAR(alt, CF_FIRST_PRESS,
							0));
	UMCHECK(@call UMMenuPrim::MSG_META_FUP_KBD_CHAR(alt, CF_RELEASE, 0));
	VisData(@UMMenuPrim, &w, sizeof(w));
	UMCHECK(w.OLWI_focusExcl.FTVMC_OD == eb &&
		(w.OLWI_focusExcl.FTVMC_flags & MAEF_OD_IS_MENU_RELATED));
	UMCHECK(@call UMMenuPrim::MSG_OL_WIN_QUERY_MENU_BAR_HAS_FOCUS());
	VisData(eb, &b, sizeof(b));
	UMCHECK((b.OLBI_specState & (OLBSS_CURSORED | OLBSS_BORDERED)) ==
		(OLBSS_CURSORED | OLBSS_BORDERED));
	/* right, left */
	UMCHECK(@call UMMenuPrim::MSG_META_FUP_KBD_CHAR(K(VC_RIGHT),
							CF_FIRST_PRESS, 0));
	VisData(@UMMenuPrim, &w, sizeof(w));
	UMCHECK(w.OLWI_focusExcl.FTVMC_OD == vb);
	VisData(eb, &b, sizeof(b));
	UMCHECK(!(b.OLBI_specState & (OLBSS_CURSORED | OLBSS_BORDERED)));
	UMCHECK(@call UMMenuPrim::MSG_META_FUP_KBD_CHAR(K(VC_LEFT),
							CF_FIRST_PRESS, 0));
	VisData(@UMMenuPrim, &w, sizeof(w));
	UMCHECK(w.OLWI_focusExcl.FTVMC_OD == eb);
	/* down: the Edit menu up, its first item the focus */
	UMCHECK(@call UMMenuPrim::MSG_META_FUP_KBD_CHAR(K(VC_DOWN),
							CF_FIRST_PRESS, 0));
	VisData(@UMEditMenu, &m, sizeof(m));
	UMCHECK((m.VI_attrs & VA_REALIZED) &&
		(m.OLMWI_specState & OMWSS_IN_STAY_UP_MODE));
	UMCHECK(m.OLWI_focusExcl.FTVMC_OD == @UMCopy);
	VisData(@UMMenuPrim, &w, sizeof(w));
	UMCHECK(w.OLWI_focusExcl.FTVMC_OD == @UMEditMenu);
	/* (the sub menu's button: the Edit menu built now) */
	VisData(@UMMoreMenu, &m, sizeof(m));
	mb = ConstructOptr(OptrToHandle(@UMMoreMenu), m.OLPWI_button);
	UMCHECK(m.OLPWI_button != 0);
	/* down, up */
	UMCHECK(@call UMEditMenu::MSG_META_FUP_KBD_CHAR(K(VC_DOWN),
							CF_FIRST_PRESS, 0));
	VisData(@UMEditMenu, &m, sizeof(m));
	UMCHECK(m.OLWI_focusExcl.FTVMC_OD == mb);
	/* right on the sub menu's button: the sub menu up; left back */
	UMCHECK(@call mb::MSG_META_FUP_KBD_CHAR(K(VC_RIGHT), CF_FIRST_PRESS,
						0));
	VisData(@UMMoreMenu, &m, sizeof(m));
	UMCHECK(m.VI_attrs & VA_REALIZED);
	VisData(mb, &b, sizeof(b));
	UMCHECK(b.OLMBI_specState & OLMBSS_POPUP_OPEN);
	UMCHECK(@call UMMoreMenu::MSG_META_FUP_KBD_CHAR(K(VC_LEFT),
							CF_FIRST_PRESS, 0));
	VisData(@UMMoreMenu, &m, sizeof(m));
	UMCHECK(!(m.VI_attrs & VA_REALIZED));
	VisData(mb, &b, sizeof(b));
	UMCHECK(!(b.OLMBI_specState & OLMBSS_POPUP_OPEN));
	VisData(@UMEditMenu, &m, sizeof(m));
	UMCHECK((m.VI_attrs & VA_REALIZED) && m.OLWI_focusExcl.FTVMC_OD == mb);
	UMCHECK(@call UMEditMenu::MSG_META_FUP_KBD_CHAR(K(VC_UP),
							CF_FIRST_PRESS, 0));
	VisData(@UMEditMenu, &m, sizeof(m));
	UMCHECK(m.OLWI_focusExcl.FTVMC_OD == @UMCopy);
	/* right: the View menu up, Edit down */
	UMCHECK(@call UMEditMenu::MSG_META_FUP_KBD_CHAR(K(VC_RIGHT),
							CF_FIRST_PRESS, 0));
	VisData(@UMEditMenu, &m, sizeof(m));
	UMCHECK(!(m.VI_attrs & VA_REALIZED));
	VisData(@UMViewMenu, &m, sizeof(m));
	UMCHECK((m.VI_attrs & VA_REALIZED) &&
		(m.OLMWI_specState & OMWSS_IN_STAY_UP_MODE));
	VisData(vb, &b, sizeof(b));
	UMCHECK(b.OLMBI_specState & OLMBSS_POPUP_OPEN);
	/* Escape: down */
	UMCHECK(@call UMViewMenu::MSG_META_FUP_KBD_CHAR(K(VC_ESCAPE),
							CF_FIRST_PRESS, 0));
	VisData(@UMViewMenu, &m, sizeof(m));
	UMCHECK(!(m.VI_attrs & VA_REALIZED));
	VisData(vb, &b, sizeof(b));
	UMCHECK(!(b.OLMBI_specState & OLMBSS_POPUP_OPEN));
	@call UMMenuPrim::MSG_GEN_SET_NOT_USABLE(VUM_NOW);
#undef K
	break;
    }
    case 23: {
	/* mnemonics: Alt+V opens the View menu (through the menu bar,
	 * which takes a mnemonic with Alt); Escape closes it (the focus
	 * before the menu comes back queued: step 24) */
	OLMenuWinInstance m;
	OLMenuButtonInstance b;
	optr vb;

	@call UMMenuPrim::MSG_GEN_SET_USABLE(VUM_NOW);
	VisData(@UMViewMenu, &m, sizeof(m));
	vb = ConstructOptr(OptrToHandle(@UMViewMenu), m.OLPWI_button);
	UMCHECK(UMPress(@UMMenuPrim, UM_K(VC_LALT), SS_LALT << 8));
	UMCHECK(UMPress(@UMMenuPrim, 'v', SS_LALT << 8));
	(void) @call UMMenuPrim::MSG_META_FUP_KBD_CHAR(UM_K(VC_LALT),
						       CF_RELEASE, 0);
	VisData(@UMViewMenu, &m, sizeof(m));
	UMCHECK((m.VI_attrs & VA_REALIZED) &&
		(m.OLMWI_specState & OMWSS_IN_STAY_UP_MODE));
	VisData(vb, &b, sizeof(b));
	UMCHECK(b.OLMBI_specState & OLMBSS_POPUP_OPEN);
	UMCHECK(UMPress(@UMViewMenu, UM_K(VC_ESCAPE), 0));
	VisData(@UMViewMenu, &m, sizeof(m));
	UMCHECK(!(m.VI_attrs & VA_REALIZED));
	break;
    }
    case 24: {
	/* the focus back where it was: not in the menu bar, no menu in
	 * stay up mode, so V alone does nothing; Alt alone puts the
	 * focus in the menu bar, then V alone opens the menu; Escape */
	OLWinInstance w;
	OLMenuWinInstance m;

	VisData(@UMMenuPrim, &w, sizeof(w));
	UMCHECK(!(w.OLWI_focusExcl.FTVMC_flags & MAEF_OD_IS_MENU_RELATED));
	UMCHECK(!(w.OLWI_menuState & OLWMS_HAS_MENU_IN_STAY_UP_MODE));
	(void) UMPress(@UMMenuPrim, 'v', 0);
	VisData(@UMViewMenu, &m, sizeof(m));
	UMCHECK(!(m.VI_attrs & VA_REALIZED));
	UMCHECK(UMPress(@UMMenuPrim, UM_K(VC_LALT), 0));
	UMCHECK(@call UMMenuPrim::MSG_META_FUP_KBD_CHAR(UM_K(VC_LALT),
							CF_RELEASE, 0));
	UMCHECK(@call UMMenuPrim::MSG_OL_WIN_QUERY_MENU_BAR_HAS_FOCUS());
	UMCHECK(UMPress(@UMMenuPrim, 'V', SS_LSHIFT << 8));
	VisData(@UMViewMenu, &m, sizeof(m));
	UMCHECK(m.VI_attrs & VA_REALIZED);
	UMCHECK(UMPress(@UMViewMenu, UM_K(VC_ESCAPE), 0));
	break;
    }
    case 25: {
	/* Alt alone: the menu bar; down opens Edit (Copy the focus); in
	 * it C activates Copy (the action arrives, the test waits for
	 * it), M opens the sub menu; Escape in the sub menu closes both */
	OLMenuWinInstance m;

	UMCHECK(UMPress(@UMMenuPrim, UM_K(VC_LALT), 0));
	UMCHECK(@call UMMenuPrim::MSG_META_FUP_KBD_CHAR(UM_K(VC_LALT),
							CF_RELEASE, 0));
	UMCHECK(@call UMMenuPrim::MSG_OL_WIN_QUERY_MENU_BAR_HAS_FOCUS());
	UMCHECK(UMPress(@UMMenuPrim, UM_K(VC_DOWN), 0));
	VisData(@UMEditMenu, &m, sizeof(m));
	UMCHECK((m.VI_attrs & VA_REALIZED) &&
		m.OLWI_focusExcl.FTVMC_OD == @UMCopy);
	UMCHECK(UMPress(@UMEditMenu, 'c', 0));
	UMCHECK(UMPress(@UMEditMenu, 'm', 0));
	VisData(@UMMoreMenu, &m, sizeof(m));
	UMCHECK(m.VI_attrs & VA_REALIZED);
	UMCHECK(UMPress(@UMMoreMenu, UM_K(VC_ESCAPE), 0));
	VisData(@UMMoreMenu, &m, sizeof(m));
	UMCHECK(!(m.VI_attrs & VA_REALIZED));
	VisData(@UMEditMenu, &m, sizeof(m));
	UMCHECK(!(m.VI_attrs & VA_REALIZED));
	break;
    }
    case 26: {
	/* the focus back out of the menu bar; not usable */
	OLWinInstance w;

	VisData(@UMMenuPrim, &w, sizeof(w));
	UMCHECK(!(w.OLWI_focusExcl.FTVMC_flags & MAEF_OD_IS_MENU_RELATED));
	@call UMMenuPrim::MSG_GEN_SET_NOT_USABLE(VUM_NOW);
	break;
    }
    case 27: {
	/* the window icon: the primary minimized makes a GenPrimary with
	 * HINT_WIN_ICON under the application, built as an OLWinIcon on
	 * the field for this primary, with the focus; its caption below
	 * it in a window of its own (the glyph) */
	OLBaseWinInstance b;
	OLWinIconInstance ic;
	OLWinGlyphDisplayInstance g;
	optr icon, glyph;

	@call umApp::MSG_GEN_ADD_CHILD(@UMIconPrim, CCO_LAST);
	@call UMIconPrim::MSG_GEN_SET_USABLE(VUM_NOW);
	@call UMIconPrim::MSG_GEN_DISPLAY_SET_MINIMIZED();
	VisData(@UMIconPrim, &b, sizeof(b));
	UMCHECK(!(b.VI_attrs & VA_REALIZED));
	icon = b.OLMDWI_icon;
	UMCHECK(icon != 0);
	if (!icon)
	    break;
	UMCHECK(InClass(icon, (ClassStruct *) &GenPrimaryClass) &&
		InClass(icon, (ClassStruct *) &OLWinIconClass));
	UMCHECK(GenFindParent(icon) == umApp);
	VisData(icon, &ic, sizeof(ic));
	UMCHECK(ic.OLWII_window == @UMIconPrim);
	UMCHECK(ic.OLWI_type == MOWT_WINDOW_ICON &&
		(ic.OLWI_fixedAttr & OWFA_IS_WIN_ICON));
	UMCHECK((ic.VI_attrs & VA_REALIZED) && ic.VCI_window);
	UMCHECK(ic.OLWII_iconMoniker != 0 && ic.OLWII_iconCaptionMoniker != 0);
	/* the size of its picture */
	UMCHECK(ic.VI_bounds.R_right - ic.VI_bounds.R_left == 16 &&
		ic.VI_bounds.R_bottom - ic.VI_bounds.R_top == 16);
	UMCHECK(VisFindParent(icon) == umApp);
	glyph = ConstructOptr(OptrToHandle(icon), ic.OLWII_titleGlyphWin);
	UMCHECK(ic.OLWII_titleGlyphWin != 0);
	VisData(glyph, &g, sizeof(g));
	UMCHECK((g.VI_attrs & VA_REALIZED) && g.VCI_window);
	UMCHECK(g.OLWGDI_icon == OptrToChunk(icon) &&
		g.OLWGDI_glyph == ic.OLWII_iconCaptionMoniker);
	/* centered below the icon */
	UMCHECK(g.VI_bounds.R_top == ic.VI_bounds.R_bottom + 3);
	UMCHECK(((g.VI_bounds.R_left + g.VI_bounds.R_right) >> 1) -
		((ic.VI_bounds.R_left + ic.VI_bounds.R_right) >> 1) <= 1 &&
		((ic.VI_bounds.R_left + ic.VI_bounds.R_right) >> 1) -
		((g.VI_bounds.R_left + g.VI_bounds.R_right) >> 1) <= 1);
	/* the focus (the caption inverted: the test looks) */
	UMCHECK(ic.OLWI_focusExcl.FTVMC_flags & HGF_SYS_EXCL);
	umState.UMS_iconX = ic.VI_bounds.R_left;
	umState.UMS_iconY = ic.VI_bounds.R_top;
	umState.UMS_markX = g.VI_bounds.R_left;
	umState.UMS_markY = g.VI_bounds.R_top;
	/* the primary told where the icon is */
	VisData(@UMIconPrim, &b, sizeof(b));
	UMCHECK(b.OLMDWI_iconPosLeft == ic.VI_bounds.R_left &&
		b.OLMDWI_iconPosTop == ic.VI_bounds.R_top);
	break;
    }
    case 28: {
	/* Enter on the icon restores the primary (queued) */
	OLBaseWinInstance b;

	VisData(@UMIconPrim, &b, sizeof(b));
	UMCHECK(UMPress(b.OLMDWI_icon, UM_K(VC_ENTER), 0));
	break;
    }
    case 29: {
	/* restored: the primary open again, the icon not realizable (its
	 * glyph gone) */
	OLBaseWinInstance b;
	OLWinIconInstance ic;

	VisData(@UMIconPrim, &b, sizeof(b));
	UMCHECK(!(b.OLWI_specState & OLWSS_MINIMIZED) &&
		(b.VI_attrs & VA_REALIZED));
	VisData(b.OLMDWI_icon, &ic, sizeof(ic));
	UMCHECK(!(ic.VI_attrs & VA_REALIZED) && !(ic.VI_specAttrs &
						  SA_REALIZABLE));
	UMCHECK(ic.OLWII_titleGlyphWin == 0);
	/* minimized again: the same icon, at the same place */
	@call UMIconPrim::MSG_GEN_DISPLAY_SET_MINIMIZED();
	VisData(@UMIconPrim, &b, sizeof(b));
	VisData(b.OLMDWI_icon, &ic, sizeof(ic));
	UMCHECK((ic.VI_attrs & VA_REALIZED) && ic.OLWII_titleGlyphWin != 0);
	UMCHECK(ic.VI_bounds.R_left == b.OLMDWI_iconPosLeft &&
		ic.VI_bounds.R_top == b.OLMDWI_iconPosTop);
	/* not usable: the icon goes too */
	@call UMIconPrim::MSG_GEN_SET_NOT_USABLE(VUM_NOW);
	VisData(b.OLMDWI_icon, &ic, sizeof(ic));
	UMCHECK(!(ic.VI_attrs & VA_REALIZED));
	break;
    }
    }
}

void UMStep(word step)
{
    optr p = ConstructOptr(umState.UMS_process, 0);

    @call p::MSG_UM_STEP(step);
}
