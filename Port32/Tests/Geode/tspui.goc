/*
 * tspui.goc -- a specific UI library for the library.ui.gen,
 * library.ui.system and library.ui.app tests (Port32/Tests): what the
 * generic objects of uigen, uisys, uahost and uiapp are built into.
 * Each build routine counts its calls in tspState and gives a class:
 * TSButtonClass for a trigger, TSWinClass for a display, TSAppClass for
 * the application, TSFieldClass, TSScreenClass and TSSystemClass for
 * the field, screen and system.  The buttons count their drawings, the
 * others the messages they get.
 */
@include <stdapp.goh>
@include <Objects/vCompC.goh>
@include <Objects/gSysC.goh>
@include <Objects/gFieldC.goh>
@include <Objects/gScrnC.goh>
#include <Internal/specUI.h>
#include <Internal/videoDr.h>
#include <geosdriver.h>
#include <stdint.h>
@include "tspui.goh"

@classdecl TSWinClass;
@classdecl TSButtonClass;
@classdecl TSAppClass;
@classdecl TSFieldClass;
@classdecl TSScreenClass;
@classdecl TSSystemClass;

TSState tspState;

ClassStruct *TSBuildTrigger(optr oself, word masterOffset)
{
    (void) oself;
    (void) masterOffset;
    tspState.TSS_builds[0]++;
    return &TSButtonClass;
}

ClassStruct *TSBuildDisplay(optr oself, word masterOffset)
{
    (void) oself;
    (void) masterOffset;
    tspState.TSS_builds[1]++;
    return &TSWinClass;
}

ClassStruct *TSBuildApplication(optr oself, word masterOffset)
{
    (void) oself;
    (void) masterOffset;
    tspState.TSS_builds[2]++;
    return &TSAppClass;
}

ClassStruct *TSBuildField(optr oself, word masterOffset)
{
    (void) oself;
    (void) masterOffset;
    tspState.TSS_sysBuilds[0]++;
    return &TSFieldClass;
}

ClassStruct *TSBuildScreen(optr oself, word masterOffset)
{
    (void) oself;
    (void) masterOffset;
    tspState.TSS_sysBuilds[1]++;
    return &TSScreenClass;
}

ClassStruct *TSBuildSystem(optr oself, word masterOffset)
{
    (void) oself;
    (void) masterOffset;
    tspState.TSS_sysBuilds[2]++;
    return &TSSystemClass;
}

/* the root window's video functions: the pointer shown and hidden */
static Boolean TSRootStrategy(word function, DriverRegs *r)
{
    (void) r;
    if (function == DR_VID_SHOWPTR)
	tspState.TSS_ptrShows++;
    else if (function == DR_VID_HIDEPTR)
	tspState.TSS_ptrHides++;
    return FALSE;
}

/* the screen made usable: its root window, as OLScreen's build opens
 * one (the test's, else one on TSRootStrategy), registered with the UI */
@method TSScreenClass, MSG_SPEC_SET_USABLE
{
    GeodeHandle driver;

    (void) updateMode;
    tspState.TSS_screenBuilds++;
    driver = ((GenScreenInstance *) ObjDerefGen(oself))->GSCI_videoDriver;
    if (!tspState.TSS_root) {
	tspState.TSS_root = WinOpen(0, 0, 0, WCF_PLAIN | CMT_CLOSEST,
				    C_DARK_GRAY, 0, 0, WPF_ROOT, 0, 0, NULL,
				    0, 0, 639, 479);
	WinSetInfo(tspState.TSS_root, WIT_STRATEGY,
		   (optr) (uintptr_t) (void *) TSRootStrategy);
    }
    UserScreenRegister(tspState.TSS_root, driver);
}

@method TSFieldClass, MSG_META_ATTACH
{
    tspState.TSS_fieldAttaches++;
    @callsuper();
}

@method TSFieldClass, MSG_META_DETACH
{
    tspState.TSS_fieldDetaches++;
    @callsuper();
}

@method TSFieldClass, MSG_GEN_FIELD_ORDER_GEN_APPLICATION_LIST
{
    tspState.TSS_orders++;
}

@method TSFieldClass, MSG_GEN_FIELD_ABOUT_TO_DETACH_COMPLETE
{
    tspState.TSS_aboutToDetach++;
}

@method TSSystemClass, MSG_META_MUP_ALTER_FTVMC_EXCL
{
    (void) objectWantingControl;
    (void) flags;
    tspState.TSS_sysExcls++;
}

@method TSSystemClass, MSG_GEN_SYSTEM_MARK_BUSY
{
    tspState.TSS_busy++;
}

@method TSSystemClass, MSG_GEN_SYSTEM_MARK_NOT_BUSY
{
    tspState.TSS_notBusy++;
}

/* the system's focus: none here, the event counted */
@method TSSystemClass, MSG_META_SEND_CLASSED_EVENT
{
    if ((word) whereTo == TO_FOCUS) {
	tspState.TSS_sysFocusEvents++;
	ObjFreeMessage(event);
	return;
    }
    @callsuper();
}

@method TSAppClass, MSG_META_APP_STARTUP
{
    tspState.TSS_appStartups++;
    @callsuper();
}

@method TSAppClass, MSG_META_ATTACH_OBJECT
{
    tspState.TSS_appAttaches++;
    @callsuper();
}

@method TSAppClass, MSG_GEN_APPLICATION_OPEN_COMPLETE
{
    tspState.TSS_appOpenCompletes++;
}

@method TSAppClass, MSG_GEN_BRING_TO_TOP
{
    tspState.TSS_appToTop++;
}

@method TSAppClass, MSG_GEN_APPLICATION_MARK_APP_COMPLETELY_BUSY
{
    tspState.TSS_appBusy++;
}

@method TSAppClass, MSG_GEN_APPLICATION_MARK_APP_NOT_COMPLETELY_BUSY
{
    tspState.TSS_appNotBusy++;
}

@method TSAppClass, MSG_GEN_APPLICATION_DETACH_PENDING
{
    tspState.TSS_appDetachPending++;
}

@method TSAppClass, MSG_GEN_APPLICATION_CLOSE_COMPLETE
{
    (void) ackOD;
    tspState.TSS_appCloseCompletes++;
}

@method TSAppClass, MSG_META_APP_SHUTDOWN
{
    tspState.TSS_appShutdowns++;
    @callsuper();
}

@method TSAppClass, MSG_GEN_APPLICATION_IGNORE_INPUT
{
    tspState.TSS_appIgnoreInput++;
}

/* a window and win group, attached and realizable from the start (the
 * application's attach does it in a real UI) */
@method TSWinClass, MSG_META_INITIALIZE
{
    @callsuper();
    pself = ObjDerefVis(oself);
    pself->VI_typeFlags |= VTF_IS_COMPOSITE | VTF_IS_WINDOW |
			   VTF_IS_WIN_GROUP;
    pself->VI_specAttrs |= SA_ATTACHED | SA_REALIZABLE;
    pself->VI_bounds.R_left = 20;
    pself->VI_bounds.R_top = 20;
    pself->VI_bounds.R_right = 220;
    pself->VI_bounds.R_bottom = 120;
    pself->VCI_geoAttrs |= VCGA_CUSTOM_MANAGE_CHILDREN;
}

@method TSWinClass, MSG_VIS_OPEN_WIN
{
    Rectangle b = pself->VI_bounds;

    pself->VCI_window = WinOpen(parentWindow ? parentWindow
					     : tspState.TSS_root,
				oself, oself, CMT_CLOSEST, C_WHITE, 0, 0, 0,
				0, 0, NULL, b.R_left, b.R_top, b.R_right - 1,
				b.R_bottom - 1);
    tspState.TSS_win = pself->VCI_window;
}

@method TSWinClass, MSG_VIS_CLOSE_WIN
{
    @callsuper();
    tspState.TSS_win = 0;
}

/* placed by their number: 50 apart */
@method TSButtonClass, MSG_META_INITIALIZE
{
    word n = tspState.TSS_buttons++;

    @callsuper();
    pself = ObjDerefVis(oself);
    pself->TSBI_which = n;
}

@method TSButtonClass, MSG_SPEC_BUILD
{
    word x;

    @callsuper();
    pself = ObjDerefVis(oself);
    x = (word) (10 + 50 * pself->TSBI_which);
    pself->VI_bounds.R_left = (sword) x;
    pself->VI_bounds.R_top = 10;
    pself->VI_bounds.R_right = (sword) (x + 40);
    pself->VI_bounds.R_bottom = 30;
}

@method TSButtonClass, MSG_VIS_DRAW
{
    Boolean en = (pself->VI_attrs & VA_FULLY_ENABLED) != 0;

    (void) drawFlags;
    GrSetAreaColor(gstate, CF_INDEX, en ? C_BLACK : C_LIGHT_GRAY, 0, 0);
    GrFillRect(gstate, pself->VI_bounds.R_left, pself->VI_bounds.R_top,
	       pself->VI_bounds.R_right, pself->VI_bounds.R_bottom);
    if (pself->TSBI_which < 3)
	tspState.TSS_draws[pself->TSBI_which]++;
    if (!en)
	tspState.TSS_greyDraws++;
}

@method TSButtonClass, MSG_SPEC_UPDATE_VIS_MONIKER
{
    tspState.TSS_monikers++;
    @callsuper();
}
