/*
 * tspui.goh -- the specific UI library of the library.ui.gen,
 * library.ui.system and library.ui.app tests (Port32/Tests): the state the tests, uigen and
 * uisys share with it.
 */
@deflib tspui

typedef struct {
    WindowHandle	TSS_root;	/* the root window, from the test */
    WindowHandle	TSS_win;	/* the display's window */
    word		TSS_builds[3];	/* trigger, display, application */
    word		TSS_draws[3];	/* the buttons, by TSBI_which */
    word		TSS_greyDraws;	/* drawn not enabled */
    word		TSS_monikers;	/* MSG_SPEC_UPDATE_VIS_MONIKER */
    word		TSS_buttons;	/* buttons made */
    word		TSS_sysBuilds[3];	/* field, screen, system */
    word		TSS_fieldAttaches;	/* MSG_META_ATTACH */
    word		TSS_orders;	/* ORDER_GEN_APPLICATION_LIST */
    word		TSS_aboutToDetach;	/* ABOUT_TO_DETACH_COMPLETE */
    word		TSS_fieldDetaches;	/* MSG_META_DETACH */
    word		TSS_sysExcls;	/* the system's MUP_ALTER_FTVMC_EXCL */
    word		TSS_busy, TSS_notBusy;	/* the system's MARK_(NOT_)BUSY */
    word		TSS_sysFocusEvents;	/* classed events TO_FOCUS */
    /* the application's specific part (library.ui.app) */
    word		TSS_appStartups;	/* MSG_META_APP_STARTUP */
    word		TSS_appAttaches;	/* MSG_META_ATTACH */
    word		TSS_appOpenCompletes;	/* ..._OPEN_COMPLETE */
    word		TSS_appToTop;		/* MSG_GEN_BRING_TO_TOP */
    word		TSS_appBusy, TSS_appNotBusy;	/* MARK_APP_(NOT_)
						 * COMPLETELY_BUSY */
    word		TSS_appDetachPending;	/* ..._DETACH_PENDING */
    word		TSS_appCloseCompletes;	/* ..._CLOSE_COMPLETE */
    word		TSS_appShutdowns;	/* MSG_META_APP_SHUTDOWN */
    word		TSS_appIgnoreInput;	/* ..._IGNORE_INPUT */
    word		TSS_screenBuilds;	/* screens made usable: */
    /* registered with the UI (UserScreenRegister) on TSS_root (made
     * then if not set, on the counting video functions below) */
    word		TSS_ptrShows, TSS_ptrHides;
} TSState;

extern TSState tspState;

/* a generic display: a window and win group on the test's root */
@class TSWinClass, VisCompClass;
@endc

/* a generic trigger: a 40x20 rectangle, black if enabled, grey if not */
@class TSButtonClass, VisClass;
    @instance word TSBI_which = 0;
@endc

/* the application: a composite above the displays, which counts what
 * the generic application tells it */
@class TSAppClass, VisCompClass;
    @uses GenApplicationClass;
@endc

/* a field, a screen and the system: composites that count */
@class TSFieldClass, VisCompClass;
    @uses GenFieldClass;
@endc

@class TSScreenClass, VisCompClass;
@endc

@class TSSystemClass, VisCompClass;
    @uses GenSystemClass;
@endc

@endlib
