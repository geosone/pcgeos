/*
 * uahost.goc -- a process geode for the library.ui.app test
 * (Port32/Tests): it checks the system that the UI's process (UserClass)
 * started, and launches the application uiapp (uiapp.goc) through the
 * UI (UserLoadApplication) with itself as the AppLaunchBlock's
 * acknowledgement output: it gets the load's acknowledgement, and uiapp
 * reports what happens to it here (MSG_META_NOTIFY).  On
 * GCNSLT_APPLICATION it hears of the applications that start and exit.
 * The test (test_ui_app.c) runs the steps through UAHostStep on the
 * process thread; the checks made here count in uaHostState.
 */
@include <stdapp.goh>
@include <Objects/gSysC.goh>
@include <Objects/gFieldC.goh>
#include <sysstats.h>
#include <string.h>
@include "uiapp.goh"

typedef struct {
    GeodeHandle	UAH_process;
    word	UAH_attached;
    word	UAH_checks, UAH_fails, UAH_failLine;
    word	UAH_events[UAE_COUNT];	/* uiapp's reports */
    word	UAH_lastData[UAE_COUNT];
    word	UAH_loads;		/* MSG_UA_HOST_LOADED */
    GeodeHandle	UAH_loaded;		/* its geode */
    word	UAH_loadError, UAH_loadID;
    GeodeHandle	UAH_app;		/* the launched process */
    word	UAH_acks;		/* MSG_META_ACK of the UI's detach */
    word	UAH_started, UAH_exited;	/* GCNSLT_APPLICATION */
    GeodeHandle	UAH_lastExited;
    word	UAH_failLines[8];
} UAHostState;

UAHostState uaHostState;

#define UACHECK(c) \
    do { uaHostState.UAH_checks++; if (!(c)) { \
	if (uaHostState.UAH_fails < 8) \
	    uaHostState.UAH_failLines[uaHostState.UAH_fails] = __LINE__; \
	uaHostState.UAH_fails++; \
	if (!uaHostState.UAH_failLine) uaHostState.UAH_failLine = __LINE__; } \
    } while (0)

@class UAHostClass, ProcessClass;
    @message void MSG_UA_HOST_STEP(word step);
    /* the load's acknowledgement (LoadApplication) */
    @message void MSG_UA_HOST_LOADED(GeodeHandle geode, word error,
				     word ackID);
@endc
@classdecl UAHostClass, neverSaved;

#define LOAD_ID		0x1234

static optr Self(void)
{
    return ConstructOptr(uaHostState.UAH_process, 0);
}

@method UAHostClass, MSG_META_ATTACH_PROCESS
{
    (void) value1;
    (void) value2;
    uaHostState.UAH_process = GeodeGetProcessHandle();
    uaHostState.UAH_attached++;
}

/* uiapp's reports */
@method UAHostClass, MSG_META_NOTIFY
{
    if (manufID != MANUFACTURER_ID_GEOWORKS || notificationType >= UAE_COUNT)
	return;
    uaHostState.UAH_events[notificationType]++;
    uaHostState.UAH_lastData[notificationType] = data;
}

@method UAHostClass, MSG_UA_HOST_LOADED
{
    uaHostState.UAH_loads++;
    uaHostState.UAH_loaded = geode;
    uaHostState.UAH_loadError = error;
    uaHostState.UAH_loadID = ackID;
}

/* the UI's detach is done */
@method UAHostClass, MSG_META_ACK
{
    (void) callerID;
    (void) caller;
    uaHostState.UAH_acks++;
}

@method UAHostClass, MSG_NOTIFY_APP_STARTED
{
    (void) appStarted;
    uaHostState.UAH_started++;
}

@method UAHostClass, MSG_NOTIFY_APP_EXITED
{
    uaHostState.UAH_exited++;
    uaHostState.UAH_lastExited = (GeodeHandle) appExited;
}

/* a copy of an object's Gen part */
static void GenData(optr o, void *buf, word size)
{
    ObjLockObjBlock(OptrToHandle(o));
    memcpy(buf, ObjDerefGen(o), size);
    MemUnlock(OptrToHandle(o));
}

/* the number of entries of a list chunk of the field, the first one */
static word ListOf(optr field, ChunkHandle ch, void *first, word size)
{
    word n = 0;

    ObjLockObjBlock(OptrToHandle(field));
    if (ch) {
	optr l = ConstructOptr(OptrToHandle(field), ch);
	n = LMemGetChunkSize(l) / size;
	if (n)
	    memcpy(first, LMemDeref(l), size);
    }
    MemUnlock(OptrToHandle(field));
    return n;
}

static optr DefaultField(void)
{
    optr f = NullOptr;

    UserCallSystem(MSG_GEN_SYSTEM_GET_DEFAULT_FIELD, NULL, 0, &f, sizeof(f));
    return f;
}

static GeodeHandle UIProcess(void)
{
    return (GeodeHandle) SysGetInfo(SGIT_UI_PROCESS);
}

/* through the UI, with this process as the acknowledgement output */
static GeodeHandle Launch(AppLaunchFlags flags)
{
    MemHandle alb;
    AppLaunchBlock *a;
    GeodeLoadError e;
    GeodeHandle gh;

    alb = MemAlloc(sizeof(AppLaunchBlock), HF_SHARABLE | HF_SWAPABLE,
		   HAF_ZERO_INIT);
    a = MemLock(alb);
    a->ALB_userLoadAckOutput = Self();
    a->ALB_userLoadAckMessage = MSG_UA_HOST_LOADED;
    a->ALB_userLoadAckID = LOAD_ID;
    MemUnlock(alb);
    gh = UserLoadApplication(flags, MSG_GEN_PROCESS_OPEN_APPLICATION, alb,
			     "uiapp", 0, &e);
    UACHECK(gh != 0);
    uaHostState.UAH_app = gh;
    return gh;
}

/* the application up on the default field, the UI its parent */
static void CheckUp(GeodeHandle gh)
{
    optr app = GeodeGetAppObject(gh), first = NullOptr;
    optr field = DefaultField();
    GenFieldInstance f;
    GeodeHandle p = 0;
    ApplicationStates as;

    UACHECK(OptrToHandle(app) != 0);
    GenData(field, &f, sizeof(f));
    UACHECK(ListOf(field, f.GFI_genApplications, &first, sizeof(optr)) == 1
	    && first == app);
    UACHECK(ListOf(field, f.GFI_processes, &p, sizeof(p)) == 1 && p == gh);
    UACHECK(f.GFI_numAttachingApps == 0);
    UACHECK(@call app::MSG_GEN_GET_USABLE());
    UACHECK(@call app::MSG_GEN_FIND_PARENT() == field);
    UACHECK(@call ConstructOptr(gh, 0)::MSG_GEN_PROCESS_GET_PARENT_FIELD()
	    == field);
    UACHECK(@call app::MSG_GEN_APPLICATION_GET_APP_MODE_MESSAGE() ==
	    MSG_GEN_PROCESS_OPEN_APPLICATION);
    as = @call app::MSG_GEN_APPLICATION_GET_STATE();
    UACHECK(!(as & (AS_ATTACHING | AS_QUITTING | AS_DETACHING)));
    UACHECK(as & AS_SINGLE_INSTANCE);
}

/* no application on the default field */
static void CheckGone(void)
{
    optr field = DefaultField(), first;
    GenFieldInstance f;
    GeodeHandle p;

    GenData(field, &f, sizeof(f));
    UACHECK(!ListOf(field, f.GFI_genApplications, &first, sizeof(optr)));
    UACHECK(!ListOf(field, f.GFI_processes, &p, sizeof(p)));
}

/* the system the UI started: two fields (its own, the system field), a
 * screen, the UI's application below the screen */
static void CheckSystem(void)
{
    GeodeHandle ui = UIProcess();
    optr screen = NullOptr, field = DefaultField(), own = NullOptr;
    optr uiApp = GeodeGetAppObject(ui);
    word n = 0;
    GenFieldInstance f;

    UACHECK(ui && ui == GeodeFind("ui      ", GEODE_NAME_SIZE, 0, 0));
    UACHECK(GeodeGetInfo(ui, GGIT_ATTRIBUTES, NULL) & GA_PROCESS);
    UACHECK(UserCallSystem(MSG_GEN_COUNT_CHILDREN, NULL, 0, &n, sizeof(n)));
    UACHECK(n == 2);
    UserCallSystem(MSG_GEN_SYSTEM_GET_DEFAULT_SCREEN, NULL, 0,
		   &screen, sizeof(screen));
    UACHECK(screen != NullOptr);
    GenData(field, &f, sizeof(f));
    UACHECK(f.GFI_flags & GFF_HAS_DEFAULT_LAUNCHER);	/* SystemField0 */
    UACHECK(f.GFI_visParent == screen);
    UACHECK(@call field::MSG_GEN_GET_USABLE());
    /* the system field first (attached last), the UI's own field next,
     * telling the UI's process */
    UserCallSystem(MSG_GEN_FIND_CHILD_AT_POSITION, &(word) { 0 },
		   sizeof(word), &own, sizeof(own));
    UACHECK(own == field);
    UserCallSystem(MSG_GEN_FIND_CHILD_AT_POSITION, &(word) { 1 },
		   sizeof(word), &own, sizeof(own));
    UACHECK(own != NullOptr && own != field);
    GenData(own, &f, sizeof(f));
    UACHECK(f.GFI_notificationDestination == ConstructOptr(ui, 0));
    /* its application */
    UACHECK(OptrToHandle(uiApp) != 0);
    UACHECK(@call uiApp::MSG_GEN_GET_USABLE());
    UACHECK(@call uiApp::MSG_GEN_FIND_PARENT() == screen);
    UACHECK(@call uiApp::MSG_GEN_APPLICATION_GET_APP_MODE_MESSAGE() ==
	    MSG_GEN_PROCESS_OPEN_APPLICATION);
}

@method UAHostClass, MSG_UA_HOST_STEP
{
    switch (step) {
    case 1: {
	/* the UI's system; uiapp of execOnStartup on the default field */
	GeodeHandle gh = GeodeFind("uiapp   ", GEODE_NAME_SIZE, 0, 0);
	CheckSystem();
	UACHECK(gh != 0);
	CheckUp(gh);
	GCNListAdd(Self(), MANUFACTURER_ID_GEOWORKS, GCNSLT_APPLICATION);
	/* the user quits it (the test waits for it to go) */
	@send GeodeGetAppObject(gh)::MSG_META_QUIT();
	break;
    }
    case 2:
	/* gone; launched through the UI */
	CheckGone();
	Launch(0);
	break;
    case 3:
	/* up, the load acknowledged; quit (the test waits) */
	CheckUp(uaHostState.UAH_app);
	UACHECK(uaHostState.UAH_loads == 1 &&
		uaHostState.UAH_loaded == uaHostState.UAH_app &&
		uaHostState.UAH_loadError == 0 &&
		uaHostState.UAH_loadID == LOAD_ID);
	@send GeodeGetAppObject(uaHostState.UAH_app)::MSG_META_QUIT();
	break;
    case 4:
	/* gone; again, not on top this time */
	CheckGone();
	Launch(ALF_DO_NOT_OPEN_ON_TOP);
	break;
    case 5:
	/* up; the UI detached (the test waits for its ack) */
	CheckUp(uaHostState.UAH_app);
	@send ConstructOptr(UIProcess(), 0)::MSG_META_DETACH(0, Self());
	break;
    case 6:
	/* the UI's process gone, the library stays; no system */
	UACHECK(!(GeodeGetInfo(GeodeFind("ui      ", GEODE_NAME_SIZE, 0, 0),
			       GGIT_ATTRIBUTES, NULL) & GA_PROCESS));
	UACHECK(!UserCallSystem(MSG_GEN_COUNT_CHILDREN, NULL, 0, NULL, 0));
	GCNListRemove(Self(), MANUFACTURER_ID_GEOWORKS, GCNSLT_APPLICATION);
	break;
    }
}

/* a step on the process thread, from the test (MF_CALL) */
void UAHostStep(word step)
{
    @call ConstructOptr(uaHostState.UAH_process, 0)::MSG_UA_HOST_STEP(step);
}
