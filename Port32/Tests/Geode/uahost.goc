/*
 * uahost.goc -- a process geode for the library.ui.app test
 * (Port32/Tests): it makes the UI's system object (GenSystemClass) with
 * the screen UAScreen and the field UAField, and launches the
 * application uiapp (uiapp.goc) on the field as the UI's
 * UserLoadApplication would: the field told first, an AppLaunchBlock
 * with the field, GeodeLoad.  It is the parent process of uiapp, so it
 * hears of its exit (MSG_PROCESS_NOTIFY_PROCESS_EXIT) and tells the
 * fields, as the UI's process does (UserNotifyProcessExit); uiapp
 * reports what happens to it here (MSG_META_NOTIFY).
 * The test (test_ui_app.c) runs the steps through UAHostStep on the
 * process thread; the checks made here count in uaHostState.
 */
@include <stdapp.goh>
@include <Objects/gSysC.goh>
@include <Objects/gFieldC.goh>
@include <Objects/gScrnC.goh>
#include <Internal/specUI.h>
#include <string.h>
@include "uiapp.goh"

typedef struct {
    GeodeHandle	UAH_process;
    word	UAH_attached;
    word	UAH_checks, UAH_fails, UAH_failLine;
    word	UAH_events[UAE_COUNT];	/* uiapp's reports */
    word	UAH_lastData[UAE_COUNT];
    word	UAH_exits;		/* MSG_PROCESS_NOTIFY_PROCESS_EXIT */
    GeodeHandle	UAH_app;		/* the launched process */
    word	UAH_acks;		/* UANotify: MSG_META_ACK */
    word	UAH_fieldDetached;	/* MSG_META_FIELD_NOTIFY_DETACH */
    word	UAH_failLines[8];
} UAHostState;

UAHostState uaHostState;

#define UACHECK(c) \
    do { uaHostState.UAH_checks++; if (!(c)) { \
	if (uaHostState.UAH_fails < 8) \
	    uaHostState.UAH_failLines[uaHostState.UAH_fails] = __LINE__; \
	uaHostState.UAH_fails++; \
	if (!uaHostState.UAH_failLine) uaHostState.UAH_failLine = __LINE__; } \
    } while (0)

@class UAHostClass, ProcessClass;
    @message void MSG_UA_HOST_STEP(word step);
@endc
@classdecl UAHostClass, neverSaved;

@class UANotifyClass, MetaClass;
@endc
@classdecl UANotifyClass;

@method UANotifyClass, MSG_META_ACK
{
    (void) callerID;
    (void) caller;
    uaHostState.UAH_acks++;
}

@method UANotifyClass, MSG_META_FIELD_NOTIFY_DETACH
{
    (void) field;
    (void) shutdownFlag;
    uaHostState.UAH_fieldDetached++;
}

@start UAHostObjects;
@object GenScreenClass UAScreen = {
}
@object GenFieldClass UAField = {
    GFI_notificationDestination = @UANotify;
}
@object UANotifyClass UANotify = {
}
@end UAHostObjects;

static optr uaSystem;

@method UAHostClass, MSG_META_ATTACH_PROCESS
{
    (void) value1;
    (void) value2;
    uaHostState.UAH_process = GeodeGetProcessHandle();
    uaHostState.UAH_attached++;
}

/* uiapp's reports */
@method UAHostClass, MSG_META_NOTIFY
{
    if (manufID != MANUFACTURER_ID_GEOWORKS || notificationType >= UAE_COUNT)
	return;
    uaHostState.UAH_events[notificationType]++;
    uaHostState.UAH_lastData[notificationType] = data;
}

/* UserNotifyProcessExit: the fields hear of it */
@method UAHostClass, MSG_PROCESS_NOTIFY_PROCESS_EXIT
{
    EventHandle ev;

    (void) exitCode;
    uaHostState.UAH_exits++;
    ev = @record GenFieldClass::MSG_GEN_FIELD_PROCESS_EXIT(exitProcess);
    UserCallSystem(MSG_GEN_SEND_TO_CHILDREN, &ev, sizeof(ev), NULL, 0);
}

/* a copy of the object's Gen part (its block is ours) */
static void GenData(optr o, void *buf, word size)
{
    ObjLockObjBlock(OptrToHandle(o));
    memcpy(buf, ObjDerefGen(o), size);
    MemUnlock(OptrToHandle(o));
}

/* the number of entries of a list chunk of the field, the first one */
static word ListOf(ChunkHandle ch, void *first, word size)
{
    word n = 0;

    ObjLockObjBlock(OptrToHandle(@UAField));
    if (ch) {
	optr l = ConstructOptr(OptrToHandle(@UAField), ch);
	n = LMemGetChunkSize(l) / size;
	if (n)
	    memcpy(first, LMemDeref(l), size);
    }
    MemUnlock(OptrToHandle(@UAField));
    return n;
}

/* UserLoadApplication, as far as the test needs it */
static GeodeHandle Launch(AppLaunchFlags flags)
{
    MemHandle alb;
    AppLaunchBlock *a;
    GeodeLoadError e;
    GeodeHandle gh;

    UACHECK(@call UAField::MSG_GEN_FIELD_APP_STARTUP_NOTIFY() == 0);
    alb = MemAlloc(sizeof(AppLaunchBlock), HF_SHARABLE | HF_SWAPABLE,
		   HAF_ZERO_INIT);
    a = MemLock(alb);
    a->ALB_genParent = @UAField;
    a->ALB_launchFlags = flags;
    a->ALB_userLoadAckOutput = ConstructOptr(GeodeGetProcessHandle(), 0);
    MemUnlock(alb);
    gh = GeodeLoad("uiapp", GA_PROCESS, 0, 0, alb, &e);
    UACHECK(gh != 0);
    uaHostState.UAH_app = gh;
    return gh;
}

/* the application up on the field */
static void CheckUp(void)
{
    GeodeHandle gh = uaHostState.UAH_app;
    optr app = GeodeGetAppObject(gh), first = NullOptr;
    GenFieldInstance f;
    GeodeHandle p = 0;
    ApplicationStates as;

    UACHECK(OptrToHandle(app) != 0);
    GenData(@UAField, &f, sizeof(f));
    UACHECK(ListOf(f.GFI_genApplications, &first, sizeof(optr)) == 1 &&
	    first == app);
    UACHECK(ListOf(f.GFI_processes, &p, sizeof(p)) == 1 && p == gh);
    UACHECK(f.GFI_numAttachingApps == 0);
    UACHECK(@call app::MSG_GEN_GET_USABLE());
    UACHECK(@call app::MSG_GEN_FIND_PARENT() == @UAField);
    UACHECK(@call ConstructOptr(gh, 0)::MSG_GEN_PROCESS_GET_PARENT_FIELD()
	    == @UAField);
    UACHECK(@call app::MSG_GEN_APPLICATION_GET_APP_MODE_MESSAGE() ==
	    MSG_GEN_PROCESS_OPEN_APPLICATION);
    as = @call app::MSG_GEN_APPLICATION_GET_STATE();
    UACHECK(!(as & (AS_ATTACHING | AS_QUITTING | AS_DETACHING)));
    UACHECK(as & AS_SINGLE_INSTANCE);
}

/* the application gone from the field */
static void CheckGone(void)
{
    GenFieldInstance f;
    optr first;
    GeodeHandle p;

    GenData(@UAField, &f, sizeof(f));
    UACHECK(!ListOf(f.GFI_genApplications, &first, sizeof(optr)));
    UACHECK(!ListOf(f.GFI_processes, &p, sizeof(p)));
}

@method UAHostClass, MSG_UA_HOST_STEP
{
    switch (step) {
    case 1:
	/* the system, the screen and the field */
	uaSystem = UserCreateSystemObject(OptrToHandle(@UAScreen));
	@call uaSystem::MSG_GEN_SYSTEM_ADD_SCREEN_CHILD(@UAScreen, CCO_LAST);
	@call uaSystem::MSG_GEN_SYSTEM_SET_DEFAULT_SCREEN(@UAScreen);
	@call UAScreen::MSG_GEN_SCREEN_SET_VIDEO_DRIVER(0);
	@call UAField::MSG_GEN_FIELD_SET_VIS_PARENT(@UAScreen);
	@call UAField::MSG_META_ATTACH();
	@call uaSystem::MSG_GEN_SYSTEM_SET_DEFAULT_FIELD(@UAField);
	UACHECK(@call uaSystem::MSG_GEN_COUNT_CHILDREN() == 1);
	break;
    case 2:
	/* uiapp launched (the test waits for it to come up) */
	Launch(0);
	break;
    case 3:
	CheckUp();
	break;
    case 4:
	/* the user quits it (the test waits for the process to go) */
	@send GeodeGetAppObject(uaHostState.UAH_app)::MSG_META_QUIT();
	break;
    case 5:
	CheckGone();
	/* again, not on top this time */
	Launch(ALF_DO_NOT_OPEN_ON_TOP);
	break;
    case 6:
	CheckUp();
	/* the system detaches: the field detaches its applications */
	@send uaSystem::MSG_META_DETACH(0, @UANotify);
	break;
    case 7: {
	/* detached: the field is out of the system, the specific parts
	 * and the specific UI go */
	CheckGone();
	UACHECK(@call uaSystem::MSG_GEN_COUNT_CHILDREN() == 0);
	UACHECK(!@call UAField::MSG_GEN_GET_USABLE());
	ObjLockObjBlock(OptrToHandle(uaSystem));
	GenSpecShrinkBranch(uaSystem);
	GenSpecShrinkBranch(@UAScreen);
	GenSpecShrinkBranch(@UAField);
	MemUnlock(OptrToHandle(uaSystem));
	@call uaSystem::MSG_GEN_SYSTEM_REMOVE_SCREEN_CHILD(@UAScreen);
	UserDestroySystemObject();
	UserFreeSpecificUI();
	break;
    }
    }
}

/* a step on the process thread, from the test (MF_CALL) */
void UAHostStep(word step)
{
    @call ConstructOptr(uaHostState.UAH_process, 0)::MSG_UA_HOST_STEP(step);
}
