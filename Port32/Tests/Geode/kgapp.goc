/*
 * kgapp.goc -- a process geode for the kernel.geode test (Port32/Tests).
 *
 * MSG_META_ATTACH (queued by GeodeLoad) runs on the process thread: it
 * calls a routine of kglib, sends messages to an object of kglib's class
 * in its own object resource, and records what it saw in kgAppState,
 * which the test reads through ProcGetLibraryEntry.  It also reads the
 * optrs goc put into chunks that are not objects (a data resource and a
 * static GCN list), which the loader relocated through their shadows.
 * And it saves objects of its own class and of kglib's to a VM file and
 * reads them again (the classes are exported entries in the file).
 */
@include <stdapp.goh>
@include "kglib.goh"

typedef struct {
    word	KGAS_attached;
    word	KGAS_value1, KGAS_value2;
    int		KGAS_sum;
    word	KGAS_count;
    GeodeHandle	KGAS_process;
    optr	KGAS_appObj;
    ThreadHandle KGAS_thread;
    word	KGAS_chunkRefs;		/* optrs in chunks that were right */
    Boolean	KGAS_gcnFound;
    MemHandle	KGAS_dup;		/* ObjDuplicateResource of KGTemplate */
    word	KGAS_dupChecks;		/* checks of the copies that were right */
    word	KGAS_vmChecks;		/* checks of objects in a VM file */
} KGAppState;

/* a structure with an optr behind a word (padding before it) */
typedef struct {
    word	KGP_tag;
    optr	KGP_obj;
    optr	KGP_none;
} KGPair;

KGAppState kgAppState;

@class KGAppProcessClass, ProcessClass;
@endc

@classdecl KGAppProcessClass, neverSaved;

/* an object with an optr */
@class KGRefClass, MetaClass;
    @message optr MSG_KG_REF_GET();
    @instance optr KGRI_ref = 0;
@endc
@classdecl KGRefClass;

@method KGRefClass, MSG_KG_REF_GET
{
    return pself->KGRI_ref;
}

@start KGObjects;
@object KGCounterClass KGAppCounter = {
    KGCI_count = 5;
    gcnList(MANUFACTURER_ID_GEOWORKS, 7) = KGAppOther;
}
@object KGCounterClass KGAppOther = {
}
@end KGObjects;

/* a template: references within it, to another resource, in chunk data */
@start KGTemplate;
@object KGRefClass KGTplA = {
    KGRI_ref = @KGTplB;
}
@object KGRefClass KGTplB = {
    KGRI_ref = @KGAppCounter;
}
@chunk optr KGTplRef = @KGTplA;
@end KGTemplate;

@start KGData;
@chunk optr KGRef = @KGAppCounter;
@chunk KGPair KGPairData = { 0x1234, @KGAppOther, 0 };
@chunkArray optr KGRefs = { @KGAppOther, @KGAppCounter, @KGRef };
@end KGData;

@method KGAppProcessClass, MSG_META_ATTACH_PROCESS
{
    kgAppState.KGAS_value1 = value1;
    kgAppState.KGAS_value2 = value2;
    kgAppState.KGAS_sum = KGLibAdd(value1, value2);
    @call KGAppCounter::MSG_KG_COUNTER_ADD(value1);
    kgAppState.KGAS_count = @call KGAppCounter::MSG_KG_COUNTER_GET();
    kgAppState.KGAS_process = GeodeGetProcessHandle();
    kgAppState.KGAS_appObj = GeodeGetAppObject(0);
    kgAppState.KGAS_thread = ThreadGetInfo(0, TGIT_THREAD_HANDLE);
    {
	optr *o;
	KGPair *p;
	word n = 0;

	MemLock(OptrToHandle(@KGRef));
	if (*(optr *) LMemDeref(@KGRef) == @KGAppCounter) n++;
	p = LMemDeref(@KGPairData);
	if (p->KGP_tag == 0x1234 && p->KGP_obj == @KGAppOther &&
	    p->KGP_none == 0) n++;
	o = ChunkArrayElementToPtr(@KGRefs, 0, NULL);
	if (o[0] == @KGAppOther && o[1] == @KGAppCounter && o[2] == @KGRef)
	    n++;
	MemUnlock(OptrToHandle(@KGRef));
	kgAppState.KGAS_chunkRefs = n;
    }
    kgAppState.KGAS_gcnFound =
	@call KGAppCounter::MSG_META_GCN_LIST_FIND_ITEM(@KGAppOther, 7,
							MANUFACTURER_ID_GEOWORKS);
    {
	MemHandle dup, dup2;
	optr a, b;
	word n = 0;
	LMemBlockHeader *h;

	dup = ObjDuplicateResource(OptrToHandle(@KGTplA), 0, 0);
	a = ConstructOptr(dup, OptrToChunk(@KGTplA));
	b = ConstructOptr(dup, OptrToChunk(@KGTplB));
	if (dup && dup != OptrToHandle(@KGTplA)) n++;
	if (@call a::MSG_KG_REF_GET() == b) n++;	/* within the copy */
	if (@call b::MSG_KG_REF_GET() == @KGAppCounter) n++;
	if (@call KGTplA::MSG_KG_REF_GET() == @KGTplB) n++;	/* template */
	h = MemLock(dup);
	if (*(optr *) LMemDeref(ConstructOptr(dup, OptrToChunk(@KGTplRef))) ==
	    a) n++;
	if ((h->LMBH_flags & (LMF_DUPLICATED | LMF_IN_RESOURCE |
			      LMF_DETACHABLE)) ==
	    (LMF_DUPLICATED | LMF_DETACHABLE)) n++;
	MemUnlock(dup);
	if (MemOwner(dup) == GeodeGetProcessHandle() &&
	    MemGetInfo(dup, MGIT_OTHER_INFO) ==
	    ThreadGetInfo(0, TGIT_THREAD_HANDLE)) n++;
	/* owner and thread from the source; freed again */
	dup2 = ObjDuplicateResource(OptrToHandle(@KGTplA), (GeodeHandle) -1,
				    (ThreadHandle) -1);
	if (dup2 && MemOwner(dup2) == GeodeGetProcessHandle() &&
	    MemGetInfo(dup2, MGIT_OTHER_INFO) ==
	    MemGetInfo(OptrToHandle(@KGTplA), MGIT_OTHER_INFO)) n++;
	ObjFreeDuplicate(dup2);
	kgAppState.KGAS_dup = dup;
	kgAppState.KGAS_dupChecks = n;
    }
    /* object blocks in a VM file: saved, read again */
    {
	VMFileHandle vm;
	VMBlockHandle v1, v2;
	MemHandle m1, m2;
	ChunkHandle ca, cb, cd, cc;
	optr a, b, c, d;
	word n = 0;
	ThreadHandle me = ThreadGetInfo(0, TGIT_THREAD_HANDLE);

	vm = VMOpen("KGOBJ.VM", 0, VMO_CREATE_TRUNCATE, 0);
	if (vm) {
	    VMSetAttributes(vm, VMA_OBJECT_RELOC, 0);
	    VMSetExecThread(vm, me);
	    v1 = VMAllocLMem(vm, LMEM_TYPE_OBJ_BLOCK, sizeof(ObjLMemBlockHeader));
	    v2 = VMAllocLMem(vm, LMEM_TYPE_OBJ_BLOCK, sizeof(ObjLMemBlockHeader));
	    m1 = VMVMBlockToMemBlock(vm, v1);
	    m2 = VMVMBlockToMemBlock(vm, v2);
	    a = ObjInstantiate(m1, &KGRefClass);
	    b = ObjInstantiate(m1, &KGRefClass);
	    d = ObjInstantiate(m1, &KGRefClass);
	    c = ObjInstantiate(m2, &KGCounterClass);	/* kglib's class */
	    ca = OptrToChunk(a);
	    cb = OptrToChunk(b);
	    cd = OptrToChunk(d);
	    cc = OptrToChunk(c);
	    @call c::MSG_KG_COUNTER_ADD(41);
	    MemLock(m1);
	    ((KGRefInstance *) LMemDeref(a))->KGRI_ref = b;	/* same block */
	    ((KGRefInstance *) LMemDeref(b))->KGRI_ref = c;	/* other block */
	    ((KGRefInstance *) LMemDeref(d))->KGRI_ref = @KGAppCounter;
	    MemUnlock(m1);
	    VMDirty(m1);
	    VMDirty(m2);
	    if (VMClose(vm, FALSE) == 0) n++;
	}
	vm = VMOpen("KGOBJ.VM", 0, VMO_OPEN, 0);
	if (vm) {
	    VMSetExecThread(vm, me);
	    m1 = VMVMBlockToMemBlock(vm, v1);
	    m2 = VMVMBlockToMemBlock(vm, v2);
	    a = ConstructOptr(m1, ca);
	    b = ConstructOptr(m1, cb);
	    c = ConstructOptr(m2, cc);
	    d = ConstructOptr(m1, cd);
	    if (m1 && m2) n++;
	    if (@call a::MSG_KG_REF_GET() == b) n++;
	    if (@call b::MSG_KG_REF_GET() == c) n++;
	    if (@call d::MSG_KG_REF_GET() == @KGAppCounter) n++;
	    if (@call c::MSG_KG_COUNTER_GET() == 41) n++;
	    if (ObjIsObjectInClass(a, &KGRefClass) &&
		ObjIsObjectInClass(c, &KGCounterClass)) n++;
	    VMClose(vm, FALSE);
	    FileDelete("KGOBJ.VM");
	}
	kgAppState.KGAS_vmChecks = n;
    }
    kgAppState.KGAS_attached++;
}
