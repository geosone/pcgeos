/*
 * uigen.goc -- a process geode for the library.ui.gen test (Port32/Tests):
 * a generic tree of the UI library's GenClass, built into the classes of
 * a specific UI (tspui.goc) when it becomes usable.
 *
 * UGApp (GenApplicationClass) has the display UGDisplay (not usable at
 * first) with the triggers UGTrig1 ("Alpha") and UGTrig2 ("Beta");
 * UGTrig3 is outside the tree.  UGDisplayClass and UGTriggerClass are
 * built by the specific UI's routines for a display and a trigger: when
 * a message passes GenClass for the first time, or the object becomes
 * usable (then built from scratch).  The
 * test (test_ui_gen.c) runs the steps through UGStep on the process
 * thread; the checks made here count in ugState.
 */
@include <stdapp.goh>
@include <Objects/vCompC.goh>
@include <Objects/gInterC.goh>
@include <Objects/gPrimC.goh>
@include <Objects/gViewC.goh>
@include <Objects/gContC.goh>
@include <Objects/gValueC.goh>
#include <Internal/specUI.h>
#include <localize.h>
#include <stdint.h>

#define VisPart(o)	((VisInstance *) ObjDerefVis(o))

typedef struct {
    GeodeHandle	UGS_process;
    word	UGS_attached;
    word	UGS_checks, UGS_fails, UGS_failLine;
    word	UGS_pings;
    word	UGS_failLines[8];
    word	UGS_valueApplies;
    dword	UGS_lastValue;
} UGState;

UGState ugState;

#define UGCHECK(c) \
    do { ugState.UGS_checks++; if (!(c)) { \
	if (ugState.UGS_fails < 8) \
	    ugState.UGS_failLines[ugState.UGS_fails] = __LINE__; \
	ugState.UGS_fails++; \
	if (!ugState.UGS_failLine) ugState.UGS_failLine = __LINE__; } \
    } while (0)

@class UGProcessClass, ProcessClass;
    @message void MSG_UG_STEP(word step);
@endc
@classdecl UGProcessClass, neverSaved;

@class UGDisplayClass, GenClass;
    @message void MSG_UG_PING();
    @message (GEN_VALUE_APPLY_MSG) MSG_UG_VALUE_APPLIED;
@endc
@classdecl UGDisplayClass;

@class UGTriggerClass, GenClass;
@endc
@classdecl UGTriggerClass;

@method UGDisplayClass, MSG_META_RESOLVE_VARIANT_SUPERCLASS
{
    return GenQueryUICallSpecificUI(oself, SPIR_BUILD_DISPLAY, MasterOffset);
}

@method UGDisplayClass, MSG_UG_VALUE_APPLIED
{
    (void) stateFlags;
    ugState.UGS_valueApplies++;
    ugState.UGS_lastValue = value;
}

@method UGDisplayClass, MSG_UG_PING
{
    ugState.UGS_pings++;
}

@method UGTriggerClass, MSG_META_RESOLVE_VARIANT_SUPERCLASS
{
    return GenQueryUICallSpecificUI(oself, SPIR_BUILD_TRIGGER, MasterOffset);
}

@start UGObjects;
@object GenApplicationClass UGApp = {
    GI_states = GS_USABLE | GS_ENABLED;	/* (the attach would) */
    GI_comp = @UGDisplay;
}
@object UGDisplayClass UGDisplay = {
    GI_states = GS_ENABLED;
    GI_comp = @UGTrig1, @UGTrig2;
}
@object UGTriggerClass UGTrig1 = {
    GI_visMoniker = "Alpha";
}
@object UGTriggerClass UGTrig2 = {
    GI_visMoniker = "Beta";
}
@object UGTriggerClass UGTrig3 = {
    GI_visMoniker = "Gamma";
    GI_states = GS_ENABLED;
}
@end UGObjects;

@method UGProcessClass, MSG_META_ATTACH_PROCESS
{
    (void) value1;
    (void) value2;
    ugState.UGS_process = GeodeGetProcessHandle();
    ugState.UGS_attached++;
}

static Boolean Grown(optr o)
{
    Boolean g;

    ObjLockObjBlock(OptrToHandle(o));
    g = GenCheckIfSpecGrown(o);
    MemUnlock(OptrToHandle(o));
    return g;
}

static GenAttrs Attrs(optr o)
{
    return @call o::MSG_GEN_GET_ATTRIBUTES();
}

static VisAttrs VAttrs(optr o)
{
    return @call o::MSG_VIS_GET_ATTRS();
}

/* the text of the object's moniker */
static Boolean MonikerIs(optr o, const char *text)
{
    ChunkHandle m = @call o::MSG_GEN_GET_VIS_MONIKER();
    Boolean r = FALSE;

    if (!m)
	return FALSE;
    ObjLockObjBlock(OptrToHandle(o));
    {
	VisMoniker *vm = LMemDeref(ConstructOptr(OptrToHandle(o), m));
	r = !(vm->VM_type & (VMT_GSTRING | VMT_MONIKER_LIST)) &&
	    !LocalCmpStrings((const char *) vm + VMWT_text, text, 0);
    }
    MemUnlock(OptrToHandle(o));
    return r;
}

@method UGProcessClass, MSG_UG_STEP
{
    switch (step) {
    case 1: {
	/* the generic tree, without a specific part */
	GetSizeArgs gs;
	EventHandle ev;

	UGCHECK(@call UGTrig1::MSG_GEN_FIND_PARENT() == @UGDisplay);
	UGCHECK(@call UGDisplay::MSG_GEN_FIND_PARENT() == @UGApp);
	UGCHECK(@call UGApp::MSG_GEN_FIND_PARENT() == 0);
	UGCHECK(@call UGDisplay::MSG_GEN_COUNT_CHILDREN() == 2);
	UGCHECK(@call UGDisplay::MSG_GEN_FIND_CHILD(@UGTrig2) == 1);
	UGCHECK(@call UGDisplay::MSG_GEN_FIND_CHILD(@UGTrig3) == (word) -1);
	UGCHECK(@call UGDisplay::MSG_GEN_FIND_CHILD_AT_POSITION(0) ==
		@UGTrig1);
	UGCHECK(@call UGTrig1::MSG_GEN_GET_USABLE() &&
		@call UGTrig1::MSG_GEN_GET_ENABLED());
	UGCHECK(!@call UGDisplay::MSG_GEN_GET_USABLE());
	UGCHECK(!@call UGTrig1::MSG_GEN_CHECK_IF_FULLY_USABLE());
	UGCHECK(@call UGApp::MSG_GEN_CHECK_IF_FULLY_USABLE());
	UGCHECK(!Grown(@UGApp) && !Grown(@UGDisplay) && !Grown(@UGTrig1));

	/* monikers */
	UGCHECK(MonikerIs(@UGTrig1, "Alpha") && MonikerIs(@UGTrig2, "Beta"));
	UGCHECK(@call UGApp::MSG_GEN_FIND_OBJECT_WITH_TEXT_MONIKER("Be", 0)
		== @UGTrig2);
	UGCHECK(@call UGApp::MSG_GEN_FIND_OBJECT_WITH_TEXT_MONIKER("Be",
		    GFTMF_EXACT_MATCH) == 0);
	UGCHECK(@call UGApp::MSG_GEN_FIND_OBJECT_WITH_TEXT_MONIKER("Alpha",
		    GFTMF_EXACT_MATCH) == @UGTrig1);
	(void) @call UGTrig2::MSG_GEN_REPLACE_VIS_MONIKER_TEXT("Delta", VUM_MANUAL);
	UGCHECK(MonikerIs(@UGTrig2, "Delta"));
	UGCHECK(@call UGApp::MSG_GEN_FIND_OBJECT_WITH_TEXT_MONIKER("Del", 0)
		== @UGTrig2);

	/* size hints */
	@call UGTrig1::MSG_GEN_SET_FIXED_SIZE(VUM_MANUAL, 0, 20, 40);
	@call UGTrig1::MSG_GEN_GET_FIXED_SIZE(&gs);
	UGCHECK(gs.GSA_width == 40 && gs.GSA_height == 20 && !gs.GSA_count);
	@call UGDisplay::MSG_GEN_SET_MINIMUM_SIZE(VUM_MANUAL, 3, 50, 100);
	@call UGDisplay::MSG_GEN_GET_MINIMUM_SIZE(&gs);
	UGCHECK(gs.GSA_width == 100 && gs.GSA_count == 3);
	@call UGTrig1::MSG_GEN_SET_FIXED_SIZE(VUM_MANUAL, 0, 0, 0);
	UGCHECK(!ObjVarFindData(@UGTrig1, HINT_FIXED_SIZE));

	/* adding, moving, removing a child */
	@call UGDisplay::MSG_GEN_ADD_CHILD(@UGTrig3, CCO_LAST);
	UGCHECK(@call UGDisplay::MSG_GEN_COUNT_CHILDREN() == 3 &&
		@call UGTrig3::MSG_GEN_FIND_PARENT() == @UGDisplay);
	@call UGDisplay::MSG_GEN_MOVE_CHILD(@UGTrig3, CCO_FIRST);
	UGCHECK(@call UGDisplay::MSG_GEN_FIND_CHILD(@UGTrig3) == 0);
	@call UGDisplay::MSG_GEN_REMOVE_CHILD(@UGTrig3, 0);
	UGCHECK(@call UGDisplay::MSG_GEN_COUNT_CHILDREN() == 2 &&
		@call UGTrig3::MSG_GEN_FIND_PARENT() == 0 &&
		@call UGDisplay::MSG_GEN_FIND_CHILD(@UGTrig1) == 0);

	/* the keyboard accelerator puts the parents on the search path */
	@call UGTrig2::MSG_GEN_SET_KBD_ACCELERATOR('b', VUM_MANUAL);
	UGCHECK(@call UGTrig2::MSG_GEN_GET_KBD_ACCELERATOR() == 'b');
	UGCHECK(Attrs(@UGTrig2) & GA_KBD_SEARCH_PATH &&
		Attrs(@UGDisplay) & GA_KBD_SEARCH_PATH &&
		Attrs(@UGApp) & GA_KBD_SEARCH_PATH &&
		!(Attrs(@UGTrig1) & GA_KBD_SEARCH_PATH));

	/* upward queries and classed events */
	UGCHECK(@call UGTrig1::MSG_GEN_GUP_FIND_OBJECT_OF_CLASS(
		    &GenApplicationClass) == @UGApp);
	UGCHECK(@call UGTrig1::MSG_GEN_GUP_TEST_FOR_OBJECT_OF_CLASS(
		    &UGDisplayClass));
	UGCHECK(!@call UGDisplay::MSG_GEN_GUP_TEST_FOR_OBJECT_OF_CLASS(
		    &UGTriggerClass));
	ev = @record UGDisplayClass::MSG_UG_PING();
	@call UGTrig1::MSG_META_SEND_CLASSED_EVENT(ev,
				(TravelOption) TO_GEN_PARENT);
	UGCHECK(ugState.UGS_pings == 1);
	/* (to the display itself: past GenClass, as the asm, which resolves
	 * the display's variant: the specific UI is loaded for it) */
	UGCHECK(!Grown(@UGDisplay));
	ev = @record UGDisplayClass::MSG_UG_PING();
	@call UGTrig2::MSG_GEN_CALL_PARENT(ev);
	UGCHECK(ugState.UGS_pings == 2 && Grown(@UGApp) && Grown(@UGDisplay) &&
		!Grown(@UGTrig1));
	ev = @record UGDisplayClass::MSG_UG_PING();
	@call UGDisplay::MSG_GEN_SEND_TO_CHILDREN(ev);	/* not theirs */
	UGCHECK(ugState.UGS_pings == 2);

	/* Trig1 not enabled: no specific part to tell */
	@call UGTrig1::MSG_GEN_SET_NOT_ENABLED(VUM_NOW);
	UGCHECK(!@call UGTrig1::MSG_GEN_GET_ENABLED() && !Grown(@UGTrig1));
	break;
    }
    case 2:
	/* usable: built by the specific UI, the window opened */
	@call UGDisplay::MSG_GEN_SET_USABLE(VUM_NOW);
	UGCHECK(Grown(@UGApp) && Grown(@UGDisplay) && Grown(@UGTrig1) &&
		Grown(@UGTrig2) && !Grown(@UGTrig3));
	UGCHECK(ObjIsObjectInClass(@UGDisplay, &VisCompClass) &&
		ObjIsObjectInClass(@UGTrig1, &VisClass) &&
		!ObjIsObjectInClass(@UGTrig1, &VisCompClass));
	UGCHECK(@call UGDisplay::MSG_GEN_CHECK_IF_FULLY_USABLE());
	UGCHECK(VAttrs(@UGDisplay) & VA_REALIZED &&
		VAttrs(@UGTrig1) & VA_REALIZED &&
		VAttrs(@UGTrig2) & VA_REALIZED);
	UGCHECK(@call UGDisplay::MSG_VIS_COUNT_CHILDREN() == 2 &&
		@call UGDisplay::MSG_VIS_FIND_CHILD(@UGTrig2) == 1 &&
		@call UGDisplay::MSG_VIS_FIND_PARENT() == @UGApp);
	UGCHECK(!(VAttrs(@UGTrig1) & VA_FULLY_ENABLED) &&
		VAttrs(@UGTrig2) & VA_FULLY_ENABLED);
	break;
    case 3:
	/* Trig1 enabled: told, drawn again (black) */
	@call UGTrig1::MSG_GEN_SET_ENABLED(VUM_NOW);
	UGCHECK(VAttrs(@UGTrig1) & VA_FULLY_ENABLED);
	break;
    case 4:
	/* the display not enabled: the triggers too, drawn grey */
	@call UGDisplay::MSG_GEN_SET_NOT_ENABLED(VUM_NOW);
	UGCHECK(!(VAttrs(@UGDisplay) & VA_FULLY_ENABLED) &&
		!(VAttrs(@UGTrig1) & VA_FULLY_ENABLED) &&
		!(VAttrs(@UGTrig2) & VA_FULLY_ENABLED));
	UGCHECK(!@call UGTrig1::MSG_GEN_CHECK_IF_FULLY_ENABLED() &&
		@call UGTrig1::MSG_GEN_GET_ENABLED());
	@call UGDisplay::MSG_GEN_SET_ENABLED(VUM_NOW);
	UGCHECK(VAttrs(@UGTrig1) & VA_FULLY_ENABLED &&
		VAttrs(@UGTrig2) & VA_FULLY_ENABLED);
	/* a new moniker for a built object */
	(void) @call UGTrig2::MSG_GEN_REPLACE_VIS_MONIKER_TEXT("Epsilon", VUM_NOW);
	UGCHECK(MonikerIs(@UGTrig2, "Epsilon"));
	break;
    case 5:
	/* a child added and made usable: built into the window */
	@call UGDisplay::MSG_GEN_ADD_CHILD(@UGTrig3, CCO_LAST);
	UGCHECK(!Grown(@UGTrig3));
	@call UGTrig3::MSG_GEN_SET_USABLE(VUM_NOW);
	UGCHECK(Grown(@UGTrig3) && VAttrs(@UGTrig3) & VA_REALIZED);
	UGCHECK(@call UGDisplay::MSG_VIS_COUNT_CHILDREN() == 3 &&
		@call UGDisplay::MSG_VIS_FIND_CHILD(@UGTrig3) == 2);
	break;
    case 6:
	/* and not usable again: out of the visual tree */
	@call UGTrig3::MSG_GEN_SET_NOT_USABLE(VUM_NOW);
	UGCHECK(!(VAttrs(@UGTrig3) & VA_REALIZED) &&
		!VisCheckIfSpecBuilt(@UGTrig3));
	UGCHECK(@call UGDisplay::MSG_VIS_COUNT_CHILDREN() == 2);
	UGCHECK(@call UGDisplay::MSG_GEN_COUNT_CHILDREN() == 3);
	break;
    case 7:
	/* the display not usable: closed */
	@call UGDisplay::MSG_GEN_SET_NOT_USABLE(VUM_NOW);
	UGCHECK(!(VAttrs(@UGDisplay) & VA_REALIZED) &&
		!(VAttrs(@UGTrig1) & VA_REALIZED));
	UGCHECK(!@call UGDisplay::MSG_GEN_GET_USABLE());
	break;
    case 9: {
	/* GenInteraction, GenDisplay, GenPrimary (not usable, so not
	 * grown); the size hints of a grown object */
	optr in, pr;
	ChunkHandle m;
	sword w, h;
	SizeAsDWord s;
	CompSizeHintArgs *c;

	in = ObjInstantiate(OptrToHandle(@UGApp),
			    (ClassStruct *) &GenInteractionClass);
	ObjInitializePart(in, word_offsetof(GenBase, Gen_offset));
	UGCHECK(@call in::MSG_GEN_INTERACTION_GET_TYPE() ==
		GIT_ORGANIZATIONAL &&
		@call in::MSG_GEN_INTERACTION_GET_VISIBILITY() ==
		GIV_SUB_GROUP);
	@call in::MSG_GEN_INTERACTION_SET_TYPE(GIT_PROPERTIES);
	@call in::MSG_GEN_INTERACTION_SET_VISIBILITY(GIV_DIALOG);
	@call in::MSG_GEN_INTERACTION_SET_ATTRS(GIA_MODAL, 0);
	UGCHECK(@call in::MSG_GEN_INTERACTION_GET_TYPE() == GIT_PROPERTIES &&
		@call in::MSG_GEN_INTERACTION_GET_VISIBILITY() ==
		GIV_DIALOG &&
		@call in::MSG_GEN_INTERACTION_GET_ATTRS() == GIA_MODAL);
	@call in::MSG_GEN_INTERACTION_SET_ATTRS(0, GIA_MODAL);
	UGCHECK(!@call in::MSG_GEN_INTERACTION_GET_ATTRS());
	UGCHECK(!Grown(in));

	pr = ObjInstantiate(OptrToHandle(@UGApp),
			    (ClassStruct *) &GenPrimaryClass);
	ObjInitializePart(pr, word_offsetof(GenBase, Gen_offset));
	UGCHECK((Attrs(pr) & GA_TARGETABLE) &&
		@call pr::MSG_GEN_DISPLAY_GET_ATTRS() == GDA_USER_DISMISSABLE);
	UGCHECK(!@call pr::MSG_GEN_DISPLAY_GET_MINIMIZED() &&
		!@call pr::MSG_GEN_DISPLAY_GET_MAXIMIZED());
	@call pr::MSG_GEN_DISPLAY_SET_MINIMIZED();
	@call pr::MSG_GEN_DISPLAY_SET_MAXIMIZED();
	UGCHECK(@call pr::MSG_GEN_DISPLAY_GET_MINIMIZED() &&
		@call pr::MSG_GEN_DISPLAY_GET_MAXIMIZED());
	@call pr::MSG_GEN_DISPLAY_SET_NOT_MINIMIZED();
	@call pr::MSG_GEN_DISPLAY_SET_NOT_MAXIMIZED();
	UGCHECK(!@call pr::MSG_GEN_DISPLAY_GET_MINIMIZED() &&
		!@call pr::MSG_GEN_DISPLAY_GET_MAXIMIZED());
	@call pr::MSG_GEN_DISPLAY_SET_ATTRS(0);
	UGCHECK(!@call pr::MSG_GEN_DISPLAY_GET_ATTRS());
	/* the long term moniker, kept by the primary while not grown */
	m = @call pr::MSG_GEN_PRIMARY_REPLACE_LONG_TERM_MONIKER(VUM_NOW, 0,
				0, 0, VMDT_TEXT, VMST_FPTR,
				(VisMonikerSource) (uintptr_t) "Long Term");
	UGCHECK(m && @call pr::MSG_GEN_PRIMARY_GET_LONG_TERM_MONIKER() == m);
	ObjLockObjBlock(OptrToHandle(pr));
	UGCHECK(!LocalCmpStrings((const char *) LMemDeref(ConstructOptr(
				    OptrToHandle(pr), m)) + VMWT_text,
				 "Long Term", 0));
	MemUnlock(OptrToHandle(pr));
	UGCHECK(!@call pr::MSG_GEN_PRIMARY_REPLACE_LONG_TERM_MONIKER(VUM_NOW,
				0, 0, 0, VMDT_NULL, VMST_FPTR, 0));
	UGCHECK(!@call pr::MSG_GEN_PRIMARY_GET_LONG_TERM_MONIKER());

	/* HINT_MINIMUM_SIZE of 100 pixels: the object's own size added
	 * (VisClass's extra size), applied to a smaller size; a larger
	 * one stays */
	ObjLockObjBlock(OptrToHandle(@UGTrig1));
	s = VisGetSize(@UGTrig1);
	c = ObjVarAddData(@UGTrig1, HINT_MINIMUM_SIZE,
			  sizeof(CompSizeHintArgs));
	c->CSHA_width = SST_PIXELS | 100;
	c->CSHA_height = 0;
	c->CSHA_count = 0;
	VisPart(@UGTrig1)->VI_geoAttrs &= ~VGA_NO_SIZE_HINTS;
	w = 10;
	h = 7;
	VisApplySizeHints(@UGTrig1, &w, &h);
	UGCHECK(w == 100 + (sword) DWORD_WIDTH(s) && h == 7);
	VisPart(@UGTrig1)->VI_geoAttrs &= ~VGA_NO_SIZE_HINTS;
	w = 500;
	VisApplySizeHints(@UGTrig1, &w, &h);
	UGCHECK(w == 500);
	(void) ObjVarDeleteData(@UGTrig1, HINT_MINIMUM_SIZE);
	UGCHECK(VisConvertSpecVisSize(@UGTrig1, SST_PIXELS | 42, 0) == 42);
	MemUnlock(OptrToHandle(@UGTrig1));
	break;
    }
    case 10: {
	/* GenView and GenContent not usable (not built): the generic
	 * data only; two views linked vertically get the changes of
	 * either */
	optr v, v2, c;
	GenViewInstance *vi;
	PointDWord pt;
	RectDWord r;
	GetScaleParams sp;
	DimensionAttrs da;
	DimensionAttrsToSetClear hs, vs;
	VisUpdateModeAsWord um;
	InkDestinationInfoParams *ip;

	v = ObjInstantiate(OptrToHandle(@UGApp),
			   (ClassStruct *) &GenViewClass);
	ObjInitializePart(v, word_offsetof(GenBase, Gen_offset));
	UGCHECK((Attrs(v) & GA_TARGETABLE) &&
		@call v::MSG_GEN_VIEW_GET_ATTRS() == GVA_FOCUSABLE);
	UGCHECK(GVCD_INDEX(@call v::MSG_GEN_VIEW_GET_COLOR()) == C_WHITE);
	@call v::MSG_GEN_VIEW_GET_SCALE_FACTOR(&sp);
	UGCHECK(sp.GSP_xScaleFactor == 0x10000 &&
		sp.GSP_yScaleFactor == 0x10000);
	@call v::MSG_GEN_VIEW_GET_INCREMENT(&pt);
	UGCHECK(pt.PD_x == 20 && pt.PD_y == 15);

	um.VUMAW_mode = VUM_NOW;
	um.VUMAW_unused = 0;
	@call v::MSG_GEN_VIEW_SET_ATTRS(GVA_TRACK_SCROLLING, GVA_FOCUSABLE,
					um);
	UGCHECK(@call v::MSG_GEN_VIEW_GET_ATTRS() == GVA_TRACK_SCROLLING);
	hs.DATSC_attrsToSet = GVDA_SCROLLABLE;
	hs.DATSC_attrsToClear = 0;
	vs.DATSC_attrsToSet = GVDA_SCROLLABLE | GVDA_TAIL_ORIENTED;
	vs.DATSC_attrsToClear = 0;
	@call v::MSG_GEN_VIEW_SET_DIMENSION_ATTRS(hs, vs, um);
	da = @call v::MSG_GEN_VIEW_GET_DIMENSION_ATTRS();
	UGCHECK(da.DA_horizAttrs == GVDA_SCROLLABLE &&
		da.DA_verAttrs == (GVDA_SCROLLABLE | GVDA_TAIL_ORIENTED));
	@call v::MSG_GEN_VIEW_SET_COLOR(C_LIGHT_GRAY, CF_INDEX, 0);
	UGCHECK(GVCD_INDEX(@call v::MSG_GEN_VIEW_GET_COLOR()) ==
		C_LIGHT_GRAY);
	@call v::MSG_GEN_VIEW_SET_COLOR(10, CF_RGB, 0x3020);
	UGCHECK(@call v::MSG_GEN_VIEW_GET_COLOR() ==
		(10 | ((dword) CF_RGB << 8) | 0x30200000UL));

	@call v::MSG_GEN_VIEW_SET_DOC_BOUNDS(400, 300, -10, -20);
	@call v::MSG_GEN_VIEW_GET_DOC_BOUNDS(&r);
	UGCHECK(r.RD_left == -20 && r.RD_top == -10 && r.RD_right == 300 &&
		r.RD_bottom == 400);
	@call v::MSG_GEN_VIEW_SET_INCREMENT(0, 8);
	@call v::MSG_GEN_VIEW_GET_INCREMENT(&pt);
	UGCHECK(pt.PD_x == 8 && pt.PD_y == 15);
	@call v::MSG_GEN_VIEW_SET_ORIGIN(70, 50);
	@call v::MSG_GEN_VIEW_SCROLL(5, -10);
	@call v::MSG_GEN_VIEW_SET_ORIGIN_LOW(GVSOL_NO_CHANGE, 1);
	@call v::MSG_GEN_VIEW_GET_ORIGIN(&pt);
	UGCHECK(pt.PD_x == 41 && pt.PD_y == 75);
	ObjLockObjBlock(OptrToHandle(v));
	vi = ObjDerefGen(v);
	vi->GVI_origin.PDF_x.DWF_frac = 0x8000;
	MemUnlock(OptrToHandle(v));
	@call v::MSG_GEN_VIEW_GET_ORIGIN(&pt);
	UGCHECK(pt.PD_x == 42);
	@call v::MSG_GEN_VIEW_SET_SCALE_FACTOR(0, 0, SVT_AROUND_UPPER_LEFT,
					       0x18000, 0x20000);
	@call v::MSG_GEN_VIEW_GET_SCALE_FACTOR(&sp);
	UGCHECK(sp.GSP_xScaleFactor == 0x20000 &&
		sp.GSP_yScaleFactor == 0x18000);
	UGCHECK(!@call v::MSG_GEN_VIEW_GET_WINDOW());
	r.RD_left = 5;
	@call v::MSG_GEN_VIEW_GET_VISIBLE_RECT(&r);
	UGCHECK(!r.RD_left && !r.RD_right && !r.RD_bottom);
	@call v::MSG_GEN_VIEW_SET_INK_TYPE(GVIT_PRESSES_ARE_INK);
	ObjLockObjBlock(OptrToHandle(v));
	UGCHECK(((GenViewInstance *) ObjDerefGen(v))->GVI_inkType ==
		GVIT_PRESSES_ARE_INK);
	MemUnlock(OptrToHandle(v));
	@call v::MSG_GEN_VIEW_SET_EXTENDED_INK_TYPE(TRUE, C_RED, 3, @UGTrig1);
	ObjLockObjBlock(OptrToHandle(v));
	ip = ObjVarFindData(v, ATTR_GEN_VIEW_INK_DESTINATION_INFO);
	UGCHECK(ip && ip->IDIP_dest == @UGTrig1 && ip->IDIP_brushSize == 3 &&
		ip->IDIP_color == C_RED && ip->IDIP_createGState);
	MemUnlock(OptrToHandle(v));
	@call v::MSG_GEN_VIEW_RESET_EXTENDED_INK_TYPE();
	ObjLockObjBlock(OptrToHandle(v));
	UGCHECK(!ObjVarFindData(v, ATTR_GEN_VIEW_INK_DESTINATION_INFO));
	MemUnlock(OptrToHandle(v));

	c = ObjInstantiate(OptrToHandle(@UGApp),
			   (ClassStruct *) &GenContentClass);
	ObjInitializePart(c, word_offsetof(GenBase, Gen_offset));
	@call c::MSG_GEN_CONTENT_SET_ATTRS(VCNA_SAME_WIDTH_AS_VIEW |
					   VCNA_SAME_HEIGHT_AS_VIEW, 0);
	@call c::MSG_GEN_CONTENT_SET_ATTRS(0, VCNA_SAME_HEIGHT_AS_VIEW);
	UGCHECK(@call c::MSG_GEN_CONTENT_GET_ATTRS() ==
		VCNA_SAME_WIDTH_AS_VIEW);
	@call v::MSG_GEN_VIEW_SET_CONTENT(c);
	UGCHECK(@call v::MSG_GEN_VIEW_GET_CONTENT() == c);
	UGCHECK(!Grown(v) && !Grown(c));

	/* linked: v2 and v in a vertical circle */
	v2 = ObjInstantiate(OptrToHandle(@UGApp),
			    (ClassStruct *) &GenViewClass);
	ObjInitializePart(v2, word_offsetof(GenBase, Gen_offset));
	ObjLockObjBlock(OptrToHandle(v));
	((GenViewInstance *) ObjDerefGen(v))->GVI_vertLink = v2;
	((GenViewInstance *) ObjDerefGen(v2))->GVI_vertLink = v;
	MemUnlock(OptrToHandle(v));
	@call v2::MSG_GEN_VIEW_SET_DOC_BOUNDS(1000, 800, 0, 0);
	@call v::MSG_GEN_VIEW_GET_DOC_BOUNDS(&r);
	UGCHECK(r.RD_right == 800 && r.RD_bottom == 1000 && !r.RD_left);
	@call v2::MSG_GEN_VIEW_GET_DOC_BOUNDS(&r);
	UGCHECK(r.RD_right == 800 && r.RD_bottom == 1000);
	@call v::MSG_GEN_VIEW_SCROLL(100, 0);
	@call v2::MSG_GEN_VIEW_GET_ORIGIN(&pt);
	UGCHECK(pt.PD_y == 100 && !pt.PD_x);
	@call v::MSG_GEN_VIEW_GET_ORIGIN(&pt);
	UGCHECK(pt.PD_y == 175);
	ObjLockObjBlock(OptrToHandle(v));
	UGCHECK(((GenViewInstance *) ObjDerefGen(v))->GVI_vertLink == v2 &&
		((GenViewInstance *) ObjDerefGen(v2))->GVI_vertLink == v);
	MemUnlock(OptrToHandle(v));
	break;
    }
    case 11: {
	/* GenValue not usable: range, steps, wrap, text, ratio, apply */
	optr v;
	char buf[GEN_VALUE_MAX_TEXT_LEN + 1];

	v = ObjInstantiate(OptrToHandle(@UGApp),
			   (ClassStruct *) &GenValueClass);
	ObjInitializePart(v, word_offsetof(GenBase, Gen_offset));
	@call v::MSG_GEN_VALUE_SET_MAXIMUM(MakeWWFixed(100));
	@call v::MSG_GEN_VALUE_SET_MINIMUM(MakeWWFixed(10));
	UGCHECK(IntegerOf(@call v::MSG_GEN_VALUE_GET_VALUE()) == 10);
	@call v::MSG_GEN_VALUE_SET_INTEGER_VALUE(150, FALSE);
	UGCHECK(IntegerOf(@call v::MSG_GEN_VALUE_GET_VALUE()) == 100);
	@call v::MSG_GEN_VALUE_SET_INCREMENT(MakeWWFixed(5));
	@call v::MSG_GEN_VALUE_DECREMENT();
	UGCHECK(IntegerOf(@call v::MSG_GEN_VALUE_GET_VALUE()) == 95);
	@call v::MSG_GEN_VALUE_INCREMENT();
	@call v::MSG_GEN_VALUE_INCREMENT();
	UGCHECK(IntegerOf(@call v::MSG_GEN_VALUE_GET_VALUE()) == 100);
	ObjLockObjBlock(OptrToHandle(v));
	(void) ObjVarAddData(v, HINT_VALUE_WRAP, 0);
	MemUnlock(OptrToHandle(v));
	@call v::MSG_GEN_VALUE_INCREMENT();
	UGCHECK(IntegerOf(@call v::MSG_GEN_VALUE_GET_VALUE()) == 10);
	/* a range length of 20: no more than 80 */
	@call v::MSG_GEN_VALUE_SET_RANGE_LENGTH(MakeWWFixed(20));
	@call v::MSG_GEN_VALUE_SET_VALUE_TO_MAXIMUM();
	UGCHECK(IntegerOf(@call v::MSG_GEN_VALUE_GET_VALUE()) == 80);
	@call v::MSG_GEN_VALUE_SUBTRACT_RANGE_LENGTH();
	UGCHECK(IntegerOf(@call v::MSG_GEN_VALUE_GET_VALUE()) == 60);
	/* (60 - 10) / (100 - 10 - 20): 0.714 */
	UGCHECK(@call v::MSG_GEN_VALUE_GET_VALUE_RATIO(
			GVI_VALUE_AS_RATIO_OF_AVAILABLE_RANGE) ==
		GrUDivWWFixed(MakeWWFixed(50), MakeWWFixed(70)));
	{
	    WWFixed half;

	    half.WWF_int = 0;
	    half.WWF_frac = 0x8000;
	    @call v::MSG_GEN_VALUE_SET_VALUE_FROM_RATIO(half, GVT_VALUE);
	}
	UGCHECK(IntegerOf(@call v::MSG_GEN_VALUE_GET_VALUE()) == 55);
	@call v::MSG_GEN_VALUE_GET_VALUE_TEXT(buf, GVT_VALUE);
	UGCHECK(!LocalCmpStrings(buf, "55", 0));
	@call v::MSG_GEN_VALUE_SET_VALUE_FROM_TEXT("42", GVT_VALUE);
	UGCHECK(IntegerOf(@call v::MSG_GEN_VALUE_GET_VALUE()) == 42);
	@call v::MSG_GEN_VALUE_SET_DISPLAY_FORMAT(GVDF_DECIMAL);
	@call v::MSG_GEN_VALUE_SET_VALUE(MakeWWFixed(12.5), FALSE);
	@call v::MSG_GEN_VALUE_GET_VALUE_TEXT(buf, GVT_VALUE);
	UGCHECK(!LocalCmpStrings(buf, "12.5", 0) ||
		!LocalCmpStrings(buf, "12,5", 0));
	@call v::MSG_GEN_VALUE_SET_DISPLAY_FORMAT(GVDF_PERCENTAGE);
	@call v::MSG_GEN_VALUE_SET_INTEGER_VALUE(50, FALSE);
	@call v::MSG_GEN_VALUE_GET_VALUE_TEXT(buf, GVT_VALUE);
	UGCHECK(!LocalCmpStrings(buf, "50%", 0));
	@call v::MSG_GEN_VALUE_SET_DISPLAY_FORMAT(GVDF_INTEGER);

	/* modified, applied once to the process */
	@call v::MSG_GEN_VALUE_SET_DESTINATION(@UGDisplay);
	@call v::MSG_GEN_VALUE_SET_APPLY_MSG(MSG_UG_VALUE_APPLIED);
	@call v::MSG_GEN_VALUE_SET_INTEGER_VALUE(33, FALSE);
	UGCHECK(!@call v::MSG_GEN_VALUE_IS_MODIFIED());
	/* not modified: nothing; applied even so with the attribute
	 * (becoming modified makes it applyable: the specific part's) */
	@call v::MSG_GEN_APPLY();
	ObjLockObjBlock(OptrToHandle(v));
	(void) ObjVarAddData(v,
		ATTR_GEN_SEND_APPLY_MSG_ON_APPLY_EVEN_IF_NOT_MODIFIED, 0);
	MemUnlock(OptrToHandle(v));
	@call v::MSG_GEN_APPLY();
	UGCHECK(!@call v::MSG_GEN_VALUE_IS_MODIFIED());
	@call v::MSG_GEN_VALUE_SET_INDETERMINATE_STATE(TRUE);
	UGCHECK(@call v::MSG_GEN_VALUE_IS_INDETERMINATE());
	UGCHECK(!Grown(v));
	break;
    }
    case 8:
	/* the specific parts gone, the specific UI freed */
	ObjLockObjBlock(OptrToHandle(@UGApp));
	GenSpecShrinkBranch(@UGApp);
	MemUnlock(OptrToHandle(@UGApp));
	UGCHECK(!Grown(@UGApp) && !Grown(@UGDisplay) && !Grown(@UGTrig1));
	UserFreeSpecificUI();
	break;
    }
}

void UGStep(word step)
{
    optr p = ConstructOptr(ugState.UGS_process, 0);

    @call p::MSG_UG_STEP(step);
}
