/*
 * textobj.goc -- a process geode for the library.text test
 * (Port32/Tests): text objects of the text library (VisTextClass), not
 * on a screen.
 *
 * TOText is a text object of a resource with a text, TOEmpty one
 * without; a third is instantiated.  They are TOTextClass, which counts
 * what a text object tells itself (modified by the user or not, empty
 * or not).  Step 10 calculates the lines of TOText (the system is
 * booted with Berkeley then).  The test (test_text.c) runs the steps through TOStep on the
 * process thread; the checks made here count in toState.
 */
@include <stdapp.goh>
@include <Objects/vTextC.goh>
@include <Objects/gViewC.goh>
@include <Objects/clipbrd.goh>
@include <Objects/vLTextC.goh>
@include <Objects/gEditCC.goh>
@include <Objects/gBoolGC.goh>
@include <Objects/styles.goh>
#include <string.h>
#include <font.h>
#include <fontID.h>
#include <chunkarr.h>
#include <initfile.h>
#include <char.h>
#include <hugearr.h>
#include <dbase.h>
#include <geoworks.h>

typedef struct {
    GeodeHandle	TOS_process;
    word	TOS_attached;
    word	TOS_checks, TOS_fails, TOS_failLine;
    word	TOS_failLines[8];
    word	TOS_modified, TOS_notModified;
    word	TOS_empty, TOS_notEmpty;
    char	TOS_text[40];		/* TOText at the end of a step */
    word	TOS_line[16];		/* of step 10, to print */
    word	TOS_geo[6];
    word	TOS_filter[2];		/* characters asked, tabs refused */
    word	TOS_shown;		/* (step 15) asked to show */
    word	TOS_generated;		/* (step 16) MSG_VIS_TEXT_GENERATE_NOTIFY */
    VisTextNotificationFlags TOS_types;
    VisTextNotifySendFlags TOS_send;
    MemHandle	TOS_countBlock;
    word	TOS_border[5];		/* of step 19, to print */
    word	TOS_tab[2];		/* of step 20 */
    word	TOS_clip;		/* of step 21 */
    word	TOS_large[3];		/* of step 22 */
    MemHandle	TOS_selectBlock;	/* (step 23) the select state */
    word	TOS_paste[2];		/* of step 23 */
    word	TOS_runs[2];		/* of step 24 */
    word	TOS_regions[6];		/* of step 25 */
    char	TOS_styleDesc[80];	/* (step 26) the style described */
    word	TOS_styles[4];		/* of step 26 */
} TOState;

TOState toState;

#define TOCHECK(c) \
    do { toState.TOS_checks++; if (!(c)) { \
	if (toState.TOS_fails < 8) \
	    toState.TOS_failLines[toState.TOS_fails] = __LINE__; \
	toState.TOS_fails++; \
	if (!toState.TOS_failLine) toState.TOS_failLine = __LINE__; } \
    } while (0)

@class TOProcessClass, ProcessClass;
    @message void MSG_TO_STEP(word step);
@endc
@classdecl TOProcessClass, neverSaved;

@class TOTextClass, VisTextClass;
@endc
@classdecl TOTextClass;

/* (step 12) an x becomes a y, a # refuses the text */
@method TOTextClass, MSG_VIS_TEXT_FILTER_VIA_CHARACTER
{
    (void) pself;
    toState.TOS_filter[0]++;
    return charToFilter == '#' ? 0 : charToFilter == 'x' ? 'y' : charToFilter;
}

@method TOTextClass, MSG_META_TEXT_TAB_FILTERED
{
    (void) pself; (void) character; (void) params;
    toState.TOS_filter[1]++;
}

@start TOObjects;
@object TOTextClass TOText = {
    VTI_text = "Hello";
}
@object TOTextClass TOEmpty = {
}
@chunk char TOString[] = "from a chunk";
@chunk char TOBuffer[] = "x";
@end TOObjects;

/* text at the end as the keyboard gives it (filtered, from a buffer of
 * its own: upper case is written into it); TRUE if it was refused */
static Boolean Typed(const char *s)
{
    VisTextReplaceParameters p;
    char buf[16];
    word n = 0;

    while (s[n] && n < sizeof(buf) - 1)
	buf[n] = s[n], n++;
    memset(&p, 0, sizeof(p));
    p.VTRP_range.VTR_start = p.VTRP_range.VTR_end = TEXT_ADDRESS_PAST_END;
    p.VTRP_insCount = n;
    p.VTRP_flags = VTRF_FILTER;
    p.VTRP_textReference.TR_type = TRT_POINTER;
    p.VTRP_textReference.TR_ref.TRU_pointer.TRP_pointer = buf;
    return @call TOText::MSG_VIS_TEXT_REPLACE_TEXT(&p);
}

/* (step 16) the notifications asked, the count block kept */
@method TOTextClass, MSG_VIS_TEXT_GENERATE_NOTIFY
{
    toState.TOS_generated++;
    toState.TOS_types = params->VTGNP_notificationTypes;
    toState.TOS_send = params->VTGNP_sendFlags;
    @callsuper();
    toState.TOS_countBlock = params->VTGNP_notificationBlocks[5];
    toState.TOS_selectBlock = params->VTGNP_notificationBlocks[0];
}

/* (step 15) the view is not asked: none here */
@method TOTextClass, MSG_VIS_TEXT_SHOW_SELECTION
{
    (void) flags; (void) yFlags; (void) yMargin;
    (void) xFlags; (void) xMargin; (void) bottom; (void) right;
    (void) top; (void) left;
    toState.TOS_shown++;
}

@method TOTextClass, MSG_META_TEXT_USER_MODIFIED
{
    (void) obj;
    toState.TOS_modified++;
}

@method TOTextClass, MSG_META_TEXT_NOT_USER_MODIFIED
{
    (void) obj;
    toState.TOS_notModified++;
}

@method TOTextClass, MSG_META_TEXT_EMPTY_STATUS_CHANGED
{
    (void) object;
    if (hasTextFlag)
	toState.TOS_notEmpty++;
    else
	toState.TOS_empty++;
}

@method TOProcessClass, MSG_META_ATTACH_PROCESS
{
    (void) value1;
    (void) value2;
    toState.TOS_process = GeodeGetProcessHandle();
    toState.TOS_attached++;
}

/* (no strcmp in a geode) */
static word Len(const char *s)
{
    word n = 0;

    while (s[n])
	n++;
    return n;
}

static Boolean Same(const char *a, const char *b)
{
    word n = Len(a);

    return n == Len(b) && !memcmp(a, b, n);
}

/* the chunks in use in a block */
static word ChunkCount(MemHandle mh)
{
    LMemBlockHeader *h = MemDeref(mh);
    word *tab = (word *) ((byte *) h + h->LMBH_offset);
    word i, n = 0;

    for (i = 0; i < h->LMBH_nHandles; i++)
	if (tab[i])
	    n++;
    return n;
}

static Boolean Is(optr o, const char *text)
{
    char buf[64];
    word n = @call o::MSG_VIS_TEXT_GET_ALL_PTR(buf);

    return n == Len(text) && Same(buf, text) &&
	   @call o::MSG_VIS_TEXT_GET_TEXT_SIZE() == n;
}

static Boolean Selection(optr o, dword start, dword end)
{
    VisTextRange r;

    @call o::MSG_VIS_TEXT_GET_SELECTION_RANGE(&r);
    return r.VTR_start == start && r.VTR_end == end;
}

static Boolean ChunkIs(optr c, const char *text)
{
    Boolean ok;

    ObjLockObjBlock(OptrToHandle(c));
    ok = Same(LMemDeref(c), text) &&
	 LMemGetChunkSize(c) == Len(text) + 1;
    MemUnlock(OptrToHandle(c));
    return ok;
}

/* the character attribute run at pos is from s to e */
static Boolean RunIs(optr o, dword pos, dword s, dword e)
{
    VisTextRange r;

    @call o::MSG_VIS_TEXT_GET_RUN_BOUNDS(&r,
		offsetof(VisTextInstance, VTI_charAttrRuns), pos);
    return r.VTR_start == s && r.VTR_end == e;
}

/* the font of the range, and the token of its attribute */
static FontID FontOf(optr o, dword start, dword end, word *token,
		     VisTextCharAttrDiffs *d)
{
    VisTextCharAttr a;

    *token = @call o::MSG_VIS_TEXT_GET_CHAR_ATTR(0, d, &a, end, start);
    return a.VTCA_fontID;
}

/* the range replaced by the text (by the program: not filtered) */
static void ReplaceRange(optr o, dword start, dword end, const char *s)
{
    VisTextReplaceParameters p;

    memset(&p, 0, sizeof(p));
    p.VTRP_range.VTR_start = start;
    p.VTRP_range.VTR_end = end;
    p.VTRP_insCount = Len(s);
    p.VTRP_textReference.TR_type = TRT_POINTER;
    p.VTRP_textReference.TR_ref.TRU_pointer.TRP_pointer = (char *) s;
    (void) @call o::MSG_VIS_TEXT_REPLACE_TEXT(&p);
}

/* the elements of the character attributes in use */
static word UsedElements(optr o)
{
    MemHandle mh = OptrToHandle(o);
    TextRunArrayHeader *h;

    h = LMemDerefHandles(mh, ((VisTextInstance *) ObjDerefVis(o))->
				 VTI_charAttrRuns);
    return ElementArrayGetUsedCount(ConstructOptr(mh, h->TRAH_elementArray),
				    0, NULL);
}

/* the paragraph attribute run at pos is from s to e */
static Boolean ParaRunIs(optr o, dword pos, dword s, dword e)
{
    VisTextRange r;

    @call o::MSG_VIS_TEXT_GET_RUN_BOUNDS(&r,
		offsetof(VisTextInstance, VTI_paraAttrRuns), pos);
    return r.VTR_start == s && r.VTR_end == e;
}

/* the paragraph attribute of the range, its token */
static word ParaOf(optr o, dword start, dword end, VisTextMaxParaAttr *a,
		   VisTextParaAttrDiffs *d)
{
    return @call o::MSG_VIS_TEXT_GET_PARA_ATTR(0, d, a, end, start);
}

/* an item in the clipboard file: one text format of one block */
static VMBlockHandle TOMakeItem(VMFileHandle f, optr owner, word extra)
{
    VMBlockHandle h = VMAlloc(f, sizeof(ClipboardItemHeader), 0),
		  d = VMAlloc(f, 16, 0);
    ClipboardItemHeader *ih;
    MemHandle mh;

    ih = VMLock(f, h, &mh);
    memset(ih, 0, sizeof(*ih));
    ih->CIH_owner = owner;
    ih->CIH_formatCount = 1;
    ih->CIH_formats[0].CIFI_format =
	FormatIDFromManufacturerAndType(MANUFACTURER_ID_GEOWORKS, CIF_TEXT);
    ih->CIH_formats[0].CIFI_extra1 = extra;
    ih->CIH_formats[0].CIFI_vmChain = VMCHAIN_MAKE_FROM_VM_BLOCK(d);
    VMDirty(mh);
    VMUnlock(mh);
    return h;
}

/* (step 23) the name of a transfer item */
static Boolean TOItemName(TransferBlockID id, const char *name)
{
    MemHandle mh;
    ClipboardItemHeader *h = VMLock(FileFromTransferBlockID(id),
				    BlockFromTransferBlockID(id), &mh);
    Boolean same = Same(h->CIH_name, name);

    VMUnlock(mh);
    return same;
}

@method TOProcessClass, MSG_TO_STEP
{
    VisTextReplaceParameters p;
    char buf[64];

    switch (step) {
    case 1:
	/* the text of the resource; appended to: not by the user */
	TOCHECK(Is(@TOText, "Hello"));
	TOCHECK(Selection(@TOText, 0, 0));
	@call TOText::MSG_VIS_TEXT_APPEND_PTR(", world", 0);
	TOCHECK(Is(@TOText, "Hello, world"));
	TOCHECK(Selection(@TOText, 0, 0));
	TOCHECK(!@call TOText::MSG_VIS_TEXT_GET_USER_MODIFIED_STATE());
	TOCHECK(!toState.TOS_modified && !toState.TOS_notModified);
	/* a length given: only that much */
	@call TOText::MSG_VIS_TEXT_APPEND_PTR("!!!", 1);
	TOCHECK(Is(@TOText, "Hello, world!"));
	break;
    case 2:
	/* the selection replaced: a cursor after the new text */
	@call TOText::MSG_VIS_TEXT_SELECT_RANGE_SMALL(0, 5);
	TOCHECK(Selection(@TOText, 0, 5));
	TOCHECK(@call TOText::MSG_VIS_TEXT_GET_SELECTION_PTR(buf) == 5 &&
		Same(buf, "Hello"));
	@call TOText::MSG_VIS_TEXT_REPLACE_SELECTION_PTR("Goodbye", 0);
	TOCHECK(Is(@TOText, "Goodbye, world!"));
	TOCHECK(Selection(@TOText, 7, 7));
	TOCHECK(@call TOText::MSG_VIS_TEXT_GET_SELECTION_START() == 7);
	/* a change before the cursor moves it, one after it does not */
	@call TOText::MSG_VIS_TEXT_SELECT_RANGE_SMALL(9, 14);
	memset(&p, 0, sizeof(p));
	p.VTRP_range.VTR_start = 0;
	p.VTRP_range.VTR_end = 4;
	TOCHECK(!@call TOText::MSG_VIS_TEXT_REPLACE_TEXT(&p));
	TOCHECK(Is(@TOText, "bye, world!"));
	TOCHECK(Selection(@TOText, 5, 10));
	@call TOText::MSG_VIS_TEXT_APPEND_PTR("?", 0);
	TOCHECK(Selection(@TOText, 5, 10));
	TOCHECK(@call TOText::MSG_VIS_TEXT_GET_SELECTION_PTR(buf) == 5 &&
		Same(buf, "world"));
	break;
    case 3:
	/* a replacement by the user: modified, told once; the range with
	 * the selection in it leaves a cursor after the new text */
	memset(&p, 0, sizeof(p));
	p.VTRP_range.VTR_start = 3;
	p.VTRP_range.VTR_end = TEXT_ADDRESS_PAST_END;
	p.VTRP_insCount = 2;
	p.VTRP_textReference.TR_type = TRT_POINTER;
	p.VTRP_textReference.TR_ref.TRU_pointer.TRP_pointer = "!!?";
	p.VTRP_flags = VTRF_USER_MODIFICATION;
	TOCHECK(!@call TOText::MSG_VIS_TEXT_REPLACE_TEXT(&p));
	TOCHECK(Is(@TOText, "bye!!"));
	TOCHECK(Selection(@TOText, 5, 5));
	TOCHECK(@call TOText::MSG_VIS_TEXT_GET_USER_MODIFIED_STATE());
	TOCHECK(@call TOText::MSG_VIS_TEXT_GET_STATE() & VTS_USER_MODIFIED);
	TOCHECK(toState.TOS_modified == 1);
	p.VTRP_range.VTR_start = p.VTRP_range.VTR_end = 0;
	p.VTRP_insCount = (dword) INSERT_COMPUTE_TEXT_LENGTH << 16;
	TOCHECK(!@call TOText::MSG_VIS_TEXT_REPLACE_TEXT(&p));
	TOCHECK(Is(@TOText, "!!?bye!!"));
	TOCHECK(Selection(@TOText, 8, 8));
	TOCHECK(toState.TOS_modified == 1 && !toState.TOS_notModified);
	/* the same text set again: not modified any more, told */
	@call TOText::MSG_VIS_TEXT_REPLACE_ALL_PTR("!!?bye!!", 0);
	TOCHECK(Is(@TOText, "!!?bye!!"));
	TOCHECK(Selection(@TOText, 8, 8));
	TOCHECK(!@call TOText::MSG_VIS_TEXT_GET_USER_MODIFIED_STATE());
	TOCHECK(toState.TOS_notModified == 1);
	/* a range past the text is its end */
	memset(&p, 0, sizeof(p));
	p.VTRP_range.VTR_start = 50;
	p.VTRP_range.VTR_end = 60;
	TOCHECK(!@call TOText::MSG_VIS_TEXT_REPLACE_TEXT(&p));
	TOCHECK(Is(@TOText, "!!?bye!!"));
	/* nothing replaced by nothing: no change */
	memset(&p, 0, sizeof(p));
	p.VTRP_range.VTR_start = p.VTRP_range.VTR_end = 2;
	p.VTRP_flags = VTRF_USER_MODIFICATION;
	TOCHECK(!@call TOText::MSG_VIS_TEXT_REPLACE_TEXT(&p));
	TOCHECK(toState.TOS_modified == 1);
	break;
    case 4:
	/* all deleted: empty, told; text again: told */
	TOCHECK(!toState.TOS_empty && !toState.TOS_notEmpty);
	@call TOText::MSG_VIS_TEXT_DELETE_ALL();
	TOCHECK(Is(@TOText, ""));
	TOCHECK(Selection(@TOText, 0, 0));
	TOCHECK(toState.TOS_empty == 1 && !toState.TOS_notEmpty);
	@call TOText::MSG_VIS_TEXT_DELETE_ALL();
	TOCHECK(toState.TOS_empty == 1);
	@call TOText::MSG_VIS_TEXT_REPLACE_ALL_PTR("abcdefgh", 0);
	TOCHECK(Is(@TOText, "abcdefgh"));
	TOCHECK(toState.TOS_empty == 1 && toState.TOS_notEmpty == 1);
	/* a range read through the message, cut to the text */
	{
	    TextReference r;

	    memset(&r, 0, sizeof(r));
	    r.TR_type = TRT_POINTER;
	    r.TR_ref.TRU_pointer.TRP_pointer = buf;
	    TOCHECK(@call TOText::MSG_VIS_TEXT_GET_TEXT_RANGE(0, r, 3, 1)
		    == 2 && Same(buf, "bc"));
	    TOCHECK(@call TOText::MSG_VIS_TEXT_GET_TEXT_RANGE(0, r, 100, 6)
		    == 2 && Same(buf, "gh"));
	    TOCHECK(@call TOText::MSG_VIS_TEXT_GET_TEXT_RANGE(0, r,
			TEXT_ADDRESS_PAST_END, TEXT_ADDRESS_PAST_END)
		    == 0 && !buf[0]);
	}
	break;
    case 5:
	/* the selection: all, the ends, deleted by the user */
	@call TOText::MSG_VIS_TEXT_SELECT_ALL();
	TOCHECK(Selection(@TOText, 0, 8));
	@call TOText::MSG_VIS_TEXT_SELECT_END();
	TOCHECK(Selection(@TOText, 8, 8));
	@call TOText::MSG_VIS_TEXT_SELECT_START();
	TOCHECK(Selection(@TOText, 0, 0));
	@call TOText::MSG_VIS_TEXT_SELECT_RANGE(6, 2);
	TOCHECK(Selection(@TOText, 2, 6));
	@call TOText::MSG_VIS_TEXT_SELECT_RANGE(3, 5);	/* in order */
	TOCHECK(Selection(@TOText, 3, 5));
	@call TOText::MSG_VIS_TEXT_SELECT_RANGE(100, 7);	/* in the text */
	TOCHECK(Selection(@TOText, 7, 8));
	@call TOText::MSG_VIS_TEXT_SELECT_RANGE_SMALL(2, 6);
	{
	    VisTextRange r;

	    r.VTR_start = VIS_TEXT_RANGE_SELECTION;
	    r.VTR_end = 0;
	    @call TOText::MSG_VIS_TEXT_GET_RANGE(&r, 0);
	    TOCHECK(r.VTR_start == 2 && r.VTR_end == 6);
	    r.VTR_start = 1;
	    r.VTR_end = TEXT_ADDRESS_PAST_END;
	    @call TOText::MSG_VIS_TEXT_GET_RANGE(&r, 0);
	    TOCHECK(r.VTR_start == 1 && r.VTR_end == 8);
	}
	@call TOText::MSG_META_DELETE();
	TOCHECK(Is(@TOText, "abgh"));
	TOCHECK(Selection(@TOText, 2, 2));
	TOCHECK(toState.TOS_modified == 2);
	@call TOText::MSG_VIS_TEXT_SELECT_RANGE_SMALL(0, 1);
	@call TOText::MSG_VIS_TEXT_DELETE_SELECTION();
	TOCHECK(Is(@TOText, "bgh"));
	TOCHECK(toState.TOS_notModified == 2);
	{
	    VisTextRange r;

	    r.VTR_start = 1;
	    r.VTR_end = 2;
	    @call TOText::MSG_META_DELETE_RANGE_OF_CHARS(r);
	}
	TOCHECK(Is(@TOText, "bh"));
	TOCHECK(toState.TOS_modified == 3);
	break;
    case 6: {
	/* chunks: the text from one (of the object's block), into one
	 * that is there (made as large) and into a new one; blocks */
	optr c;
	MemHandle mh, m2;
	char *t;

	@call TOText::MSG_VIS_TEXT_REPLACE_ALL_OPTR(@TOString, 0);
	TOCHECK(Is(@TOText, "from a chunk"));
	@call TOText::MSG_VIS_TEXT_APPEND_OPTR(@TOString, 4);
	TOCHECK(Is(@TOText, "from a chunkfrom"));
	@call TOText::MSG_VIS_TEXT_SELECT_RANGE_SMALL(4, 12);
	@call TOText::MSG_VIS_TEXT_REPLACE_SELECTION_OPTR(@TOString, 0);
	TOCHECK(Is(@TOText, "fromfrom a chunkfrom"));
	TOCHECK(Selection(@TOText, 16, 16));
	TOCHECK(@call TOText::MSG_VIS_TEXT_GET_ALL_OPTR(@TOBuffer) ==
		OptrToChunk(@TOBuffer));
	TOCHECK(ChunkIs(@TOBuffer, "fromfrom a chunkfrom"));
	c = ConstructOptr(OptrToHandle(@TOText),
		@call TOText::MSG_VIS_TEXT_GET_ALL_OPTR(
			ConstructOptr(OptrToHandle(@TOText), 0)));
	TOCHECK(OptrToChunk(c) != 0 && c != @TOBuffer &&
		ChunkIs(c, "fromfrom a chunkfrom"));
	LMemFree(c);
	TOCHECK(ChunkIs(@TOString, "from a chunk"));

	mh = MemAlloc(16, HF_SWAPABLE, HAF_NO_ERR);
	t = MemLock(mh);
	memcpy(t, "in a block", 11);
	MemUnlock(mh);
	@call TOText::MSG_VIS_TEXT_REPLACE_ALL_BLOCK(mh, 0);
	TOCHECK(Is(@TOText, "in a block"));
	@call TOText::MSG_VIS_TEXT_APPEND_BLOCK(mh, 2);
	@call TOText::MSG_VIS_TEXT_SELECT_RANGE_SMALL(0, 3);
	@call TOText::MSG_VIS_TEXT_REPLACE_SELECTION_BLOCK(mh, 4);
	TOCHECK(Is(@TOText, "in aa blockin"));
	TOCHECK(@call TOText::MSG_VIS_TEXT_GET_ALL_BLOCK(mh) == mh);
	t = MemLock(mh);
	TOCHECK(Same(t, "in aa blockin"));
	MemUnlock(mh);
	m2 = @call TOText::MSG_VIS_TEXT_GET_ALL_BLOCK(0);
	TOCHECK(m2 != 0 && m2 != mh);
	if (m2) {
	    t = MemLock(m2);
	    TOCHECK(Same(t, "in aa blockin"));
	    MemFree(m2);
	}
	MemFree(mh);
	break;
    }
    case 7:
	/* the maximum length: a shorter one cuts the text and keeps the
	 * selection in it; more is refused, or cut where asked */
	TOCHECK(@call TOText::MSG_VIS_TEXT_GET_MAX_LENGTH() == 10000);
	@call TOText::MSG_VIS_TEXT_REPLACE_ALL_PTR("abcdefgh", 0);
	@call TOText::MSG_VIS_TEXT_SELECT_RANGE_SMALL(2, 7);
	@call TOText::MSG_VIS_TEXT_SET_MAX_LENGTH(4);
	TOCHECK(@call TOText::MSG_VIS_TEXT_GET_MAX_LENGTH() == 4);
	TOCHECK(Is(@TOText, "abcd"));
	TOCHECK(Selection(@TOText, 2, 4));
	@call TOText::MSG_VIS_TEXT_APPEND_PTR("e", 0);
	TOCHECK(Is(@TOText, "abcd"));
	memset(&p, 0, sizeof(p));
	p.VTRP_range.VTR_start = 1;
	p.VTRP_range.VTR_end = 3;
	p.VTRP_insCount = 3;
	p.VTRP_textReference.TR_type = TRT_POINTER;
	p.VTRP_textReference.TR_ref.TRU_pointer.TRP_pointer = "XYZ";
	TOCHECK(@call TOText::MSG_VIS_TEXT_REPLACE_TEXT(&p));
	TOCHECK(Is(@TOText, "abcd"));
	p.VTRP_flags = VTRF_TRUNCATE;
	TOCHECK(!@call TOText::MSG_VIS_TEXT_REPLACE_TEXT(&p));
	TOCHECK(Is(@TOText, "aXYd"));
	@call TOText::MSG_VIS_TEXT_SET_MAX_LENGTH(100);
	@call TOText::MSG_VIS_TEXT_APPEND_PTR("e", 0);
	TOCHECK(Is(@TOText, "aXYde"));
	break;
    case 8: {
	/* an object of a resource without a text; a new object:
	 * editable and selectable, empty, as long as it likes; the
	 * plain instance data */
	optr n;

	TOCHECK(Is(@TOEmpty, ""));
	TOCHECK(!@call TOEmpty::MSG_VIS_TEXT_GET_STATE());
	@call TOEmpty::MSG_VIS_TEXT_APPEND_PTR("one", 0);
	TOCHECK(Is(@TOEmpty, "one"));
	TOCHECK(toState.TOS_notEmpty == 2);
	TOCHECK(Is(@TOText, "aXYde"));

	n = ObjInstantiate(OptrToHandle(@TOText),
			   (ClassStruct *) &TOTextClass);
	TOCHECK(n != 0);
	TOCHECK(@call n::MSG_VIS_TEXT_GET_STATE() ==
		(VTS_EDITABLE | VTS_SELECTABLE));
	TOCHECK(@call n::MSG_VIS_TEXT_GET_MAX_LENGTH() == 0xffff);
	TOCHECK(Is(n, ""));
	@call n::MSG_VIS_TEXT_REPLACE_ALL_PTR("new", 0);
	TOCHECK(Is(n, "new") && Is(@TOEmpty, "one"));
	@call n::MSG_VIS_TEXT_MODIFY_EDITABLE_SELECTABLE(0, VTS_EDITABLE);
	TOCHECK(@call n::MSG_VIS_TEXT_GET_STATE() == VTS_SELECTABLE);
	@call n::MSG_VIS_TEXT_SET_FEATURES(VTF_ALLOW_UNDO, 0);
	TOCHECK(@call n::MSG_VIS_TEXT_GET_FEATURES() == VTF_ALLOW_UNDO);
	@call n::MSG_VIS_TEXT_SET_FEATURES(0, VTF_ALLOW_UNDO);
	TOCHECK(!@call n::MSG_VIS_TEXT_GET_FEATURES());
	@call n::MSG_VIS_TEXT_SET_OUTPUT(@TOText);
	TOCHECK(@call n::MSG_VIS_TEXT_GET_OUTPUT() == @TOText);
	@call n::MSG_VIS_TEXT_SET_LR_MARGIN(3);
	@call n::MSG_VIS_TEXT_SET_TB_MARGIN(2);
	TOCHECK(@call n::MSG_VIS_TEXT_GET_LR_MARGIN() == 3 &&
		@call n::MSG_VIS_TEXT_GET_TB_MARGIN() == 2);
	@call n::MSG_VIS_TEXT_SET_FILTER(VTF_NO_TABS);
	TOCHECK(@call n::MSG_VIS_TEXT_GET_FILTER() == VTF_NO_TABS);
	@call n::MSG_VIS_TEXT_SET_USER_MODIFIED();
	TOCHECK(@call n::MSG_VIS_TEXT_GET_USER_MODIFIED_STATE());
	@call n::MSG_VIS_TEXT_SET_NOT_USER_MODIFIED();
	TOCHECK(!@call n::MSG_VIS_TEXT_GET_USER_MODIFIED_STATE());
	break;
    }
    case 9: {
	/* the character attribute: the default record (Berkeley 12),
	 * changed field by field; kept as a record while one can say
	 * it, else in a chunk */
	VisTextCharAttr a, b;
	VisTextCharAttrDiffs d;
	VisTextInstance *t;
	WWFixed size;
	ColorQuad c;
	word chunks;

	t = ObjDerefVis(@TOText);
	TOCHECK((t->VTI_storageFlags & VTSF_DEFAULT_CHAR_ATTR) &&
		t->VTI_charAttrRuns == VIS_TEXT_INITIAL_CHAR_ATTR);
	chunks = ChunkCount(OptrToHandle(@TOText));
	(void) @call TOText::MSG_VIS_TEXT_GET_CHAR_ATTR(0, &d, &a, 0, 0);
	TOCHECK(a.VTCA_fontID == FID_BERKELEY &&
		a.VTCA_pointSize.WBF_int == 12 &&
		a.VTCA_pointSize.WBF_frac == 0 && a.VTCA_textStyles == 0);
	TOCHECK(a.VTCA_color.CQ_info == CF_INDEX &&
		a.VTCA_color.CQ_redOrIndex == C_BLACK &&
		a.VTCA_bgColor.CQ_redOrIndex == C_WHITE &&
		a.VTCA_grayScreen == SDM_100 && a.VTCA_bgGrayScreen == SDM_0);
	TOCHECK(a.VTCA_fontWeight == FW_NORMAL &&
		a.VTCA_fontWidth == FWI_MEDIUM &&
		a.VTCA_meta.SSEH_style == CA_NULL_ELEMENT);
	TOCHECK(d.VTCAD_diffs == 0 && d.VTCAD_textStyles == 0);

	/* another default record */
	@call TOText::MSG_VIS_TEXT_SET_CHAR_ATTR_BY_DEFAULT(
	    VTDCA_BOLD | VTDS_18 << VTDCA_SIZE_OFFSET | VTDF_URW_SANS |
	    C_BLUE << VTDCA_COLOR_OFFSET, TEXT_ADDRESS_PAST_END, 0);
	(void) @call TOText::MSG_VIS_TEXT_GET_CHAR_ATTR(0, &d, &a, 0, 0);
	TOCHECK(a.VTCA_fontID == FID_DTC_URW_SANS &&
		a.VTCA_pointSize.WBF_int == 18 &&
		a.VTCA_textStyles == TS_BOLD &&
		a.VTCA_color.CQ_redOrIndex == C_BLUE);
	t = ObjDerefVis(@TOText);
	TOCHECK(t->VTI_storageFlags & VTSF_DEFAULT_CHAR_ATTR);

	/* fields a record has: still a record */
	@call TOText::MSG_VIS_TEXT_SET_FONT_ID(FID_BERKELEY,
					       TEXT_ADDRESS_PAST_END, 0);
	size.WWF_int = 10;
	size.WWF_frac = 0;
	@call TOText::MSG_VIS_TEXT_SET_POINT_SIZE(size, TEXT_ADDRESS_PAST_END,
						  0);
	/* the same bits to set and to clear toggle */
	@call TOText::MSG_VIS_TEXT_SET_TEXT_STYLE(0, 0, TS_BOLD | TS_ITALIC,
						  TS_BOLD | TS_ITALIC,
						  TEXT_ADDRESS_PAST_END, 0);
	t = ObjDerefVis(@TOText);
	TOCHECK((t->VTI_storageFlags & VTSF_DEFAULT_CHAR_ATTR) &&
		t->VTI_charAttrRuns ==
		(VTDCA_ITALIC | VTDS_10 << VTDCA_SIZE_OFFSET | VTDF_BERKELEY |
		 C_BLUE << VTDCA_COLOR_OFFSET));
	TOCHECK(ChunkCount(OptrToHandle(@TOText)) == chunks);

	/* a size no record has: a chunk */
	size.WWF_int = 11;
	size.WWF_frac = 0x8000;
	@call TOText::MSG_VIS_TEXT_SET_POINT_SIZE(size, TEXT_ADDRESS_PAST_END,
						  0);
	t = ObjDerefVis(@TOText);
	TOCHECK(!(t->VTI_storageFlags & VTSF_DEFAULT_CHAR_ATTR));
	TOCHECK(ChunkCount(OptrToHandle(@TOText)) == chunks + 1);
	(void) @call TOText::MSG_VIS_TEXT_GET_CHAR_ATTR(0, &d, &a, 0, 0);
	TOCHECK(a.VTCA_pointSize.WBF_int == 11 &&
		a.VTCA_pointSize.WBF_frac == 0x80 &&
		a.VTCA_textStyles == TS_ITALIC &&
		a.VTCA_fontID == FID_BERKELEY);
	/* superscript and subscript: the new one wins; an RGB color */
	@call TOText::MSG_VIS_TEXT_SET_TEXT_STYLE(0, VTES_BOXED, 0,
						  TS_SUPERSCRIPT,
						  TEXT_ADDRESS_PAST_END, 0);
	@call TOText::MSG_VIS_TEXT_SET_TEXT_STYLE(0, 0, TS_ITALIC,
						  TS_SUBSCRIPT,
						  TEXT_ADDRESS_PAST_END, 0);
	c.CQ_redOrIndex = 10;
	c.CQ_info = CF_RGB;
	c.CQ_green = 20;
	c.CQ_blue = 30;
	@call TOText::MSG_VIS_TEXT_SET_COLOR(c, TEXT_ADDRESS_PAST_END, 0);
	(void) @call TOText::MSG_VIS_TEXT_GET_CHAR_ATTR(0, &d, &a, 0, 0);
	TOCHECK(a.VTCA_textStyles == TS_SUBSCRIPT &&
		a.VTCA_extendedStyles == VTES_BOXED);
	TOCHECK(a.VTCA_color.CQ_info == CF_RGB &&
		a.VTCA_color.CQ_redOrIndex == 10 &&
		a.VTCA_color.CQ_green == 20 && a.VTCA_color.CQ_blue == 30);

	/* compared with a passed attribute */
	b = a;
	b.VTCA_fontID = FID_DTC_URW_MONO;
	b.VTCA_textStyles = TS_SUBSCRIPT | TS_BOLD;
	memset(&d, 0, sizeof(d));
	(void) @call TOText::MSG_VIS_TEXT_GET_CHAR_ATTR(
	    VTGAF_MERGE_WITH_PASSED, &d, &b, 0, 0);
	TOCHECK(d.VTCAD_diffs == VTCAF_MULTIPLE_FONT_IDS &&
		d.VTCAD_textStyles == TS_BOLD &&
		d.VTCAD_extendedStyles == 0 &&
		b.VTCA_fontID == FID_BERKELEY);

	/* a whole attribute; one a record can say frees the chunk */
	a.VTCA_fontWeight = FW_NORMAL + 20;
	@call TOText::MSG_VIS_TEXT_SET_CHAR_ATTR(&a, TEXT_ADDRESS_PAST_END,
						 0);
	(void) @call TOText::MSG_VIS_TEXT_GET_CHAR_ATTR(0, &d, &b, 0, 0);
	TOCHECK(!memcmp(&a, &b, sizeof(a)));
	TOCHECK(ChunkCount(OptrToHandle(@TOText)) == chunks + 1);
	@call TOText::MSG_VIS_TEXT_SET_CHAR_ATTR_BY_DEFAULT(
	    VIS_TEXT_INITIAL_CHAR_ATTR, TEXT_ADDRESS_PAST_END, 0);
	t = ObjDerefVis(@TOText);
	TOCHECK((t->VTI_storageFlags & VTSF_DEFAULT_CHAR_ATTR) &&
		t->VTI_charAttrRuns == VIS_TEXT_INITIAL_CHAR_ATTR);
	TOCHECK(ChunkCount(OptrToHandle(@TOText)) == chunks);
	/* the text is as it was */
	TOCHECK(Is(@TOText, "aXYde"));
	break;
    }
    case 10: {
	/* the lines: none before the geometry is valid.  Berkeley 10:
	 * H is 7 wide, i 3, a space 4, a line 12 high with the baseline
	 * at 10.  The text is 50 wide. */
	struct { LineInfo li; FieldInfo more[2]; } b;
	VisTextGetLineInfoParameters gp;
	VisTextGetLineInfoReturnValues gr;
	VisTextGetLineOffsetAndFlagsParameters op;
	VisTextInstance *t;
	WWFixed size;

	TOCHECK(!((VisTextInstance *) ObjDerefVis(@TOText))->VTI_lines);
	gp.VTGLIP_buffer = &b.li;
	gp.VTGLIP_bsize = sizeof(b);
	gp.VTGLIP_line = 0;
	TOCHECK(@call TOText::MSG_VIS_TEXT_GET_LINE_INFO(&gr, &gp));
	size.WWF_int = 10;
	size.WWF_frac = 0;
	@call TOText::MSG_VIS_TEXT_SET_POINT_SIZE(size, TEXT_ADDRESS_PAST_END,
						  0);
	@call TOText::MSG_VIS_SET_SIZE(50, 40);
	@call TOText::MSG_VIS_NOTIFY_GEOMETRY_VALID();
	t = ObjDerefVis(@TOText);
	TOCHECK(t->VTI_lines && t->VTI_height.WBF_int == 12 &&
		!t->VTI_gstate);
	TOCHECK(!@call TOText::MSG_VIS_TEXT_GET_LINE_INFO(&gr, &gp));
	toState.TOS_line[0] = b.li.LI_flags;
	toState.TOS_line[1] = b.li.LI_firstField.FI_width;
	toState.TOS_line[2] = b.li.LI_firstField.FI_nChars;
	toState.TOS_line[3] = b.li.LI_hgt.WBF_int;
	TOCHECK(gr.VTGLIRV_byteCount ==
		offsetof(LineInfo, LI_firstField) + sizeof(FieldInfo));
	TOCHECK(b.li.LI_flags == (LF_STARTS_PARAGRAPH | LF_ENDS_PARAGRAPH |
				  LF_ENDS_IN_NULL | LF_NEEDS_DRAW));
	TOCHECK(b.li.LI_count.WAAH_low == 5 &&
		b.li.LI_firstField.FI_nChars == 5 &&
		b.li.LI_hgt.WBF_int == 12 && b.li.LI_blo.WBF_int == 10);
	gp.VTGLIP_line = 1;
	TOCHECK(@call TOText::MSG_VIS_TEXT_GET_LINE_INFO(&gr, &gp));

	/* word wrap: three words fit, the space after them stays */
	@call TOText::MSG_VIS_TEXT_REPLACE_ALL_PTR("Hi Hi Hi Hi Hi", 0);
	t = ObjDerefVis(@TOText);
	TOCHECK(t->VTI_height.WBF_int == 24);
	gp.VTGLIP_line = 0;
	TOCHECK(!@call TOText::MSG_VIS_TEXT_GET_LINE_INFO(&gr, &gp));
	toState.TOS_line[4] = b.li.LI_flags;
	toState.TOS_line[5] = b.li.LI_firstField.FI_width;
	toState.TOS_line[6] = b.li.LI_lineEnd;
	toState.TOS_line[7] = b.li.LI_count.WAAH_low;
	TOCHECK(b.li.LI_flags == (LF_STARTS_PARAGRAPH | LF_NEEDS_DRAW));
	TOCHECK(b.li.LI_count.WAAH_low == 9 &&
		b.li.LI_firstField.FI_width == 42 &&
		b.li.LI_lineEnd == 38 && b.li.LI_adjustment == 0);
	gp.VTGLIP_line = 1;
	TOCHECK(!@call TOText::MSG_VIS_TEXT_GET_LINE_INFO(&gr, &gp));
	TOCHECK(b.li.LI_flags == (LF_ENDS_PARAGRAPH | LF_ENDS_IN_NULL |
				  LF_NEEDS_DRAW));
	TOCHECK(b.li.LI_count.WAAH_low == 5 &&
		b.li.LI_firstField.FI_width == 24 &&
		b.li.LI_firstField.FI_position == 0);
	gp.VTGLIP_line = 2;
	TOCHECK(@call TOText::MSG_VIS_TEXT_GET_LINE_INFO(&gr, &gp));
	TOCHECK(@call TOText::MSG_VIS_TEXT_GET_LINE_FROM_OFFSET(8) == 0 &&
		@call TOText::MSG_VIS_TEXT_GET_LINE_FROM_OFFSET(9) == 1 &&
		@call TOText::MSG_VIS_TEXT_GET_LINE_FROM_OFFSET(14) == 1);
	op.VTGLOAFP_line = 1;
	TOCHECK(!@call TOText::MSG_VIS_TEXT_GET_LINE_OFFSET_AND_FLAGS(&op) &&
		op.VTGLOAFP_offset == 9 &&
		(op.VTGLOAFP_flags & LF_ENDS_IN_NULL));
	op.VTGLOAFP_line = 2;
	TOCHECK(@call TOText::MSG_VIS_TEXT_GET_LINE_OFFSET_AND_FLAGS(&op));

	/* right justified, centered: the line moved (LI_adjustment) */
	t = ObjDerefVis(@TOText);
	t->VTI_paraAttrRuns = DEF_PARA_ATTR_JUST_TABS(J_RIGHT, VTDDT_HALF_INCH);
	@call TOText::MSG_VIS_TEXT_RECALC_AND_DRAW();
	gp.VTGLIP_line = 0;
	(void) @call TOText::MSG_VIS_TEXT_GET_LINE_INFO(&gr, &gp);
	toState.TOS_line[8] = b.li.LI_adjustment;
	TOCHECK(b.li.LI_adjustment == 12 && b.li.LI_lineEnd == 50);
	gp.VTGLIP_line = 1;
	(void) @call TOText::MSG_VIS_TEXT_GET_LINE_INFO(&gr, &gp);
	TOCHECK(b.li.LI_adjustment == 26);
	t = ObjDerefVis(@TOText);
	t->VTI_paraAttrRuns = DEF_PARA_ATTR_JUST_TABS(J_CENTER,
						      VTDDT_HALF_INCH);
	@call TOText::MSG_VIS_TEXT_RECALC_AND_DRAW();
	(void) @call TOText::MSG_VIS_TEXT_GET_LINE_INFO(&gr, &gp);
	TOCHECK(b.li.LI_adjustment == 13);
	/* fully justified: the spaces of a wrapped line padded (two
	 * count, 12 to share), the last field as much wider; not the
	 * paragraph's last line */
	t = ObjDerefVis(@TOText);
	t->VTI_paraAttrRuns = DEF_PARA_ATTR_JUST_TABS(J_FULL, VTDDT_HALF_INCH);
	@call TOText::MSG_VIS_TEXT_RECALC_AND_DRAW();
	gp.VTGLIP_line = 0;
	(void) @call TOText::MSG_VIS_TEXT_GET_LINE_INFO(&gr, &gp);
	toState.TOS_line[9] = b.li.LI_spacePad.WBF_int;
	toState.TOS_line[10] = b.li.LI_firstField.FI_width;
	TOCHECK(b.li.LI_spacePad.WBF_int == 6 && b.li.LI_adjustment == 0 &&
		b.li.LI_firstField.FI_width == 42 + 18 &&
		b.li.LI_lineEnd == 50);
	gp.VTGLIP_line = 1;
	(void) @call TOText::MSG_VIS_TEXT_GET_LINE_INFO(&gr, &gp);
	TOCHECK(b.li.LI_spacePad.WBF_int == 0 && b.li.LI_adjustment == 0);
	t = ObjDerefVis(@TOText);
	t->VTI_paraAttrRuns = VIS_TEXT_INITIAL_PARA_ATTR;

	/* a carriage return ends the paragraph; a tab starts a field at
	 * the next default tab stop (every half inch) */
	@call TOText::MSG_VIS_TEXT_REPLACE_ALL_PTR("H\ri\tH", 0);
	t = ObjDerefVis(@TOText);
	TOCHECK(t->VTI_height.WBF_int == 24);
	gp.VTGLIP_line = 0;
	(void) @call TOText::MSG_VIS_TEXT_GET_LINE_INFO(&gr, &gp);
	TOCHECK(b.li.LI_flags == (LF_STARTS_PARAGRAPH | LF_ENDS_PARAGRAPH |
				  LF_ENDS_IN_CR | LF_NEEDS_DRAW) &&
		b.li.LI_count.WAAH_low == 2 && b.li.LI_lineEnd == 7);
	gp.VTGLIP_line = 1;
	(void) @call TOText::MSG_VIS_TEXT_GET_LINE_INFO(&gr, &gp);
	toState.TOS_line[11] = gr.VTGLIRV_byteCount;
	toState.TOS_line[12] = b.more[0].FI_position;
	toState.TOS_line[13] = b.more[0].FI_tab;
	TOCHECK(gr.VTGLIRV_byteCount ==
		offsetof(LineInfo, LI_firstField) + 2 * sizeof(FieldInfo));
	TOCHECK(b.li.LI_count.WAAH_low == 3 &&
		b.li.LI_firstField.FI_nChars == 1 &&
		b.li.LI_firstField.FI_width == 3 &&
		b.more[0].FI_nChars == 2 && b.more[0].FI_position == 36 &&
		b.more[0].FI_width == 7 && b.more[0].FI_tab == 0x81 &&
		b.li.LI_lineEnd == 43);

	/* less text: the lines left over go; one edited in the middle */
	@call TOText::MSG_VIS_TEXT_REPLACE_ALL_PTR("Hi Hi Hi", 0);
	t = ObjDerefVis(@TOText);
	TOCHECK(t->VTI_height.WBF_int == 12 &&
		ChunkArrayGetCountHandles(OptrToHandle(@TOText),
					  t->VTI_lines) == 1);
	gp.VTGLIP_line = 0;
	(void) @call TOText::MSG_VIS_TEXT_GET_LINE_INFO(&gr, &gp);
	TOCHECK(gr.VTGLIRV_byteCount ==
		offsetof(LineInfo, LI_firstField) + sizeof(FieldInfo) &&
		b.li.LI_firstField.FI_width == 38);
	break;
    }
    case 11: {
	/* the sizes for the geometry: of the font; of the text on one
	 * line; the height at a width, asked only (nothing changes) and
	 * to be cached (the lines of another height go, to be made
	 * again when the geometry is valid) */
	VisTextInstance *t = ObjDerefVis(@TOText);
	word tb = 2 * t->VTI_tbMargin, lr = 2 * t->VTI_lrMargin;

	toState.TOS_geo[0] = @call TOText::MSG_VIS_TEXT_GET_LINE_HEIGHT();
	toState.TOS_geo[1] = @call TOText::MSG_VIS_TEXT_GET_AVERAGE_CHAR_WIDTH();
	toState.TOS_geo[2] = @call TOText::MSG_VIS_TEXT_GET_MIN_WIDTH();
	toState.TOS_geo[3] = @call TOText::MSG_VIS_TEXT_GET_SIMPLE_MIN_WIDTH();
	TOCHECK(toState.TOS_geo[0] >= 12 && toState.TOS_geo[0] <= 14);
	TOCHECK(toState.TOS_geo[1] >= 4 && toState.TOS_geo[1] <= 8);
	TOCHECK(toState.TOS_geo[2] == 47 + lr &&
		toState.TOS_geo[3] < toState.TOS_geo[2] &&
		toState.TOS_geo[3] > lr + 6);
	TOCHECK(@call TOText::MSG_VIS_TEXT_GET_ONE_LINE_WIDTH(0) == 38 &&
		@call TOText::MSG_VIS_TEXT_GET_ONE_LINE_WIDTH(2) == 10);
	@call TOText::MSG_VIS_TEXT_REPLACE_ALL_PTR("Hi Hi Hi Hi Hi", 0);
	t = ObjDerefVis(@TOText);
	TOCHECK(t->VTI_height.WBF_int == 24 && !t->VTI_gstate);
	toState.TOS_geo[4] = @call TOText::MSG_VIS_TEXT_CALC_HEIGHT(100, FALSE);
	t = ObjDerefVis(@TOText);
	TOCHECK(toState.TOS_geo[4] == 12 + tb);
	TOCHECK(t->VTI_height.WBF_int == 24 && t->VTI_lines &&
		t->VTI_lastWidth != 100 && !t->VTI_gstate &&
		t->VI_bounds.R_right - t->VI_bounds.R_left == 50);
	TOCHECK(ChunkArrayGetCountHandles(OptrToHandle(@TOText),
					  t->VTI_lines) == 2);
	TOCHECK(@call TOText::MSG_VIS_TEXT_CALC_HEIGHT(50, FALSE) == 24 + tb);
	toState.TOS_geo[5] = @call TOText::MSG_VIS_TEXT_CALC_HEIGHT(100, TRUE);
	t = ObjDerefVis(@TOText);
	TOCHECK(toState.TOS_geo[5] == 12 + tb && !t->VTI_lines &&
		t->VTI_lastWidth == 100 && t->VTI_height.WBF_int == 12);
	/* (the same width again: from the cache) */
	TOCHECK(@call TOText::MSG_VIS_TEXT_CALC_HEIGHT(100, TRUE) == 12 + tb);
	@call TOText::MSG_VIS_SET_SIZE(100, 40);
	@call TOText::MSG_VIS_NOTIFY_GEOMETRY_VALID();
	t = ObjDerefVis(@TOText);
	TOCHECK(t->VTI_lines && t->VTI_height.WBF_int == 12 &&
		ChunkArrayGetCountHandles(OptrToHandle(@TOText),
					  t->VTI_lines) == 1);
	/* a new character attribute: the lines made again at once
	 * (ReflectChange), the object user modified */
	TOCHECK(!(t->VTI_state & VTS_USER_MODIFIED));
	{
	    WWFixed size;

	    size.WWF_int = 24;
	    size.WWF_frac = 0;
	    @call TOText::MSG_VIS_TEXT_SET_POINT_SIZE(size,
						      TEXT_ADDRESS_PAST_END,
						      0);
	}
	t = ObjDerefVis(@TOText);
	TOCHECK(t->VTI_height.WBF_int >= 24 &&
		(t->VTI_state & VTS_USER_MODIFIED));
	/* (Berkeley 10 again) */
	{
	    WWFixed size;

	    size.WWF_int = 10;
	    size.WWF_frac = 0;
	    @call TOText::MSG_VIS_TEXT_SET_POINT_SIZE(size,
						      TEXT_ADDRESS_PAST_END,
						      0);
	}
	t = ObjDerefVis(@TOText);
	TOCHECK(t->VTI_height.WBF_int == 12);
	@call TOText::MSG_VIS_TEXT_SET_NOT_USER_MODIFIED();
	break;
    }
    case 12: {
	/* filters: one character refused refuses all of the text; not
	 * for text set by the program.  The classes, no spaces, no
	 * tabs (told to the object), upper case, a range of its own,
	 * every character by a message */
	VisTextCustomFilterData *d;
	VisTextExtendedFilterType *x;
	ChunkHandle *c, ranges;

	@call TOText::MSG_VIS_TEXT_REPLACE_ALL_PTR("a", 0);
	@call TOText::MSG_VIS_TEXT_SET_FILTER(VTFC_NUMERIC);
	TOCHECK(@call TOText::MSG_VIS_TEXT_GET_FILTER() == VTFC_NUMERIC);
	TOCHECK(Typed("x") && Typed("1x") && Typed("-") && Typed("."));
	TOCHECK(!Typed("12"));
	@call TOText::MSG_VIS_TEXT_APPEND_PTR("b", 0);
	@call TOText::MSG_VIS_TEXT_SET_FILTER(VTFC_SIGNED_NUMERIC);
	TOCHECK(!Typed("-") && Typed("+") && Typed("e"));
	@call TOText::MSG_VIS_TEXT_SET_FILTER(VTFC_ALPHA);
	/* (a space is in none of the groups) */
	TOCHECK(Typed("3") && Typed("_") && !Typed("cE") && !Typed(" "));
	@call TOText::MSG_VIS_TEXT_SET_FILTER(VTFC_ALPHA_NUMERIC);
	TOCHECK(Typed("-") && Typed("a.b"));
	@call TOText::MSG_VIS_TEXT_SET_FILTER(VTFC_DASHED_ALPHA_NUMERIC);
	TOCHECK(!Typed("-") && Typed("*"));
	@call TOText::MSG_VIS_TEXT_SET_FILTER(VTFC_DOS_FILENAMES);
	TOCHECK(Typed("?") && Typed(":") && Typed("\\") && Typed("[") &&
		Typed("+") && !Typed("."));
	@call TOText::MSG_VIS_TEXT_SET_FILTER(VTFC_NORMAL_ASCII);
	TOCHECK(Typed("\344") && Typed("\r"));
	@call TOText::MSG_VIS_TEXT_SET_FILTER(VTF_NO_SPACES | VTF_NO_TABS |
					      VTF_UPCASE_CHARS);
	TOCHECK(Typed("a b") && !toState.TOS_filter[1] && Typed("\t") &&
		toState.TOS_filter[1] == 1);
	TOCHECK(!Typed("f1"));
	/* its own range: no digits from 5 */
	@call TOText::MSG_VIS_TEXT_SET_FILTER(0);
	ranges = LMemAlloc(OptrToHandle(@TOText),
			   sizeof(VisTextCustomFilterData));
	d = LMemDerefHandles(OptrToHandle(@TOText), ranges);
	d->VTCFD_startOfRange = '5';
	d->VTCFD_endOfRange = '9';
	c = ObjVarAddData(@TOText, ATTR_VIS_TEXT_CUSTOM_FILTER, sizeof(*c));
	*c = ranges;
	TOCHECK(Typed("5") && Typed("47") && !Typed("4"));
	ObjVarDeleteData(@TOText, ATTR_VIS_TEXT_CUSTOM_FILTER);
	/* by the object */
	x = ObjVarAddData(@TOText, ATTR_VIS_TEXT_EXTENDED_FILTER, sizeof(*x));
	*x = VTEFT_CHARACTER_LEVELER_LEVEL;
	TOCHECK(!Typed("x") && toState.TOS_filter[0] == 1);
	TOCHECK(Typed("z#z") && toState.TOS_filter[0] == 3);
	ObjVarDeleteData(@TOText, ATTR_VIS_TEXT_EXTENDED_FILTER);
	TOCHECK(!Typed("#") && toState.TOS_filter[0] == 3);
	break;
    }
    case 13: {
	/* character attribute runs: a range of another font, text
	 * inserted in it and deleted across it, the font of the whole
	 * text again (one run), the attribute typed at a cursor */
	VisTextCharAttrDiffs d;
	VisTextCharAttr a;
	FontID base;
	word t, u;
	optr n;

	n = ObjInstantiate(OptrToHandle(@TOText),
			   (ClassStruct *) &VisTextClass);
	@call n::MSG_VIS_TEXT_REPLACE_ALL_PTR("abcdef", 0);
	@call n::MSG_VIS_TEXT_CREATE_STORAGE(VTSF_MULTIPLE_CHAR_ATTRS, 0);
	TOCHECK(((VisTextInstance *) ObjDerefVis(n))->VTI_storageFlags &
		VTSF_MULTIPLE_CHAR_ATTRS);
	TOCHECK(RunIs(n, 3, 0, TEXT_ADDRESS_PAST_END));
	TOCHECK(UsedElements(n) == 1);
	base = FontOf(n, 0, 6, &t, &d);
	TOCHECK(t == 0 && !d.VTCAD_diffs);
	@call n::MSG_VIS_TEXT_SET_FONT_ID(FID_ROMA, 4, 2);
	TOCHECK(RunIs(n, 0, 0, 2) && RunIs(n, 2, 2, 4) && RunIs(n, 3, 2, 4));
	TOCHECK(RunIs(n, 4, 4, TEXT_ADDRESS_PAST_END));
	TOCHECK(UsedElements(n) == 2);
	TOCHECK(FontOf(n, 2, 4, &t, &d) == FID_ROMA && t == 1);
	TOCHECK(FontOf(n, 0, 2, &t, &d) == base && t == 0);
	(void) FontOf(n, 0, 6, &t, &d);
	TOCHECK(t == CA_NULL_ELEMENT && d.VTCAD_diffs == VTCAF_MULTIPLE_FONT_IDS);
	/* in the run: it grows */
	ReplaceRange(n, 3, 3, "XY");
	TOCHECK(Is(n, "abcXYdef"));
	TOCHECK(RunIs(n, 2, 2, 6) && RunIs(n, 6, 6, TEXT_ADDRESS_PAST_END));
	/* across its start: what is left of it starts with the range */
	ReplaceRange(n, 1, 5, "");
	TOCHECK(Is(n, "adef"));
	TOCHECK(RunIs(n, 0, 0, 1) && RunIs(n, 1, 1, 2) &&
		RunIs(n, 2, 2, TEXT_ADDRESS_PAST_END));
	TOCHECK(FontOf(n, 1, 2, &t, &d) == FID_ROMA);
	/* one font: one run, one element */
	@call n::MSG_VIS_TEXT_SET_FONT_ID(base, TEXT_ADDRESS_PAST_END, 0);
	TOCHECK(RunIs(n, 1, 0, TEXT_ADDRESS_PAST_END));
	TOCHECK(UsedElements(n) == 1);
	/* bold at a cursor: for the text typed there only */
	@call n::MSG_VIS_TEXT_SELECT_RANGE(2, 2);
	@call n::MSG_VIS_TEXT_SET_TEXT_STYLE(0, 0, 0, TS_BOLD, 2, 2);
	TOCHECK(RunIs(n, 1, 0, TEXT_ADDRESS_PAST_END));
	TOCHECK(ObjVarFindData(n, ATTR_VIS_TEXT_CHAR_ATTR_INSERTION_TOKEN));
	(void) @call n::MSG_VIS_TEXT_GET_CHAR_ATTR(0, &d, &a, 2, 2);
	TOCHECK(a.VTCA_textStyles == TS_BOLD);
	ReplaceRange(n, 2, 2, "Z");
	TOCHECK(Is(n, "adZef"));
	TOCHECK(!ObjVarFindData(n, ATTR_VIS_TEXT_CHAR_ATTR_INSERTION_TOKEN));
	TOCHECK(RunIs(n, 2, 2, 3) && RunIs(n, 3, 3, TEXT_ADDRESS_PAST_END));
	(void) @call n::MSG_VIS_TEXT_GET_CHAR_ATTR(0, &d, &a, 3, 2);
	TOCHECK(a.VTCA_textStyles == TS_BOLD);
	(void) @call n::MSG_VIS_TEXT_GET_CHAR_ATTR(0, &d, &a, 4, 3);
	TOCHECK(a.VTCA_textStyles == 0);
	/* a new cursor gives up an attribute not typed with */
	@call n::MSG_VIS_TEXT_SET_TEXT_STYLE(0, 0, 0, TS_ITALIC, 1, 1);
	u = UsedElements(n);
	TOCHECK(u == 3);
	@call n::MSG_VIS_TEXT_SELECT_RANGE(4, 4);
	TOCHECK(UsedElements(n) == 2);
	break;
    }
    case 14: {
	/* paragraph attribute runs: a margin for one paragraph (the
	 * range grows to whole paragraphs), the paragraphs joined, a
	 * tab; a single attribute kept as a default record while one
	 * says it */
	VisTextParaAttrDiffs d;
	VisTextMaxParaAttr a;
	VisTextInstance *vi;
	Tab tab;
	optr n;

	n = ObjInstantiate(OptrToHandle(@TOText),
			   (ClassStruct *) &VisTextClass);
	@call n::MSG_VIS_TEXT_REPLACE_ALL_PTR("ab\rcd\ref", 0);
	@call n::MSG_VIS_TEXT_SET_LEFT_MARGIN(72 * 8, 0, 0);
	vi = (VisTextInstance *) ObjDerefVis(n);
	TOCHECK(vi->VTI_storageFlags & VTSF_DEFAULT_PARA_ATTR);
	@call n::MSG_VIS_TEXT_SET_LEADING(3 * 8, 0, 0);
	vi = (VisTextInstance *) ObjDerefVis(n);
	TOCHECK(!(vi->VTI_storageFlags & VTSF_DEFAULT_PARA_ATTR));
	(void) ParaOf(n, 0, 0, &a, &d);
	TOCHECK(a.VTMPA_paraAttr.VTPA_leftMargin == 72 * 8 &&
		a.VTMPA_paraAttr.VTPA_leading == 3 * 8);
	@call n::MSG_VIS_TEXT_SET_LEADING(0, 0, 0);
	@call n::MSG_VIS_TEXT_SET_LEFT_MARGIN(0, 0, 0);
	vi = (VisTextInstance *) ObjDerefVis(n);
	TOCHECK(vi->VTI_storageFlags & VTSF_DEFAULT_PARA_ATTR);

	@call n::MSG_VIS_TEXT_CREATE_STORAGE(VTSF_MULTIPLE_PARA_ATTRS, 0);
	vi = (VisTextInstance *) ObjDerefVis(n);
	TOCHECK((vi->VTI_storageFlags & (VTSF_MULTIPLE_PARA_ATTRS |
					 VTSF_DEFAULT_PARA_ATTR)) ==
		VTSF_MULTIPLE_PARA_ATTRS);
	TOCHECK(ParaRunIs(n, 4, 0, TEXT_ADDRESS_PAST_END));
	/* the second paragraph ("cd\r", 3 to 6) */
	@call n::MSG_VIS_TEXT_SET_LEFT_MARGIN(72 * 8, 4, 4);
	TOCHECK(ParaRunIs(n, 1, 0, 3) && ParaRunIs(n, 3, 3, 6) &&
		ParaRunIs(n, 6, 6, TEXT_ADDRESS_PAST_END));
	TOCHECK(ParaOf(n, 5, 5, &a, &d) != CA_NULL_ELEMENT &&
		a.VTMPA_paraAttr.VTPA_leftMargin == 72 * 8);
	TOCHECK(ParaOf(n, 0, 8, &a, &d) == CA_NULL_ELEMENT &&
		a.VTMPA_paraAttr.VTPA_leftMargin == 0 &&
		d.VTPAD_diffs == VTPAF_MULTIPLE_LEFT_MARGINS);
	/* joined: the paragraph keeps the first one's attribute */
	ReplaceRange(n, 2, 4, "");
	TOCHECK(Is(n, "abd\ref"));
	TOCHECK(ParaRunIs(n, 4, 0, TEXT_ADDRESS_PAST_END));
	(void) ParaOf(n, 1, 1, &a, &d);
	TOCHECK(a.VTMPA_paraAttr.VTPA_leftMargin == 0);
	/* a tab for the last paragraph */
	memset(&tab, 0, sizeof(tab));
	tab.T_position = 36 * 8;
	@call n::MSG_VIS_TEXT_SET_TAB(tab, 5, 5);
	TOCHECK(ParaRunIs(n, 0, 0, 4) &&
		ParaRunIs(n, 4, 4, TEXT_ADDRESS_PAST_END));
	(void) ParaOf(n, 4, 4, &a, &d);
	TOCHECK(a.VTMPA_paraAttr.VTPA_numberOfTabs == 1 &&
		a.VTMPA_tabs[0].T_position == 36 * 8);
	tab.T_position = 18 * 8;
	@call n::MSG_VIS_TEXT_SET_TAB(tab, 5, 5);
	@call n::MSG_VIS_TEXT_MOVE_TAB(54 * 8, 36 * 8, 5, 5);
	(void) ParaOf(n, 4, 4, &a, &d);
	TOCHECK(a.VTMPA_paraAttr.VTPA_numberOfTabs == 2 &&
		a.VTMPA_tabs[0].T_position == 18 * 8 &&
		a.VTMPA_tabs[1].T_position == 54 * 8);
	@call n::MSG_VIS_TEXT_CLEAR_ALL_TABS(5, 5);
	TOCHECK(ParaRunIs(n, 4, 0, TEXT_ADDRESS_PAST_END));
	break;
    }
    case 15: {
	/* a position shown: an object not on the screen does nothing
	 * (keeps its selection, asks nobody); a plain object without a
	 * view to ask */
	VisTextRange r;
	optr n;

	@call TOText::MSG_VIS_TEXT_SELECT_RANGE(2, 2);
	@call TOText::MSG_VIS_TEXT_SHOW_POSITION(5);
	@call TOText::MSG_VIS_TEXT_GET_SELECTION_RANGE(&r);
	TOCHECK(r.VTR_start == 2 && r.VTR_end == 2);
	TOCHECK(!toState.TOS_shown);
	n = ObjInstantiate(OptrToHandle(@TOText),
			   (ClassStruct *) &VisTextClass);
	TOCHECK(n != 0);
	@call n::MSG_VIS_TEXT_SHOW_SELECTION(0, 0, MRVM_50_PERCENT, 0,
					     MRVM_50_PERCENT, 10, 0, 0, 0);
	@call n::MSG_VIS_TEXT_SHOW_POSITION(0);
	TOCHECK(!toState.TOS_shown);
	break;
    }
    case 16: {
	/* the notifications: of a type, the standard ones; not the
	 * target: for nobody.  With ATTR_VIS_TEXT_NOTIFY_EVEN_IF_NOT_
	 * TARGETED made (the application's list, none here, keeps its
	 * reference): the count of the text */
	VisTextNotifyCountChange *c;
	word state = @call TOText::MSG_VIS_TEXT_GET_STATE();

	/* (neither editable nor targetable: only the select state) */
	@call TOText::MSG_VIS_TEXT_MODIFY_EDITABLE_SELECTABLE(VTS_EDITABLE,
							      0);
	toState.TOS_generated = 0;
	@call TOText::MSG_META_UI_FORCE_CONTROLLER_UPDATE(
			MANUFACTURER_ID_GEOWORKS, GWNT_TEXT_COUNT_CHANGE);
	TOCHECK(toState.TOS_generated == 1 &&
		toState.TOS_types == VTNF_COUNT &&
		!(toState.TOS_send & VTNSF_UPDATE_APP_TARGET_GCN_LISTS) &&
		!toState.TOS_countBlock);
	@call TOText::MSG_META_UI_FORCE_CONTROLLER_UPDATE(0xffff, 0);
	TOCHECK(toState.TOS_generated == 2 &&
		toState.TOS_types == (VIS_TEXT_STANDARD_NOTIFICATION_FLAGS &
				      ~(VTNF_TYPE | VTNF_NAME)));
	(void) ObjVarAddData(@TOText,
			     ATTR_VIS_TEXT_NOTIFY_EVEN_IF_NOT_TARGETED, 0);
	@call TOText::MSG_META_UI_FORCE_CONTROLLER_UPDATE(
			MANUFACTURER_ID_GEOWORKS, GWNT_TEXT_COUNT_CHANGE);
	TOCHECK(toState.TOS_generated == 3 &&
		(toState.TOS_send & VTNSF_UPDATE_APP_TARGET_GCN_LISTS) &&
		toState.TOS_countBlock);
	if (toState.TOS_countBlock) {
	    c = MemLock(toState.TOS_countBlock);
	    TOCHECK(c->VTNCC_charCount == 15 && c->VTNCC_wordCount == 3);
	    MemUnlock(toState.TOS_countBlock);
	    MemDecRefCount(toState.TOS_countBlock);
	}
	(void) ObjVarDeleteData(@TOText,
				ATTR_VIS_TEXT_NOTIFY_EVEN_IF_NOT_TARGETED);
	/* (a manufacturer's own types: nothing) */
	@call TOText::MSG_META_UI_FORCE_CONTROLLER_UPDATE(1, 0);
	TOCHECK(toState.TOS_generated == 3);
	if (!(state & VTS_EDITABLE))
	    @call TOText::MSG_VIS_TEXT_MODIFY_EDITABLE_SELECTABLE(0,
							VTS_EDITABLE);
	break;
    }
    case 17: {
	/* overstrike mode: a cursor's character replaced, not at the
	 * end; insert mode again.  Smart quotes ([text] smartQuotes): an
	 * opening one at the start and after a space, else a closing one */
	optr n = ObjInstantiate(OptrToHandle(@TOText),
				(ClassStruct *) &VisTextClass);
	char buf[16];

	@call n::MSG_VIS_TEXT_REPLACE_ALL_PTR("abc", 0);
	@call n::MSG_VIS_TEXT_SELECT_RANGE(1, 1);
	@call n::MSG_VIS_TEXT_ENTER_OVERSTRIKE_MODE(FALSE);
	TOCHECK(@call n::MSG_VIS_TEXT_GET_STATE() & VTS_OVERSTRIKE_MODE);
	@call n::MSG_META_KBD_CHAR('X', CF_FIRST_PRESS, 0);
	@call n::MSG_VIS_TEXT_SELECT_RANGE(3, 3);
	@call n::MSG_META_KBD_CHAR('Y', CF_FIRST_PRESS, 0);
	TOCHECK(Is(n, "aXcY"));
	@call n::MSG_VIS_TEXT_ENTER_INSERT_MODE(FALSE);
	TOCHECK(!(@call n::MSG_VIS_TEXT_GET_STATE() & VTS_OVERSTRIKE_MODE));
	@call n::MSG_VIS_TEXT_SELECT_RANGE(1, 1);
	@call n::MSG_META_KBD_CHAR('Z', CF_FIRST_PRESS, 0);
	TOCHECK(Is(n, "aZXcY"));

	@call n::MSG_VIS_TEXT_REPLACE_ALL_PTR("", 0);
	@call n::MSG_META_KBD_CHAR('"', CF_FIRST_PRESS, 0);
	TOCHECK(Is(n, "\""));		/* (smart quotes not allowed) */
	@call n::MSG_VIS_TEXT_SET_FEATURES(VTF_ALLOW_SMART_QUOTES, 0);
	InitFileWriteBoolean("text", "smartQuotes", TRUE);
	@call n::MSG_VIS_TEXT_REPLACE_ALL_PTR("", 0);
	@call n::MSG_META_KBD_CHAR('"', CF_FIRST_PRESS, 0);
	@call n::MSG_META_KBD_CHAR('a', CF_FIRST_PRESS, 0);
	@call n::MSG_META_KBD_CHAR('\'', CF_FIRST_PRESS, 0);
	@call n::MSG_META_KBD_CHAR(' ', CF_FIRST_PRESS, 0);
	@call n::MSG_META_KBD_CHAR('\'', CF_FIRST_PRESS, 0);
	buf[0] = (char) C_QUOTEDBLLEFT;
	buf[1] = 'a';
	buf[2] = (char) C_QUOTESNGRIGHT;
	buf[3] = ' ';
	buf[4] = (char) C_QUOTESNGLEFT;
	buf[5] = 0;
	TOCHECK(Is(n, buf));
	InitFileDeleteEntry("text", "smartQuotes");
	break;
    }
    case 18: {
	/* the view's scrolling on whole lines (Berkeley 10: 12 high):
	 * a line down, a line up from a line's top and from within one,
	 * the suggestion kept for the other actions */
	optr n = ObjInstantiate(OptrToHandle(@TOText),
				(ClassStruct *) &VisTextClass);
	TrackScrollingParams p;
	VisTextInstance *t;
	WWFixed size;
	sdword base;

	size.WWF_int = 10;
	size.WWF_frac = 0;
	@call n::MSG_VIS_TEXT_SET_POINT_SIZE(size, TEXT_ADDRESS_PAST_END, 0);
	@call n::MSG_VIS_SET_SIZE(50, 40);
	@call n::MSG_VIS_NOTIFY_GEOMETRY_VALID();
	@call n::MSG_VIS_TEXT_REPLACE_ALL_PTR("a\rb\rc\rd\re", 0);
	t = ObjDerefVis(n);
	TOCHECK(t->VTI_height.WBF_int == 60);
	base = t->VI_bounds.R_top + t->VTI_tbMargin;
	memset(&p, 0, sizeof(p));
	p.TSP_flags = SF_VERTICAL;
	p.TSP_viewHeight = 12;
	p.TSP_change.PD_y = 7;
	p.TSP_action = SA_INC_FWD;
	p.TSP_oldOrigin.PD_y = base;
	TOCHECK(@call n::MSG_VIS_TEXT_GET_SCROLL_AMOUNT(&p) == 12);
	p.TSP_action = SA_INC_BACK;
	p.TSP_oldOrigin.PD_y = base + 24;
	TOCHECK(@call n::MSG_VIS_TEXT_GET_SCROLL_AMOUNT(&p) == -12);
	p.TSP_oldOrigin.PD_y = base + 30;
	TOCHECK(@call n::MSG_VIS_TEXT_GET_SCROLL_AMOUNT(&p) == -6);
	p.TSP_action = SA_TO_END;
	TOCHECK(@call n::MSG_VIS_TEXT_GET_SCROLL_AMOUNT(&p) == 7);
	/* (MSG_META_SELECT_ALL) */
	{
	    VisTextRange r;

	    @call n::MSG_META_SELECT_ALL();
	    @call n::MSG_VIS_TEXT_GET_SELECTION_RANGE(&r);
	    TOCHECK(r.VTR_start == 0 && r.VTR_end == 9);
	}
	break;
    }
    case 19: {
	/* a paragraph's border (1 wide, 2 apart): room above and below
	 * the line, the left margin moved past it, the sides drawn into
	 * a bitmap; the paragraph's own background inside it */
	optr n = ObjInstantiate(OptrToHandle(@TOText),
				(ClassStruct *) &VisTextClass);
	struct { LineInfo li; FieldInfo more[2]; } b;
	VisTextGetLineInfoParameters gp;
	VisTextGetLineInfoReturnValues gr;
	VisTextInstance *t;
	VMFileHandle vm;
	GStateHandle g;
	ColorQuad gray;
	WWFixed size;
	sword x, y;

	size.WWF_int = 10;
	size.WWF_frac = 0;
	@call n::MSG_VIS_TEXT_SET_POINT_SIZE(size, TEXT_ADDRESS_PAST_END, 0);
	@call n::MSG_VIS_SET_SIZE(50, 40);
	@call n::MSG_VIS_NOTIFY_GEOMETRY_VALID();
	@call n::MSG_VIS_TEXT_REPLACE_ALL_PTR("Hi", 0);
	@call n::MSG_VIS_TEXT_SET_BORDER_BITS(0, VTPBF_LEFT | VTPBF_TOP |
					      VTPBF_RIGHT | VTPBF_BOTTOM,
					      TEXT_ADDRESS_PAST_END, 0);
	t = ObjDerefVis(n);
	toState.TOS_border[0] = t->VTI_height.WBF_int;
	gp.VTGLIP_buffer = &b.li;
	gp.VTGLIP_bsize = sizeof(b);
	gp.VTGLIP_line = 0;
	TOCHECK(!@call n::MSG_VIS_TEXT_GET_LINE_INFO(&gr, &gp));
	toState.TOS_border[1] = b.li.LI_blo.WBF_int;
	toState.TOS_border[2] = b.li.LI_adjustment;
	TOCHECK(t->VTI_height.WBF_int == 18 && b.li.LI_blo.WBF_int == 13 &&
		b.li.LI_adjustment == 3);

	vm = VMOpen("TOBORDER.VM", 0, VMO_CREATE_TRUNCATE, 0);
	TOCHECK(vm != 0);
	(void) GrCreateBitmap(BMF_24BIT, 50, 40, vm, 0, &g);
	@call n::MSG_VIS_DRAW(DF_EXPOSED, g);
	t = ObjDerefVis(n);
	x = (sword) (t->VI_bounds.R_left + t->VTI_lrMargin);
	y = (sword) (t->VI_bounds.R_top + t->VTI_tbMargin);
	toState.TOS_border[3] = (word) GrGetPoint(g, x, (sword) (y + 5));
	TOCHECK(GrGetPoint(g, x, (sword) (y + 5)) == 0 &&
		GrGetPoint(g, (sword) (x + 1), (sword) (y + 5)) == 0xffffffUL &&
		GrGetPoint(g, (sword) (x + 49 - 2 * t->VTI_lrMargin),
			   (sword) (y + 5)) == 0 &&
		GrGetPoint(g, (sword) (x + 30), y) == 0 &&
		GrGetPoint(g, (sword) (x + 30), (sword) (y + 1)) == 0xffffffUL &&
		GrGetPoint(g, (sword) (x + 30), (sword) (y + 17)) == 0 &&
		GrGetPoint(g, (sword) (x + 30), (sword) (y + 18)) == 0xffffffUL);

	gray.CQ_redOrIndex = C_LIGHT_GRAY;
	gray.CQ_info = CF_INDEX;
	gray.CQ_green = gray.CQ_blue = 0;
	@call n::MSG_VIS_TEXT_SET_PARA_BG_COLOR(gray, TEXT_ADDRESS_PAST_END, 0);
	@call n::MSG_VIS_TEXT_SET_PARA_BG_GRAY_SCREEN(SDM_100,
						      TEXT_ADDRESS_PAST_END, 0);
	@call n::MSG_VIS_DRAW(DF_EXPOSED, g);
	toState.TOS_border[4] = (word) GrGetPoint(g, (sword) (x + 1),
						  (sword) (y + 1));
	TOCHECK(GrGetPoint(g, (sword) (x + 1), (sword) (y + 1)) == 0xaaaaaaUL &&
		GrGetPoint(g, (sword) (x + 30), (sword) (y + 16)) == 0xaaaaaaUL &&
		GrGetPoint(g, x, (sword) (y + 1)) == 0 &&
		GrGetPoint(g, (sword) (x + 30), (sword) (y + 18)) == 0xffffffUL);
	GrDestroyBitmap(g, BMD_KILL_DATA);
	VMClose(vm, FALSE);
	FileDelete("TOBORDER.VM");
	break;
    }
    case 20: {
	/* a tab at 30 with a line leader and a line 1 wide 1 away
	 * before it: the leader on the baseline from the end of "a",
	 * the tab's line beside it from the line's top to its bottom */
	optr n = ObjInstantiate(OptrToHandle(@TOText),
				(ClassStruct *) &VisTextClass);
	VisTextInstance *t;
	VMFileHandle vm;
	GStateHandle g;
	WWFixed size;
	Tab tab;
	sword x, y;

	size.WWF_int = 10;
	size.WWF_frac = 0;
	@call n::MSG_VIS_TEXT_SET_POINT_SIZE(size, TEXT_ADDRESS_PAST_END, 0);
	@call n::MSG_VIS_SET_SIZE(50, 40);
	@call n::MSG_VIS_NOTIFY_GEOMETRY_VALID();
	memset(&tab, 0, sizeof(tab));
	tab.T_position = 30 * 8;
	tab.T_attr = (TL_LINE << 2) | TT_LEFT;
	tab.T_grayScreen = SDM_100;
	tab.T_lineWidth = 1 * 8;
	tab.T_lineSpacing = 1 * 8;
	@call n::MSG_VIS_TEXT_SET_TAB(tab, TEXT_ADDRESS_PAST_END, 0);
	@call n::MSG_VIS_TEXT_REPLACE_ALL_PTR("a\tb", 0);

	vm = VMOpen("TOTAB.VM", 0, VMO_CREATE_TRUNCATE, 0);
	TOCHECK(vm != 0);
	(void) GrCreateBitmap(BMF_24BIT, 50, 40, vm, 0, &g);
	@call n::MSG_VIS_DRAW(DF_EXPOSED, g);
	t = ObjDerefVis(n);
	x = (sword) (t->VI_bounds.R_left + t->VTI_lrMargin);
	y = (sword) (t->VI_bounds.R_top + t->VTI_tbMargin);
	toState.TOS_tab[0] = (word) GrGetPoint(g, (sword) (x + 20),
					       (sword) (y + 10));
	toState.TOS_tab[1] = (word) GrGetPoint(g, (sword) (x + 28),
					       (sword) (y + 3));
	TOCHECK(GrGetPoint(g, (sword) (x + 20), (sword) (y + 10)) == 0 &&
		GrGetPoint(g, (sword) (x + 20), (sword) (y + 9)) == 0xffffffUL &&
		GrGetPoint(g, (sword) (x + 20), (sword) (y + 11)) == 0xffffffUL &&
		GrGetPoint(g, (sword) (x + 28), (sword) (y + 3)) == 0 &&
		GrGetPoint(g, (sword) (x + 28), (sword) (y + 11)) == 0 &&
		GrGetPoint(g, (sword) (x + 27), (sword) (y + 3)) == 0xffffffUL &&
		GrGetPoint(g, (sword) (x + 29), (sword) (y + 3)) == 0xffffffUL &&
		GrGetPoint(g, (sword) (x + 28), (sword) (y + 12)) == 0xffffffUL);
	GrDestroyBitmap(g, BMD_KILL_DATA);
	VMClose(vm, FALSE);
	FileDelete("TOTAB.VM");
	break;
    }
    case 21: {
	/* the clipboard (the UI's): an item registered, queried, asked
	 * for its format; replaced while it is held, freed when it is
	 * let go; the normal item kept across closing the clipboard file
	 * without its owner */
	ClipboardItemFormatID text = FormatIDFromManufacturerAndType(
		MANUFACTURER_ID_GEOWORKS, CIF_TEXT), fmts[4];
	ClipboardQueryArgs q;
	ClipboardRequestArgs ra;
	VMFileHandle f;
	VMBlockHandle h1, h2;
	TransferBlockID id1, id2;

	TOCHECK(ClipboardOpenClipboardFile() == 0);
	f = ClipboardGetClipboardFile();
	TOCHECK(f != 0);
	h1 = TOMakeItem(f, @TOText, 5);
	h2 = TOMakeItem(f, @TOText, 6);
	id1 = BlockIDFromFileAndBlock(f, h1);
	id2 = BlockIDFromFileAndBlock(f, h2);
	TOCHECK(!ClipboardRegisterItem(id1, TIF_NORMAL));
	ClipboardQueryItem(TIF_NORMAL, &q);
	TOCHECK(q.CQA_numFormats == 1 && q.CQA_owner == @TOText &&
		q.CQA_header == id1);
	TOCHECK(!ClipboardTestItemFormat(q.CQA_header, text) &&
		ClipboardTestItemFormat(q.CQA_header, text + 1));
	TOCHECK(ClipboardEnumItemFormats(q.CQA_header, 4, fmts) == 1 &&
		fmts[0] == text);
	ClipboardRequestItemFormat(text, q.CQA_header, &ra);
	TOCHECK(ra.CRA_file == f && ra.CRA_data != 0 && ra.CRA_extra1 == 5);
	TOCHECK(!ClipboardRegisterItem(id2, TIF_NORMAL));
	TOCHECK(ClipboardGetNormalItemInfo() == id2 &&
		VMInfo(f, h1, NULL));
	ClipboardDoneWithItem(q.CQA_header);
	TOCHECK(!VMInfo(f, h1, NULL) &&
		!VMInfo(f, VMCHAIN_GET_VM_BLOCK(ra.CRA_data), NULL));
	ClipboardCloseClipboardFile();
	TOCHECK(ClipboardGetClipboardFile() == 0);
	TOCHECK(ClipboardOpenClipboardFile() == 0);
	f = ClipboardGetClipboardFile();
	ClipboardQueryItem(TIF_NORMAL, &q);
	toState.TOS_clip = q.CQA_numFormats;
	TOCHECK(q.CQA_numFormats == 1 && !q.CQA_owner &&
		BlockFromTransferBlockID(q.CQA_header) == h2);
	ClipboardRequestItemFormat(text, q.CQA_header, &ra);
	TOCHECK(ra.CRA_extra1 == 6);
	ClipboardDoneWithItem(q.CQA_header);
	ClipboardCloseClipboardFile();
	break;
    }
    case 22: {
	/* a large text object (as the clipboard's,
	 * TextAllocClipboardObject): its text a huge array in a VM
	 * file; replaced, appended to, read in parts, deleted from */
	static char big[9000], all[9100];
	char part[16];
	TextReference ref;
	VMFileHandle f;
	MemHandle mh;
	optr lt;
	word i;

	TOCHECK(ClipboardOpenClipboardFile() == 0);
	f = ClipboardGetClipboardFile();
	mh = UserAllocObjBlock(ThreadGetInfo(0, TGIT_THREAD_HANDLE));
	lt = ObjInstantiate(mh, (ClassStruct *) &VisLargeTextClass);
	@call lt::MSG_VIS_TEXT_SET_VM_FILE(f);
	@call lt::MSG_VIS_LARGE_TEXT_CREATE_DATA_STRUCTURES();
	TOCHECK(@call lt::MSG_VIS_TEXT_GET_TEXT_SIZE() == 0);
	@call lt::MSG_VIS_TEXT_REPLACE_ALL_PTR("large", 0);
	for (i = 0; i < sizeof(big) - 1; i++)
	    big[i] = (char) ('a' + i % 26);
	@call lt::MSG_VIS_TEXT_APPEND_PTR(big, sizeof(big) - 1);
	toState.TOS_large[0] = (word) @call lt::MSG_VIS_TEXT_GET_TEXT_SIZE();
	TOCHECK(toState.TOS_large[0] == 5 + sizeof(big) - 1);
	/* (a range from two blocks of the array) */
	memset(&ref, 0, sizeof(ref));
	ref.TR_type = TRT_POINTER;
	ref.TR_ref.TRU_pointer.TRP_pointer = part;
	TOCHECK(@call lt::MSG_VIS_TEXT_GET_TEXT_RANGE(0, ref, 8005, 7995)
		== 10);
	for (i = 0; i < 10; i++)
	    TOCHECK(part[i] == (char) ('a' + (7990 + i) % 26));
	TOCHECK(part[10] == 0);
	@call lt::MSG_VIS_TEXT_SELECT_RANGE(6005, 3);
	@call lt::MSG_VIS_TEXT_DELETE_SELECTION();
	toState.TOS_large[1] = (word) @call lt::MSG_VIS_TEXT_GET_TEXT_SIZE();
	TOCHECK(toState.TOS_large[1] == 3002);
	toState.TOS_large[2] = @call lt::MSG_VIS_TEXT_GET_ALL_PTR(all);
	TOCHECK(toState.TOS_large[2] == 3002 && !memcmp(all, "lar", 3) &&
		all[3] == (char) ('a' + 6000 % 26) && all[3002] == 0);
	/* (into a huge array, from it into a VM block and a DB item) */
	{
	    VMBlockHandle ha, vb;
	    DBGroupAndItem gi;

	    ref.TR_type = TRT_HUGE_ARRAY;
	    ref.TR_ref.TRU_hugeArray.TRHA_file = f;
	    /* (the reference goes by value: the array given, emptied) */
	    ha = HugeArrayCreate(f, 1, 0);
	    HugeArrayAppend(f, ha, 3, "old");
	    ref.TR_ref.TRU_hugeArray.TRHA_array = ha;
	    TOCHECK(@call lt::MSG_VIS_TEXT_GET_TEXT_RANGE(0, ref, 3002, 0)
		    == 3002);
	    TOCHECK(ha && HugeArrayGetCount(f, ha) == 3003);
	    @call lt::MSG_VIS_TEXT_APPEND_HUGE_ARRAY(f, ha, 0);
	    TOCHECK(@call lt::MSG_VIS_TEXT_GET_TEXT_SIZE() == 6004);
	    vb = @call lt::MSG_VIS_TEXT_GET_ALL_VM_BLOCK(f, 0);
	    gi = @call lt::MSG_VIS_TEXT_GET_ALL_DB_ITEM(f, DB_UNGROUPED, 0);
	    @call lt::MSG_VIS_TEXT_REPLACE_ALL_PTR("y", 1);
	    @call lt::MSG_VIS_TEXT_REPLACE_ALL_VM_BLOCK(f, vb, 0);
	    TOCHECK(@call lt::MSG_VIS_TEXT_GET_TEXT_SIZE() == 6004);
	    @call lt::MSG_VIS_TEXT_REPLACE_ALL_DB_ITEM(f,
			DBGroupFromGroupAndItem(gi), DBItemFromGroupAndItem(gi));
	    TOCHECK(@call lt::MSG_VIS_TEXT_GET_ALL_PTR(all) == 6004 &&
		    !memcmp(all + 3002, "lar", 3));
	    HugeArrayDestroy(f, ha);
	    VMFree(f, vb);
	    DBFreeUngrouped(f, gi);
	}
	@call lt::MSG_VIS_TEXT_REPLACE_ALL_PTR("x", 1);
	TOCHECK(@call lt::MSG_VIS_TEXT_GET_ALL_PTR(all) == 1 &&
		!memcmp(all, "x", 2));
	@call lt::MSG_META_BLOCK_FREE();
	ClipboardCloseClipboardFile();
	break;
    }
    case 23: {
	/* the clipboard of the text: a copy, a paste, a cut; pasteable
	 * told; a clipboard object of the application (its text the
	 * format, TCO_COPY) pasted */
	ClipboardQueryArgs q;
	ClipboardRequestArgs ra;
	TextTransferBlockHeader *t;
	MemHandle mh;
	NotifySelectStateChange *n;
	optr co;

	word state = @call TOText::MSG_VIS_TEXT_GET_STATE();

	TOCHECK(ClipboardOpenClipboardFile() == 0);
	@call TOText::MSG_VIS_TEXT_MODIFY_EDITABLE_SELECTABLE(VTS_EDITABLE, 0);
	TOCHECK(@call TOText::MSG_VIS_TEXT_GET_STATE() & VTS_EDITABLE);
	@call TOText::MSG_VIS_TEXT_SELECT_RANGE(3, 1);
	@call TOText::MSG_META_CLIPBOARD_COPY();
	ClipboardQueryItem(TIF_NORMAL, &q);
	TOCHECK(q.CQA_numFormats == 1 && q.CQA_owner == @TOText &&
		TOItemName(q.CQA_header, "Unnamed Text"));
	ClipboardRequestItemFormat(FormatIDFromManufacturerAndType(
			MANUFACTURER_ID_GEOWORKS, CIF_TEXT), q.CQA_header, &ra);
	t = VMLock(ra.CRA_file, VMCHAIN_GET_VM_BLOCK(ra.CRA_data), &mh);
	toState.TOS_paste[0] = (word) HugeArrayGetCount(ra.CRA_file,
				VMCHAIN_GET_VM_BLOCK(t->TTBH_text));
	TOCHECK(toState.TOS_paste[0] == 3 && !t->TTBH_charAttrRuns);
	VMUnlock(mh);
	ClipboardDoneWithItem(q.CQA_header);
	/* (pasteable: told to the edit menu) */
	(void) ObjVarAddData(@TOText,
			     ATTR_VIS_TEXT_NOTIFY_EVEN_IF_NOT_TARGETED, 0);
	toState.TOS_selectBlock = 0;
	@call TOText::MSG_META_UI_FORCE_CONTROLLER_UPDATE(
			MANUFACTURER_ID_GEOWORKS, GWNT_SELECT_STATE_CHANGE);
	TOCHECK(toState.TOS_selectBlock != 0);
	if (toState.TOS_selectBlock) {
	    n = MemLock(toState.TOS_selectBlock);
	    TOCHECK(n->NSSC_pasteable == 0xff &&
		    n->NSSC_clipboardableSelection == 0xff);
	    MemUnlock(toState.TOS_selectBlock);
	    MemDecRefCount(toState.TOS_selectBlock);
	}
	(void) ObjVarDeleteData(@TOText,
				ATTR_VIS_TEXT_NOTIFY_EVEN_IF_NOT_TARGETED);
	@call TOText::MSG_VIS_TEXT_SELECT_RANGE(15, 15);
	@call TOText::MSG_META_CLIPBOARD_PASTE();
	(void) @call TOText::MSG_VIS_TEXT_GET_ALL_PTR(buf);
	TOCHECK(Same(buf, "a12b-cE -.F14y#12"));
	@call TOText::MSG_VIS_TEXT_SELECT_RANGE(17, 15);
	@call TOText::MSG_META_CLIPBOARD_CUT();
	(void) @call TOText::MSG_VIS_TEXT_GET_ALL_PTR(buf);
	TOCHECK(Same(buf, "a12b-cE -.F14y#"));
	ClipboardQueryItem(TIF_NORMAL, &q);
	TOCHECK(q.CQA_numFormats == 1);
	ClipboardDoneWithItem(q.CQA_header);
	/* (the application's clipboard object) */
	co = TextAllocClipboardObject(0, 0, 0);
	@call co::MSG_VIS_TEXT_REPLACE_ALL_PTR("clip", 0);
	TOCHECK(TextFinishWithClipboardObject(co, TCO_COPY, @TOText,
					      "Mine") == 0);
	ClipboardQueryItem(TIF_NORMAL, &q);
	TOCHECK(q.CQA_numFormats == 1 && TOItemName(q.CQA_header, "Mine"));
	ClipboardDoneWithItem(q.CQA_header);
	@call TOText::MSG_VIS_TEXT_SELECT_RANGE(15, 15);
	@call TOText::MSG_META_CLIPBOARD_PASTE();
	toState.TOS_paste[1] = @call TOText::MSG_VIS_TEXT_GET_ALL_PTR(buf);
	TOCHECK(Same(buf, "a12b-cE -.F14y#clip"));
	@call TOText::MSG_VIS_TEXT_SELECT_RANGE(19, 15);
	@call TOText::MSG_META_DELETE();
	if (!(state & VTS_EDITABLE))
	    @call TOText::MSG_VIS_TEXT_MODIFY_EDITABLE_SELECTABLE(0,
							VTS_EDITABLE);
	ClipboardCloseClipboardFile();
	break;
    }
    case 24: {
	/* the attribute runs go with a copy: a font and a margin copied
	 * from one object, pasted into another (a paragraph begun in the
	 * paste gets its margin, the one pasted into keeps its own); an
	 * application's clipboard object (a large object: runs in huge
	 * arrays) with a font */
	ClipboardQueryArgs q;
	ClipboardRequestArgs ra;
	TextTransferBlockHeader *t;
	VisTextCharAttrDiffs d;
	VisTextParaAttrDiffs pd;
	VisTextMaxParaAttr a;
	MemHandle mh;
	FontID base;
	word tk;
	optr n, m, co;

	TOCHECK(ClipboardOpenClipboardFile() == 0);
	n = ObjInstantiate(OptrToHandle(@TOText),
			   (ClassStruct *) &VisTextClass);
	@call n::MSG_VIS_TEXT_REPLACE_ALL_PTR("ab\rcd\ref", 0);
	@call n::MSG_VIS_TEXT_CREATE_STORAGE(VTSF_MULTIPLE_CHAR_ATTRS |
					     VTSF_MULTIPLE_PARA_ATTRS, 0);
	base = FontOf(n, 0, 1, &tk, &d);
	@call n::MSG_VIS_TEXT_SET_FONT_ID(FID_ROMA, 5, 4);
	@call n::MSG_VIS_TEXT_SET_LEFT_MARGIN(72 * 8, 4, 4);
	@call n::MSG_VIS_TEXT_SELECT_RANGE(8, 3);
	@call n::MSG_META_CLIPBOARD_COPY();
	ClipboardQueryItem(TIF_NORMAL, &q);
	ClipboardRequestItemFormat(FormatIDFromManufacturerAndType(
			MANUFACTURER_ID_GEOWORKS, CIF_TEXT), q.CQA_header, &ra);
	t = VMLock(ra.CRA_file, VMCHAIN_GET_VM_BLOCK(ra.CRA_data), &mh);
	TOCHECK(t->TTBH_charAttrRuns && t->TTBH_paraAttrRuns &&
		t->TTBH_charAttrElements && t->TTBH_paraAttrElements);
	if (t->TTBH_charAttrRuns && t->TTBH_paraAttrRuns) {
	    toState.TOS_runs[0] = (word) HugeArrayGetCount(ra.CRA_file,
				VMCHAIN_GET_VM_BLOCK(t->TTBH_charAttrRuns));
	    toState.TOS_runs[1] = (word) HugeArrayGetCount(ra.CRA_file,
				VMCHAIN_GET_VM_BLOCK(t->TTBH_paraAttrRuns));
	}
	/* ("cd" "\ref": base, the font, base; two paragraphs) */
	TOCHECK(toState.TOS_runs[0] == 4 && toState.TOS_runs[1] == 3);
	VMUnlock(mh);
	ClipboardDoneWithItem(q.CQA_header);

	m = ObjInstantiate(OptrToHandle(@TOText),
			   (ClassStruct *) &VisTextClass);
	@call m::MSG_VIS_TEXT_REPLACE_ALL_PTR("xy\rz", 0);
	@call m::MSG_VIS_TEXT_CREATE_STORAGE(VTSF_MULTIPLE_CHAR_ATTRS |
					     VTSF_MULTIPLE_PARA_ATTRS, 0);
	@call m::MSG_VIS_TEXT_SELECT_RANGE(0, 0);
	@call m::MSG_META_CLIPBOARD_PASTE();
	TOCHECK(Is(m, "cd\refxy\rz"));
	TOCHECK(FontOf(m, 1, 2, &tk, &d) == FID_ROMA);
	TOCHECK(FontOf(m, 0, 1, &tk, &d) == base);
	/* (a font set up to a paragraph's end takes its carriage return:
	 * "d\r") */
	TOCHECK(FontOf(m, 3, 9, &tk, &d) == base && tk != CA_NULL_ELEMENT);
	TOCHECK(RunIs(m, 1, 1, 3) && RunIs(m, 3, 3, TEXT_ADDRESS_PAST_END));
	(void) ParaOf(m, 1, 1, &a, &pd);
	TOCHECK(a.VTMPA_paraAttr.VTPA_leftMargin == 72 * 8);
	(void) ParaOf(m, 6, 6, &a, &pd);
	TOCHECK(a.VTMPA_paraAttr.VTPA_leftMargin == 0);
	TOCHECK(ParaRunIs(m, 1, 0, 3) &&
		ParaRunIs(m, 4, 3, TEXT_ADDRESS_PAST_END));

	/* (the application's large object) */
	co = TextAllocClipboardObject(0, VTSF_MULTIPLE_CHAR_ATTRS, 0);
	@call co::MSG_VIS_TEXT_REPLACE_ALL_PTR("QR", 0);
	@call co::MSG_VIS_TEXT_SET_FONT_ID(FID_ROMA, 2, 1);
	TOCHECK(TextFinishWithClipboardObject(co, TCO_COPY, m, "Runs") == 0);
	/* (its runs and elements in the item, the runs naming them) */
	ClipboardQueryItem(TIF_NORMAL, &q);
	ClipboardRequestItemFormat(FormatIDFromManufacturerAndType(
			MANUFACTURER_ID_GEOWORKS, CIF_TEXT), q.CQA_header, &ra);
	t = VMLock(ra.CRA_file, VMCHAIN_GET_VM_BLOCK(ra.CRA_data), &mh);
	TOCHECK(t->TTBH_charAttrRuns && t->TTBH_charAttrElements &&
		!t->TTBH_paraAttrRuns);
	if (t->TTBH_charAttrRuns) {
	    TextLargeRunArrayHeader *lh;

	    TOCHECK(HugeArrayGetCount(ra.CRA_file,
			VMCHAIN_GET_VM_BLOCK(t->TTBH_charAttrRuns)) == 3);
	    HugeArrayLockDir(ra.CRA_file,
			     VMCHAIN_GET_VM_BLOCK(t->TTBH_charAttrRuns),
			     (void **) &lh);
	    TOCHECK(lh->TLRAH_elementVMBlock ==
		    VMCHAIN_GET_VM_BLOCK(t->TTBH_charAttrElements));
	    HugeArrayUnlockDir(lh);
	}
	VMUnlock(mh);
	ClipboardDoneWithItem(q.CQA_header);
	@call m::MSG_VIS_TEXT_SELECT_RANGE(9, 9);
	@call m::MSG_META_CLIPBOARD_PASTE();
	TOCHECK(Is(m, "cd\refxy\rzQR"));
	TOCHECK(FontOf(m, 10, 11, &tk, &d) == FID_ROMA);
	TOCHECK(FontOf(m, 9, 10, &tk, &d) == base);
	TOCHECK(RunIs(m, 9, 3, 10) && RunIs(m, 10, 10, TEXT_ADDRESS_PAST_END));
	@call n::MSG_META_OBJ_FREE();
	@call m::MSG_META_OBJ_FREE();
	ClipboardCloseClipboardFile();
	break;
    }
    case 25: {
	/* the lines of a large object in its regions: draft mode, the
	 * regions as wide as the draft size and so low that a few lines
	 * fill one; the lines go on in the next region, the regions
	 * stacked; fewer lines give up the regions after */
	VisLargeTextInstance *vl;
	VisLargeTextGetRegionPosReturnStruct pos;
	MemHandle mh;
	ChunkHandle ra;
	optr lt;
	word i, n, lines = 0;
	dword chars = 0, total;
	sdword y = 0;

	TOCHECK(ClipboardOpenClipboardFile() == 0);
	mh = UserAllocObjBlock(ThreadGetInfo(0, TGIT_THREAD_HANDLE));
	lt = ObjInstantiate(mh, (ClassStruct *) &VisLargeTextClass);
	/* (a message first builds the instance) */
	@call lt::MSG_VIS_TEXT_SET_VM_FILE(ClipboardGetClipboardFile());
	ObjLockObjBlock(mh);
	/* (the array first: the block may move) */
	ra = ChunkArrayCreate(mh, sizeof(VisLargeTextRegionArrayElement), 0,
			      0);
	vl = (VisLargeTextInstance *) ObjDerefVis(lt);
	vl->VLTI_regionArray = ra;
	vl->VLTI_displayMode = VLTDM_DRAFT_WITH_STYLES;
	vl->VLTI_attrs = VLTA_EXACT_HEIGHT;
	vl->VLTI_draftRegionSize.XYS_width = 200;
	vl->VLTI_draftRegionSize.XYS_height = 40;
	MemUnlock(mh);
	@call lt::MSG_VIS_LARGE_TEXT_CREATE_DATA_STRUCTURES();
	@call lt::MSG_VIS_NOTIFY_GEOMETRY_VALID();
	TOCHECK(@call lt::MSG_VIS_LARGE_TEXT_GET_REGION_COUNT() == 1);
	for (i = 0; i < 20; i++)
	    @call lt::MSG_VIS_TEXT_APPEND_PTR("Here is some text.\r", 0);
	n = @call lt::MSG_VIS_LARGE_TEXT_GET_REGION_COUNT();
	toState.TOS_regions[0] = n;
	TOCHECK(n >= 5);
	/* (the regions hold all the lines and text, one after the other,
	 * no more than fit; each one's top below the one before) */
	ObjLockObjBlock(mh);
	for (i = 0; i < n; i++) {
	    VisLargeTextRegionArrayElement *e;

	    vl = (VisLargeTextInstance *) ObjDerefVis(lt);
	    e = ChunkArrayElementToPtr(ConstructOptr(mh, vl->VLTI_regionArray),
				       i, NULL);
	    TOCHECK(e->VLTRAE_lineCount > 0 &&
		    e->VLTRAE_calcHeight.WBF_int <= 40);
	    if (!i) {
		toState.TOS_regions[1] = (word) e->VLTRAE_lineCount;
		toState.TOS_regions[2] = e->VLTRAE_calcHeight.WBF_int;
	    }
	    lines += (word) e->VLTRAE_lineCount;
	    chars += e->VLTRAE_charCount;
	    MemUnlock(mh);
	    @call lt::MSG_VIS_LARGE_TEXT_GET_REGION_POS(&pos, i);
	    ObjLockObjBlock(mh);
	    TOCHECK(pos.VLTGRPRS_yPosition == y);
	    y += pos.VLTGRPRS_height;
	}
	vl = (VisLargeTextInstance *) ObjDerefVis(lt);
	total = vl->VLTI_totalHeight;
	MemUnlock(mh);
	toState.TOS_regions[3] = lines;
	TOCHECK(lines == 21 && chars == 20 * 19);
	TOCHECK(total == (dword) y);
	/* (a line's region and place: the first line of the second
	 * region at its top) */
	{
	    VisTextGetLineOffsetAndFlagsParameters lp;

	    lp.VTGLOAFP_line = toState.TOS_regions[1];
	    TOCHECK(!@call lt::MSG_VIS_TEXT_GET_LINE_OFFSET_AND_FLAGS(&lp));
	    TOCHECK(lp.VTGLOAFP_offset == 19 * (dword) toState.TOS_regions[1]);
	    TOCHECK(@call lt::MSG_VIS_TEXT_GET_LINE_FROM_OFFSET(
			lp.VTGLOAFP_offset) == toState.TOS_regions[1]);
	}
	/* (fewer lines: fewer regions) */
	@call lt::MSG_VIS_TEXT_SELECT_RANGE(20 * 19, 5 * 19);
	@call lt::MSG_VIS_TEXT_DELETE_SELECTION();
	toState.TOS_regions[4] = @call lt::MSG_VIS_LARGE_TEXT_GET_REGION_COUNT();
	TOCHECK(toState.TOS_regions[4] < n &&
		toState.TOS_regions[4] ==
		(word) ((6 + toState.TOS_regions[1] - 1) /
			toState.TOS_regions[1]));
	@call lt::MSG_VIS_TEXT_DELETE_ALL();
	toState.TOS_regions[5] = @call lt::MSG_VIS_LARGE_TEXT_GET_REGION_COUNT();
	TOCHECK(toState.TOS_regions[5] == 1);
	@call lt::MSG_META_OBJ_FREE();
	ClipboardCloseClipboardFile();
	break;
    }
    case 26: {
	/* style sheets: a style defined from the attributes of a
	 * paragraph (named by a text object, its flags from a boolean
	 * group), applied to it and to another, described; redefined from
	 * a new font: the other paragraph follows; deleted, reverting to
	 * no style: the attributes stay, without the style */
	StyleSheetParams p;
	SSCDefineStyleParams dp;
	SSCApplyDeleteStyleParams ap;
	SSCDescribeStyleParams ds;
	VisTextCharAttrDiffs d;
	VisTextCharAttr ca;
	VisTextMaxParaAttr pa;
	VisTextParaAttrDiffs pd;
	MemHandle mh = OptrToHandle(@TOText);
	word tk, ptk, tools;
	optr n, name, desc, list;
	char db[100];

	n = ObjInstantiate(mh, (ClassStruct *) &VisTextClass);
	@call n::MSG_VIS_TEXT_REPLACE_ALL_PTR("Head\rBody\r", 0);
	@call n::MSG_VIS_TEXT_CREATE_STORAGE(VTSF_MULTIPLE_CHAR_ATTRS |
					     VTSF_MULTIPLE_PARA_ATTRS |
					     VTSF_STYLES, 0);
	name = ObjInstantiate(mh, (ClassStruct *) &VisTextClass);
	@call name::MSG_VIS_TEXT_REPLACE_ALL_PTR("Heading", 0);
	desc = ObjInstantiate(mh, (ClassStruct *) &VisTextClass);
	list = ObjInstantiate(mh, (ClassStruct *) &GenBooleanGroupClass);
	@call n::MSG_VIS_TEXT_SET_FONT_ID(FID_ROMA, 5, 0);
	@call n::MSG_VIS_TEXT_SET_LEFT_MARGIN(72 * 8, 0, 0);
	(void) FontOf(n, 2, 2, &tk, &d);
	ptk = ParaOf(n, 2, 2, &pa, &pd);
	memset(&dp, 0, sizeof(dp));
	dp.SSCDSP_defineStyledClasss = (ClassStruct *) &VisTextClass;
	dp.SSCDSP_attrTokens[0] = tk;
	dp.SSCDSP_attrTokens[1] = ptk;
	dp.SSCDSP_baseStyle = CA_NULL_ELEMENT;
	dp.SSCDSP_attrList = list;
	dp.SSCDSP_textObject = name;
	dp.SSCDSP_extraUI = list;
	@call n::MSG_VIS_TEXT_SELECT_RANGE(2, 2);
	@call n::MSG_META_STYLED_OBJECT_DEFINE_STYLE(&dp);
	@call n::MSG_VIS_TEXT_LOAD_STYLE_SHEET_PARAMS(&p, FALSE);
	TOCHECK(p.SSP_styleArray.SCD_chunk != 0);
	toState.TOS_styles[0] = StyleSheetGetStyleCounts(&p.SSP_styleArray,
							 &tools);
	TOCHECK(toState.TOS_styles[0] == 1);
	/* (applied to its paragraph: the style's elements) */
	(void) @call n::MSG_VIS_TEXT_GET_CHAR_ATTR(0, &d, &ca, 4, 0);
	TOCHECK(ca.VTCA_fontID == FID_ROMA && ca.VTCA_meta.SSEH_style == 0);
	(void) ParaOf(n, 0, 0, &pa, &pd);
	TOCHECK(pa.VTMPA_paraAttr.VTPA_meta.SSEH_style == 0 &&
		pa.VTMPA_paraAttr.VTPA_leftMargin == 72 * 8);
	(void) @call n::MSG_VIS_TEXT_GET_CHAR_ATTR(0, &d, &ca, 9, 6);
	toState.TOS_styles[1] = ca.VTCA_meta.SSEH_style;
	TOCHECK(ca.VTCA_fontID != FID_ROMA && ca.VTCA_meta.SSEH_style != 0);
	/* (described) */
	memset(&ds, 0, sizeof(ds));
	ds.SSCDSP_describeStyledClass = (ClassStruct *) &VisTextClass;
	ds.SSCDSP_describeTextObject = desc;
	ds.SSCDSP_usedIndex = 0;
	ds.SSCDSP_describeDeleteTrigger = list;
	ds.SSCDSP_describeDeleteRevertTrigger = list;
	@call n::MSG_META_STYLED_OBJECT_DESCRIBE_STYLE(&ds);
	(void) @call desc::MSG_VIS_TEXT_GET_ALL_PTR(db);
	memcpy(toState.TOS_styleDesc, db, sizeof(toState.TOS_styleDesc) - 1);
	{
	    /* ("Character:" in it) */
	    word i, found = 0;

	    for (i = 0; db[i] && !found; i++)
		found = !memcmp(db + i, "Character:", 10);
	    TOCHECK(found);
	}
	/* (applied to the other paragraph) */
	memset(&ap, 0, sizeof(ap));
	ap.SSCADSP_deleteStyledClass = (ClassStruct *) &VisTextClass;
	ap.SSCADSP_token = 0;
	@call n::MSG_VIS_TEXT_SELECT_RANGE(7, 7);
	@call n::MSG_META_STYLED_OBJECT_APPLY_STYLE(&ap);
	TOCHECK(FontOf(n, 5, 9, &tk, &d) == FID_ROMA);
	(void) ParaOf(n, 7, 7, &pa, &pd);
	TOCHECK(pa.VTMPA_paraAttr.VTPA_leftMargin == 72 * 8);
	/* (redefined from the first paragraph's new font) */
	@call n::MSG_VIS_TEXT_SET_FONT_ID(FID_DTC_URW_SANS, 5, 0);
	(void) FontOf(n, 2, 2, &tk, &d);
	ptk = ParaOf(n, 2, 2, &pa, &pd);
	dp.SSCDSP_attrTokens[0] = tk;
	dp.SSCDSP_attrTokens[1] = ptk;
	dp.SSCDSP_baseStyle = 0;
	@call n::MSG_VIS_TEXT_SELECT_RANGE(2, 2);
	@call n::MSG_META_STYLED_OBJECT_REDEFINE_STYLE(&dp);
	toState.TOS_styles[2] = FontOf(n, 5, 9, &tk, &d);
	TOCHECK(toState.TOS_styles[2] == FID_DTC_URW_SANS);
	TOCHECK(FontOf(n, 0, 9, &tk, &d) == FID_DTC_URW_SANS &&
		tk != CA_NULL_ELEMENT);
	/* (deleted: no style, the attributes kept) */
	ap.SSCADSP_flags = SSCADSF_REVERT_TO_BASE_STYLE;
	@call n::MSG_META_STYLED_OBJECT_DELETE_STYLE(&ap);
	@call n::MSG_VIS_TEXT_LOAD_STYLE_SHEET_PARAMS(&p, FALSE);
	toState.TOS_styles[3] = StyleSheetGetStyleCounts(&p.SSP_styleArray,
							 &tools);
	TOCHECK(toState.TOS_styles[3] == 0);
	(void) @call n::MSG_VIS_TEXT_GET_CHAR_ATTR(0, &d, &ca, 9, 0);
	TOCHECK(ca.VTCA_fontID == FID_DTC_URW_SANS &&
		ca.VTCA_meta.SSEH_style == CA_NULL_ELEMENT);
	(void) ParaOf(n, 0, 9, &pa, &pd);
	TOCHECK(pa.VTMPA_paraAttr.VTPA_meta.SSEH_style == CA_NULL_ELEMENT &&
		pa.VTMPA_paraAttr.VTPA_leftMargin == 72 * 8);
	@call n::MSG_META_OBJ_FREE();
	@call name::MSG_META_OBJ_FREE();
	@call desc::MSG_META_OBJ_FREE();
	@call list::MSG_META_OBJ_FREE();
	break;
    }
    }
    (void) @call TOText::MSG_VIS_TEXT_GET_ALL_PTR(buf);
    memcpy(toState.TOS_text, buf, sizeof(toState.TOS_text) - 1);
}

/* a step on the process thread, from the test (MF_CALL) */
void TOStep(word step)
{
    @call ConstructOptr(toState.TOS_process, 0)::MSG_TO_STEP(step);
}
