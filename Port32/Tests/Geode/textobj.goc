/*
 * textobj.goc -- a process geode for the library.text test
 * (Port32/Tests): text objects of the text library (VisTextClass), not
 * on a screen.
 *
 * TOText is a text object of a resource with a text, TOEmpty one
 * without; a third is instantiated.  They are TOTextClass, which counts
 * what a text object tells itself (modified by the user or not, empty
 * or not).  Step 10 calculates the lines of TOText (the system is
 * booted with Berkeley then).  The test (test_text.c) runs the steps through TOStep on the
 * process thread; the checks made here count in toState.
 */
@include <stdapp.goh>
@include <Objects/vTextC.goh>
#include <string.h>
#include <font.h>
#include <fontID.h>
#include <chunkarr.h>

typedef struct {
    GeodeHandle	TOS_process;
    word	TOS_attached;
    word	TOS_checks, TOS_fails, TOS_failLine;
    word	TOS_failLines[8];
    word	TOS_modified, TOS_notModified;
    word	TOS_empty, TOS_notEmpty;
    char	TOS_text[40];		/* TOText at the end of a step */
    word	TOS_line[16];		/* of step 10, to print */
    word	TOS_geo[6];
} TOState;

TOState toState;

#define TOCHECK(c) \
    do { toState.TOS_checks++; if (!(c)) { \
	if (toState.TOS_fails < 8) \
	    toState.TOS_failLines[toState.TOS_fails] = __LINE__; \
	toState.TOS_fails++; \
	if (!toState.TOS_failLine) toState.TOS_failLine = __LINE__; } \
    } while (0)

@class TOProcessClass, ProcessClass;
    @message void MSG_TO_STEP(word step);
@endc
@classdecl TOProcessClass, neverSaved;

@class TOTextClass, VisTextClass;
@endc
@classdecl TOTextClass;

@method TOTextClass, MSG_META_TEXT_USER_MODIFIED
{
    (void) obj;
    toState.TOS_modified++;
}

@method TOTextClass, MSG_META_TEXT_NOT_USER_MODIFIED
{
    (void) obj;
    toState.TOS_notModified++;
}

@method TOTextClass, MSG_META_TEXT_EMPTY_STATUS_CHANGED
{
    (void) object;
    if (hasTextFlag)
	toState.TOS_notEmpty++;
    else
	toState.TOS_empty++;
}

@start TOObjects;
@object TOTextClass TOText = {
    VTI_text = "Hello";
}
@object TOTextClass TOEmpty = {
}
@chunk char TOString[] = "from a chunk";
@chunk char TOBuffer[] = "x";
@end TOObjects;

@method TOProcessClass, MSG_META_ATTACH_PROCESS
{
    (void) value1;
    (void) value2;
    toState.TOS_process = GeodeGetProcessHandle();
    toState.TOS_attached++;
}

/* (no strcmp in a geode) */
static word Len(const char *s)
{
    word n = 0;

    while (s[n])
	n++;
    return n;
}

static Boolean Same(const char *a, const char *b)
{
    word n = Len(a);

    return n == Len(b) && !memcmp(a, b, n);
}

/* the chunks in use in a block */
static word ChunkCount(MemHandle mh)
{
    LMemBlockHeader *h = MemDeref(mh);
    word *tab = (word *) ((byte *) h + h->LMBH_offset);
    word i, n = 0;

    for (i = 0; i < h->LMBH_nHandles; i++)
	if (tab[i])
	    n++;
    return n;
}

static Boolean Is(optr o, const char *text)
{
    char buf[64];
    word n = @call o::MSG_VIS_TEXT_GET_ALL_PTR(buf);

    return n == Len(text) && Same(buf, text) &&
	   @call o::MSG_VIS_TEXT_GET_TEXT_SIZE() == n;
}

static Boolean Selection(optr o, dword start, dword end)
{
    VisTextRange r;

    @call o::MSG_VIS_TEXT_GET_SELECTION_RANGE(&r);
    return r.VTR_start == start && r.VTR_end == end;
}

static Boolean ChunkIs(optr c, const char *text)
{
    Boolean ok;

    ObjLockObjBlock(OptrToHandle(c));
    ok = Same(LMemDeref(c), text) &&
	 LMemGetChunkSize(c) == Len(text) + 1;
    MemUnlock(OptrToHandle(c));
    return ok;
}

@method TOProcessClass, MSG_TO_STEP
{
    VisTextReplaceParameters p;
    char buf[64];

    switch (step) {
    case 1:
	/* the text of the resource; appended to: not by the user */
	TOCHECK(Is(@TOText, "Hello"));
	TOCHECK(Selection(@TOText, 0, 0));
	@call TOText::MSG_VIS_TEXT_APPEND_PTR(", world", 0);
	TOCHECK(Is(@TOText, "Hello, world"));
	TOCHECK(Selection(@TOText, 0, 0));
	TOCHECK(!@call TOText::MSG_VIS_TEXT_GET_USER_MODIFIED_STATE());
	TOCHECK(!toState.TOS_modified && !toState.TOS_notModified);
	/* a length given: only that much */
	@call TOText::MSG_VIS_TEXT_APPEND_PTR("!!!", 1);
	TOCHECK(Is(@TOText, "Hello, world!"));
	break;
    case 2:
	/* the selection replaced: a cursor after the new text */
	@call TOText::MSG_VIS_TEXT_SELECT_RANGE_SMALL(0, 5);
	TOCHECK(Selection(@TOText, 0, 5));
	TOCHECK(@call TOText::MSG_VIS_TEXT_GET_SELECTION_PTR(buf) == 5 &&
		Same(buf, "Hello"));
	@call TOText::MSG_VIS_TEXT_REPLACE_SELECTION_PTR("Goodbye", 0);
	TOCHECK(Is(@TOText, "Goodbye, world!"));
	TOCHECK(Selection(@TOText, 7, 7));
	TOCHECK(@call TOText::MSG_VIS_TEXT_GET_SELECTION_START() == 7);
	/* a change before the cursor moves it, one after it does not */
	@call TOText::MSG_VIS_TEXT_SELECT_RANGE_SMALL(9, 14);
	memset(&p, 0, sizeof(p));
	p.VTRP_range.VTR_start = 0;
	p.VTRP_range.VTR_end = 4;
	TOCHECK(!@call TOText::MSG_VIS_TEXT_REPLACE_TEXT(&p));
	TOCHECK(Is(@TOText, "bye, world!"));
	TOCHECK(Selection(@TOText, 5, 10));
	@call TOText::MSG_VIS_TEXT_APPEND_PTR("?", 0);
	TOCHECK(Selection(@TOText, 5, 10));
	TOCHECK(@call TOText::MSG_VIS_TEXT_GET_SELECTION_PTR(buf) == 5 &&
		Same(buf, "world"));
	break;
    case 3:
	/* a replacement by the user: modified, told once; the range with
	 * the selection in it leaves a cursor after the new text */
	memset(&p, 0, sizeof(p));
	p.VTRP_range.VTR_start = 3;
	p.VTRP_range.VTR_end = TEXT_ADDRESS_PAST_END;
	p.VTRP_insCount = 2;
	p.VTRP_textReference.TR_type = TRT_POINTER;
	p.VTRP_textReference.TR_ref.TRU_pointer.TRP_pointer = "!!?";
	p.VTRP_flags = VTRF_USER_MODIFICATION;
	TOCHECK(!@call TOText::MSG_VIS_TEXT_REPLACE_TEXT(&p));
	TOCHECK(Is(@TOText, "bye!!"));
	TOCHECK(Selection(@TOText, 5, 5));
	TOCHECK(@call TOText::MSG_VIS_TEXT_GET_USER_MODIFIED_STATE());
	TOCHECK(@call TOText::MSG_VIS_TEXT_GET_STATE() & VTS_USER_MODIFIED);
	TOCHECK(toState.TOS_modified == 1);
	p.VTRP_range.VTR_start = p.VTRP_range.VTR_end = 0;
	p.VTRP_insCount = (dword) INSERT_COMPUTE_TEXT_LENGTH << 16;
	TOCHECK(!@call TOText::MSG_VIS_TEXT_REPLACE_TEXT(&p));
	TOCHECK(Is(@TOText, "!!?bye!!"));
	TOCHECK(Selection(@TOText, 8, 8));
	TOCHECK(toState.TOS_modified == 1 && !toState.TOS_notModified);
	/* the same text set again: not modified any more, told */
	@call TOText::MSG_VIS_TEXT_REPLACE_ALL_PTR("!!?bye!!", 0);
	TOCHECK(Is(@TOText, "!!?bye!!"));
	TOCHECK(Selection(@TOText, 8, 8));
	TOCHECK(!@call TOText::MSG_VIS_TEXT_GET_USER_MODIFIED_STATE());
	TOCHECK(toState.TOS_notModified == 1);
	/* a range past the text is its end */
	memset(&p, 0, sizeof(p));
	p.VTRP_range.VTR_start = 50;
	p.VTRP_range.VTR_end = 60;
	TOCHECK(!@call TOText::MSG_VIS_TEXT_REPLACE_TEXT(&p));
	TOCHECK(Is(@TOText, "!!?bye!!"));
	/* nothing replaced by nothing: no change */
	memset(&p, 0, sizeof(p));
	p.VTRP_range.VTR_start = p.VTRP_range.VTR_end = 2;
	p.VTRP_flags = VTRF_USER_MODIFICATION;
	TOCHECK(!@call TOText::MSG_VIS_TEXT_REPLACE_TEXT(&p));
	TOCHECK(toState.TOS_modified == 1);
	break;
    case 4:
	/* all deleted: empty, told; text again: told */
	TOCHECK(!toState.TOS_empty && !toState.TOS_notEmpty);
	@call TOText::MSG_VIS_TEXT_DELETE_ALL();
	TOCHECK(Is(@TOText, ""));
	TOCHECK(Selection(@TOText, 0, 0));
	TOCHECK(toState.TOS_empty == 1 && !toState.TOS_notEmpty);
	@call TOText::MSG_VIS_TEXT_DELETE_ALL();
	TOCHECK(toState.TOS_empty == 1);
	@call TOText::MSG_VIS_TEXT_REPLACE_ALL_PTR("abcdefgh", 0);
	TOCHECK(Is(@TOText, "abcdefgh"));
	TOCHECK(toState.TOS_empty == 1 && toState.TOS_notEmpty == 1);
	/* a range read through the message, cut to the text */
	{
	    TextReference r;

	    memset(&r, 0, sizeof(r));
	    r.TR_type = TRT_POINTER;
	    r.TR_ref.TRU_pointer.TRP_pointer = buf;
	    TOCHECK(@call TOText::MSG_VIS_TEXT_GET_TEXT_RANGE(0, r, 3, 1)
		    == 2 && Same(buf, "bc"));
	    TOCHECK(@call TOText::MSG_VIS_TEXT_GET_TEXT_RANGE(0, r, 100, 6)
		    == 2 && Same(buf, "gh"));
	    TOCHECK(@call TOText::MSG_VIS_TEXT_GET_TEXT_RANGE(0, r,
			TEXT_ADDRESS_PAST_END, TEXT_ADDRESS_PAST_END)
		    == 0 && !buf[0]);
	}
	break;
    case 5:
	/* the selection: all, the ends, deleted by the user */
	@call TOText::MSG_VIS_TEXT_SELECT_ALL();
	TOCHECK(Selection(@TOText, 0, 8));
	@call TOText::MSG_VIS_TEXT_SELECT_END();
	TOCHECK(Selection(@TOText, 8, 8));
	@call TOText::MSG_VIS_TEXT_SELECT_START();
	TOCHECK(Selection(@TOText, 0, 0));
	@call TOText::MSG_VIS_TEXT_SELECT_RANGE(6, 2);
	TOCHECK(Selection(@TOText, 2, 6));
	@call TOText::MSG_VIS_TEXT_SELECT_RANGE(3, 5);	/* in order */
	TOCHECK(Selection(@TOText, 3, 5));
	@call TOText::MSG_VIS_TEXT_SELECT_RANGE(100, 7);	/* in the text */
	TOCHECK(Selection(@TOText, 7, 8));
	@call TOText::MSG_VIS_TEXT_SELECT_RANGE_SMALL(2, 6);
	{
	    VisTextRange r;

	    r.VTR_start = VIS_TEXT_RANGE_SELECTION;
	    r.VTR_end = 0;
	    @call TOText::MSG_VIS_TEXT_GET_RANGE(&r, 0);
	    TOCHECK(r.VTR_start == 2 && r.VTR_end == 6);
	    r.VTR_start = 1;
	    r.VTR_end = TEXT_ADDRESS_PAST_END;
	    @call TOText::MSG_VIS_TEXT_GET_RANGE(&r, 0);
	    TOCHECK(r.VTR_start == 1 && r.VTR_end == 8);
	}
	@call TOText::MSG_META_DELETE();
	TOCHECK(Is(@TOText, "abgh"));
	TOCHECK(Selection(@TOText, 2, 2));
	TOCHECK(toState.TOS_modified == 2);
	@call TOText::MSG_VIS_TEXT_SELECT_RANGE_SMALL(0, 1);
	@call TOText::MSG_VIS_TEXT_DELETE_SELECTION();
	TOCHECK(Is(@TOText, "bgh"));
	TOCHECK(toState.TOS_notModified == 2);
	{
	    VisTextRange r;

	    r.VTR_start = 1;
	    r.VTR_end = 2;
	    @call TOText::MSG_META_DELETE_RANGE_OF_CHARS(r);
	}
	TOCHECK(Is(@TOText, "bh"));
	TOCHECK(toState.TOS_modified == 3);
	break;
    case 6: {
	/* chunks: the text from one (of the object's block), into one
	 * that is there (made as large) and into a new one; blocks */
	optr c;
	MemHandle mh, m2;
	char *t;

	@call TOText::MSG_VIS_TEXT_REPLACE_ALL_OPTR(@TOString, 0);
	TOCHECK(Is(@TOText, "from a chunk"));
	@call TOText::MSG_VIS_TEXT_APPEND_OPTR(@TOString, 4);
	TOCHECK(Is(@TOText, "from a chunkfrom"));
	@call TOText::MSG_VIS_TEXT_SELECT_RANGE_SMALL(4, 12);
	@call TOText::MSG_VIS_TEXT_REPLACE_SELECTION_OPTR(@TOString, 0);
	TOCHECK(Is(@TOText, "fromfrom a chunkfrom"));
	TOCHECK(Selection(@TOText, 16, 16));
	TOCHECK(@call TOText::MSG_VIS_TEXT_GET_ALL_OPTR(@TOBuffer) ==
		OptrToChunk(@TOBuffer));
	TOCHECK(ChunkIs(@TOBuffer, "fromfrom a chunkfrom"));
	c = ConstructOptr(OptrToHandle(@TOText),
		@call TOText::MSG_VIS_TEXT_GET_ALL_OPTR(
			ConstructOptr(OptrToHandle(@TOText), 0)));
	TOCHECK(OptrToChunk(c) != 0 && c != @TOBuffer &&
		ChunkIs(c, "fromfrom a chunkfrom"));
	LMemFree(c);
	TOCHECK(ChunkIs(@TOString, "from a chunk"));

	mh = MemAlloc(16, HF_SWAPABLE, HAF_NO_ERR);
	t = MemLock(mh);
	memcpy(t, "in a block", 11);
	MemUnlock(mh);
	@call TOText::MSG_VIS_TEXT_REPLACE_ALL_BLOCK(mh, 0);
	TOCHECK(Is(@TOText, "in a block"));
	@call TOText::MSG_VIS_TEXT_APPEND_BLOCK(mh, 2);
	@call TOText::MSG_VIS_TEXT_SELECT_RANGE_SMALL(0, 3);
	@call TOText::MSG_VIS_TEXT_REPLACE_SELECTION_BLOCK(mh, 4);
	TOCHECK(Is(@TOText, "in aa blockin"));
	TOCHECK(@call TOText::MSG_VIS_TEXT_GET_ALL_BLOCK(mh) == mh);
	t = MemLock(mh);
	TOCHECK(Same(t, "in aa blockin"));
	MemUnlock(mh);
	m2 = @call TOText::MSG_VIS_TEXT_GET_ALL_BLOCK(0);
	TOCHECK(m2 != 0 && m2 != mh);
	if (m2) {
	    t = MemLock(m2);
	    TOCHECK(Same(t, "in aa blockin"));
	    MemFree(m2);
	}
	MemFree(mh);
	break;
    }
    case 7:
	/* the maximum length: a shorter one cuts the text and keeps the
	 * selection in it; more is refused, or cut where asked */
	TOCHECK(@call TOText::MSG_VIS_TEXT_GET_MAX_LENGTH() == 10000);
	@call TOText::MSG_VIS_TEXT_REPLACE_ALL_PTR("abcdefgh", 0);
	@call TOText::MSG_VIS_TEXT_SELECT_RANGE_SMALL(2, 7);
	@call TOText::MSG_VIS_TEXT_SET_MAX_LENGTH(4);
	TOCHECK(@call TOText::MSG_VIS_TEXT_GET_MAX_LENGTH() == 4);
	TOCHECK(Is(@TOText, "abcd"));
	TOCHECK(Selection(@TOText, 2, 4));
	@call TOText::MSG_VIS_TEXT_APPEND_PTR("e", 0);
	TOCHECK(Is(@TOText, "abcd"));
	memset(&p, 0, sizeof(p));
	p.VTRP_range.VTR_start = 1;
	p.VTRP_range.VTR_end = 3;
	p.VTRP_insCount = 3;
	p.VTRP_textReference.TR_type = TRT_POINTER;
	p.VTRP_textReference.TR_ref.TRU_pointer.TRP_pointer = "XYZ";
	TOCHECK(@call TOText::MSG_VIS_TEXT_REPLACE_TEXT(&p));
	TOCHECK(Is(@TOText, "abcd"));
	p.VTRP_flags = VTRF_TRUNCATE;
	TOCHECK(!@call TOText::MSG_VIS_TEXT_REPLACE_TEXT(&p));
	TOCHECK(Is(@TOText, "aXYd"));
	@call TOText::MSG_VIS_TEXT_SET_MAX_LENGTH(100);
	@call TOText::MSG_VIS_TEXT_APPEND_PTR("e", 0);
	TOCHECK(Is(@TOText, "aXYde"));
	break;
    case 8: {
	/* an object of a resource without a text; a new object:
	 * editable and selectable, empty, as long as it likes; the
	 * plain instance data */
	optr n;

	TOCHECK(Is(@TOEmpty, ""));
	TOCHECK(!@call TOEmpty::MSG_VIS_TEXT_GET_STATE());
	@call TOEmpty::MSG_VIS_TEXT_APPEND_PTR("one", 0);
	TOCHECK(Is(@TOEmpty, "one"));
	TOCHECK(toState.TOS_notEmpty == 2);
	TOCHECK(Is(@TOText, "aXYde"));

	n = ObjInstantiate(OptrToHandle(@TOText),
			   (ClassStruct *) &TOTextClass);
	TOCHECK(n != 0);
	TOCHECK(@call n::MSG_VIS_TEXT_GET_STATE() ==
		(VTS_EDITABLE | VTS_SELECTABLE));
	TOCHECK(@call n::MSG_VIS_TEXT_GET_MAX_LENGTH() == 0xffff);
	TOCHECK(Is(n, ""));
	@call n::MSG_VIS_TEXT_REPLACE_ALL_PTR("new", 0);
	TOCHECK(Is(n, "new") && Is(@TOEmpty, "one"));
	@call n::MSG_VIS_TEXT_MODIFY_EDITABLE_SELECTABLE(0, VTS_EDITABLE);
	TOCHECK(@call n::MSG_VIS_TEXT_GET_STATE() == VTS_SELECTABLE);
	@call n::MSG_VIS_TEXT_SET_FEATURES(VTF_ALLOW_UNDO, 0);
	TOCHECK(@call n::MSG_VIS_TEXT_GET_FEATURES() == VTF_ALLOW_UNDO);
	@call n::MSG_VIS_TEXT_SET_FEATURES(0, VTF_ALLOW_UNDO);
	TOCHECK(!@call n::MSG_VIS_TEXT_GET_FEATURES());
	@call n::MSG_VIS_TEXT_SET_OUTPUT(@TOText);
	TOCHECK(@call n::MSG_VIS_TEXT_GET_OUTPUT() == @TOText);
	@call n::MSG_VIS_TEXT_SET_LR_MARGIN(3);
	@call n::MSG_VIS_TEXT_SET_TB_MARGIN(2);
	TOCHECK(@call n::MSG_VIS_TEXT_GET_LR_MARGIN() == 3 &&
		@call n::MSG_VIS_TEXT_GET_TB_MARGIN() == 2);
	@call n::MSG_VIS_TEXT_SET_FILTER(VTF_NO_TABS);
	TOCHECK(@call n::MSG_VIS_TEXT_GET_FILTER() == VTF_NO_TABS);
	@call n::MSG_VIS_TEXT_SET_USER_MODIFIED();
	TOCHECK(@call n::MSG_VIS_TEXT_GET_USER_MODIFIED_STATE());
	@call n::MSG_VIS_TEXT_SET_NOT_USER_MODIFIED();
	TOCHECK(!@call n::MSG_VIS_TEXT_GET_USER_MODIFIED_STATE());
	break;
    }
    case 9: {
	/* the character attribute: the default record (Berkeley 12),
	 * changed field by field; kept as a record while one can say
	 * it, else in a chunk */
	VisTextCharAttr a, b;
	VisTextCharAttrDiffs d;
	VisTextInstance *t;
	WWFixed size;
	ColorQuad c;
	word chunks;

	t = ObjDerefVis(@TOText);
	TOCHECK((t->VTI_storageFlags & VTSF_DEFAULT_CHAR_ATTR) &&
		t->VTI_charAttrRuns == VIS_TEXT_INITIAL_CHAR_ATTR);
	chunks = ChunkCount(OptrToHandle(@TOText));
	(void) @call TOText::MSG_VIS_TEXT_GET_CHAR_ATTR(0, &d, &a, 0, 0);
	TOCHECK(a.VTCA_fontID == FID_BERKELEY &&
		a.VTCA_pointSize.WBF_int == 12 &&
		a.VTCA_pointSize.WBF_frac == 0 && a.VTCA_textStyles == 0);
	TOCHECK(a.VTCA_color.CQ_info == CF_INDEX &&
		a.VTCA_color.CQ_redOrIndex == C_BLACK &&
		a.VTCA_bgColor.CQ_redOrIndex == C_WHITE &&
		a.VTCA_grayScreen == SDM_100 && a.VTCA_bgGrayScreen == SDM_0);
	TOCHECK(a.VTCA_fontWeight == FW_NORMAL &&
		a.VTCA_fontWidth == FWI_MEDIUM &&
		a.VTCA_meta.SSEH_style == CA_NULL_ELEMENT);
	TOCHECK(d.VTCAD_diffs == 0 && d.VTCAD_textStyles == 0);

	/* another default record */
	@call TOText::MSG_VIS_TEXT_SET_CHAR_ATTR_BY_DEFAULT(
	    VTDCA_BOLD | VTDS_18 << VTDCA_SIZE_OFFSET | VTDF_URW_SANS |
	    C_BLUE << VTDCA_COLOR_OFFSET, TEXT_ADDRESS_PAST_END, 0);
	(void) @call TOText::MSG_VIS_TEXT_GET_CHAR_ATTR(0, &d, &a, 0, 0);
	TOCHECK(a.VTCA_fontID == FID_DTC_URW_SANS &&
		a.VTCA_pointSize.WBF_int == 18 &&
		a.VTCA_textStyles == TS_BOLD &&
		a.VTCA_color.CQ_redOrIndex == C_BLUE);
	t = ObjDerefVis(@TOText);
	TOCHECK(t->VTI_storageFlags & VTSF_DEFAULT_CHAR_ATTR);

	/* fields a record has: still a record */
	@call TOText::MSG_VIS_TEXT_SET_FONT_ID(FID_BERKELEY,
					       TEXT_ADDRESS_PAST_END, 0);
	size.WWF_int = 10;
	size.WWF_frac = 0;
	@call TOText::MSG_VIS_TEXT_SET_POINT_SIZE(size, TEXT_ADDRESS_PAST_END,
						  0);
	/* the same bits to set and to clear toggle */
	@call TOText::MSG_VIS_TEXT_SET_TEXT_STYLE(0, 0, TS_BOLD | TS_ITALIC,
						  TS_BOLD | TS_ITALIC,
						  TEXT_ADDRESS_PAST_END, 0);
	t = ObjDerefVis(@TOText);
	TOCHECK((t->VTI_storageFlags & VTSF_DEFAULT_CHAR_ATTR) &&
		t->VTI_charAttrRuns ==
		(VTDCA_ITALIC | VTDS_10 << VTDCA_SIZE_OFFSET | VTDF_BERKELEY |
		 C_BLUE << VTDCA_COLOR_OFFSET));
	TOCHECK(ChunkCount(OptrToHandle(@TOText)) == chunks);

	/* a size no record has: a chunk */
	size.WWF_int = 11;
	size.WWF_frac = 0x8000;
	@call TOText::MSG_VIS_TEXT_SET_POINT_SIZE(size, TEXT_ADDRESS_PAST_END,
						  0);
	t = ObjDerefVis(@TOText);
	TOCHECK(!(t->VTI_storageFlags & VTSF_DEFAULT_CHAR_ATTR));
	TOCHECK(ChunkCount(OptrToHandle(@TOText)) == chunks + 1);
	(void) @call TOText::MSG_VIS_TEXT_GET_CHAR_ATTR(0, &d, &a, 0, 0);
	TOCHECK(a.VTCA_pointSize.WBF_int == 11 &&
		a.VTCA_pointSize.WBF_frac == 0x80 &&
		a.VTCA_textStyles == TS_ITALIC &&
		a.VTCA_fontID == FID_BERKELEY);
	/* superscript and subscript: the new one wins; an RGB color */
	@call TOText::MSG_VIS_TEXT_SET_TEXT_STYLE(0, VTES_BOXED, 0,
						  TS_SUPERSCRIPT,
						  TEXT_ADDRESS_PAST_END, 0);
	@call TOText::MSG_VIS_TEXT_SET_TEXT_STYLE(0, 0, TS_ITALIC,
						  TS_SUBSCRIPT,
						  TEXT_ADDRESS_PAST_END, 0);
	c.CQ_redOrIndex = 10;
	c.CQ_info = CF_RGB;
	c.CQ_green = 20;
	c.CQ_blue = 30;
	@call TOText::MSG_VIS_TEXT_SET_COLOR(c, TEXT_ADDRESS_PAST_END, 0);
	(void) @call TOText::MSG_VIS_TEXT_GET_CHAR_ATTR(0, &d, &a, 0, 0);
	TOCHECK(a.VTCA_textStyles == TS_SUBSCRIPT &&
		a.VTCA_extendedStyles == VTES_BOXED);
	TOCHECK(a.VTCA_color.CQ_info == CF_RGB &&
		a.VTCA_color.CQ_redOrIndex == 10 &&
		a.VTCA_color.CQ_green == 20 && a.VTCA_color.CQ_blue == 30);

	/* compared with a passed attribute */
	b = a;
	b.VTCA_fontID = FID_DTC_URW_MONO;
	b.VTCA_textStyles = TS_SUBSCRIPT | TS_BOLD;
	memset(&d, 0, sizeof(d));
	(void) @call TOText::MSG_VIS_TEXT_GET_CHAR_ATTR(
	    VTGAF_MERGE_WITH_PASSED, &d, &b, 0, 0);
	TOCHECK(d.VTCAD_diffs == VTCAF_MULTIPLE_FONT_IDS &&
		d.VTCAD_textStyles == TS_BOLD &&
		d.VTCAD_extendedStyles == 0 &&
		b.VTCA_fontID == FID_BERKELEY);

	/* a whole attribute; one a record can say frees the chunk */
	a.VTCA_fontWeight = FW_NORMAL + 20;
	@call TOText::MSG_VIS_TEXT_SET_CHAR_ATTR(&a, TEXT_ADDRESS_PAST_END,
						 0);
	(void) @call TOText::MSG_VIS_TEXT_GET_CHAR_ATTR(0, &d, &b, 0, 0);
	TOCHECK(!memcmp(&a, &b, sizeof(a)));
	TOCHECK(ChunkCount(OptrToHandle(@TOText)) == chunks + 1);
	@call TOText::MSG_VIS_TEXT_SET_CHAR_ATTR_BY_DEFAULT(
	    VIS_TEXT_INITIAL_CHAR_ATTR, TEXT_ADDRESS_PAST_END, 0);
	t = ObjDerefVis(@TOText);
	TOCHECK((t->VTI_storageFlags & VTSF_DEFAULT_CHAR_ATTR) &&
		t->VTI_charAttrRuns == VIS_TEXT_INITIAL_CHAR_ATTR);
	TOCHECK(ChunkCount(OptrToHandle(@TOText)) == chunks);
	/* the text is as it was */
	TOCHECK(Is(@TOText, "aXYde"));
	break;
    }
    case 10: {
	/* the lines: none before the geometry is valid.  Berkeley 10:
	 * H is 7 wide, i 3, a space 4, a line 12 high with the baseline
	 * at 10.  The text is 50 wide. */
	struct { LineInfo li; FieldInfo more[2]; } b;
	VisTextGetLineInfoParameters gp;
	VisTextGetLineInfoReturnValues gr;
	VisTextGetLineOffsetAndFlagsParameters op;
	VisTextInstance *t;
	WWFixed size;

	TOCHECK(!((VisTextInstance *) ObjDerefVis(@TOText))->VTI_lines);
	gp.VTGLIP_buffer = &b.li;
	gp.VTGLIP_bsize = sizeof(b);
	gp.VTGLIP_line = 0;
	TOCHECK(@call TOText::MSG_VIS_TEXT_GET_LINE_INFO(&gr, &gp));
	size.WWF_int = 10;
	size.WWF_frac = 0;
	@call TOText::MSG_VIS_TEXT_SET_POINT_SIZE(size, TEXT_ADDRESS_PAST_END,
						  0);
	@call TOText::MSG_VIS_SET_SIZE(50, 40);
	@call TOText::MSG_VIS_NOTIFY_GEOMETRY_VALID();
	t = ObjDerefVis(@TOText);
	TOCHECK(t->VTI_lines && t->VTI_height.WBF_int == 12 &&
		!t->VTI_gstate);
	TOCHECK(!@call TOText::MSG_VIS_TEXT_GET_LINE_INFO(&gr, &gp));
	toState.TOS_line[0] = b.li.LI_flags;
	toState.TOS_line[1] = b.li.LI_firstField.FI_width;
	toState.TOS_line[2] = b.li.LI_firstField.FI_nChars;
	toState.TOS_line[3] = b.li.LI_hgt.WBF_int;
	TOCHECK(gr.VTGLIRV_byteCount ==
		offsetof(LineInfo, LI_firstField) + sizeof(FieldInfo));
	TOCHECK(b.li.LI_flags == (LF_STARTS_PARAGRAPH | LF_ENDS_PARAGRAPH |
				  LF_ENDS_IN_NULL | LF_NEEDS_DRAW));
	TOCHECK(b.li.LI_count.WAAH_low == 5 &&
		b.li.LI_firstField.FI_nChars == 5 &&
		b.li.LI_hgt.WBF_int == 12 && b.li.LI_blo.WBF_int == 10);
	gp.VTGLIP_line = 1;
	TOCHECK(@call TOText::MSG_VIS_TEXT_GET_LINE_INFO(&gr, &gp));

	/* word wrap: three words fit, the space after them stays */
	@call TOText::MSG_VIS_TEXT_REPLACE_ALL_PTR("Hi Hi Hi Hi Hi", 0);
	t = ObjDerefVis(@TOText);
	TOCHECK(t->VTI_height.WBF_int == 24);
	gp.VTGLIP_line = 0;
	TOCHECK(!@call TOText::MSG_VIS_TEXT_GET_LINE_INFO(&gr, &gp));
	toState.TOS_line[4] = b.li.LI_flags;
	toState.TOS_line[5] = b.li.LI_firstField.FI_width;
	toState.TOS_line[6] = b.li.LI_lineEnd;
	toState.TOS_line[7] = b.li.LI_count.WAAH_low;
	TOCHECK(b.li.LI_flags == (LF_STARTS_PARAGRAPH | LF_NEEDS_DRAW));
	TOCHECK(b.li.LI_count.WAAH_low == 9 &&
		b.li.LI_firstField.FI_width == 42 &&
		b.li.LI_lineEnd == 38 && b.li.LI_adjustment == 0);
	gp.VTGLIP_line = 1;
	TOCHECK(!@call TOText::MSG_VIS_TEXT_GET_LINE_INFO(&gr, &gp));
	TOCHECK(b.li.LI_flags == (LF_ENDS_PARAGRAPH | LF_ENDS_IN_NULL |
				  LF_NEEDS_DRAW));
	TOCHECK(b.li.LI_count.WAAH_low == 5 &&
		b.li.LI_firstField.FI_width == 24 &&
		b.li.LI_firstField.FI_position == 0);
	gp.VTGLIP_line = 2;
	TOCHECK(@call TOText::MSG_VIS_TEXT_GET_LINE_INFO(&gr, &gp));
	TOCHECK(@call TOText::MSG_VIS_TEXT_GET_LINE_FROM_OFFSET(8) == 0 &&
		@call TOText::MSG_VIS_TEXT_GET_LINE_FROM_OFFSET(9) == 1 &&
		@call TOText::MSG_VIS_TEXT_GET_LINE_FROM_OFFSET(14) == 1);
	op.VTGLOAFP_line = 1;
	TOCHECK(!@call TOText::MSG_VIS_TEXT_GET_LINE_OFFSET_AND_FLAGS(&op) &&
		op.VTGLOAFP_offset == 9 &&
		(op.VTGLOAFP_flags & LF_ENDS_IN_NULL));
	op.VTGLOAFP_line = 2;
	TOCHECK(@call TOText::MSG_VIS_TEXT_GET_LINE_OFFSET_AND_FLAGS(&op));

	/* right justified, centered: the line moved (LI_adjustment) */
	t = ObjDerefVis(@TOText);
	t->VTI_paraAttrRuns = DEF_PARA_ATTR_JUST_TABS(J_RIGHT, VTDDT_HALF_INCH);
	@call TOText::MSG_VIS_TEXT_RECALC_AND_DRAW();
	gp.VTGLIP_line = 0;
	(void) @call TOText::MSG_VIS_TEXT_GET_LINE_INFO(&gr, &gp);
	toState.TOS_line[8] = b.li.LI_adjustment;
	TOCHECK(b.li.LI_adjustment == 12 && b.li.LI_lineEnd == 50);
	gp.VTGLIP_line = 1;
	(void) @call TOText::MSG_VIS_TEXT_GET_LINE_INFO(&gr, &gp);
	TOCHECK(b.li.LI_adjustment == 26);
	t = ObjDerefVis(@TOText);
	t->VTI_paraAttrRuns = DEF_PARA_ATTR_JUST_TABS(J_CENTER,
						      VTDDT_HALF_INCH);
	@call TOText::MSG_VIS_TEXT_RECALC_AND_DRAW();
	(void) @call TOText::MSG_VIS_TEXT_GET_LINE_INFO(&gr, &gp);
	TOCHECK(b.li.LI_adjustment == 13);
	/* fully justified: the spaces of a wrapped line padded (two
	 * count, 12 to share), the last field as much wider; not the
	 * paragraph's last line */
	t = ObjDerefVis(@TOText);
	t->VTI_paraAttrRuns = DEF_PARA_ATTR_JUST_TABS(J_FULL, VTDDT_HALF_INCH);
	@call TOText::MSG_VIS_TEXT_RECALC_AND_DRAW();
	gp.VTGLIP_line = 0;
	(void) @call TOText::MSG_VIS_TEXT_GET_LINE_INFO(&gr, &gp);
	toState.TOS_line[9] = b.li.LI_spacePad.WBF_int;
	toState.TOS_line[10] = b.li.LI_firstField.FI_width;
	TOCHECK(b.li.LI_spacePad.WBF_int == 6 && b.li.LI_adjustment == 0 &&
		b.li.LI_firstField.FI_width == 42 + 18 &&
		b.li.LI_lineEnd == 50);
	gp.VTGLIP_line = 1;
	(void) @call TOText::MSG_VIS_TEXT_GET_LINE_INFO(&gr, &gp);
	TOCHECK(b.li.LI_spacePad.WBF_int == 0 && b.li.LI_adjustment == 0);
	t = ObjDerefVis(@TOText);
	t->VTI_paraAttrRuns = VIS_TEXT_INITIAL_PARA_ATTR;

	/* a carriage return ends the paragraph; a tab starts a field at
	 * the next default tab stop (every half inch) */
	@call TOText::MSG_VIS_TEXT_REPLACE_ALL_PTR("H\ri\tH", 0);
	t = ObjDerefVis(@TOText);
	TOCHECK(t->VTI_height.WBF_int == 24);
	gp.VTGLIP_line = 0;
	(void) @call TOText::MSG_VIS_TEXT_GET_LINE_INFO(&gr, &gp);
	TOCHECK(b.li.LI_flags == (LF_STARTS_PARAGRAPH | LF_ENDS_PARAGRAPH |
				  LF_ENDS_IN_CR | LF_NEEDS_DRAW) &&
		b.li.LI_count.WAAH_low == 2 && b.li.LI_lineEnd == 7);
	gp.VTGLIP_line = 1;
	(void) @call TOText::MSG_VIS_TEXT_GET_LINE_INFO(&gr, &gp);
	toState.TOS_line[11] = gr.VTGLIRV_byteCount;
	toState.TOS_line[12] = b.more[0].FI_position;
	toState.TOS_line[13] = b.more[0].FI_tab;
	TOCHECK(gr.VTGLIRV_byteCount ==
		offsetof(LineInfo, LI_firstField) + 2 * sizeof(FieldInfo));
	TOCHECK(b.li.LI_count.WAAH_low == 3 &&
		b.li.LI_firstField.FI_nChars == 1 &&
		b.li.LI_firstField.FI_width == 3 &&
		b.more[0].FI_nChars == 2 && b.more[0].FI_position == 36 &&
		b.more[0].FI_width == 7 && b.more[0].FI_tab == 0x81 &&
		b.li.LI_lineEnd == 43);

	/* less text: the lines left over go; one edited in the middle */
	@call TOText::MSG_VIS_TEXT_REPLACE_ALL_PTR("Hi Hi Hi", 0);
	t = ObjDerefVis(@TOText);
	TOCHECK(t->VTI_height.WBF_int == 12 &&
		ChunkArrayGetCountHandles(OptrToHandle(@TOText),
					  t->VTI_lines) == 1);
	gp.VTGLIP_line = 0;
	(void) @call TOText::MSG_VIS_TEXT_GET_LINE_INFO(&gr, &gp);
	TOCHECK(gr.VTGLIRV_byteCount ==
		offsetof(LineInfo, LI_firstField) + sizeof(FieldInfo) &&
		b.li.LI_firstField.FI_width == 38);
	break;
    }
    case 11: {
	/* the sizes for the geometry: of the font; of the text on one
	 * line; the height at a width, asked only (nothing changes) and
	 * to be cached (the lines of another height go, to be made
	 * again when the geometry is valid) */
	VisTextInstance *t = ObjDerefVis(@TOText);
	word tb = 2 * t->VTI_tbMargin, lr = 2 * t->VTI_lrMargin;

	toState.TOS_geo[0] = @call TOText::MSG_VIS_TEXT_GET_LINE_HEIGHT();
	toState.TOS_geo[1] = @call TOText::MSG_VIS_TEXT_GET_AVERAGE_CHAR_WIDTH();
	toState.TOS_geo[2] = @call TOText::MSG_VIS_TEXT_GET_MIN_WIDTH();
	toState.TOS_geo[3] = @call TOText::MSG_VIS_TEXT_GET_SIMPLE_MIN_WIDTH();
	TOCHECK(toState.TOS_geo[0] >= 12 && toState.TOS_geo[0] <= 14);
	TOCHECK(toState.TOS_geo[1] >= 4 && toState.TOS_geo[1] <= 8);
	TOCHECK(toState.TOS_geo[2] == 47 + lr &&
		toState.TOS_geo[3] < toState.TOS_geo[2] &&
		toState.TOS_geo[3] > lr + 6);
	TOCHECK(@call TOText::MSG_VIS_TEXT_GET_ONE_LINE_WIDTH(0) == 38 &&
		@call TOText::MSG_VIS_TEXT_GET_ONE_LINE_WIDTH(2) == 10);
	@call TOText::MSG_VIS_TEXT_REPLACE_ALL_PTR("Hi Hi Hi Hi Hi", 0);
	t = ObjDerefVis(@TOText);
	TOCHECK(t->VTI_height.WBF_int == 24 && !t->VTI_gstate);
	toState.TOS_geo[4] = @call TOText::MSG_VIS_TEXT_CALC_HEIGHT(100, FALSE);
	t = ObjDerefVis(@TOText);
	TOCHECK(toState.TOS_geo[4] == 12 + tb);
	TOCHECK(t->VTI_height.WBF_int == 24 && t->VTI_lines &&
		t->VTI_lastWidth != 100 && !t->VTI_gstate &&
		t->VI_bounds.R_right - t->VI_bounds.R_left == 50);
	TOCHECK(ChunkArrayGetCountHandles(OptrToHandle(@TOText),
					  t->VTI_lines) == 2);
	TOCHECK(@call TOText::MSG_VIS_TEXT_CALC_HEIGHT(50, FALSE) == 24 + tb);
	toState.TOS_geo[5] = @call TOText::MSG_VIS_TEXT_CALC_HEIGHT(100, TRUE);
	t = ObjDerefVis(@TOText);
	TOCHECK(toState.TOS_geo[5] == 12 + tb && !t->VTI_lines &&
		t->VTI_lastWidth == 100 && t->VTI_height.WBF_int == 12);
	/* (the same width again: from the cache) */
	TOCHECK(@call TOText::MSG_VIS_TEXT_CALC_HEIGHT(100, TRUE) == 12 + tb);
	@call TOText::MSG_VIS_SET_SIZE(100, 40);
	@call TOText::MSG_VIS_NOTIFY_GEOMETRY_VALID();
	t = ObjDerefVis(@TOText);
	TOCHECK(t->VTI_lines && t->VTI_height.WBF_int == 12 &&
		ChunkArrayGetCountHandles(OptrToHandle(@TOText),
					  t->VTI_lines) == 1);
	break;
    }
    }
    (void) @call TOText::MSG_VIS_TEXT_GET_ALL_PTR(buf);
    memcpy(toState.TOS_text, buf, sizeof(toState.TOS_text) - 1);
}

/* a step on the process thread, from the test (MF_CALL) */
void TOStep(word step)
{
    @call ConstructOptr(toState.TOS_process, 0)::MSG_TO_STEP(step);
}
