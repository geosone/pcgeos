/***********************************************************************
 *
 * gocres.goc -- object resources made by goc -cg (Port32/ABI.md 4).
 *
 * goc -cg turns this file into C for a flat 32/64-bit host; the test
 * (test_gocres.c) links it and checks the tables the geode loader will
 * get: chunk handles, unrelocated optrs in instance data, chunks made of
 * two C objects, the class structure and its method table.
 *
 ***********************************************************************/
@include <stdapp.goh>
#include <stdio.h>
#include <string.h>

@class GocTestProcessClass, GenProcessClass;
@message void MSG_GOCTEST_PING(word value);
@message sdword MSG_GOCTEST_ADD(sword a, sdword b, WWFixed c);
@message void MSG_GOCTEST_STORE(const char *text, word len);
@endc
@classdecl GocTestProcessClass, neverSaved;

@start AppResource;
@object GenApplicationClass GocTestApp = {
    GI_visMoniker = list { @GocTestTextMoniker };
    GI_comp = @GocTestPrimary;
    gcnList(MANUFACTURER_ID_GEOWORKS, GAGCNLT_WINDOWS) = @GocTestPrimary;
}
@visMoniker GocTestTextMoniker = "Goc Test";
@end AppResource;

@start Interface;
@object GenPrimaryClass GocTestPrimary = {
    GI_comp = @GocTestTrigger, @GocTestGlyph;
}
@object GenTriggerClass GocTestTrigger = {
    GI_visMoniker = "Ping";
    GTI_destination = process;
    GTI_actionMsg = MSG_GOCTEST_PING;
}
@object GenGlyphClass GocTestGlyph = {
    GI_visMoniker = "Hello";
}
@chunk char GocTestText[] = "some text";
@end Interface;

/* a static table of chunk handles must stay a constant expression */
const ChunkHandle gocTestChunks[] = {
    OptrToChunk(@GocTestTrigger),
    OptrToChunk(@GocTestGlyph),
    OptrToChunk(@GocTestText)
};

/* static optrs in code: unrelocated constants, resolved where used */
static const optr gocTestOne = @GocTestText;
const optr gocTestOptrs[] = { @GocTestTrigger, @GocTestGlyph, @GocTestApp };
typedef struct {
    ChunkHandle	TFI_object;
    optr	TFI_name;
    word	TFI_flags;
} TestFeaturesInfo;		/* like GenControlFeaturesInfo */

static const TestFeaturesInfo *
GocTestFeatures(void)
{
    static const TestFeaturesInfo list[] = {
	{OptrToChunk(@GocTestTrigger), @GocTestTextMoniker, 1},
	{OptrToChunk(@GocTestGlyph), @GocTestText, 2}
    };
    return list;
}

@method GocTestProcessClass, MSG_GOCTEST_PING
{
    if (value != 0) {
	@send GocTestGlyph::MSG_GEN_SET_NOT_USABLE(VUM_NOW);
    }
    @callsuper();
}

@method GocTestProcessClass, MSG_GOCTEST_ADD
{
    return a + b + c.WWF_int;
}

char gocTestStored[32];

@method GocTestProcessClass, MSG_GOCTEST_STORE
{
    memcpy(gocTestStored, text, len);
    gocTestStored[len] = '\0';
}

/* ---------------------------------------------------------------------
 * Checks, called by test_gocres.c.  The resource data is emitted at the
 * end of the file, so it is reached through the descriptors.
 * ------------------------------------------------------------------ */
extern const GocResource __goc_resource_AppResource;
extern const GocResource __goc_resource_Interface;

static int gocFails;

static void
Check(int ok, const char *what)
{
    if (!ok) {
	gocFails++;
	printf("FAIL %s\n", what);
    }
}

/* the chunk table entry of a chunk handle */
static const GocChunk *
TestChunkOf(const GocResource *res, ChunkHandle ch)
{
    word first = (word) GOCR_LMEM_HANDLES(ObjLMemBlockHeader);

    if (ch < first || (ch - first) % 2 != 0 ||
	(ch - first) / 2 >= res->GR_chunks) {
	return NULL;
    }
    return &res->GR_chunk[(ch - first) / 2];
}

static GenInstance *
TestGenPart(const GocChunk *c)
{
    const GenBase *base = (const GenBase *) c->GC_data;

    return (GenInstance *) ((byte *) c->GC_data + base->Gen_offset);
}

int
GocTestCheck(void)
{
    const GocResource *ui = &__goc_resource_Interface;
    const GocResource *app = &__goc_resource_AppResource;
    const ObjLMemBlockHeader *hdr = ui->GR_header;
    const GocChunk *primary, *trigger, *glyph, *text, *appObj, *moniker;

    Check(ui->GR_number == GOCR_RES_INTERFACE, "Interface number");
    Check(app->GR_number == GOCR_RES_APPRESOURCE, "AppResource number");
    Check(hdr->OLMBH_header.LMBH_lmemType == LMEM_TYPE_OBJ_BLOCK, "obj block");
    Check(hdr->OLMBH_header.LMBH_offset ==
	  (word) GOCR_LMEM_HANDLES(ObjLMemBlockHeader), "handle table offset");
    Check(hdr->OLMBH_header.LMBH_nHandles >= ui->GR_chunks &&
	  hdr->OLMBH_header.LMBH_nHandles % 2 == 0, "handle count");
    Check(ui->GR_chunk[0].GC_size >= ui->GR_chunks, "flags chunk");

    primary = TestChunkOf(ui, GocTestPrimary);
    trigger = TestChunkOf(ui, GocTestTrigger);
    glyph = TestChunkOf(ui, GocTestGlyph);
    text = TestChunkOf(ui, GocTestText);
    appObj = TestChunkOf(app, GocTestApp);
    moniker = TestChunkOf(app, GocTestTextMoniker);
    Check(primary && trigger && glyph && text && appObj && moniker,
	  "chunks in their resources");
    if (gocFails) {
	return gocFails;
    }
    Check(GocTestPrimary_resid == GOCR_RES_INTERFACE, "resid");
    Check(GocTestApp_resid == GOCR_RES_APPRESOURCE, "resid app");

    /* the object tree: unrelocated optrs (resource number, chunk) */
    Check(TestGenPart(primary)->GI_comp.CP_firstChild ==
	  GOCR_UNRELOC_OPTR(GOCR_RES_INTERFACE, GocTestTrigger), "GI_comp");
    Check(TestGenPart(trigger)->GI_link.LP_next ==
	  GOCR_UNRELOC_OPTR(GOCR_RES_INTERFACE, GocTestGlyph), "GI_link");
    Check(TestGenPart(glyph)->GI_link.LP_next ==
	  (GOCR_UNRELOC_OPTR(GOCR_RES_INTERFACE, GocTestPrimary) | 1),
	  "GI_link to parent");
    Check(TestGenPart(appObj)->GI_comp.CP_firstChild ==
	  GOCR_UNRELOC_OPTR(GOCR_RES_INTERFACE, GocTestPrimary),
	  "GI_comp across resources");
    Check(((GenTriggerInstance *) TestGenPart(trigger))->GTI_destination ==
	  GOCR_PROCESS_OPTR, "process as destination");
    Check(((GenTriggerInstance *) TestGenPart(trigger))->GTI_actionMsg ==
	  MSG_GOCTEST_PING, "action message");
    Check(((MetaBase *) primary->GC_data)->MB_class ==
	  (ClassStruct *) &GenPrimaryClass, "class pointer");

    /* chunk data */
    Check(text->GC_size == sizeof("some text") &&
	  !strcmp((const char *) text->GC_data, "some text") &&
	  text->GC_data2 == NULL, "plain chunk");
    Check(moniker->GC_data2 != NULL &&
	  moniker->GC_size2 == sizeof("Goc Test") &&
	  !strcmp((const char *) moniker->GC_data2, "Goc Test"),
	  "text moniker in two parts");
    Check(gocTestChunks[0] == GocTestTrigger &&
	  gocTestChunks[1] == GocTestGlyph &&
	  gocTestChunks[2] == GocTestText, "OptrToChunk(@x) table");

    /* sending messages: parameters as a structure, methods via thunks */
    {
	extern int gocTestSuperCalls;
	WWFixed c;
	EventHandle ev;

	c.WWF_frac = 0;
	c.WWF_int = 5;
	Check(@call process::MSG_GOCTEST_ADD(-3, 100000, c) == 100002,
	      "@call with parameters and reply");
	@send process::MSG_GOCTEST_STORE("hello", 5);
	Check(!strcmp(gocTestStored, "hello"), "@send");
	ev = @record process::MSG_GOCTEST_STORE("again", 5);
	Check(!strcmp(gocTestStored, "hello"), "@record does not deliver");
	@dispatch ev;
	Check(!strcmp(gocTestStored, "again"), "@dispatch");
	@call process::MSG_GOCTEST_PING(0);
	Check(gocTestSuperCalls == 1, "@callsuper");
    }

    /* static optrs in code */
    {
	extern optr gocTestLastDest;
	const TestFeaturesInfo *f = GocTestFeatures();
	optr automatic;

	__goc_resource_handles[0] = 0x11;
	__goc_resource_handles[GOCR_RES_INTERFACE] = 0x22;
	__goc_resource_handles[GOCR_RES_APPRESOURCE] = 0x33;
	{
	    optr a = @GocTestGlyph;	/* not static: relocated at once */
	    automatic = a;
	}
	Check(gocTestOne == GOCR_UNRELOC_OPTR(GOCR_RES_INTERFACE, GocTestText),
	      "static optr unrelocated");
	Check(gocTestOptrs[2] ==
	      GOCR_UNRELOC_OPTR(GOCR_RES_APPRESOURCE, GocTestApp),
	      "static optr table");
	Check(GOCR_RESOLVE(gocTestOptrs[1]) == ConstructOptr(0x22, GocTestGlyph) &&
	      GOCR_RESOLVE(gocTestOptrs[2]) == ConstructOptr(0x33, GocTestApp),
	      "GOCR_RESOLVE");
	Check(GOCR_RESOLVE(GOCR_PROCESS_OPTR) == ConstructOptr(0x11, 0),
	      "GOCR_RESOLVE process");
	Check(GOCR_RESOLVE(automatic) == automatic &&
	      automatic == ConstructOptr(0x22, GocTestGlyph),
	      "automatic optr relocated");
	Check(f[0].TFI_object == GocTestTrigger &&
	      f[0].TFI_name == GOCR_UNRELOC_OPTR(GOCR_RES_APPRESOURCE,
						 GocTestTextMoniker) &&
	      f[1].TFI_flags == 2, "static feature list");
	Check(GeodeResolveOptrAt(&f[1].TFI_name, f[1].TFI_name) ==
	      ConstructOptr(0x22, GocTestText), "GeodeResolveOptrAt");
	@send gocTestOptrs[1]::MSG_GEN_SET_NOT_USABLE(VUM_NOW);
	Check(gocTestLastDest == ConstructOptr(0x22, GocTestGlyph),
	      "@send to a static optr");
    }

    /* the class structure points to its tables */
    Check(GocTestProcessClass.Class_superClass ==
	  (ClassStruct *) &GenProcessClass, "superclass");
    {
	static const Message msgs[] = {
	    MSG_GOCTEST_PING, MSG_GOCTEST_ADD, MSG_GOCTEST_STORE
	};
	word i, j, found = 0;

	for (i = 0; i < 3; i++) {
	    for (j = 0; j < GocTestProcessClass.Class_methodCount; j++) {
		if (GocTestProcessClass.Class_messages[j] == msgs[i] &&
		    GocTestProcessClass.Class_methods[j] != NULL) {
		    found++;
		}
	    }
	}
	Check(GocTestProcessClass.Class_methodCount == 3 && found == 3 &&
	      GocTestProcessClass.Class_htypes != NULL, "method table");
    }
    return gocFails;
}
