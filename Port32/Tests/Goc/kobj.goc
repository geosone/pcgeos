/***********************************************************************
 *
 * kobj.goc -- the object system of the C kernel (Port32/ABI.md
 * section 13): object layout, variable data, relocation, MetaClass and
 * ProcessClass, ObjInstantiate, freeing objects and blocks,
 * composites.
 *
 * Two master levels with optrs in their instance data, variable data
 * with an optr that is relocated, a class with a relocation method and
 * a class without master levels; objects in two resources that point to
 * each other and to the process; a tree of composites across both
 * resources.  test_kernel_obj.c drives it.
 *
 ***********************************************************************/
@include <stdapp.goh>
#include <stdio.h>
#include <string.h>

/* kernel internals the test uses (kernelC.h) */
void ObjRelocateObjBlock(MemHandle mh, word vmRelocType);
void ObjUnRelocateObjBlock(MemHandle mh, word vmRelocType);

/* numbered like IMClass of the kernel (a subclass of ProcessClass;
 * CInclude/Internal/im.h) */
@class KOIMClass, ProcessClass;
@message void MSG_KOIM_BUTTON_CHANGE();
@message void MSG_KOIM_PTR_CHANGE();
@message void MSG_KOIM_PRESSURE_CHANGE();
@message void MSG_KOIM_DIRECTION_CHANGE();
@message void MSG_KOIM_KBD_SCAN();
@message void MSG_KOIM_UNUSED_5();
@message void MSG_KOIM_UNUSED_6();
@message void MSG_KOIM_UNUSED_7();
@message void MSG_KOIM_UNUSED_8();
@message void MSG_KOIM_UNUSED_9();
@message void MSG_KOIM_UNUSED_10();
@message void MSG_KOIM_UNUSED_11();
@message void MSG_KOIM_UNUSED_12();
@message void MSG_KOIM_UNUSED_13();
@message void MSG_KOIM_UNUSED_14();
@message void MSG_KOIM_UNUSED_15();
@message void MSG_KOIM_UNUSED_16();
@message void MSG_KOIM_UNUSED_17();
@message void MSG_KOIM_UNUSED_18();
@message void MSG_KOIM_UNUSED_19();
@message void MSG_KOIM_UNUSED_20();
@message void MSG_KOIM_UNUSED_21();
@message void MSG_KOIM_UNUSED_22();
@message void MSG_KOIM_MOUSE_WHEEL_VERTICAL();
@endc

@class KOTopClass, MetaClass, master;
    @instance optr KOTI_link;
    @instance word KOTI_inits;
@message word MSG_KOT_INITS();
@endc
@classdecl KOTopClass;

@class KOMidClass, KOTopClass, master;
    @instance optr KOMI_target;
    @instance word KOMI_value;
    @instance MemHandle KOMI_block;
    @reloc KOMI_block, handle;
    @vardata optr ATTR_KOM_LINK;
    @reloc ATTR_KOM_LINK, 0, optr;
    @vardata void HINT_KOM_FLAG;
    @vardata char[] ATTR_KOM_NAME;
    @vardata dword ATTR_KOM_COUNT;
    @vardata word TEMP_KOM_INIT;
@message word MSG_KOM_GET_VALUE();
@message void MSG_KOM_BUMP();
@endc
@classdecl KOMidClass;

@class KORelocClass, KOMidClass;
    @instance word KORI_extra;
@endc
@classdecl KORelocClass;

@class KOPlainClass, MetaClass;
    @instance optr KOPI_other;
    @instance optr KOPI_proc;
    @instance word KOPI_x;
    @vardata word ATTR_KOP_W;
@endc
@classdecl KOPlainClass;

@class KOCompClass, MetaClass, master;
    @instance @link KOCI_link;
    @instance @composite KOCI_kids = KOCI_link;
    @instance word KOCI_id;
@message void MSG_KOC_VISIT(word add);
@message word MSG_KOC_ID();
@message word MSG_KOC_PARENT_ID();
@endc
@classdecl KOCompClass;

@define kocChildren @children word_offsetof(KOCompBase, KOComp_offset), word_offsetof(KOCompInstance, KOCI_kids), word_offsetof(KOCompInstance, KOCI_link)
@define kocParent @parent word_offsetof(KOCompBase, KOComp_offset), word_offsetof(KOCompInstance, KOCI_link)

@class KObjProcessClass, ProcessClass;
@endc
@classdecl KObjProcessClass;

@start Objects;
@object KOMidClass KOObj1 = {
    KOTI_link = @KOPlain1;
    KOMI_target = @KOObj2;
    KOMI_value = 7;
    ATTR_KOM_LINK = @KOPlain1;
    HINT_KOM_FLAG;
    ATTR_KOM_NAME = "hello";
    ATTR_KOM_COUNT = 0x12345678;
}
@object KORelocClass KOObj2 = {
    KOMI_target = @KOOther;
    KOMI_value = 9;
}
@object KOPlainClass KOPlain1 = {
    KOPI_other = @KOObj1;
    KOPI_proc = process;
    KOPI_x = 3;
}
@object KOCompClass KOTree = {
    KOCI_id = 1;
    KOCI_kids = @KOLeafA, @KOLeafB, @KOLeafC;
}
@object KOCompClass KOLeafA = {
    KOCI_id = 10;
}
@object KOCompClass KOLeafC = {
    KOCI_id = 30;
}
@end Objects;

@start Other;
@object KOPlainClass KOOther = {
    KOPI_other = @KOObj2;
    KOPI_x = 4;
    ATTR_KOP_W = 0x55;
}
@object KOCompClass KOLeafB = {
    KOCI_id = 20;
}
@end Other;

/* goc's message numbers, for the kernel's KMSG_* (test_kernel_obj.c) */
const Message kobjGocMessages[] = {
    MSG_META_NULL, MSG_META_INITIALIZE, MSG_META_DUMMY, MSG_META_ACK,
    MSG_META_GET_CLASS, MSG_META_IS_OBJECT_IN_CLASS, MSG_META_BLOCK_FREE,
    MSG_META_OBJ_FREE, MSG_META_FINAL_OBJ_FREE,
    MSG_META_DEC_BLOCK_REF_COUNT, MSG_META_RESOLVE_VARIANT_SUPERCLASS,
    MSG_META_RELOCATE, MSG_META_UNRELOCATE, MSG_META_SET_FLAGS,
    MSG_META_GET_FLAGS, MSG_META_DISPATCH_EVENT,
    MSG_META_SEND_CLASSED_EVENT, MSG_META_GET_OPTR,
    MSG_META_ADD_VAR_DATA, MSG_META_DELETE_VAR_DATA,
    MSG_META_INITIALIZE_VAR_DATA, MSG_META_GET_VAR_DATA,
    MSG_META_NOTIFY_OBJ_BLOCK_INTERACTIBLE,
    MSG_META_NOTIFY_OBJ_BLOCK_NOT_INTERACTIBLE,
    MSG_META_SET_OBJ_BLOCK_OUTPUT, MSG_META_GET_OBJ_BLOCK_OUTPUT,
    MSG_PROCESS_INSTANTIATE, MSG_PROCESS_FINAL_BLOCK_FREE,
    MSG_PROCESS_INSTANTIATE_FOR_THREAD,
    MSG_META_NOTIFY, MSG_META_NOTIFY_WITH_DATA_BLOCK,
    MSG_META_GCN_LIST_ADD, MSG_META_GCN_LIST_REMOVE,
    MSG_META_GCN_LIST_SEND, MSG_META_GCN_LIST_DESTROY,
    MSG_META_GCN_LIST_FIND_ITEM,
    MSG_META_DETACH, MSG_META_DETACH_COMPLETE, MSG_META_APP_SHUTDOWN,
    MSG_META_SHUTDOWN_COMPLETE, MSG_META_SHUTDOWN_ACK, MSG_META_QUIT,
    MSG_META_QUIT_ACK, MSG_META_FINISH_QUIT, MSG_PROCESS_EXIT,
    MSG_KOIM_BUTTON_CHANGE, MSG_KOIM_KBD_SCAN, MSG_META_KBD_CHAR,
    MSG_KOIM_MOUSE_WHEEL_VERTICAL, MSG_META_MOUSE_BUTTON, MSG_META_MOUSE_PTR,
    MSG_META_MOUSE_DRAG, MSG_META_MOUSE_WHEEL_VERTICAL,
    MSG_META_LEAVE_CONSTRAIN
};
const word kobjGocVarData[] = {
    TEMP_META_GCN, TEMP_META_QUIT_LIST, DETACH_DATA
};
/* goc's vardata tag and GCN structures, for the kernel's */
const word kobjGocGCNSizes[] = {
    sizeof(GCNListHeader), sizeof(GCNListElement),
    sizeof(GCNListOfListsElement), sizeof(TempMetaGCNData),
    offsetof(GCNListHeader, GCNLH_statusCount),
    sizeof(DetachDataEntry), offsetof(DetachDataEntry, DDE_completeMsg)
};
const int kobjGocMessageCount =
    sizeof(kobjGocMessages) / sizeof(kobjGocMessages[0]);

/* the offsets of the master offset words */
#define TOP_MO	word_offsetof(KOTopBase, KOTop_offset)
#define MID_MO	word_offsetof(KOMidBase, KOMid_offset)
#define COMP_MO	word_offsetof(KOCompBase, KOComp_offset)
#define COMP_ARGS COMP_MO, word_offsetof(KOCompInstance, KOCI_kids), \
		  word_offsetof(KOCompInstance, KOCI_link)

int kobjRelocs, kobjUnrelocs, kobjBumps;
static int fails;

static void
Check(int ok, const char *what)
{
    if (!ok) {
	fails++;
	printf("FAIL %s\n", what);
    }
}

static int
Aligned(const void *p)
{
    return ((uintptr_t) p & 7) == 0;
}

/* ---- methods ---- */

@method KOTopClass, MSG_META_INITIALIZE
{
    pself->KOTI_inits++;
    @callsuper();
}

@method KOTopClass, MSG_KOT_INITS
{
    return pself->KOTI_inits;
}

@method KOMidClass, MSG_KOM_GET_VALUE
{
    return pself->KOMI_value;
}

@method KOMidClass, MSG_KOM_BUMP
{
    kobjBumps++;
}

/* TEMP_KOM_INIT is made on demand (ObjVarDerefData) */
@method KOMidClass, MSG_META_INITIALIZE_VAR_DATA
{
    if (dataType == TEMP_KOM_INIT) {
	word *p = ObjVarAddData(oself, TEMP_KOM_INIT, sizeof(word));
	*p = 99;
	return (word) ((byte *) p - (byte *) MemDeref(OptrToHandle(oself)));
    }
    return @callsuper();
}

@method KORelocClass, _reloc
{
    if (message == MSG_META_RELOCATE) {
	kobjRelocs++;
    } else {
	kobjUnrelocs++;
    }
    return @callsuper();
}

@method KOPlainClass, MSG_META_INITIALIZE
{
    pself->KOPI_x = 77;
    @callsuper();
}

/* ---- the layout goc made, relocation ---- */

/* Before relocation: unrelocated optrs, aligned parts and vardata. */
int
KObjLayout(optr obj1, optr obj2)
{
    KOMidInstance *mid;
    KOTopInstance *top;
    byte *chunk;
    optr *link;
    char *name;
    dword *count;

    fails = 0;
    chunk = LMemDeref(obj1);
    Check(Aligned(chunk), "chunk aligned");
    top = ObjDeref(obj1, TOP_MO);
    mid = ObjDeref(obj1, MID_MO);
    Check(Aligned(top) && Aligned(mid), "master parts aligned");
    Check(mid->KOMI_value == 7, "KOMI_value");
    Check(GOCR_IS_UNRELOCATED(mid->KOMI_target) &&
	  GOCR_RES_OF(mid->KOMI_target) == GOCR_RES_OBJECTS &&
	  OptrToChunk(mid->KOMI_target) == KOObj2, "unrelocated optr");
    Check(top->KOTI_link == GOCR_UNRELOC_OPTR(GOCR_RES_OBJECTS, KOPlain1),
	  "unrelocated optr in the first part");
    link = ObjVarFindData(obj1, ATTR_KOM_LINK);
    Check(link && Aligned(link) &&
	  *link == GOCR_UNRELOC_OPTR(GOCR_RES_OBJECTS, KOPlain1),
	  "optr in vardata");
    name = ObjVarFindData(obj1, ATTR_KOM_NAME);
    Check(name && strcmp(name, "hello") == 0 &&
	  VarDataSizePtr(name) == 6, "string vardata");
    count = ObjVarFindData(obj1, ATTR_KOM_COUNT);
    Check(count && Aligned(count) && *count == 0x12345678 &&
	  VarDataSizePtr(count) == 4, "dword vardata");
    Check(ObjVarFindData(obj1, HINT_KOM_FLAG) != NULL &&
	  VarDataSizePtr(ObjVarFindData(obj1, HINT_KOM_FLAG)) == 0,
	  "vardata without data");
    Check(ObjVarFindData(obj1, TEMP_KOM_INIT) == NULL, "no TEMP_KOM_INIT");
    Check((ObjGetFlags(obj1) & (OCF_IS_OBJECT | OCF_IN_RESOURCE |
				OCF_VARDATA_RELOC)) ==
	  (OCF_IS_OBJECT | OCF_IN_RESOURCE | OCF_VARDATA_RELOC), "flags");
    mid = ObjDeref(obj2, MID_MO);
    /* goc builds every part that is not above an unresolved variant */
    Check(*(word *) ((byte *) LMemDeref(obj2) + TOP_MO) != 0 &&
	  Aligned(ObjDeref(obj2, TOP_MO)), "static part built");
    Check(mid->KOMI_value == 9, "KOObj2 value");
    return fails;
}

/* After relocation with handles[]: everything points to blocks. */
int
KObjRelocated(optr obj1, optr obj2, optr plain, optr other,
	      const Handle *handles)
{
    KOMidInstance *mid;
    KOPlainInstance *p;

    fails = 0;
    mid = ObjDeref(obj1, MID_MO);
    Check(mid->KOMI_target == obj2, "relocated target");
    Check(((KOTopInstance *) ObjDeref(obj1, TOP_MO))->KOTI_link ==
	  plain, "relocated link");
    Check(*(optr *) ObjVarFindData(obj1, ATTR_KOM_LINK) == plain,
	  "relocated vardata optr");
    mid = ObjDeref(obj2, MID_MO);
    Check(mid->KOMI_target == other, "relocated across resources");
    p = LMemDeref(plain);
    Check(p->KOPI_other == obj1, "plain other");
    Check(p->KOPI_proc == ConstructOptr(handles[0], 0), "process");
    p = LMemDeref(other);
    Check(p->KOPI_other == obj2, "other block to this block");
    Check(*(word *) ObjVarFindData(other, ATTR_KOP_W) == 0x55,
	  "plain vardata");
    return fails;
}

/* An hptr (@reloc handle) is the handle itself. */
int
KObjHptr(optr obj1, MemHandle other)
{
    MemHandle mh = OptrToHandle(obj1);
    KOMidInstance *mid;

    fails = 0;
    mid = ObjDeref(obj1, MID_MO);
    mid->KOMI_block = other;
    ObjUnRelocateObjBlock(mh, VMRT_UNRELOCATE_FROM_RESOURCE);
    mid = ObjDeref(obj1, MID_MO);
    Check(mid->KOMI_block == (GOCR_UNRELOCATED | GOCR_RES_OTHER),
	  "hptr unrelocated");
    ObjRelocateObjBlock(mh, VMRT_RELOCATE_FROM_RESOURCE);
    mid = ObjDeref(obj1, MID_MO);
    Check(mid->KOMI_block == other, "hptr relocated");
    return fails;
}

/* ---- variable data ---- */

static int scanCount, scanTotal;

static void
ScanCount(MemHandle mh, ChunkHandle ch, VarDataEntry *extra, word type,
	  void *data)
{
    (void) mh; (void) ch; (void) extra; (void) type;
    scanCount++;
    scanTotal += *(int *) data;
}

int
KObjVarData(optr obj1, optr obj2, optr plain)
{
    VarDataCHandler handlers[] = {
	{ATTR_KOM_COUNT, ScanCount},
	{HINT_KOM_FLAG, ScanCount},
	{ATTR_KOM_NAME, ScanCount}
    };
    int three = 3;
    word *w;
    dword *d;
    char buf[16];
    word n;
    struct {
	word	dataType;
	word	dataSize;
	void	*data;
    } avdp;
    KOMidInstance *mid;

    fails = 0;
    ObjVarScanData(obj1, 3, handlers, &three);
    Check(scanCount == 3 && scanTotal == 9, "ObjVarScanData");

    /* made on demand by the class */
    w = ObjVarDerefData(obj1, TEMP_KOM_INIT);
    Check(w && *w == 99 && Aligned(w), "ObjVarDerefData");
    Check(ObjVarDerefData(obj1, TEMP_KOM_INIT) == w, "found again");

    /* add over an existing entry: same size, data cleared */
    d = ObjVarAddData(obj1, ATTR_KOM_COUNT, sizeof(dword));
    Check(*d == 0 && Aligned(d), "re-add clears");
    *d = 41;
    /* another size: moved to the end */
    d = ObjVarAddData(obj1, ATTR_KOM_COUNT, 3 * sizeof(dword));
    Check(d && VarDataSizePtr(d) == 12 && Aligned(d), "re-add resized");
    d[2] = 0xabcdef01;

    Check(ObjVarDeleteData(obj1, HINT_KOM_FLAG), "delete");
    Check(!ObjVarDeleteData(obj1, HINT_KOM_FLAG), "delete again");
    Check(strcmp(ObjVarFindData(obj1, ATTR_KOM_NAME), "hello") == 0,
	  "others stay");

    /* through MetaClass messages */
    avdp.dataType = ATTR_KOM_NAME;
    avdp.dataSize = 4;
    avdp.data = "abc";
    @call obj1::MSG_META_ADD_VAR_DATA(avdp.dataType, avdp.dataSize,
				      avdp.data);
    n = @call obj1::MSG_META_GET_VAR_DATA(ATTR_KOM_NAME, sizeof(buf), buf);
    Check(n == 4 && strcmp(buf, "abc") == 0, "MSG_META_GET_VAR_DATA");
    n = @call obj1::MSG_META_GET_VAR_DATA(HINT_KOM_FLAG, sizeof(buf), buf);
    Check(n == 0xffff, "MSG_META_GET_VAR_DATA not found");
    Check(!@call obj1::MSG_META_DELETE_VAR_DATA(ATTR_KOM_NAME),
	  "MSG_META_DELETE_VAR_DATA");
    Check(@call obj1::MSG_META_DELETE_VAR_DATA(ATTR_KOM_NAME),
	  "MSG_META_DELETE_VAR_DATA not found");

    /* copy a range, delete a range */
    ObjVarCopyDataRange(obj1, plain, ATTR_KOM_LINK, TEMP_KOM_INIT);
    Check(*(word *) ObjVarFindData(plain, TEMP_KOM_INIT) == 99 &&
	  ((dword *) ObjVarFindData(plain, ATTR_KOM_COUNT))[2] ==
	  0xabcdef01, "ObjVarCopyDataRange");
    ObjVarDeleteDataRange(plain, ATTR_KOM_LINK, TEMP_KOM_INIT, FALSE);
    Check(!ObjVarFindData(plain, TEMP_KOM_INIT) &&
	  !ObjVarFindData(plain, ATTR_KOM_COUNT) &&
	  !ObjVarFindData(plain, ATTR_KOM_LINK), "ObjVarDeleteDataRange");

    /* vardata on an object with static parts */
    w = ObjVarAddData(obj2, ATTR_KOM_COUNT, sizeof(dword));
    *(dword *) w = 5;
    Check(@call obj2::MSG_KOT_INITS() == 0, "static part not initialized");
    d = ObjVarFindData(obj2, ATTR_KOM_COUNT);
    Check(d && *d == 5 && Aligned(d), "vardata after the parts");
    mid = ObjDeref(obj2, MID_MO);
    Check(Aligned(mid) && mid->KOMI_value == 9, "parts unchanged");
    return fails;
}

/* ---- ObjInstantiate, MetaClass ---- */

int
KObjInstantiate(MemHandle block)
{
    optr a, b;
    dword *d;

    fails = 0;
    a = ObjInstantiate(block, &KOMidClass);
    Check(LMemGetChunkSize(a) == MID_MO + sizeof(word),
	  "only the base structure");
    d = ObjVarAddData(a, ATTR_KOM_COUNT, sizeof(dword));
    *d = 8;
    Check(@call a::MSG_KOT_INITS() == 1, "parts built on demand");
    Check(@call a::MSG_KOM_GET_VALUE() == 0, "new part is zero");
    d = ObjVarFindData(a, ATTR_KOM_COUNT);
    Check(d && *d == 8 && Aligned(d), "vardata kept");
    Check(Aligned(ObjDeref(a, TOP_MO)) &&
	  Aligned(ObjDeref(a, MID_MO)), "new parts aligned");
    Check((ObjGetFlags(a) & (OCF_IS_OBJECT | OCF_DIRTY)) ==
	  (OCF_IS_OBJECT | OCF_DIRTY), "new object flags");

    b = ObjInstantiate(block, &KOPlainClass);
    Check(((KOPlainInstance *) LMemDeref(b))->KOPI_x == 77,
	  "MSG_META_INITIALIZE without master parts");
    d = ObjVarAddData(b, ATTR_KOP_W, sizeof(word));
    Check(Aligned(d), "vardata of a plain object aligned");

    Check(@call a::MSG_META_GET_CLASS() == &KOMidClass, "GET_CLASS");
    Check(@call a::MSG_META_IS_OBJECT_IN_CLASS(&KOTopClass),
	  "IS_OBJECT_IN_CLASS");
    Check(!@call a::MSG_META_IS_OBJECT_IN_CLASS(&KOPlainClass),
	  "IS_OBJECT_IN_CLASS not");
    Check(ObjIsObjectInClass(b, &MetaClass), "in MetaClass");
    Check(@call a::MSG_META_GET_OPTR() == a, "GET_OPTR");
    @call a::MSG_META_SET_FLAGS(OptrToChunk(b), OCF_IGNORE_DIRTY, OCF_DIRTY);
    Check(@call a::MSG_META_GET_FLAGS(OptrToChunk(b)) ==
	  (OCF_IS_OBJECT | OCF_IGNORE_DIRTY), "SET/GET_FLAGS");
    @call a::MSG_META_SET_OBJ_BLOCK_OUTPUT(b);
    Check(@call a::MSG_META_GET_OBJ_BLOCK_OUTPUT() == b &&
	  ObjBlockGetOutput(block) == b, "block output");
    ObjBlockSetOutput(block, 0);
    return fails;
}

/* ---- classed events ---- */

int
KObjClassed(optr mid, optr plain)
{
    EventHandle ev;

    fails = 0;
    ev = @record KOMidClass::MSG_KOM_BUMP();
    @call mid::MSG_META_SEND_CLASSED_EVENT(ev, TO_SELF);
    Check(kobjBumps == 1, "classed event delivered");
    ev = @record KOMidClass::MSG_KOM_BUMP();
    @call plain::MSG_META_SEND_CLASSED_EVENT(ev, TO_SELF);
    Check(kobjBumps == 1, "classed event of another class dropped");
    ev = @record KOMidClass::MSG_KOM_BUMP();
    @call mid::MSG_META_SEND_CLASSED_EVENT(ev, TO_NULL);
    Check(kobjBumps == 1, "TO_NULL dropped");
    return fails;
}

/* ---- freeing, remote ---- */

void
KObjSendFree(optr o)
{
    @send o::MSG_META_OBJ_FREE();
}

ClassStruct *
KObjClassOf(optr o)
{
    return @call o::MSG_META_GET_CLASS();
}

/* ---- composites ---- */

static word visits[8];
static int nVisits;

@method KOCompClass, MSG_KOC_VISIT
{
    if (nVisits < 8) {
	visits[nVisits++] = pself->KOCI_id + add;
    }
}

@method KOCompClass, MSG_KOC_ID
{
    return pself->KOCI_id;
}

@method KOCompClass, MSG_KOC_PARENT_ID
{
    return @call @kocParent::MSG_KOC_ID();
}

/* the children's ids in order, through @send @children (from the
 * composite: @children is of oself) */
static int
KObjCompOrder(optr tree, word a, word b, word c)
{
    optr oself = tree;

    nVisits = 0;
    @send @kocChildren::MSG_KOC_VISIT(0);
    if (c) {
	return nVisits == 3 && visits[0] == a && visits[1] == b &&
	       visits[2] == c;
    }
    if (b) {
	return nVisits == 2 && visits[0] == a && visits[1] == b;
    }
    if (a) {
	return nVisits == 1 && visits[0] == a;
    }
    return nVisits == 0;
}

static int abortAt;

static Boolean
Visit(optr parent, optr child, void *cbData)
{
    (void) parent;
    (*(int *) cbData)++;
    visits[nVisits++] = @call child::MSG_KOC_ID();
    return *(int *) cbData == abortAt;
}

/* goc's unrelocated links: siblings, and the parent for the last */
int
KObjCompLayout(optr tree, optr a, optr c)
{
    KOCompInstance *t, *ci;

    fails = 0;
    t = ObjDeref(tree, COMP_MO);
    ci = ObjDeref(c, COMP_MO);
    Check(t->KOCI_kids.CP_firstChild == GOCR_UNRELOC_OPTR(GOCR_RES_OBJECTS, KOLeafA),
	  "unrelocated first child");
    Check(ci->KOCI_link.LP_next == (GOCR_UNRELOC_OPTR(GOCR_RES_OBJECTS, KOTree) | 1),
	  "unrelocated parent link");
    (void) a;
    return fails;
}

int
KObjComposite(optr tree, optr a, optr b, optr c)
{
    MemHandle mh = OptrToHandle(tree);
    word count = 0;
    int n;
    optr d, e;
    KOCompInstance *ci;

    fails = 0;
    ci = ObjDeref(c, COMP_MO);
    Check(ci->KOCI_link.LP_next == (tree | 1), "relocated parent link");
    Check(ObjLinkFindParent(a, COMP_MO, word_offsetof(KOCompInstance,
						      KOCI_link)) == tree &&
	  ObjLinkFindParent(b, COMP_MO, word_offsetof(KOCompInstance,
						      KOCI_link)) == tree,
	  "ObjLinkFindParent");
    Check(ObjLinkFindParent(tree, COMP_MO, word_offsetof(KOCompInstance,
							 KOCI_link)) == 0,
	  "no parent");
    Check(@call b::MSG_KOC_PARENT_ID() == 1, "@parent");
    Check(ObjCompFindChildByOptr(tree, b, COMP_ARGS) == 1 &&
	  ObjCompFindChildByOptr(tree, tree, COMP_ARGS) == 0xffff,
	  "ObjCompFindChildByOptr");
    Check(ObjCompFindChildByNumber(tree, 2, COMP_ARGS) == c &&
	  ObjCompFindChildByNumber(tree, 0, COMP_ARGS) == a &&
	  ObjCompFindChildByNumber(tree, 3, COMP_ARGS) == 0,
	  "ObjCompFindChildByNumber");
    ObjCompProcessChildren(tree, 0, OCCT_COUNT_CHILDREN, &count, COMP_ARGS,
			   NULL);
    Check(count == 3, "OCCT_COUNT_CHILDREN");

    /* @send @children, across both blocks */
    Check(KObjCompOrder(tree, 10, 20, 30), "@children");

    /* a callback that stops, a start at a child number */
    n = 0;
    nVisits = 0;
    abortAt = 2;
    Check(ObjCompProcessChildren(tree, 0, 0, &n, COMP_ARGS, Visit) &&
	  n == 2 && visits[1] == 20, "callback abort");
    n = 0;
    nVisits = 0;
    abortAt = 0;
    Check(!ObjCompProcessChildren(tree, ConstructOptr(0, 1), 0, &n,
				  COMP_ARGS, Visit) &&
	  n == 2 && visits[0] == 20, "start at child 1");
    n = 0;
    nVisits = 0;
    Check(!ObjCompProcessChildren(tree, c, 0, &n, COMP_ARGS, Visit) &&
	  n == 1 && visits[0] == 30, "start at a child");

    /* remove: the middle, the first, the only child */
    ObjSetFlags(a, 0, OCF_DIRTY);
    ObjCompRemoveChild(tree, b, CCF_MARK_DIRTY, COMP_ARGS);
    Check(KObjCompOrder(tree, 10, 30, 0) &&
	  ((KOCompInstance *) ObjDeref(b, COMP_MO))->KOCI_link.LP_next == 0 &&
	  (ObjGetFlags(a) & OCF_DIRTY), "remove the middle child");
    ObjCompRemoveChild(tree, a, 0, COMP_ARGS);
    Check(KObjCompOrder(tree, 30, 0, 0), "remove the first child");
    ObjCompRemoveChild(tree, c, 0, COMP_ARGS);
    Check(KObjCompOrder(tree, 0, 0, 0) &&
	  ((KOCompInstance *) ObjDeref(tree, COMP_MO))->KOCI_kids.CP_firstChild == 0,
	  "remove the only child");

    /* add at the end, at the front, in the middle; move */
    ObjCompAddChild(tree, a, CCO_LAST, COMP_ARGS);
    Check(ObjLinkFindParent(a, COMP_MO, word_offsetof(KOCompInstance,
						      KOCI_link)) == tree,
	  "add to an empty composite");
    ObjCompAddChild(tree, c, CCO_FIRST, COMP_ARGS);
    ObjCompAddChild(tree, b, 1 | CCF_MARK_DIRTY, COMP_ARGS);
    Check(KObjCompOrder(tree, 30, 20, 10), "add");
    ObjCompMoveChild(tree, a, CCO_FIRST, COMP_ARGS);
    Check(KObjCompOrder(tree, 10, 30, 20), "move");

    /* new objects: the parts are built when added */
    d = ObjInstantiate(mh, &KOCompClass);
    e = ObjInstantiate(mh, &KOCompClass);
    ObjCompAddChild(d, e, CCO_LAST, COMP_ARGS);
    Check(ObjLinkFindParent(e, COMP_MO, word_offsetof(KOCompInstance,
						      KOCI_link)) == d &&
	  ObjCompFindChildByNumber(d, 0, COMP_ARGS) == e,
	  "new composite");
    ObjCompAddChild(tree, d, CCO_LAST, COMP_ARGS);
    Check(@call e::MSG_KOC_PARENT_ID() == 0 &&
	  ObjCompFindChildByNumber(tree, 3, COMP_ARGS) == d, "nested");
    return fails;
}

/* ---- GCN lists ---- */

#define GEOWORKS	MANUFACTURER_ID_GEOWORKS
#define LIST_A		GCNSLT_DATE_TIME
#define LIST_O		0x100			/* an object's lists */
#define LIST_S		(0x102 | GCNLTF_SAVE_TO_STATE)

static int notifies, dataNotifies;
static word notifyData, notifyIds;

@method KOCompClass, MSG_META_NOTIFY
{
    notifies++;
    notifyData = data;
    notifyIds += pself->KOCI_id;
}

@method KOCompClass, MSG_META_NOTIFY_WITH_DATA_BLOCK
{
    dataNotifies++;
    notifyIds += pself->KOCI_id;
    @callsuper();			/* gives up the reference */
}

static void
Reset(void)
{
    notifies = dataNotifies = 0;
    notifyIds = 0;
}

static word
Refs(MemHandle blk)
{
    return (word) MemGetInfo(blk, MGIT_OTHER_INFO);
}

/* the system lists: a, b, c are leaves of the tree (ids 10, 20, 30) */
int
KObjGCNSystem(optr a, optr b, optr c)
{
    MemHandle blk;
    EventHandle ev;
    word n;

    fails = 0;
    Check(GCNListAdd(a, GEOWORKS, LIST_A) && !GCNListAdd(a, GEOWORKS, LIST_A)
	  && GCNListAdd(b, GEOWORKS, LIST_A), "GCNListAdd");
    Reset();
    ev = @record KOCompClass::MSG_META_NOTIFY(GEOWORKS, 7, 42);
    n = GCNListSend(GEOWORKS, LIST_A, ev, 0, 0);
    Check(n == 2 && notifies == 2 && notifyData == 42 && notifyIds == 30,
	  "GCNListSend");
    Check(GCNListSend(GEOWORKS, LIST_A + 2,
		      @record KOCompClass::MSG_META_NOTIFY(GEOWORKS, 7, 1), 0,
		      0) == 0, "send to no list");

    /* a data block: a reference per object, the sender's given up */
    blk = MemAlloc(16, HF_SWAPABLE, HAF_ZERO_INIT);
    MemInitRefCount(blk, 2);		/* the sender's and ours */
    Reset();
    ev = @record KOCompClass::MSG_META_NOTIFY_WITH_DATA_BLOCK(GEOWORKS, 8, blk);
    GCNListSend(GEOWORKS, LIST_A, ev, blk, 0);
    Check(dataNotifies == 2 && Refs(blk) == 1, "data block references");

    /* the status: kept by the list, sent to who comes later */
    MemIncRefCount(blk);		/* the sender's */
    Reset();
    ev = @record KOCompClass::MSG_META_NOTIFY_WITH_DATA_BLOCK(GEOWORKS, 8, blk);
    GCNListSend(GEOWORKS, LIST_A, ev, blk, GCNLSF_SET_STATUS);
    Check(dataNotifies == 2 && Refs(blk) == 2, "status kept");
    Reset();
    Check(GCNListAdd(c, GEOWORKS, LIST_A) && dataNotifies == 1 &&
	  notifyIds == 30 && Refs(blk) == 2, "status to a new object");
    /* the same status again: nobody is told */
    MemIncRefCount(blk);
    Reset();
    ev = @record KOCompClass::MSG_META_NOTIFY_WITH_DATA_BLOCK(GEOWORKS, 8, blk);
    GCNListSend(GEOWORKS, LIST_A, ev, blk, GCNLSF_SET_STATUS);
    Check(dataNotifies == 0 && Refs(blk) == 2, "same status not sent");
    /* another status: the old one and its block are let go */
    Reset();
    ev = @record KOCompClass::MSG_META_NOTIFY(GEOWORKS, 9, 5);
    GCNListSend(GEOWORKS, LIST_A, ev, 0, GCNLSF_SET_STATUS);
    Check(notifies == 3 && Refs(blk) == 1, "new status");
    MemDecRefCount(blk);		/* ours: freed */

    /* remove, by optr and for a whole block (chunk 0) */
    Check(GCNListRemove(b, GEOWORKS, LIST_A) &&
	  !GCNListRemove(b, GEOWORKS, LIST_A), "GCNListRemove");
    Reset();
    Check(GCNListSend(GEOWORKS, LIST_A,
		      @record KOCompClass::MSG_META_NOTIFY(GEOWORKS, 7, 1), 0,
		      0) == 2 && notifyIds == 40, "send after remove");
    Check(GCNListRemove(ConstructOptr(OptrToHandle(a), 0), GEOWORKS, LIST_A)
	  && GCNListSend(GEOWORKS, LIST_A,
			 @record KOCompClass::MSG_META_NOTIFY(GEOWORKS, 7, 1),
			 0, 0) == 0, "remove a block's objects");
    /* clear the status for the next test run */
    GCNListSend(GEOWORKS, LIST_A, 0, 0, GCNLSF_SET_STATUS);
    return fails;
}

/* an object's lists (MetaClass, TEMP_META_GCN) */
int
KObjGCNObject(optr tree, optr a, optr b)
{
    MemHandle mh = OptrToHandle(tree);
    TempMetaGCNData *d;
    GCNListElement *e;
    ChunkHandle lol, list;
    EventHandle ev;

    fails = 0;
    Check(ObjVarFindData(tree, TEMP_META_GCN) == NULL, "no lists yet");
    Check(!@call tree::MSG_META_GCN_LIST_REMOVE(a, LIST_O, GEOWORKS) &&
	  !@call tree::MSG_META_GCN_LIST_FIND_ITEM(a, LIST_O, GEOWORKS),
	  "remove, find without lists");
    Check(@call tree::MSG_META_GCN_LIST_ADD(a, LIST_O, GEOWORKS) &&
	  @call tree::MSG_META_GCN_LIST_ADD(b, LIST_O, GEOWORKS) &&
	  !@call tree::MSG_META_GCN_LIST_ADD(b, LIST_O, GEOWORKS),
	  "MSG_META_GCN_LIST_ADD");
    d = ObjVarFindData(tree, TEMP_META_GCN);
    Check(d && d->TMGCND_flags == TMGCNF_RELOCATED &&
	  !(VarDataFlagsPtr(d) & VDF_SAVE_TO_STATE), "TEMP_META_GCN");
    Check(@call tree::MSG_META_GCN_LIST_FIND_ITEM(b, LIST_O, GEOWORKS),
	  "MSG_META_GCN_LIST_FIND_ITEM");
    Reset();
    ev = @record KOCompClass::MSG_META_NOTIFY(GEOWORKS, 1, 2);
    @call tree::MSG_META_GCN_LIST_SEND(0, ev, 0, LIST_O, GEOWORKS);
    Check(notifies == 2 && notifyIds == 30, "MSG_META_GCN_LIST_SEND");
    Check(@call tree::MSG_META_GCN_LIST_REMOVE(a, LIST_O, GEOWORKS) &&
	  !@call tree::MSG_META_GCN_LIST_FIND_ITEM(a, LIST_O, GEOWORKS),
	  "MSG_META_GCN_LIST_REMOVE");

    /* a list saved to state survives unrelocation, the other goes */
    Check(@call tree::MSG_META_GCN_LIST_ADD(a, LIST_S, GEOWORKS),
	  "add to a saved list");
    d = ObjVarFindData(tree, TEMP_META_GCN);
    Check(VarDataFlagsPtr(d) & VDF_SAVE_TO_STATE, "VDF_SAVE_TO_STATE");
    lol = d->TMGCND_listOfLists;
    Check(!GCNListUnRelocateBlock(mh, lol, mh), "unrelocate the lists");
    Check(GCNListFindListInBlock(GEOWORKS, LIST_O, mh, lol, FALSE) == 0,
	  "unsaved list dropped");
    list = GCNListFindListInBlock(GEOWORKS, LIST_S, mh, lol, FALSE);
    e = ChunkArrayElementToPtr(ConstructOptr(mh, list), 0, NULL);
    Check(list && e->GCNLE_item ==
	  GOCR_UNRELOC_OPTR(GOCR_RES_OBJECTS, OptrToChunk(a)),
	  "saved list unrelocated");
    GCNListRelocateBlock(mh, lol, mh);
    e = ChunkArrayElementToPtr(ConstructOptr(mh, list), 0, NULL);
    Check(e->GCNLE_item == a, "saved list relocated");

    @call tree::MSG_META_GCN_LIST_DESTROY();
    Check(ObjVarFindData(tree, TEMP_META_GCN) == NULL,
	  "MSG_META_GCN_LIST_DESTROY");
    return fails;
}

/* ---- detach and quit (objects run by a process thread) ---- */

@class KODetClass, MetaClass;
    @instance optr KODI_h1;
    @instance optr KODI_h2;
@endc
@classdecl KODetClass;

@class KOAbortClass, MetaClass;
@endc
@classdecl KOAbortClass;

static volatile int acks, shutdownAcks, finishes, finishAbort, quits;
static volatile word ackCaller;
static volatile optr ackFrom;

/* waits for a detach on the helpers it sends MSG_META_DETACH to */
@method KODetClass, MSG_META_DETACH
{
    optr h1 = pself->KODI_h1, h2 = pself->KODI_h2;

    ObjInitDetach(MSG_META_DETACH, oself, callerID, caller);
    ObjIncDetach(oself);
    @send h1::MSG_META_DETACH(0, oself);
    ObjIncDetach(oself);
    @send h2::MSG_META_DETACH(0, oself);
    ObjEnableDetach(oself);
    @callsuper();
}

@method KOCompClass, MSG_META_ACK
{
    acks++;
    ackCaller = callerID;
    ackFrom = caller;
    @callsuper();
}

@method KOCompClass, MSG_META_SHUTDOWN_ACK
{
    shutdownAcks++;
    ackCaller = callerID;
    ackFrom = ackOD;
    @callsuper();
}

@method KOCompClass, MSG_META_FINISH_QUIT
{
    finishes++;
    finishAbort = abortFlag;
    @callsuper();
}

/* MSG_META_QUIT as MSG_META_QUIT_OBJECT: refuse */
@method KOAbortClass, MSG_META_QUIT_OBJECT
{
    quits++;
    @send obj::MSG_META_QUIT_ACK(0, TRUE);
}

/* run a sync call to t2's objects until `cond' holds (or give up) */
#define WAIT_FOR(any, cond) do { \
	int _n; \
	for (_n = 0; _n < 200 && !(cond); _n++) { \
	    (void) @call any::MSG_META_GET_CLASS(); \
	    TimerSleep(1); \
	} \
    } while (0)

int
KObjDetach(ThreadHandle t2, ThreadHandle t3)
{
    optr rec, det, h1, h2, q, ab;
    KODetInstance *di;

    fails = 0;
    rec = ObjInstantiateForThread(t2, &KOCompClass);
    det = ObjInstantiateForThread(t2, &KODetClass);
    h1 = ObjInstantiateForThread(t2, &KOCompClass);
    h2 = ObjInstantiateForThread(t2, &KOCompClass);
    di = LMemDeref(det);
    di->KODI_h1 = h1;
    di->KODI_h2 = h2;

    /* an object that waits for two others */
    acks = 0;
    @send det::MSG_META_DETACH(7, rec);
    WAIT_FOR(rec, acks == 1);
    Check(acks == 1 && ackCaller == 7 && ackFrom == det &&
	  ObjVarFindData(det, DETACH_DATA) == NULL, "detach with acks");

    /* an object that acks at once */
    @send h1::MSG_META_APP_SHUTDOWN(3, rec);
    WAIT_FOR(rec, shutdownAcks == 1);
    Check(shutdownAcks == 1 && ackCaller == 3 && ackFrom == h1,
	  "app shutdown");

    /* quit: each object on the active list in turn, then FINISH_QUIT */
    q = ObjInstantiateForThread(t2, &KOCompClass);
    (void) @call q::MSG_META_GCN_LIST_ADD(h1, MGCNLT_ACTIVE_LIST, GEOWORKS);
    (void) @call q::MSG_META_GCN_LIST_ADD(h2, MGCNLT_ACTIVE_LIST, GEOWORKS);
    finishes = 0;
    @send q::MSG_META_QUIT_ACK(0, 0);
    WAIT_FOR(rec, finishes == 1);
    Check(finishes == 1 && !finishAbort &&
	  ObjVarFindData(q, TEMP_META_QUIT_LIST) == NULL, "quit");

    /* an object on the active list that refuses */
    ab = ObjInstantiateForThread(t2, &KOAbortClass);
    (void) @call q::MSG_META_GCN_LIST_ADD(ab, MGCNLT_ACTIVE_LIST, GEOWORKS);
    finishes = 0;
    @send q::MSG_META_QUIT_ACK(0, 0);
    WAIT_FOR(rec, finishes == 1);
    Check(quits == 1 && finishes == 1 && finishAbort &&
	  ObjVarFindData(q, TEMP_META_QUIT_LIST) == NULL, "quit aborted");
    if (fails)
	printf("quits %d finishes %d abort %d\n", quits, finishes, finishAbort);

    /* a process: its thread exits, the ack names the thread */
    acks = 0;
    @send ConstructOptr(t3, 0)::MSG_META_DETACH(5, rec);
    WAIT_FOR(rec, acks == 1);
    Check(acks == 1 && ackCaller == 5 && OptrToHandle(ackFrom) == t3,
	  "process detach");
    return fails;
}
